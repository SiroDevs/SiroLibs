  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "ZEC 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lọghachitanụ nʼebe",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text"
            }
          ]
        },
        {
          "text": "nọ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ZEC 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼọnwa nke asatọ, nʼafọ nke abụọ nke ọchịchị eze Daraiọs, okwu",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.1",
            "verseOrgIds": [
              "ZEC.1.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.1.1",
                "verseOrgIds": [
                  "ZEC.1.1"
                ]
              }
            }
          ]
        },
        {
          "text": "ruru Zekaraya nwa Berekaya, nwa Ido, bụ onye amụma ntị, na-asị,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.1",
            "verseOrgIds": [
              "ZEC.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ZEC 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.2",
            "verseOrgIds": [
              "ZEC.1.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.1.2",
                "verseOrgIds": [
                  "ZEC.1.2"
                ]
              }
            }
          ]
        },
        {
          "text": "were oke iwe megide nna unu ha.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.2",
            "verseOrgIds": [
              "ZEC.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ZEC 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi ya, gwa ha, ihe ndị a ka",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.3",
            "verseOrgIds": [
              "ZEC.1.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.1.3",
                "verseOrgIds": [
                  "ZEC.1.3"
                ]
              }
            }
          ]
        },
        {
          "text": ", Onye pụrụ ime ihe niile, na-ekwu. 'Lọghachikwutenụ m,' otu a ka",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.3",
            "verseOrgIds": [
              "ZEC.1.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.1.3",
                "verseOrgIds": [
                  "ZEC.1.3"
                ]
              }
            }
          ]
        },
        {
          "text": ", Onye pụrụ ime ihe niile kwupụtara, 'Mụ onwe m kwa ga-alọghachikwute unu.' Ọ bụ ihe",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.3",
            "verseOrgIds": [
              "ZEC.1.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.1.3",
                "verseOrgIds": [
                  "ZEC.1.3"
                ]
              }
            }
          ]
        },
        {
          "text": "Onye pụrụ ime ihe niile, na-ekwu.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.3",
            "verseOrgIds": [
              "ZEC.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ZEC 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unu adịla ka ndị nna unu ha, ndị amụma mbụ kpọrọ oku si, Otu a ka",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.4",
            "verseOrgIds": [
              "ZEC.1.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.1.4",
                "verseOrgIds": [
                  "ZEC.1.4"
                ]
              }
            }
          ]
        },
        {
          "text": ", Onye pụrụ ime ihe niile kwupụtara: 'Sitenụ nʼụzọ ọjọọ unu na ajọ omume unu chigharịa' ma ha achọghị ịnụ maọbụ gee m ntị, otu a ka",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.4",
            "verseOrgIds": [
              "ZEC.1.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.1.4",
                "verseOrgIds": [
                  "ZEC.1.4"
                ]
              }
            }
          ]
        },
        {
          "text": "kwupụtara.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.4",
            "verseOrgIds": [
              "ZEC.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ZEC 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olee ebe ka nna nna unu ha nọ ugbu a? Ndị amụma ahụ, ha na-adị ndụ ruo mgbe ebighị ebi?",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.5",
            "verseOrgIds": [
              "ZEC.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ZEC 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ na okwu m na iwu bụ nke m nyere ụmụ ohu m ndị amụma, ọ bụ na ha emezughị nʼebe ndị nna nna unu ha nọ?",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.6",
            "verseOrgIds": [
              "ZEC.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "ZEC 1:6"
      },
      "items": [
        {
          "text": "\"Mgbe ahụ, ha chegharịrị ma kwuo, '",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.6",
            "verseOrgIds": [
              "ZEC.1.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.1.6",
                "verseOrgIds": [
                  "ZEC.1.6"
                ]
              }
            }
          ]
        },
        {
          "text": ", Onye pụrụ ime ihe niile, emesola anyị mmeso dịka ụzọ anyị na omume anyị si dị. O mekwara ya dịka o si zube na ọ ga-eme ya.' \"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.6",
            "verseOrgIds": [
              "ZEC.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nwoke nọ nʼetiti osisi mietul",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ZEC 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼụbọchị nke iri abụọ na anọ, nke ọnwa iri na otu, bụ ọnwa Shebat, nʼafọ abụọ nke ọchịchị eze Daraiọs, okwu",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.7",
            "verseOrgIds": [
              "ZEC.1.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.1.7",
                "verseOrgIds": [
                  "ZEC.1.7"
                ]
              }
            }
          ]
        },
        {
          "text": "ruru Zekaraya onye amụma, bụ nwa Berekaya, nwa Ido ntị, na-asị:",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.7",
            "verseOrgIds": [
              "ZEC.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ZEC 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼabalị ahụ, ahụrụ m nʼọhụ, otu nwoke na-agba ịnyịnya na-acha ọbara ọbara. O guzokwa nʼetiti osisi mietul, nke dị nʼebe miri emi nke mgbawa dị nʼala. Nʼazụ ya, ọtụtụ ịnyịnya na-acha ọbara ọbara, ndị na-acha ka ahịhịa kpọrọ nkụ, na ndị na-acha ọcha dịkwa.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.8",
            "verseOrgIds": [
              "ZEC.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ZEC 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ajụrụ m, \"Nna m ukwu, gịnị bụ ihe ndị a?\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.9",
            "verseOrgIds": [
              "ZEC.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "ZEC 1:9"
      },
      "items": [
        {
          "text": "Mmụọ ozi ahụ nke na-agwa m okwu sịrị m, \"Aga m egosi gị ihe ha bụ.\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.9",
            "verseOrgIds": [
              "ZEC.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ZEC 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ onye ahụ guzo nʼetiti osisi mietul ndị ahụ sịrị, \"Ndị a bụ ndị",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.10",
            "verseOrgIds": [
              "ZEC.1.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.1.10",
                "verseOrgIds": [
                  "ZEC.1.10"
                ]
              }
            }
          ]
        },
        {
          "text": "zitere ka ha jegharịa nʼụwa niile.\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.10",
            "verseOrgIds": [
              "ZEC.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ZEC 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha sịrị mmụọ ozi nke",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.11",
            "verseOrgIds": [
              "ZEC.1.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.1.11",
                "verseOrgIds": [
                  "ZEC.1.11"
                ]
              }
            }
          ]
        },
        {
          "text": "nke na-eguzo nʼetiti osisi mietul ahụ, \"Anyị ejegharịala nʼụwa niile, ma lee anyị chọpụtara na ụwa niile nọ nʼudo, dịkwa jụụ.\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.11",
            "verseOrgIds": [
              "ZEC.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ZEC 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, mmụọ ozi nke",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.12",
            "verseOrgIds": [
              "ZEC.1.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.1.12",
                "verseOrgIds": [
                  "ZEC.1.12"
                ]
              }
            }
          ]
        },
        {
          "text": "sịrị, \"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.12",
            "verseOrgIds": [
              "ZEC.1.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.1.12",
                "verseOrgIds": [
                  "ZEC.1.12"
                ]
              }
            }
          ]
        },
        {
          "text": ", Onye pụrụ ime ihe niile, ọ bụ ruo ole mgbe ka ị ga-anọgide hapụ imere Jerusalem na obodo niile nke Juda ebere, bụ obodo ị na-eweso iwe iri afọ asaa ndị a gara aga?\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.12",
            "verseOrgIds": [
              "ZEC.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ZEC 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.13",
            "verseOrgIds": [
              "ZEC.1.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.1.13",
                "verseOrgIds": [
                  "ZEC.1.13"
                ]
              }
            }
          ]
        },
        {
          "text": "gwara mmụọ ozi ahụ guzo na-agwa m okwu, okwu nkasiobi na okwu ọma dị iche iche.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.13",
            "verseOrgIds": [
              "ZEC.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ZEC 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, mmụọ ozi ahụ nọ na-agwa m okwu gwara m sị, \"Kwusaa ozi a, otu a ka",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.14",
            "verseOrgIds": [
              "ZEC.1.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.1.14",
                "verseOrgIds": [
                  "ZEC.1.14"
                ]
              }
            }
          ]
        },
        {
          "text": ", Onye pụrụ ime ihe niile kwuru sị, 'Ekworo m dị ukwuu nʼebe Jerusalem na Zayọn nọ,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.14",
            "verseOrgIds": [
              "ZEC.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ZEC 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "ma iwe m dị ukwuu megide ndị mba niile ahụ onwe ha juru afọ. Nʼihi na mgbe iwe m dị nta, ha nyere aka ime ka ahụhụ ahụ karịa njọ.'",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.15",
            "verseOrgIds": [
              "ZEC.1.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ZEC 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nʼihi ya, ihe ndị a ka",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.16",
            "verseOrgIds": [
              "ZEC.1.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.1.16",
                "verseOrgIds": [
                  "ZEC.1.16"
                ]
              }
            }
          ]
        },
        {
          "text": "kwuru, 'Aga m eji obi ebere lọghachi na Jerusalem. Nʼebe ahụ kwa ka a ga-ewugharị ụlọnsọ ukwuu m. A ga-esetikwa eriri e ji atụ ihe nʼelu Jerusalem.' Otu a ka",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.16",
            "verseOrgIds": [
              "ZEC.1.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.1.16",
                "verseOrgIds": [
                  "ZEC.1.16"
                ]
              }
            }
          ]
        },
        {
          "text": ", Onye pụrụ ime ihe niile kwubiri.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.16",
            "verseOrgIds": [
              "ZEC.1.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ZEC 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kwusaakwa ọzọ, otu a ka",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.17",
            "verseOrgIds": [
              "ZEC.1.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.1.17",
                "verseOrgIds": [
                  "ZEC.1.17"
                ]
              }
            }
          ]
        },
        {
          "text": ", Onye pụrụ ime ihe niile kwuru. 'Ọganihu ga-adịkwa nʼobodo m niile ọzọ.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.17",
            "verseOrgIds": [
              "ZEC.1.17"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.17",
            "verseOrgIds": [
              "ZEC.1.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.1.17",
                "verseOrgIds": [
                  "ZEC.1.17"
                ]
              }
            }
          ]
        },
        {
          "text": "ga-akasị Zayọn obi ọzọ, ma họpụtakwa Jerusalem.' \"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.17",
            "verseOrgIds": [
              "ZEC.1.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mpi anọ na ndị ọkpụ ụzụ anọ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ZEC 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, eweliri m anya m abụọ elu hụ mpi anọ.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.18",
            "verseOrgIds": [
              "ZEC.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ZEC 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ajụrụ m mmụọ ozi ahụ na-agwa m okwu sị, \"Gịnị ka ihe ndị a bụ?\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.19",
            "verseOrgIds": [
              "ZEC.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "ZEC 1:19"
      },
      "items": [
        {
          "text": "Ọ sịrị m, \"Ndị a bụ mpi ndị ahụ chụsasịrị Juda, na Izrel, na Jerusalem.\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.19",
            "verseOrgIds": [
              "ZEC.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ZEC 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.20",
            "verseOrgIds": [
              "ZEC.2.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.1.20",
                "verseOrgIds": [
                  "ZEC.2.3"
                ]
              }
            }
          ]
        },
        {
          "text": "gosiri m ndị ọkpụ ụzụ anọ.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.20",
            "verseOrgIds": [
              "ZEC.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ZEC 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asịrị m, \"Gịnị ka ndị na-abịa ime?\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.21",
            "verseOrgIds": [
              "ZEC.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "ZEC 1:21"
      },
      "items": [
        {
          "text": "Ọ zaghachiri m, \"Ndị a bụ mpi anọ ndị ahụ chụsasịrị Juda, ime ka onye ọbụla ghara inwe ike iwelite isi ya. Ma ndị a abịala imenye ha ụjọ, na ịtụda mpi mba niile, bụ ndị ahụ buliri mpi ha imegide ala Juda, na ịchụsa ndị ya.\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.21",
            "verseOrgIds": [
              "ZEC.2.4"
            ]
          }
        }
      ]
    }
