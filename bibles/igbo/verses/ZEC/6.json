  "verseCount": 15,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
        "style": "c",
        "sid": "ZEC 6"
      },
      "items": [
        {
          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ụgbọala anọ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ZEC 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elelikwara m anya elu ọzọ hụ ụgbọ ịnyịnya anọ nke si nʼetiti ugwu abụọ na-apụta. Ugwu ndị a bụ ugwu e ji bronz mee.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.6.1",
            "verseOrgIds": [
              "ZEC.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ZEC 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụgbọ ịnyịnya nke mbụ ka ịnyịnya na-acha ọbara ọbara na-adọkpụ. Nke abụọ ka ịnyịnya na-eji nji na-adọkpụ.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.6.2",
            "verseOrgIds": [
              "ZEC.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ZEC 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nke atọ ka ịnyịnya dị ọcha na-adọkpụ, ma nke anọ ka ịnyịnya tụrụ agwa siekwa ike na-adọkpụ.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.6.3",
            "verseOrgIds": [
              "ZEC.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ZEC 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ajụrụ m mmụọ ozi ahụ na-agwa m okwu, \"Gịnị ka ihe ndị a bụ, nna m ukwu?\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.6.4",
            "verseOrgIds": [
              "ZEC.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ZEC 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mmụọ ozi ahụ zara m, sị, \"Ndị a bụ mmụọ anọ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.6.5",
            "verseOrgIds": [
              "ZEC.6.5"
            ]
          }
        },
        {
          "text": "nke eluigwe, ka ha na-apụ mgbe ha guzochara nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.6.5",
            "verseOrgIds": [
              "ZEC.6.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.6.5",
                "verseOrgIds": [
                  "ZEC.6.5"
                ]
              }
            }
          ]
        },
        {
          "text": "elu ụwa niile.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.6.5",
            "verseOrgIds": [
              "ZEC.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ZEC 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụgbọala nke ịnyịnya ndị dị oji na-adọkpụ na-aga nʼakụkụ ugwu. Nke ịnyịnya ndị dị ọcha na-adọkpụ na-aga nʼọdịda anyanwụ. Nke ahụ ndị ịnyịnya na-adịghị ezi ọcha na-adọkpụ na-aga nʼakụkụ ndịda.\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.6.6",
            "verseOrgIds": [
              "ZEC.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ZEC 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ịnyịnya ndị ahụ dị ike pụtara, chọọ ka e nye ha ike ijegharị nʼụwa niile, ọ gwara ha sị, \"Gaanụ jegharịa nʼụwa niile.\" Nʼihi ya, ha pụrụ jegharịa nʼụwa niile.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.6.7",
            "verseOrgIds": [
              "ZEC.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ZEC 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, ọ gwara m, \"Ndị ahụ jere nʼakụkụ ugwu emeela ka Mmụọ m dajụọ nʼala dị nʼakụkụ ugwu.\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.6.8",
            "verseOrgIds": [
              "ZEC.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okpueze Joshua",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ZEC 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okwu",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.6.9",
            "verseOrgIds": [
              "ZEC.6.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.6.9",
                "verseOrgIds": [
                  "ZEC.6.9"
                ]
              }
            }
          ]
        },
        {
          "text": "ruru m ntị, sị,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.6.9",
            "verseOrgIds": [
              "ZEC.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ZEC 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Gaa nata Heldai, Tobaija na Jedaya, ndị a dọtara nʼagha si Babilọn lọta ọlaọcha na ọlaedo. Nʼotu ụbọchị ahụ, gakwaa nʼụlọ Josaya nwa Zefanaya.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.6.10",
            "verseOrgIds": [
              "ZEC.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ZEC 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jiri ọlaọcha na ọlaedo ahụ kpụọ otu okpueze, were ya kpukwasị Joshua nwa Jehozadak bụ onyeisi nchụaja nʼisi.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.6.11",
            "verseOrgIds": [
              "ZEC.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ZEC 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gwa ya na ihe ndị a ka",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.6.12",
            "verseOrgIds": [
              "ZEC.6.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.6.12",
                "verseOrgIds": [
                  "ZEC.6.12"
                ]
              }
            }
          ]
        },
        {
          "text": ", Onye pụrụ ime ihe niile kwuru, 'Nke a bụ nwoke ahụ aha ya bụ Ngalaba. Ọ ga-esi nʼebe nke ya wapụta wuo ụlọnsọ ukwu nke",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.6.12",
            "verseOrgIds": [
              "ZEC.6.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.6.12",
                "verseOrgIds": [
                  "ZEC.6.12"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.6.12",
            "verseOrgIds": [
              "ZEC.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ZEC 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ ya ga-arụ ụlọnsọ ukwu nke",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.6.13",
            "verseOrgIds": [
              "ZEC.6.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.6.13",
                "verseOrgIds": [
                  "ZEC.6.13"
                ]
              }
            }
          ]
        },
        {
          "text": ". A ga-eyikwasịkwa ya ịma mma dịka uwe, ọ ga-anọdụ nʼocheeze ya na-achị. Ọ ga-abụ onye nchụaja ga-anọ nʼocheeze ya, mee ka ịdị nʼotu dịrị nʼetiti ha abụọ.'",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.6.13",
            "verseOrgIds": [
              "ZEC.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ZEC 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okpueze ahụ ka a ga-enye Heldaya, Tobaija, Jedaya na Hen, nwa Zefanaya, ka ọ bụrụ ihe ncheta nʼụlọnsọ ukwu nke",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.6.14",
            "verseOrgIds": [
              "ZEC.6.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.6.14",
                "verseOrgIds": [
                  "ZEC.6.14"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.6.14",
            "verseOrgIds": [
              "ZEC.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ZEC 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị nọ nʼebe dị anya ga-esi ebe ahụ bịa nye aka nʼọrụ iwu ụlọnsọ ukwu nke",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.6.15",
            "verseOrgIds": [
              "ZEC.6.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.6.15",
                "verseOrgIds": [
                  "ZEC.6.15"
                ]
              }
            }
          ]
        },
        {
          "text": ". Unu ga-amatakwa na ọ bụ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.6.15",
            "verseOrgIds": [
              "ZEC.6.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.6.15",
                "verseOrgIds": [
                  "ZEC.6.15"
                ]
              }
            }
          ]
        },
        {
          "text": ", Onye pụrụ ime ihe niile zitere m ịbịakwute unu. Ihe ndị a niile ga-eme ma ọ bụrụ na unu akpachapụ anya rubere",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.6.15",
            "verseOrgIds": [
              "ZEC.6.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.6.15",
                "verseOrgIds": [
                  "ZEC.6.15"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke unu isi.\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.6.15",
            "verseOrgIds": [
              "ZEC.6.15"
            ]
          }
        }
      ]
    }
  ],
