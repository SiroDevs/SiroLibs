  "verseCount": 30,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "19",
        "style": "c",
        "sid": "JDG 19"
      },
      "items": [
        {
          "text": "19",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Onye Livayị na iko ya nwanyị",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JDG 19:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼoge a, Izrel enweghị eze na-achị ha.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.1",
            "verseOrgIds": [
              "JDG.19.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JDG 19:1"
      },
      "items": [
        {
          "text": "Nʼoge ahụ kwa, ọ dị otu nwoke, onye Livayị bi nʼebe dị anya nʼala ugwu ugwu Ifrem. Nwoke a gara Betlehem, nʼime Juda, kpọrọ otu nwaagbọghọ ka ọ bụrụ iko ya nwanyị.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.1",
            "verseOrgIds": [
              "JDG.19.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JDG 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma iko ya nwanyị ahụ kwara iko megide ya. Ọ hapụrụ ya laghachi nʼezinaụlọ nne na nna ya na Betlehem, Juda. Ọ nọrọ ọnwa anọ nʼebe ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.2",
            "verseOrgIds": [
              "JDG.19.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JDG 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwoke ahụ kpebiri ịga nʼụlọ nna nwaagbọghọ ahụ ịrịọ ya ka ọ lọghachi. Ọ kpọọrọ otu nʼime ndị ohu ya, duru ịnyịnya ibu abụọ. Mgbe nwoke ahụ bịaruru nʼụlọ ahụ, iko ya nwanyị kpọbatara ya nʼụlọ nna ya. Mgbe nna nwaagbọghọ ahụ hụrụ ya, o jiri ọṅụ kelee ya ekele.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.3",
            "verseOrgIds": [
              "JDG.19.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JDG 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nna nwanyị ahụ rịọrọ ya ka ọ nọnyere ha ụfọdụ oge. Nʼihi nke a, ọ nọnyeere ha ụbọchị atọ. Ha niile nọrọ ọnọdụ obi ụtọ abalị atọ ahụ niile, rie ṅụọkwa.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.4",
            "verseOrgIds": [
              "JDG.19.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JDG 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼụbọchị nke anọ, nwoke ahụ na iko ya jikeere nʼisi ụtụtụ ịlaghachi. Ma nna nwanyị ahụ rịọrọ ha sị ha, \"Jirinụ ihe oriri gbaanụ onwe unu ume. Emesịa unu nwere ike ịlawa.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.5",
            "verseOrgIds": [
              "JDG.19.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JDG 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, ha abụọ nọdụrụ ala rie ihe, ṅụọkwa ihe ọṅụṅụ. Mgbe e mesiri, nna nwaagbọghọ ahụ sịrị ha, \"Biko, nọdụnụ rahụ ụra nʼabalị taa, meekwanụ onwe unu obi ụtọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.6",
            "verseOrgIds": [
              "JDG.19.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma mgbe nwoke ahụ biliri ka ọ laa, nna nwaagbọghọ ahụ, nọgidere ya, nke a mere ka o kwenye ịnọ ruo echi ya.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.7",
            "verseOrgIds": [
              "JDG.19.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JDG 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼisi ụtụtụ ụbọchị nke ise, ha bilikwara ngwangwa jikere ịhapụ ma ịlaghachi. Ọzọkwa, nna nwaagbọghọ ahụ rịọkwara ha sị ha, \"Biko, nọgidenụ nʼụtụtụ taa, ma nʼoge ehihie unu nwere ike laa.\" Nʼihi nke a, ha nọgidekwara rie, ṅụọ.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.8",
            "verseOrgIds": [
              "JDG.19.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JDG 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe nwoke ahụ na iko ya nwanyị, na ohu ya, jikeere ịhapụ, nna nwaagbọghọ ahụ rịọkwara ha sị ha, \"Biko, lee chi ebidola iji ugbu a, abalị adịkwala nso. Biko, nọgide nʼụlọ m naanị abalị taa. Anyị ga-emekwa onwe anyị obi ụtọ abalị taa niile. Ma unu ga-amalite ije unu nʼisi ụtụtụ echi. Mgbe ahụ, unu ga-ala nʼudo.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.9",
            "verseOrgIds": [
              "JDG.19.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JDG 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma nwoke ahụ ekweghị ịnọ ọnọdụ abalị ọzọ, ọ hapụrụ gawa nʼụzọ ije Jebus (ya bụ Jerusalem), ya na ịnyịnya ibu ya abụọ akwadoro maka njem nakwa iko ya nwanyị.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.10",
            "verseOrgIds": [
              "JDG.19.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JDG 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha rutere ebe ahụ oge chi na-akwado iji. Ohu ya sịrị nna ya ukwu, \"Bịa, ka anyị kwụsị nʼobodo ndị Jebus a, nọ ọnọdụ abalị.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.11",
            "verseOrgIds": [
              "JDG.19.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JDG 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma nna ya ukwu zaghachiri, \"Mba! Anyị agaghị aba nʼobodo ndị na abụghị ụmụ Izrel. Anyị ga-aga nʼihu ruo Gibea.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.12",
            "verseOrgIds": [
              "JDG.19.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JDG 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "O kwukwara sị, \"Bịa ka anyị gbalịa iru Gibea maọbụ Rema, nọọ ọnọdụ abalị nʼotu nʼime ebe ndị a.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.13",
            "verseOrgIds": [
              "JDG.19.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JDG 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, ha gara nʼihu nʼije ha. Anwụ dara dịka ha na-eru Gibea dị na Benjamin.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.14",
            "verseOrgIds": [
              "JDG.19.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JDG 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼebe ahụ ka ha kwụsịrị ịnọ ọnọdụ abalị. Ha gara nọrọ na mbara ama obodo ahụ, ma o nweghị onye ọbụla kpọbatara ha ka ha rahụ ụra nʼụlọ ya.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.15",
            "verseOrgIds": [
              "JDG.19.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JDG 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼanyasị ahụ, otu agadi nwoke zutere ha ka o si ịrụ ọrụ nʼubi na-alọghachi, onye si nʼobodo ugwu ugwu Ifrem, ma o bi ka onye ọbịa na Gibea (ndị bi nʼebe a bụ ndị Benjamin).",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.16",
            "verseOrgIds": [
              "JDG.19.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JDG 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe agadi nwoke a hụrụ ndị ije ahụ na mbara ama obodo ahụ, ọ jụrụ ha ajụjụ sị, \"Ebee ka unu si bịa? Ebee ka unu na-aga?\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.17",
            "verseOrgIds": [
              "JDG.19.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JDG 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwoke ahụ zara sị ya, \"Anyị si Betlehem dị na Juda na-alọghachi nʼụlọ anyị dị nʼebe dị anya nʼala ugwu ugwu Ifrem. Esi m ebe ahụ gaa Betlehem dị na Juda, ma ugbu a, ana m aga nʼụlọ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.18",
            "verseOrgIds": [
              "JDG.19.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JDG.19.18",
                "verseOrgIds": [
                  "JDG.19.18"
                ]
              }
            }
          ]
        },
        {
          "text": ". O nweghị onye kpọbatara anyị nʼụlọ ya.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.18",
            "verseOrgIds": [
              "JDG.19.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JDG 19:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyị nwere ihe oriri nke ịnyịnya ibu anyị ga-eri, achịcha na mmanya nke anyị bụ ndị ohu gị ga-eri, ya bụ, mụ onwe m na ohu gị nwanyị na nwokorobịa so anyị. Anyị achọghị ihe ọbụla nʼaka onye ọbụla.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.19",
            "verseOrgIds": [
              "JDG.19.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JDG 19:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agadi nwoke ahụ sịrị ha, \"Batanụ nʼụlọ m dịka ndị ọbịa nke m. Ka m nye unu ihe niile bụ mkpa unu. Naanị unu anọla ọnọdụ abalị nʼama.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.20",
            "verseOrgIds": [
              "JDG.19.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JDG 19:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi nke a, ọ kpọbatara ha nʼụlọ ya. O duuru ịnyịnya ibu ha, nye ha ihe oriri. Emesịa, ha sara ụkwụ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.21",
            "verseOrgIds": [
              "JDG.19.21"
            ]
          }
        },
        {
          "text": "ha mmiri, nọdụ ala rie ma ṅụọkwa.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.21",
            "verseOrgIds": [
              "JDG.19.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JDG 19:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma mgbe ha risiri nri, nọrọ na-ezu ike, na-akpakọrịta ụka, na mberede, ndị ikom ụfọdụ sitere nʼobodo ahụ, ndị jọgburu onwe ha nʼomume gbara ụlọ ahụ gburugburu. Ha malitekwara iti aka nʼụzọ ahụ na iti mkpu na-akpọku agadi nwoke ahụ, sị ya, \"Kpọpụta onye ọbịa ahụ nọ nʼime ụlọ gị ka anyị mara ya.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.22",
            "verseOrgIds": [
              "JDG.19.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JDG 19:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agadi nwoke ahụ bụ onyenwe ụlọ ahụ pụkwuuru ha nʼezi, sị ha, \"Biko ụmụnna m, unu emela ihe ọjọọ dị otu a. Nwoke a nọ nʼụlọ m dịka ọbịa. Unu emela ihe ihere dị otu a.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.23",
            "verseOrgIds": [
              "JDG.19.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JDG 19:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka m kpọpụtara unu nwa m nwanyị na-amaghị nwoke, na iko nwanyị nwoke a ka unu jiri ha mee ihe ọbụla unu chọrọ ma hapụnụ nwoke a. Unu emela ihe ihere dị otu a.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.24",
            "verseOrgIds": [
              "JDG.19.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JDG 19:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ndị ikom ahụ egeghị ya ntị. Ya mere, nwoke ahụ kpọpụtara iko ya nwanyị zipụrụ ha ya nʼezi. Ha niile nʼotu na otu, dinakwuru nwanyị ahụ abalị ahụ niile. Mgbe chi na-achọ ịbọ, ha hapụrụ ya ka ọ laa.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.25",
            "verseOrgIds": [
              "JDG.19.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JDG 19:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼisi ụtụtụ, nwanyị ahụ biliri laghachi azụ nʼụlọ ahụ iko ya nwoke nọ. Ma ọ dara nʼala nʼihu ọnụ ụzọ ụlọ ahụ tọgbọrọ nʼebe ahụ tutu chi abọzie.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.26",
            "verseOrgIds": [
              "JDG.19.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JDG 19:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe nwoke ahụ biliri nʼụtụtụ, meghee ụzọ ka ọ malite ije ya, ọ hụrụ iko ya nwanyị ahụ ka ọ tọgbọ nʼọnụ ụzọ ahụ. Aka ya abụọ dịkwa nʼọnụ ụzọ mbata ụlọ ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.27",
            "verseOrgIds": [
              "JDG.19.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JDG 19:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwoke ahụ kpọkuru ya sị ya, \"Ngwa, bilie ka anyị laa.\" Ma nwaagbọghọ ahụ ekwughị okwu ọbụla. Nwoke ahụ buliri ya, tụkwasị ya nʼelu ịnyịnya ibu ya, buru ya laa nʼobodo nke aka ya.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.28",
            "verseOrgIds": [
              "JDG.19.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JDG 19:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ọ bịaruru obodo ya, ọ banyere nʼụlọ ya wepụta mma jiri ya bọwaa ozu iko ya nwanyị ahụ ụzọ iri na abụọ. O zigaara ebo iri na abụọ niile dị nʼIzrel otu ụzọ, otu ụzọ.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.29",
            "verseOrgIds": [
              "JDG.19.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JDG 19:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi nke a, Onye ọbụla hụrụ ihe ọjọọ a kwuru sị, \"O nwebeghị onye ọbụla mere ụdị ajọ omume dị otu a kemgbe ụmụ Izrel si nʼobodo Ijipt pụta. Chee echiche banyere ihe a. Tulee ya ma gwa anyị ihe anyị ga-eme?\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.30",
            "verseOrgIds": [
              "JDG.19.30"
            ]
          }
        }
      ]
    }
  ],
