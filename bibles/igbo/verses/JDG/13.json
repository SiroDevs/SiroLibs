            "sid": "JDG 13:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma nwunye ya zara sị ya, \"Ọ bụrụ na",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.23",
            "verseOrgIds": [
              "JDG.13.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JDG.13.23",
                "verseOrgIds": [
                  "JDG.13.23"
                ]
              }
            }
          ]
        },
        {
          "text": "chọrọ igbu anyị, ọ garaghị anara aja nsure ọkụ, na aja mkpụrụ ọka anyị chụrụ nye ya. Ọzọkwa, ọ garaghị egosi anyị ihe ndị a niile maọbụ gwa anyị ihe ndị a.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.23",
            "verseOrgIds": [
              "JDG.13.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
