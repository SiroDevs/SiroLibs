                "verseId": "JDG.13.25",
                "verseOrgIds": [
                  "JDG.13.25"
                ]
              }
            }
          ]
        },
        {
          "text": "bidokwara na-agba ya ume nʼoge niile, mgbe ọ nọ Mahane Dan, nke dị nʼetiti Zora na Eshtaol.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.25",
