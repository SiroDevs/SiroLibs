  "verseCount": 20,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "14",
        "style": "c",
        "sid": "JDG 14"
      },
      "items": [
        {
          "text": "14",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ọlụlụ nwunye Samsin",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JDG 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samsin gbadara nʼobodo Timna",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.1",
            "verseOrgIds": [
              "JDG.14.1"
            ]
          }
        },
        {
          "text": "ebe ọ hụrụ otu nwaagbọghọ onye Filistia.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.1",
            "verseOrgIds": [
              "JDG.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JDG 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ọ lọtara nʼụlọ, ọ gwara nne na nna ya, \"Ahụrụ m otu nwanyị nʼime Timna",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.2",
            "verseOrgIds": [
              "JDG.14.2"
            ]
          }
        },
        {
          "text": "sitere nʼụmụ ndị inyom Filistia; ugbu a, lụtara m ya na nwunye.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.2",
            "verseOrgIds": [
              "JDG.14.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JDG 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nne na nna ya zara ya, \"Ọ bụ na ọ dịghị nwanyị dị nʼetiti ndị inyom ụmụnne gị, maọbụ nʼetiti ndị anyị niile? Gịnị mere o ji bụrụ nʼetiti ndị Filistia a na-ebighị ugwu ka i si lụtara onwe gị nwunye?\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.3",
            "verseOrgIds": [
              "JDG.14.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JDG 14:3"
      },
      "items": [
        {
          "text": "Ma Samsin sịrị nna ya, \"Gaa lụtara m ya. Nʼihi na o ziri ezi nʼanya m.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.3",
            "verseOrgIds": [
              "JDG.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JDG 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Nne na nna ya aghọtaghị na aka",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.4",
            "verseOrgIds": [
              "JDG.14.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JDG.14.4",
                "verseOrgIds": [
                  "JDG.14.4"
                ]
              }
            }
          ]
        },
        {
          "text": "dị nʼọlụlụ nwunye a Samsin chọrọ ịlụ. Nʼihi na",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.4",
            "verseOrgIds": [
              "JDG.14.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JDG.14.4",
                "verseOrgIds": [
                  "JDG.14.4"
                ]
              }
            }
          ]
        },
        {
          "text": "na-achọ ụzọ ọ ga-esi megide ndị Filistia, ndị na-achị ụmụ Izrel nʼoge ahụ.)",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.4",
            "verseOrgIds": [
              "JDG.14.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JDG 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samsin na nne na nna ya gawara obodo Timna maka ọlụlụ nwanyị a. Mgbe ha na-erute ubi vaịnị dị obodo Timna nso, otu",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.5",
            "verseOrgIds": [
              "JDG.14.5"
            ]
          }
        },
        {
          "text": "nwa ọdụm sitere nʼọhịa mapụta, gbọrọ ụja na-abịakwute Samsin.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.5",
            "verseOrgIds": [
              "JDG.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JDG 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼotu oge ahụ, Mmụọ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.6",
            "verseOrgIds": [
              "JDG.14.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JDG.14.6",
                "verseOrgIds": [
                  "JDG.14.6"
                ]
              }
            }
          ]
        },
        {
          "text": "bịakwasịrị Samsin nʼike. O jekwuuru ọdụm ahụ, were aka ya abụọ dọwaa ya ọnụ, dịka a ga-asị na ọ bụ nwa ewu. Ma Samsin agwaghị nne na nna ya ihe mere.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.6",
            "verseOrgIds": [
              "JDG.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma mgbe ha bịaruru Timna, Samsin na nwaagbọghọ ahụ kparịtara ụka. Ihe banyere nwaagbọghọ ahụ dị Samsin ezi mma.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.7",
            "verseOrgIds": [
              "JDG.14.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JDG 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ laghachiri mgbe ụbọchị ole na ole gasịrị ka ọ kpọrọ ya. Ma mgbe ọ tụgharịrị ka ọ hụ ozu ọdụm ahụ, ọ hụrụ na igwe aṅụ bizi nʼime ozu ọdụm ahụ, na-emepụtakwa mmanụ aṅụ.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.8",
            "verseOrgIds": [
              "JDG.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JDG 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ kọpụtara mmanụ aṅụ ahụ tinye nʼaka ya, malite ịracha ka ọ na-aga nʼụzọ. Mgbe ọ bịakwutere nne na nna ya, o nyebinyere ha ụfọdụ, ha onwe ha rachakwara ya. Ma ọ gwaghị ha na o wetara ya site nʼozu ọdụm.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.9",
            "verseOrgIds": [
              "JDG.14.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JDG 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nna ya gara ịhụ nwanyị ahụ ma Samsin kpọkọtara ụmụ okorobịa obodo ahụ meere ha oriri dịka omenaala ha sị di.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.10",
            "verseOrgIds": [
              "JDG.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JDG 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Samsin rutere, a kpọnyere ya ndị bịara mmemme ọnụọgụgụ ha dị iri atọ.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.11",
            "verseOrgIds": [
              "JDG.14.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JDG 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Samsin gwara ha okwu sị ha, \"O nwere ajụjụ, gwa m, gwa m, gwa m, m chọrọ ka unu kọwaara m. Ọ bụrụ na unu enwee ike kọwaa ya, site taa ruo nʼụbọchị asaa nke mmemme a, aga m enye unu iri uwe mwụda atọ, nyekwa unu iri uwe mwụda atọ ọzọ akpara akpa.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.12",
            "verseOrgIds": [
              "JDG.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JDG 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụkwanụ na unu enweghị ike kọwaa ya, unu ga-enye m iri uwe mwụda atọ, na iri uwe mwụda atọ akpara akpa.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.13",
            "verseOrgIds": [
              "JDG.14.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JDG 14:13"
      },
      "items": [
        {
          "text": "Ha niile kwenyere sị, \"Ọ dị mma. Kwuo ka anyị nụ.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.13",
            "verseOrgIds": [
              "JDG.14.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JDG 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ gwara ha sị,",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.14",
            "verseOrgIds": [
              "JDG.14.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JDG 14:14"
      },
      "items": [
        {
          "text": "\"Ihe oriri si nʼime onye na-eri eri na-apụta,",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.14",
            "verseOrgIds": [
              "JDG.14.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JDG 14:14"
      },
      "items": [
        {
          "text": "ọzọkwa, ihe dị ụtọ si nʼime onye dị ike pụta.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.14",
            "verseOrgIds": [
              "JDG.14.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m",
        "vid": "JDG 14:14"
      },
      "items": [
        {
          "text": "Mgbe ụbọchị atọ gasịrị, ha enwebeghịkwa ike kọwaa ya.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.14",
            "verseOrgIds": [
              "JDG.14.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JDG 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma nʼụbọchị nke anọ, ha jekwuuru nwunye Samsin gwa ya okwu sị, \"Chọọ ụzọ rafụta di gị ọnụ, ka ọ gwa gị ihe okwu a pụtara. Ma ọ bụghị ya, anyị ga-akpọ gị na ezinaụlọ nna gị ọkụ. Ọ bụ ịnapụ anyị ihe anyị nwere ka unu ji kpọọ anyị oku bịa nʼebe?\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.15",
            "verseOrgIds": [
              "JDG.14.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JDG 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ nwunye Samsin buuru onwe ya tụọ nʼelu ahụ ya, nʼebe akwa, sị, \"Ị kpọrọ m asị! Nʼezie, ị hụghị m nʼanya. Ị tụụrụ ndị m ilu, ma ị gwaghị m ọsịsa ya.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.16",
            "verseOrgIds": [
              "JDG.14.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JDG 14:16"
      },
      "items": [
        {
          "text": "Ọ sịrị ya, \"Lee, agwaghị m nne na nna m, ọ bụkwa gị ka m ga akọwara ya?\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.16",
            "verseOrgIds": [
              "JDG.14.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JDG 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma nwanyị ahụ kwagidere akwa abalị asaa ha nọ na mmemme ahụ. Nʼikpeazụ, nʼụbọchị nke asaa, Samsin kọwaara ya okwu ahụ nʼihi na ọ nọgidere na-enye ya nsogbu. Nwanyị ahụ gakwara kọwaara ụmụ okorobịa obodo ihe okwu ahụ pụtara.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.17",
            "verseOrgIds": [
              "JDG.14.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JDG 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma tupu anwụ adaa nʼụbọchị nke asaa ahụ, ndị ikom obodo ahụ sịrị ya,",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.18",
            "verseOrgIds": [
              "JDG.14.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JDG 14:18"
      },
      "items": [
        {
          "text": "\"Olee ihe dị ụtọ karịa mmanụ aṅụ?",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.18",
            "verseOrgIds": [
              "JDG.14.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JDG 14:18"
      },
      "items": [
        {
          "text": "Gịnị dịkwa ike karịa ọdụm?\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.18",
            "verseOrgIds": [
              "JDG.14.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
