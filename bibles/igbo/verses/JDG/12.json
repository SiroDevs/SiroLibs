  "verseCount": 15,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "12",
        "style": "c",
        "sid": "JDG 12"
      },
      "items": [
        {
          "text": "12",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jefta na ndị Ifrem",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JDG 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, ndị Ifrem kpọkọtara ndị agha ha na Zafọn zigara Jefta ozi sị ya, \"Gịnị mere ị kpọghị anyị ka anyị bịa nyere gị aka ịlụso ndị Amọn agha? Anyị na-abịa iwere ọkụ irechapụ gị na ezinaụlọ gị.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.12.1",
            "verseOrgIds": [
              "JDG.12.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JDG 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jefta zaghachiri ha sị, \"Akpọrọ m unu mgbe mụ na ndị m na ndị Amọn na-ese okwu dị ukwu ma unu jụrụ ịbịa. Unu azọpụtaghị m site nʼaka ha.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.12.2",
            "verseOrgIds": [
              "JDG.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JDG 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe m hụrụ na unu achọghị inyere anyị aka, e tinyere m ndụ m nʼaka m, gabiga nʼofe nke ọzọ ibuso ndị Amọn agha. Ma",
          "type": "text",
          "attrs": {
            "verseId": "JDG.12.3",
            "verseOrgIds": [
              "JDG.12.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JDG.12.3",
                "verseOrgIds": [
                  "JDG.12.3"
                ]
              }
            }
          ]
        },
        {
          "text": "nyeere m aka imeri ha. Ugbu a, nʼihi gịnị ka unu ji bịa ịlụso m ọgụ taa?\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.12.3",
            "verseOrgIds": [
              "JDG.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JDG 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jefta kpọkọtara ndị ikom Gilead pụọ buso ndị Ifrem agha. Ndị Gilead tidara ha nʼala nʼihi na ndị Ifrem sịrị, \"Ndị gbapụrụ agbapụ site nʼIfrem na Manase ka unu bụ.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.12.4",
            "verseOrgIds": [
              "JDG.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JDG 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ nọchiri akụkụ Jọdan dị ndị agha Ifrem nʼazụ, ebe ndị agha Ifrem nwere ike isi gbapụ. Mgbe ọbụla onye agha Ifrem ọbụla gbapụrụ ọsọ chọọ ịgafe osimiri ahụ, ndị agha Gilead ga-ejide ya jụọ ya sị, \"Ị bụ onye Ifrem?\" Ọ bụrụ na onye ahụ ekwuo na ya abụghị onye Ifrem,",
          "type": "text",
          "attrs": {
            "verseId": "JDG.12.5",
            "verseOrgIds": [
              "JDG.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JDG 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "ha sịrị, \"Ọ dị mma, kpọọ, 'Shibolet.' \" Ọ bụrụ na onye ahụ akpọ, \"Sibolet,\" nʼihi na ọ kpọpụtaghị mkpụrụ okwu ahụ nke ọma, ha na-akpụrụ ya gbuo ya na ngabiga mmiri Jọdan. Ọ bụ ọnụọgụgụ iri puku anọ, na puku abụọ ndị Ifrem ka e gburu mgbe ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.12.6",
            "verseOrgIds": [
              "JDG.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jefta duuru ndị Izrel afọ isii. Mgbe ọ nwụrụ, e liri ya nʼotu obodo Gilead.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.12.7",
            "verseOrgIds": [
              "JDG.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ibzan, Elọn, na Abdon",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JDG 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye ikpe ọzọ Izrel nwere bụ Ibzan onye bi na Betlehem.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.12.8",
            "verseOrgIds": [
              "JDG.12.8"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JDG.12.8",
            "verseOrgIds": [
              "JDG.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JDG 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "O nwere iri ụmụ ndị ikom atọ na iri ụmụ ndị inyom atọ. O kenyere ndị ikom ikwu ọzọ ụmụ ya ndị inyom. Otu a kwa, o sikwa nʼikwu ọzọ lụtara ụmụ ya ndị ikom iri ndị inyom atọ. O kpere Izrel ikpe afọ asaa.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.12.9",
            "verseOrgIds": [
              "JDG.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JDG 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibzan nwụrụ, e lie ya na Betlehem.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.12.10",
            "verseOrgIds": [
              "JDG.12.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JDG 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye ọzọ kpere Izrel ikpe bụ Elọn, onye Zebụlọn. O kpere Izrel ikpe afọ iri.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.12.11",
            "verseOrgIds": [
              "JDG.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JDG 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emesịa, Elọn nwụrụ, e lie ya nʼAijalon, nʼime ala Zebụlọn.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.12.12",
            "verseOrgIds": [
              "JDG.12.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JDG 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye ọzọ kpere Izrel ikpe bụ Abdon nwa Hilel, onye Piraton.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.12.13",
            "verseOrgIds": [
              "JDG.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JDG 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "O nwere iri ụmụ ndị ikom anọ na iri ụmụ ụmụ atọ ndị na-agba iri ịnyịnya ibu asaa. O kpere ụmụ Izrel ikpe afọ asatọ.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.12.14",
            "verseOrgIds": [
              "JDG.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JDG 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Abdon nwa Hilel nwụrụ, e lie ya na Piraton ala dị nʼIfrem, nʼobodo ugwu ndị Amalek.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.12.15",
            "verseOrgIds": [
              "JDG.12.15"
            ]
          }
        }
      ]
    }
  ],
