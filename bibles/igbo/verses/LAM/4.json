      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 4:18"
      },
      "items": [
        {
          "text": "nʼihi ya anyị enweghị ike jegharịakwa nʼokporoụzọ anyị.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.18",
            "verseOrgIds": [
              "LAM.4.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "LAM 4:18"
      },
      "items": [
        {
          "text": "Ọgwụgwụ anyị adịla nso, a pụkwara ịgụta ụbọchị ole fọdụụrụ anyị,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.18",
            "verseOrgIds": [
              "LAM.4.18"
            ]
          }
        }
      ]
    },
