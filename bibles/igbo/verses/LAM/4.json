          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nke ka nke, anya agbaala anyị ọchịchịrị,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.17",
            "verseOrgIds": [
              "LAM.4.17"
            ]
