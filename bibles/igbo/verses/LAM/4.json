      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 4:20"
      },
      "items": [
        {
          "text": "nʼetiti mba dị iche iche.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.20",
            "verseOrgIds": [
              "LAM.4.20"
            ]
          }
        }
      ]
    },
