          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gị ada Zayọn, ahụhụ gị agwụsịala;",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.22",
            "verseOrgIds": [
              "LAM.4.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 4:22"
      },
      "items": [
        {
          "text": "Ọ gaghị emekwa ka i jee biri ogologo oge na mba ọzọ.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.22",
            "verseOrgIds": [
              "LAM.4.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "LAM 4:22"
      },
      "items": [
        {
          "text": "Kama, ọ ga-ata gị ahụhụ nʼihi mmehie gị, gị, ada Edọm,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.22",
            "verseOrgIds": [
              "LAM.4.22"
            ]
          }
        }
