              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ume ndụ anyị, nke",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.20",
            "verseOrgIds": [
              "LAM.4.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "LAM.4.20",
                "verseOrgIds": [
                  "LAM.4.20"
                ]
              }
            }
          ]
        },
        {
          "text": "tere mmanụ,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.20",
            "verseOrgIds": [
              "LAM.4.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 4:20"
      },
      "items": [
        {
          "text": "ka ha jidere nʼọnya ha.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.20",
            "verseOrgIds": [
              "LAM.4.20"
            ]
          }
        }
      ]
    },
    {
