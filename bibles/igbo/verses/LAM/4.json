              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị na-achụ anyị ọsọ na-agbasi ọsọ ike",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.19",
            "verseOrgIds": [
              "LAM.4.19"
            ]
          }
        }
      ]
    },
