      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 4:19"
      },
      "items": [
        {
          "text": "karịa ugo na-efe na mbara eluigwe.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.19",
            "verseOrgIds": [
              "LAM.4.19"
            ]
          }
        }
      ]
    },
