          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṅụrịa ọṅụ, ka obi tọkwaa gị ụtọ, gị ada Edọm,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.21",
            "verseOrgIds": [
              "LAM.4.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 4:21"
      },
      "items": [
        {
          "text": "onye nke bi nʼala Uz.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.21",
            "verseOrgIds": [
              "LAM.4.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "LAM 4:21"
      },
      "items": [
        {
          "text": "Ma a ga-emesịakwa nye gị iko ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.21",
            "verseOrgIds": [
              "LAM.4.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 4:21"
      },
      "items": [
        {
          "text": "Ị ga-esitekwa na ya ṅụọ ihe ọṅụṅụ ṅụjụbiga afọ oke. A ga-agbakwa gị ọtọ.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.21",
            "verseOrgIds": [
              "LAM.4.21"
            ]
          }
        }
      ]
