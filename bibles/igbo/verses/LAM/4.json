          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị mmadụ na-esogharị anyị ebe niile anyị jere,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.18",
            "verseOrgIds": [
              "LAM.4.18"
            ]
          }
        }
      ]
    },
