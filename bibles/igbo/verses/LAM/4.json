      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 4:14"
      },
      "items": [
        {
          "text": "O nwekwaghị onye na-agbalị ịbịaru ha nso ịmetụ uwe ha aka.",
