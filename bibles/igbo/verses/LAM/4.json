            "style": "v",
            "sid": "LAM 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị mmadụ na-eti mkpu na-asị ha, \"Sitenụ nʼebe anyị nọ wezuga onwe unu! Unu rụrụ arụ!",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.15",
            "verseOrgIds": [
              "LAM.4.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 4:15"
      },
      "items": [
        {
          "text": "Wezuganụ onwe unu, unu emetụkwala anyị aka!\"",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.15",
            "verseOrgIds": [
              "LAM.4.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "LAM 4:15"
      },
      "items": [
        {
          "text": "Mgbe ha gbapụrụ ọsọ bido na-awagharị,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.15",
            "verseOrgIds": [
              "LAM.4.15"
            ]
          }
        }
      ]
    },
