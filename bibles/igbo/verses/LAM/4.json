      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "LAM 4:20"
      },
      "items": [
        {
          "text": "Anyị naara eche na anyị ga-ebi nʼokpuru ndo ya,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.20",
            "verseOrgIds": [
              "LAM.4.20"
            ]
          }
        }
      ]
    },
