      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "LAM 4:19"
      },
      "items": [
        {
          "text": "Ha chụgharịrị anyị nʼelu ugwu niile,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.19",
            "verseOrgIds": [
              "LAM.4.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 4:19"
      },
      "items": [
        {
          "text": "nọrọkwa nʼọzara zoo onwe ha na-eche anyị.",
