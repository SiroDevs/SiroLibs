      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 4:17"
      },
      "items": [
        {
          "text": "maka ọbịbịa mba ahụ na-enweghị ike bịa zọpụta anyị.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.17",
            "verseOrgIds": [
              "LAM.4.17"
            ]
          }
        }
      ]
    },
