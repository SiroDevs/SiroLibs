      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 4:15"
      },
      "items": [
        {
          "text": "ndị nọ na mba dị iche iche na-asị ha,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.15",
            "verseOrgIds": [
              "LAM.4.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 4:15"
      },
      "items": [
        {
          "text": "\"O kwesighị ka ha nọrọkwa nʼebe a.\"",
