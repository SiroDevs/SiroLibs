                  "LAM.4.16"
                ]
              }
            }
          ]
        },
        {
          "text": "nʼonwe ya achụsaala ha.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.16",
            "verseOrgIds": [
              "LAM.4.16"
            ]
