  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "LAM 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LAM 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lee ka ọlaedo si chuo echu.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.1",
            "verseOrgIds": [
              "LAM.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 4:1"
      },
      "items": [
        {
          "text": "Lee ka ọlaedo makarịsịrị mma si gbanwee ghọọ ihe na-amakwaghị mma.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.1",
            "verseOrgIds": [
              "LAM.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "LAM 4:1"
      },
      "items": [
        {
          "text": "Nkume niile dị oke ọnụahịa nke ebe nsọ bụ",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.1",
            "verseOrgIds": [
              "LAM.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 4:1"
      },
      "items": [
        {
          "text": "ndị a ghasara nʼisi okporoụzọ niile.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.1",
            "verseOrgIds": [
              "LAM.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LAM 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lee ka ụmụ ndị ikom Zayọn dị oke ọnụahịa,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.2",
            "verseOrgIds": [
              "LAM.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 4:2"
      },
      "items": [
        {
          "text": "ndị dị oke ọnụahịa na mbụ dịka ọlaedo a nụchara anụcha,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.2",
            "verseOrgIds": [
              "LAM.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "LAM 4:2"
      },
      "items": [
        {
          "text": "si dịrị ugbu a dịka ite aja",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.2",
            "verseOrgIds": [
              "LAM.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 4:2"
      },
      "items": [
        {
          "text": "nke ọkpụ ite kpụrụ.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.2",
            "verseOrgIds": [
              "LAM.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LAM 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụladị ụmụ nkịta ọhịa na-eji ara ha",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.3",
            "verseOrgIds": [
              "LAM.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 4:3"
      },
      "items": [
        {
          "text": "azụ ụmụ ha,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.3",
            "verseOrgIds": [
              "LAM.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "LAM 4:3"
      },
      "items": [
        {
          "text": "ma ndị a aghọọla ndị na-enweghị obi ebere;",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.3",
            "verseOrgIds": [
              "LAM.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 4:3"
      },
      "items": [
        {
          "text": "ha aghọọla enyi nnụnụ nke na-ebi nʼọzara.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.3",
            "verseOrgIds": [
              "LAM.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LAM 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lee na ire nwa ọhụrụ na-arapara nʼakpo ọnụ ya",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.4",
            "verseOrgIds": [
              "LAM.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 4:4"
      },
      "items": [
        {
          "text": "nʼihi akpịrị ịkpọ nkụ.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.4",
            "verseOrgIds": [
              "LAM.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "LAM 4:4"
      },
      "items": [
        {
          "text": "Ụmụntakịrị na-arịọkwa ka e nye ha nri,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.4",
            "verseOrgIds": [
              "LAM.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 4:4"
      },
      "items": [
        {
          "text": "ma o nweghị onye na-enye ha nri ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.4",
            "verseOrgIds": [
              "LAM.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LAM 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị ahụ naara eri ihe ụtọ dị iche iche",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.5",
            "verseOrgIds": [
              "LAM.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 4:5"
      },
      "items": [
        {
          "text": "tọgbọrọ nʼefu ugbu a nʼokporoụzọ.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.5",
            "verseOrgIds": [
              "LAM.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "LAM 4:5"
      },
      "items": [
        {
          "text": "Ndị ahụ a zụrụ iyi uwe uhie uhie",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.5",
            "verseOrgIds": [
              "LAM.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 4:5"
      },
      "items": [
        {
          "text": "nọ ugbu a na-edina nʼebe a na-ekpofu ahịhịa.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.5",
            "verseOrgIds": [
              "LAM.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LAM 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahụhụ dịịrị ndị m dị ukwuu",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.6",
            "verseOrgIds": [
              "LAM.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 4:6"
      },
      "items": [
        {
          "text": "karịa ahụhụ nke bịakwasịrị Sọdọm.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.6",
            "verseOrgIds": [
              "LAM.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "LAM 4:6"
      },
      "items": [
        {
          "text": "Nʼihi na ọ bụ nʼotu ntabi anya ka a kwatụrụ ya.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.6",
            "verseOrgIds": [
              "LAM.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 4:6"
      },
      "items": [
        {
          "text": "Ọ dịkwaghị onye bịara nyere ya aka.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.6",
            "verseOrgIds": [
              "LAM.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LAM 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụmụ ndị eze ha na-egbuke karịa akụmmiri igwe,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.7",
            "verseOrgIds": [
              "LAM.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 4:7"
      },
      "items": [
        {
          "text": "ha na-acha ọcha chakarịa mmiri ara ehi.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.7",
            "verseOrgIds": [
              "LAM.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "LAM 4:7"
      },
      "items": [
        {
          "text": "Anụ ahụ ha na-akwọ mụrụmụrụ dịka nkume rubi dị oke ọnụahịa;",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.7",
            "verseOrgIds": [
              "LAM.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 4:7"
      },
      "items": [
        {
          "text": "ha makwara mma ile anya dịka nkume safaia, bụ nkume dị oke ọnụahịa.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.7",
            "verseOrgIds": [
              "LAM.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LAM 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ugbu a, ha na-eji nji karịa unyi.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.8",
            "verseOrgIds": [
              "LAM.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 4:8"
      },
      "items": [
        {
          "text": "A naghị amatakwa ha ma a hụ ha nʼezi.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.8",
            "verseOrgIds": [
              "LAM.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "LAM 4:8"
      },
      "items": [
        {
          "text": "Anụ ahụ ha araparala nʼọkpụkpụ ha;",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.8",
            "verseOrgIds": [
              "LAM.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 4:8"
      },
      "items": [
        {
          "text": "ọ kpọnwụọla dịka a ga-asị na ọ bụ osisi kpọrọ nkụ.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.8",
            "verseOrgIds": [
              "LAM.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LAM 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọnọdụ ndị e ji mma agha gbuo ka mma",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.9",
            "verseOrgIds": [
              "LAM.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 4:9"
      },
      "items": [
        {
          "text": "karịa ọnọdụ ndị nwụrụ site nʼụnwụ,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.9",
            "verseOrgIds": [
              "LAM.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "LAM 4:9"
      },
      "items": [
        {
          "text": "ndị agụụ gụgburu, ndị ji nwayọọ nwayọọ nwụọ",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.9",
            "verseOrgIds": [
              "LAM.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 4:9"
      },
      "items": [
        {
          "text": "nʼihi nri nke na-adịghị nʼubi.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.9",
            "verseOrgIds": [
              "LAM.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LAM 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aka ha ka ndị inyom ndị ahụ nwere obi ebere",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.10",
            "verseOrgIds": [
              "LAM.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 4:10"
      },
      "items": [
        {
          "text": "ji gbuo ụmụ ha, sie ha.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.10",
            "verseOrgIds": [
              "LAM.4.10"
            ]
          }
        }
      ]
    },
    {
