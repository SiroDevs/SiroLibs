      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 4:18"
      },
      "items": [
        {
          "text": "tupu ọgwụgwụ anyị eruo.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.18",
            "verseOrgIds": [
              "LAM.4.18"
            ]
          }
        }
      ]
    },
