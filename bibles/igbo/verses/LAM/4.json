      "attrs": {
        "style": "q2",
        "vid": "LAM 4:17"
      },
      "items": [
        {
          "text": "ebe anyị nọ na-elepụ anya nʼefu maka enyemaka.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.17",
            "verseOrgIds": [
              "LAM.4.17"
            ]
          }
        }
      ]
