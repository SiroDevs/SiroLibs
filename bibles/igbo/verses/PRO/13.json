      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 13:25"
      },
      "items": [
        {
          "text": "ma nri na-akọ nʼafọ onye ajọ omume.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.25",
            "verseOrgIds": [
              "PRO.13.25"
