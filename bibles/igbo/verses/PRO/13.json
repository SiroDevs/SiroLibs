      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 13:20"
      },
      "items": [
        {
          "text": "nʼihi na onye na-eso ndị nzuzu na-aba na nsogbu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.20",
            "verseOrgIds": [
              "PRO.13.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
