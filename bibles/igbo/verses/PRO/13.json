          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye ọbụla na-adọghị ụmụ ya aka na ntị, na-egosi na ọ hụghị ha nʼanya;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.24",
            "verseOrgIds": [
              "PRO.13.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 13:24"
      },
      "items": [
        {
          "text": "ma onye hụrụ ha nʼanya, ga-adọsi ha aka na ntị ike.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.24",
            "verseOrgIds": [
              "PRO.13.24"
            ]
          }
        }
      ]
    },
