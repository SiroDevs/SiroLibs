        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PRO 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na-eso ndị maara ihe ka ị ghọọ onye mara ihe,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.20",
            "verseOrgIds": [
              "PRO.13.20"
            ]
          }
        }
      ]
    },
