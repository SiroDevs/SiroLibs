          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubi onye ogbenye pụrụ inwe ọtụtụ ihe oriri,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.23",
            "verseOrgIds": [
              "PRO.13.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 13:23"
      },
      "items": [
        {
          "text": "ma ikpe na-ezighị ezi na-azachapụ ya.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.23",
            "verseOrgIds": [
              "PRO.13.23"
            ]
          }
        }
      ]
    },
    {
