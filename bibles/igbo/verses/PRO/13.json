          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ezi mmadụ nwụrụ, ọ na-ahapụrụ ụmụ ya na ụmụ ụmụ ya akụ,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.22",
            "verseOrgIds": [
              "PRO.13.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 13:22"
      },
      "items": [
        {
          "text": "ma mgbe onye mmehie nwụrụ, akụ ya na-abụ nke ndị ezi omume.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.22",
            "verseOrgIds": [
              "PRO.13.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
