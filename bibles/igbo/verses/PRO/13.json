          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nsogbu bụ ihe na-esogharị ndị mmehie,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.21",
            "verseOrgIds": [
              "PRO.13.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 13:21"
      },
      "items": [
        {
          "text": "ma ngọzị na-esogharị ndị ezi omume.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.21",
            "verseOrgIds": [
              "PRO.13.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
