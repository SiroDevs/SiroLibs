            "number": "19",
            "style": "v",
            "sid": "PRO 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ihe a na-ele anya mezuru ọ na-atọ mkpụrụobi ụtọ,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.19",
            "verseOrgIds": [
              "PRO.13.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 13:19"
      },
      "items": [
        {
          "text": "ma ndị nzuzu kpọrọ isite nʼajọ ihe wezuga onwe ha asị.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.19",
            "verseOrgIds": [
              "PRO.13.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
