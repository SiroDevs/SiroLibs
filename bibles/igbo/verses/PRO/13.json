      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PRO 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye na-ajụ ịdọ aka na ntị ga-anwụ nʼụkpa na nʼihere;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.18",
            "verseOrgIds": [
              "PRO.13.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 13:18"
      },
      "items": [
        {
          "text": "ma onye na-anabata ịdọ aka na ntị ka a ga-asọpụrụ.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.18",
            "verseOrgIds": [
              "PRO.13.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
