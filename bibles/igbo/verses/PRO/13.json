              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye ezi omume na-eri nri ruo na nriju afọ onwe ya,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.25",
            "verseOrgIds": [
              "PRO.13.25"
            ]
          }
        }
      ]
    },
    {
