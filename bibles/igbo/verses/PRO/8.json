  "verseCount": 36,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "8",
        "style": "c",
        "sid": "PRO 8"
      },
      "items": [
        {
          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ọkpụkpọ oku amamihe na-akpọ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ na amamihe adịghị eti mkpu?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.1",
            "verseOrgIds": [
              "PRO.8.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 8:1"
      },
      "items": [
        {
          "text": "Ọ bụ na nghọta anaghị eme ka olu ya daa ụda?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.1",
            "verseOrgIds": [
              "PRO.8.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ na-eguzo nʼelu ebe niile dị elu nʼokporoụzọ,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.2",
            "verseOrgIds": [
              "PRO.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 8:2"
      },
      "items": [
        {
          "text": "nʼagbata ụzọ niile.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.2",
            "verseOrgIds": [
              "PRO.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼọnụ ụzọ nke obodo niile",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.3",
            "verseOrgIds": [
              "PRO.8.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 8:3"
      },
      "items": [
        {
          "text": "na nʼọnụ ụzọ ụlọ niile ka ọ nọ na-eti mkpu,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.3",
            "verseOrgIds": [
              "PRO.8.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "ọ na-asị, \"Ụmụ mmadụ geenụ m ntị;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.4",
            "verseOrgIds": [
              "PRO.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 8:4"
      },
      "items": [
        {
          "text": "ọ bụ unu ndị dị ndụ ka m na-agwa okwu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.4",
            "verseOrgIds": [
              "PRO.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unu ndị na-enweghị uche, nweenụ uche zuruoke;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.5",
            "verseOrgIds": [
              "PRO.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 8:5"
      },
      "items": [
        {
          "text": "unu ndị nzuzu, nweenụ nghọta.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.5",
            "verseOrgIds": [
              "PRO.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Geenụ m ntị, nʼihi na enwere m okwu dị mkpa m ga-agwa unu;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.6",
            "verseOrgIds": [
              "PRO.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 8:6"
      },
      "items": [
        {
          "text": "Ihe ọbụla m kwuru bụ ihe ziri ezi,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.6",
            "verseOrgIds": [
              "PRO.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọnụ m na-ekwu eziokwu",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.7",
            "verseOrgIds": [
              "PRO.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 8:7"
      },
      "items": [
        {
          "text": "nʼihi na akpọrọ m okwu ụgha asị.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.7",
            "verseOrgIds": [
              "PRO.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndụmọdụ m zuruoke, ọ dịkwa mma.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.8",
            "verseOrgIds": [
              "PRO.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 8:8"
      },
      "items": [
        {
          "text": "Ihe ọjọọ ọbụla adịghị nʼime ya.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.8",
            "verseOrgIds": [
              "PRO.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼebe onye nwetara nghọta nọ, okwu m doro anya;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.9",
            "verseOrgIds": [
              "PRO.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 8:9"
      },
      "items": [
        {
          "text": "nʼebe ndị chọtara ihe ọmụma nọ, okwu m ziri ezi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.9",
            "verseOrgIds": [
              "PRO.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Họrọ ịdọ aka na ntị m karịa ọlaọcha",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.10",
            "verseOrgIds": [
              "PRO.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 8:10"
      },
      "items": [
        {
          "text": "họrọkwa ihe ọmụma karịa ọlaedo dị ezi mma.\"",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.10",
            "verseOrgIds": [
              "PRO.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amamihe dị mkpa karịa nkume rubi dị oke ọnụahịa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.11",
            "verseOrgIds": [
              "PRO.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 8:11"
      },
      "items": [
        {
          "text": "Ọ dịkwaghị ihe a ga-eji tụnyere ya.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.11",
            "verseOrgIds": [
              "PRO.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mụ onwe m bụ amamihe na ezi nghọta na-agakọta.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.12",
            "verseOrgIds": [
              "PRO.8.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 8:12"
      },
      "items": [
        {
          "text": "Enwere m ọmụma ihe na ezi izuzu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.12",
            "verseOrgIds": [
              "PRO.8.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ịtụ egwu",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.13",
            "verseOrgIds": [
              "PRO.8.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PRO.8.13",
                "verseOrgIds": [
                  "PRO.8.13"
                ]
              }
            }
          ]
        },
        {
          "text": "bụ ịkpọ ihe ọjọọ asị.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.13",
            "verseOrgIds": [
              "PRO.8.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 8:13"
      },
      "items": [
        {
          "text": "Akpọrọ m nganga na mpako,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.13",
            "verseOrgIds": [
              "PRO.8.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 8:13"
      },
      "items": [
        {
          "text": "omume ọjọọ nakwa okwu gbagọrọ agbagọ asị.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.13",
            "verseOrgIds": [
              "PRO.8.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndụmọdụ na ezi nghọta bụ nke m;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.14",
            "verseOrgIds": [
              "PRO.8.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 8:14"
      },
      "items": [
        {
          "text": "enwekwara m ọmụma ihe na ike.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.14",
            "verseOrgIds": [
              "PRO.8.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Site na m ka ndị eze ji achị,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.15",
            "verseOrgIds": [
              "PRO.8.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 8:15"
      },
      "items": [
        {
          "text": "ọ bụ m na-eme ka ndị na-achị achị mee iwu ziri ezi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.15",
            "verseOrgIds": [
              "PRO.8.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Site na m ka ndị eze ji achị",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.16",
            "verseOrgIds": [
              "PRO.8.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 8:16"
      },
      "items": [
        {
          "text": "bụ ndịisi niile na-achị nʼụwa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.16",
            "verseOrgIds": [
              "PRO.8.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PRO 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị niile hụrụ m nʼanya ka m na-ahụ nʼanya.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.17",
            "verseOrgIds": [
              "PRO.8.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 8:17"
      },
      "items": [
        {
          "text": "Ndị niile na-achọ m aghakwaghị ịchọta m.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.17",
            "verseOrgIds": [
              "PRO.8.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PRO 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ana m ekenye ụba na nsọpụrụ,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.18",
            "verseOrgIds": [
              "PRO.8.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 8:18"
      },
      "items": [
        {
          "text": "na ikpe ziri ezi na ezi omume.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.18",
            "verseOrgIds": [
              "PRO.8.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PRO 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onyinye m na-enye dị mma karịa ọlaọcha,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.19",
            "verseOrgIds": [
              "PRO.8.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 8:19"
      },
      "items": [
        {
          "text": "ọ karịkwara ọlaedo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.19",
            "verseOrgIds": [
              "PRO.8.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PRO 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ana m aga ije nʼụzọ ezi omume,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.20",
            "verseOrgIds": [
              "PRO.8.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 8:20"
      },
      "items": [
        {
          "text": "nʼokporoụzọ ikpe ziri ezi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.20",
            "verseOrgIds": [
              "PRO.8.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "PRO 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị niile hụrụ m nʼanya, na-eketa akụnụba.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.21",
            "verseOrgIds": [
              "PRO.8.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 8:21"
      },
      "items": [
        {
          "text": "Ana m emejupụtakwa ụlọakụ ha.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.21",
            "verseOrgIds": [
              "PRO.8.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
