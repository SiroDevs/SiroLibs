            "sid": "PRO 8:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Site nʼebighị ebi gara aga ka m dị;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.23",
            "verseOrgIds": [
              "PRO.8.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 8:23"
      },
      "items": [
        {
          "text": "adịkwa m adị tupu e kee ụwa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.23",
            "verseOrgIds": [
              "PRO.8.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "PRO 8:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anọ m na-adị tupu e kee ogbu mmiri,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.24",
            "verseOrgIds": [
              "PRO.8.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 8:24"
      },
      "items": [
        {
          "text": "tupu isi iyi ọbụla agbapụta mmiri nʼelu ụwa,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.24",
            "verseOrgIds": [
              "PRO.8.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "PRO 8:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "tupu e kee ugwu ukwu",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.25",
            "verseOrgIds": [
              "PRO.8.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 8:25"
      },
      "items": [
        {
          "text": "na ugwu nta.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.25",
            "verseOrgIds": [
              "PRO.8.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "PRO 8:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "E, amụọla m rịị tupu Chineke ekee ụwa",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.26",
            "verseOrgIds": [
              "PRO.8.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 8:26"
      },
      "items": [
        {
          "text": "na osisi niile, na aja niile dị nʼime ya.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.26",
            "verseOrgIds": [
              "PRO.8.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "PRO 8:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anọ m ya mgbe o doziri mbara eluigwe nʼọnọdụ ya,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.27",
            "verseOrgIds": [
              "PRO.8.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 8:27"
      },
      "items": [
        {
          "text": "mgbe ọ tụsara ha nʼelu ogbu mmiri niile;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.27",
            "verseOrgIds": [
              "PRO.8.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "PRO 8:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "mgbe o hiwere mbara eluigwe,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.28",
            "verseOrgIds": [
              "PRO.8.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 8:28"
      },
      "items": [
        {
          "text": "mgbe o mere ka isi iyi niile nke ogbu mmiri dị ike,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.28",
            "verseOrgIds": [
              "PRO.8.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "PRO 8:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "mgbe ọ kpara oke nye osimiri ebe ọ ga-akwụsị,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.29",
            "verseOrgIds": [
              "PRO.8.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 8:29"
      },
      "items": [
        {
          "text": "ka mmiri ya ghara ịgafe iwu ya,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.29",
            "verseOrgIds": [
              "PRO.8.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PRO 8:29"
      },
      "items": [
        {
          "text": "mgbe ọ kara akara ebe a tọrọ ntọala nke ụwa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.29",
            "verseOrgIds": [
              "PRO.8.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "PRO 8:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oge ahụ niile ka m na-anọ nʼakụkụ ya dịka onye ǹka.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.30",
            "verseOrgIds": [
              "PRO.8.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PRO 8:30"
      },
      "items": [
        {
          "text": "Ihe banyere m na-atọkwa ya ụtọ;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.30",
            "verseOrgIds": [
              "PRO.8.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 8:30"
      },
      "items": [
        {
          "text": "ana m egwuri egwu nʼihu ya.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.30",
            "verseOrgIds": [
              "PRO.8.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "PRO 8:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihe niile o kere tọkwara m ụtọ,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.31",
            "verseOrgIds": [
              "PRO.8.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 8:31"
      },
      "items": [
        {
          "text": "ụwa niile na ụmụ mmadụ!",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.31",
            "verseOrgIds": [
              "PRO.8.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "PRO 8:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nʼihi ya, ụmụ m ndị ikom, geenụ m ntị;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.32",
            "verseOrgIds": [
              "PRO.8.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 8:32"
      },
      "items": [
        {
          "text": "nʼihi na ndị niile na-eso ụzọ m na-enwe ọṅụ.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.32",
            "verseOrgIds": [
              "PRO.8.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "PRO 8:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gee ntị na ndụmọdụ m ka ị bụrụ onye maara ihe,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.33",
            "verseOrgIds": [
              "PRO.8.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 8:33"
      },
      "items": [
        {
          "text": "agbakụtakwala ndụmọdụ m azụ.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.33",
            "verseOrgIds": [
              "PRO.8.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "PRO 8:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngọzị dịrị mmadụ ahụ na-aṅa ntị nʼokwu m,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.34",
            "verseOrgIds": [
              "PRO.8.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 8:34"
      },
      "items": [
        {
          "text": "onye na-anọ na nche nʼọnụ ụzọ m ụbọchị niile,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.34",
            "verseOrgIds": [
              "PRO.8.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 8:34"
      },
      "items": [
        {
          "text": "onye na-anọ na-echere m nʼọnụ ụzọ ụlọ m;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.34",
            "verseOrgIds": [
              "PRO.8.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "PRO 8:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "nʼihi na onye ọbụla chọtara m chọtara ndụ;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.35",
            "verseOrgIds": [
              "PRO.8.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 8:35"
