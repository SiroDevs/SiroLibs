      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 8:22"
      },
      "items": [
        {
          "text": "tupu o bido ike ihe ọbụla ọzọ.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.22",
            "verseOrgIds": [
              "PRO.8.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
