          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọkụ na-anyụ mgbe nkụ gwụrụ,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.20",
            "verseOrgIds": [
              "PRO.26.20"
            ]
          }
        }
      ]
    },
