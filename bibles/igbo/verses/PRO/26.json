      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 26:21"
      },
      "items": [
        {
          "text": "otu a ka onye na-ese okwu si eme ka ọgụ nwuru ọkụ.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.21",
            "verseOrgIds": [
              "PRO.26.21"
            ]
          }
        }
      ]
    },
    {
