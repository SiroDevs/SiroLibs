          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okwu ọnụ ya nwere ike tọọ ụtọ na ntị ma ekwenyerela ha,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.25",
            "verseOrgIds": [
              "PRO.26.25"
            ]
          }
        }
      ]
    },
