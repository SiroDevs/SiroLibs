      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 26:20"
      },
      "items": [
        {
          "text": "otu a kwa esemokwu na-akwụsị mgbe a kwụsịrị ikwu ndị ọzọ okwu nʼazụ.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.20",
            "verseOrgIds": [
              "PRO.26.20"
            ]
          }
        }
      ]
    },
    {
