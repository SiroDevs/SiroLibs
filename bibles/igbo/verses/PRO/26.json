      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 26:24"
      },
      "items": [
        {
          "text": "ma nʼime obi ha ọ bụ naanị aghụghọ dị ya.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.24",
            "verseOrgIds": [
              "PRO.26.24"
            ]
          }
        }
      ]
    },
    {
