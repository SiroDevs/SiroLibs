          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye ị kpọrọ asị bụ onye ị ga-achọ iwetara ihe mgbu site nʼịgha ụgha.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.28",
            "verseOrgIds": [
              "PRO.26.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 26:28"
      },
      "items": [
        {
          "text": "Okwu ọma na-esighị nʼobi mmadụ pụta na-eweta ịla nʼiyi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.28",
            "verseOrgIds": [
              "PRO.26.28"
            ]
          }
        }
      ]
