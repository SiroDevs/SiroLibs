          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị iro na-eji egbugbere ọnụ ha gbanwee onwe ha,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.24",
            "verseOrgIds": [
              "PRO.26.24"
            ]
          }
        }
      ]
    },
