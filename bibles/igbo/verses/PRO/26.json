          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka nwoke ahụ bụ nke na-aghọgbu onye agbataobi ya",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.19",
            "verseOrgIds": [
              "PRO.26.19"
            ]
          }
        }
      ]
    },
    {
