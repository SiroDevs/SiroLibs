      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 26:19"
      },
      "items": [
        {
          "text": "ma sị, \"ọ bụ naanị egwuregwu ka m na-egwu.\"",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.19",
            "verseOrgIds": [
              "PRO.26.19"
            ]
          }
        }
      ]
    },
    {
