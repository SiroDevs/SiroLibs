      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 26:22"
      },
      "items": [
        {
          "text": "ha na-agbadakwa nʼime ime ala afọ.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.22",
            "verseOrgIds": [
              "PRO.26.22"
            ]
          }
        }
      ]
    },
