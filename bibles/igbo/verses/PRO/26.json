      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 26:23"
      },
      "items": [
        {
          "text": "ka egbugbere ọnụ dị nro nke obi jupụtara nʼihe ọjọọ bụ.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.23",
            "verseOrgIds": [
              "PRO.26.23"
            ]
          }
        }
      ]
    },
    {
