            "number": "27",
            "style": "v",
            "sid": "PRO 26:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye na-egwuru ibe ya olulu ga-adaba nʼime ya.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.27",
            "verseOrgIds": [
              "PRO.26.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 26:27"
      },
      "items": [
        {
          "text": "Ọzọ, onye na-enuda nkume, ya ka nkume ahụ ga-adagbu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.27",
            "verseOrgIds": [
              "PRO.26.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
