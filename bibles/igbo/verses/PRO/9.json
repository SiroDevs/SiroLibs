{
  "id": "PRO.9",
  "number": "9",
  "bookId": "PRO",
  "reference": "Ilu 9",
  "copyright": "Biblica® Open Igbo Contemporary Bible™ Copyright © 1980, 1988, 2019, 2020 by Biblica, Inc. Used with permission. All rights reserved worldwide.",
  "verseCount": 18,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "9",
        "style": "c",
        "sid": "PRO 9"
      },
      "items": [
        {
          "text": "9",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ọkpụkpọ oku nke amamihe na nzuzu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amamihe ewuola ụlọ ukwu ya",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.1",
            "verseOrgIds": [
              "PRO.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 9:1"
      },
      "items": [
        {
          "text": "nʼelu ogidi asaa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.1",
            "verseOrgIds": [
              "PRO.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "O doziela oriri ya nʼusoro,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.2",
            "verseOrgIds": [
              "PRO.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 9:2"
      },
      "items": [
        {
          "text": "o gbuola anụ ya, gwaakwa mmanya.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.2",
            "verseOrgIds": [
              "PRO.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "O zipụkwala ndị ozi ya ka ha gaa kpọọ mmadụ niile,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.3",
            "verseOrgIds": [
              "PRO.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 9:3"
      },
      "items": [
        {
          "text": "site nʼebe dị elu nke obodo ka ha nọ na-akpọ oku na-asị,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.3",
            "verseOrgIds": [
              "PRO.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Bịanụ nʼụlọ m, unu ndị niile na-enweghị uche\"",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.4",
            "verseOrgIds": [
              "PRO.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PRO 9:4"
      },
      "items": [
        {
          "text": "Ma nye ndị amamihe kọrọ, ọ na-asị,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.4",
            "verseOrgIds": [
              "PRO.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Bịanụ, rie nri m,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.5",
            "verseOrgIds": [
              "PRO.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 9:5"
      },
      "items": [
        {
          "text": "ṅụọkwa mmanya m gwakọtara.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.5",
            "verseOrgIds": [
              "PRO.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hapụnụ ụzọ enweghị uche unu, ka unu were dị ndụ;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.6",
            "verseOrgIds": [
              "PRO.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 9:6"
      },
      "items": [
        {
          "text": "gbasokwanụ ụzọ mmụọ ịghọta ihe.\"",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.6",
            "verseOrgIds": [
              "PRO.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye ọbụla na-adọ onye na-akwa emo aka na ntị na-ewetara onwe ya nlelị;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.7",
            "verseOrgIds": [
              "PRO.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 9:7"
      },
      "items": [
        {
          "text": "onye na-abara mmadụ ọjọọ mba na-enweta nkọcha.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.7",
            "verseOrgIds": [
              "PRO.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abarala ndị na-akwa emo mba, ma ọ bụghị ya, ha ga-akpọ gị asị;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.8",
            "verseOrgIds": [
              "PRO.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 9:8"
      },
      "items": [
        {
          "text": "baara ndị maara ihe mba, ha ga-ahụ gị nʼanya.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.8",
            "verseOrgIds": [
              "PRO.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuziere onye maara ihe ihe o kwesiri ịmụta, ọ ga-ama ihe karịa,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.9",
            "verseOrgIds": [
              "PRO.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 9:9"
      },
      "items": [
        {
          "text": "kuziere onye ziri ezi ihe ọ ga-atụkwasị ihe ọ mụtara nʼamamihe ya.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.9",
            "verseOrgIds": [
              "PRO.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na ịtụ egwu",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.10",
            "verseOrgIds": [
              "PRO.9.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PRO.9.10",
                "verseOrgIds": [
                  "PRO.9.10"
                ]
              }
            }
          ]
        },
        {
          "text": "bụ mmalite amamihe,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.10",
            "verseOrgIds": [
              "PRO.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 9:10"
      },
      "items": [
        {
          "text": "inwe ihe ọmụma banyere onye Nsọ ahụ bụkwa nghọta.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.10",
            "verseOrgIds": [
              "PRO.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na ọ bụ site na amamihe, ka ụbọchị gị ga-adị ogologo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.11",
            "verseOrgIds": [
              "PRO.9.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 9:11"
      },
      "items": [
        {
          "text": "A ga-etinyekwara gị ọtụtụ afọ na ndụ gị.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.11",
            "verseOrgIds": [
              "PRO.9.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ị bụrụ onye nwere amamihe, amamihe gị ga-abara gị uru,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.12",
            "verseOrgIds": [
              "PRO.9.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 9:12"
      },
      "items": [
        {
          "text": "ma ị bụrụ onye na-akwa emo, naanị gị ga-ata ahụhụ ya.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.12",
            "verseOrgIds": [
              "PRO.9.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwanyị dị nzuzu na-eme mkpọtụ,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.13",
            "verseOrgIds": [
              "PRO.9.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 9:13"
      },
      "items": [
        {
          "text": "o nweghị uche; ihere adịghịkwa eme ya.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.13",
            "verseOrgIds": [
              "PRO.9.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ na-anọ ọdụ nʼọnụ ụzọ ụlọ ya,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.14",
            "verseOrgIds": [
              "PRO.9.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 9:14"
      },
      "items": [
        {
          "text": "nʼelu oche nʼebe dịkarịsịrị elu nʼobodo,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.14",
            "verseOrgIds": [
              "PRO.9.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "na-akpọ ndị na-aga nʼụzọ oku,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.15",
            "verseOrgIds": [
              "PRO.9.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 9:15"
      },
      "items": [
        {
          "text": "bụ ndị na-aga mkpa ha,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.15",
            "verseOrgIds": [
              "PRO.9.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ka ndị niile amamihe kọrọ bịa nʼụlọ m.\"",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.16",
            "verseOrgIds": [
              "PRO.9.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PRO 9:16"
      },
      "items": [
        {
          "text": "Ọ na-asịkwa ndị na-enweghị uche,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.16",
            "verseOrgIds": [
              "PRO.9.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PRO 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mmiri e zutere nʼohi na-atọ ụtọ,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.17",
            "verseOrgIds": [
              "PRO.9.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 9:17"
      },
      "items": [
        {
          "text": "nri e riri na nzuzo na-atọkarịkwa nʼụtọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.17",
            "verseOrgIds": [
              "PRO.9.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PRO 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
