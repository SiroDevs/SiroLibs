  "verseCount": 35,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
        "style": "c",
        "sid": "PRO 6"
      },
      "items": [
        {
          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ịdọ aka na ntị banyere nzuzu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwa m, ọ bụrụ na ị nara onye agbataobi gị nʼibe,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.1",
            "verseOrgIds": [
              "PRO.6.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 6:1"
      },
      "items": [
        {
          "text": "ọ bụrụ na ị nara aka ị bụrụ onye ọbịa onye akaebe,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.1",
            "verseOrgIds": [
              "PRO.6.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ị bụrụla onye mara nʼọnya site nʼihe ị kwuru,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.2",
            "verseOrgIds": [
              "PRO.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 6:2"
      },
      "items": [
        {
          "text": "onye enwudere site nʼokwu ọnụ ya.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.2",
            "verseOrgIds": [
              "PRO.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mee nke a, nwa m, si nʼime ya wepụ onwe gị;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.3",
            "verseOrgIds": [
              "PRO.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 6:3"
      },
      "items": [
        {
          "text": "nʼihi na ịdabala nʼaka onye agbataobi gị:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.3",
            "verseOrgIds": [
              "PRO.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PRO 6:3"
      },
      "items": [
        {
          "text": "Jee ọsịịsọ weda onwe gị nʼala rịọọ ya",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.3",
            "verseOrgIds": [
              "PRO.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 6:3"
      },
      "items": [
        {
          "text": "enyekwala ya izuike ọbụla.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.3",
            "verseOrgIds": [
              "PRO.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekwekwala ka ụra baa gị anya abụọ,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.4",
            "verseOrgIds": [
              "PRO.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 6:4"
      },
      "items": [
        {
          "text": "ekwekwala ka mbụbara anya gị ruo ụra.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.4",
            "verseOrgIds": [
              "PRO.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Napụta onwe gị, dịka mgbada site nʼaka dinta,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.5",
            "verseOrgIds": [
              "PRO.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 6:5"
      },
      "items": [
        {
          "text": "maọbụ dịka nnụnụ site nʼọnya osi ọnya.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.5",
            "verseOrgIds": [
              "PRO.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaa mụta ihe site nʼaka ndanda, gị onye umengwụ.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.6",
            "verseOrgIds": [
              "PRO.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 6:6"
      },
      "items": [
        {
          "text": "Mụta ihe site nʼụzọ ya niile.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.6",
            "verseOrgIds": [
              "PRO.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ ezie na o nweghị eze na-achịkọta ha,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.7",
            "verseOrgIds": [
              "PRO.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 6:7"
      },
      "items": [
        {
          "text": "maọbụ onyendu, maọbụ ọchịagha,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.7",
            "verseOrgIds": [
              "PRO.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "ma ọ na-akpakọta nri ya nʼoge ọkọchị",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.8",
            "verseOrgIds": [
              "PRO.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 6:8"
      },
      "items": [
        {
          "text": "ma na-ewebata nri ya nʼoge owuwe ihe ubi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.8",
            "verseOrgIds": [
              "PRO.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ ruo ole mgbe ka ị ga-edina ala nʼebe ahụ, gị onye umengwụ?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.9",
            "verseOrgIds": [
              "PRO.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 6:9"
      },
      "items": [
        {
          "text": "Olee mgbe ka ị ga-esi nʼụra bilie?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.9",
            "verseOrgIds": [
              "PRO.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwa ụra nta, nwa iru ụra nta,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.10",
            "verseOrgIds": [
              "PRO.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 6:10"
      },
      "items": [
        {
          "text": "nwa ịchịkọba aka nta zuo ike,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.10",
            "verseOrgIds": [
              "PRO.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "ụbịam ga-abịakwasị gị dịka onye ohi,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.11",
            "verseOrgIds": [
              "PRO.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 6:11"
      },
      "items": [
        {
          "text": "ụkọ abịakwasịkwa gị dịka onye na-apụnara mmadụ ihe.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.11",
            "verseOrgIds": [
              "PRO.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye okwu na ụka na onye omume ya jọgburu onwe ya,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.12",
            "verseOrgIds": [
              "PRO.6.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 6:12"
      },
      "items": [
        {
          "text": "onye na-ejegharị na-ekwu okwu aghụghọ,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.12",
            "verseOrgIds": [
              "PRO.6.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "onye ji iro na-egbu ikuanya ya,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.13",
            "verseOrgIds": [
              "PRO.6.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 6:13"
      },
      "items": [
        {
          "text": "jiri ụkwụ ya na-ekwu okwu",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.13",
            "verseOrgIds": [
              "PRO.6.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 6:13"
      },
      "items": [
        {
          "text": "na mkpịsịaka ya na-egosi ihe.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.13",
            "verseOrgIds": [
              "PRO.6.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye obi ya na-echepụta ihe ọjọọ na aghụghọ,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.14",
            "verseOrgIds": [
              "PRO.6.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 6:14"
      },
      "items": [
        {
          "text": "onye na-akpalikwa esemokwu mgbe niile.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.14",
            "verseOrgIds": [
              "PRO.6.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi ya, mbibi ga-abịakwasị ya na mberede;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.15",
            "verseOrgIds": [
              "PRO.6.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 6:15"
      },
      "items": [
        {
          "text": "nʼotu ntabi anya ka a ga-ebibi ya, apụghịkwa ịgwọta ya.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.15",
            "verseOrgIds": [
              "PRO.6.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ dị ụzọ ihe isii",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.16",
            "verseOrgIds": [
              "PRO.6.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PRO.6.16",
                "verseOrgIds": [
                  "PRO.6.16"
                ]
              }
            }
          ]
        },
        {
          "text": "kpọrọ asị,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.16",
            "verseOrgIds": [
              "PRO.6.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "PRO 6:16"
      },
      "items": [
        {
          "text": "e, ha dị asaa bụ ihe arụ nʼebe ọ nọ.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.16",
            "verseOrgIds": [
              "PRO.6.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li3"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PRO 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anya dị nganga,",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li3",
        "vid": "PRO 6:17"
      },
      "items": [
        {
          "text": "ire na-ekwu okwu ụgha,",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li3",
        "vid": "PRO 6:17"
      },
      "items": [
        {
          "text": "aka na-awụfu ọbara ndị na-emeghị ihe ọjọọ.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li3"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PRO 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obi na-echepụta nzube ọjọọ;",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li3",
        "vid": "PRO 6:18"
      },
      "items": [
        {
          "text": "ụkwụ na-eme ngwangwa ịgbaba nʼajọ ihe,",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li3"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PRO 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "onyeama ụgha na-awụpụ ụgha dịka mmiri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li3",
        "vid": "PRO 6:19"
      },
      "items": [
        {
          "text": "na onye na-agbasa esemokwu nʼetiti ụmụnna.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ịdọ aka na ntị banyere ịkwa iko",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PRO 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwa m, debe ihe nna gị nyere gị nʼiwu,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.20",
            "verseOrgIds": [
              "PRO.6.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 6:20"
      },
      "items": [
        {
          "text": "ahapụkwala iwu nke nne gị.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.20",
            "verseOrgIds": [
              "PRO.6.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "PRO 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka ndụmọdụ ha dịrị gị nʼobi mgbe niile,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.21",
            "verseOrgIds": [
              "PRO.6.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 6:21"
      },
      "items": [
        {
          "text": "ka ị ghara ichefu ha.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.21",
            "verseOrgIds": [
              "PRO.6.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "PRO 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ị na-ejegharị, ọ ga na-edu gị;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.22",
            "verseOrgIds": [
              "PRO.6.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 6:22"
      },
      "items": [
        {
          "text": "mgbe ị na-arahụ ụra, ọ ga na-eche gị.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.22",
            "verseOrgIds": [
              "PRO.6.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 6:22"
      },
      "items": [
        {
          "text": "Mgbe i tetakwara, ha ga-akpanyere gị ụka.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.22",
            "verseOrgIds": [
              "PRO.6.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "PRO 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na iwu a bụ oriọna,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.23",
            "verseOrgIds": [
              "PRO.6.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 6:23"
      },
      "items": [
        {
          "text": "Ihe ozizi a bụkwa ìhè,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.23",
            "verseOrgIds": [
              "PRO.6.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PRO 6:23"
      },
      "items": [
        {
          "text": "otu a kwa ịdọ aka na ntị na ịba mba",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.23",
            "verseOrgIds": [
              "PRO.6.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 6:23"
      },
      "items": [
        {
          "text": "bụ ụzọ ezi ndụ,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.23",
            "verseOrgIds": [
              "PRO.6.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "PRO 6:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "idebe gị ka ị pụọ nʼebe nwunye onye agbataobi gị nọ,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.24",
            "verseOrgIds": [
              "PRO.6.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 6:24"
      },
      "items": [
        {
          "text": "sitekwa nʼire ụtọ nke nwanyị ọjọọ.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.24",
            "verseOrgIds": [
              "PRO.6.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "PRO 6:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekwela ka agụ nʼezighị ezi gụọ gị nʼime obi nʼihi ịma mma ya,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.25",
            "verseOrgIds": [
              "PRO.6.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 6:25"
      },
      "items": [
        {
          "text": "ma ọ bụkwanụ ka o jiri ile anya ya rata gị.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.25",
            "verseOrgIds": [
              "PRO.6.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "PRO 6:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na nwanyị akwụna ka enwere ike iji otu ogbe achịcha nweta,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.26",
            "verseOrgIds": [
              "PRO.6.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 6:26"
      },
      "items": [
        {
          "text": "ma nwunye nwoke ọzọ na-achụ nta ndụ gị ịla ya nʼiyi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.26",
            "verseOrgIds": [
              "PRO.6.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "PRO 6:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mmadụ ọ pụrụ ịgụrụ ọkụ tụkwasị nʼahụ ya,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.27",
            "verseOrgIds": [
              "PRO.6.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 6:27"
      },
      "items": [
        {
          "text": "ma uwe ya ereghị ọkụ?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.27",
            "verseOrgIds": [
              "PRO.6.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "PRO 6:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mmadụ ọ pụrụ ije ije nʼelu icheku ọkụ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.28",
            "verseOrgIds": [
              "PRO.6.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 6:28"
      },
      "items": [
        {
          "text": "ma ụkwụ ya ahapụ igbuchapụ?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.28",
            "verseOrgIds": [
              "PRO.6.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "PRO 6:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otu a ka ọ na-adịrị nwoke na-abakwuru nwunye mmadụ ibe ya;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.29",
            "verseOrgIds": [
              "PRO.6.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 6:29"
      },
      "items": [
        {
          "text": "o nweghị onye ọbụla na-emetụ ya aka nke a na-agaghị ata ahụhụ.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.29",
            "verseOrgIds": [
              "PRO.6.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "PRO 6:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị mmadụ adịghị eleda onye ohi anya ma ọ bụrụ na o zuo ohi",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.30",
            "verseOrgIds": [
              "PRO.6.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 6:30"
      },
      "items": [
        {
          "text": "ka o were gboo mkpa agụụ nke na-agụsị ya ike.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.30",
            "verseOrgIds": [
              "PRO.6.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "PRO 6:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ọ bụrụ na ejide ya ọ ga-akwụghachi ụgwọ ihe niile ahụ o zuru okpukpu asaa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.31",
            "verseOrgIds": [
              "PRO.6.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 6:31"
      },
      "items": [
        {
          "text": "Nʼagbanyeghị na nke a ga-eme ka o ree ihe niile o ji biri nʼụlọ ya.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.31",
            "verseOrgIds": [
              "PRO.6.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "PRO 6:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma nwoke ahụ na-akwa iko bụ onye nzuzu, amamihe kọrọ ya,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.32",
            "verseOrgIds": [
              "PRO.6.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 6:32"
      },
      "items": [
        {
          "text": "nʼihi na ọ bụ onwe ya ka ọ na-ala nʼiyi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.32",
            "verseOrgIds": [
              "PRO.6.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "PRO 6:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "A ga-eti ya ezi ihe otiti, a ga-elelikwa ya anya,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.33",
            "verseOrgIds": [
              "PRO.6.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 6:33"
      },
      "items": [
        {
          "text": "ihere ya agaghị ekwe ihichapụ.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.33",
            "verseOrgIds": [
              "PRO.6.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "PRO 6:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na di nwanyị ahụ ga-esite nʼekworo wee iwe dị ọkụ;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.34",
            "verseOrgIds": [
              "PRO.6.34"
            ]
          }
        }
      ]
    },
    {
