          "text": "Anyị nwere ike pịa ọpịpịa nʼobi anyị,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.9",
            "verseOrgIds": [
              "PRO.16.9"
            ]
          }
        }
      ]
    },
