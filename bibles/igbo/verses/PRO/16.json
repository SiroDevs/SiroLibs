          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PRO.16.2",
                "verseOrgIds": [
                  "PRO.16.2"
                ]
              }
            }
          ]
        },
        {
          "text": "na-atule ebumnobi niile nke mmadụ.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.2",
            "verseOrgIds": [
              "PRO.16.2"
            ]
          }
        }
      ]
