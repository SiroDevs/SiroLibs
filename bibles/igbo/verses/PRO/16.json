      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 16:4"
      },
      "items": [
        {
          "text": "o bụladị ndị mmebi iwu ka e debere maka ụbọchị mbibi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.4",
            "verseOrgIds": [
              "PRO.16.4"
            ]
          }
        }
      ]
