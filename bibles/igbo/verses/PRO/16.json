                "verseId": "PRO.16.4",
                "verseOrgIds": [
                  "PRO.16.4"
                ]
              }
            }
          ]
        },
        {
          "text": "na-eme ka ihe niile rụpụta ebumnuche ya,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.4",
            "verseOrgIds": [
              "PRO.16.4"
            ]
          }
        }
      ]
    },
    {
