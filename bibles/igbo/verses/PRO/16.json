      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 16:3"
      },
      "items": [
        {
          "text": "ọ ga-eme ka ha gaa nʼihu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.3",
            "verseOrgIds": [
              "PRO.16.3"
            ]
          }
