            "sid": "PRO 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ụzọ mmadụ na-agbaso na-atọ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.7",
            "verseOrgIds": [
              "PRO.16.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PRO.16.7",
                "verseOrgIds": [
                  "PRO.16.7"
                ]
              }
            }
          ]
        },
        {
          "text": "ụtọ,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.7",
            "verseOrgIds": [
              "PRO.16.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 16:7"
      },
      "items": [
        {
          "text": "ọ na-eme ka mmadụ ahụ na ndị iro ya dị nʼudo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.7",
            "verseOrgIds": [
              "PRO.16.7"
            ]
          }
        }
      ]
    },
