      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 16:1"
      },
      "items": [
        {
          "text": "ma okwu ikpeazụ ga-esi nʼọnụ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.1",
            "verseOrgIds": [
              "PRO.16.1"
