              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mmadụ nwere ike pịa ihe ọ chọrọ ime,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.1",
            "verseOrgIds": [
