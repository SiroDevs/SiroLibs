        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PRO.16.5",
                "verseOrgIds": [
                  "PRO.16.5"
                ]
              }
            }
          ]
        },
        {
          "text": "kpọrọ ndị nwere obi dị mpako asị.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.5",
            "verseOrgIds": [
              "PRO.16.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 16:5"
      },
      "items": [
        {
          "text": "Mara nke a nke ọma: Ha aghaghị ịta ahụhụ.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.5",
            "verseOrgIds": [
              "PRO.16.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
