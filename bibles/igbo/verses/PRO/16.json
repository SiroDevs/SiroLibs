            "number": "6",
            "style": "v",
            "sid": "PRO 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ site nʼịhụnanya na eziokwu ka eji ekpuchi mmehie;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.6",
            "verseOrgIds": [
              "PRO.16.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 16:6"
      },
      "items": [
        {
          "text": "ọ bụkwa site nʼegwu",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.6",
            "verseOrgIds": [
              "PRO.16.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PRO.16.6",
                "verseOrgIds": [
                  "PRO.16.6"
                ]
              }
            }
          ]
        },
        {
          "text": "ka mmadụ ji agbanarị mmehie.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.6",
            "verseOrgIds": [
              "PRO.16.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
