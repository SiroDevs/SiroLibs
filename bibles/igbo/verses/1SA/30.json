  "verseCount": 31,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "30",
        "style": "c",
        "sid": "1SA 30"
      },
      "items": [
        {
          "text": "30",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Devid ebibie ndị Amalek",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 30:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Devid na ndị ikom ya rutere obodo Ziklag nʼụbọchị nke atọ, ha hụrụ na ndị Amalek abịala wakporo bi nʼakụkụ ndịda Negev na Ziklag. Ha buru agha megide Ziklag, gbaa obodo ahụ ọkụ,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.1",
            "verseOrgIds": [
              "1SA.30.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 30:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "dọtakwa ndị inyom na ndị niile bi nʼime ya nʼagha, ma okenye ma ụmụntakịrị. Ha egbughị ha egbu, kama ha buuru ha laa.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.2",
            "verseOrgIds": [
              "1SA.30.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 30:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Devid na ndị ikom ya ruru Ziklag, ha hụrụ na-esuola ya ọkụ, dọkpụrụ ndị inyom ha, na ụmụ ndị ikom na ndị inyom nʼagha.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.3",
            "verseOrgIds": [
              "1SA.30.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 30:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, Devid na ndị ikom ya kwara akwa ruo mgbe ike akwa gwụrụ ha.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.4",
            "verseOrgIds": [
              "1SA.30.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 30:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị inyom abụọ Devid, Ahinoam onye Jezril na Abigel, nwunye ochie Nebal onye Kamel, sokwa na ndị a dọtara nʼagha ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.5",
            "verseOrgIds": [
              "1SA.30.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 30:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihe a wetaara Devid oke nsogbu, nʼihi na ndị ikom ya nọ na-ekwu okwu iji nkume tugbuo ya; ha niile nọ nʼobi ilu nʼihi ụmụ ha ndị ikom na ndị inyom. Ma Devid chọtara ike nʼime",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.6",
            "verseOrgIds": [
              "1SA.30.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1SA.30.6",
                "verseOrgIds": [
                  "1SA.30.6"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke ya.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.6",
            "verseOrgIds": [
              "1SA.30.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 30:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Devid sịrị Abịata, bụ onye nchụaja, nwa Ahimelek, \"Chịtara m efọọd ahụ.\" Ya mere, Abịata chịtara ya nye ya",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.7",
            "verseOrgIds": [
              "1SA.30.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 30:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Devid jụrụ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.8",
            "verseOrgIds": [
              "1SA.30.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1SA.30.8",
                "verseOrgIds": [
                  "1SA.30.8"
                ]
              }
            }
          ]
        },
        {
          "text": "ase sị, \"Ọ bụ m chụso ndị a na-apụnara ndị mmadụ ihe? Ọ bụrụ na m achụso ha, aga m ejide ha?\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.8",
            "verseOrgIds": [
              "1SA.30.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 30:8"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1SA.30.8",
                "verseOrgIds": [
                  "1SA.30.8"
                ]
              }
            }
          ]
        },
        {
          "text": "zara, \"E, chụso ha ọsọ, ị ga-achụkwute ha, ma nataghachikwa ihe niile ha were.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.8",
            "verseOrgIds": [
              "1SA.30.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 30:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Devid na narị ndị agha isii ya bịarutere nʼọdọ mmiri Beso, ebe ha hapụrụ ụfọdụ ndị",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.9",
            "verseOrgIds": [
              "1SA.30.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 30:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "narị ndị ikom abụọ nʼime ha enwekwaghị ike ịgafe ndagwurugwu Beso nʼihi ike ọgwụgwụ, ma Devid na narị anọ ndị ọzọ chụsoro ha.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.10",
            "verseOrgIds": [
              "1SA.30.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 30:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha hụrụ otu nwokorobịa onye Ijipt nʼọhịa, duuru ya bịakwute Devid. Ha nyere ya mmiri ka ọ ṅụọ, nyekwa ya nri ka o rie.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.11",
            "verseOrgIds": [
              "1SA.30.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 30:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihe ha nyere ya bụ achịcha fiig,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.12",
            "verseOrgIds": [
              "1SA.30.12"
            ]
          }
        },
        {
          "text": "na ụyọkọ mkpụrụ vaịnị abụọ nke a mịkpọrọ amịkpọ. Mgbe o richara ha, o nweghachiri onwe ya, nʼihi na o ribeghị nri ọbụla, maọbụ ṅụọ mmiri ọbụla ụbọchị atọ, ehihie na nʼabalị.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.12",
            "verseOrgIds": [
              "1SA.30.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 30:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Devid jụrụ ya sị, \"Ị bụ onye? Ebeekwa ka i si bịa?\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.13",
            "verseOrgIds": [
              "1SA.30.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 30:13"
      },
      "items": [
        {
          "text": "Ọ zara Devid sị, \"Abụ m onye Ijipt, bụrụkwa ohu onye Amalek. Onyenwe m hapụrụ m nʼebe a abalị atọ gara aga nʼihi na ahụ adịghị m ike.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.13",
            "verseOrgIds": [
              "1SA.30.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 30:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyị si obodo ebe anyị gara lụọ agha na-alọghachi mgbe ha hapụrụ m nʼebe a. Anyị gara lụgbuo obodo ndị Keret,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.14",
            "verseOrgIds": [
              "1SA.30.14"
            ]
          }
        },
        {
          "text": "nke dị nʼime Negeb, na obodo dị na ndịda ala Juda na ala Kaleb. Anyị gbakwara obodo Ziklag ọkụ.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.14",
            "verseOrgIds": [
              "1SA.30.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 30:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Devid jụrụ ya sị, \"I nwere ike duru m gaa ebe ha nọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.15",
            "verseOrgIds": [
              "1SA.30.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 30:15"
      },
      "items": [
        {
          "text": "Nwokorobịa ahụ zara ya sị, \"Ọ bụrụ na ị ga-aṅụ iyi nʼaha Chineke na ị gaghị egbu m maọbụ were m nyeghachi onyenwe m, aga m eduru gị gaa ebe ha nọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.15",
            "verseOrgIds": [
              "1SA.30.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 30:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "O duuru ha jee nʼebe ndị Amalek nọ. Mgbe ha ruru ebe ahụ, ha hụrụ ha ebe ha tụsara onwe ha nʼala na-eri na-aṅụ, na-etekwa egwu ọṅụ, nʼihi ihe dị ukwuu ha kwatara nʼagha site nʼala ndị Filistia, na nʼala Juda.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.16",
            "verseOrgIds": [
              "1SA.30.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 30:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Devid na ndị agha ya bịakwasịrị ha na mberede gbuo ha site nʼabalị ahụ ruo anyasị echi ya. Ọ dịkwaghị otu nwoke nʼime ha fọdụrụ ndụ ma ọ bụghị narị ndị ikom anọ makwasịrị nʼelu ịnyịnya kamel ha gbalaga.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.17",
            "verseOrgIds": [
              "1SA.30.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 30:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Devid nwetaghachiri ihe niile ndị Amalek kwatara nʼagha, tinyere ndị inyom ya abụọ.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.18",
            "verseOrgIds": [
              "1SA.30.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 30:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "O nweghị ihe furu efu, ma nke ukwu ma nke nta, ụmụ ndị ikom na ụmụ ndị inyom, ihe a kwatara nʼagha, maọbụ ihe ọbụla ọzọ ndị Amalek dọtara nʼagha. Devid nwetaghachiri ihe niile.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.19",
            "verseOrgIds": [
              "1SA.30.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 30:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọzọkwa, Devid chịkọtara igwe ehi na igwe ewu na atụrụ. Ndị ikom ya chịịrị ha, tinyere anụ ụlọ ndị ọzọ, na-aga, na-asị, \"Ndị a bụ ihe Devid kwatara nʼagha.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.20",
            "verseOrgIds": [
              "1SA.30.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 30:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emesịa, Devid bịarutere ebe narị ndị ikom abụọ ndị ahụ nọ na Ndagwurugwu Beso. Ndị a bụ ndị ahụ na-enweghị ike iso Devid nʼihi na ike gwụrụ ha. Ha pụtara zute Devid na ndị so ya. Mgbe Devid na ndị ikom ya bịara ha nso, ọ jụrụ ha otu ha mere.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.21",
            "verseOrgIds": [
              "1SA.30.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 30:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ndị ikom ọjọọ ahụ niile, na ndị okwu na ụka nọ nʼetiti ndị na-eso Devid sịrị, \"Nʼihi na ndị a esoghị anyị jee, ya mere ha agaghị eso anyị keta ihe ndị a anyị kwatara nʼagha. Nyeghachi ha naanị nwunye ha na ụmụ ha; gwakwa ha ka ha laa.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.22",
            "verseOrgIds": [
              "1SA.30.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1SA 30:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Devid sịrị, \"Mba, ụmụnna m, unu ekwesighị isi otu a kee ihe ndị ahụ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.23",
            "verseOrgIds": [
              "1SA.30.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1SA.30.23",
                "verseOrgIds": [
                  "1SA.30.23"
                ]
              }
            }
          ]
        },
        {
          "text": "nyere anyị. O chebere anyị, nyefee nʼaka anyị ndị agha ahụ niile bịara imegide anyị.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.23",
            "verseOrgIds": [
              "1SA.30.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1SA 30:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unu chere na ọ dị onye ga-ege unu ntị mgbe unu na-ekwu okwu dị otu a? Anyị niile ga-eketa oke; oke ndị jere agha na ndị chebere ihe anyị ga-abụ otu.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.24",
            "verseOrgIds": [
              "1SA.30.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1SA 30:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Site nʼụbọchị ahụ, Devid mere ka nke a bụrụ iwu nye ndị Izrel niile ruo taa.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.25",
            "verseOrgIds": [
              "1SA.30.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1SA 30:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ha rutere Ziklag, Devid weere ụfọdụ ihe ha kwatara nʼagha zigara ndị okenye Juda, ndị bụ ndị enyi ya, na-asị, \"Lee onyinye ewetaara unu site nʼụfọdụ nʼime ihe anyị kwatara site nʼaka ndị iro",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.26",
            "verseOrgIds": [
              "1SA.30.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1SA.30.26",
                "verseOrgIds": [
                  "1SA.30.26"
                ]
              }
            }
          ]
        },
        {
          "text": ".\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.26",
            "verseOrgIds": [
              "1SA.30.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1SA 30:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "O zigara ha nye ndị bi na Betel, Ramọt Negev na Jatịa,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.27",
            "verseOrgIds": [
              "1SA.30.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1SA 30:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "nyekwa ndị nọ Aroea, Sifmot, Eshtemoa",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.28",
            "verseOrgIds": [
              "1SA.30.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1SA 30:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Rakal, nyekwa ndị bi nʼobodo ndị Jerameel na nke ndị Ken,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.29",
            "verseOrgIds": [
              "1SA.30.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1SA 30:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "nyekwa ndị bi na Homa, Bo Ashan, Atak",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.30",
            "verseOrgIds": [
              "1SA.30.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1SA 30:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Hebrọn na ndị nọ nʼebe niile ndị ahụ ebe Devid na ndị ya wagharịrị.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.31",
            "verseOrgIds": [
              "1SA.30.31"
            ]
          }
        }
      ]
    }
  ],
