  "verseCount": 58,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "17",
        "style": "c",
        "sid": "1SA 17"
      },
      "items": [
        {
          "text": "17",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Devid na Golaịat",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼoge a, ndị Filistia chịkọtara ndị agha ha ọnụ, zukọtaa nʼobodo Sokoh nke dị na Juda maka ibu agha. Ha mara ụlọ ikwu ha nʼEfes Damim, nke dị nʼagbata Sokoh na Azeka.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.1",
            "verseOrgIds": [
              "1SA.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Sọl na ndị Izrel niile zukọtara maa ụlọ ikwu nke ha na ndagwurugwu Ịla. Ha doro onwe ha nʼusoro agha izute ndị Filistia.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.2",
            "verseOrgIds": [
              "1SA.17.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị Filistia doro onwe ha nʼelu ugwu nʼotu akụkụ, ma ndị Izrel dokwara onwe ha nʼelu ugwu nʼakụkụ nke ọzọ. Ndagwurugwu dịkwa nʼetiti ha.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.3",
            "verseOrgIds": [
              "1SA.17.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, otu onye ọka agha aha ya bụ Golaịat,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.4",
            "verseOrgIds": [
              "1SA.17.4"
            ]
          }
        },
        {
          "text": "onye obodo Gat, sitere nʼetiti ụlọ ikwu ndị Filistia pụta. Nwoke a toro ogologo nke ukwuu; ịdị ogologo ya ga-erukwa mita atọ.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.4",
            "verseOrgIds": [
              "1SA.17.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "O kpu okpu agha e ji bronz kpụọ, ma yiri uwe agha nke ịdị arọ bronz e ji kpụọ ya ga-erukwa iri kilogram ise na asaa.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.5",
            "verseOrgIds": [
              "1SA.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "O yikwa ihe agha o ji kpuchie ụkwụ ya abụọ nke e ji bronz kpụọ, nyakwasịkwa nʼubu ya ùbe e ji bronz kpụọ.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.6",
            "verseOrgIds": [
              "1SA.17.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "A kpụrụ ùbe ya ka ọ dịrị ka osisi e ji ekwe akwa, jiri igwe ịdị arọ ya ga-eru kilogram asaa kpụọ ọnụ ọnụ ùbe ahụ. Onye na-ebu ọta o ji ekpuchi obi ya nọkwa nʼihu ya.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.7",
            "verseOrgIds": [
              "1SA.17.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Golaịat guzoro kpọkuo ndị agha Izrel sị ha, \"Gịnị mere unu ga-eji pụta guzo nʼusoro ibu agha. Ọ bụ na m abụghị onye Filistia? Ọ bụkwa na unu onwe unu abụghị ndị ozi Sọl? Họpụtaranụ onwe unu otu nwoke, ka ọ bịakwute m.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.8",
            "verseOrgIds": [
              "1SA.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ na onye ahụ unu họpụtara etigbuo m, anyị ga-abụrụ unu ndị ohu, ma ọ bụrụkwanụ na m etigbuo ya, unu ga-abụrụ anyị ndị ohu!\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.9",
            "verseOrgIds": [
              "1SA.17.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, onye Filistia ahụ sịrị, \"Taa, ana m ama usuu ndị agha Izrel aka nʼihu! Kpọpụtaranụ m otu nwoke ka mụ na ya lụọ ọgụ.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.10",
            "verseOrgIds": [
              "1SA.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Sọl na ndị agha Izrel nụrụ ihe onye Filistia a kwuru, ha mara jijiji tụọkwa oke egwu.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.11",
            "verseOrgIds": [
              "1SA.17.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Devid bụ nwa Jesi, onye Efrat nke Betlehem dị na Juda. Jesi mụtara ndị ikom asatọ. Nʼoge nke Sọl, ọ ghọọla agadi nwoke.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.12",
            "verseOrgIds": [
              "1SA.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atọ nʼime ụmụ ndị ikom Jesi, ndị bụ okenye, soro Sọl gaa agha. Aha ha bụ Eliab, ọkpara ya, Abinadab, nwa nke abụọ na Shama, nwa nke atọ.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.13",
            "verseOrgIds": [
              "1SA.17.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Devid bụ ọdụdụ nwa. Ụmụnne ya ndị okenye atọ na-eso Sọl.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.14",
            "verseOrgIds": [
              "1SA.17.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Devid na-apụ jekwuru Sọl, ma na-alaghachikwa nʼụlọ ịzụ atụrụ nna ya na Betlehem.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.15",
            "verseOrgIds": [
              "1SA.17.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Golaịat, onye Filistia na-abịaru nso ụtụtụ na uhuruchi, na-eguzo onwe ya otu a iri ụbọchị anọ.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.16",
            "verseOrgIds": [
              "1SA.17.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 17:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otu ụbọchị, Jesi gwara Devid okwu sị, \"Bịa ka i wegara ụmụnne gị otu akpa ọka ndị a e ghere eghe. Chịrịkwa ogbe achịcha iri ndị a chịlara ha.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.17",
            "verseOrgIds": [
              "1SA.17.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wegakwara onyeisi usuu ha, iri chiizi,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.18",
            "verseOrgIds": [
              "1SA.17.18"
            ]
          }
        },
        {
          "text": "ndị a. Chọpụta otu ihe si agara ụmụnne gị",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.18",
            "verseOrgIds": [
              "1SA.17.18"
            ]
          }
        },
        {
          "text": "natakwa ha ihe ị ga-egosi anyị na ha dị ndụ.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.18",
            "verseOrgIds": [
              "1SA.17.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 17:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha na Sọl na ndị ikom Izrel niile, nọ na ndagwurugwu Ịla, na-ebuso ndị Filistia agha.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.19",
            "verseOrgIds": [
              "1SA.17.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 17:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Devid biliri njem nʼisi ụtụtụ, hapụ igwe atụrụ ya nʼaka onye na-elekọta atụrụ, buru onyinye ndị ahụ gawa dịka Jesi nyere ya nʼiwu. Ọ bịarutere ụlọ ikwu ndị Izrel mgbe ha na-apụ nʼihu agha, ha na-etikwa mkpu agha.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.20",
            "verseOrgIds": [
              "1SA.17.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 17:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị Izrel na ndị Filistia dokwara onwe ha nʼusoro izute onwe ha nʼagha, ndị agha megide ndị agha.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.21",
            "verseOrgIds": [
              "1SA.17.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 17:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Devid hapụrụ ihe ndị ahụ nʼaka onye na-elekọta akpa niile, gbara ọsọ gaa nʼusoro ndị agha jụọ ụmụnne ya banyere udo ha.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.22",
            "verseOrgIds": [
              "1SA.17.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1SA 17:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma mgbe ha na ya nọ na-akparịta ụka, onye mmeri nʼọgbọ agha, onye Filistia nke Gat, Golaịat bụ aha ya, sitere nʼusoro ndị agha Filistia pụta, kwuokwa okwu niile ahụ dịka ọ na-ekwu na mbụ. Devid nụrụ ihe o kwuru.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.23",
            "verseOrgIds": [
              "1SA.17.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1SA 17:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ndị Izrel niile hụrụ nwoke a, ha gbara ọsọ pụọ nʼihu ya ma tụọkwa oke egwu.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.24",
            "verseOrgIds": [
              "1SA.17.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1SA 17:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị Izrel sịrị, \"Unu hụrụ nwoke a na-eguzo onwe ya? Ọ bụ ka ọ kparịa nnọọ ndị Izrel ka o ji apụta? Eze kwere nkwa inye onye ọbụla ga-etigbu ya akụ nʼebe ọ bara ụba. Ọ ga-akpọnyekwa ya nwa ya nwanyị ka ọ bụrụ nwunye ya, meekwa ka ndị ezinaụlọ onye ahụ gharakwa ịtụ ụtụ taks ọzọ nʼIzrel!\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.25",
            "verseOrgIds": [
              "1SA.17.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1SA 17:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Devid jụrụ ndị ikom nọ ya nso, \"Gịnị ka a ga-emere nwoke ga-etigbu onye Filistia a, meekwa ka mkparị a ghara ịdịrị Izrel ọzọ? Onye ka onye Filistia a a na-ebighị ugwu bụ, na ọ ga-apụta na-akparị ndị agha Chineke dị ndụ?\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.26",
            "verseOrgIds": [
              "1SA.17.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1SA 17:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha gwara ya otu ihe ahụ ha kwuru na mbụ sị ya na ọ bụ ihe ahụ ka a ga-emere onye gburu ya.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.27",
            "verseOrgIds": [
              "1SA.17.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1SA 17:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Eliab, nwanne Devid nke okenye, nụrụ ka ya na ndị ikom ahụ na-ekwu okwu, o were iwe dị ọkụ megide ya, jụọ ya sị, \"Gịnị ka ị bịara ime nʼebe a? Onye kwa ka ị hapụrụ atụrụ ole na ole ndị ahụ nʼọzara? Amaara m ụdị nganga dị nʼime gị na echiche ọjọọ juru gị obi. Ihe ị ji bịa nʼebe a bụ naanị ka ịhụchata ihe na-eme nʼagha.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.28",
            "verseOrgIds": [
              "1SA.17.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1SA 17:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Devid zara sị ya, \"Oleekwanụ ihe m mere ugbu a? Adara m iwu nʼihi na m jụrụ ajụjụ?\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.29",
            "verseOrgIds": [
              "1SA.17.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1SA 17:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Devid chigharịkwara jekwuru onye ọzọ jụọkwa ya otu ajụjụ ahụ. Ọ natakwara otu ụdị ọsịsa ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.30",
            "verseOrgIds": [
              "1SA.17.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1SA 17:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼikpeazụ, mgbe a matara ihe bụ uche Devid, e mere ka Sọl mara ihe banyere Devid. Sọl zikwara ozi ka a kpọọ ya.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.31",
            "verseOrgIds": [
              "1SA.17.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1SA 17:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Devid sịrị Sọl, \"Ka obi onye ọbụla ghara ịda mba nʼihi onye Filistia a; ohu gị ga-aga lụso ya ọgụ.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.32",
            "verseOrgIds": [
              "1SA.17.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1SA 17:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Sọl zaghachiri, \"Ị pụghị ibuso onye Filistia a agha, megide ya, nʼihi na i bụ naanị nwantakịrị, ma ya onwe ya bu onye na-ebu agha siterị na mgbe ọ bụ okorobịa.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.33",
            "verseOrgIds": [
              "1SA.17.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1SA 17:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Devid gwara Sọl sị, \"Ohu gị bụ onye na-elekọta atụrụ nna ya. Mgbe ọdụm maọbụ anụ ọhịa bịa bịara buru atụrụ site nʼigwe atụrụ ahụ,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.34",
            "verseOrgIds": [
              "1SA.17.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1SA 17:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "achụụrụ m ya, tigbuo ya ma napụtakwa atụrụ ahụ site nʼọnụ ya. Mgbe o biliri imegide m, ejidere m ya nʼajị ya, tie ya ihe, gbuo ya.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.35",
            "verseOrgIds": [
              "1SA.17.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1SA 17:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Etigburu m ọdụm na anụ ọhịa bịa ahụ, ugbu a, apụkwara m ime onye Filistia a na-amaghị Chineke otu ihe ahụ, nʼihi na ọ kparịala usuu ndị agha Chineke dị ndụ!",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.36",
            "verseOrgIds": [
              "1SA.17.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1SA 17:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1SA.17.37",
                "verseOrgIds": [
                  "1SA.17.37"
                ]
              }
            }
          ]
        },
        {
          "text": "ahụ napụtara m site nʼaka ọdụm na anụ ọhịa bịa ga-anapụtakwa m site nʼaka onye Filistia a!\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.37",
            "verseOrgIds": [
              "1SA.17.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 17:37"
      },
      "items": [
        {
          "text": "Nʼikpeazụ, Sọl sịrị Devid, \"Gaa, ka",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.37",
            "verseOrgIds": [
              "1SA.17.37"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1SA.17.37",
                "verseOrgIds": [
                  "1SA.17.37"
                ]
              }
            }
          ]
        },
        {
          "text": "nọnyere gị.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.37",
            "verseOrgIds": [
              "1SA.17.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1SA 17:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Sọl yinyere Devid uwe ime ahụ nke ya, yikwasịkwa ya uwe agha igwe, ma kpukwasị ya okpu bronz nʼisi.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.38",
            "verseOrgIds": [
              "1SA.17.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1SA 17:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Devid fanyere mma agha nʼime uwe ahụ, malite ijegharị ije, nʼihi na ọ maghị otu e si eyi uwe ndị ahụ ejegharị.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.39",
            "verseOrgIds": [
              "1SA.17.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 17:39"
      },
      "items": [
        {
          "text": "Ọ dịghị anya, o gwara Sọl okwu sị, \"Agaghị m eyi uwe ndị a nʼihi na o doghị m ahụ.\" Ya mere, Devid yipụrụ ha.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.39",
            "verseOrgIds": [
              "1SA.17.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1SA 17:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emesịa, o were mkpanaka ya nʼaka ya, site nʼiyi họpụta nkume ise dị mụrụmụrụ tinye ha nʼakpa nta dị nʼime akpa onye ọzụzụ atụrụ ya. O jidere ebe ya nʼaka ya, malite ịpụkwuru onye Filistia ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.40",
            "verseOrgIds": [
              "1SA.17.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1SA 17:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye Filistia ahụ, na-abịa nso na-apụkwute Devid, onye ahụ na-ebu ọta ya na-agakwa nʼihu ya.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.41",
            "verseOrgIds": [
              "1SA.17.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1SA 17:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "O lere Devid anya hụ na ọ bụ naanị nwantakịrị nwoke, onye ahụ dị mma, onye mara mma ile anya. Nʼihi ya, o ledara Devid anya.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.42",
            "verseOrgIds": [
              "1SA.17.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "1SA 17:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ sịrị Devid, \"Abụ m nkịta, na i ji mkpanaka na-abịakwute m?\" Onye Filistia ahụ ji aha chi niile ya bụọ Devid ọnụ.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.43",
            "verseOrgIds": [
              "1SA.17.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "1SA 17:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ sịrị, \"Bịa nʼebe a ka m were anụ ahụ gị mere anụ ufe nke eluigwe na anụ ọhịa niile ihe oriri!\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.44",
            "verseOrgIds": [
              "1SA.17.44"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "1SA 17:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Devid sịrị onye Filistia ahụ, \"I ji mma agha na ùbe igwe na ùbe osisi, na-abịakwute m, ma eji m aha",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.45",
            "verseOrgIds": [
              "1SA.17.45"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1SA.17.45",
                "verseOrgIds": [
                  "1SA.17.45"
                ]
              }
            }
          ]
        },
        {
          "text": ", Onye pụrụ ime ihe niile, Chineke nke usuu ndị agha Izrel ahụ ị kparịrị, na-abịakwute gị.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.45",
            "verseOrgIds": [
              "1SA.17.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "1SA 17:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Taa ka",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.46",
            "verseOrgIds": [
              "1SA.17.46"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1SA.17.46",
                "verseOrgIds": [
                  "1SA.17.46"
                ]
              }
            }
          ]
        },
        {
          "text": "ga-enyefe gị nʼaka m. Aga m etigbu gị, bepụkwa gị isi. Taa aga m ewere anụ ahụ ndị agha Filistia niile nyefee nʼaka ụmụ anụ ufe niile nke eluigwe, na ụmụ anụ ọhịa niile nke ụwa. Ụwa niile ga-amatakwa na Chineke nọ nʼIzrel.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.46",
            "verseOrgIds": [
              "1SA.17.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "1SA 17:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị niile guzokwa nʼebe a ga-amata na",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.47",
            "verseOrgIds": [
              "1SA.17.47"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1SA.17.47",
                "verseOrgIds": [
                  "1SA.17.47"
                ]
              }
            }
          ]
        },
        {
          "text": "adịghị eji mma agha maọbụ ùbe azọpụta. Nʼihi na agha a bụ nke",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.47",
            "verseOrgIds": [
              "1SA.17.47"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1SA.17.47",
                "verseOrgIds": [
                  "1SA.17.47"
                ]
              }
            }
          ]
        },
        {
          "text": ", ọ ga-ewerekwa unu niile nyefee anyị nʼaka.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.47",
            "verseOrgIds": [
              "1SA.17.47"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "1SA 17:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe onye Filistia ahụ na-abịa nso ibuso ya agha, Devid jiri ọsọ gbara gaa nʼihu agha izute ya.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.48",
            "verseOrgIds": [
              "1SA.17.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "1SA 17:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ manyere aka nʼime akpa ya wepụta otu nkume, maa ya mata onye Filistia ahụ nʼegedege ihu. Nkume ahụ mikpuru nʼegedege ihu ya, ọ dakwara kpuo ihu nʼala.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.49",
            "verseOrgIds": [
              "1SA.17.49"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "1SA 17:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otu a ka Devid si jiri ebe na nkume merie onye Filistia ahụ. O gburu onye Filistia ahụ ma o jighị mma ọbụla nʼaka ya gbuo ya.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.50",
            "verseOrgIds": [
              "1SA.17.50"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "1SA 17:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Devid gbaara ọsọ jeruo nʼebe Golaịat dara, mịịrị mma agha ya site nʼọbọ, jiri ya gbuo ya. O ji ya bepụkwa isi ya!",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.51",
            "verseOrgIds": [
              "1SA.17.51"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 17:51"
      },
      "items": [
        {
          "text": "Mgbe ndị Filistia hụrụ na onye ọka agha ha adaala nwụọ, ha tụgharịrị gbawa ọsọ.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.51",
            "verseOrgIds": [
              "1SA.17.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "1SA 17:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, ndị agha Izrel na Juda tiri mkpu ọṅụ, biliekwa, malite ịchụ ndị Filistia ọsọ. Ha chụrụ ha ọsọ chụruo ha nʼọnụ ụzọ ama Gat, na nʼọnụ ụzọ ama Ekrọn. Ndị Filistia nwụrụ anwụ dara nnọọ aghara aghara nʼụzọ Shaaraim nke gawara Gat na Ekrọn.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.52",
            "verseOrgIds": [
              "1SA.17.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "1SA 17:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emesịa, ndị Izrel lọghachiri bịa kwakọrọ ihe niile dị nʼụlọ ikwu ndị Filistia, nke ha hapụrụ gbaa ọsọ.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.53",
            "verseOrgIds": [
              "1SA.17.53"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "1SA 17:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Devid buuru isi onye Filistia bulata na Jerusalem. Ma dobe ngwa agha onye Filistia ahụ nʼime ụlọ ikwu nke ya.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.54",
            "verseOrgIds": [
              "1SA.17.54"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "1SA 17:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Sọl nọ na-ele Devid anya ka ọ na-apụ izute onye Filistia ahụ, ọ sịrị Abna, ọchịagha ya, \"Abna, nwa onye ka nwokorobịa ahụ bụ?\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.55",
            "verseOrgIds": [
              "1SA.17.55"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 17:55"
      },
      "items": [
        {
          "text": "Abna zara sị, \"Dịka i si adị ndụ, eze, amaghị m.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.55",
            "verseOrgIds": [
              "1SA.17.55"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "56",
            "style": "v",
            "sid": "1SA 17:56"
          },
          "items": [
            {
              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eze zara sị, \"Chọpụta onye mụrụ nwokorobịa a.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.56",
            "verseOrgIds": [
              "1SA.17.56"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "57",
            "style": "v",
            "sid": "1SA 17:57"
          },
          "items": [
            {
              "text": "57",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Devid si nʼigbu onye Filistia ahụ lọghachi, Abna duuru ya, dute ya nʼihu Sọl. Isi onye Filistia a dịkwa nʼaka Devid.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.57",
            "verseOrgIds": [
              "1SA.17.57"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "58",
            "style": "v",
            "sid": "1SA 17:58"
          },
          "items": [
            {
              "text": "58",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sọl jụrụ ya sị, \"Nwokorobịa, nwa onye ka ị bụ?\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.58",
            "verseOrgIds": [
              "1SA.17.58"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 17:58"
      },
      "items": [
        {
          "text": "Devid zara sị, \"Abụ m nwa ohu gị nwoke Jesi onye Betlehem.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.58",
            "verseOrgIds": [
              "1SA.17.58"
            ]
          }
        }
      ]
    }
  ],
