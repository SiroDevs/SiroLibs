        },
        {
          "text": "tigburu iri ndị ikom asaa nʼetiti ndị Bet-Shemesh nʼihi na ha nyobara anya nʼime igbe ọgbụgba ndụ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.6.19",
            "verseOrgIds": [
              "1SA.6.19"
            ]
