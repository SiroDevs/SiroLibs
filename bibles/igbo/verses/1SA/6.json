                "verseOrgIds": [
                  "1SA.6.19"
                ]
              }
            }
          ]
        },
        {
          "text": "ahụ. Nʼihi ya ndị Bet-Shemesh ruru ụjụ nʼihi ndị ahụ niile",
          "type": "text",
