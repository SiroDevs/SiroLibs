            "style": "v",
            "sid": "1SA 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha wetakwara oke ọlaedo a dịka ọnụọgụgụ obodo ndị Filistia si dị, bụ nke ndịisi ise ahụ nwere, obodo ndị e wusiri ike, na obodo nta niile ha. Nkume ukwu ahụ ebe a dọkwasịrị igbe ọgbụgba ndụ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.6.18",
            "verseOrgIds": [
              "1SA.6.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1SA.6.18",
                "verseOrgIds": [
                  "1SA.6.18"
                ]
              }
            }
          ]
        },
        {
          "text": ", bụ ihe akaebe nʼubi Joshua, onye Bet-Shemesh ruo taa.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.6.18",
            "verseOrgIds": [
              "1SA.6.18"
            ]
          }
        }
