    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "AMO 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okwu ndị Emọs kwuru, onye bụ otu nʼime ndị ọzụzụ atụrụ nke obodo Tekoa. Ndị a bụ ọhụ ọ hụrụ banyere Izrel. Ọ hụrụ ọhụ a mgbe Uzaya bụ eze ndị Juda. Nʼoge ahụ kwa ka Jeroboam nwa Joash na-achị Izrel. Ọ hụrụ ọhụ a afọ abụọ tupu oke ala ọma jijiji ahụ adịrị.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.1",
            "verseOrgIds": [
              "AMO.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "AMO 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ sịrị,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.2",
            "verseOrgIds": [
              "AMO.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 1:2"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "AMO.1.2",
                "verseOrgIds": [
                  "AMO.1.2"
                ]
              }
            }
          ]
        },
        {
          "text": "si nʼugwu Zayọn na-ebigbọ,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.2",
            "verseOrgIds": [
              "AMO.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 1:2"
      },
      "items": [
        {
          "text": "o si na Jerusalem na-eme ka olu ya daa ụda.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.2",
            "verseOrgIds": [
              "AMO.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 1:2"
      },
      "items": [
        {
          "text": "Ebe ịta nri nke ndị ọzụzụ atụrụ ga-eru ụjụ.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.2",
            "verseOrgIds": [
              "AMO.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 1:2"
      },
      "items": [
        {
          "text": "Elu ugwu Kamel ga-akpọnwụkwa.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.2",
            "verseOrgIds": [
              "AMO.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ikpe ọmụma dịrị ndị agbataobi Izrel",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "AMO 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otu a ka",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.3",
            "verseOrgIds": [
              "AMO.1.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "AMO.1.3",
                "verseOrgIds": [
                  "AMO.1.3"
                ]
              }
            }
          ]
        },
        {
          "text": "na-ekwu,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.3",
            "verseOrgIds": [
              "AMO.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 1:3"
      },
      "items": [
        {
          "text": "\"Nʼihi njehie atọ nke Damaskọs,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.3",
            "verseOrgIds": [
              "AMO.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 1:3"
      },
      "items": [
        {
          "text": "na nʼihi njehie ha nke ugboro anọ, agaghị m ahapụ inye ya ntaramahụhụ.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.3",
            "verseOrgIds": [
              "AMO.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 1:3"
      },
      "items": [
        {
          "text": "Nʼihi na ha azọpịala ndị m nʼime Gilead,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.3",
            "verseOrgIds": [
              "AMO.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 1:3"
      },
      "items": [
        {
          "text": "ha ji igwe ịzọcha mkpụrụ ọka nwere eze.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.3",
            "verseOrgIds": [
              "AMO.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "AMO 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi ya, aga m esunye ọkụ nʼụlọeze Hazael;",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.4",
            "verseOrgIds": [
              "AMO.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 1:4"
      },
      "items": [
        {
          "text": "ọkụ a ga-erepịakwa ebe niile e wusiri ike nke Ben-Hadad.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.4",
            "verseOrgIds": [
              "AMO.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "AMO 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aga m etiji ibo ọnụ ụzọ ama Damaskọs,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.5",
            "verseOrgIds": [
              "AMO.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 1:5"
      },
      "items": [
        {
          "text": "aga m ekpochapụkwa ndị niile bi na Ndagwurugwu Aven,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.5",
            "verseOrgIds": [
              "AMO.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 1:5"
      },
      "items": [
        {
          "text": "na onye ahụ mkpara eze dị nʼaka ya, nke nọ na Bet-Eden.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.5",
            "verseOrgIds": [
              "AMO.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 1:5"
      },
      "items": [
        {
          "text": "Ndị Aram ga-abụkwa ndị a dọtara nʼagha, ndị a ga-adọkpụrụ gaa Kia.\"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.5",
            "verseOrgIds": [
              "AMO.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 1:5"
      },
      "items": [
        {
          "text": "Ka",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.5",
            "verseOrgIds": [
              "AMO.1.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "AMO.1.5",
                "verseOrgIds": [
                  "AMO.1.5"
                ]
              }
            }
          ]
        },
        {
          "text": "kwuru.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.5",
            "verseOrgIds": [
              "AMO.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "AMO 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otu a ka",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.6",
            "verseOrgIds": [
              "AMO.1.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "AMO.1.6",
                "verseOrgIds": [
                  "AMO.1.6"
                ]
              }
            }
          ]
        },
        {
          "text": "na-ekwu,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.6",
            "verseOrgIds": [
              "AMO.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 1:6"
      },
      "items": [
        {
          "text": "\"Nʼihi njehie atọ nke Gaza,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.6",
            "verseOrgIds": [
              "AMO.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 1:6"
      },
      "items": [
        {
          "text": "e, nʼihi njehie nke anọ, agaghị m ahapụ inye ya ntaramahụhụ,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.6",
            "verseOrgIds": [
              "AMO.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 1:6"
      },
      "items": [
        {
          "text": "nʼihi na ha dọtara mmadụ niile nʼagha,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.6",
            "verseOrgIds": [
              "AMO.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 1:6"
      },
      "items": [
        {
          "text": "ranye nʼaka ndị Edọm.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.6",
            "verseOrgIds": [
              "AMO.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "AMO 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi ya, aga m esunye ọkụ na mgbidi niile nke Gaza,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.7",
            "verseOrgIds": [
              "AMO.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 1:7"
      },
      "items": [
        {
          "text": "ebe ya niile e wusiri ike ga-agba ọkụ.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.7",
            "verseOrgIds": [
              "AMO.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "AMO 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aga m egbu ndị Ashdọd,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.8",
            "verseOrgIds": [
              "AMO.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 1:8"
      },
      "items": [
        {
          "text": "ma bibiekwa onye ahụ na-achị Ashkelọn.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.8",
            "verseOrgIds": [
              "AMO.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 1:8"
      },
      "items": [
        {
          "text": "Aga eweli aka m megide ndị Ekrọn,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.8",
            "verseOrgIds": [
              "AMO.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 1:8"
      },
      "items": [
        {
          "text": "ruo mgbe ndị Filistia fọdụrụ ga-ala nʼiyi.\"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.8",
            "verseOrgIds": [
              "AMO.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 1:8"
      },
      "items": [
        {
          "text": "Otu a ka Onye kachasị ihe niile elu, bụ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.8",
            "verseOrgIds": [
              "AMO.1.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "AMO.1.8",
                "verseOrgIds": [
                  "AMO.1.8"
                ]
              }
            }
          ]
        },
        {
          "text": "sịrị.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.8",
            "verseOrgIds": [
              "AMO.1.8"
            ]
          }
        }
      ]
    },
