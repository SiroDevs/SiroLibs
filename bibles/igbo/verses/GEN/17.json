  "verseCount": 27,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "17",
        "style": "c",
        "sid": "GEN 17"
      },
      "items": [
        {
          "text": "17",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ọgbụgba ndụ nke obibi ugwu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Ebram gbara iri afọ itoolu na itoolu,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.1",
            "verseOrgIds": [
              "GEN.17.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "GEN.17.1",
                "verseOrgIds": [
                  "GEN.17.1"
                ]
              }
            }
          ]
        },
        {
          "text": "gosiri ya onwe ya sị ya, \"Abụ m Chineke Onye pụrụ ime ihe niile. Jegharịa ije nʼihu m, bụrụ onye na-enweghị ịta ụta ọbụla.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.1",
            "verseOrgIds": [
              "GEN.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aga m eme ka ọgbụgba ndụ m dịrị nʼetiti mụ na gị, mekwa ka ị mụbaa nke ukwuu nʼọnụọgụgụ.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.2",
            "verseOrgIds": [
              "GEN.17.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebram dara nʼala, kpudo ihu ya nʼala. Chineke gwara ya sị,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.3",
            "verseOrgIds": [
              "GEN.17.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Lee, nke a bụ ọgbụgba ndụ dị nʼetiti mụ na gị. Ị ga-abụ nna ọtụtụ mba.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.4",
            "verseOrgIds": [
              "GEN.17.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aha gị agaghị abụkwa Ebram, kama ọ ga-abụ Ebraham, nʼihi na emeela m gị nna nke ọtụtụ mba.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.5",
            "verseOrgIds": [
              "GEN.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aga m eme gị ka ị mụbaa nke ukwuu. Aga m eme ka ị ghọọ ọtụtụ mba dị iche iche, ndị eze ga-esitekwa na gị pụta.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.6",
            "verseOrgIds": [
              "GEN.17.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aga m eme ka ọgbụgba ndụ mụ na gị gbara guzosie ike, ka ọ dịkwara ụmụ ụmụ ndị ga-esote gị nʼọgbọ niile na-abịa. Ọ bụ ọgbụgba ndụ na-egosi na m bụ Chineke gị, na Chineke ụmụ ụmụ gị niile ga-eso gị.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.7",
            "verseOrgIds": [
              "GEN.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ala Kenan niile, ebe ị nọ ugbu a dịka ọbịa ka m ga-enye gị na ụmụ ụmụ gị ga-esote gị dịka ihe nketa ebighị ebi. Aga m abụ Chineke ha.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.8",
            "verseOrgIds": [
              "GEN.17.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chineke gwara Ebraham okwu sị ya, \"Ma nʼebe ị nọ, ị ghaghị irube isi imezu ihe ọgbụgba ndụ m kwuru, gị onwe gị na ụmụ ụmụ gị ndị ga-esote gị, ruo ọgbọ niile.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.9",
            "verseOrgIds": [
              "GEN.17.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nke a bụ ọgbụgba ndụ dị nʼetiti mụ na gị na ụmụ ụmụ gị ndị ga-esote gị, ọgbụgba ndụ nke unu na-aghaghị idebe. A ga-ebi nwoke ọbụla nʼetiti unu ugwu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.10",
            "verseOrgIds": [
              "GEN.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "A ga-ebi unu ugwu, bipụ elu ahụ nke anụ ahụ unu. Nke a ga-abụ ihe ama nke ọgbụgba ndụ dị nʼetiti mụ na unu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.11",
            "verseOrgIds": [
              "GEN.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼoge ọ gbara mkpụrụ ụbọchị asatọ, unu ga-ebi nwoke ọbụla nʼagbụrụ unu ugwu: ndị a mụrụ nʼụlọ, maọbụ ndị eji ego zụta site nʼaka ndị mba ọzọ, ndị na-esighị na mkpụrụ nke afọ gị.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.12",
            "verseOrgIds": [
              "GEN.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "A ga-ebi ha niile ugwu. Ma a mụrụ ha nʼezinaụlọ gị ma i ji ego zụta ha site nʼaka onye mba ọzọ. Ọgbụgba ndụ m nke ga-apụta ihe nʼanụ ahụ gị bụ ọgbụgba ndụ ebighị ebi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.13",
            "verseOrgIds": [
              "GEN.17.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwoke ọbụla a na-ebighị ugwu nke anụ ahụ ka a ga-ebipụ site nʼetiti ụmụnna ya. Nʼihi na o mehiela megide ọgbụgba ndụ m.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.14",
            "verseOrgIds": [
              "GEN.17.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chineke gwakwara Ebraham sị, \"Ma nʼebe Serai nwunye gị nọ, ị gaghị akpọkwa ya Serai ọzọ, kama aha ya ga-abụ Sera.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.15",
            "verseOrgIds": [
              "GEN.17.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aga m agọzi ya, sitekwa na ya nye gị nwa nwoke. Aga m agọzi ya ruo na ọ ga-abụ nne nke ọtụtụ mba. Ndị eze ga-achị ọtụtụ mmadụ ga-esite na ya pụta.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.16",
            "verseOrgIds": [
              "GEN.17.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 17:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebraham dara kpuo ihu nʼala, chịakwa ọchị nʼobi ya sị, \"Ọ bụ onye gbara narị afọ ka a ga-amụrụ nwa? Sera, onye gbara iri afọ itoolu ọ ga-amụ nwa?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.17",
            "verseOrgIds": [
              "GEN.17.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebraham gwara Chineke sị, \"A sịkwa na ị ga-ekwe mee ka Ishmel bụrụ onye dị ndụ nʼihu gị.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.18",
            "verseOrgIds": [
              "GEN.17.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 17:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Chineke zara sị ya, \"Ee, kama Sera nwunye gị ga-amụtara gị nwa nwoke. Ị ga-agụ ya Aịzik. Ọgbụgba ndụ m ga-adịkwara ya na agbụrụ ya ruo mgbe ebighị ebi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.19",
            "verseOrgIds": [
              "GEN.17.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 17:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma banyere Ishmel, anụla m ihe i kwuru. Aga m agọzi ya mee ya ka ọ baa ụba ma dịkwa ukwuu nʼọnụọgụgụ. Ọ ga-aghọ nna ndị eze iri na abụọ. Aga m eme ya ka ọ ghọọ mba dị ukwuu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.20",
            "verseOrgIds": [
              "GEN.17.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 17:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ọgbụgba ndụ m ka m ga-eme ka o guzosie ike nʼebe Aịzik nọ, onye Sera ga-amụtara gị nʼoge dịka ugbu a nʼafọ ọzọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.21",
            "verseOrgIds": [
              "GEN.17.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 17:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ọ gwasịrị Ebraham okwu, Chineke si nʼebe ọ nọ pụọ.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.22",
            "verseOrgIds": [
              "GEN.17.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 17:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼụbọchị ahụ, Ebraham duuru Ishmel nwa ya nwoke, na ndị ikom niile a mụrụ nʼezinaụlọ ya, tinyere ndị e ji ego zụta, ndị ikom niile nọ nʼezinaụlọ ya, bie ha ugwu dịka Chineke gwara ya ka ọ mee.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.23",
            "verseOrgIds": [
              "GEN.17.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 17:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebraham gbara iri afọ itoolu na itoolu mgbe e biri ya ugwu,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.24",
            "verseOrgIds": [
              "GEN.17.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 17:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ishmel nwa ya gbara afọ iri na atọ.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.25",
            "verseOrgIds": [
              "GEN.17.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 17:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "E biri Ebraham na nwa ya bụ Ishmel ugwu nʼotu ụbọchị ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.26",
            "verseOrgIds": [
              "GEN.17.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 17:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị ikom niile nọ nʼezinaụlọ Ebraham, ndị a mụrụ nʼụlọ ya na ndị e si nʼaka ndị mba ọzọ zụta ka e biri ugwu nʼoge Ebraham biri ugwu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.27",
            "verseOrgIds": [
              "GEN.17.27"
            ]
          }
        }
      ]
    }
  ],
