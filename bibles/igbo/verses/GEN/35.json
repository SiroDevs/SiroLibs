        "vid": "GEN 35:26"
      },
      "items": [
        {
          "text": "Ụmụ ndị ikom ndị a ka a mụụrụ Jekọb na Padan Aram.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
