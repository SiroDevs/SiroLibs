  "verseCount": 43,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "36",
        "style": "c",
        "sid": "GEN 36"
      },
      "items": [
        {
          "text": "36",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ụmụ ụmụ Ịsọ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 36:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nke a bụ akụkọ banyere usoro agbụrụ Ịsọ, onye a na-akpọ Edọm.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.1",
            "verseOrgIds": [
              "GEN.36.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 36:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ịsọ lụrụ ndị inyom a site nʼala Kenan. Onye nke mbụ bụ Ada nwa Elọn, onye Het. Nke abụọ bụ Oholibama, nwa Ana, nwa nwa Zibiọn, onye Hiv.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.2",
            "verseOrgIds": [
              "GEN.36.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 36:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye nke atọ bụ Basemat, nwa Ishmel, onye nwanne ya nwanyị bụ Nebaiot.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.3",
            "verseOrgIds": [
              "GEN.36.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 36:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ada mụụrụ Ịsọ Elifaz, ebe Basemat mụrụ Reuel.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.4",
            "verseOrgIds": [
              "GEN.36.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 36:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oholibama mụtaara Jeush na Jalam na Kora. Ndị a bụ ụmụ Ịsọ ndị a mụtara ya nʼala Kenan.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.5",
            "verseOrgIds": [
              "GEN.36.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 36:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emesịa, Ịsọ duuru ndị nwunye ya na ụmụ ya ndị ikom na ndị inyom, na ndị niile nọ nʼezinaụlọ ya. Ọ chịkọọrọ anụ ụlọ ya niile, na akụ niile ọ kpatara nʼala Kenan kwapụ gaa biri nʼala dị anya site nʼebe nwanne ya Jekọb nọ.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.6",
            "verseOrgIds": [
              "GEN.36.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 36:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebe ọ bụ na akụnụba ha nwere dịkarịrị ukwuu ha ibikọta ọnụ, tinyekwara na ala ebe ha bi enwezighị ike ibuli ha nʼihi anụ ụlọ niile ha nwere.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.7",
            "verseOrgIds": [
              "GEN.36.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 36:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, Ịsọ gara biri nʼala ugwu ugwu Sia, Ịsọ bụkwa Edọm.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.8",
            "verseOrgIds": [
              "GEN.36.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 36:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nke a bụ akụkọ banyere usoro agbụrụ Ịsọ, nna obodo Edọm, nʼala ugwu ugwu Sia.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 36:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị a bụ aha ụmụ ndị ikom Ịsọ mụtara.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.10",
            "verseOrgIds": [
              "GEN.36.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "GEN 36:10"
      },
      "items": [
        {
          "text": "Elifaz bụ ọkpara Ada, nwunye Ịsọ. Nwanne ya bụ Reuel, nwa Basemat, nwunye Ịsọ.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.10",
            "verseOrgIds": [
              "GEN.36.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 36:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụmụ Elifaz ndị ikom bụ,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.11",
            "verseOrgIds": [
              "GEN.36.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "GEN 36:11"
      },
      "items": [
        {
          "text": "Teman, Ọmaa, Zefo, Gatam na Kenaz.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.11",
            "verseOrgIds": [
              "GEN.36.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 36:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elifaz nwa Ịsọ nwere iko nwanyị aha ya bụ Timna, onye mụtaara ya Amalek. Ndị a niile bụ ụmụ ndị ikom Ada, nwunye Ịsọ.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.12",
            "verseOrgIds": [
              "GEN.36.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 36:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụmụ ndị ikom Reuel bụ,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.13",
            "verseOrgIds": [
              "GEN.36.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "GEN 36:13"
      },
      "items": [
        {
          "text": "Nahat, Zera, Shama na Miza. Ndị a niile bụ ụmụ ụmụ Basemat, nwunye Ịsọ.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.13",
            "verseOrgIds": [
              "GEN.36.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 36:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị a bụ ụmụ Oholibama, nwunye Ịsọ. Oholibama bụ nwa Ana na nwa nwa Zibiọn. Ọ mụtaara Ịsọ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.14",
            "verseOrgIds": [
              "GEN.36.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "GEN 36:14"
      },
      "items": [
        {
          "text": "Jeush, Jalam na Kora.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.14",
            "verseOrgIds": [
              "GEN.36.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 36:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị a bụ ọnụmara si nʼetiti ụmụ ụmụ Ịsọ.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "GEN 36:15"
      },
      "items": [
        {
          "text": "Site nʼetiti ụmụ Elifaz, ọkpara Ịsọ,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.15",
            "verseOrgIds": [
              "GEN.36.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "GEN 36:15"
      },
      "items": [
        {
          "text": "e nwere Ọnụmara Teman, ọnụmara Ọmaa, ọnụmara Zefo, ọnụmara Kenaz.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.15",
            "verseOrgIds": [
              "GEN.36.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 36:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọnụmara Kora, ọnụmara Gatam na ọnụmara Amalek. Ndị eze ndị a bụ ụmụ Elifaz nʼala Edọm. Ha bụ ụmụ ụmụ Ada.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.16",
            "verseOrgIds": [
              "GEN.36.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 36:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị bụ ụmụ Reuel, nwa Ịsọ,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.17",
            "verseOrgIds": [
              "GEN.36.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "GEN 36:17"
      },
      "items": [
        {
          "text": "e nwere ọnụmara Nahat, ọnụmara Zera, ọnụmara Shama, ọnụmara Miza. Ọnụmara ndị a bụ ụmụ Reuel nʼala Edọm. Ha bụ ụmụ Basemat, nwunye Ịsọ.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.17",
            "verseOrgIds": [
              "GEN.36.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 36:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị a bụ ụmụ Oholibama, nwunye Ịsọ,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.18",
            "verseOrgIds": [
              "GEN.36.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "GEN 36:18"
      },
      "items": [
        {
          "text": "ọnụmara Jeush, ọnụmara Jalam, na ọnụmara Kora. Ndị a bụ ọnụmara ụmụ Oholibama nwa Ana, nwunye Ịsọ.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.18",
            "verseOrgIds": [
              "GEN.36.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 36:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị a niile bụ ụmụ ndị ikom Ịsọ (ya bụ, Edọm). Ndị a bụkwa ọnụmara ha.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 36:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị a bụ ụmụ ndị ikom Sia onye Hor, ndị bi nʼakụkụ ala ahụ:",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.20",
            "verseOrgIds": [
              "GEN.36.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "GEN 36:20"
      },
      "items": [
        {
          "text": "Lotan, Shobal, Zibiọn, Ana,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.20",
            "verseOrgIds": [
              "GEN.36.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 36:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dishọn, Eza na Dishan. Ụmụ ndị ikom Sia nʼala Edọm, ha bụ ndị ọnụmara Hor.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.21",
            "verseOrgIds": [
              "GEN.36.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 36:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụmụ ndị ikom Lotan bụ,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.22",
            "verseOrgIds": [
              "GEN.36.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "GEN 36:22"
      },
      "items": [
        {
          "text": "Hori na Homam. Timna bụkwa nwanne nwanyị Lotan.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.22",
            "verseOrgIds": [
              "GEN.36.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
