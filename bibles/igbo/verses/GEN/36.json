          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụmụ ndị ikom Shobal bụ,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.23",
            "verseOrgIds": [
              "GEN.36.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "GEN 36:23"
      },
      "items": [
        {
          "text": "Alvan, Manahat, Ebal, Shefo na Onam.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.23",
            "verseOrgIds": [
              "GEN.36.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 36:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụmụ ndị ikom Zibiọn mụrụ bụ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.24",
            "verseOrgIds": [
              "GEN.36.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "GEN 36:24"
      },
      "items": [
        {
          "text": "Aịa na Ana. Ana bụ nwoke ahụ chọpụtara isi iyi mmiri ime ala ahụ nke mmiri dị ọkụ si nʼime ya na-asọpụta nʼọzara, mgbe ọ na-elekọta ịnyịnya ibu nna ya Zibiọn.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.24",
            "verseOrgIds": [
              "GEN.36.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 36:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụmụ Ana bụ,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.25",
            "verseOrgIds": [
              "GEN.36.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "GEN 36:25"
      },
      "items": [
        {
          "text": "Dishọn na Oholibama nwa nwanyị Ana.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.25",
            "verseOrgIds": [
              "GEN.36.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 36:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụmụ ndị ikom Dishọn bụ,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.26",
            "verseOrgIds": [
              "GEN.36.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "GEN 36:26"
      },
      "items": [
        {
          "text": "Hemdan na Eshban na Itran na Keran.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.26",
            "verseOrgIds": [
              "GEN.36.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 36:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụmụ ndị ikom Eza bụ,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.27",
            "verseOrgIds": [
              "GEN.36.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "GEN 36:27"
      },
      "items": [
        {
          "text": "Bilhan na Zaavan na Akan.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.27",
            "verseOrgIds": [
              "GEN.36.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 36:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụmụ ndị ikom Dishan bụ,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.28",
            "verseOrgIds": [
              "GEN.36.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "GEN 36:28"
      },
      "items": [
        {
          "text": "Uz na Aran.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.28",
            "verseOrgIds": [
              "GEN.36.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 36:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị a bụ ndị ọnụmara Hor,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.29",
            "verseOrgIds": [
              "GEN.36.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "GEN 36:29"
      },
      "items": [
        {
          "text": "ọnụmara Lotan, ọnụmara Shobal, ọnụmara Zibiọn, ọnụmara Ana,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.29",
            "verseOrgIds": [
              "GEN.36.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 36:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "ọnụmara Dishọn, ọnụmara Eza na ọnụmara Dishan.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.30",
            "verseOrgIds": [
              "GEN.36.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4",
        "vid": "GEN 36:30"
      },
      "items": [
        {
          "text": "Ndị a niile bụ ndị ọnụmara Hor dịka nkewa ha si dị nʼala Sia.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ndị eze Edọm",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 36:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị a bụ ndị eze chịrị nʼEdọm tupu ndị Izrel enwee eze mbụ ha.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 36:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bela, nwa Beoa chịrị dịka eze nʼEdọm. Isi obodo ya bụ Dinhaba.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.32",
            "verseOrgIds": [
              "GEN.36.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 36:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Bela nwụrụ, Jobab nwa Zera onye Bozra nọchiri ya dịka eze.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.33",
            "verseOrgIds": [
              "GEN.36.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "GEN 36:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Jobab nwụrụ, Husham onye si nʼala Teman nọchiri ya dịka eze.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.34",
            "verseOrgIds": [
              "GEN.36.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "GEN 36:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Husham nwụrụ, Hadad nwa Bedad, onye meriri ndị Midia nʼagha nʼala Moab nọchiri dịka eze. Isi obodo ya bụ Avit.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.35",
            "verseOrgIds": [
              "GEN.36.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "GEN 36:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Hadad nwụrụ, Samla onye Masrika nọchiri ya dịka eze.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.36",
            "verseOrgIds": [
              "GEN.36.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "GEN 36:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Samla nwụrụ, Shaul onye sitere na Rehobọt dị nʼakụkụ osimiri nọchiri ya dịka eze.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.37",
            "verseOrgIds": [
              "GEN.36.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "GEN 36:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Shaul nwụrụ, Baal-Hanan nwa Akboa nọchiri ya dịka eze.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.38",
            "verseOrgIds": [
              "GEN.36.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "GEN 36:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Baal-Hanan nwa Akboa nwụrụ, Heda nọchiri ya dịka eze. Aha obodo ya bụ Pau. Aha nwunye ya bụ Mehetabel, nwa Matred nwa nwa Mezahab.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.39",
            "verseOrgIds": [
              "GEN.36.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "GEN 36:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị a bụ ndịisi ọnụmara Ịsọ, dịka aha ha si dị, dịka ikwu ha na akụkụ ebe ha bi si dị:",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "GEN 36:40"
      },
      "items": [
        {
          "text": "Timna, Alva, Jetet,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.40",
            "verseOrgIds": [
              "GEN.36.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "GEN 36:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oholibama, Elaa, Pinon,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.41",
            "verseOrgIds": [
              "GEN.36.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "GEN 36:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenaz, Teman, Mibza,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.42",
            "verseOrgIds": [
              "GEN.36.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "GEN 36:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Magdiel na Iram.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.43",
            "verseOrgIds": [
              "GEN.36.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4",
        "vid": "GEN 36:43"
      },
      "items": [
        {
          "text": "Ndị a bụ ndịisi ọnụmara nʼEdọm, dịka ebe obibi ha na ala obi ha si dị.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "GEN 36:43"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4",
        "vid": "GEN 36:43"
      },
      "items": [
        {
          "text": "Nke a bụ ezinaụlọ Ịsọ bụkwa nna ndị Edọm.",
          "type": "text"
        }
      ]
    }
