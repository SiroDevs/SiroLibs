{
  "TIT.1": {
    "id": "TIT.1",
    "number": "1",
    "bookId": "TIT",
    "reference": "Taịtọs 1",
    "copyright": "Biblica® Open Igbo Contemporary Bible™ Copyright © 1980, 1988, 2019, 2020 by Biblica, Inc. Used with permission. All rights reserved worldwide.",
    "verseCount": 16,
    "content": [
      {
        "name": "chapter",
        "type": "tag",
        "attrs": {
          "number": "1",
          "style": "c",
          "sid": "TIT 1"
        },
        "items": [
          {
            "text": "1",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "1",
              "style": "v",
              "sid": "TIT 1:1"
            },
            "items": [
              {
                "text": "1",
                "type": "text"
              }
            ]
          },
          {
            "text": "Akwụkwọ ozi a si nʼaka m, Pọl, odibo Chineke, na onyeozi Jisọs Kraịst, onye ahọpụtara ime ka okwukwe ndị Chineke, na nghọta banyere ịmara eziokwu ahụ na-eduba na ndụ ịsọpụrụ Chineke gaa nʼihu,",
            "type": "text",
            "attrs": {
              "verseId": "TIT.1.1",
              "verseOrgIds": [
                "TIT.1.1"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "2",
              "style": "v",
              "sid": "TIT 1:2"
            },
            "items": [
              {
                "text": "2",
                "type": "text"
              }
            ]
          },
          {
            "text": "nke a dabere nʼolileanya maka ndụ ebighị ebi, nke Chineke onye na-adịghị agha ụgha kwerelarị na nkwa tupu mmalite nke oge.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.1.2",
              "verseOrgIds": [
                "TIT.1.2"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "3",
              "style": "v",
              "sid": "TIT 1:3"
            },
            "items": [
              {
                "text": "3",
                "type": "text"
              }
            ]
          },
          {
            "text": "Mgbe oge imezu nkwa ahụ ruru, o mere ka okwu ya pụta ìhè site na nkwusa oziọma, nke e nyefere m nʼaka idebe, dị ka Chineke Onye nzọpụta anyị si nye ya nʼiwu.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.1.3",
              "verseOrgIds": [
                "TIT.1.3"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "b"
        },
        "items": []
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "4",
              "style": "v",
              "sid": "TIT 1:4"
            },
            "items": [
              {
                "text": "4",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ọ bụ gị Taịtọs, ezi nwa m nwoke nʼime okwukwe nke anyị nwekọrọ.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.1.4",
              "verseOrgIds": [
                "TIT.1.4"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "b",
          "vid": "TIT 1:4"
        },
        "items": []
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p",
          "vid": "TIT 1:4"
        },
        "items": [
          {
            "text": "Ka amara na udo nke sitere na Chineke bụ Nna, na Kraịst Jisọs Onye nzọpụta anyị dịrị gị.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.1.4",
              "verseOrgIds": [
                "TIT.1.4"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "b"
        },
        "items": []
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "s1"
        },
        "items": [
          {
            "text": "Ọrụ dịrị Taịtọs",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "5",
              "style": "v",
              "sid": "TIT 1:5"
            },
            "items": [
              {
                "text": "5",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ahapụrụ m gị na Kriit ka i dozie ihe ụfọdụ a na-edozibeghị, ka ị họpụtakwa ndị okenye nʼobodo niile, dị ka m siri nye gị nʼiwu.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.1.5",
              "verseOrgIds": [
                "TIT.1.5"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "6",
              "style": "v",
              "sid": "TIT 1:6"
            },
            "items": [
              {
                "text": "6",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ọ ga-abụ onye a na-enweghị ihe ịta ụta, ọ ga-abụ onye na-alụ otu nwanyị. Ụmụ ya bụ ndị kwere ekwe, ndị ama na ha anaghị ebi ndụ ọjọọ, maọbụ na-eme isiike.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.1.6",
              "verseOrgIds": [
                "TIT.1.6"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "7",
              "style": "v",
              "sid": "TIT 1:7"
            },
            "items": [
              {
                "text": "7",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ebe ọ bụ na onye nlekọta nʼahụ ihe banyere chọọchị Chineke, ọ ga-abụ onye na-enweghị ihe ịta ụta. Ọ gaghị abụ onye nganga, onye na-ewe iwe ọkụ, onye na-aṅụbiga mmanya oke, onye na-alụ ọgụ mgbe niile, onye hụrụ ego nʼanya.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.1.7",
              "verseOrgIds": [
                "TIT.1.7"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "8",
              "style": "v",
              "sid": "TIT 1:8"
            },
            "items": [
              {
                "text": "8",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ọ ga-abụ onye na-anabata ndị ọbịa, na onye na-ahụ ezi ihe nʼanya. Ọ ga-abụ onye na-akwanyere onwe ya ugwu, ezi mmadụ ụzọ ya kwụ ọtọ, onye dị nsọ, na onyeisi zuruoke.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.1.8",
              "verseOrgIds": [
                "TIT.1.8"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "9",
              "style": "v",
              "sid": "TIT 1:9"
            },
            "items": [
              {
                "text": "9",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ọ ga-abụkwa onye jidesiri oziọma ahụ nke kwesiri ntụkwasị obi aka ike dịka eziri ya. Nke ga-eme ka o nwe ike gbaa ndị ọzọ ume site na ozizi ahụ nke zuruoke, nakwa ịtụ ndị ahụ na-eguzogide ya mmehie ha nʼihu.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.1.9",
              "verseOrgIds": [
                "TIT.1.9"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "s1"
        },
        "items": [
          {
            "text": "Igbochi ndị ozizi ụgha",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "10",
              "style": "v",
              "sid": "TIT 1:10"
            },
            "items": [
              {
                "text": "10",
                "type": "text"
              }
            ]
          },
          {
            "text": "Nʼihi na e nwere ọtụtụ mmadụ ndị na-ekweghị, ndị na-ekwu okwu efu, na ndị aghụghọ, nke ka nke, ndị si nʼotu ndị obibi ugwu pụta.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.1.10",
              "verseOrgIds": [
                "TIT.1.10"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "11",
              "style": "v",
              "sid": "TIT 1:11"
            },
            "items": [
              {
                "text": "11",
                "type": "text"
              }
            ]
          },
          {
            "text": "Aghaghị ịkwụsị ha maka na ha na-akụzi ihe ha ekwesighị ikuzi nʼihi ego, si otu ahụ na-eme ka ọtụtụ ezinaụlọ gbasaa.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.1.11",
              "verseOrgIds": [
                "TIT.1.11"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "12",
              "style": "v",
              "sid": "TIT 1:12"
            },
            "items": [
              {
                "text": "12",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ọ bụ otu onye nʼime ha, onye bụkwa onye amụma ha kwuru okwu banyere ha sị, \"Ndị Kriit niile bụ ndị ụgha. Ha kwara obi nʼazụ dị ka anụ ọhịa jọrọ njọ. Ha bụ ndị umengwụ nwere akpịrị ogologo.\"",
            "type": "text",
            "attrs": {
              "verseId": "TIT.1.12",
              "verseOrgIds": [
                "TIT.1.12"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "13",
              "style": "v",
              "sid": "TIT 1:13"
            },
            "items": [
              {
                "text": "13",
                "type": "text"
              }
            ]
          },
          {
            "text": "Nʼezie, okwu a bụ eziokwu. Nʼihi nke a, baara ha mba nʼolu ike banyere mmehie ha ka ha nwee ike zuo oke nʼokwukwe,",
            "type": "text",
            "attrs": {
              "verseId": "TIT.1.13",
              "verseOrgIds": [
                "TIT.1.13"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "14",
              "style": "v",
              "sid": "TIT 1:14"
            },
            "items": [
              {
                "text": "14",
                "type": "text"
              }
            ]
          },
          {
            "text": "ka ha kwụsị ige ntị nʼakụkọ ifo ndị Juu na-akọ, maọbụ iwu nke ndị jụrụ ịnabata eziokwu nyere.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.1.14",
              "verseOrgIds": [
                "TIT.1.14"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "15",
              "style": "v",
              "sid": "TIT 1:15"
            },
            "items": [
              {
                "text": "15",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ihe niile dị ọcha nʼebe ndị dị ọcha nọ, o nweghị ihe ọbụla dị ọcha nʼebe ndị rụrụ arụ na ndị na-ekweghị ekwe nọ. Nʼihi na uche ha na akọnuche ha rụrụ arụ.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.1.15",
              "verseOrgIds": [
                "TIT.1.15"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "16",
              "style": "v",
              "sid": "TIT 1:16"
            },
            "items": [
              {
                "text": "16",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ha na-ekwupụta na ha maara Chineke, ma ha ji omume ha na-agọnarị ya. Ha bụkwa ndị na-akpọ mmadụ ibe ha asị, ndị isiike, na ndị na-adịghị ike nʼezi ọrụ ọbụla.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.1.16",
              "verseOrgIds": [
                "TIT.1.16"
              ]
            }
          }
        ]
      }
    ],
    "next": {
      "id": "TIT.2",
      "number": "2",
      "bookId": "TIT"
    },
    "previous": {
      "id": "TIT.intro",
      "number": "intro",
      "bookId": "TIT"
    }
  },
  "TIT.2": {
    "id": "TIT.2",
    "number": "2",
    "bookId": "TIT",
    "reference": "Taịtọs 2",
    "copyright": "Biblica® Open Igbo Contemporary Bible™ Copyright © 1980, 1988, 2019, 2020 by Biblica, Inc. Used with permission. All rights reserved worldwide.",
    "verseCount": 15,
    "content": [
      {
        "name": "chapter",
        "type": "tag",
        "attrs": {
          "number": "2",
          "style": "c",
          "sid": "TIT 2"
        },
        "items": [
          {
            "text": "2",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "s1"
        },
        "items": [
          {
            "text": "Ezi ozizi na ezi agwa",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "1",
              "style": "v",
              "sid": "TIT 2:1"
            },
            "items": [
              {
                "text": "1",
                "type": "text"
              }
            ]
          },
          {
            "text": "Nʼakụkụ nke gị, na-akụzi ihe kwesiri eziokwu nke okwukwe.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.2.1",
              "verseOrgIds": [
                "TIT.2.1"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "2",
              "style": "v",
              "sid": "TIT 2:2"
            },
            "items": [
              {
                "text": "2",
                "type": "text"
              }
            ]
          },
          {
            "text": "Gwa ndị okenye nwoke ka ha nwee anya udo, ka ha nwee akọnuche zuruoke, ka ha bụrụ ndị kwesiri nsọpụrụ, ndị okwukwe ha siri ike, ndị na-ahụ ibe ha nʼanya, na ndị nwekwara ntachiobi.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.2.2",
              "verseOrgIds": [
                "TIT.2.2"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "3",
              "style": "v",
              "sid": "TIT 2:3"
            },
            "items": [
              {
                "text": "3",
                "type": "text"
              }
            ]
          },
          {
            "text": "Nʼotu aka ahụ, gwa ndị okenye nwanyị ka ha na-eme omume dị ka ụmụ nwanyị dị nsọ. Ka ha ghara ịbụ ndị na-agba asịrị maọbụ ohu nke ịṅụbiga mmanya oke. Kama ha na-akụzi ihe dị mma.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.2.3",
              "verseOrgIds": [
                "TIT.2.3"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "4",
              "style": "v",
              "sid": "TIT 2:4"
            },
            "items": [
              {
                "text": "4",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ha ga-esi otu a kuziere ụmụ agbọghọ ka ha ga-esi hụ di ha na ụmụ ha nʼanya.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.2.4",
              "verseOrgIds": [
                "TIT.2.4"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "5",
              "style": "v",
              "sid": "TIT 2:5"
            },
            "items": [
              {
                "text": "5",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ka ha bụrụkwa ndị akọnuche ha zuruoke, ndị dị ọcha nʼobi, ndị na-edozi ezinaụlọ di ha, ndị na-eme ebere, ndị na-edo onwe ha nʼokpuru di ha, ka onye ọbụla ghara ikwulu okwu Chineke.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.2.5",
              "verseOrgIds": [
                "TIT.2.5"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "6",
              "style": "v",
              "sid": "TIT 2:6"
            },
            "items": [
              {
                "text": "6",
                "type": "text"
              }
            ]
          },
          {
            "text": "Nʼotu ụzọ ahụ kwa, gbaakwa ụmụ okorobịa ume ka ha jide onwe ha.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.2.6",
              "verseOrgIds": [
                "TIT.2.6"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "7",
              "style": "v",
              "sid": "TIT 2:7"
            },
            "items": [
              {
                "text": "7",
                "type": "text"
              }
            ]
          },
          {
            "text": "Nʼihe niile ị na-eme, mee onwe gị ihe ịma atụ ndị ọzọ ga na-eṅomi nʼime ezi omume. Na nkuzi gị niile, gosikwa izuoke na ikwesi ntụkwasị obi.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.2.7",
              "verseOrgIds": [
                "TIT.2.7"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "8",
              "style": "v",
              "sid": "TIT 2:8"
            },
            "items": [
              {
                "text": "8",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ka ozi gị bụrụ nke kwụ ọtọ mmadụ apụghị ịma ikpe, ka ihere mee onye na-agbagha gị okwu, ebe ọ bụ na onweghi ihe ọjọọ ọ ga-ekwu gbasara anyị.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.2.8",
              "verseOrgIds": [
                "TIT.2.8"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "9",
              "style": "v",
              "sid": "TIT 2:9"
            },
            "items": [
              {
                "text": "9",
                "type": "text"
              }
            ]
          },
          {
            "text": "Gwa ndị ohu ka ha na-erubere ndị nwe ha isi, ka ha na-eme ihe ga-atọ onyenwe ha ụtọ mgbe niile. Ka ha hapụ ịsa ndị nwe ha okwu,",
            "type": "text",
            "attrs": {
              "verseId": "TIT.2.9",
              "verseOrgIds": [
                "TIT.2.9"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "10",
              "style": "v",
              "sid": "TIT 2:10"
            },
            "items": [
              {
                "text": "10",
                "type": "text"
              }
            ]
          },
          {
            "text": "ka ha ghara izu ohi, kama ka ha gosi na ha bụ ndị kwesiri ntụkwasị obi. Nʼụzọ dị otu a, ha ga-ewetara ihe anyị na-akụzi maka Chineke Onye nzọpụta anyị otuto nʼihe niile ha na-eme.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.2.10",
              "verseOrgIds": [
                "TIT.2.10"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "11",
              "style": "v",
              "sid": "TIT 2:11"
            },
            "items": [
              {
                "text": "11",
                "type": "text"
              }
            ]
          },
          {
            "text": "Nʼihi na Chineke emela ka amara ya nke wetaara mmadụ niile nzọpụta pụta ìhè.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.2.11",
              "verseOrgIds": [
                "TIT.2.11"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "12",
              "style": "v",
              "sid": "TIT 2:12"
            },
            "items": [
              {
                "text": "12",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ọ bụkwa amara a na-akụziri anyị ka anyị jụ ndụ asọpụrụghị Chineke na nke ịgbaso ọchịchọ ọjọọ dị nʼụwa, kama ka anyị bie ndụ dị ka ndịisi zuruoke na ndụ ezi omume, nakwa ịtụ egwu Chineke nʼọgbọ nke oge a.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.2.12",
              "verseOrgIds": [
                "TIT.2.12"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "13",
              "style": "v",
              "sid": "TIT 2:13"
            },
            "items": [
              {
                "text": "13",
                "type": "text"
              }
            ]
          },
          {
            "text": "Otu a ka anyị ga-esi na-eche olileanya anyị dị ngọzị bụ ọbịbịa nke otuto nke Chineke anyị dị ukwuu, na Onye nzọpụta anyị bụ Jisọs Kraịst.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.2.13",
              "verseOrgIds": [
                "TIT.2.13"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "14",
              "style": "v",
              "sid": "TIT 2:14"
            },
            "items": [
              {
                "text": "14",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ọ bụ ya jiri onwe ya chụọ aja nʼihi anyị, ka ọ gbapụta anyị site nʼajọ omume anyị niile, na ido ndị ga-abụ ndị nke ya ọcha nye onwe ya, ndị ọ na-agụ agụụ ime ihe dị mma mgbe niile.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.2.14",
              "verseOrgIds": [
                "TIT.2.14"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "15",
              "style": "v",
              "sid": "TIT 2:15"
            },
            "items": [
              {
                "text": "15",
                "type": "text"
              }
            ]
          },
          {
            "text": "Na-akụzi ihe ndị a, werekwa ha na-adụ ndị gị ọdụ site nʼikike niile i nwere. Werekwa ha na-atụ ha mmehie ha nʼihu. Ka mmadụ ọbụla ghara ilelị gị anya.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.2.15",
              "verseOrgIds": [
                "TIT.2.15"
              ]
            }
          }
        ]
      }
    ],
    "next": {
      "id": "TIT.3",
      "number": "3",
      "bookId": "TIT"
    },
    "previous": {
      "id": "TIT.1",
      "number": "1",
      "bookId": "TIT"
    }
  },
  "TIT.3": {
    "id": "TIT.3",
    "number": "3",
    "bookId": "TIT",
    "reference": "Taịtọs 3",
    "copyright": "Biblica® Open Igbo Contemporary Bible™ Copyright © 1980, 1988, 2019, 2020 by Biblica, Inc. Used with permission. All rights reserved worldwide.",
    "verseCount": 15,
    "content": [
      {
        "name": "chapter",
        "type": "tag",
        "attrs": {
          "number": "3",
          "style": "c",
          "sid": "TIT 3"
        },
        "items": [
          {
            "text": "3",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "s1"
        },
        "items": [
          {
            "text": "Ime ihe dị mma",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "1",
              "style": "v",
              "sid": "TIT 3:1"
            },
            "items": [
              {
                "text": "1",
                "type": "text"
              }
            ]
          },
          {
            "text": "Chetara ndị nke gị ka ha doo onwe ha nʼokpuru ndịisi na ndị ọchịchị, ka ha rubere ha isi, dịkwa njikere ịrụ ọrụ ọma ọbụla.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.3.1",
              "verseOrgIds": [
                "TIT.3.1"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "2",
              "style": "v",
              "sid": "TIT 3:2"
            },
            "items": [
              {
                "text": "2",
                "type": "text"
              }
            ]
          },
          {
            "text": "Gwa ha ka ha ghara ikwulu onye ọbụla, ka ha gharakwa ịlụ ọgụ, kama, ka ha bụrụ enyi mmadụ niile, na-egosikwa ịdị nwayọọ ha nʼebe mmadụ niile nọ.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.3.2",
              "verseOrgIds": [
                "TIT.3.2"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "3",
              "style": "v",
              "sid": "TIT 3:3"
            },
            "items": [
              {
                "text": "3",
                "type": "text"
              }
            ]
          },
          {
            "text": "Nʼihi na mbụ, anyị onwe anyị bụ ndị nzuzu, ndị na-enupu isi, na ndị na-enweghị uche. Anyị bụ ohu agụụ ihe ọjọọ, na ihe ụtọ dị iche iche. Anyị biri ndụ obi ọjọọ na ekworo, na ịkpọrịta onwe anyị asị.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.3.3",
              "verseOrgIds": [
                "TIT.3.3"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "4",
              "style": "v",
              "sid": "TIT 3:4"
            },
            "items": [
              {
                "text": "4",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ma mgbe obiọma na ịhụnanya Chineke Onye nzọpụta anyị pụtara ihe,",
            "type": "text",
            "attrs": {
              "verseId": "TIT.3.4",
              "verseOrgIds": [
                "TIT.3.4"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "5",
              "style": "v",
              "sid": "TIT 3:5"
            },
            "items": [
              {
                "text": "5",
                "type": "text"
              }
            ]
          },
          {
            "text": "ọ zọpụtara anyị, ma ọ bụghị nʼihi ezi ihe ndị anyị mere, kama ọ bụ site nʼebere ya. Ọ zọpụtara anyị site na nsacha nke ịmụ ọzọ na nnwogharị nke Mmụọ Nsọ,",
            "type": "text",
            "attrs": {
              "verseId": "TIT.3.5",
              "verseOrgIds": [
                "TIT.3.5"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "6",
              "style": "v",
              "sid": "TIT 3:6"
            },
            "items": [
              {
                "text": "6",
                "type": "text"
              }
            ]
          },
          {
            "text": "onye ọ wụsara anyị nʼuju site nʼOnye nzọpụta anyị bụ Jisọs Kraịst,",
            "type": "text",
            "attrs": {
              "verseId": "TIT.3.6",
              "verseOrgIds": [
                "TIT.3.6"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "7",
              "style": "v",
              "sid": "TIT 3:7"
            },
            "items": [
              {
                "text": "7",
                "type": "text"
              }
            ]
          },
          {
            "text": "ka ọ bụrụ na ebe e sitere nʼamara gụọ anyị dịka ndị ezi omume, anyị ga-abụ ndị nketa, ndị nwere olileanya ndụ ebighị ebi.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.3.7",
              "verseOrgIds": [
                "TIT.3.7"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "8",
              "style": "v",
              "sid": "TIT 3:8"
            },
            "items": [
              {
                "text": "8",
                "type": "text"
              }
            ]
          },
          {
            "text": "Okwu a kwesiri ntụkwasị obi, ọ ga-amasị m ma i kwusie ihe ndị a ike, ka ndị kweere na Chineke, lezie anya nʼịrụ ezi ọrụ. Ihe ndị a dị mma na-abakwara mmadụ uru.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.3.8",
              "verseOrgIds": [
                "TIT.3.8"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "9",
              "style": "v",
              "sid": "TIT 3:9"
            },
            "items": [
              {
                "text": "9",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ma zere ịrụ ụka nzuzu na ịgụ agbụrụ ọmụmụ, esemokwu niile, na ọgụ niile ndị mmadụ na-alụ banyere iwu. Ihe ndị a niile abaghị uru ọbụla, ha bụ ihe efu.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.3.9",
              "verseOrgIds": [
                "TIT.3.9"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "10",
              "style": "v",
              "sid": "TIT 3:10"
            },
            "items": [
              {
                "text": "10",
                "type": "text"
              }
            ]
          },
          {
            "text": "Gbasara onye na-akpa oke, ị dụchaa ya ọdụ ihe dịka otu ugboro maọbụ abụọ, leghara ya anya.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.3.10",
              "verseOrgIds": [
                "TIT.3.10"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "11",
              "style": "v",
              "sid": "TIT 3:11"
            },
            "items": [
              {
                "text": "11",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ebe ị ma na onye dị otu a bụ onye ndahie na onye ajọọ omume, o jirila aka ya maa onwe ya ikpe.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.3.11",
              "verseOrgIds": [
                "TIT.3.11"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "b"
        },
        "items": []
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "s1"
        },
        "items": [
          {
            "text": "Okwu mmechi",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "12",
              "style": "v",
              "sid": "TIT 3:12"
            },
            "items": [
              {
                "text": "12",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ana m akwado izitere gị Atemas maọbụ Taịkikọs. Gbalịa bịakwute m na Nikopolis, maka nʼebe ahụ ka m kpebiri ịnọ nʼoge oyi.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.3.12",
              "verseOrgIds": [
                "TIT.3.12"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "13",
              "style": "v",
              "sid": "TIT 3:13"
            },
            "items": [
              {
                "text": "13",
                "type": "text"
              }
            ]
          },
          {
            "text": "Gbaa mbọ zipụ Zenas bụ onye ọkaikpe, na Apọlọs, ngwangwa nʼije ha. Hụkwa na ha ji ihe niile dị ha mkpa.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.3.13",
              "verseOrgIds": [
                "TIT.3.13"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "b"
        },
        "items": []
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "14",
              "style": "v",
              "sid": "TIT 3:14"
            },
            "items": [
              {
                "text": "14",
                "type": "text"
              }
            ]
          },
          {
            "text": "Nʼihi na ọ dị mkpa ka ndị anyị mụta inyere ndị niile chọrọ enyemaka ha aka. Ọ bụ nke a ga-eme ka ha bụrụ ndị na-amị mkpụrụ.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.3.14",
              "verseOrgIds": [
                "TIT.3.14"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "b"
        },
        "items": []
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "15",
              "style": "v",
              "sid": "TIT 3:15"
            },
            "items": [
              {
                "text": "15",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ndị niile mụ na ha nọ nʼebe a na-ekele gị.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.3.15",
              "verseOrgIds": [
                "TIT.3.15"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p",
          "vid": "TIT 3:15"
        },
        "items": [
          {
            "text": "Kelekwara anyị ndị niile hụrụ anyị nʼanya nʼime okwukwe.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.3.15",
              "verseOrgIds": [
                "TIT.3.15"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "b",
          "vid": "TIT 3:15"
        },
        "items": []
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p",
          "vid": "TIT 3:15"
        },
        "items": [
          {
            "text": "Ka amara dịnyere unu niile.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.3.15",
              "verseOrgIds": [
                "TIT.3.15"
              ]
            }
          }
        ]
      }
    ],
