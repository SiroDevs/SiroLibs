  "verseCount": 27,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "28",
        "style": "c",
        "sid": "2CH 28"
      },
      "items": [
        {
          "text": "28",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ehaz eze Juda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 28:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ehaz gbara iri afọ abụọ mgbe ọ malitere ịbụ eze. Ọ chịkwara afọ iri na isii nʼime Jerusalem, ma o meghị ihe ziri ezi nʼanya",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.1",
            "verseOrgIds": [
              "2CH.28.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.28.1",
                "verseOrgIds": [
                  "2CH.28.1"
                ]
              }
            }
          ]
        },
        {
          "text": ", dịka nna ya Devid mere.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.1",
            "verseOrgIds": [
              "2CH.28.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 28:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ gbasoro ụzọ niile nke ndị eze Izrel, kpụọkwa arụsị dị iche iche maka ofufe arụsị Baal.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.2",
            "verseOrgIds": [
              "2CH.28.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 28:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "O surere ihe nsure ọkụ na-esi isi ụtọ dị iche iche nʼime Ndagwurugwu nke Ben Hinom, surekwaa ụmụ ya nʼọkụ. Ọ gbasoro omenaala niile rụrụ arụ nke ndị mba ọzọ, ndị ahụ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.3",
            "verseOrgIds": [
              "2CH.28.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.28.3",
                "verseOrgIds": [
                  "2CH.28.3"
                ]
              }
            }
          ]
        },
        {
          "text": "chụpụrụ site nʼihu ndị Izrel.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.3",
            "verseOrgIds": [
              "2CH.28.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 28:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ chụrụ aja surekwaa ihe nsure ọkụ aja na-esi isi ụtọ nʼebe niile dị elu, nʼelu ugwu niile, na nʼokpuru osisi ndụ ọbụla.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.4",
            "verseOrgIds": [
              "2CH.28.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 28:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi ya,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.5",
            "verseOrgIds": [
              "2CH.28.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.28.5",
                "verseOrgIds": [
                  "2CH.28.5"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke ya nyefere ya nʼaka eze ndị Aram. Ndị Aram lụgburu ya, kpọrọ ọtụtụ nʼetiti ndị ya dịka ndị mkpọrọ kpọta ha nʼDamaskọs.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.5",
            "verseOrgIds": [
              "2CH.28.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2CH 28:5"
      },
      "items": [
        {
          "text": "E nyefekwara ya nʼaka eze Izrel, onye gburu ọtụtụ ndị agha ya.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.5",
            "verseOrgIds": [
              "2CH.28.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 28:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼotu ụbọchị, Peka nwa Remalaya gburu narị puku ndị agha Juda na iri puku abụọ. Ihe ndị a mere nʼihi na ha gbakụtara",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.6",
            "verseOrgIds": [
              "2CH.28.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.28.6",
                "verseOrgIds": [
                  "2CH.28.6"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke nna nna ha azụ.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.6",
            "verseOrgIds": [
              "2CH.28.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 28:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zikri onye Ifrem, onye bụ dike nʼagha, gburu Maaseia, nwa eze, na Azrikam onye na-elekọta ụlọeze. O gbukwara Elkena onye na-esota eze.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.7",
            "verseOrgIds": [
              "2CH.28.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 28:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị Izrel sitere nʼetiti ụmụnne ha ndị Juda dọta ndị inyom, na ụmụ okorobịa, na ụmụ agbọghọbịa ọnụọgụgụ ha dị narị puku abụọ nʼagha. Ha bukọkwaara ọtụtụ ihe ndị ọzọ ha kwatara nʼagha laghachi na Sameria.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.8",
            "verseOrgIds": [
              "2CH.28.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 28:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Oded, onye amụma",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.9",
            "verseOrgIds": [
              "2CH.28.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.28.9",
                "verseOrgIds": [
                  "2CH.28.9"
                ]
              }
            }
          ]
        },
        {
          "text": ", nọ na Sameria nʼoge a. Ọ pụrụ jekwuru ndị agha ahụ na Sameria sị ha, \"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.9",
            "verseOrgIds": [
              "2CH.28.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.28.9",
                "verseOrgIds": [
                  "2CH.28.9"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke nna nna unu ha mere ka unu merie ndị Juda nʼihi na ha na-efe arụsị. Ma unu ji ọnụma gbuo ha, nke mere na ụzụ tụrụ ruo nʼeluigwe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.9",
            "verseOrgIds": [
              "2CH.28.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 28:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ugbu a, unu na-achọkwa ime ndị ikom na ndị inyom Juda na Jerusalem ndị ohu unu? Ma unu abụghị ndị ikpe mmehie mara nʼebe",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.10",
            "verseOrgIds": [
              "2CH.28.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.28.10",
                "verseOrgIds": [
                  "2CH.28.10"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke unu nọ?",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.10",
            "verseOrgIds": [
              "2CH.28.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 28:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ugbu a, geenụ ntị nʼihe m na-ekwu. Kpọghachinụ ụmụnna unu ndị a unu dọtara nʼagha nʼụlọ ha, nʼihi na ugbu a",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.11",
            "verseOrgIds": [
              "2CH.28.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.28.11",
                "verseOrgIds": [
                  "2CH.28.11"
                ]
              }
            }
          ]
        },
        {
          "text": "na-ewe oke iwe megide unu.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.11",
            "verseOrgIds": [
              "2CH.28.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 28:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụfọdụ ndịisi ndị Ifrem, bụ Azaraya nwa Jehohanan, na Berekaya nwa Meshilemot, na Jehizkaya nwa Shalum, na Amasa nwa Hadlai, biliri guzogide ndị ahụ si agha na-alọta.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.12",
            "verseOrgIds": [
              "2CH.28.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 28:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha sịrị, \"Unu akpọbatakwala ndị a unu dọtara nʼagha nʼebe a, nʼihi na unu mee ya, anyị ga-abụ ndị ikpe maara nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.13",
            "verseOrgIds": [
              "2CH.28.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.28.13",
                "verseOrgIds": [
                  "2CH.28.13"
                ]
              }
            }
          ]
        },
        {
          "text": ". Unu chọrọ ịtụkwasị ihe na mmehie na ikpe ọmụma anyị? Nʼihi na ikpe ọmụma anyị adịla ukwuu, iwe ya dị ọkụ na-adịkwasịkwa nʼahụ Izrel.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.13",
            "verseOrgIds": [
              "2CH.28.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 28:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, ndị agha ahụ hapụrụ ndị mkpọrọ ahụ na ihe niile ha bulatara, nʼihu ndị ozi na igwe mmadụ ahụ niile.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.14",
            "verseOrgIds": [
              "2CH.28.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 28:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, ndị ikom ahụ akpọrọ nʼaha nʼaha duuru ndị mkpọrọ ahụ, manye aka nʼihe ahụ niile a dọtara nʼagha wepụta uwe, na nri, na mmanya na akpụkpọụkwụ, na mmanụ, nyeghachi ha ndị ahụ niile a dọtara nʼagha. Ha bulitere ndị ọrịa nọ nʼetiti ndị ahụ a dọtara nʼagha kukwasị ha nʼelu ịnyịnya ibu. Emesịa, ha duuru mmadụ ahụ niile dughachiri ha ndị ha nọ na Jeriko, obodo nkwụ. Emesịakwa, ha laghachikwara azụ na Sameria.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.15",
            "verseOrgIds": [
              "2CH.28.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 28:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼoge ahụ, eze Ehaz zigara ndị eze Asịrịa ozi ka ọ bịa nyere ya aka.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.16",
            "verseOrgIds": [
              "2CH.28.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 28:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị Edọm bịara ọzọ buso Juda agha, ma dọrọkwa ọtụtụ nʼime ha nʼagha.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.17",
            "verseOrgIds": [
              "2CH.28.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 28:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị Filistia na-ebusokwa ụfọdụ obodo Juda dị na mgbada ugwu, na Negeb agha. Ha meriri ma bichikwaa obodo ndị a; Bet-Shemesh, na Aijalon, na Gederọt, na Soko, na Timna, na Gimzo, na obodo nta niile gbara ha gburugburu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.18",
            "verseOrgIds": [
              "2CH.28.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 28:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.19",
            "verseOrgIds": [
              "2CH.28.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.28.19",
                "verseOrgIds": [
                  "2CH.28.19"
                ]
              }
            }
          ]
        },
        {
          "text": "wedara Juda nʼala nʼihi Ehaz, eze Izrel onye mere ka ihe ọjọọ baa ụba na Juda, na-ekwesighị ntụkwasị obi ya nye",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.19",
            "verseOrgIds": [
              "2CH.28.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.28.19",
                "verseOrgIds": [
                  "2CH.28.19"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.19",
            "verseOrgIds": [
              "2CH.28.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 28:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Tiglat-Pilesa",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.20",
            "verseOrgIds": [
              "2CH.28.20"
            ]
          }
        },
        {
          "text": "eze ndị Asịrịa bịara, o wetaara Ehaz nsogbu kama enyemaka.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.20",
            "verseOrgIds": [
              "2CH.28.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 28:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ehaz weere ụfọdụ ihe dị nʼụlọnsọ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.21",
            "verseOrgIds": [
              "2CH.28.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.28.21",
                "verseOrgIds": [
                  "2CH.28.21"
                ]
              }
            }
          ]
        },
        {
          "text": ", na nke dị nʼụlọeze, sitekwa na nʼụlọ ndịisi obodo, were ha nye eze Asịrịa, ma ihe ndị a enyereghị ya aka.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.21",
            "verseOrgIds": [
              "2CH.28.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 28:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼoge nsogbu ya, eze Ehaz gakwara nʼihu bụrụ onye na-ekwesighị ntụkwasị obi nye",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.22",
            "verseOrgIds": [
              "2CH.28.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.28.22",
                "verseOrgIds": [
                  "2CH.28.22"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.22",
            "verseOrgIds": [
              "2CH.28.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 28:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ chụrụ aja nye chi niile nke Damaskọs, bụ ndị meriri ya nʼagha. Ọ sịrị, \"Nʼihi na chi nke ndị eze Aram nyeere ha aka, ha ka m ga-achụrụ aja, ka ha nwee ike nyere m aka.\" Ma ha bụ ihe wetaara ya ọdịda, bụrụkwa ọdịda nye Izrel niile.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.23",
            "verseOrgIds": [
              "2CH.28.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 28:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ehaz chịkọtara ngwongwo niile dị nʼụlọnsọ ukwu Chineke, gbujasịa ha. O mechiri ọnụ ụzọ niile e si abanye nʼụlọnsọ ukwu",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.24",
            "verseOrgIds": [
              "2CH.28.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.28.24",
                "verseOrgIds": [
                  "2CH.28.24"
                ]
              }
            }
          ]
        },
        {
          "text": ", ma wuo ọtụtụ ebe ịchụ aja na nkuku ụzọ niile nʼime Jerusalem.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.24",
            "verseOrgIds": [
              "2CH.28.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 28:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼobodo niile ọbụla na Juda, o wuru ebe dị elu maka ịchụ aja dị iche iche nye chi ndị ọzọ, si otu a kpasuo",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.25",
            "verseOrgIds": [
              "2CH.28.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.28.25",
                "verseOrgIds": [
                  "2CH.28.25"
                ]
              }
            }
          ]
        },
        {
          "text": ", bụ Chineke nna nna ya ha iwe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.25",
            "verseOrgIds": [
              "2CH.28.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CH 28:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma banyere ihe ndị ọzọ niile mere nʼoge ọchịchị ya, site na mmalite ruo ọgwụgwụ, ọ bụ na e deghị ha nʼakwụkwọ akụkọ ihe mere nʼoge ndị eze Juda na Izrel?",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.26",
            "verseOrgIds": [
              "2CH.28.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 28:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ehaz soro nna nna ya ha dina nʼọnwụ, e lie ya nʼobodo Jerusalem, ma ọ bụghị nʼime ili ebe a na-eli ndị eze Izrel. Hezekaya nwa ya, ghọrọ eze nʼọnọdụ ya.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.27",
            "verseOrgIds": [
              "2CH.28.27"
            ]
          }
        }
      ]
    }
  ],
