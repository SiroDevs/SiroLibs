  "verseCount": 17,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "2CH 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Solomọn arịọọ amamihe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomọn nwa Devid mere onwe ya ka o guzosie ike nʼalaeze ya, nʼihi na",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.1",
            "verseOrgIds": [
              "2CH.1.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.1.1",
                "verseOrgIds": [
                  "2CH.1.1"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke ya nọnyeere ya, meekwa ka ọ dị ukwuu hie nne.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.1",
            "verseOrgIds": [
              "2CH.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Solomọn gwara ndị Izrel niile okwu, ya bụ, ndịisi agha na-achị ọtụtụ puku ndị agha, na ndịisi agha na-achị ọtụtụ narị ndị agha, na ndị ikpe, na ndị ndu niile nọ nʼIzrel, na ndịisi ezinaụlọ niile.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.2",
            "verseOrgIds": [
              "2CH.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomọn ya na ọgbakọ ahụ niile, gara nʼebe dị elu nke Gibiọn, nʼihi nʼebe ahụ ka ụlọ nzute Chineke dị, bụ nke Mosis onyeozi",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.3",
            "verseOrgIds": [
              "2CH.1.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.1.3",
                "verseOrgIds": [
                  "2CH.1.3"
                ]
              }
            }
          ]
        },
        {
          "text": "wuru nʼọzara.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.3",
            "verseOrgIds": [
              "2CH.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Devid esitelarị na Kiriat Jearim buputa igbe ọgbụgba ndụ Chineke ahụ, bulaa ya nʼụlọ ikwu nke o wuru maka ya na Jerusalem.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.4",
            "verseOrgIds": [
              "2CH.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebe ịchụ aja bronz ahụ Bezalel nwa Uri, nwa Hua wuru dịkwa na Gibiọn, nʼihu ụlọ nzute",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.5",
            "verseOrgIds": [
              "2CH.1.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.1.5",
                "verseOrgIds": [
                  "2CH.1.5"
                ]
              }
            }
          ]
        },
        {
          "text": ". Solomọn na ọgbakọ ahụ na-ajụta ya ase nʼebe bronz ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.5",
            "verseOrgIds": [
              "2CH.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomọn jere nʼebe ịchụ aja ahụ e ji bronz kpụọ, nke dị nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.6",
            "verseOrgIds": [
              "2CH.1.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.1.6",
                "verseOrgIds": [
                  "2CH.1.6"
                ]
              }
            }
          ]
        },
        {
          "text": ", nʼime ụlọ nzute, jiri anụ ụlọ ọnụọgụgụ ha dị otu puku chụọ aja nsure ọkụ nʼelu ya.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.6",
            "verseOrgIds": [
              "2CH.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼabalị ụbọchị ahụ na Gibiọn,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.7",
            "verseOrgIds": [
              "2CH.1.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.1.7",
                "verseOrgIds": [
                  "2CH.1.7"
                ]
              }
            }
          ]
        },
        {
          "text": "mere ka Solomọn hụ ya anya, sị ya, \"Rịọọ ihe ọbụla ị chọrọ ka m nye gị.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.7",
            "verseOrgIds": [
              "2CH.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Solomọn zara Chineke, sị, \"I gosila nna m bụ Devid obi ebere dị ukwuu. Ugbu a, i meekwala m eze nʼọnọdụ ya",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.8",
            "verseOrgIds": [
              "2CH.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ugbu a,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.9",
            "verseOrgIds": [
              "2CH.1.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.1.9",
                "verseOrgIds": [
                  "2CH.1.9"
                ]
              }
            }
          ]
        },
        {
          "text": "bụ Chineke, ka nkwa gị nke i kwere nna m, bụ Devid, bụrụ ihe e mezuru, nʼihi na ị meela m eze ndị a bara ụba nʼọnụọgụgụ dịka aja nke ala.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.9",
            "verseOrgIds": [
              "2CH.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Biko, nye m amamihe na nghọta, nke m ga-eji edu ndị a napụ na-abata, nʼihi na onye pụrụ ịchịkọta ndị gị a dị ukwuu?\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.10",
            "verseOrgIds": [
              "2CH.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chineke zara Solomọn sị ya, \"Ebe ọ bụ na ị rịọghị m ka m nye gị akụnụba, maọbụ ogologo ndụ; ebe ọ bụkwa na ị rịọghị m ka m mee ka ndị kpọrọ gị asị nwụsịa, maọbụ ka m mee ka i nwee nsọpụrụ karịa, kama mkpa na-akpa gị bụ ka m nye gị amamihe na nghọta ị ga-eji duzie ndị m, nke m mere gị eze ha.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.11",
            "verseOrgIds": [
              "2CH.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, enyela gị amamihe na nghọta dịka ị rịọrọ. Aga m enyekwa gị akụnụba na nsọpụrụ dị ukwuu, nke eze ọbụla nke buru gị ụzọ na-enwebeghị. Ọ dịkwaghị onye nke ga-eso gị ga-enwe ụdị ya.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.12",
            "verseOrgIds": [
              "2CH.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Solomọn sitere nʼebe dị elu nke Gibiọn, site nʼihu ụlọ nzute ahụ, lọghachi na Jerusalem. Ọ chịrị dịka eze nʼIzrel.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.13",
            "verseOrgIds": [
              "2CH.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomọn chịkọbara ọtụtụ ụgbọ agha na ịnyịnya dị iche iche. O nwere ụgbọ agha dị otu puku na narị anọ na ịnyịnya agha dị puku iri na abụọ nʼọnụọgụgụ, ndị o debere ụfọdụ nʼime ha nʼobodo ụgbọ agha ya ma ndị ọzọ dị na Jerusalem ebe ya onwe ya nọ.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.14",
            "verseOrgIds": [
              "2CH.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eze mere ka ọlaọcha na ọlaedo baa ụba na Jerusalem, dịka nkume efu. O mekwara ka osisi sida dị ọtụtụ dịka osisi sikamọ nke dị nʼala ala ugwu dị iche iche",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.15",
            "verseOrgIds": [
              "2CH.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "A na-esite nʼIjipt nakwa ala Kue atụbatara Solomọn ịnyịnya. Ndị ahịa eze na-azụta ha site na Kue nʼọnụ ahịa a na-ere ha nʼoge ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.16",
            "verseOrgIds": [
              "2CH.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha sitere nʼIjipt tụbata otu ụgbọ agha nʼọnụ ahịa narị shekel ọlaọcha isii; jirikwa otu narị shekel na iri shekel ise zụta otu ịnyịnya. Ha zipụkwara ha nye ndị eze niile nke ndị Het na ndị Aram.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.17",
            "verseOrgIds": [
              "2CH.1.17"
            ]
          }
        }
      ]
    }
  ],
