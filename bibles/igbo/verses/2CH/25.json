  "verseCount": 28,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "25",
        "style": "c",
        "sid": "2CH 25"
      },
      "items": [
        {
          "text": "25",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Amazaya eze Juda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 25:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amazaya gbara iri afọ abụọ na ise mgbe e mere ya eze, ọ chịrị dịka eze iri afọ abụọ na itoolu na Jerusalem. Nne ya bụ Jehoadin onye Jerusalem.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.1",
            "verseOrgIds": [
              "2CH.25.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "O mere ihe ziri ezi nʼanya",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.2",
            "verseOrgIds": [
              "2CH.25.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.25.2",
                "verseOrgIds": [
                  "2CH.25.2"
                ]
              }
            }
          ]
        },
        {
          "text": ", ma o jighị obi ya niile mee nke a.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.2",
            "verseOrgIds": [
              "2CH.25.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe alaeze guzosiri ike nʼokpuru ọchịchị ya, o gburu ndị ozi ahụ gburu eze, bụ nna ya.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.3",
            "verseOrgIds": [
              "2CH.25.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma o meghị ka ụmụ ha nwụọ, kama ọ gbasoro usoro ihe e dere nʼakwụkwọ iwu Mosis, ebe",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.4",
            "verseOrgIds": [
              "2CH.25.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.25.4",
                "verseOrgIds": [
                  "2CH.25.4"
                ]
              }
            }
          ]
        },
        {
          "text": "nyere iwu sị: \"Ndị mụrụ ụmụ agaghị anwụ nʼihi ihe ụmụ ha metara, maọbụ mee ka ụmụ nwụọ nʼihi ihe ndị mụrụ ha metara, onye ọbụla ga-anwụ nʼihi mmehie nke aka ya.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.4",
            "verseOrgIds": [
              "2CH.25.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amazaya kpọkọtara ndị Juda, guzo ha dịka ezinaụlọ ha si dị, kenye ha nʼokpuru ndị ọchịagha na-achị ọtụtụ puku ndị agha, na ndị na-achị ọtụtụ narị ndị agha, bụ ndị Juda na ndị Benjamin niile. Mgbe ọ gụrụ ndị dị afọ iri abụọ maọbụ karịa ọnụ, ọ chọpụtara na ha dị narị puku ndị ikom atọ ndị tozuru iji ùbe na ọta buo agha.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.5",
            "verseOrgIds": [
              "2CH.25.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "O ji narị talenti ọlaọcha gota narị puku ndị agha site nʼala Izrel.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.6",
            "verseOrgIds": [
              "2CH.25.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma otu onye nke Chineke bịakwutere ya, sị ya; \"Eze, ka ndị agha a si Izrel ghara isonyere gị, nʼihi na",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.7",
            "verseOrgIds": [
              "2CH.25.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.25.7",
                "verseOrgIds": [
                  "2CH.25.7"
                ]
              }
            }
          ]
        },
        {
          "text": "anọnyereghị ndị Izrel, ọ nọnyereghị onye ọbụla sitere nʼIfrem.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.7",
            "verseOrgIds": [
              "2CH.25.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "A sịkwarị na i jiri obi dimkpa ga agha a, Chineke ga-eme ka ndị iro gị merie gị, nʼihi na Chineke bụ onye nwere ike inyere mmadụ aka maọbụ ime ka ọ sụọ ngọngọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.8",
            "verseOrgIds": [
              "2CH.25.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amazaya sịrị onye nke Chineke ahụ, \"Gịnị kwanụ ka anyị ga-eme banyere narị ego talenti m kwụrụ maka ndị agha Izrel?\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.9",
            "verseOrgIds": [
              "2CH.25.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2CH 25:9"
      },
      "items": [
        {
          "text": "Onye nke Chineke ahụ zara, \"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.9",
            "verseOrgIds": [
              "2CH.25.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.25.9",
                "verseOrgIds": [
                  "2CH.25.9"
                ]
              }
            }
          ]
        },
        {
          "text": "pụrụ inye gị karịa nke ahụ.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.9",
            "verseOrgIds": [
              "2CH.25.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amazaya zighachiri ndị agha Izrel ahụ azụ ka ha laa, bụ ndị a si nʼIfrem bịakwute ya. Ha were iwe nke ukwuu megide Juda, jirikwa oke iwe laghachi nʼụlọ ha.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.10",
            "verseOrgIds": [
              "2CH.25.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amazaya duuru ndị agha ya gaa na Ndagwurugwu Nnu, ebe o gburu ndị ikom Sia dị puku iri.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.11",
            "verseOrgIds": [
              "2CH.25.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị agha Juda nwudoro puku ndị ikom iri ọzọ na ndụ, duru ha gaa nʼelu nkume dị elu, si nʼebe ahụ tụda ha niile, nke mere na ha niile kụpịasịrị.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.12",
            "verseOrgIds": [
              "2CH.25.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 25:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ndị agha ahụ Amazaya zilagara, ka ha ghara iso ya gaa agha, wakporo ọtụtụ obodo ndị Juda site na Sameria ruo Bet-Horon. Ha gburu puku mmadụ atọ nʼime ha, bukọrọkwa ọtụtụ ihe nkwata nʼagha, buru ha laa.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.13",
            "verseOrgIds": [
              "2CH.25.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 25:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Amazaya sitere nʼagha ebe o gburu ọtụtụ ndị Edọm lọta, o bulatara chi",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.14",
            "verseOrgIds": [
              "2CH.25.14"
            ]
          }
        },
        {
          "text": "nke ndị Sia. O guzobere ha dịka chi ndị nke aka ya, kpọọ isiala nye ha ma surekwa aja nsure ọkụ na-esi isi ụtọ nye ha.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.14",
            "verseOrgIds": [
              "2CH.25.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 25:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwe",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.15",
            "verseOrgIds": [
              "2CH.25.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.25.15",
                "verseOrgIds": [
                  "2CH.25.15"
                ]
              }
            }
          ]
        },
        {
          "text": "dị ukwuu megide Amazaya. O zigaara ya onye amụma, onye sịrị, \"Nʼihi gịnị ka iji ajụ ase site nʼaka chi nke ndị ahụ, bụ ndị na-enweghị ike ịzọpụta ndị ha site nʼaka gị?\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.15",
            "verseOrgIds": [
              "2CH.25.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 25:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ọ ka kpụ okwu nʼọnụ ya, eze sịrị ya; \"Mechie ọnụ! Ị chọrọ ịnwụ? Ole mgbe ka anyị mere gị onye na-adụ eze ọdụ?\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.16",
            "verseOrgIds": [
              "2CH.25.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2CH 25:16"
      },
      "items": [
        {
          "text": "Ya mere, onye amụma ahụ kwụsịrị, ma sị, \"Amaara m na Chineke ekpebiela ịla gị nʼiyi, nʼihi na i mere nke a ma jụkwa ige ntị na ndụmọdụ m.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.16",
            "verseOrgIds": [
              "2CH.25.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 25:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emesịa, mgbe Amazaya, eze Juda gbachara izu ya na ndị ndụmọdụ ya, o zigara Jehoash nwa Jehoahaz, nwa Jehu, eze Izrel ozi ịma aka, sị, \"Bịa ka dimkpa na ibe ya zute ihu na ihu nʼagha.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.17",
            "verseOrgIds": [
              "2CH.25.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 25:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Jehoash eze Izrel, zighachiri ozi nye Amazaya eze Juda, sị; \"Uke dị na Lebanọn zigaara osisi sida nke dị na Lebanọn ozi sị ya, 'Nye nwa m nwoke nwa gị nwanyị ka ọ bụrụ nwunye ya.' Mgbe ahụ, anụ ọhịa nke dị na Lebanọn gafetere ebe ahụ zọpịa uke ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.18",
            "verseOrgIds": [
              "2CH.25.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 25:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ị na-asị onwe gị, na i meriela Edọm, ugbu a, mpako abatala, isi a na-ebu gị. Ma nọdụ nʼụlọ gị. Nʼihi gịnị ka ị ga-eji kpaliere onwe gị nsogbu, si otu a wetara onwe gị na Juda ọdịda?\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.19",
            "verseOrgIds": [
              "2CH.25.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 25:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Amazaya egeghị ntị, nʼihi na Chineke na-akwado inyefe ya nʼaka Jehoash onye iro ha, nʼihi na ha chọrọ chi ndị Edọm gawa.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.20",
            "verseOrgIds": [
              "2CH.25.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 25:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, Jehoash bụ eze Izrel buliri agha. Ya na Amazaya eze Juda zutere ihu na ihu nʼagha na Bet-Shemesh, dị nʼala Juda.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.21",
            "verseOrgIds": [
              "2CH.25.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 25:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị Izrel meriri ndị Juda, mee ka ha gbalaga, nwoke ọbụla nʼụlọ ya.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.22",
            "verseOrgIds": [
              "2CH.25.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 25:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehoash, bụ eze Izrel nwudere Amazaya eze Juda, nwa Joash, nwa Ahazaya na Bet-Shemesh. Mgbe ahụ, Jehoash duuru ya bịa na Jerusalem, kwada mgbidi Jerusalem, site nʼỌnụ ụzọ ama Ifrem ruo nʼọnụ ụzọ ama Nkuku, nke ogologo ya ruru narị nzọ ụkwụ isii.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.23",
            "verseOrgIds": [
              "2CH.25.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 25:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ chịkọrọ ọlaedo na ọlaọcha niile na ngwongwo niile ahụtara nʼụlọnsọ ukwu Chineke, nke e tinyere nʼaka Obed-Edọm ilekọta, tinyekwara akụ niile dị nʼụlọeze. Ọ dọọrọ ọtụtụ ndị mmadụ nʼagha, kpọrọ laghachi na Sameria.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.24",
            "verseOrgIds": [
              "2CH.25.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 25:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amazaya nwa Joash, eze Juda nọrọ ndụ afọ iri na ise, mgbe Jehoash nwa Jehoahaz, eze Izrel nwụsịrị.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.25",
            "verseOrgIds": [
              "2CH.25.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CH 25:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma banyere ihe ndị ọzọ niile mere nʼoge ọchịchị Amazaya, site na mmalite ruo ọgwụgwụ, ọ bụ na e deghị ha nʼakwụkwọ akụkọ ndị eze Juda na Izrel?",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.26",
            "verseOrgIds": [
              "2CH.25.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 25:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Site nʼoge Amazaya gbakụtara",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.27",
            "verseOrgIds": [
              "2CH.25.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.25.27",
                "verseOrgIds": [
                  "2CH.25.27"
                ]
              }
            }
          ]
        },
        {
          "text": "azụ, ha gbara izuzu imegide ya nʼime Jerusalem. Ọ gbapụrụ gbalaga Lakish, ma ha zipụrụ ndị ikom chụụrụ ya gaa Lakish, gbuo ya nʼebe ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.27",
            "verseOrgIds": [
              "2CH.25.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2CH 25:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha bulatara ozu ya nʼelu ịnyịnya, e lie ya nʼebe e liri nna nna ya ha nʼobodo Juda.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.28",
            "verseOrgIds": [
              "2CH.25.28"
            ]
          }
        }
      ]
    }
