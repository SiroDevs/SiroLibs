{
  "id": "SNG.7",
  "number": "7",
  "bookId": "SNG",
  "reference": "Abụ nke Abụ 7",
  "copyright": "Biblica® Open Igbo Contemporary Bible™ Copyright © 1980, 1988, 2019, 2020 by Biblica, Inc. Used with permission. All rights reserved worldwide.",
  "verseCount": 13,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "7",
        "style": "c",
        "sid": "SNG 7"
      },
      "items": [
        {
          "text": "7",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "SNG 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lee ka ụkwụ gị si dị mma nʼime akpụkpọụkwụ",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.1",
            "verseOrgIds": [
              "SNG.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 7:1"
      },
      "items": [
        {
          "text": "gị ada nwa eze.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.1",
            "verseOrgIds": [
              "SNG.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 7:1"
      },
      "items": [
        {
          "text": "Apata ụkwụ gị abụọ dị ezi mma dịka nkume oke ọnụahịa,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.1",
            "verseOrgIds": [
              "SNG.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 7:1"
      },
      "items": [
        {
          "text": "ọrụ aka nke ezigbo onye ọkwa ǹka.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.1",
            "verseOrgIds": [
              "SNG.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "SNG 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otubo gị mara mma",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.2",
            "verseOrgIds": [
              "SNG.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 7:2"
      },
      "items": [
        {
          "text": "dịka iko nke a gbajuru mmanya.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.2",
            "verseOrgIds": [
              "SNG.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 7:2"
      },
      "items": [
        {
          "text": "Ukwu gị dị ka ukwu ọka",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.2",
            "verseOrgIds": [
              "SNG.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 7:2"
      },
      "items": [
        {
          "text": "e ji okoko urodi gbaa gburugburu.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.2",
            "verseOrgIds": [
              "SNG.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "SNG 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ara gị abụọ dị ka ụmụ mgbada abụọ",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.3",
            "verseOrgIds": [
              "SNG.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 7:3"
      },
      "items": [
        {
          "text": "nke otu nne mụrụ nʼotu oge.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.3",
            "verseOrgIds": [
              "SNG.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "SNG 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olu gị guzo kwem dị ka ụlọ elu e ji ọdụ wuo.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.4",
            "verseOrgIds": [
              "SNG.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 7:4"
      },
      "items": [
        {
          "text": "Anya gị abụọ dị ka ọdọ mmiri Heshbọn",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.4",
            "verseOrgIds": [
              "SNG.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 7:4"
      },
      "items": [
        {
          "text": "nke dị nʼakụkụ ọnụ ụzọ ama Bat-Rabim.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.4",
            "verseOrgIds": [
              "SNG.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 7:4"
      },
      "items": [
        {
          "text": "Imi gị mara mma dị ka ụlọ elu Lebanọn",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.4",
            "verseOrgIds": [
              "SNG.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 7:4"
      },
      "items": [
        {
          "text": "nke chere Damaskọs ihu.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.4",
            "verseOrgIds": [
              "SNG.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "SNG 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isi gị guzo nʼahụ gị ka ugwu Kamel.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.5",
            "verseOrgIds": [
              "SNG.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 7:5"
      },
      "items": [
        {
          "text": "Agịrị isi nke isi gị dịkwa ogho odo odo.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.5",
            "verseOrgIds": [
              "SNG.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 7:5"
      },
      "items": [
        {
          "text": "Ịma mma nke agịrị isi gị emela eze onye a dọtara nʼagha.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.5",
            "verseOrgIds": [
              "SNG.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "SNG 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lee ka i si maa mma nke ukwuu, nʼezie, ị mara mma.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.6",
            "verseOrgIds": [
              "SNG.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 7:6"
      },
      "items": [
        {
          "text": "Ị dịkwa ụtọ nke ukwuu, gị onye m hụrụ nʼanya.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.6",
            "verseOrgIds": [
              "SNG.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "SNG 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ị dị ogologo dịka osisi nkwụ;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.7",
            "verseOrgIds": [
              "SNG.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 7:7"
      },
      "items": [
        {
          "text": "ara gị abụọ dịkwa ka ụyọkọ mkpụrụ osisi.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.7",
            "verseOrgIds": [
              "SNG.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "SNG 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekwuru m sị, \"Aga m arịgoro elu osisi nkwụ ahụ,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.8",
            "verseOrgIds": [
              "SNG.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 7:8"
      },
      "items": [
        {
          "text": "jidekwa mkpụrụ ya aka.\"",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.8",
            "verseOrgIds": [
              "SNG.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 7:8"
      },
      "items": [
        {
          "text": "Ugbu a, ka ara gị abụọ dịkwa ka ụyọkọ mkpụrụ vaịnị,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.8",
            "verseOrgIds": [
              "SNG.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 7:8"
      },
      "items": [
        {
          "text": "ka isisi nke iku ume gị dịkwa ka mkpụrụ osisi apụl,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.8",
            "verseOrgIds": [
              "SNG.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "SNG 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka okpo ọnụ gị dịka mmanya makarịsịrị na mma.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.9",
            "verseOrgIds": [
              "SNG.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp",
        "vid": "SNG 7:9"
      },
      "items": [
        {
          "text": "Onye a hụrụ nʼanya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 7:9"
      },
      "items": [
        {
          "text": "Ka mmanya ahụ gbadaa nwayọọ nye onye m hụrụ nʼanya,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.9",
            "verseOrgIds": [
              "SNG.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 7:9"
      },
      "items": [
        {
          "text": "na-asọda nwayọọ nʼelu egbugbere ọnụ ya na eze ya.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.9",
            "verseOrgIds": [
              "SNG.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "SNG 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abụ m nke onye ahụ m hụrụ nʼanya,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.10",
            "verseOrgIds": [
              "SNG.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 7:10"
      },
      "items": [
        {
          "text": "ọ bụkwa m ka ọ chọrọ.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.10",
            "verseOrgIds": [
              "SNG.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "SNG 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bịa, onye m hụrụ nʼanya, ka anyị gaa nʼime obodo,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.11",
            "verseOrgIds": [
              "SNG.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 7:11"
      },
      "items": [
        {
          "text": "ka anyị nọọ ọnọdụ abalị nʼobodo nta.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.11",
            "verseOrgIds": [
              "SNG.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "SNG 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka anyị bilie ngwangwa nʼisi ụtụtụ pụọ jee nʼubi",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.12",
            "verseOrgIds": [
              "SNG.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 7:12"
      },
      "items": [
        {
          "text": "lee ma osisi vaịnị ha amaala ifuru,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.12",
            "verseOrgIds": [
              "SNG.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 7:12"
      },
      "items": [
        {
          "text": "ma okoko ya agbawaala,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.12",
            "verseOrgIds": [
              "SNG.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 7:12"
      },
      "items": [
        {
          "text": "ma osisi pomegranet agbawaala okoko.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.12",
            "verseOrgIds": [
              "SNG.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 7:12"
      },
      "items": [
        {
          "text": "Nʼebe ahụ ka m ga-egosi gị ịhụnanya m.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.12",
            "verseOrgIds": [
              "SNG.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "SNG 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼebe ahụ ka ị ga-anọ nụ isi nke mandreki",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.13",
            "verseOrgIds": [
              "SNG.7.14"
            ]
          }
        },
