  "verseCount": 11,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "3",
        "style": "c",
        "sid": "SNG 3"
      },
      "items": [
        {
          "text": "3",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "SNG 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Achọrọ m onye m hụrụ nʼanya",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.1",
            "verseOrgIds": [
              "SNG.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 3:1"
      },
      "items": [
        {
          "text": "nʼelu ihe ndina m nʼabalị, ma ahụghị m ya.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.1",
            "verseOrgIds": [
              "SNG.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 3:1"
      },
      "items": [
        {
          "text": "Ebiliri m chọọ ya ma ahụghị m ya.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.1",
            "verseOrgIds": [
              "SNG.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "SNG 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ugbu a, aga m ebili pụọ jegharịa nʼama niile",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.2",
            "verseOrgIds": [
              "SNG.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 3:2"
      },
      "items": [
        {
          "text": "na nʼokporoụzọ niile nke obodo ịchọ ya,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.2",
            "verseOrgIds": [
              "SNG.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 3:2"
      },
      "items": [
        {
          "text": "m ga-achọgharị onye m hụrụ nʼanya.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.2",
            "verseOrgIds": [
              "SNG.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 3:2"
      },
      "items": [
        {
          "text": "Ya mere, achọrọ m ya ma ahụghị m ya.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.2",
            "verseOrgIds": [
              "SNG.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "SNG 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị nche na-eche obodo",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.3",
            "verseOrgIds": [
              "SNG.3.3"
            ]
          }
        },
        {
          "text": "hụrụ m,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.3",
            "verseOrgIds": [
              "SNG.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 3:3"
      },
      "items": [
        {
          "text": "mgbe ha na-agagharị nʼobodo,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.3",
            "verseOrgIds": [
              "SNG.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 3:3"
      },
      "items": [
        {
          "text": "ma ajụrụ m ha sị, \"Biko, unu hụrụ onye ahụ m hụrụ nʼanya?\"",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.3",
            "verseOrgIds": [
              "SNG.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "SNG 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ dịghị anya mgbe m gafere ha,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.4",
            "verseOrgIds": [
              "SNG.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 3:4"
      },
      "items": [
        {
          "text": "achọtara m onye m hụrụ nʼanya,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.4",
            "verseOrgIds": [
              "SNG.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 3:4"
      },
      "items": [
        {
          "text": "ejidesiri m ya ike, ahapụghị m ya aka",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.4",
            "verseOrgIds": [
              "SNG.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 3:4"
      },
      "items": [
        {
          "text": "tutu m duta ya nʼụlọ nne m,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.4",
            "verseOrgIds": [
              "SNG.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 3:4"
      },
      "items": [
        {
          "text": "nʼime ụlọ nwanyị tụrụ ime m.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.4",
            "verseOrgIds": [
              "SNG.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "SNG 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unu ụmụ agbọghọ Jerusalem,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.5",
            "verseOrgIds": [
              "SNG.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 3:5"
      },
      "items": [
        {
          "text": "eji m nne mgbada niile na nne ele ọhịa gbaa unu iyi sị,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.5",
            "verseOrgIds": [
              "SNG.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 3:5"
      },
      "items": [
        {
          "text": "unu akpọtela, maọbụ mee ka ịhụnanya teta",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.5",
            "verseOrgIds": [
              "SNG.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 3:5"
      },
      "items": [
        {
          "text": "ruo mgbe o masịrị ya.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.5",
            "verseOrgIds": [
              "SNG.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "SNG 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye bụ nke a na-esi nʼọzara na-abịa",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.6",
            "verseOrgIds": [
              "SNG.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 3:6"
      },
      "items": [
        {
          "text": "dịka anwụrụ ọkụ,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.6",
            "verseOrgIds": [
              "SNG.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 3:6"
      },
      "items": [
        {
          "text": "nke tere mmanụ máá na ụda na-esi isi ụtọ,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.6",
            "verseOrgIds": [
              "SNG.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 3:6"
      },
      "items": [
        {
          "text": "ụda nke ndị ahịa na-ere?",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.6",
            "verseOrgIds": [
              "SNG.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "SNG 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lee ọ bụ ụgbọ Solomọn.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.7",
            "verseOrgIds": [
              "SNG.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 3:7"
      },
      "items": [
        {
          "text": "Iri mmadụ isii ndị ọka agha,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.7",
            "verseOrgIds": [
              "SNG.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 3:7"
      },
      "items": [
        {
          "text": "ndị a maara aha ha karịsịa nʼala Izrel sokwa ya.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.7",
            "verseOrgIds": [
              "SNG.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "SNG 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha niile ji mma agha;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.8",
            "verseOrgIds": [
              "SNG.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 3:8"
      },
      "items": [
        {
          "text": "ha bụ ndị a zụrụ nke ọma ibu agha.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.8",
            "verseOrgIds": [
              "SNG.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 3:8"
      },
      "items": [
        {
          "text": "Mma agha onye ọbụla dịkwa nʼukwu ya,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.8",
            "verseOrgIds": [
              "SNG.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 3:8"
      },
      "items": [
        {
          "text": "ịdị njikere maka ihe egwu abalị.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.8",
            "verseOrgIds": [
              "SNG.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "SNG 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eze Solomọn rụrụ onwe ya ụgbọ a",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.9",
            "verseOrgIds": [
              "SNG.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 3:9"
      },
      "items": [
        {
          "text": "nke o ji osisi sitere Lebanọn rụọ.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.9",
            "verseOrgIds": [
              "SNG.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "SNG 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogidi ya ka o ji ọlaọcha mee;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.10",
            "verseOrgIds": [
              "SNG.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 3:10"
      },
      "items": [
        {
          "text": "ala ya bụkwa ọlaedo.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.10",
            "verseOrgIds": [
              "SNG.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 3:10"
      },
      "items": [
        {
          "text": "Ebe ịnọdụ ọdụ ya ka e ji akwa odo odo kpaa,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.10",
            "verseOrgIds": [
              "SNG.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 3:10"
      },
      "items": [
        {
          "text": "e ji ịhụnanya dozie ebe ime ya.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.10",
            "verseOrgIds": [
              "SNG.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 3:10"
      },
      "items": [
        {
          "text": "Ndị inyom Jerusalem,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.10",
            "verseOrgIds": [
              "SNG.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "SNG 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "pụtanụ,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.11",
            "verseOrgIds": [
              "SNG.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 3:11"
      },
      "items": [
        {
          "text": "bịa hụrụ, unu ụmụ agbọghọ Zayọn,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.11",
            "verseOrgIds": [
              "SNG.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 3:11"
      },
      "items": [
        {
          "text": "bịanụ ka unu hụ Solomọn bụ eze;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.11",
            "verseOrgIds": [
              "SNG.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 3:11"
      },
      "items": [
        {
          "text": "lee ụdị okpueze nne ya kpunyere ya nʼisi,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.11",
            "verseOrgIds": [
              "SNG.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
