        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okwu Bildad",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 25:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Bildad onye Shua zara sị:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.25.1",
            "verseOrgIds": [
              "JOB.25.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ike ọchịchị na oke egwu bụ nke Chineke;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.25.2",
            "verseOrgIds": [
              "JOB.25.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 25:2"
      },
      "items": [
        {
          "text": "Ọ bụ ya na-eme ka udo dịrị nʼeluigwe.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.25.2",
            "verseOrgIds": [
              "JOB.25.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye pụrụ ịgụta usuu ndị agha ya ọnụ?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.25.3",
            "verseOrgIds": [
              "JOB.25.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 25:3"
      },
      "items": [
        {
          "text": "Onye kwa ka ìhè ya na-adịghị enwukwasị?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.25.3",
            "verseOrgIds": [
              "JOB.25.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mmadụ ọ ga-esi aṅaa bụrụ onye ezi omume nʼihu Chineke?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.25.4",
            "verseOrgIds": [
              "JOB.25.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 25:4"
      },
      "items": [
        {
          "text": "Mmadụ nwanyị mụrụ ọ ga-esi aṅaa dị ọcha?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.25.4",
            "verseOrgIds": [
              "JOB.25.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lee, ọ bụladị ọnwa adịghị achawapụta,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.25.5",
            "verseOrgIds": [
              "JOB.25.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 25:5"
      },
      "items": [
        {
          "text": "ọzọ kpakpando adịghị ọcha nʼanya ya,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.25.5",
            "verseOrgIds": [
              "JOB.25.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka ọfọdụzie nwa mmadụ efu mụrụ, nke bụ naanị ikpuru,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.25.6",
            "verseOrgIds": [
              "JOB.25.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 25:6"
      },
      "items": [
        {
          "text": "mmadụ, nke bụ naanị idide.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOB.25.6",
            "verseOrgIds": [
              "JOB.25.6"
            ]
          }
        }
      ]
    }
  ],
