  "verseCount": 31,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "30",
        "style": "c",
        "sid": "JOB 30"
      },
      "items": [
        {
          "text": "30",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 30:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ma ugbu a, ha na-akwa m emo",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.1",
            "verseOrgIds": [
              "JOB.30.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:1"
      },
      "items": [
        {
          "text": "bụ ndị bụ ụmụntakịrị nʼebe m nọ,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.1",
            "verseOrgIds": [
              "JOB.30.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOB 30:1"
      },
      "items": [
        {
          "text": "bụ ndị nna ha na-etorughị ndị m na-ezipụ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.1",
            "verseOrgIds": [
              "JOB.30.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:1"
      },
      "items": [
        {
          "text": "ka ha na nkịta na-eso atụrụ m nọkọta.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.1",
            "verseOrgIds": [
              "JOB.30.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 30:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uru gịnị ka ike aka ha ga-abara m,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.2",
            "verseOrgIds": [
              "JOB.30.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:2"
      },
      "items": [
        {
          "text": "ebe ọ bụ na ha adịghịkwa ike?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.2",
            "verseOrgIds": [
              "JOB.30.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 30:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha bụ ndị ike gwụrụ site nʼụkọ na agụụ,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.3",
            "verseOrgIds": [
              "JOB.30.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:3"
      },
      "items": [
        {
          "text": "ha na-agagharị nʼala kpọrọ nkụ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.3",
            "verseOrgIds": [
              "JOB.30.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:3"
      },
      "items": [
        {
          "text": "na-awagharịkwa nʼime ọzara nʼabalị.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.3",
            "verseOrgIds": [
              "JOB.30.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 30:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼala ọhịa ka ha na-atụrị ahịhịa nnu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.4",
            "verseOrgIds": [
              "JOB.30.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:4"
      },
      "items": [
        {
          "text": "mgbọrọgwụ osisi brum bụkwa nri ha.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.4",
            "verseOrgIds": [
              "JOB.30.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 30:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "A chụpụrụ ha site nʼetiti ndị mmadụ ibe ha,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.5",
            "verseOrgIds": [
              "JOB.30.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:5"
      },
      "items": [
        {
          "text": "a na-etiso ha mkpu dịka ha bụ ndị ohi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.5",
            "verseOrgIds": [
              "JOB.30.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 30:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "A chụpụrụ ha ka ha gaa biri nʼala iyi mmiri na-adịghị.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.6",
            "verseOrgIds": [
              "JOB.30.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:6"
      },
      "items": [
        {
          "text": "Ha bi nʼetiti ọgba nkume na ọnụ a tụrụ nʼime ala.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.6",
            "verseOrgIds": [
              "JOB.30.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 30:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha na-eme ụzụ nʼọhịa dịka ụmụ anụmanụ,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.7",
            "verseOrgIds": [
              "JOB.30.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:7"
      },
      "items": [
        {
          "text": "na-ejikọta onwe ha nʼahịhịa toro nʼokpuru osisi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.7",
            "verseOrgIds": [
              "JOB.30.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 30:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha bụ ndị e ledara anya, ndị na-enweghị aha,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.8",
            "verseOrgIds": [
              "JOB.30.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:8"
      },
      "items": [
        {
          "text": "e sitere nʼala ahụ chụpụ ha.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.8",
            "verseOrgIds": [
              "JOB.30.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 30:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ma ugbu a, abụrụla m ihe ụmụ okorobịa ji abụ abụ ịkwa emo;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.9",
            "verseOrgIds": [
              "JOB.30.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:9"
      },
      "items": [
        {
          "text": "abụrụkwala m okwu ha ji anọpụrụ ụbọchị.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.9",
            "verseOrgIds": [
              "JOB.30.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 30:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abụ m ihe ịsọ oyi nye ha, ha adịghị abịakwa m nso;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.10",
            "verseOrgIds": [
              "JOB.30.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:10"
      },
      "items": [
        {
          "text": "ha anaghị egbu oge igbu m asọ mmiri nʼihu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.10",
            "verseOrgIds": [
              "JOB.30.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 30:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ugbu a, ebe ọ bụ na Chineke atọpụla eriri ụta m ma kpagbuo m,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.11",
            "verseOrgIds": [
              "JOB.30.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:11"
      },
      "items": [
        {
          "text": "o nwekwaghị ihe ha na-adịghị eme nʼihu m.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.11",
            "verseOrgIds": [
              "JOB.30.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 30:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼaka nri m mba ndị a na-ebuso m agha.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.12",
            "verseOrgIds": [
              "JOB.30.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:12"
      },
      "items": [
        {
          "text": "Ha na-esiri ụkwụ m ọnya,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.12",
            "verseOrgIds": [
              "JOB.30.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:12"
      },
      "items": [
        {
          "text": "ha na-ewuli mgbidi ha nọchibido m.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.12",
            "verseOrgIds": [
              "JOB.30.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 30:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha na-etiwasị ụzọ m,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.13",
            "verseOrgIds": [
              "JOB.30.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:13"
      },
      "items": [
        {
          "text": "ha kwadoro mmekpa ahụ m.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.13",
            "verseOrgIds": [
              "JOB.30.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:13"
      },
      "items": [
        {
          "text": "'O nweghị onye ga-enyere ya aka,' ka ha na-ekwu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.13",
            "verseOrgIds": [
              "JOB.30.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 30:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha na-abịakwasị m dịka ndị sitere ebe e tipuru mgbidi;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.14",
            "verseOrgIds": [
              "JOB.30.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:14"
      },
      "items": [
        {
          "text": "nʼetiti mbibi ya ha na-enu onwe ha enute nʼebe m nọ.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.14",
            "verseOrgIds": [
              "JOB.30.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 30:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oke egwu abịakwasịla m;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.15",
            "verseOrgIds": [
              "JOB.30.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:15"
      },
      "items": [
        {
          "text": "ugwu m adịla ka ihe ifufe buuru,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.15",
            "verseOrgIds": [
              "JOB.30.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:15"
      },
      "items": [
        {
          "text": "nchekwa m agabigala dịka igwe ojii.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.15",
            "verseOrgIds": [
              "JOB.30.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 30:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ugbu a, ndụ m ji nwayọọ nwayọọ na-agabiga;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.16",
            "verseOrgIds": [
              "JOB.30.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:16"
      },
      "items": [
        {
          "text": "ụbọchị ahụhụ ejidela m.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.16",
            "verseOrgIds": [
              "JOB.30.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 30:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abalị na-esewasị ọkpụkpụ m,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.17",
            "verseOrgIds": [
              "JOB.30.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:17"
      },
      "items": [
        {
          "text": "ihe mgbu m nke na-ata ata enweghị ezumike.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.17",
            "verseOrgIds": [
              "JOB.30.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 30:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼoke ike ya, Chineke na-adịrị m ka uwe;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.18",
            "verseOrgIds": [
              "JOB.30.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:18"
      },
      "items": [
        {
          "text": "ọ na-ekechi m dịka olu uwe m.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.18",
            "verseOrgIds": [
              "JOB.30.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOB 30:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ na-atụba m nʼime apịtị,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.19",
            "verseOrgIds": [
              "JOB.30.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:19"
      },
      "items": [
        {
          "text": "mee ka m ghọọ ntụ na aja.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.19",
            "verseOrgIds": [
              "JOB.30.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOB 30:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Chineke m, anam etiku gị ma ị dịghị aza m;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.20",
            "verseOrgIds": [
              "JOB.30.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:20"
      },
      "items": [
        {
          "text": "anam eguzo ọtọ, ma naanị anya ka i lere m.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.20",
            "verseOrgIds": [
              "JOB.30.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOB 30:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ị na-emegide m na-enweghị obi ebere;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.21",
            "verseOrgIds": [
              "JOB.30.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:21"
      },
      "items": [
        {
          "text": "i ji aka gị dị ike megide m.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.21",
            "verseOrgIds": [
              "JOB.30.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOB 30:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ị na-ejide m nʼike welie m elu chụba m nʼoke ifufe,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.22",
            "verseOrgIds": [
              "JOB.30.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:22"
      },
      "items": [
        {
          "text": "ị na-eme ka m bụrụ onye na-akwụfegharị nʼoke ifufe nke mmiri.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.22",
            "verseOrgIds": [
              "JOB.30.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOB 30:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amara m na ị ga-eweda m ruo ọnwụ;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.23",
            "verseOrgIds": [
              "JOB.30.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:23"
      },
      "items": [
        {
          "text": "ruo nʼebe e debeere mmadụ niile dị ndụ.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.23",
            "verseOrgIds": [
              "JOB.30.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOB 30:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nʼezie, ọ dịghị onye na-emegide onye e tidara nʼala;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.24",
            "verseOrgIds": [
              "JOB.30.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:24"
      },
      "items": [
        {
          "text": "mgbe ọ na-eti mkpu nʼọnọdụ nhụju anya ya na-achọ enyemaka.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.24",
            "verseOrgIds": [
              "JOB.30.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOB 30:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ na m akwaghị akwa nʼihi ndị nọ na nsogbu;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.25",
            "verseOrgIds": [
              "JOB.30.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:25"
      },
      "items": [
        {
          "text": "ọ bụ na mmụọ m erughị ụjụ nʼihi ndị ogbenye?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.25",
            "verseOrgIds": [
              "JOB.30.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOB 30:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma mgbe m lere anya ihe ọma, ihe ọjọọ bịara;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.26",
            "verseOrgIds": [
              "JOB.30.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:26"
      },
      "items": [
        {
          "text": "mgbe m lere anya ìhè, mgbe ahụ ka ọchịchịrị bịara.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.26",
            "verseOrgIds": [
              "JOB.30.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JOB 30:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obi m anaghị ezu ike nʼime m;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.27",
            "verseOrgIds": [
              "JOB.30.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:27"
      },
      "items": [
        {
          "text": "ụbọchị ahụhụ na-ezute m.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.27",
            "verseOrgIds": [
              "JOB.30.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JOB 30:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ana m agagharị na-eji nji ma ọ bụghị nʼihi oke anwụ.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.28",
            "verseOrgIds": [
              "JOB.30.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:28"
      },
      "items": [
        {
          "text": "Eguzola m ọtọ nʼọgbakọ ndị mmadụ tikuo ha ka ha nyere m aka.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.28",
            "verseOrgIds": [
              "JOB.30.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JOB 30:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abụrụla m nwanne nkịta ọhịa;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.29",
            "verseOrgIds": [
              "JOB.30.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:29"
      },
      "items": [
        {
          "text": "onye ya na ikwighịkwighị na-esogharị.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.29",
            "verseOrgIds": [
              "JOB.30.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JOB 30:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akpụkpọ ahụ m na-eji nji na-ekpe iwere;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.30",
            "verseOrgIds": [
              "JOB.30.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:30"
      },
      "items": [
        {
          "text": "anụ ahụ m na-anụ ọkụ dịka ihe a kwanyere ọkụ.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.30",
            "verseOrgIds": [
              "JOB.30.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JOB 30:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụda ụbọ akwara m bụ ụda iru ụjụ;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.31",
            "verseOrgIds": [
              "JOB.30.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:31"
      },
      "items": [
        {
          "text": "ụda ọja m bụkwa ụda iti mkpu akwa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.31",
            "verseOrgIds": [
              "JOB.30.31"
            ]
          }
        }
      ]
    }
