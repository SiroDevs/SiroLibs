  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "29",
        "style": "c",
        "sid": "JOB 29"
      },
      "items": [
        {
          "text": "29",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ngọpụ ikpeazụ Job",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 29:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Job gakwara nʼihu nʼokwu ya sị:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.1",
            "verseOrgIds": [
              "JOB.29.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 29:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ọ gaara adị m nọọ mma ma a sị na m ga-adị dịka m dị nʼọnwa ole na ole gara aga,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.2",
            "verseOrgIds": [
              "JOB.29.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 29:2"
      },
      "items": [
        {
          "text": "dịka ụbọchị ndị ahụ mgbe Chineke na-elekọta m,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.2",
            "verseOrgIds": [
              "JOB.29.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 29:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "mgbe oriọna ya na-achakwasị m nʼisi",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.3",
            "verseOrgIds": [
              "JOB.29.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 29:3"
      },
      "items": [
        {
          "text": "ìhè ya ka m ji jee ije nʼọchịchịrị.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.3",
            "verseOrgIds": [
              "JOB.29.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 29:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ewoo, otu ihe dịịrị nʼụbọchị ihe na-agara m nke ọma,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.4",
            "verseOrgIds": [
              "JOB.29.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 29:4"
      },
      "items": [
        {
          "text": "mgbe mmekọrịta mụ na Chineke mere ka ụlọ m bụrụ ebe a gọziri agọzi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.4",
            "verseOrgIds": [
              "JOB.29.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 29:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "mgbe Onye pụrụ ime ihe niile nọnyeere m",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.5",
            "verseOrgIds": [
              "JOB.29.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 29:5"
      },
      "items": [
        {
          "text": "na mgbe ụmụ m nọkwa m gburugburu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.5",
            "verseOrgIds": [
              "JOB.29.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 29:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "mgbe ụzọ m jupụtara na mmiri ara ehi rahụrụ arahụ,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.6",
            "verseOrgIds": [
              "JOB.29.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 29:6"
      },
      "items": [
        {
          "text": "mgbe nkume na-awụpụtara m mmanụ oliv dịka mmiri na-asọ asọ.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.6",
            "verseOrgIds": [
              "JOB.29.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 29:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mgbe m na-apụ nʼọnụ ụzọ ama obodo",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.7",
            "verseOrgIds": [
              "JOB.29.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 29:7"
      },
      "items": [
        {
          "text": "were ọnọdụ m nʼama.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.7",
            "verseOrgIds": [
              "JOB.29.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 29:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụmụ okorobịa na-ahụ m wezuga onwe ha,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.8",
            "verseOrgIds": [
              "JOB.29.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 29:8"
      },
      "items": [
        {
          "text": "ndị okenye na-ahụkwa m ma guzo nʼụkwụ ha;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.8",
            "verseOrgIds": [
              "JOB.29.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 29:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndịisi ọchịchị obodo na-akwụsị ikwu okwu",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.9",
            "verseOrgIds": [
              "JOB.29.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 29:9"
      },
      "items": [
        {
          "text": "ma were aka ha kpuchie ọnụ ha;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.9",
            "verseOrgIds": [
              "JOB.29.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 29:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "olu ndị a na-asọpụrụ na-adakwa jụụ,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.10",
            "verseOrgIds": [
              "JOB.29.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 29:10"
      },
      "items": [
        {
          "text": "ire ha na-araparakwa ha nʼakpo ọnụ.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.10",
            "verseOrgIds": [
              "JOB.29.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 29:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼoge ahụ, onye ọbụla nụrụ olu m na-ekwu ihe dị mma banyere m,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.11",
            "verseOrgIds": [
              "JOB.29.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 29:11"
      },
      "items": [
        {
          "text": "ndị hụkwara m na-agba ama ọma maka m.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.11",
            "verseOrgIds": [
              "JOB.29.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 29:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na anapụtara m ndị ogbenye na-eti mkpu enyemaka,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.12",
            "verseOrgIds": [
              "JOB.29.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 29:12"
      },
      "items": [
        {
          "text": "napụtakwa ndị mgbei na-enweghị ndị enyemaka.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.12",
            "verseOrgIds": [
              "JOB.29.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 29:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye nọ nʼọnụ ọnwụ gọziri m;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.13",
            "verseOrgIds": [
              "JOB.29.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 29:13"
      },
      "items": [
        {
          "text": "emekwara m ka obi nwanyị di ya nwụrụ bụọ abụ.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.13",
            "verseOrgIds": [
              "JOB.29.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 29:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ana m eyikwasị ezi omume dịka uwe,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.14",
            "verseOrgIds": [
              "JOB.29.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 29:14"
      },
      "items": [
        {
          "text": "ikpe ziri ezi bụ uwe mwụda m na akwa okike nke isi m.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.14",
            "verseOrgIds": [
              "JOB.29.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 29:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abụ m anya nye onye ìsì,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.15",
            "verseOrgIds": [
              "JOB.29.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 29:15"
      },
      "items": [
        {
          "text": "bụrụkwa ụkwụ nye onye ngwụrọ.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.15",
            "verseOrgIds": [
              "JOB.29.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 29:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abụ m nna nke onye nọ na mkpa;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.16",
            "verseOrgIds": [
              "JOB.29.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 29:16"
      },
      "items": [
        {
          "text": "bụrụkwa onye gbalịrị ịhụ na ndị ọbịa natara ikpe ziri ezi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.16",
            "verseOrgIds": [
              "JOB.29.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 29:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Etijiri m ikiri eze nke ndị ajọ omume,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.17",
            "verseOrgIds": [
              "JOB.29.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 29:17"
      },
      "items": [
        {
          "text": "si otu a napụta ndị ha na-achọ ịdọgbu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.17",
            "verseOrgIds": [
              "JOB.29.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 29:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Echere m sị, 'Aga m anwụ nʼụlọ nke aka m,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.18",
            "verseOrgIds": [
              "JOB.29.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 29:18"
      },
      "items": [
        {
          "text": "na ụbọchị m ga-abakwa ụba dịka aja dị nʼala.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.18",
            "verseOrgIds": [
              "JOB.29.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOB 29:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbọrọgwụ m ga-eto rịda na mmiri,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.19",
            "verseOrgIds": [
              "JOB.29.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 29:19"
      },
      "items": [
        {
          "text": "na igirigi ga-adakwasịkwa nʼalaka m abalị niile.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.19",
            "verseOrgIds": [
              "JOB.29.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOB 29:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nsọpụrụ m ga-adịgide ọhụrụ nʼime m,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.20",
            "verseOrgIds": [
              "JOB.29.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 29:20"
      },
      "items": [
        {
          "text": "ụta m ga-adịgidekwa ọhụrụ nʼaka m.'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.20",
            "verseOrgIds": [
              "JOB.29.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOB 29:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ụmụ mmadụ na-eji oke olileanya na-ege m ntị,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.21",
            "verseOrgIds": [
              "JOB.29.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 29:21"
      },
      "items": [
        {
          "text": "ha na-ederekwa duu ịnụrụ ndụmọdụ m.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.21",
            "verseOrgIds": [
              "JOB.29.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOB 29:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe m kwụsịrị okwu, ha anaghị ekwukwa ọzọ.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.22",
            "verseOrgIds": [
              "JOB.29.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 29:22"
      },
      "items": [
        {
          "text": "Okwu m na-ada juu na ntị ha.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.22",
            "verseOrgIds": [
              "JOB.29.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOB 29:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha na-echerekwa m dịka e si echere mmiri ozuzo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.23",
            "verseOrgIds": [
              "JOB.29.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 29:23"
      },
      "items": [
        {
          "text": "na-aṅụkwa okwu m dịka ala si aṅụ mmiri ozuzo nʼọkọchị.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.23",
            "verseOrgIds": [
              "JOB.29.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOB 29:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe m miiri ha ọnụ ọchị, ha adịghị ekwenye ya;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.24",
            "verseOrgIds": [
              "JOB.29.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 29:24"
      },
      "items": [
        {
          "text": "ìhè nke ihu m dị oke mkpa nye ha.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.24",
            "verseOrgIds": [
              "JOB.29.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOB 29:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ m na-ahọpụtara ha ụzọ, na-anọdụ dịka onyeisi ha;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.25",
            "verseOrgIds": [
              "JOB.29.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 29:25"
      },
      "items": [
        {
          "text": "ebiri m dịka a ga-asị na m bụ onye eze nʼetiti ndị agha ya;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.25",
            "verseOrgIds": [
              "JOB.29.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 29:25"
      },
      "items": [
        {
          "text": "na dịka onye na-akasị ndị na-eru ụjụ obi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.25",
            "verseOrgIds": [
              "JOB.29.25"
            ]
          }
        }
      ]
