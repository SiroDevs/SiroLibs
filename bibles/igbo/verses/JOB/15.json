  "verseCount": 35,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "15",
        "style": "c",
        "sid": "JOB 15"
      },
      "items": [
        {
          "text": "15",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okwu Elifaz",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Elifaz onye Teman zara sị:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.1",
            "verseOrgIds": [
              "JOB.15.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Onye maara ihe ọ ga-eji okwu na-abaghị uru zaghachi?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.2",
            "verseOrgIds": [
              "JOB.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 15:2"
      },
      "items": [
        {
          "text": "Ọ ga-emeju afọ ya nʼifufe na-ekpo ọkụ nke si nʼọwụwa anyanwụ?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.2",
            "verseOrgIds": [
              "JOB.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ ga-eji okwu na-abaghị uru rụọ ụka,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.3",
            "verseOrgIds": [
              "JOB.15.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 15:3"
      },
      "items": [
        {
          "text": "maọbụ kwuo okwu na-enweghị isi?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.3",
            "verseOrgIds": [
              "JOB.15.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ị na-eleda ezi omume anya",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.4",
            "verseOrgIds": [
              "JOB.15.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 15:4"
      },
      "items": [
        {
          "text": "na-egbochikwa ịsọpụrụ Chineke.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.4",
            "verseOrgIds": [
              "JOB.15.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mmehie gị na-eme ka ọnụ gị kwuo okwu ngwangwa;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.5",
            "verseOrgIds": [
              "JOB.15.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 15:5"
      },
      "items": [
        {
          "text": "ọ bụkwa ire ndị aghụghọ ka i nwere.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.5",
            "verseOrgIds": [
              "JOB.15.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọnụ gị na-ama gị ikpe, ọ bụghị mụ onwe m,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.6",
            "verseOrgIds": [
              "JOB.15.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 15:6"
      },
      "items": [
        {
          "text": "egbugbere ọnụ gị na-ekwu okwu megide gị.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.6",
            "verseOrgIds": [
              "JOB.15.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ị bụ mmadụ mbụ a mụrụ?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.7",
            "verseOrgIds": [
              "JOB.15.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 15:7"
      },
      "items": [
        {
          "text": "A mụọla gị tupu e kee ugwu niile?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.7",
            "verseOrgIds": [
              "JOB.15.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ getụla ntị nʼizu nzuzo nke Chineke?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.8",
            "verseOrgIds": [
              "JOB.15.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 15:8"
      },
      "items": [
        {
          "text": "Amamihe niile ọ bụ nʼime gị ka ha juru?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.8",
            "verseOrgIds": [
              "JOB.15.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gịnị ka ị maara nke anyị na-amaghị?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.9",
            "verseOrgIds": [
              "JOB.15.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 15:9"
      },
      "items": [
        {
          "text": "Ụdị nghọta dị aṅaa ka i nwere nke anyị na-enweghị?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.9",
            "verseOrgIds": [
              "JOB.15.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndịisi awọ na ndị kara nka nọ nʼetiti anyị,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.10",
            "verseOrgIds": [
              "JOB.15.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 15:10"
      },
      "items": [
        {
          "text": "ndị ikom mere agadi karịa nna mụrụ gị.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.10",
            "verseOrgIds": [
              "JOB.15.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ ga-abụ na nkasiobi Chineke bụrụ gị ihe nta,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.11",
            "verseOrgIds": [
              "JOB.15.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 15:11"
      },
      "items": [
        {
          "text": "ka ọ bụ okwu dị nro nke ọ gwara gị?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.11",
            "verseOrgIds": [
              "JOB.15.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gịnị mere obi gị ji duhie gị,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.12",
            "verseOrgIds": [
              "JOB.15.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 15:12"
      },
      "items": [
        {
          "text": "gịnị mekwara anya gị abụọ ji chagharịa,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.12",
            "verseOrgIds": [
              "JOB.15.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "nke mere iwe gị jiri dị ọkụ megide Chineke,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.13",
            "verseOrgIds": [
              "JOB.15.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 15:13"
      },
      "items": [
        {
          "text": "meekwa ka okwu ọjọọ ndị a niile si nʼọnụ gị pụta?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.13",
            "verseOrgIds": [
              "JOB.15.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Gịnị ka mmadụ efu bụ, ọ ga-eji dị ọcha nʼobi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.14",
            "verseOrgIds": [
              "JOB.15.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 15:14"
      },
      "items": [
        {
          "text": "gịnị ka mmadụ nwanyị mụrụ bụ, na ha nwere ike ị bụ ndị ezi omume?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.14",
            "verseOrgIds": [
              "JOB.15.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ na Chineke atụkwasịghị ndị nsọ ya obi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.15",
            "verseOrgIds": [
              "JOB.15.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 15:15"
      },
      "items": [
        {
          "text": "ọ bụrụkwa na eluigwe adịghị ọcha nʼanya ya,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.15",
            "verseOrgIds": [
              "JOB.15.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "ọ ga-esi aṅaa tụkwasị mmadụ efu onye rụrụ arụ obi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.16",
            "verseOrgIds": [
              "JOB.15.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 15:16"
      },
      "items": [
        {
          "text": "bụ onye na-aṅụ ajọ omume dịka mmiri.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.16",
            "verseOrgIds": [
              "JOB.15.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Gee m ntị ka m kọwaara gị;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.17",
            "verseOrgIds": [
              "JOB.15.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 15:17"
      },
      "items": [
        {
          "text": "kwerekwa ka m gwa gị ihe m hụrụ,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.17",
            "verseOrgIds": [
              "JOB.15.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "bụ ihe ndị amamihe kwuru,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.18",
            "verseOrgIds": [
              "JOB.15.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 15:18"
      },
      "items": [
        {
          "text": "ndị na-ezobeghị ihe ha natara nʼaka nna nna ha,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.18",
            "verseOrgIds": [
              "JOB.15.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOB 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "bụ ndị e nyefere ala ndị a nʼaka ha",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.19",
            "verseOrgIds": [
              "JOB.15.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 15:19"
      },
      "items": [
        {
          "text": "mgbe ọ dịghị onye ọbịa gabigara nʼetiti ha.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.19",
            "verseOrgIds": [
              "JOB.15.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOB 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụbọchị ndụ ya niile, onye ajọ omume na-ata ahụhụ mmekpa ahụ,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.20",
            "verseOrgIds": [
              "JOB.15.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 15:20"
      },
      "items": [
        {
          "text": "bụ nke e debere ogologo afọ nye nwoke ahụ na-eme ihe ike.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.20",
            "verseOrgIds": [
              "JOB.15.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOB 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụzụ na-eweta oke egwu na-eju ya ntị,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.21",
            "verseOrgIds": [
              "JOB.15.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 15:21"
      },
      "items": [
        {
          "text": "mgbe ọ dị ka ihe niile na-aga nke ọma, ndị na-apụnara mmadụ ihe na-abịakwasị ya.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.21",
            "verseOrgIds": [
              "JOB.15.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOB 15:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "O nweghị olileanya ịgbanarị ọchịchịrị;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.22",
            "verseOrgIds": [
              "JOB.15.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 15:22"
      },
      "items": [
        {
          "text": "mma agha nọ na-echere ya.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.22",
            "verseOrgIds": [
              "JOB.15.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOB 15:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ na-akpagharị na-achọ ebe nri dịka udele;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.23",
            "verseOrgIds": [
              "JOB.15.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 15:23"
      },
      "items": [
        {
          "text": "ọ makwara na ụbọchị ọchịchịrị nọ nso.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.23",
            "verseOrgIds": [
              "JOB.15.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOB 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahụhụ na mkpagbu na-eme ka ọ tụọ oke egwu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.24",
            "verseOrgIds": [
              "JOB.15.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 15:24"
      },
      "items": [
        {
          "text": "nsogbu na-abịakwasị ya dịka eze nke nọ na njikere ibuso ndị iro ya agha.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.24",
            "verseOrgIds": [
              "JOB.15.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOB 15:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na ọ na-atụ Chineke aka nʼihu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.25",
            "verseOrgIds": [
              "JOB.15.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 15:25"
      },
      "items": [
        {
          "text": "dokwaa onwe ya imegide Onye pụrụ ime ihe niile.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.25",
            "verseOrgIds": [
              "JOB.15.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOB 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "O ji ikwesi olu ike,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.26",
            "verseOrgIds": [
              "JOB.15.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 15:26"
      },
      "items": [
        {
          "text": "dịka ọta siri ike, na-emegide Chineke.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.26",
            "verseOrgIds": [
              "JOB.15.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JOB 15:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ọ bụ ezie na abụba kpuchiri ihu ya,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.27",
            "verseOrgIds": [
              "JOB.15.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 15:27"
      },
      "items": [
        {
          "text": "abụba nke dị nʼukwu ya na-eme ka anụ ahụ nupụtakwa,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.27",
            "verseOrgIds": [
              "JOB.15.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JOB 15:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "ọ ga-ebi nʼobodo e bibiri ebibi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.28",
            "verseOrgIds": [
              "JOB.15.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 15:28"
      },
      "items": [
        {
          "text": "nʼụlọ nke mmadụ na-ekwesighị ibi nʼime ha,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.28",
            "verseOrgIds": [
              "JOB.15.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 15:28"
      },
      "items": [
        {
          "text": "ụlọ nke na-adakasị adakasị.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.28",
            "verseOrgIds": [
              "JOB.15.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JOB 15:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ọ gaghị aga nʼihu ị bụ ọgaranya, akụ ya agaghị adịgidekwa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.29",
            "verseOrgIds": [
              "JOB.15.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 15:29"
      },
      "items": [
        {
          "text": "Ihe o nwere agakwaghị agbasapụ nʼala niile ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.29",
            "verseOrgIds": [
              "JOB.15.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JOB 15:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ gaghị agbanarị ọchịchịrị,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.30",
            "verseOrgIds": [
              "JOB.15.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 15:30"
      },
      "items": [
        {
          "text": "ire ọkụ ga-eme ka ome ya kpọnwụọ,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.30",
            "verseOrgIds": [
              "JOB.15.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 15:30"
      },
      "items": [
        {
          "text": "iku ume nke ọnụ Chineke ga-ebufu ya.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.30",
            "verseOrgIds": [
              "JOB.15.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JOB 15:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka onye dị otu a hapụ ịghọgbu onwe ya site nʼịtụkwasị uche nʼihe efu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.31",
            "verseOrgIds": [
              "JOB.15.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 15:31"
      },
      "items": [
        {
          "text": "nʼihi na ọ dịghị ụgwọ ọrụ ọbụla ọ ga-enweta.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.31",
            "verseOrgIds": [
              "JOB.15.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JOB 15:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tụpụ oge ya eruo, ọ ga-anata ụgwọ ọrụ ya nʼuju,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.32",
            "verseOrgIds": [
              "JOB.15.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 15:32"
      },
      "items": [
        {
          "text": "ọzọ, alaka ya ga-akpọnwụ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.32",
            "verseOrgIds": [
              "JOB.15.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JOB 15:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ ga-adị ka osisi vaịnị nke mkpụrụ ya dapụsịrị na-achaghị acha,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.33",
            "verseOrgIds": [
              "JOB.15.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 15:33"
      },
      "items": [
        {
          "text": "dịka osisi oliv nke akwụkwọ ya kpọnwụrụ akpọnwụ.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.33",
            "verseOrgIds": [
              "JOB.15.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JOB 15:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na ndị na-amaghị Chineke ga-adị ka nwanyị aga,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.34",
            "verseOrgIds": [
              "JOB.15.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 15:34"
      },
      "items": [
        {
          "text": "ọkụ ga-erepịa ụlọ ikwu niile nke ndị hụrụ iri ngarị nʼanya.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.34",
            "verseOrgIds": [
              "JOB.15.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JOB 15:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha na-atụrụ ihe ọjọọ dịka ime, ma mụọkwa ajọọ omume;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.35",
            "verseOrgIds": [
              "JOB.15.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 15:35"
      },
      "items": [
        {
          "text": "naanị aghụghọ ka akpanwa ha na-arụpụta.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.35",
            "verseOrgIds": [
              "JOB.15.35"
            ]
          }
        }
      ]
    }
