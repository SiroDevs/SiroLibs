      "attrs": {
        "style": "q2",
        "vid": "JOB 7:19"
      },
      "items": [
        {
          "text": "maọbụ hapụ m ka m nọọrọ onwe m loda asụ mmiri?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.19",
            "verseOrgIds": [
              "JOB.7.19"
            ]
          }
        }
