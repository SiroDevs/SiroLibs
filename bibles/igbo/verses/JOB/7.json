        "vid": "JOB 7:21"
      },
      "items": [
        {
          "text": "Mgbe ahụ ị ga-achọ m, ma ị gaghị ahụkwa m anya ọzọ, nʼihi na agaghị m adịkwa.\"",
          "type": "text",
