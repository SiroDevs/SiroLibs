      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 7:20"
      },
      "items": [
        {
          "text": "gị onye na-ahụ ihe niile anyị na-eme?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.20",
            "verseOrgIds": [
              "JOB.7.20"
            ]
          }
        }
      ]
    },
