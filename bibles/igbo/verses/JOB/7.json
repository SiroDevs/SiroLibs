          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ na m emehiela, gịnị ka m mere megide gị,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.20",
            "verseOrgIds": [
              "JOB.7.20"
            ]
          }
