      "attrs": {
        "style": "q2",
        "vid": "JOB 7:18"
      },
      "items": [
        {
          "text": "ma na-anwale ya mgbe mgbe?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.18",
            "verseOrgIds": [
              "JOB.7.18"
            ]
          }
        }
