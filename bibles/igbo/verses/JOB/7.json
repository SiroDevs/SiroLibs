      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 7:21"
      },
      "items": [
        {
          "text": "ma bupụ mmehie m?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.21",
            "verseOrgIds": [
              "JOB.7.21"
            ]
          }
