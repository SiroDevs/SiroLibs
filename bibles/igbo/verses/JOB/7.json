      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOB 7:20"
      },
      "items": [
        {
          "text": "Gịnị mere i ji elekwasị m anya?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.20",
            "verseOrgIds": [
              "JOB.7.20"
            ]
          }
        }
