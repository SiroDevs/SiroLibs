          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ị gaghị elepụ anya gị site nʼebe m nọ,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.19",
            "verseOrgIds": [
              "JOB.7.19"
            ]
