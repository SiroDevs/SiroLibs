      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOB 7:21"
      },
      "items": [
        {
          "text": "Nʼihi na oge ọnwụ m eruola nso, e, oge a ga-eliba m nʼaja, ma m nwụọ.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.21",
            "verseOrgIds": [
              "JOB.7.21"
            ]
