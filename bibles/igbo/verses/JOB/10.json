        "style": "q2",
        "vid": "JOB 10:17"
      },
      "items": [
        {
          "text": "mee ka iwe gị baa ụba nʼebe m nọ;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.17",
            "verseOrgIds": [
