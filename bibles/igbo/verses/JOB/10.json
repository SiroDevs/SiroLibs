  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "10",
        "style": "c",
        "sid": "JOB 10"
      },
      "items": [
        {
          "text": "10",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ike ịdị ndụ agwụla m.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.1",
            "verseOrgIds": [
              "JOB.10.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:1"
      },
      "items": [
        {
          "text": "Hapụnụ m ka m kwuo ihe dị m nʼobi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.1",
            "verseOrgIds": [
              "JOB.10.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:1"
      },
      "items": [
        {
          "text": "kwupụta ya dịka obi ilu nke mkpụrụobi m si dị.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.1",
            "verseOrgIds": [
              "JOB.10.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihe m ga-agwa Chineke bụ nke a: Apụtala maa m ikpe,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.2",
            "verseOrgIds": [
              "JOB.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:2"
      },
      "items": [
        {
          "text": "kama gwa m ihe mere i ji ama m ikpe.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.2",
            "verseOrgIds": [
              "JOB.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ dị gị mma nʼobi imegbu m,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.3",
            "verseOrgIds": [
              "JOB.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:3"
      },
      "items": [
        {
          "text": "si otu a leda ọrụ aka gị anya,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.3",
            "verseOrgIds": [
              "JOB.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:3"
      },
      "items": [
        {
          "text": "mgbe ị na-anabata atụmatụ nke ndị na-emebi iwu?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.3",
            "verseOrgIds": [
              "JOB.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ị nwere anya nke anụ ahụ?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.4",
            "verseOrgIds": [
              "JOB.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:4"
      },
      "items": [
        {
          "text": "Ị na-ahụ ụzọ dịka mmadụ si ahụ?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.4",
            "verseOrgIds": [
              "JOB.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụbọchị nke gị, ha dịka nke ndị nwere anụ ahụ,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.5",
            "verseOrgIds": [
              "JOB.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:5"
      },
      "items": [
        {
          "text": "ka afọ nke gị, ha dịka nke mmadụ dị ike?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.5",
            "verseOrgIds": [
              "JOB.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nke ga-eme na i na-achọpụta ikpe ọmụma m",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.6",
            "verseOrgIds": [
              "JOB.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:6"
      },
      "items": [
        {
          "text": "ma nyochaa mmehie m?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.6",
            "verseOrgIds": [
              "JOB.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ ezie na ị maara na ikpe amaghị m,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.7",
            "verseOrgIds": [
              "JOB.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:7"
      },
      "items": [
        {
          "text": "na ọ dịghị onye pụrụ ịnapụta m site nʼaka gị.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.7",
            "verseOrgIds": [
              "JOB.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ọ bụ aka gị kpụrụ m kee m.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.8",
            "verseOrgIds": [
              "JOB.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:8"
      },
      "items": [
        {
          "text": "Ọ ga-atụgharịa ugbu a bibie m?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.8",
            "verseOrgIds": [
              "JOB.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cheta na ị kpụrụ m dịka ụrọ.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.9",
            "verseOrgIds": [
              "JOB.10.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:9"
      },
      "items": [
        {
          "text": "Ị ga-eme ka m laghachi nʼaja ọzọ?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.9",
            "verseOrgIds": [
              "JOB.10.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ na ị wụpụghị m dịka mmiri ara ehi",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.10",
            "verseOrgIds": [
              "JOB.10.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:10"
      },
      "items": [
        {
          "text": "mee ka m kpụkọta dịka mmiri ara rahụrụ arahụ?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.10",
            "verseOrgIds": [
              "JOB.10.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yikwasị m akpụkpọ ahụ na anụ ahụ,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.11",
            "verseOrgIds": [
              "JOB.10.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:11"
      },
      "items": [
        {
          "text": "werekwa ọkpụkpụ na akwara kpaa m dịka uwe?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.11",
            "verseOrgIds": [
              "JOB.10.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "I nyere m ndụ gosikwa m obiọma gị,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.12",
            "verseOrgIds": [
              "JOB.10.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:12"
      },
      "items": [
        {
          "text": "nʼịdị mma gị chebekwara mmụọ m.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.12",
            "verseOrgIds": [
              "JOB.10.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ma nke a bụ ihe i zoro nʼime obi gị,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.13",
            "verseOrgIds": [
              "JOB.10.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:13"
      },
      "items": [
        {
          "text": "amakwa m na ọ bụ ihe dị gị nʼuche.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.13",
            "verseOrgIds": [
              "JOB.10.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ na m mehiere, ị ga na-ele m anya,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.14",
            "verseOrgIds": [
              "JOB.10.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:14"
      },
      "items": [
        {
          "text": "ị gaghị ekwe ka m ghara ịta ahụhụ nʼihi mmehie m.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.14",
            "verseOrgIds": [
              "JOB.10.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ na ikpe mara m, ahụhụ na-adịrị m!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.15",
            "verseOrgIds": [
              "JOB.10.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:15"
      },
      "items": [
        {
          "text": "A sịkwarị na aka m dị ọcha, apụghị m iweli isi m elu",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.15",
            "verseOrgIds": [
              "JOB.10.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOB 10:15"
      },
      "items": [
        {
          "text": "nʼihi na ejupụtara m nʼihere,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.15",
            "verseOrgIds": [
              "JOB.10.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:15"
      },
      "items": [
        {
          "text": "bụrụkwa onye e mibara nʼime nsogbu m.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.15",
            "verseOrgIds": [
              "JOB.10.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ na m welie m isi elu, dịka ọdụm ị ga-eji nwayọọ na-eso m nʼazụ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.16",
            "verseOrgIds": [
              "JOB.10.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:16"
      },
      "items": [
        {
          "text": "ma werekwa ike gị dị egwu megide m.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.16",
            "verseOrgIds": [
              "JOB.10.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "I na-eweta ndị ama ọhụrụ megide m,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.17",
            "verseOrgIds": [
              "JOB.10.17"
            ]
          }
        }
      ]
    },
