      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:18"
      },
      "items": [
        {
          "text": "Ọ gaara aka m mma ịnwụ tupu anya ọbụla ahụ m.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.18",
            "verseOrgIds": [
