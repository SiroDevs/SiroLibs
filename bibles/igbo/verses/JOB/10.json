      "attrs": {
        "style": "q2",
        "vid": "JOB 10:19"
      },
      "items": [
        {
          "text": "maọbụ na e sitere nʼafọ nne m buba m nʼime ili!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.19",
            "verseOrgIds": [
              "JOB.10.19"
            ]
          }
        }
      ]
