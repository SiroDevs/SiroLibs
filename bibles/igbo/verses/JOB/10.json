          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "A sịkwarị na amụpụtaghị m",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.19",
            "verseOrgIds": [
              "JOB.10.19"
            ]
