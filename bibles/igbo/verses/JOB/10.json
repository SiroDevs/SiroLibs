      "attrs": {
        "style": "q2",
        "vid": "JOB 10:17"
      },
      "items": [
        {
          "text": "ị na-eme ka ndị agha gị na-abịakwute m, otu nʼelu ibe ya dịka ebili mmiri.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.17",
            "verseOrgIds": [
              "JOB.10.17"
            ]
