  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "19",
        "style": "c",
        "sid": "REV 19"
      },
      "items": [
        {
          "text": "19",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Otuto dịrị Onyenwe anyị",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "REV 19:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ihe ndị a gasịrị, anụrụ m ụzụ nke ọtụtụ igwe mmadụ nʼeluigwe. Ha niile na-eti mkpu na-asị,",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.1",
            "verseOrgIds": [
              "REV.19.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 19:1"
      },
      "items": [
        {
          "text": "\"Haleluya!",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.1",
            "verseOrgIds": [
              "REV.19.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 19:1"
      },
      "items": [
        {
          "text": "Nzọpụta, na ebube na ike niile dịrị Chineke anyị.",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.1",
            "verseOrgIds": [
              "REV.19.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na ikpe ikpe ya niile ziri ezi, bụrụkwa eziokwu.",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.2",
            "verseOrgIds": [
              "REV.19.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 19:2"
      },
      "items": [
        {
          "text": "Ọ kpeela nwanyị ahụ na-akwa iko ikpe,",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.2",
            "verseOrgIds": [
              "REV.19.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 19:2"
      },
      "items": [
        {
          "text": "onye ji ịkwa iko ya merụọ ụwa.",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.2",
            "verseOrgIds": [
              "REV.19.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 19:2"
      },
      "items": [
        {
          "text": "Ọ bọọlara ọbọ ọbara ndị ohu ya nʼisi ya.\"",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.2",
            "verseOrgIds": [
              "REV.19.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọzọkwa, ha tiri mkpu,",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.3",
            "verseOrgIds": [
              "REV.19.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 19:3"
      },
      "items": [
        {
          "text": "\"Haleluya!",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.3",
            "verseOrgIds": [
              "REV.19.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 19:3"
      },
      "items": [
        {
          "text": "Anwụrụ ọkụ si nʼime ya na-arịgo elu ruo mgbe ebighị ebi.\"",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.3",
            "verseOrgIds": [
              "REV.19.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, iri ndị okenye abụọ na anọ ahụ, ha na anụ anọ ahụ dị ndụ dara nʼala nʼihu Chineke onye nọkwasịrị nʼelu ocheeze ukwu ahụ, fee ya ofufe na-asị,",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.4",
            "verseOrgIds": [
              "REV.19.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 19:4"
      },
      "items": [
        {
          "text": "\"Amen, Haleluya!\"",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.4",
            "verseOrgIds": [
              "REV.19.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otu olu sitekwara nʼocheeze ahụ na-asị,",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.5",
            "verseOrgIds": [
              "REV.19.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 19:5"
      },
      "items": [
        {
          "text": "\"Toonu Chineke anyị,",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.5",
            "verseOrgIds": [
              "REV.19.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 19:5"
      },
      "items": [
        {
          "text": "unu ndị ohu ya niile,",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.5",
            "verseOrgIds": [
              "REV.19.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 19:5"
      },
      "items": [
        {
          "text": "ndị ukwu na ndị nta,",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.5",
            "verseOrgIds": [
              "REV.19.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 19:5"
      },
      "items": [
        {
          "text": "unu ndị na-atụ egwu ya.\"",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.5",
            "verseOrgIds": [
              "REV.19.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, anụkwara m olu dara ka olu igwe mmadụ dịkwa ka ụzụ mmiri na-ekwo ekwo, dịkwa ka ụda egbe eluigwe dasiri ike na-asị,",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.6",
            "verseOrgIds": [
              "REV.19.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 19:6"
      },
      "items": [
        {
          "text": "\"Haleluya!",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.6",
            "verseOrgIds": [
              "REV.19.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 19:6"
      },
      "items": [
        {
          "text": "Nʼihi na Onyenwe anyị Chineke, Onye pụrụ ime ihe niile na-achị.",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.6",
            "verseOrgIds": [
              "REV.19.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka anyị ṅụrịanụ ọṅụ, ka obi tọkwaa anyị ụtọ.",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.7",
            "verseOrgIds": [
              "REV.19.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 19:7"
      },
      "items": [
        {
          "text": "Ka anyị nye ya otuto.",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.7",
            "verseOrgIds": [
              "REV.19.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 19:7"
      },
      "items": [
        {
          "text": "Nʼihi na ọlụlụ di na nwunye nke Nwa Atụrụ ahụ eruola,",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.7",
            "verseOrgIds": [
              "REV.19.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 19:7"
      },
      "items": [
        {
          "text": "nwunye ya edoziekwala onwe ya.",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.7",
            "verseOrgIds": [
              "REV.19.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "E nyela ya ezi akwa ọcha nke na-enweghị ntụpọ ọbụla,",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.8",
            "verseOrgIds": [
              "REV.19.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 19:8"
      },
      "items": [
        {
          "text": "na nke dị nnọọ ezi ọcha ka o yikwasị onwe ya.\"",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.8",
            "verseOrgIds": [
              "REV.19.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m",
        "vid": "REV 19:8"
      },
      "items": [
        {
          "text": "(Ezi akwa ọcha ahụ nọchiri anya ọrụ ezi omume nke ndị nsọ rụrụ.)",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.8",
            "verseOrgIds": [
              "REV.19.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mmụọ ozi ahụ gwara m sị, \"Dee nke a: Ngọzị dịrị ndị ahụ a kpọrọ ka ha bịa soro nʼoriri ọlụlụ nwunye Nwa Atụrụ ahụ.\" Ọ gwakwara m sị, \"Nʼeziokwu, ndị a bụ okwu nke Chineke.\"",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.9",
            "verseOrgIds": [
              "REV.19.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adara m nʼala nʼụkwụ ya ịkpọ isiala nye ya, ma ọ gwara m sị, \"O kwesighị ka ị kpọọ isiala nye m nʼihi na abụ m naanị onyeozi ibe gị, na dịka ọtụtụ ụmụnna gị ndị na-agba ama banyere Jisọs. Ọ bụ naanị Chineke ka i kwesiri ịkpọ isiala nye. Nʼihi na ọ bụ Mmụọ nke amụma na-agba ama ihe banyere Jisọs.\"",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.10",
            "verseOrgIds": [
              "REV.19.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Onye nọkwasịrị nʼelu ịnyịnya ọcha",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ kwa, elere m anya hụ ka eluigwe meghere. Ahụkwara m otu ịnyịnya dị ọcha. Onye nọkwasịrị nʼelu ya bụ onye a na-akpọ Onye kwesiri ntụkwasị obi na Onye eziokwu. Ọ bụ onye na-ekpe ikpe nʼụzọ ziri ezi na-ebukwa agha.",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.11",
            "verseOrgIds": [
              "REV.19.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anya ya na-acha dịka ire ọkụ. Ọtụtụ okpueze dịkwa ya nʼisi. Otu aha nke naanị ya maara omimi ya ka e dekwasịrị ya nʼegedege ihu.",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.12",
            "verseOrgIds": [
              "REV.19.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "E gbokwasịrị ya uwe mwụda e denyere nʼọbara. Aha a na-akpọ ya bụ Okwu Chineke.",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.13",
            "verseOrgIds": [
              "REV.19.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usuu ndị agha nke eluigwe, ndị yi uwe ezi akwa ọcha, na-enweghị ntụpọ, nọ nʼelu ịnyịnya ọcha na-eso ya.",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.14",
            "verseOrgIds": [
              "REV.19.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ kpụ mma agha dị nkọ nʼọnụ ya, nke o ji egbutu mba niile. \"Ọ ga-eji mkpara igwe achị ha.\"",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.15",
            "verseOrgIds": [
              "REV.19.15"
            ]
          }
        },
        {
          "text": "Ọ na-azọchakwa mkpụrụ vaịnị nʼebe ịnara mmanya nke iwe ọkụ nke Chineke Onye pụrụ ime ihe niile.",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.15",
            "verseOrgIds": [
              "REV.19.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "REV 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otu aha ka e dere nʼelu uwe ya na nʼelu apata ya:",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.16",
            "verseOrgIds": [
              "REV.19.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pc",
        "vid": "REV 19:16"
      },
      "items": [
        {
          "text": "Eze kachasị ndị eze niile, na Onyenwe kachasị ndị nwenụ niile.",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.16",
            "verseOrgIds": [
              "REV.19.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "REV 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, ahụrụ m otu mmụọ ozi ka o guzo nʼime anyanwụ na-eti mkpu nʼoke olu, na-akpọku ụmụ nnụnụ niile na-efe nʼetiti mbara eluigwe, \"Bịanụ! Zukọọnụ maka oke oriri nke Chineke.",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.17",
            "verseOrgIds": [
              "REV.19.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "REV 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bịanụ soro rie anụ ahụ ndị eze, na ndị ọchịagha, na ndịisi agha. Sorokwanụ rie anụ ahụ ịnyịnya na anụ ahụ ndị nọkwasịrị nʼelu ha. Riekwanụ anụ ahụ ndị mmadụ, ndị ukwu na ndị nta, ndị ohu na ndị nweere onwe ha.\"",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.18",
            "verseOrgIds": [
              "REV.19.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "REV 19:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, ahụrụ m anụ ọhịa ọjọọ ahụ ya na ndị eze niile dị nʼụwa, na ndị agha ha, ka ha zukọtara ibu agha megide onye ahụ nọkwasịrị nʼelu ịnyịnya ahụ na ndị agha ya.",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.19",
            "verseOrgIds": [
              "REV.19.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "REV 19:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma e jidere anụ ọhịa ahụ, ya na onye amụma ụgha ahụ onye nke nọọrọ nʼihu ya gosi ihe ịrịbama nke o jiri duhie ndị niile natara akara nke anụ ọhịa ahụ, ya na ndị kpọọrọ ihe oyiyi ya isiala. A tụnyere anụ ọhịa ahụ na onye amụma ụgha ya na ndụ nʼime ọdọ ọkụ e ji nkume na-enwu ọkụ kwanye.",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.20",
            "verseOrgIds": [
              "REV.19.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "REV 19:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị agha ha fọdụrụnụ ka e jikwa mma agha dị nkọ, nke dị nʼọnụ onye ahụ nọ nʼelu ịnyịnya ọcha ahụ gbuo. Ụmụ anụ ufe niile nke eluigwe rikwara ozu ha.",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.21",
            "verseOrgIds": [
              "REV.19.21"
            ]
          }
        }
      ]
    }
  ],
