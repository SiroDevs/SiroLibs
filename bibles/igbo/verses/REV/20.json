  "verseCount": 15,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "20",
        "style": "c",
        "sid": "REV 20"
      },
      "items": [
        {
          "text": "20",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Puku afọ ahụ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "REV 20:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ kwa, ahụrụ m otu mmụọ ozi ka o si nʼeluigwe na-arịdata, o ji mkpisi igodo e ji atụghe olulu Abis ahụ. O jikwa eriri igwe dị ukwuu nʼaka ya.",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.1",
            "verseOrgIds": [
              "REV.20.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "O jidere agwọ ochie ahụ, bụ agwọ ochie ahụ, onye bụ Ekwensu na Setan, kee ya agbụ otu puku afọ.",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.2",
            "verseOrgIds": [
              "REV.20.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emesịa, a tụnyere ya nʼime olulu Abis ahụ, tụchie ụzọ ya. Ọ kakwara akara nʼelu ya ka agwọ ochie ahụ hapụ inwekwa ike iduhie mba niile dị nʼụwa ọzọ tutu ruo mgbe puku afọ gasịrị. Mgbe afọ ndị a zuru, a ga-atọghepụ ya ka ọ gagharịa nwantịntị oge.",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.3",
            "verseOrgIds": [
              "REV.20.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mbilite nʼọnwụ nke mbụ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, ahụkwara m ocheeze, hụkwa ndị nọ nʼelu ya. Ha bụ ndị e nyere ike ikpe ikpe. Ahụkwara m mkpụrụobi ndị ahụ e bepụrụ isi nʼihi na ha gbaara Jisọs akaebe, kwusakwa okwu Chineke. Ha akpọbeghị isiala nye anụ ọhịa ahụ maọbụ ihe oyiyi ya. Ha enweghị akara anụ ọhịa ahụ nʼegedege ihu ha, maọbụ nʼaka ha. Ha dịkwa ndụ ọzọ, sorokwa Kraịst chịa otu puku afọ.",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.4",
            "verseOrgIds": [
              "REV.20.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nke a bụ mbilite nʼọnwụ nke mbụ. Ndị fọdụrụ nʼetiti ndị nwụrụ anwụ esoghị bilite nʼọnwụ tutu ruo mgbe puku afọ gafesịrị.",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.5",
            "verseOrgIds": [
              "REV.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị a gọziri agọzi na ndị dị nsọ bụ ndị ahụ ketara oke na mbilite nʼọnwụ nke mbụ ahụ. Ọnwụ nke abụọ enweghị ike nʼebe ha nọ, nʼihi na ha ga-abụ ndị nchụaja Chineke na nke Kraịst, sorokwa ya chịa ọchịchị puku afọ.",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.6",
            "verseOrgIds": [
              "REV.20.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ikpe e kpere Setan",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe puku afọ ahụ gafesịrị, a ga-emekwa ka ekwensu si nʼụlọ mkpọrọ ya pụta.",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.7",
            "verseOrgIds": [
              "REV.20.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ ga-apụkwa jegharịa iduhie mba niile nọ nʼakụkụ anọ nke ụwa, ya bụ Gog na Magog, ọ ga-akpọkọta ha maka agha. Ọnụọgụgụ ha dịka aja dị nʼikpere osimiri.",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.8",
            "verseOrgIds": [
              "REV.20.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha biliri agha guzo nʼụwa niile, gbaa ụlọ ikwu nke ndị nsọ Chineke hụrụ nʼanya gburugburu. Ma ọkụ sitere nʼeluigwe gbadata repịa ha.",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.9",
            "verseOrgIds": [
              "REV.20.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 20:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, ekwensu ahụ dufuru ha ka a ga-atụnye nʼọdọ ọkụ e ji nkume na-enwu ọkụ kwanye. Ebe ahụ ka ọ ga-anọ, ya na anụ ọhịa ọjọọ ahụ, na onye amụma ụgha ya. Ha ga-anọkwa nʼọnọdụ ahụ mgbu ehihie na abalị ruo mgbe ebighị ebi.",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.10",
            "verseOrgIds": [
              "REV.20.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ikpe Ikpeazụ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 20:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahụkwara m otu ocheeze ọcha buru ibu, na onye nọkwasịrị nʼelu ya. Ụwa na mbara eluigwe si nʼihu ya gbapụ, ahụkwaghị ebe ọbụla nye ha.",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.11",
            "verseOrgIds": [
              "REV.20.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 20:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahụrụ m ndị niile nwụrụ anwụ, ndị ukwu na ndị nta, ka ha guzo nʼihu ocheeze ahụ. E meghere akwụkwọ dị iche iche, meghekwa akwụkwọ ọzọ, nke bụ akwụkwọ nke ndụ. E sitekwara nʼihe niile e dere nʼakwụkwọ ahụ kpee ndị a niile nwụrụ anwụ ikpe dịka ọrụ ha rụrụ si dị.",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.12",
            "verseOrgIds": [
              "REV.20.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 20:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oke osimiri niile nyeghachiri ndị niile nwụrụ nọ nʼime ha. Otu a kwa, ọnwụ na ala mmụọ nyeghachikwara ndị nwụrụ anwụ dị nʼime ha. E kpekwara onye ọbụla ikpe dịka ọrụ ya si dị.",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.13",
            "verseOrgIds": [
              "REV.20.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 20:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emesịa, a tụnyere ọnwụ na ọkụ ala mmụọ nʼime ọdọ ọkụ ahụ. Nke a bụ ọnwụ nke ugboro abụọ nke bụ ọdọ ọkụ.",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.14",
            "verseOrgIds": [
              "REV.20.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 20:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye ọbụla a na-achọtaghị ebe e dere aha ya nʼakwụkwọ nke ndụ ahụ, ka a tụnyere nʼime ọdọ ọkụ ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.15",
            "verseOrgIds": [
              "REV.20.15"
            ]
          }
        }
      ]
    }
  ],
