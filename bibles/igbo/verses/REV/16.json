  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "16",
        "style": "c",
        "sid": "REV 16"
      },
      "items": [
        {
          "text": "16",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Efere asaa nke ọnụma Chineke",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "REV 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, anụrụ m oke olu si nʼụlọnsọ ahụ na-ada na-agwa ndị mmụọ ozi asaa ahụ okwu, \"Ngwanụ, gaanụ wụsa ihe dị nʼefere ọnụma asaa Chineke ahụ nʼelu ụwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.1",
            "verseOrgIds": [
              "REV.16.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mmụọ ozi nke mbụ pụrụ gaa wụsa ihe dị nʼefere nke ya nʼelu ụwa, ọnya ọjọọ na-egbu oke mgbu bịakwasịrị mmadụ niile nwere akara anụ ọhịa ahụ, na ndị na-akpọrọ oyiyi ya isiala.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.2",
            "verseOrgIds": [
              "REV.16.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mmụọ ozi nke abụọ wụsara ihe dị nʼime efere nke ya nʼelu osimiri niile. Otu mgbe ahụ, osimiri niile chagharịrị ghọọ ọbara dịka nke onye nwụrụ anwụ. Nke a mere ka ihe niile dị ndụ nʼime osimiri ahụ nwụọ.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.3",
            "verseOrgIds": [
              "REV.16.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mmụọ ozi nke atọ pụrụ gaa wụsa ihe dị nʼefere nke ya nʼelu iyi na nʼelu isi iyi niile. Nke a mere ka ha niile ghọọ ọbara.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.4",
            "verseOrgIds": [
              "REV.16.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anụrụ m ka mmụọ ozi ahụ mmiri niile dị nʼaka ya kwuru okwu sị,",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.5",
            "verseOrgIds": [
              "REV.16.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 16:5"
      },
      "items": [
        {
          "text": "\"I kpere ikpe ziri ezi, Gị, Onye dị Nsọ,",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.5",
            "verseOrgIds": [
              "REV.16.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 16:5"
      },
      "items": [
        {
          "text": "na onye na-adị site na mmalite, na onye na-adịkwa ugbu a.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.5",
            "verseOrgIds": [
              "REV.16.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na ha wụsara ọbara ndị nsọ gị na ndị amụma gị.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.6",
            "verseOrgIds": [
              "REV.16.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 16:6"
      },
      "items": [
        {
          "text": "Ma ugbu a, i nyela ha ọbara ka ha ṅụọ. Nke a bụkwa ezi ụgwọ ọrụ ha kwesiri ịnata.\"",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.6",
            "verseOrgIds": [
              "REV.16.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ kwa, anụrụ m ka mmụọ ozi ahụ na-anọ nʼebe ịchụ aja sịrị,",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.7",
            "verseOrgIds": [
              "REV.16.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 16:7"
      },
      "items": [
        {
          "text": "\"E, Onyenwe anyị Chineke, Onye pụrụ ime ihe niile,",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.7",
            "verseOrgIds": [
              "REV.16.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 16:7"
      },
      "items": [
        {
          "text": "ikpe gị niile bụ nke ziri ezi, bụrụkwa eziokwu.\"",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.7",
            "verseOrgIds": [
              "REV.16.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mmụọ ozi nke anọ pụrụ wụsa ihe dị nʼefere nke ya nʼelu anyanwụ si otu a mee ka anwụ were okpomọkụ ya chagbuo ndị mmadụ.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.8",
            "verseOrgIds": [
              "REV.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okpomọkụ ahụ si nʼanyanwụ bịa rere onye ọbụla ọkụ nʼahụ. Nke a mere ka ndị mmadụ bido ịkọcha aha Chineke, onye nwere ike ịchị ihe otiti ndị a, ma ha jụrụ ichegharị nye ya otuto.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.9",
            "verseOrgIds": [
              "REV.16.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mmụọ ozi nke ise pụrụ wụkwasị ihe dị nʼefere nke ya nʼelu ocheeze anụ ọhịa ahụ, mee ka alaeze ya jupụta nʼọchịchịrị. Ndị mmadụ tabiri ire ha nʼihi oke ahụ ụfụ.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.10",
            "verseOrgIds": [
              "REV.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha kọchara Chineke nke eluigwe nʼihi ihe ụfụ na ọnya bịakwasịrị ha. Ma ha jụrụ ichegharị site nʼajọ ọrụ ha niile.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.11",
            "verseOrgIds": [
              "REV.16.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mmụọ ozi nke isii pụkwara wụkwasị ihe dị nʼefere ya nʼelu mmiri ukwu ahụ bụ Yufretis si otu a mee ka mmiri dị nʼime ya taa. Nke a mere ka ọ dịrị ndị eze ahụ si nʼọwụwa anyanwụ mfe.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.12",
            "verseOrgIds": [
              "REV.16.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahụrụ mmụọ atọ rụrụ arụ ndị pụtara ihe nʼụdịdị awọ, ha si nʼọnụ agwọ ochie ahụ na nʼọnụ anụ ọhịa ahụ nwere ike ịrụ ọrụ ịtụnanya pụta, na nʼọnụ onye amụma ụgha ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.13",
            "verseOrgIds": [
              "REV.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha bụ mmụọ nke ajọ mmụọ ndị ahụ na-arụ ọrụ ịrịbama. Ọ bụ ha na-ejekwuru ndị eze ụwa niile ịchịkọta ha maka ibu agha nʼụbọchị ukwu ahụ bụ ụbọchị Chineke Onye pụrụ ime ihe niile.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.14",
            "verseOrgIds": [
              "REV.16.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "mi"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Lee! Ana m abịa dịka onye ohi. Ngọzị na-adịrị onye ahụ nọ na-eche nche, ndị yi uwe ha na njikere, ka ọ ghara ijegharị nʼọnọdụ ịgba ọtọ, bụrụ onye ọnọdụ ya na-eweta ihere.\"",
              "type": "text",
              "attrs": {
                "verseId": "REV.16.15",
                "verseOrgIds": [
                  "REV.16.15"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "REV 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha kpọkọrọ ndị eze ahụ nʼotu ebe a na-akpọ Amagidọn nʼasụsụ Hibru.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.16",
            "verseOrgIds": [
              "REV.16.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "REV 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mmụọ ozi nke asaa wụpụrụ ihe dị nʼefere nke ya nʼikuku, otu olu sitere nʼocheeze dị nʼụlọnsọ ukwu ahụ daa ụda sị, \"Emezuola ya!\"",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.17",
            "verseOrgIds": [
              "REV.16.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "REV 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ egbe eluigwe bidoro na-agba na-eme mkpọtụ, amụma bidokwara na-egbu, oke ala ọma jijiji dịkwara nʼụwa, ụdị nke na-adịbeghị site na mgbe e kere ụwa. Ọ bụ ala ọma jijiji kachasị ala ọma jijiji ndị ọzọ njọ.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.18",
            "verseOrgIds": [
              "REV.16.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "REV 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obodo ukwu ahụ kewara ụzọ atọ. Obodo niile dị na mba niile dakwara. Chineke chetara obodo ukwu ahụ bụ Babilọn. O nyere ya iko jupụtara na mmanya nke nʼoke iwe nke ọnụma ya.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.19",
            "verseOrgIds": [
              "REV.16.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "REV 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, agwa etiti niile mikpuru, ugwu niile ghọrọ ala dị larịị.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.20",
            "verseOrgIds": [
              "REV.16.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "REV 16:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkpụrụ mmiri nke ịdị arọ otu nʼime ha ruru kilogram iri anọ na ọkara, sitere nʼeluigwe na-adakwasị ndị mmadụ. Nke a mekwara ka ha kọchaa Chineke nʼihi ihe ntaramahụhụ nke mkpụrụ mmiri ahụ, nʼihi na ihe ntaramahụhụ ahụ dị nnọọ njọ nke ukwuu.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.21",
            "verseOrgIds": [
              "REV.16.21"
            ]
          }
        }
      ]
    }
  ],
