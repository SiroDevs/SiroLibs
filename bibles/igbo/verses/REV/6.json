  "verseCount": 17,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
        "style": "c",
        "sid": "REV 6"
      },
      "items": [
        {
          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Akara mechiri akwụkwọ ahụ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "REV 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahụrụ m mgbe Nwa atụrụ ahụ meghere otu nʼime akara asaa ahụ. Otu nʼime anụ anọ ahụ dị ndụ tiri mkpu dịka a ga-asị na ọ bụ egbe eluigwe sị, \"Bịa!\"",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.1",
            "verseOrgIds": [
              "REV.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe m lere anya, ahụrụ m ịnyịnya dị ọcha. Onye na-anọkwasị nʼelu ya ji ụta nʼaka ya. A tụkwasịkwara okpueze nʼisi ya dịka onye agha na-emeri emeri mgbe niile.",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.2",
            "verseOrgIds": [
              "REV.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe o meghere akara nke abụọ, ngwangwa, anụrụ m ka anụ nke abụọ ahụ nʼime anụ anọ ndị ahụ dị ndụ tiri mkpu sị, \"Bịa!\"",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.3",
            "verseOrgIds": [
              "REV.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, ịnyịnya ọzọ na-acha ọbara ọbara pụtara. E nyere onye nọkwasịrị nʼelu ya ike iwepụ udo nʼụwa nakwa ime ka ụmụ mmadụ na-egburita ibe ha. E nyekwara ya mma agha dị ukwuu.",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.4",
            "verseOrgIds": [
              "REV.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma mgbe o meghere akara nke atọ, anụrụ m ka anụ nke atọ ahụ dị ndụ kwuru, \"Bịa!\" Ahụrụ m ịnyịnya dị ojii. Onye na-anọkwasị nʼelu ya ji ihe ọtụtụ abụọ nʼaka ya.",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.5",
            "verseOrgIds": [
              "REV.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anụkwara m ihe dị ka olu nke sitere nʼetiti anụ anọ ahụ dị ndụ na-adapụta sị, \"Otu ihe ọtụtụ kilo",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.6",
            "verseOrgIds": [
              "REV.6.6"
            ]
          }
        },
        {
          "text": "nke ọka wiiti bụ ụgwọ ọrụ otu ụbọchị,",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.6",
            "verseOrgIds": [
              "REV.6.6"
            ]
          }
        },
        {
          "text": "ihe ọtụtụ kilo atọ",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.6",
            "verseOrgIds": [
              "REV.6.6"
            ]
          }
        },
        {
          "text": "nke ọka balị bụkwa ụgwọ ọrụ otu ụbọchị. Ya mere, unu emebikwala mmanụ oliv na mmanya.\"",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.6",
            "verseOrgIds": [
              "REV.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe o meghere akara nke anọ, anụrụ m ka anụ nke anọ dị ndụ sịrị, \"Bịa!\"",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.7",
            "verseOrgIds": [
              "REV.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elere m anya ma hụ ịnyịnya na-acha ntụntụ nʼihu m. Aha onye nọkwasịrị nʼelu ya bụ Ọnwụ na Ọkụ ala mmụọ na-esokwa ya nʼazụ. E nyere ha ike nʼebe otu ụzọ nʼụzọ anọ nke ụwa dị ka ha jiri mma agha na ụnwụ, na ọrịa ọjọọ na anụ ọhịa gbuchapụ ndị bi nʼime ha.",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.8",
            "verseOrgIds": [
              "REV.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma mgbe ọ meghere akara nke ise, ahụrụ m nʼokpuru ebe ịchụ aja mkpụrụobi ndị niile e gburu egbu nʼihi okwu Chineke na nʼihi ịgba ama nke ha jidesiri ike.",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.9",
            "verseOrgIds": [
              "REV.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha ji oke olu tie mkpu na-asị, \"Gị, Onye kachasị ihe niile elu, bụ Onyenwe anyị, onye dị nsọ na onye eziokwu, ruo olee mgbe ka ị na-eche ikpe ụwa na ndị bi nʼime ya ikpe ma bọọkwa ọbọ nʼisi ha maka ọbara anyị ha wufuru?\"",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.10",
            "verseOrgIds": [
              "REV.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "E nyere ha nʼotu nʼotu uwe ọcha, a gwakwara ha ka ha zuru ike nwa oge nta, tutu ruo mgbe ọnụọgụgụ ndị ozi ibe ha na ụmụnna ha a ga-egbu dịka e gburu ha ga-ezu.",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.11",
            "verseOrgIds": [
              "REV.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anọkwa m na-ele anya mgbe o meghere akara nke isii ahụ. Nke a mere ka oke ala ọma jijiji dịrị. Anyanwụ gbara ọchịchịrị dị ka akwa mkpe e jiri ajị mee. E mekwara ka ọnwa chaa uhie uhie dịka ọbara.",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.12",
            "verseOrgIds": [
              "REV.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, kpakpando dị na mbara eluigwe malitere ịdapụ nʼala dịka mkpụrụ osisi fiig na-achaghị acha si adapụ mgbe oke ifufe na-efegharị ya.",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.13",
            "verseOrgIds": [
              "REV.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbara eluigwe gabigara, dịka akwụkwọ mgbe a na-apịakọta ya. Ugwu niile na agwa etiti niile ka e wepụkwara site nʼọnọdụ ha.",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.14",
            "verseOrgIds": [
              "REV.6.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị eze niile nke ụwa na ndị nọ nʼọchịchị dị iche iche, na ndị ọgaranya, na ndị nọ nʼọnọdụ dị elu, na ndị ọchịagha, na ndị mmadụ niile dị iche iche, ndị ukwu ma ndị nta, ndị ohu na ndị nwe onwe ha, ha niile gara zoo onwe ha nʼime ọgba nkume na nʼokpuru ugwu,",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.15",
            "verseOrgIds": [
              "REV.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "REV 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "ha na-eti mkpu na-arịọ ugwu ndị ahụ na-asị, \"Dakwasịnụ anyị zoo anyị ka onye ahụ nọkwasịrị nʼelu ocheeze ahụ hapụ ịhụ anyị, ka oke iwe nke Nwa Atụrụ ahụ hapụ ịbịakwasị anyị.",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.16",
            "verseOrgIds": [
              "REV.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "REV 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na, lee oke ụbọchị iwe ha abịala, onye pụrụ ịgbanarị ya?\"",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.17",
            "verseOrgIds": [
              "REV.6.17"
            ]
          }
        }
      ]
    }
  ],
