  "verseCount": 15,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "9",
        "style": "c",
        "sid": "2CO 9"
      },
      "items": [
        {
          "text": "9",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Inyere ndị nọ na mkpa aka",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CO 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ dịghị mkpa idere unu akwụkwọ banyere ozi nke ndị nsọ.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.9.1",
            "verseOrgIds": [
              "2CO.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CO 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amaara m na unu jikeere inyere ha aka, dịka m nyara isi nye ndị Masidonia banyere unu. Nʼihi na agwara m ha na unu ndị bi na Akaịa ejikerelarị inyere ha aka kemgbe afọ gara aga. Ọ bụkwa ịnụ ọkụ nʼobi unu kwaliri obi ha, ime ihe ha mere.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.9.2",
            "verseOrgIds": [
              "2CO.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CO 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ugbu a, ana m ezitere unu ụmụnna anyị ndị a ka e mee ka ịnya isi nke m nyara banyere unu ghara ịbụ okwu efu. Ma dịka m gwara ha na unu ejikerela, achọrọ m ka unu jikere nye ha ihe unu chọrọ inye.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.9.3",
            "verseOrgIds": [
              "2CO.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CO 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na ọ bụrụ na ndị Masidonia esoro m bịa hụ na unu ejikeghị ejike, ebe anyị na-anya isi na unu ejikerela, ọ ga-abụrụ m ihe ihere, bụkwara unu ihe ihere, ebe anyị nwere ntụkwasị obi na unu ga-anọ na njikere.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.9.4",
            "verseOrgIds": [
              "2CO.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CO 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ nke a mere m ji hụ na ọ dị mkpa ịrịọ ụmụnna anyị ka ha buru ụzọ bịa, tupu m bịa. Ka unu nwee ike ịkwado onyinye ahụ unu kwere na nkwa inye, jide ya na njikere ruo mgbe m bịara. Ka unu si otu a gosi ndị mụ na ha ga-eso na unu na-enye nʼihi na unu chọrọ inye, ọ bụkwaghị nʼihi na a gwara unu ka unu nye.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.9.5",
            "verseOrgIds": [
              "2CO.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ngọzị dịrị ndị gbasara aka nye onyinye",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CO 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isi okwu bụ nke a, Onye ọbụla na-akụ mkpụrụ ntakịrị, ga-aghọtakwa nke nta, ma onye ahụ na-akụ mkpụrụ buru ibu ga-aghọtakwa mkpụrụ hiri nne.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.9.6",
            "verseOrgIds": [
              "2CO.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CO 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka onye ọbụla nye dịka o buru ụzọ kpebie nʼime obi ya inye. Ka ọ ghara inye nʼihi na mmadụ kwagidere ya, maọbụ inye nʼihi na ndị ọzọ na-enye, nʼihi na Chineke hụrụ ndị ji obi ụtọ nye onyinye ha nʼanya.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.9.7",
            "verseOrgIds": [
              "2CO.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CO 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chineke nwere ike inye unu karịa ihe na-akpa unu, ka unu na-enwezukwa ihe unu chọrọ mgbe niile nʼoge niile. Mgbe ahụ, unu ga-enwezukwa ihe niile unu ji arụ ọrụ ọma.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.9.8",
            "verseOrgIds": [
              "2CO.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CO 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dịka e dere ya,",
          "type": "text",
          "attrs": {
            "verseId": "2CO.9.9",
            "verseOrgIds": [
              "2CO.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "2CO 9:9"
      },
      "items": [
        {
          "text": "\"Ọ gbasara onyinye ya ebe niile nye ndị ogbenye;",
          "type": "text",
          "attrs": {
            "verseId": "2CO.9.9",
            "verseOrgIds": [
              "2CO.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2CO 9:9"
      },
      "items": [
        {
          "text": "ezi omume ya na-adịgidekwa ruo mgbe ebighị ebi.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CO.9.9",
            "verseOrgIds": [
              "2CO.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CO 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma onye ahụ na-enye onye ọrụ ubi mkpụrụ nke ọ na-agha nʼubi ya, na-enyekwa mmadụ nri ọ ga-eri, ọ ga-enyekwa unu ihe niile dị unu mkpa, meekwa ka ụlọakụ unu jupụta na mkpụrụ. Ọ ga-emekwa ka mkpụrụ ezi omume unu baa ụba.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.9.10",
            "verseOrgIds": [
              "2CO.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CO 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ ga-emekwa ka unu bụrụ ndị ọgaranya nʼụzọ niile, ka unu nwee ihe ga-ezuru unu na nke unu ga-enye ndị ọzọ mgbe niile. Site nʼaka anyị, afọ ofufu unu ga-enye Chineke ekele nʼihi inyeaka unu nyere ha.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.9.11",
            "verseOrgIds": [
              "2CO.9.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CO 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na ije ozi nke ife ofufe a abụghị naanị nke igboro ndị nsọ mkpa ha, kama ọ bụkwa nke na-eme ka ekele ọtụtụ ndị mmadụ na-enye Chineke babiga ụba oke.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.9.12",
            "verseOrgIds": [
              "2CO.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CO 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi ije ozi a, nke unu sitere na ya gosi onwe unu dịka ndị kwesiri, ndị ọzọ ga-eto Chineke nʼihi irube isi unu nke dakọtara na nkwupụta unu banyere oziọma nke Kraịst, ya na onyinye afọ ofufu nke unu na-eme ka ha na ndị ọzọ niile soro unu nwekọ.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.9.13",
            "verseOrgIds": [
              "2CO.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CO 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nke a ga-eme nʼekpere ha maka unu, ha ga-eji obi ha niile rịọọ arịrịọ, nʼihi ịdị ukwu nke amara Chineke dị nʼime unu.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.9.14",
            "verseOrgIds": [
              "2CO.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CO 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekele dịrị Chineke nʼihi onyinye ya dị ukwuu nke ọnụ na-apụghị ịkọ.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.9.15",
            "verseOrgIds": [
              "2CO.9.15"
            ]
          }
        }
      ]
    }
  ],
