  "verseCount": 18,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "10",
        "style": "c",
        "sid": "2CO 10"
      },
      "items": [
        {
          "text": "10",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Anyị bụ ndị Chineke họpụtara",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CO 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma mụ onwe m bụ Pọl, ji ịdị nwayọọ na obi umeala nke Kraịst na-arịọ unu. Mụ, onye na-adị umeala mgbe mụ na unu nọ nʼihu nʼihu, ma na-enwe mkwuwa okwu nʼebe unu nọ mgbe m na-anọghị nʼetiti unu.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.1",
            "verseOrgIds": [
              "2CO.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CO 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arịọ m unu, ka m ghara inwe obi ike mgbe m bịarutere dịka o kwesiri nʼebe ụfọdụ ndị nọ, site na iguzogide ndị ahụ na-eche na anyị na-eme ihe dị ka ndị ụwa si eme ya.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.2",
            "verseOrgIds": [
              "2CO.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CO 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ ezie na anyị na-ebi dịka mmadụ, ma anyị adịghị ebu agha dịka usoro anụ ahụ si dị.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.3",
            "verseOrgIds": [
              "2CO.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CO 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na ngwa agha anyị ji ebu agha, abụghị ngwa agha nke mmadụ nkịtị nke ụwa, kama ha nwere ike nke mmụọ ịla ebe niile e wusiri ike nʼiyi.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.4",
            "verseOrgIds": [
              "2CO.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CO 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyị na-ala ịrụ ụka niile na okwu ụgha niile nʼiyi, nke na-egbochiri ụmụ mmadụ ụzọ e si amata Chineke, na-eme ka echiche niile hulata isi nʼokpuru Kraịst.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.5",
            "verseOrgIds": [
              "2CO.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CO 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyị nọ na njikere ịta erubeghị isi niile ahụhụ, mgbe irube isi gị zuruoke.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.6",
            "verseOrgIds": [
              "2CO.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CO 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unu na-ele anya nʼihe ndị dị unu nʼihu. Ọ bụrụ na ọ bụ ihe doro anya nye onye ọbụla na ha bụ nke Kraịst, ha matakwa na onwe ha, na otu ahụ ha bụ nke Kraịst na anyị onwe anyị bụkwa nke ya.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.7",
            "verseOrgIds": [
              "2CO.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CO 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ugbu a, ọ bụrụ na m anya isi banyere ikike ahụ Onyenwe anyị nyere m nʼebe unu nọ, ike ahụ o nyere m iji wulie unu elu, ọ bụghị iji wedaa unu ala, ihere agaghị eme m nʼihi nke a.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.8",
            "verseOrgIds": [
              "2CO.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CO 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Achọghị ka ọ dịka m a ga-asị na m sitere nʼakwụkwọ ozi m na-emenye unu egwu.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.9",
            "verseOrgIds": [
              "2CO.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CO 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na ha na-asị, \"Akwụkwọ ozi ya dị arọ dịkwa ike, ma na mmadụ, ma nʼọdịdị ya na mmadụ adịghị ike, okwu ọnụ ya bụkwa ihe na-abaghị uru.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.10",
            "verseOrgIds": [
              "2CO.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CO 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ana m eme ka ndị dị otu a ghọta na ihe anyị na-ekwu site nʼakwụkwọ ozi mgbe anyị na-anọghị nʼetiti unu, ka anyị ga-eme ma anyị nọrọ nʼetiti unu.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.11",
            "verseOrgIds": [
              "2CO.10.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CO 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyị enweghị anya ike ihazi ọnọdụ maọbụ were onwe anyị tụnyere ndị ụfọdụ na ndị ahụ nʼeto onwe ha. Ma mgbe ha na-eji onwe ha na-atụ onwe ha, werekwa onwe ha na-atụnyere onwe ha, ha adịghị ezipụta nghọta.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.12",
            "verseOrgIds": [
              "2CO.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CO 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma anyị onwe anyị, adịghị anya isi banyere ihe ọbụla anyị na-enweghị ike ime. Kama anyị ga-anya isi nʼoke ọrụ ahụ Chineke kenyere anyị, ka anyị rụrụte ọ bụladị ruo nʼebe unu nọ.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.13",
            "verseOrgIds": [
              "2CO.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CO 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na anyị adịghị ekwu okwu karịrị ọnụ anyị mgbe anyị na-etinye anya nʼihe gbasara unu, nʼihi na ọ bụ anyị buru ụzọ bịakwute unu, ikwusara unu oziọma gbasara Kraịst.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.14",
            "verseOrgIds": [
              "2CO.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CO 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụghị na anyị na-ekwu na ọ bụ anyị rụrụ ọrụ niile, ya na ọrụ nke ndị ọzọ rụrụ nʼetiti unu, kama olileanya anyị bụ na okwukwe unu ga na-eto eto mgbe niile, ka ọrụ ya nʼetiti unu bụrụ nke ga-eto eto.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.15",
            "verseOrgIds": [
              "2CO.10.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CO 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nke a ga-eme ka anyị nwee ike zisaa oziọma ahụ na mba ndị ọzọ ndị dị nʼofe ala unu, ghara iji ọrụ arụrụ nʼebe ndị ọzọ na-arụ ọrụ na-etu ọnụ.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.16",
            "verseOrgIds": [
              "2CO.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CO 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma, \"Onye ọbụla na-anya isi, ya nyaa nʼime Onyenwe anyị.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.17",
            "verseOrgIds": [
              "2CO.10.17"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.17",
            "verseOrgIds": [
              "2CO.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CO 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na ọ bụghị onye ji aka ya bulie onwe ya elu ka a na-anabata, kama ọ bụ onye Onyenwe anyị jiri aka ya bulie.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.18",
            "verseOrgIds": [
              "2CO.10.18"
            ]
          }
        }
      ]
    }
  ],
