  "verseCount": 20,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "8",
        "style": "c",
        "sid": "DEU 8"
      },
      "items": [
        {
          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Echezọla",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lezie anya hụ na i debezuru iwu ndị a niile m nyere gị taa. Ọ bụrụ na i debe ha, ọ bụghị naanị na ị ga-adị ndụ, kama ị ga-amụba, banyekwa inweta ala ahụ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.1",
            "verseOrgIds": [
              "DEU.8.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.8.1",
                "verseOrgIds": [
                  "DEU.8.1"
                ]
              }
            }
          ]
        },
        {
          "text": "kwere nna nna gị ha na nkwa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.1",
            "verseOrgIds": [
              "DEU.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chetakwa otu",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.2",
            "verseOrgIds": [
              "DEU.8.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.8.2",
                "verseOrgIds": [
                  "DEU.8.2"
                ]
              }
            }
          ]
        },
        {
          "text": "bụ Chineke gị si duo gị nʼime ọzara iri afọ anọ ndị a niile. O wedara mmụọ gị ala, nwakwaa gị ọnwụnwa ịmata ihe dị gị nʼobi, ịchọpụta ma ị ga-edebekwa iwu ya.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.2",
            "verseOrgIds": [
              "DEU.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "E, o wedatara mmụọ gị ala mgbe o mere ka ihe oriri kọ gị, mgbe o mere ka i rie mánà, nri ahụ gị na nna gị na-amaghị ihe ọ bụ. O mere nke a igosi gị na izi gị na ọ bụghị naanị achịcha ka mmadụ ga-eji dị ndụ, kama ọ bụ nʼokwu niile nke si nʼọnụ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.3",
            "verseOrgIds": [
              "DEU.8.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.8.3",
                "verseOrgIds": [
                  "DEU.8.3"
                ]
              }
            }
          ]
        },
        {
          "text": "pụta.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.3",
            "verseOrgIds": [
              "DEU.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iri afọ anọ ndị a niile, uwe gị akaghị nka, ụkwụ gị azakwaghị aza.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.4",
            "verseOrgIds": [
              "DEU.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi ya, mata nke a nʼobi gị, na dịka nna si adọ nwa ya aka na ntị, otu a ka",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.5",
            "verseOrgIds": [
              "DEU.8.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.8.5",
                "verseOrgIds": [
                  "DEU.8.5"
                ]
              }
            }
          ]
        },
        {
          "text": "bụ Chineke gị si adọ gị aka na ntị.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.5",
            "verseOrgIds": [
              "DEU.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Debe iwu",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.6",
            "verseOrgIds": [
              "DEU.8.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.8.6",
                "verseOrgIds": [
                  "DEU.8.6"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke gị. Na-ejegharị ije nʼụzọ ya, ma na-atụkwa ya egwu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.6",
            "verseOrgIds": [
              "DEU.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.7",
            "verseOrgIds": [
              "DEU.8.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.8.7",
                "verseOrgIds": [
                  "DEU.8.7"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke gị na-ewebata gị nʼala mara mma, bụ ala nwere iyi, na ọdọ mmiri, ala nwere mmiri nke si nʼime ya na-asọpụta asọgharị nʼugwu na ndagwurugwu,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.7",
            "verseOrgIds": [
              "DEU.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "ọ bụ ala na-epu ọka wiiti na ọka balị, na osisi vaịnị, na osisi fiig, na osisi pomegranet, na mmanụ oliv, na mmanụ aṅụ.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.8",
            "verseOrgIds": [
              "DEU.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụkwa ala jupụtara nʼihe oriri, ebe a na-agaghị enwe ụkọ nri. Ọ bụ ala ebe igwe jupụtara nʼime ya dị ka ha bụ nkume, ala ebe ọla jupụtakwara nʼugwu ya niile.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.9",
            "verseOrgIds": [
              "DEU.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe i riri rijuo afọ, too",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.10",
            "verseOrgIds": [
              "DEU.8.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.8.10",
                "verseOrgIds": [
                  "DEU.8.10"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke gị nʼihi ala mara mma nke o nyere gị.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.10",
            "verseOrgIds": [
              "DEU.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma lezie anya ka ị ghara ichefu",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.11",
            "verseOrgIds": [
              "DEU.8.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.8.11",
                "verseOrgIds": [
                  "DEU.8.11"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke gị, na-edebeghị iwu ya niile, na ikpe ya niile, na ụkpụrụ ya niile, nke m na-enye gị taa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.11",
            "verseOrgIds": [
              "DEU.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka ọ ghara ị bụ, mgbe i riri rijuru afọ, mgbe i wuuru onwe gị ezi ụlọ dị mma birikwa nʼime ha,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.12",
            "verseOrgIds": [
              "DEU.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "mgbe igwe ehi na igwe atụrụ gị mụbara, mgbe ọlaọcha na ọlaedo gị mụbara, na mgbe ihe niile i nwere mụbara.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.13",
            "verseOrgIds": [
              "DEU.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kpachara anya hụ na nganga abanyeghị gị nʼobi, ime ka i chefuo",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.14",
            "verseOrgIds": [
              "DEU.8.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.8.14",
                "verseOrgIds": [
                  "DEU.8.14"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke gị onye mere ka ị site nʼIjipt, sitekwa nʼala ịbụ ohu pụta.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.14",
            "verseOrgIds": [
              "DEU.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye duuru gị nʼime ọzara ukwu ahụ dị egwu, ebe agwọ ọjọọ na akpị jupụtara, ebe na-ekpo ọkụ, nke mmiri na-adịghị. O sitere na nkume nye gị mmiri ọṅụṅụ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.15",
            "verseOrgIds": [
              "DEU.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "O ji mánà nyejuo gị afọ nʼọzara, mánà ahụ nna gị ha na-amaghị ihe ọ bụ na mbụ. O mere ya nʼihi iweda mmụọ gị ala, na ịnwale gị, ka ihe si otu a gaara gị nke ọma.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.16",
            "verseOrgIds": [
              "DEU.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "I nwere ike kwuo sị, \"Ọ bụ site nʼike aka m ka m ji baa ụba.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.17",
            "verseOrgIds": [
              "DEU.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma cheta",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.18",
            "verseOrgIds": [
              "DEU.8.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.8.18",
                "verseOrgIds": [
                  "DEU.8.18"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke gị, nʼihi na ọ bụ ya onwe ya na-enye gị ike i ji akpata akụ, ime ka ọgbụgba ndụ ya guzosie ike, bụ nke ọ ṅụrụ nna nna gị ha nʼiyi, dịka ọ dị taa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.18",
            "verseOrgIds": [
              "DEU.8.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ọ bụrụ na i chefuo",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.19",
            "verseOrgIds": [
              "DEU.8.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.8.19",
                "verseOrgIds": [
                  "DEU.8.19"
                ]
              }
            }
          ]
        },
        {
          "text": "bụ Chineke gị, gbasoo chi ndị ọzọ, fee ha ofufe ma kpọọkwa isiala nye ha, ana m agba ama megide gị taa na ị ghaghị ịla nʼiyi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.19",
            "verseOrgIds": [
              "DEU.8.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ na unu egeghị ntị nʼolu",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.20",
            "verseOrgIds": [
              "DEU.8.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
