                "verseId": "DEU.14.24",
                "verseOrgIds": [
                  "DEU.14.24"
                ]
              }
            }
          ]
        },
        {
          "text": "họpụtara dị anya, ọ bụrụkwa na",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.24",
            "verseOrgIds": [
              "DEU.14.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.14.24",
                "verseOrgIds": [
                  "DEU.14.24"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke gị agọziela gị ruo na ị pụghị ibu otu ụzọ nʼụzọ iri gị gaa nʼebe ahụ (nʼihi na ebe ahụ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.24",
            "verseOrgIds": [
              "DEU.14.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.14.24",
                "verseOrgIds": [
                  "DEU.14.24"
                ]
              }
            }
          ]
        },
        {
          "text": "họpụtara dị anya),",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.24",
            "verseOrgIds": [
              "DEU.14.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DEU 14:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "mgbe ahụ, gbanwee otu ụzọ nʼụzọ iri nata ọlaọcha, were ọlaọcha ahụ jee nʼebe ahụ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.25",
            "verseOrgIds": [
              "DEU.14.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.14.25",
                "verseOrgIds": [
                  "DEU.14.25"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke gị họpụtara.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.25",
            "verseOrgIds": [
              "DEU.14.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DEU 14:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Were ọlaọcha ahụ zụọ ihe ọbụla ị chọrọ: ehi, na atụrụ, na mmanya, maọbụ mmanya siri ike na-aba nʼanya maọbụ ihe ọbụla ọzọ nke ị chọrọ. Mgbe ahụ, gị na ezinaụlọ gị ga-eri nri nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.26",
            "verseOrgIds": [
              "DEU.14.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.14.26",
                "verseOrgIds": [
                  "DEU.14.26"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke gị, ṅụrịakwa ọṅụ.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.26",
            "verseOrgIds": [
              "DEU.14.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DEU 14:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Echefukwala ime ka ndị Livayị soro gị rie ihe ị kpatara, nʼihi na ha enweghị ihe nketa ọbụla, maọbụ ihe ubi dịka gị.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.27",
            "verseOrgIds": [
              "DEU.14.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
