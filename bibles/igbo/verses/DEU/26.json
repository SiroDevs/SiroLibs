  "verseCount": 19,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "26",
        "style": "c",
        "sid": "DEU 26"
      },
      "items": [
        {
          "text": "26",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Onyinye mkpụrụ mbụ na otu ụzọ nʼụzọ iri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 26:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ị ga-aba nʼala ahụ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.1",
            "verseOrgIds": [
              "DEU.26.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.26.1",
                "verseOrgIds": [
                  "DEU.26.1"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke gị na-enye gị dịka ihe nketa, mgbe ị nwetara ya, birikwa nʼime ya,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.1",
            "verseOrgIds": [
              "DEU.26.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 26:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ị ga-ewere ụfọdụ nʼime mkpụrụ niile si nʼala ahụ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.2",
            "verseOrgIds": [
              "DEU.26.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.26.2",
                "verseOrgIds": [
                  "DEU.26.2"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke gị na-enye gị, tinye ya nʼime nkata, were ya gaa nʼebe ahụ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.2",
            "verseOrgIds": [
              "DEU.26.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.26.2",
                "verseOrgIds": [
                  "DEU.26.2"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke unu ga-ahọpụta, dịka ebe a kpọkwasịrị aha ya.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.2",
            "verseOrgIds": [
              "DEU.26.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 26:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ị ga-agwakwa onye nchụaja nọ nʼọrụ nʼoge ahụ okwu sị: \"Ana m ekwupụta taa nye",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.3",
            "verseOrgIds": [
              "DEU.26.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.26.3",
                "verseOrgIds": [
                  "DEU.26.3"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke gị na abịala m nʼala ahụ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.3",
            "verseOrgIds": [
              "DEU.26.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.26.3",
                "verseOrgIds": [
                  "DEU.26.3"
                ]
              }
            }
          ]
        },
        {
          "text": "ṅụụrụ nna nna anyị ha nʼiyi inye anyị.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.3",
            "verseOrgIds": [
              "DEU.26.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 26:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye nchụaja ahụ ga-anara nkata ahụ, dọba ya nʼihu ebe ịchụ aja",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.4",
            "verseOrgIds": [
              "DEU.26.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.26.4",
                "verseOrgIds": [
                  "DEU.26.4"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke gị.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.4",
            "verseOrgIds": [
              "DEU.26.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 26:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, ị ga-ekwupụta nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.5",
            "verseOrgIds": [
              "DEU.26.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.26.5",
                "verseOrgIds": [
                  "DEU.26.5"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke gị sị, \"Nna nna m bụ onye Aram na-awagharị awagharị, onye jere Ijipt izere ndụ.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.5",
            "verseOrgIds": [
              "DEU.26.5"
            ]
          }
        },
        {
          "text": "Ha dị ole na ole mgbe ha gara Ijipt, ma nʼIjipt ha ghọrọ mba dị ukwuu, ndị dị ike, na ndị bara ụba nʼọnụọgụgụ.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.5",
            "verseOrgIds": [
              "DEU.26.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 26:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ndị Ijipt mejọrọ anyị, mee ka anyị taa ahụhụ nʼihi ọrụ dị ike nke ha bokwasịrị anyị.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.6",
            "verseOrgIds": [
              "DEU.26.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 26:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, anyị tikuru",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.7",
            "verseOrgIds": [
              "DEU.26.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.26.7",
                "verseOrgIds": [
                  "DEU.26.7"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke nna nna anyị.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.7",
            "verseOrgIds": [
              "DEU.26.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.26.7",
                "verseOrgIds": [
                  "DEU.26.7"
                ]
              }
            }
          ]
        },
        {
          "text": "nụrụ olu anyị, hụkwa mmegbu a na-emegbu anyị, na ndọgbu anyị na-adọgbu onwe anyị nʼọrụ, na ọnọdụ ọjọọ anyị.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.7",
            "verseOrgIds": [
              "DEU.26.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 26:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.26.8",
                "verseOrgIds": [
                  "DEU.26.8"
                ]
              }
            }
          ]
        },
        {
          "text": "ji aka dị ike na ogwe aka o setịrị eseti, nʼọtụtụ ihe oke egwu na ọrụ ịrịbama, na ihe ebube, si nʼIjipt kpọpụta anyị.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.8",
            "verseOrgIds": [
              "DEU.26.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 26:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ kpọbatara anyị nʼebe a, nye anyị ala a, ala mmiri ara ehi na mmanụ aṅụ na-eru na ya.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.9",
            "verseOrgIds": [
              "DEU.26.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 26:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, ugbu a,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.10",
            "verseOrgIds": [
              "DEU.26.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.26.10",
                "verseOrgIds": [
                  "DEU.26.10"
                ]
              }
            }
          ]
        },
        {
          "text": ", lee, ewebatala m mkpụrụ mbụ sitere nʼala i nyere m.\" Dọba nkata ahụ nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.10",
            "verseOrgIds": [
              "DEU.26.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.26.10",
                "verseOrgIds": [
                  "DEU.26.10"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke gị, kpọọkwa isiala nye ya nʼebe ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.10",
            "verseOrgIds": [
              "DEU.26.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, gị na ndị Livayị, na ndị mbịarambịa bi nʼetiti unu, ga-aṅụrị ọṅụ nʼihe ọma niile",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.11",
            "verseOrgIds": [
              "DEU.26.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.26.11",
                "verseOrgIds": [
                  "DEU.26.11"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke gị nyere gị na ezinaụlọ gị.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.11",
            "verseOrgIds": [
              "DEU.26.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 26:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼafọ nke atọ ọbụla, ị ga-enye onyinye pụrụ iche, onyinye otu ụzọ nʼụzọ iri, nke ihe ubi gị. Nʼafọ ahụ, ị ga-enye ndị Livayị, na ndị ọbịa, na ụmụ mgbei, na ndị inyom di ha nwụrụ, onyinye otu ụzọ nʼụzọ iri gị, ka ha rie ya nʼobodo gị dị iche iche, ka afọ jukwa ha.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.12",
            "verseOrgIds": [
              "DEU.26.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 26:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ị ga-ekwupụta nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.13",
            "verseOrgIds": [
              "DEU.26.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.26.13",
                "verseOrgIds": [
                  "DEU.26.13"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke gị sị, \"Esitela m nʼụlọ wepụ oke ahụ dị nsọ, nye ha ndị Livayị, na ndị ọbịa, na ụmụ mgbei, na ndị inyom di ha nwụrụ, dịka i nyere m nʼiwu, enupughị m isi maọbụ chefuo iwu gị ọbụla.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.13",
            "verseOrgIds": [
              "DEU.26.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 26:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erighị m ihe ọbụla si nʼime ya mgbe m na-eru ụjụ maọbụ wepụ ihe ọbụla nʼime ya nʼọnọdụ adịghị ọcha m, ọ dịkwaghị nke m ji chụọrọ ndị nwụrụ anwụ aja. Egeela m ntị nʼolu",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.14",
            "verseOrgIds": [
              "DEU.26.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.26.14",
                "verseOrgIds": [
                  "DEU.26.14"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke m, meekwa ihe niile i nyere m nʼiwu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.14",
            "verseOrgIds": [
              "DEU.26.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 26:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Site nʼebe obibi nsọ gị dị nʼeluigwe ledata anya gị, gọzie ndị gị Izrel na ala a i nyere anyị, ala mmiri ara ehi na mmanụ aṅụ na-eru na ya, dịka i kwere nna nna anyị ha na nkwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.15",
            "verseOrgIds": [
              "DEU.26.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ịgbaso iwu",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 26:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
