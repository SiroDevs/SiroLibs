                "verseOrgIds": [
                  "DEU.26.18"
                ]
              }
            }
          ]
        },
        {
          "text": "ekwupụtala na unu bụ ndị nke aka ya, dịka o kwere na nkwa, na ị ga-edebekwa ihe niile o nyere nʼiwu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.18",
            "verseOrgIds": [
              "DEU.26.18"
            ]
          }
        },
        {
