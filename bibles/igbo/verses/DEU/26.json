                "verseOrgIds": [
                  "DEU.26.17"
                ]
              }
            }
          ]
        },
        {
          "text": "bụ Chineke gị, i kweekwala nkwa na ị ga-ege ya ntị, debe iwu ya niile, na ụkpụrụ ya niile, na ị ga-emekwa ihe niile ọ sị gị mee.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.17",
            "verseOrgIds": [
              "DEU.26.17"
            ]
          }
        },
        {
