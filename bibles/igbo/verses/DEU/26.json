          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "I kwupụtala taa na",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.17",
            "verseOrgIds": [
              "DEU.26.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
