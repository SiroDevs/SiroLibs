          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwere ka m gafee hụ ala ọma ahụ dị nʼofe ọzọ nke Jọdan, ala ugwu ugwu ahụ mara mma, na Lebanọn.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.25",
            "verseOrgIds": [
              "DEU.3.25"
            ]
          }
        }
