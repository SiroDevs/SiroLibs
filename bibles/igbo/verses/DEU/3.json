              "type": "text"
            }
          ]
        },
        {
          "text": "Ma nʼihi unu,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.26",
            "verseOrgIds": [
              "DEU.3.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
