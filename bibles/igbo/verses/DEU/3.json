          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaa, rigoruo nʼelu ugwu Pisga, site nʼebe ahụ lepụ anya nʼakụkụ ugwu na ndịda ma nʼakụkụ ọwụwa anyanwụ na ọdịda anyanwụ. Ọ bụ anya gị ka ị ga-eji hụ ala ahụ, nʼihi na ị gaghị agafe osimiri Jọdan.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.27",
            "verseOrgIds": [
              "DEU.3.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DEU 3:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nye Joshua ike ka ọ nọchie ọnọdụ gị. Gbaakwa ya ume,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.28",
            "verseOrgIds": [
              "DEU.3.28"
            ]
          }
        },
        {
          "text": "nʼihi na ọ bụ ya ga-edu ndị a gafee Jọdan iketa ala ahụ niile ị ga-ahụ.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.28",
            "verseOrgIds": [
              "DEU.3.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
