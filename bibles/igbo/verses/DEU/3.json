                "verseId": "DEU.3.26",
                "verseOrgIds": [
                  "DEU.3.26"
                ]
              }
            }
          ]
        },
        {
          "text": "gwara m okwu sị m, \"O zuola! Agwakwala m ihe ọbụla banyere okwu a.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.26",
            "verseOrgIds": [
              "DEU.3.26"
            ]
          }
        },
        {
