          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Onye kachasị ihe niile elu, bụ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.24",
            "verseOrgIds": [
              "DEU.3.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.3.24",
                "verseOrgIds": [
                  "DEU.3.24"
                ]
              }
            }
          ]
        },
        {
          "text": "ị malitela igosi mụ bụ ohu gị ịdị ukwuu gị na ike gị. O nweghị chi ọzọ dị nʼeluigwe maọbụ nʼụwa pụrụ ịrụ ọrụ ebube niile ị rụrụ.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.24",
            "verseOrgIds": [
              "DEU.3.24"
            ]
          }
        },
