          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, anyị nọdụrụ na ndagwurugwu ahụ dị nso na Bet-Peoa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.29",
