                "verseId": "DEU.3.26",
                "verseOrgIds": [
                  "DEU.3.26"
                ]
              }
            }
          ]
        },
        {
          "text": "wesoro m iwe jụ ige m ntị!",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.26",
            "verseOrgIds": [
              "DEU.3.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
