  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "15",
        "style": "c",
        "sid": "DEU 15"
      },
      "items": [
        {
          "text": "15",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Afọ inwere onwe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼọgwụgwụ afọ asaa ọbụla, ị ga-akagbu ụgwọ niile mmadụ ji gị.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.1",
            "verseOrgIds": [
              "DEU.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otu a ka a ga-esi mee ya: Onye ọbụla e ji ụgwọ ga-akagbu ụgwọ niile onye Izrel ibe ya ji ya. Ọ gaghị elekwa anya na onye agbataobi ya maọbụ nwanna ya ga-akwụ ya ụgwọ ahụ, nʼihi na oge a na-ekwusa mgbaghara ụgwọ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.2",
            "verseOrgIds": [
              "DEU.15.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.15.2",
                "verseOrgIds": [
                  "DEU.15.2"
                ]
              }
            }
          ]
        },
        {
          "text": "eruola.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.2",
            "verseOrgIds": [
              "DEU.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbaghara a erughị nʼebe ndị ọbịa nọ,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.3",
            "verseOrgIds": [
              "DEU.15.3"
            ]
          }
        },
        {
          "text": "ma ị ghaghị ịkagbu ụgwọ ọbụla nwanna gị ji gị.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.3",
            "verseOrgIds": [
              "DEU.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otu ọ dị, o kwesighị ka ndị ogbenye dịrị nʼetiti gị, nʼihi nʼala ahụ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.4",
            "verseOrgIds": [
              "DEU.15.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.15.4",
                "verseOrgIds": [
                  "DEU.15.4"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke gị na-enye gị ka inweta dịka ihe nketa gị, ọ ga-agọzi gị nke ukwuu,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.4",
            "verseOrgIds": [
              "DEU.15.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "ma ọ bụrụ na i rube isi nye",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.5",
            "verseOrgIds": [
              "DEU.15.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.15.5",
                "verseOrgIds": [
                  "DEU.15.5"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke gị, ma lezie anya debe iwu ndị a niile m na-enye gị taa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.5",
            "verseOrgIds": [
              "DEU.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.15.6",
                "verseOrgIds": [
                  "DEU.15.6"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke gị ga-agọzi gị dịka o kwere na nkwa. Ị ga-agbazinye ọtụtụ mba ego, ị gaghị anọ nʼụkọ! Ị ga-achị ọtụtụ mba, ma ha agaghị achị gị.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.6",
            "verseOrgIds": [
              "DEU.15.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma mgbe ị banyere nʼala ahụ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.7",
            "verseOrgIds": [
              "DEU.15.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.15.7",
                "verseOrgIds": [
                  "DEU.15.7"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke unu na-enye gị, a sị na e nwee onye ogbenye nʼetiti gị, nke bụ onye Izrel ibe gị, ị gaghị emechi obi gị maọbụ kechie aka gị megide ya,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.7",
            "verseOrgIds": [
              "DEU.15.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "ị ghaghị ịgbazinye ya ihe dị ka o si chọọ.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.8",
            "verseOrgIds": [
              "DEU.15.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lezie anya ka ị ghara inwe ụdị echiche ọjọọ a nʼobi gị sị, \"Afọ mgbaghara ụgwọ na-abịa nso,\" nʼihi ya, i kechie obi gị jụ ibinye nwanna gị nọ na mkpa ihe ọ chọrọ. Ọ bụrụ na onye ahụ nọ na mkpa akwaa akwa kpọkuo",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.9",
            "verseOrgIds": [
              "DEU.15.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.15.9",
                "verseOrgIds": [
                  "DEU.15.9"
                ]
              }
            }
          ]
        },
        {
          "text": ", a ga-agụ gị dịka onye ikpe mmehie mara.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.9",
            "verseOrgIds": [
              "DEU.15.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ị ghaghị inye ha site nʼafọ ofufu, meekwa nke a na-enweghị obi ilu, mgbe ahụ, nʼihi nke a,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.10",
            "verseOrgIds": [
              "DEU.15.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.15.10",
                "verseOrgIds": [
                  "DEU.15.10"
                ]
              }
            }
          ]
        },
        {
          "text": "bụ Chineke gị ga-agọzi gị nʼọrụ gị niile nakwa ihe niile nke ị tinyere aka na ya.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.10",
            "verseOrgIds": [
              "DEU.15.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "A ghaghị inwe ndị ogbenye nʼetiti unu, ọ bụ ya mere iwu a jiri dị mkpa. Gbasapụ aka nʼebe nwanna gị na nʼebe ndị ogbenye na ndị nọ na mkpa nọ.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.11",
            "verseOrgIds": [
              "DEU.15.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mmeso a na-emeso ndị ohu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ na onye Hibru ibe gị, ndị nwoke maọbụ ndị nwanyị, eresi gị onwe ha, gbakwaara gị odibo afọ isii, nʼafọ nke asaa, ị ghaghị ịhapụ ha ka ha nwere onwe ha.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.12",
            "verseOrgIds": [
              "DEU.15.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ọ hapụrụ ụlọ gị, ezipụkwala ya nʼaka efu!",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.13",
            "verseOrgIds": [
              "DEU.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ị ga-esite nʼigwe anụ ụlọ gị, na nʼebe ịzọcha ọka gị, na nʼebe ịzọcha vaịnị gị, nye ya onyinye pụrụ iche iji sị ya laa nʼudo. Nye ya onyinye a dịka",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.14",
            "verseOrgIds": [
              "DEU.15.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.15.14",
                "verseOrgIds": [
                  "DEU.15.14"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke gị si gọzie gị.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.14",
            "verseOrgIds": [
              "DEU.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cheta na ị bụrị ohu nʼala Ijipt ma",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.15",
            "verseOrgIds": [
              "DEU.15.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.15.15",
                "verseOrgIds": [
                  "DEU.15.15"
                ]
              }
            }
          ]
        },
        {
          "text": "bụ Chineke gị gbapụtara gị. Ọ bụ nʼihi ya ka m ji na-enye gị iwu a taa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.15",
            "verseOrgIds": [
              "DEU.15.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ọ bụrụ na ohu gị asị gị, \"Achọghị m ịhapụ gị,\" nʼihi na ọ hụrụ gị na ndị ụlọ gị nʼanya, hụkwa na ihe na-agara gị na ya nke ọma, mgbe gị na ya nọ.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.16",
            "verseOrgIds": [
              "DEU.15.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Were agịga kpọpuo ntị",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.17",
            "verseOrgIds": [
              "DEU.15.17"
            ]
          }
        },
        {
          "text": "ya nʼọnụ ụzọ ụlọ gị. Ọ ga-abụkwara gị ohu ogologo ndụ ya niile. Otu aka ahụ kwa ka ị ga-eme ohu gị nwanyị.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.17",
            "verseOrgIds": [
              "DEU.15.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enwela obi mwute mgbe ọbụla ị na-ahapụ ohu gị ka o nwere onwe ya, nʼihi na ị ga-echeta na ọ rụụrụ gị ọrụ afọ isii, ihe i mefukwara erughị ọkara ihe ị gaara eji goo ndị ọrụ.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.18",
            "verseOrgIds": [
              "DEU.15.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.15.18",
                "verseOrgIds": [
                  "DEU.15.18"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke gị ga-agọzikwa gị nʼihe niile ị na-eme.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.18",
            "verseOrgIds": [
              "DEU.15.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Anụ ụlọ e bụ ụzọ mụọ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwa oke ehi ọbụla maọbụ nwa atụrụ ọbụla maọbụ nwa ewu ọbụla e bụ ụzọ mụọ nʼime igwe anụ ụlọ gị ka ị ga-edo nsọ nye",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.19",
            "verseOrgIds": [
              "DEU.15.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.15.19",
                "verseOrgIds": [
                  "DEU.15.19"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke gị, ejila nwa mbụ nke ehi gị e buru ụzọ mụọ arụ ọrụ ubi, akpachakwala ajị nwa ewu maọbụ nwa atụrụ ọbụla e buru ụzọ mụọ dị nʼime igwe ewu na atụrụ gị.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.19",
            "verseOrgIds": [
              "DEU.15.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gị na ezinaụlọ gị ga-eri anụ ndị a nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.20",
            "verseOrgIds": [
              "DEU.15.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.15.20",
                "verseOrgIds": [
                  "DEU.15.20"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke gị afọ ọbụla nʼebe ọ họpụtara.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.20",
            "verseOrgIds": [
              "DEU.15.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ọ bụrụ na nwa anụ ọbụla e buru ụzọ mụọ nwere nkwarụ, dịka ngwụrọ maọbụ ìsì maọbụ nkwarụ ọbụla nke jọrọ njọ, ị gaghị eji ya achụ aja nye",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.21",
            "verseOrgIds": [
              "DEU.15.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.15.21",
                "verseOrgIds": [
                  "DEU.15.21"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke gị.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.21",
            "verseOrgIds": [
              "DEU.15.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 15:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kama, ka ọ bụrụ ihe oriri nye ezinaụlọ gị nʼime ụlọ gị. Onye ọbụla, ma ndị dị ọcha ma onye rụrụ arụ nʼoge ahụ ga-eri ya, dịka onye ọbụla pụrụ iri anụ ele maọbụ anụ mgbada.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.22",
            "verseOrgIds": [
              "DEU.15.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DEU 15:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma erila ọbara ya. Wụsa ya nʼala dịka mmiri.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.23",
            "verseOrgIds": [
              "DEU.15.23"
            ]
          }
        }
      ]
    }
