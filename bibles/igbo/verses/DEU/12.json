  "verseCount": 32,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "12",
        "style": "c",
        "sid": "DEU 12"
      },
      "items": [
        {
          "text": "12",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ebe a ga-anọ fee Onyenwe anyị",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị a bụ iwu na ụkpụrụ niile unu na-aghaghị idebe ogologo ụbọchị niile unu ga-ebi nʼala ahụ,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.1",
            "verseOrgIds": [
              "DEU.12.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.12.1",
                "verseOrgIds": [
                  "DEU.12.1"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke nna unu ha nyere unu, dịka ihe nweta.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.1",
            "verseOrgIds": [
              "DEU.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tikpọọnụ ebe niile nke dị nʼelu ugwu niile dị elu na nʼelu ugwu niile dị nta, nakwa nʼokpuru osisi mgbasa ọbụla, bụ ebe mba niile unu na-anapụ ala ha fere chi niile ha ofufe.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.2",
            "verseOrgIds": [
              "DEU.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwatuokwanụ ebe ịchụ aja ha niile, tijisie ogidi nsọ ha niile, kpọọkwa osisi Ashera ha ọkụ, gbutukwaanụ arụsị niile a apịrị apị nke chi niile ha. Kpochapụkwanụ aha ha niile site nʼebe niile ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.3",
            "verseOrgIds": [
              "DEU.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unu agaghị efe",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.4",
            "verseOrgIds": [
              "DEU.12.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.12.4",
                "verseOrgIds": [
                  "DEU.12.4"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke unu ofufe dịka ndị ahụ na-efe arụsị na-eme.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.4",
            "verseOrgIds": [
              "DEU.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kama unu chọpụta ebe ahụ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.5",
            "verseOrgIds": [
              "DEU.12.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.12.5",
                "verseOrgIds": [
                  "DEU.12.5"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke unu ga-ahọpụta, site nʼetiti ebo Izrel niile, ebe ọ ga-akpọkwasị aha ya. Nʼebe ahụ ka unu ga-abịakwute ya.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.5",
            "verseOrgIds": [
              "DEU.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụkwa nʼebe ahụ ka unu ga-ewetara",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.6",
            "verseOrgIds": [
              "DEU.12.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.12.6",
                "verseOrgIds": [
                  "DEU.12.6"
                ]
              }
            }
          ]
        },
        {
          "text": "aja nsure ọkụ unu, na aja ndị ọzọ niile, na otu ụzọ nʼụzọ iri unu, na onyinye pụrụ iche unu, bụ onyinye unu kwere nkwa inye, na onyinye afọ ofufu unu, na onyinye ụmụ mbụ igwe ehi, na igwe ewu na atụrụ unu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.6",
            "verseOrgIds": [
              "DEU.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unu na ezinaụlọ unu ga-anọkwa nʼebe ahụ, nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.7",
            "verseOrgIds": [
              "DEU.12.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.12.7",
                "verseOrgIds": [
                  "DEU.12.7"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke unu, rie oriri unu. Nʼihu ya kwa ka unu ga-aṅụrịkwa ọṅụ, nʼihi ihe niile ahụ unu setịpụrụ aka unu ime, na nʼihi ngọzị",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.7",
            "verseOrgIds": [
              "DEU.12.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.12.7",
                "verseOrgIds": [
                  "DEU.12.7"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke unu gọziri unu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.7",
            "verseOrgIds": [
              "DEU.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unu agaghị emekwa ihe masịrị unu, dịka unu si eme taa, nʼihi na onye ọbụla na-eme ihe ọbụla o chere na o ziri ezi nʼanya ya,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.8",
            "verseOrgIds": [
              "DEU.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "nʼihi na iwu ndị a ebidobeghị ịdị ire, ebe ọ bụ na unu abanyebeghị nʼebe izuike ahụ, na ihe nketa ahụ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.9",
            "verseOrgIds": [
              "DEU.12.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.12.9",
                "verseOrgIds": [
                  "DEU.12.9"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke unu na-enye unu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.9",
            "verseOrgIds": [
              "DEU.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kama, mgbe unu gafere osimiri Jọdan, birikwa nʼala ahụ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.10",
            "verseOrgIds": [
              "DEU.12.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.12.10",
                "verseOrgIds": [
                  "DEU.12.10"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke unu na-enye unu dịka ihe nketa, mgbe",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.10",
            "verseOrgIds": [
              "DEU.12.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.12.10",
                "verseOrgIds": [
                  "DEU.12.10"
                ]
              }
            }
          ]
        },
        {
          "text": "nyere unu izuike, meekwa ka unu nwere onwe unu site nʼebe ndị iro unu nọ.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.10",
            "verseOrgIds": [
              "DEU.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, unu ga-eweta ihe ndị ahụ niile m nyere unu nʼiwu: aja nsure ọkụ unu niile, na aja ndị ọzọ, na onyinye ahụ pụrụ iche unu kwere nkwa inye, unu ga-eweta ya nʼebe ahụ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.11",
            "verseOrgIds": [
              "DEU.12.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.12.11",
                "verseOrgIds": [
                  "DEU.12.11"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke unu họpụtara ebe o kpọkwasịrị aha ya.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.11",
            "verseOrgIds": [
              "DEU.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unu na ụmụ unu ndị ikom, na ụmụ unu ndị inyom, na ndị odibo nwoke na nwanyị niile unu, na ndị Livayị bi nʼobodo unu, ndị na-enweghị ihe nketa nke aka ha, ga-anọ nʼebe ahụ ṅụrịa ọṅụ nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.12",
            "verseOrgIds": [
              "DEU.12.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.12.12",
                "verseOrgIds": [
                  "DEU.12.12"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke unu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.12",
            "verseOrgIds": [
              "DEU.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ị gaghị achụ aja nsure ọkụ gị nʼebe ọbụla masịrị gị,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.13",
            "verseOrgIds": [
              "DEU.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "ọ bụ naanị nʼebe ahụ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.14",
            "verseOrgIds": [
              "DEU.12.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.12.14",
                "verseOrgIds": [
                  "DEU.12.14"
                ]
              }
            }
          ]
        },
        {
          "text": "ga-ahọpụta. Ọ ga-ahọpụta otu ebe, nʼala otu ebo. Ọ bụ naanị nʼebe ahụ ka ị ga-esure aja unu niile, ọ bụkwa nʼebe ahụ ka ị ga-eweta onyinye gị niile.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.14",
            "verseOrgIds": [
              "DEU.12.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otu ọ dị, ị pụrụ ịnọ nʼebe ọbụla gbuo anụ ị ga-eri, dịka ọ bụ ele maọbụ mgbada ugbu a. Rie anụ mgbe ọbụla ọ gụrụ gị agụụ, na-erikwa ya mgbe ọbụla i nwetara ya, dịka ngọzị",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.15",
            "verseOrgIds": [
              "DEU.12.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.12.15",
                "verseOrgIds": [
                  "DEU.12.15"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke unu na-enye unu. Ma onye dị ọcha, ma onye na-adịghị ọcha nwere ike iso rie ya.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.15",
            "verseOrgIds": [
              "DEU.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naanị iwu dị nʼiri anụ ndị a bụ na ị gaghị eri ọbara ya, wụsa ọbara ya nʼala, dịka mmiri.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.16",
            "verseOrgIds": [
              "DEU.12.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma o nweghị onyinye ọbụla a na-enye",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.17",
            "verseOrgIds": [
              "DEU.12.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.12.17",
                "verseOrgIds": [
                  "DEU.12.17"
                ]
              }
            }
          ]
        },
        {
          "text": "i kwesiri ịnọ nʼụlọ gị rie. I kwesighị ịnọ nʼụlọ gị rie onyinye ndị a: onyinye otu ụzọ nʼụzọ iri nke ọka na mmanya ọhụrụ gị, na nke mmanụ oliv, na ụmụ mbụ nke igwe ehi na igwe ewu na atụrụ gị, na ihe ọbụla i kwere na nkwa, na onyinye afọ ofufu gị, na onyinye ndị ọzọ pụrụ iche.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.17",
            "verseOrgIds": [
              "DEU.12.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 12:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kama unu ga-eri ha nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.18",
            "verseOrgIds": [
              "DEU.12.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.12.18",
                "verseOrgIds": [
                  "DEU.12.18"
                ]
              }
            }
          ]
        },
        {
          "text": "bụ Chineke unu, nʼebe ahụ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.18",
            "verseOrgIds": [
              "DEU.12.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.12.18",
                "verseOrgIds": [
                  "DEU.12.18"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke unu ga-ahọpụta, gị onwe gị, na ụmụ gị ndị nwoke na ụmụ gị ndị nwanyị, na ndị odibo nwoke na nwanyị niile unu, na ndị Livayị si nʼobodo unu niile, unu ga-aṅụrịkwa ọṅụ nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.18",
            "verseOrgIds": [
              "DEU.12.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.12.18",
                "verseOrgIds": [
                  "DEU.12.18"
                ]
              }
            }
          ]
        },
        {
          "text": "bụ Chineke unu, nʼihe niile aka gị rụpụtara.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.18",
            "verseOrgIds": [
              "DEU.12.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 12:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Echefukwala ndị Livayị, gị na ha ga na-enwekọ ihe ndị a niile, ogologo ụbọchị niile i biri nʼala ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.19",
            "verseOrgIds": [
              "DEU.12.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 12:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.20",
            "verseOrgIds": [
              "DEU.12.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.12.20",
                "verseOrgIds": [
                  "DEU.12.20"
                ]
              }
            }
          ]
        },
        {
          "text": ", bụ Chineke gị mere ka oke ala gị saa mbara, dịka o kwere gị na nkwa, i nwee oke agụụ maka iri anụ na-asị, \"Achọrọ m iri anụ,\" mgbe ahụ, i nwere ike rie anụ dịka i si chọọ.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.20",
            "verseOrgIds": [
              "DEU.12.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 12:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ nʼebe ahụ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.21",
            "verseOrgIds": [
              "DEU.12.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.12.21",
                "verseOrgIds": [
                  "DEU.12.21"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke gị kpọkwasịrị aha ya dị gị anya site nʼebe i nọ, i nwere ike gbuo anụ ụlọ site nʼigwe ehi maọbụ ewu na atụrụ nke",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.21",
            "verseOrgIds": [
              "DEU.12.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.12.21",
                "verseOrgIds": [
                  "DEU.12.21"
                ]
              }
            }
          ]
        },
        {
          "text": "nyere gị, dịka m si nye gị nʼiwu. Gbuo ha nʼobodo ebe i bi, riekwa ha otu ị chọrọ.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.21",
            "verseOrgIds": [
              "DEU.12.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 12:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rie ha dịka ị ga-esi rie ele maọbụ mgbada. Onye ọbụla nʼime unu nwere ike rie ya, ma onye dị ọcha ma onye na-adịghị ọcha.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.22",
            "verseOrgIds": [
              "DEU.12.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DEU 12:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma lezie anya hụ na i righị ọbara, nʼihi na ndụ dị nʼọbara. Ị gaghị erikọta anụ ọbụla na ndụ ya.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.23",
            "verseOrgIds": [
              "DEU.12.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 12:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erila ọbara, wụsa ya nʼala dịka mmiri.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.24",
            "verseOrgIds": [
              "DEU.12.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DEU 12:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erila ya, ka ihe si otu a gaara gị na ụmụ ụmụ gị nke ọma, nʼihi na ị na-eme ihe ziri ezi nʼanya",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.25",
            "verseOrgIds": [
              "DEU.12.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.12.25",
                "verseOrgIds": [
                  "DEU.12.25"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.25",
            "verseOrgIds": [
              "DEU.12.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DEU 12:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma were ihe ndị ahụ niile i doro nsọ, ya na ihe ọbụla i kwere",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.26",
            "verseOrgIds": [
              "DEU.12.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.12.26",
                "verseOrgIds": [
                  "DEU.12.26"
                ]
              }
            }
          ]
        },
        {
          "text": "na nkwa gaa nʼebe ahụ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.26",
            "verseOrgIds": [
              "DEU.12.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.12.26",
                "verseOrgIds": [
                  "DEU.12.26"
                ]
              }
            }
          ]
        },
        {
          "text": "ga-ahọpụta.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.26",
            "verseOrgIds": [
              "DEU.12.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DEU 12:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chụọ aja nsure ọkụ nʼelu ebe ịchụ aja",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.27",
            "verseOrgIds": [
              "DEU.12.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.12.27",
                "verseOrgIds": [
                  "DEU.12.27"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke gị, ma anụ na ọbara. A ghaghị ịwụsa ọbara anụ ahụ e ji chụọ aja nʼakụkụ ebe nchụaja nke",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.27",
            "verseOrgIds": [
              "DEU.12.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.12.27",
                "verseOrgIds": [
                  "DEU.12.27"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke gị. Ma i nwere ike rie anụ ahụ e ji chụọ aja.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.27",
            "verseOrgIds": [
              "DEU.12.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DEU 12:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lezie anya, debe iwu ndị a niile m na-enye gị. Ọ bụrụ na i mee ya, ihe ga-agara gị na ụmụ gị nke ọma, nʼihi na ọ bụ ihe dị mma nʼanya",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.28",
            "verseOrgIds": [
              "DEU.12.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.12.28",
                "verseOrgIds": [
                  "DEU.12.28"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke gị, na ihe ziri ezi ka ị ga na-eme.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.28",
            "verseOrgIds": [
              "DEU.12.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DEU 12:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.12.29",
                "verseOrgIds": [
                  "DEU.12.29"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke gị ga-ala mba niile bi nʼala ahụ ị na-aga ibuso agha nʼiyi. Ma mgbe i si nʼala ahụ chụpụ ha, ị ga-ebichi nʼala ha.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.29",
            "verseOrgIds": [
              "DEU.12.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "DEU 12:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ị lachara ha nʼiyi, lezie anya ka ị ghara ịma nʼọnya, site nʼịjụ ajụjụ ka ịjụpụta otu ha si efe chi ha, na-asị, \"Mba ndị a o si aṅaa na-efe chi ha ofufe? Anyị ga-emekwa otu a.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.30",
            "verseOrgIds": [
              "DEU.12.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "DEU 12:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Efekwala",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.31",
            "verseOrgIds": [
              "DEU.12.31"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.12.31",
                "verseOrgIds": [
                  "DEU.12.31"
                ]
              }
            }
          ]
        },
        {
          "text": "bụ Chineke gị dịka ha si efe chi ha, nʼihi na mgbe ha na-efe chi ha ofufe, ha na-eme ihe arụ dị iche iche nke",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.31",
            "verseOrgIds": [
              "DEU.12.31"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.12.31",
                "verseOrgIds": [
                  "DEU.12.31"
                ]
              }
            }
          ]
        },
        {
          "text": "kpọrọ asị. Ọ bụladị ụmụ ha ndị ikom na ndị inyom ka ha na-esure nʼọkụ nye chi ha dị iche iche dịka aja.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.31",
            "verseOrgIds": [
              "DEU.12.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "DEU 12:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lezienụ anya hụ na unu na-eme ihe niile bụ nke m nyere unu nʼiwu. Unu etinyela ihe nʼime ya maọbụ wepụkwa ihe site na ya.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.32",
            "verseOrgIds": [
              "DEU.13.1"
            ]
          }
        }
      ]
    }
  ],
