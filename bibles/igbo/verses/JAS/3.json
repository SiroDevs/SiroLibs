  "verseCount": 18,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "3",
        "style": "c",
        "sid": "JAS 3"
      },
      "items": [
        {
          "text": "3",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ịzụ ire anyị",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JAS 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụmụnna m, ka ọtụtụ nʼime unu hapụ ịgbalị ịbụ ndị ozizi, nʼihi na unu maara na anyị bụ ndị ozizi ka a ga-ekpe ikpe nʼọnọdụ sikarịrị ike.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.3.1",
            "verseOrgIds": [
              "JAS.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JAS 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na anyị niile na-asọ ngọngọ site nʼọtụtụ ụzọ. Ma onye ọbụla nke na-adịghị emehie site nʼikwuhie ọnụ bụ onye tozuru oke na onye pụrụ ijide anụ ahụ ya niile aka.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.3.2",
            "verseOrgIds": [
              "JAS.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JAS 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ na anyị e tinye mkpụmkpụ igwe e ji ekechi ọnụ ịnyịnya ibu nʼọnụ ya, ka o rubere anyị isi, anyị na-eduru ya gaa ebe anyị chọrọ.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.3.3",
            "verseOrgIds": [
              "JAS.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JAS 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otu a kwa, ọ bụladị ụgbọ mmiri buru ibu nke ikuku dị ike na-ebugharị nʼosimiri, ka onye na-anya ụgbọ mmiri pụrụ ime ka ọ gaa ebe ọ chọrọ site nʼịtụgharịa ụmara ntakịrị e ji anya ụgbọ.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.3.4",
            "verseOrgIds": [
              "JAS.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JAS 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otu a ka ọ dịkwa ire anyị. Ọ bụ akụkụ anụ ahụ anyị dị nta, ma ọ na-anya isi banyere ọtụtụ ihe. Tulee otu oke ọhịa si dị ukwuu, bụ nke icheku ọkụ dịkarịsịrị nta na-eme ka o nwuru ọkụ.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.3.5",
            "verseOrgIds": [
              "JAS.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JAS 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ire anyị bụ ọkụ. E debere ire nʼetiti akụkụ anụ ahụ ndị ọzọ dịka ụwa ajọ omume. Ọ na-emerụ ahụ niile, na-amụnye ọkụ nʼusoro ndụ mmadụ. Ya onwe ya bụkwa ihe ọkụ ala mmụọ na-amụnye ọkụ.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.3.6",
            "verseOrgIds": [
              "JAS.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JAS 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mmadụ enweela ike zụọ, na-agbalịkwa ịzụ anụmanụ dị iche iche, na nnụnụ, na anụ na-akpụ akpụ, na anụ bi na mmiri;",
          "type": "text",
          "attrs": {
            "verseId": "JAS.3.7",
            "verseOrgIds": [
              "JAS.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JAS 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "ma mmadụ ọbụla adịghị nke nwere ike ịzụ ire. Ọ bụ ihe dị oke njọ na-adịghị ekwe nchịkọta, ma jupụtakwa na nsi na-ebute ọnwụ.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.3.8",
            "verseOrgIds": [
              "JAS.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JAS 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ ya ka anyị ji eto Onyenwe anyị na Nna anyị. Ọ bụkwa ya ka anyị ji abụ mmadụ ibe anyị ọnụ, bụ ndị Chineke mere nʼoyiyi nke ya.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.3.9",
            "verseOrgIds": [
              "JAS.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JAS 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Site nʼotu ọnụ anyị ka ịja mma na ịbụ ọnụ na-esi apụta. Ụmụnna m, nke a abụghị ihe ziri ezi.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.3.10",
            "verseOrgIds": [
              "JAS.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JAS 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ ihe pụrụ ime na mmiri dị mma ịṅụ aṅụ na mmiri nnu ga-esite nʼotu isi iyi ahụ na-asọpụta?",
          "type": "text",
          "attrs": {
            "verseId": "JAS.3.11",
            "verseOrgIds": [
              "JAS.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JAS 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụmụnna m, osisi fiig ọ pụrụ ịmị oliv, ka osisi grepu ọ pụrụ ịmịpụta fiig? Nʼụzọ dị otu a, anyị makwaara na mmiri nnu apụghịkwa ịsọpụta mmiri dị mma ọṅụṅụ.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.3.12",
            "verseOrgIds": [
              "JAS.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ụdị amamihe abụọ dị",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JAS 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ dị onye ọbụla nʼime unu na-agụ onwe ya dị ka onye maara ihe na onye nwere nghọta? Ya gosi amamihe ya na nghọta ya site nʼibi ezi ndụ na ịrụ ọrụ ọma site nʼobi dị umeala.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.3.13",
            "verseOrgIds": [
              "JAS.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JAS 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ọ bụrụ na obi unu ejupụta nʼihe ilu na ekworo na ịchọ naanị ihe nke onwe unu, mgbe ahụ, unu ekwesighị ịnya isi sị otu a na-agọnarị eziokwu.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.3.14",
            "verseOrgIds": [
              "JAS.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JAS 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụdị amamihe dị otu ahụ esiteghị nʼeluigwe bịa. Ọ bụ amamihe nke ụwa. Ọ bụghị nke mmụọ nsọ. Ọ bụ nke mmụọ ọjọọ.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.3.15",
            "verseOrgIds": [
              "JAS.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JAS 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi nʼebe ọbụla obi ilu na ekworo dị, ebe ahụ ka ọgbaaghara na omume ọjọọ niile dị.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.3.16",
            "verseOrgIds": [
              "JAS.3.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JAS 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma amamihe na-esite nʼeluigwe abịa bụrụ ụzọ dị ọcha, emesịa, ọ hụrụ udo nʼanya, ọ na-eme obiọma, o jupụtara nʼebere, na-ewepụtakwa ọrụ ọma. Ihu abụọ na obi abụọ adịghịkwa nʼime ya.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.3.17",
            "verseOrgIds": [
              "JAS.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JAS 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ndị ahụ bụ ndị na-eme udo bụ ndị na-agha mkpụrụ udo. Ha ga-aghọta mkpụrụ ezi omume.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.3.18",
            "verseOrgIds": [
              "JAS.3.18"
            ]
          }
        }
      ]
    }
  ],
