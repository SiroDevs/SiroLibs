  "verseCount": 40,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "21",
        "style": "c",
        "sid": "ACT 21"
      },
      "items": [
        {
          "text": "21",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Pọl agaa Jerusalem",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 21:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe anyị hapụsịrị ha, anyị nyapụrụ ụgbọ anyị bịaruo Kos. Nʼechi ya, anyị rutere Rods. Anyị sitere nʼebe ahụ jeruo Patara.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.1",
            "verseOrgIds": [
              "ACT.21.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe anyị hụrụ ụgbọ mmiri na-aga Fonisia, anyị banyere nʼime ya kwọpụ.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.2",
            "verseOrgIds": [
              "ACT.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe anyị kwọruru ụgbọ anyị ebe anyị nwere ike ịhụ Saiprọs, anyị siri nʼaka ekpe ya gafee, ruo Siria. Anyị rutere nʼọnụ mmiri Taịa, ebe ụgbọ mmiri ga-akwapụ ibu dị nʼime ya.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.3",
            "verseOrgIds": [
              "ACT.21.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe anyị chọtara ndị na-eso ụzọ ahụ, anyị nọnyere ha abalị asaa. Ha gwara Pọl site nʼike nke Mmụọ Nsọ, ka ọ ghara ịga Jerusalem.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.4",
            "verseOrgIds": [
              "ACT.21.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe anyị nọzuru ụbọchị anyị, anyị hapụrụ ha, bilie ije. Ha na nwunye ha na ụmụ ha so dupu ruo mgbe anyị si nʼobodo ahụ pụọ. Anyị na ha gburu ikpere nʼala nʼọnụ mmiri kpee ekpere.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.5",
            "verseOrgIds": [
              "ACT.21.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, anyị kelere onwe anyị ekele ikpeazụ. Emesịa, anyị banyere nʼime ụgbọ, ma ha laghachiri azụ nʼụlọ ha.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.6",
            "verseOrgIds": [
              "ACT.21.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe anyị hapụrụ Taịa, anyị kwụsịrị na Tolomas. Nʼebe a anyị kelekwara ndị kwere ekwe nọ nʼime obodo a, nọnyere ha naanị otu ụbọchị.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.7",
            "verseOrgIds": [
              "ACT.21.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼụbọchị nke ọzọ ya, anyị gara nʼihu nʼije anyị rute Sizaria. Nʼebe ahụ, anyị nọnyeere otu nwanna anyị a na-akpọ Filip onye na-agbasa oziọma. Ọ bụ otu nʼime mmadụ asaa ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.8",
            "verseOrgIds": [
              "ACT.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "O nwere ụmụ agbọghọ anọ ndị na-alụbeghị di. Ha nwekwara onyinye ibu amụma.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.9",
            "verseOrgIds": [
              "ACT.21.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe anyị nọrọ ọtụtụ ụbọchị nʼebe ahụ, ka otu onye amụma a na-akpọ Agabọs, si Judịa bata.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.10",
            "verseOrgIds": [
              "ACT.21.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bịakwutere anyị, chilite belịt Pọl na-eke nʼukwu, kee onwe ya nʼụkwụ na aka sị, \"Dịka Mmụọ Nsọ kwuru, 'otu a ka ndị ndu ndị Juu ga-eke onye nwe ihe a agbụ na Jerusalem. Ha ga-ararakwa ya nye nʼaka ndị mba ọzọ.' \"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.11",
            "verseOrgIds": [
              "ACT.21.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe anyị nụrụ nke a, anyị na ndị niile nọ nʼebe ahụ rịọrọ Pọl ka ọ ghara ịga Jerusalem.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.12",
            "verseOrgIds": [
              "ACT.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Pọl zaghachiri, \"Gịnị ka unu na-eme, ọ bụ akwa ka unu na-ebe, na-eme ka obi gbawaa m? Nʼihi na ọ bụghị naanị na m dị njikere ka e kee m agbụ, kama ejikekwara m iwere ndụ m nye na Jerusalem nʼihi aha Onyenwe anyị Jisọs.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.13",
            "verseOrgIds": [
              "ACT.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebe ọ na-ekweghị ege anyị ntị, anyị kwụsịrị ma sị, \"Ka e mee uche Onyenwe anyị.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.14",
            "verseOrgIds": [
              "ACT.21.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ụbọchị ndị a gasịrị, anyị jikere bilie ịga Jerusalem.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.15",
            "verseOrgIds": [
              "ACT.21.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụfọdụ ndị na-eso ụzọ ahụ ndị nọ na Sizaria, duuru anyị gaa, ha kpọruru anyị nʼụlọ Mnasin, onye Saiprọs ebe anyị ga-anọ dịka ọbịa, onye sitere na mbụ bụrụ onye na-eso ụzọ ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.16",
            "verseOrgIds": [
              "ACT.21.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Pọl erute Jerusalem",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe anyị rutere Jerusalem, ndị ụmụnna jiri obi ụtọ nabata anyị.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.17",
            "verseOrgIds": [
              "ACT.21.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 21:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼụbọchị nke so ya, anyị na Pọl gara ileta Jemis, ndị okenye niile nọkwa nʼebe ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.18",
            "verseOrgIds": [
              "ACT.21.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe o kelechara ha, ọ kọọrọ ha nʼotu nʼotu, ihe niile Chineke rụrụ nʼetiti ndị mba ọzọ site nʼije ozi ya.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.19",
            "verseOrgIds": [
              "ACT.21.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 21:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ha nụchara nke a, ha nyere Chineke otuto. Emesịa, ha sịrị Pọl, \"Leenụ nwanna, otu ọtụtụ puku ndị Juu si bụrụ ndị kwere ekwe, ha niile ka ihe banyere iwu a na-anụ ọkụ nʼobi.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.20",
            "verseOrgIds": [
              "ACT.21.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "A kọọrọla ha ihe banyere gị, na ị na-ezi ndị Juu bi nʼetiti ndị mba ọzọ ka ha hapụ ịgbasokwa iwu Mosis, na ka ha kwụsịkwa ibi ụmụ ha ugwu maọbụ bie ndụ nʼusoro omenaala anyị.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.21",
            "verseOrgIds": [
              "ACT.21.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 21:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gịnị ka anyị ga-eme ugbu a? O doro anya na ha ga-amata na ị bịara nʼebe a.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.22",
            "verseOrgIds": [
              "ACT.21.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 21:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya bụ, jisie ike mee ihe anyị ga-agwa gị ugbu a. Anyị nwere mmadụ anọ nʼebe a, ndị nọ na nkwa ha kwere Chineke.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.23",
            "verseOrgIds": [
              "ACT.21.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 21:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Soro ha mee omenaala ahụ nke ndị nọ na nkwa ji edo onwe ha ọcha. Kwụọrọ ha ụgwọ maka ịkpụcha isi ha. I mee otu a, mmadụ niile ga-amata na eziokwu adịghị nʼihe ndị a niile e kwuru maka gị, kama na gị onwe gị na-agazi ma na-edebekwa iwu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.24",
            "verseOrgIds": [
              "ACT.21.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 21:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma nʼebe ndị mba ọzọ kwere ekwe nọ, anyị edegarala ha akwụkwọ gwa ha kwụsị iri ihe ọbụla a chụrụ nʼaja nye arụsị, na iri ọbara, maọbụ anụ a nyagburu anyagbu, ya na ịkwa iko.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.25",
            "verseOrgIds": [
              "ACT.21.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 21:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pọl kpọọrọ ndị ikom anọ ndị ahụ tinyere onwe ya, nʼụbọchị so ya mee ka ya na ha dị ọcha. Mgbe ahụ, ọ banyere nʼụlọnsọ ukwu ahụ, maka ikwupụta ụbọchị ole mmemme ịdị ọcha ahụ ga-anọ tupu e mechaa ya, nakwa mgbe ịchụ aja nʼihi ha nʼotu nʼotu ga-abụ.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.26",
            "verseOrgIds": [
              "ACT.21.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Njide e jidere Pọl",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ACT 21:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma mgbe ọ fọdụrụ nwa oge nta ka ụbọchị asaa ahụ gwụchaa, ụfọdụ ndị Juu si Eshịa bịa hụrụ ya nʼụlọnsọ ukwu ahụ. Ha tikuru igwe mmadụ ma kpaliekwa ha. Ha jidere ya,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.27",
            "verseOrgIds": [
              "ACT.21.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 21:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "na-eti mkpu, \"Ndị ikom Izrel, nyerenụ anyị aka! Onye a bụ nwoke ahụ na-ejegharị nʼebe niile na-ezi ozizi megidere ndị nke anyị, iwu anyị nakwa ebe a. Ma nke kachasị nke, ọ merụọkwala ụlọnsọ a site nʼịkpọbata ndị Griik nʼime ya.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.28",
            "verseOrgIds": [
              "ACT.21.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ACT 21:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Nʼihi na ha ebula ụzọ hụ ya na Trofimọs onye Efesọs nʼime obodo, ha chere na Pọl kpọbatara ya nʼụlọnsọ ukwu ahụ.)",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.29",
            "verseOrgIds": [
              "ACT.21.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ACT 21:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọgbaaghara jupụtara nʼobodo ahụ niile. Ndị mmadụ gbakọtara dọkpụpụta Pọl site nʼụlọnsọ ukwu ahụ. Nʼotu mgbe ahụ, e mechiri ọnụ ụzọ niile.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.30",
            "verseOrgIds": [
              "ACT.21.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ACT 21:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ha na-achọ igbu ya, ozi ruru ọchịagha ntị na Jerusalem niile nọ nʼọgbaaghara.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.31",
            "verseOrgIds": [
              "ACT.21.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ACT 21:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otu mgbe ahụ o duuru ụfọdụ ndịisi agha ya na ndị agha ya mee ngwangwa bịaruo nʼebe ha nọ. Mgbe ha hụrụ ndị agha ka ha na-abịa, ha kwụsịrị iti Pọl ihe.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.32",
            "verseOrgIds": [
              "ACT.21.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ACT 21:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọchịagha ahụ bịara jide ya, nye iwu ka e were ụdọ igwe abụọ kee ya agbụ, ọ jụkwara onye ọ bụ na ihe o mere.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.33",
            "verseOrgIds": [
              "ACT.21.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "ACT 21:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụfọdụ nʼime igwe mmadụ ahụ na-eti mkpu na-ekwu otu ihe, ebe ụfọdụ na-eti na-ekwu ihe ọzọ. Mgbe ọ na-apụghị ịchọpụta ihe bụ isi mkpọtụ na ọgbaaghara ahụ, o nyere iwu ka e duru ya gaa nʼogige ndị agha.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.34",
            "verseOrgIds": [
              "ACT.21.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "ACT 21:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe o rutere na mgbagolite ọnụ ụzọ ụlọ ahụ, ndị agha bulitere ya elu nʼihi ọgbaaghara igwe ndị mmadụ dị ukwuu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.35",
            "verseOrgIds": [
              "ACT.21.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "ACT 21:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igwe mmadụ ahụ so ha nọ na-eti mkpu, \"Wepụnụ ya! Wepụnụ ya!\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.36",
            "verseOrgIds": [
              "ACT.21.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Pọl agọrọ onwe ya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "ACT 21:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ha chọrọ iduba Pọl nʼime ogige ahụ, ọ sịrị ọchịagha ahụ, \"Ị ga-ekwe ka m gwa gị okwu?\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.37",
            "verseOrgIds": [
              "ACT.21.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "ACT 21:37"
      },
      "items": [
        {
          "text": "Ọ sịrị, \"I maara asụ asụsụ ndị Griik?",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.37",
            "verseOrgIds": [
              "ACT.21.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "ACT 21:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ pụtara na ị bụghị onye Ijipt ahụ malitere ọgbaaghara ma duuru puku ndị ogbu mmadụ anọ gbalaa nʼọzara?\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.38",
            "verseOrgIds": [
              "ACT.21.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "ACT 21:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pọl sịrị, \"Abụ m onye Juu si Tasọs, obodo dị na Silisia, nwa afọ oke obodo amara aha ya. Biko, kwee ka m gwa ndị mmadụ okwu.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.39",
            "verseOrgIds": [
              "ACT.21.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "ACT 21:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe o nyere ya ikike, Pọl guzooro nʼihe nrigo nke ọnụ ụzọ ahụ fee aka ya ime ka ha nọọ duu. Mgbe ha nọdụrụ nwayọọ, ọ gwara ha okwu nʼasụsụ Hibru",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.40",
            "verseOrgIds": [
              "ACT.21.40"
            ]
          }
        },
        {
          "text": "sị,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.40",
            "verseOrgIds": [
              "ACT.21.40"
            ]
          }
        }
      ]
    }
  ],
