  "verseCount": 27,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "24",
        "style": "c",
        "sid": "ACT 24"
      },
      "items": [
        {
          "text": "24",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ebubo ndị Juu boro Pọl nʼihu Feliks",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 24:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ụbọchị ise gasịrị, onyeisi nchụaja bụ Ananayas na ụfọdụ ndị okenye ndị Juu na lọya ha aha ya bụ Tatulọs bịara. Ha dum pụtara ịgbagide Pọl ama nʼihu onye na-achị obodo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.24.1",
            "verseOrgIds": [
              "ACT.24.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe a kpọbatara ya, Tatulọs pụtara guzo boo ya ebubo sị, \"Onye a na-asọpụrụ ka ị bụ. Nʼihi gị, mmadụ niile enwela udo ogologo mgbe. Ịdị nkọ nke uche gị emeela ka mgbanwe dị nʼobodo a.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.24.2",
            "verseOrgIds": [
              "ACT.24.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyị ji ekele nke jupụtara nʼọṅụ na-anabata ihe ndị a nke ọma, nʼebe niile na nʼụzọ niile, gị Feliks, onye a na-asọpụrụ.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.24.3",
            "verseOrgIds": [
              "ACT.24.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Achọghị m itufu oge gị. Ana m arịọ ka i were ndidi na obiọma nụrụ nkenke okwu anyị ji bịa.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.24.4",
            "verseOrgIds": [
              "ACT.24.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Anyị chọpụtara na nwoke a bụ onye na-akpalikarị ọgbaaghara, onye ọrụ ya bụ ịkwagide ndị Juu nọ nʼebe niile nʼụwa a ka ha nupu isi. Ọ bụkwa onyeisi nke ajọ otu ahụ a na-akpọ Otu ndị Nazaret.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.24.5",
            "verseOrgIds": [
              "ACT.24.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 24:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ chọkwara imerụ ụlọnsọ anyị, ya mere anyị ji jide ya. Ma anyị chọrọ ikpe ya ikpe dịka omenaala anyị siri dị,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.24.6",
            "verseOrgIds": [
              "ACT.24.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "ọchịagha Lisias, bịara jiri ike napụ ya nʼaka anyị.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.24.7",
            "verseOrgIds": [
              "ACT.24.7"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "ACT.24.7",
            "verseOrgIds": [
              "ACT.24.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 24:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ na inyochaa ya, ị ga-enwe ike ịghọta ihe niile banyere ebubo anyị na-ebo ya.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.24.8",
            "verseOrgIds": [
              "ACT.24.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị Juu kwadokwara okwu ya, na ihe niile e boro ya, bụ ihe mere eme.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.24.9",
            "verseOrgIds": [
              "ACT.24.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 24:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe gọvanọ feere ya aka ka o kwuo okwu, Pọl zara, \"amaara m na ị bụ onye ọkaikpe nke mba a ogologo mgbe. Nke a na-enye m obi ụtọ ịgọpụ onwe m nʼihu gị.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.24.10",
            "verseOrgIds": [
              "ACT.24.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 24:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ị pụrụ ịchọpụta na o rubeghị ụbọchị iri na abụọ kemgbe m rigooro nʼụlọnsọ ukwu na Jerusalem ife ofufe.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.24.11",
            "verseOrgIds": [
              "ACT.24.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 24:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha ahụghị m ka mụ na onye ọbụla na-arụrịta ụka nʼụlọnsọ, maọbụ na o nwere ebe m kpatara ọgbaaghara nʼime ụlọ nzukọ, maọbụ ebe ọbụla nʼime obodo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.24.12",
            "verseOrgIds": [
              "ACT.24.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 24:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha enwekwaghị ihe ọbụla ha ga-eji kwagide ama ha na-agba megide m.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.24.13",
            "verseOrgIds": [
              "ACT.24.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 24:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agaghị m agọ agọ nʼihu gị na m na-ekpere Chineke nke nna anyị ha, dịka onye na-eso Ụzọ ahụ ha na-akpọ otu. Ekwenyere m ihe niile dịka usoro nke iwu si dị, na nke e dere nʼakwụkwọ ndị amụma.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.24.14",
            "verseOrgIds": [
              "ACT.24.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 24:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma enwere m olileanya nʼebe Chineke nọ dịka ha onwe ha nwekwara, na mbilite nʼọnwụ nke ndị ezi omume na nke ndị ajọ omume ga-adị.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.24.15",
            "verseOrgIds": [
              "ACT.24.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 24:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi nke a, a na m agbalị inwe akọnuche dị ọcha nʼihu Chineke na nʼihu mmadụ niile.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.24.16",
            "verseOrgIds": [
              "ACT.24.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 24:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ugbu a, mgbe ọtụtụ afọ gasịrị, abịara m Jerusalem iwetara ndị nke m onyinye, nakwa ịchụrụ Chineke aja.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.24.17",
            "verseOrgIds": [
              "ACT.24.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 24:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emezuola m omenaala ịdị ọcha mgbe ha hụrụ m nʼụlọnsọ ukwu ahụ mgbe m na-eme nke a. Ọ dịkwaghị igwe mmadụ so m maọbụ na m sonyere ọgbaaghara ọbụla.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.24.18",
            "verseOrgIds": [
              "ACT.24.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 24:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma enwere ụfọdụ ndị Juu si Eshịa bịa, bụ ndị kwesiri ịnọ nʼebe a ma ọ bụrụ na ha nwere ihe ọbụla megide m.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.24.19",
            "verseOrgIds": [
              "ACT.24.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 24:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maọbụ ndị nke nọ nʼebe a ugbu a, ka ha kwuo ajọ omume ọbụla ha hụrụ nʼime m mgbe m guzoro nʼihu ndị nzukọ ndị okenye.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.24.20",
            "verseOrgIds": [
              "ACT.24.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 24:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Karịa na m kwuru naanị otu ihe mgbe m guzoro nʼihu ha tie mkpu, 'A na-ekpe m ikpe taa nʼihi okwukwe m na mbilite nʼọnwụ nke ndị nwụrụ anwụ.' \"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.24.21",
            "verseOrgIds": [
              "ACT.24.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 24:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Feliks onye maara ihe banyere Ụzọ ahụ nke ọma yigharịrị ikpe a. Ọ gwara ha, \"Aga m eleba anya nʼikpe gị a, mgbe Lisias onyeisi agha bịara.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.24.22",
            "verseOrgIds": [
              "ACT.24.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 24:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "O nyere ọchịagha ahụ iwu ka e debe ya nʼokpuru nlekọta ha. Ma ka ha nye ya ohere inwere onwe ya ime ụfọdụ ihe, ka ha kwekwa ka ndị enyi ya bịa nyere ya aka gboo mkpa ya.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.24.23",
            "verseOrgIds": [
              "ACT.24.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Pọl nʼihu Feliks na nwunye ya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 24:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ụbọchị ole na ole gasịrị, Feliks na nwunye ya Drusila, bụ onye Juu bịara, ọ kpọrọ Pọl ka ọ gwa ha okwu banyere inwe okwukwe nʼime Jisọs Kraịst.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.24.24",
            "verseOrgIds": [
              "ACT.24.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 24:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma mgbe ọ gara nʼihu na-ekwu ihe banyere ezi omume na mkpa ọ dị mmadụ ijide onwe ya aka, ya na ihe banyere ụbọchị ikpe nke na-abịa nʼoge ikpeazụ, egwu jidere Feliks. Ọ sịrị, \"I nwere ike ịpụ ugbu a. Aga m akpọkwa gị nʼoge ọzọ mgbe m nwetara ohere.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.24.25",
            "verseOrgIds": [
              "ACT.24.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 24:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ na-atụkwa anya na Pọl ga-enye ya ego. Ya mere o jiri na-eziga ka a na-akpọ ya site nʼoge ruo nʼoge ka ya na ya na-akparịta ụka.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.24.26",
            "verseOrgIds": [
              "ACT.24.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ACT 24:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe afọ abụọ gasịrị, onye a na-akpọ Pọshiọs Festọs nọchiri anya Feliks. Ma ebe ọ chọrọ inweta ihuọma nʼaka ndị Juu, Feliks hapụrụ Pọl nʼụlọ mkpọrọ.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.24.27",
            "verseOrgIds": [
              "ACT.24.27"
            ]
          }
        }
      ]
    }
  ],
