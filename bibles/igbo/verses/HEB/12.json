          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, ebe anyị na-anata alaeze nke na-apụghị ịgbanwe, ka anyị jiri obi ekele, egwu na nsọpụrụ fee Chineke ofufe nʼụzọ ọ ga-anabata.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.28",
            "verseOrgIds": [
              "HEB.12.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "HEB 12:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na Chineke anyị bụ ọkụ na-erepịa erepịa.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.29",
            "verseOrgIds": [
              "HEB.12.29"
            ]
          }
        }
      ]
