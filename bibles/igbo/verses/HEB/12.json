    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "HEB 12:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbalịsienụ ike ihu na unu ajụghị onye ahụ na-ekwu okwu. Nʼihi na ọ bụrụ na ha agbanarịghị ya, bụ onye ahụ dọrọ ha aka na ntị nʼelu ụwa, anyị agaghị agbanarị onye ahụ si nʼeluigwe na-adọ anyị aka na ntị.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.25",
            "verseOrgIds": [
              "HEB.12.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "HEB 12:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼoge ahụ, olu ya mere ka ụwa ma jijiji, ma ugbu a, ọ kwela nkwa, sị, \"Otu mgbe ọzọ fọdụrụ, ọ bụghị naanị ụwa ka m ga-eme ka ọ maa jijiji kama aga m emekwa ka eluigwe maa jijiji.\"",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.26",
            "verseOrgIds": [
              "HEB.12.26"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.26",
            "verseOrgIds": [
              "HEB.12.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "HEB 12:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okwu a bụ, \"Otu mgbe ọzọ fọdụrụ,\" na-egosi mwepụ nke ihe na-ama jijiji dịka ihe e kere eke, iji hụ na nke na-anaghị ama jijiji ga-adị.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.27",
            "verseOrgIds": [
              "HEB.12.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
