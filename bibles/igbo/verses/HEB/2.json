  "verseCount": 18,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
        "style": "c",
        "sid": "HEB 2"
      },
      "items": [
        {
          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ịdọ aka na ntị banyere ige ntị",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HEB 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, anyị aghaghị ilezi anya nke ọma banyere ihe anyị nụrụla, ka anyị hapụ isi na ha wezuga onwe anyị.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.1",
            "verseOrgIds": [
              "HEB.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HEB 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na ọ bụrụ na ozi ahụ e ziri site na ndị mmụọ ozi dị ire, ọ bụrụkwa na njehie maọbụ nnupu isi ọbụla natara ahụhụ kwesiri ya.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.2",
            "verseOrgIds": [
              "HEB.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HEB 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyị ga-esi aṅaa gbanarị ntaramahụhụ ma ọ bụrụ na anyị eleghara oke nzọpụta ahụ anya? Ọ bụ Onyenwe anyị kwupụtara ya, bụkwa nke ndị nụrụ ya gbaara anyị ama banyere ya.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.3",
            "verseOrgIds": [
              "HEB.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HEB 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chineke nʼonwe ya tụkwasịrị ịgba ama nke ya, site nʼịrụ ọrụ ebube na ọrụ ịrịbama, na ọrụ ịtụnanya dị iche iche, nakwa ikesa ọtụtụ onyinye nke Mmụọ Nsọ, dị ka ọchịchọ ya siri dị.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.4",
            "verseOrgIds": [
              "HEB.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "E mere ka Jisọs dịrị ka ụmụnna ya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HEB 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ dịghị mgbe Chineke nyere ndị mmụọ ozi ike ịchị elu ụwa a. Anyị na-ekwu banyere ụwa gaje ịbịa abịa.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.5",
            "verseOrgIds": [
              "HEB.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HEB 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otu onye agbaala akaebe nʼebe ọzọ,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.6",
            "verseOrgIds": [
              "HEB.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HEB 2:6"
      },
      "items": [
        {
          "text": "\"Gịnị ka mmadụ bụ i ji na-eche banyere ha?",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.6",
            "verseOrgIds": [
              "HEB.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HEB 2:6"
      },
      "items": [
        {
          "text": "Gịnị ka nwa nke mmadụ bụ iji na-elekọta ya?",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.6",
            "verseOrgIds": [
              "HEB.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HEB 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na i mere ka ha dị ala nwantakịrị nʼebe ndị mmụọ ozi nọ;",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.7",
            "verseOrgIds": [
              "HEB.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HEB 2:7"
      },
      "items": [
        {
          "text": "i jikwa ebube na nsọpụrụ kpube ya nʼisi dịka okpueze,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.7",
            "verseOrgIds": [
              "HEB.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HEB 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "dokwaa ihe niile nʼokpuru ụkwụ ya.\"",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.8",
            "verseOrgIds": [
              "HEB.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m",
        "vid": "HEB 2:8"
      },
      "items": [
        {
          "text": "Mgbe o mere ka ihe niile dịrị nʼokpuru ya, o nwekwaghị ihe ọbụla ọ hapụrụ itinye nʼokpuru ya. Ma otu ọ dị, anyị ahụbeghị ka e doro ihe niile nʼokpuru ya.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.8",
            "verseOrgIds": [
              "HEB.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HEB 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma anyị na-ahụ Jisọs bụ onye e mere ka ọ dị ala nwantakịrị oge karịa ndị mmụọ ozi, ma ugbu a ejirila ebube na nsọpụrụ kpukwasị ya nʼisi, nʼihi ahụhụ ọnwụ nke ọ hụrụ, ka o site nʼamara Chineke detụ ọnwụ ire nʼihi mmadụ niile.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.9",
            "verseOrgIds": [
              "HEB.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HEB 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebe e sitere na ya kpọbata ọtụtụ ụmụ nʼebube, o ziri ezi ka Chineke, onye ihe niile dịrị na onye kere ihe niile, mee ka onyeisi nzọpụta ha bụrụ onye zuruoke site nʼahụhụ ọ hụrụ.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.10",
            "verseOrgIds": [
              "HEB.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HEB 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye ahụ na-eme mmadụ ka ọ dị nsọ, na ndị ahụ e mere ka ha dị nsọ si nʼotu ezinaụlọ. Nʼihi ya, ihere adịghị eme ya ịkpọ ha ụmụnna ya.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.11",
            "verseOrgIds": [
              "HEB.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HEB 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ sịrị,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.12",
            "verseOrgIds": [
              "HEB.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HEB 2:12"
      },
      "items": [
        {
          "text": "\"Aga m ekwupụta aha gị nye ụmụnna m,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.12",
            "verseOrgIds": [
              "HEB.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HEB 2:12"
      },
      "items": [
        {
          "text": "nʼetiti nzukọ ka m ga-anọ bụọrọ gị abụ otuto.\"",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.12",
            "verseOrgIds": [
              "HEB.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HEB 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọzọkwa,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.13",
            "verseOrgIds": [
              "HEB.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HEB 2:13"
      },
      "items": [
        {
          "text": "\"Aga m atụkwasị obi m na ya.\"",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.13",
            "verseOrgIds": [
              "HEB.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m",
        "vid": "HEB 2:13"
      },
      "items": [
        {
          "text": "Ọzọkwa, ọ sịrị,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.13",
            "verseOrgIds": [
              "HEB.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HEB 2:13"
      },
      "items": [
        {
          "text": "\"Lee mụ onwe m, na ụmụ ndị Chineke nyere m.\"",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.13",
            "verseOrgIds": [
              "HEB.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HEB 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebe ọ bụ na ụmụ ndị ahụ ketara oke na anụ ahụ na ọbara, ya onwe ya sooro ha keta oke nʼụdịdị ahụ, ka o site nʼọnwụ ya laa onye ahụ nwere ike ọnwụ nʼiyi, onye ahụ bụ ekwensu.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.14",
            "verseOrgIds": [
              "HEB.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "HEB 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma tọpụ ndị ahụ niile egwu nke ọnwụ mere ka ha bụrụ ohu na ndụ ha niile.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.15",
            "verseOrgIds": [
              "HEB.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "HEB 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na nʼezie, ọ bụghị ndị mmụọ ozi ka ọ na-enyere aka kama ọ bụ ụmụ ụmụ Ebraham.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.16",
            "verseOrgIds": [
              "HEB.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "HEB 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi nke a, e mere ka o yie ụmụnna ya nʼihe niile, ka o nwe ike ghọọ onyeisi nchụaja kwesiri ntụkwasị obi ma na nke nwere obi ebere nʼijere Chineke ozi, ka o nweekwa ike chụọ aja ikpuchi mmehie mmadụ niile.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.17",
            "verseOrgIds": [
              "HEB.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "HEB 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebe ọ bụ na ya onwe ya tara ahụhụ mgbe a na-anwa ya ọnwụnwa, o nwekwara ike inyere ndị a na-anwa ọnwụnwa aka.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.18",
            "verseOrgIds": [
              "HEB.2.18"
            ]
          }
        }
      ]
    }
  ],
