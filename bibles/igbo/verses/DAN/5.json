  "verseCount": 31,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
        "style": "c",
        "sid": "DAN 5"
      },
      "items": [
        {
          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aka na-ede ihe nʼaja ụlọ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DAN 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eze Belshaza, kpọrọ puku ndịisi nọ nʼalaeze ya oriri, ebe ha nọ ṅụọ nnọọ mmanya dị ukwuu.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.1",
            "verseOrgIds": [
              "DAN.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DAN 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Belshaza na-aṅụ mmanya ya, ọ nyere iwu ka a chịtara ya iko ọlaedo na ọlaọcha nke nna ya bụ Nebukadneza si nʼụlọnsọ ukwu dị na Jerusalem chịkọta, ka eze na ndị a mara aha ha nʼalaeze ya, na ndị nwunye ya, na ndị iko ya jiri ha ṅụọ mmanya.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.2",
            "verseOrgIds": [
              "DAN.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DAN 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, a chịtara iko ọlaedo ndị e si nʼụlọnsọ ukwu Chineke dị na Jerusalem chịkọta. Eze na ndị a mara aha ha nʼalaeze ya na ndị nwunye ya na ndị iko ya jiri ha ṅụọ mmanya.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.3",
            "verseOrgIds": [
              "DAN.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DAN 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha ṅụrụ mmanya tookwa chi nke ọlaedo na ọlaọcha na bronz, na igwe na osisi na nkume.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.4",
            "verseOrgIds": [
              "DAN.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DAN 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mberede, ha hụrụ mkpịsịaka mmadụ ka ọ na-ede ihe nʼaja ụlọ nke ụlọeze ahụ ha nọ nʼime ya, na ncherita ihu ebe a dọbara iheọkụ. Eze nʼonwe ya hụrụ aka ahụ mgbe ọ na-ede ihe ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.5",
            "verseOrgIds": [
              "DAN.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DAN 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, ihu eze ahụ tụhịkọtara, gbarụọ nʼihi egwu. Oke ụjọ tụrụ ya. Ụkwụ ya makwara jijiji. Ikpere ya abụọ kụkọtara onwe ha.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.6",
            "verseOrgIds": [
              "DAN.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DAN 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eze kpọrọ mkpu ka a kpọbata ndị dibịa niile na ndị Kaldịa, na ndị na-akọwa maka njegharị nke kpakpando. Mgbe ahụ eze sịrị ndị ikom amamihe nke Babilọn, \"Onye ọbụla nwere ike gụọ ihe ahụ e dere, nke nwekwara ike ịkọwara m ihe ọ pụtara, ka a ga-eyikwasị uwe odo odo nke ndị eze. A ga-anyakwasị ya ihe olu ọlaedo. A ga-emekwa ya ka ọ bụrụ onye ọchịchị nke atọ nʼalaeze a.\"",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.7",
            "verseOrgIds": [
              "DAN.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DAN 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, ndị amamihe eze batara, ma o nweghị onye ọbụla nʼime ha pụrụ ịgụta, maọbụ ịkọwara eze ihe ọ pụtara.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.8",
            "verseOrgIds": [
              "DAN.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DAN 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nke a mere, ka eze Belshaza maa jijiji karịa, ihu ya gburu maramara ma gbarụkwaa. Ọ gbakwara ndị ozi ya gharịị.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.9",
            "verseOrgIds": [
              "DAN.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DAN 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe eze nwanyị, nụrụ olu eze na olu ndị a mara aha ha nʼala ya, ọ batara nʼụlọ oriri ahụ. Eze nwanyị sịrị, \"Eze, dị ndụ ruo mgbe ebighị ebi; ka ihe a mere ghara iwetara gị ihu mgbarụ, atụla ụjọ.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.10",
            "verseOrgIds": [
              "DAN.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DAN 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na o nwere otu nwoke nọ nʼalaeze gị, onye mmụọ nke chi ndị ahụ dị nsọ bi nʼime ya. Nʼoge ahụ nna gị bụ eze, a chọpụtara na nwoke a jupụtara nʼamamihe na nghọta, dịka a ga-asị na ya onwe ya bụ chi. Nna gị eze Nebukadneza mere ya onyeisi ndị amamihe niile, ndị dibịa, ndị na-enyocha kpakpando, ndị Kaldịa na ndị mgba afa niile.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.11",
            "verseOrgIds": [
              "DAN.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DAN 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebe ọ bụ na ezigbo mmụọ, mmụta na nghọta nke e ji akọwa nrọ na ihe mgbagwoju anya, na igbo mkpa dị iche iche, dị nʼime nwoke a a na-akpọ Daniel, nke eze kpọrọ Belteshaza. Ugbu a, zie ozi ka a kpọọ Daniel ka ọ kọwara gị ihe a.\"",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.12",
            "verseOrgIds": [
              "DAN.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DAN 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, a kpọbatara Daniel nʼihu eze, eze sịrị Daniel, \"Ọ bụ gị bụ Daniel, otu nʼime ndị Juda, ndị nna m dọtara nʼagha site na Juda?",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.13",
            "verseOrgIds": [
              "DAN.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DAN 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anụla m na i nwere mmụọ nke chi niile nʼime gị, na ị bụkwa onye jupụtara na nghọta na amamihe.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.14",
            "verseOrgIds": [
              "DAN.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DAN 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị amamihe m, na ndị na-enyocha kpakpando abịala nʼihu m ịgụ ihe ahụ e dere nʼaja ụlọ ma ha enweghị ike ịgụta ya maọbụ ịkọwa ihe ọ bụ.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.15",
            "verseOrgIds": [
              "DAN.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DAN 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agwara m na i nwere ike ịkọwa ihe ọbụla gbagwojuru anya. Ọ bụrụ na i nwee ike ịgụ ihe e dere nʼaja ma kọwakwara m ihe ọ pụtara, aga m eyikwasị gị uwe odo odo ndị eze, yinyekwa gị ihe olu ọlaedo nʼolu, meekwa ka i bụrụ onye ọchịchị nke atọ nʼalaeze m.\"",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.16",
            "verseOrgIds": [
              "DAN.5.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DAN 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daniel zara nʼihu eze, \"Debere onwe gị onyinye gị, ma ọ bụkwanụ were ya nye onye ọzọ. Ma aga m agụrụ gị eze ihe ahụ e dere ma kọwakwara gị ihe ọ pụtara.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.17",
            "verseOrgIds": [
              "DAN.5.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DAN 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Gị eze, Chineke nke kachasị ihe niile elu nyere nna gị, Nebukadneza ike ọchịchị a, na ịdị ukwu, na ebube, na ịma mma.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.18",
            "verseOrgIds": [
              "DAN.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DAN 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi ọkwa dị ukwuu nke o nyere ya, ndị niile, na mba niile di iche iche, na-asụ asụsụ niile dị iche iche nʼelu ụwa na-ama jijiji na-atụkwa ya egwu. Ndị eze chọrọ igbu ka o gburu, ọ hapụkwara onye ọbụla ọ chọrọ ịhapụ; o buliri onye ọbụla ọ chọrọ ibuli elu, ma ndị ọ chọrọ iweda nʼala, ka ya onwe ya wedakwara nʼala.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.19",
            "verseOrgIds": [
              "DAN.5.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DAN 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma mgbe nganga na ịnya isi jupụtara ya obi, Chineke sitere nʼocheeze ya wezuga ya, napụkwa ya ebube o nwere dịka eze.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.20",
            "verseOrgIds": [
              "DAN.5.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DAN 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "A chụpụrụ ya site nʼetiti ụmụ mmadụ, nyekwa ya echiche uche dịka nke anụmanụ. Ọ bụkwa nʼetiti ụmụ ịnyịnya ibu ọhịa ka ebe obibi ya dị, o soro ha taa ahịhịa dịka oke ehi. Igirigi nke eluigwe deekwara ahụ ya, tutu ruo mgbe ọ matara na Chineke Onye kachasị ihe niile elu na-achị achị nʼalaeze niile nke ụwa. Ọ bụkwa onye ọbụla ọ chọrọ ka ọ na-eguzobe ka ọ chịa.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.21",
            "verseOrgIds": [
              "DAN.5.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DAN 5:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ma gị nwa ya, O Belshaza, ewedaghị onwe gị ala, nʼagbanyeghị na i ma ihe ndị a niile.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.22",
            "verseOrgIds": [
              "DAN.5.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DAN 5:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na i lelịala Chineke nke eluigwe. Ị wepụtara iko ndị a e si nʼụlọnsọ ukwu ya chịpụta, ka gị na ndịisi alaeze gị, ndị nwunye ha na ndị iko unu, jiri ṅụọ mmanya, mgbe unu nọ na-eto chi niile nke e jiri ọlaọcha na ọlaedo, bronz na igwe, osisi na nkume kpụọ; chi nke na-adịghị ahụ ụzọ, maọbụ nụ ihe; chi nke na-amaghị ihe ọbụla. Ma unu enyeghị Chineke onye na-enye unu ume ndụ na onye ndụ gị na ọganihu gị dị nʼaka ya nsọpụrụ.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.23",
            "verseOrgIds": [
              "DAN.5.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DAN 5:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ nke a mere o ji zite aka ahụ ị hụrụ, nke depụtara ozi a.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.24",
            "verseOrgIds": [
              "DAN.5.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DAN 5:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nke a bụ ozi ahụ e dere:",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.25",
            "verseOrgIds": [
              "DAN.5.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pc",
