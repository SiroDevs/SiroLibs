              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼabalị ụbọchị ahụ kwa ka e gburu Belshaza eze ndị Kaldịa.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.30",
            "verseOrgIds": [
              "DAN.5.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "DAN 5:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼabalị ahụ kwa ka Daraiọs onye Midia, bidoro ịchị dịka eze. Ọ gbara iri afọ isii na abụọ nʼoge o bidoro ịchị.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.31",
            "verseOrgIds": [
              "DAN.6.1"
            ]
