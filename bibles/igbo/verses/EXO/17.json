  "verseCount": 16,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "17",
        "style": "c",
        "sid": "EXO 17"
      },
      "items": [
        {
          "text": "17",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mmiri si na nkume",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọgbakọ ụmụ Izrel niile sitere nʼọzara Sin bilie ije ha, na-aga site nʼotu ebe ruo nʼebe ọzọ dịka",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.1",
            "verseOrgIds": [
              "EXO.17.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.17.1",
                "verseOrgIds": [
                  "EXO.17.1"
                ]
              }
            }
          ]
        },
        {
          "text": "nyere nʼiwu. Ha mara ụlọ ikwu ha na Refidim, ma ọ dịghị mmiri dị nke ndị mmadụ ga-aṅụ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.1",
            "verseOrgIds": [
              "EXO.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi nke a, ha sesịrị Mosis okwu, sị, \"Nye anyị mmiri ka anyị ṅụọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.2",
            "verseOrgIds": [
              "EXO.17.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EXO 17:2"
      },
      "items": [
        {
          "text": "Mosis zara, sị, \"Gịnị mere unu ji esesị m okwu? Gịnị mere unu ji chọọ ịnwapụta ntachiobi",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.2",
            "verseOrgIds": [
              "EXO.17.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.17.2",
                "verseOrgIds": [
                  "EXO.17.2"
                ]
              }
            }
          ]
        },
        {
          "text": "?\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.2",
            "verseOrgIds": [
              "EXO.17.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma akpịrị mmiri kpọrọ ndị a nkụ nʼebe ahụ, nke a mere ka ha tamuo ntamu megide Mosis. Ha sịrị, \"Ọ bụkwa nʼihi gịnị ka i ji site nʼobodo Ijipt kpọpụta anyị, ime ka anyị, ụmụntakịrị anyị na anụ ụlọ anyị nwụọ nʼihi akpịrị ịkpọ nkụ?\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.3",
            "verseOrgIds": [
              "EXO.17.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi ya, Mosis tikuru",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.4",
            "verseOrgIds": [
              "EXO.17.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.17.4",
                "verseOrgIds": [
                  "EXO.17.4"
                ]
              }
            }
          ]
        },
        {
          "text": "mkpu akwa sị, \"Gịnị ka m ga-eme banyere ndị a. Lee, ha chọrọ itugbu m na nkume.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.4",
            "verseOrgIds": [
              "EXO.17.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.5",
            "verseOrgIds": [
              "EXO.17.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.17.5",
                "verseOrgIds": [
                  "EXO.17.5"
                ]
              }
            }
          ]
        },
        {
          "text": "zaghachiri Mosis, sị ya, \"Gaa nʼihu ndị a, kpọrọ ụfọdụ nʼime ndị okenye Izrel. Jirikwa mkpanaka ahụ nʼaka gị, bụ nke i tiri nʼelu osimiri Naịl gaa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.5",
            "verseOrgIds": [
              "EXO.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lee, Aga m eguzo nʼihu gị nʼakụkụ nkume dị na Horeb. Ị ga-akụ mkpara gị nʼelu nkume ahụ. Mmiri ga-asọpụtakwa site na ya, ka ndị mmadụ ṅụọ.\" Ya mere, Mosis mere otu a nʼihu ndị okenye Izrel niile.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.6",
            "verseOrgIds": [
              "EXO.17.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi nke a, ọ kpọrọ aha ebe ahụ Masa na Meriba nʼihi esemokwu ụmụ Izrel na nʼihi nwale ha nwalere",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.7",
            "verseOrgIds": [
              "EXO.17.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.17.7",
                "verseOrgIds": [
                  "EXO.17.7"
                ]
              }
            }
          ]
        },
        {
          "text": ", na-asị, \"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.7",
            "verseOrgIds": [
              "EXO.17.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.17.7",
                "verseOrgIds": [
                  "EXO.17.7"
                ]
              }
            }
          ]
        },
        {
          "text": "ọ nọnyeere anyị, ka ọ bụ na ọ nọnyereghị anyị?\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.7",
            "verseOrgIds": [
              "EXO.17.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mmeri e meriri ndị Amalek nʼagha",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị Amalek",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.8",
            "verseOrgIds": [
              "EXO.17.8"
            ]
          }
        },
        {
          "text": "bịara lụso ụmụ Izrel agha na Refidim.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.8",
            "verseOrgIds": [
              "EXO.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mosis gwara Joshua okwu sị ya, \"Họpụta ụfọdụ ndị ikom ka ha gaa lụso ndị Amalek agha. Echi, mụ onwe m ga-eguzoro nʼelu ugwu, jidekwa mkpara Chineke nʼaka m.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.9",
            "verseOrgIds": [
              "EXO.17.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, Joshua pụrụ gaa lụso ndị Amalek agha dịka Mosis gwara ya. Ma Mosis na Erọn na Hua, rigoro nʼelu ugwu ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.10",
            "verseOrgIds": [
              "EXO.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị Izrel na-enwe mmeri mgbe ọbụla Mosis weliri aka ya elu, ma ndị Amalek na-emeri mgbe ọbụla Mosis wedatara aka ya.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.11",
            "verseOrgIds": [
              "EXO.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ike gwụrụ aka Mosis, ha butere nkume tinye nʼokpuru ya mee ka ọ nọkwasị nʼelu ya. Erọn na Hua jidere aka Mosis abụọ welie ya elu, otu onye nʼakụkụ a, onye nke ọzọ nʼakụkụ nke ọzọ. Ime ka aka Mosis guzosie ike tutu ruo mgbe anwụ dara.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.12",
            "verseOrgIds": [
              "EXO.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi nke a, Joshua na ndị agha ya meriri ndị agha Amalek site nʼiji mma agha gbuo ha.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.13",
            "verseOrgIds": [
              "EXO.17.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emesịa,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.14",
            "verseOrgIds": [
              "EXO.17.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.17.14",
                "verseOrgIds": [
                  "EXO.17.14"
                ]
              }
            }
          ]
        },
        {
          "text": "sịrị Mosis, \"Dee ihe niile ndị a nʼakwụkwọ, ka ọ bụrụ ihe ncheta. Gụgharịakwa ya na ntị Joshua. Nʼihi na aga m ehichapụ ihe niile a ga-eji cheta Amalek nʼelu ụwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.14",
            "verseOrgIds": [
              "EXO.17.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mosis wuru ebe ịchụ aja nye",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.15",
            "verseOrgIds": [
              "EXO.17.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.17.15",
                "verseOrgIds": [
                  "EXO.17.15"
                ]
              }
            }
          ]
        },
        {
          "text": ". Ọ kpọrọ ya",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.15",
            "verseOrgIds": [
              "EXO.17.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.17.15",
                "verseOrgIds": [
                  "EXO.17.15"
                ]
              }
            }
          ]
        },
        {
          "text": "Nisi, nke pụtara,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.15",
            "verseOrgIds": [
              "EXO.17.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.17.15",
                "verseOrgIds": [
                  "EXO.17.15"
                ]
              }
            }
          ]
        },
        {
          "text": "bụ ọkọlọtọ m.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.15",
            "verseOrgIds": [
              "EXO.17.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mosis sịrị, \"Nʼihi na-eweliri aka elu nʼebe ocheeze",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.16",
            "verseOrgIds": [
              "EXO.17.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.17.16",
                "verseOrgIds": [
                  "EXO.17.16"
                ]
              }
            }
          ]
        },
        {
          "text": "dị.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.16",
            "verseOrgIds": [
              "EXO.17.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.17.16",
                "verseOrgIds": [
                  "EXO.17.16"
                ]
              }
            }
          ]
        },
        {
          "text": "ga na-ebuso ndị Amalek agha site nʼọgbọ ruo nʼọgbọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.16",
            "verseOrgIds": [
              "EXO.17.16"
            ]
          }
        }
      ]
    }
  ],
