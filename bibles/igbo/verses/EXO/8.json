  "verseCount": 32,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "8",
        "style": "c",
        "sid": "EXO 8"
      },
      "items": [
        {
          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "nb"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.1",
            "verseOrgIds": [
              "EXO.7.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.8.1",
                "verseOrgIds": [
                  "EXO.7.26"
                ]
              }
            }
          ]
        },
        {
          "text": "gwara Mosis sị, \"Jekwuru Fero gwa ya, 'Nke a bụ ihe",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.1",
            "verseOrgIds": [
              "EXO.7.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.8.1",
                "verseOrgIds": [
                  "EXO.7.26"
                ]
              }
            }
          ]
        },
        {
          "text": "kwuru. Hapụ ndị m, ka ha gaa fee m ofufe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.1",
            "verseOrgIds": [
              "EXO.7.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ na ị jụ ịhapụ ha ka ha gaa, aga m eme ka awọ jupụta nʼala Ijipt niile.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.2",
            "verseOrgIds": [
              "EXO.7.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Osimiri Naịl ga-ejupụta nʼawọ. Ha ga-abata nʼụlọeze gị na nʼime ọnụụlọ ndina gị, ma nʼelu ihe ndina gị, ma nʼụlọ ndị na-ejere gị ozi, ma nʼụlọ ndị gị niile, na nʼebe a na-esi nri, ma nʼime ihe e ji agwakọta ụtụ ọka.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.3",
            "verseOrgIds": [
              "EXO.7.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awọ ndị a ga-arịgokwa nʼahụ gị, na nʼahụ ndị gị, na nʼahụ ndị na-ejere gị ozi.' \"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.4",
            "verseOrgIds": [
              "EXO.7.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.5",
            "verseOrgIds": [
              "EXO.8.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.8.5",
                "verseOrgIds": [
                  "EXO.8.1"
                ]
              }
            }
          ]
        },
        {
          "text": "gwara Mosis sị, \"Gwa Erọn, 'Setịpụ aka gị ya na mkpanaka gị nʼelu osimiri niile, na mmiri nta na ọdọ mmiri ndị Ijipt, mee ka awọ jupụta ala Ijipt niile.' \"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.5",
            "verseOrgIds": [
              "EXO.8.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erọn setịpụrụ aka nʼelu mmiri niile nke Ijipt, awọ pụtara kpuchie ala ahụ niile.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.6",
            "verseOrgIds": [
              "EXO.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ndị majiki Ijipt jikwa ihe nzuzo ha mee ihe ahụ Mosis na Erọn mere. Ha mekwara ka awọ jupụta ala ahụ niile.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.7",
            "verseOrgIds": [
              "EXO.8.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fero kpọrọ Mosis na Erọn rịọọ ha sị, \"Rịọọnụ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.8",
            "verseOrgIds": [
              "EXO.8.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.8.8",
                "verseOrgIds": [
                  "EXO.8.4"
                ]
              }
            }
          ]
        },
        {
          "text": "ka o wepụrụ mụ na ndị m awọ ndị a. Emesịa aga m ekwe ka ndị gị gaa chụọrọ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.8",
            "verseOrgIds": [
              "EXO.8.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.8.8",
                "verseOrgIds": [
                  "EXO.8.4"
                ]
              }
            }
          ]
        },
        {
          "text": "aja.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.8",
            "verseOrgIds": [
              "EXO.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mosis zaghachiri Fero sị, \"Gị ka ọ dịrị ịgwa m mgbe m ga-arịọ arịrịọ a nʼisi gị na nʼisi ndị gị, ka e wezuga awọ ndị a site nʼụlọ unu, ma hapụ naanị ndị nọ nʼosimiri Naịl.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.9",
            "verseOrgIds": [
              "EXO.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ Fero sịrị Mosis, \"Achọrọ m ka i mee ya echi.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.10",
            "verseOrgIds": [
              "EXO.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EXO 8:10"
      },
      "items": [
        {
          "text": "Mosis zaghachiri Fero sị, \"Ọ dị mma, ka ọ dịrị dịka i kwuru. Mgbe ahụ, ị ga-amata na o nweghị onye dịka",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.10",
            "verseOrgIds": [
              "EXO.8.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.8.10",
                "verseOrgIds": [
                  "EXO.8.6"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke anyị.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.10",
            "verseOrgIds": [
              "EXO.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awọ ndị a niile ga-apụ site nʼebe ị nọ, na site nʼụlọ gị na site nʼụlọ ndị na-ejere gị ozi na site nʼụlọ ndị Ijipt niile. Ọ bụ naanị nʼosimiri Naịl ka ha ga-anọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.11",
            "verseOrgIds": [
              "EXO.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Mosis na Erọn sitere nʼụlọ Fero pụọ, Mosis kpọkuru",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.12",
            "verseOrgIds": [
              "EXO.8.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.8.12",
                "verseOrgIds": [
                  "EXO.8.8"
                ]
              }
            }
          ]
        },
        {
          "text": "ka o wepụ awọ ndị a o mere ka ha bịakwasị Fero.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.12",
            "verseOrgIds": [
              "EXO.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.8.13",
                "verseOrgIds": [
                  "EXO.8.9"
                ]
              }
            }
          ]
        },
        {
          "text": "mere ihe Mosis rịọrọ. Awọ ndị ahụ niile nwụrụ nʼime ụlọ, na nʼama, na nʼọhịa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.13",
            "verseOrgIds": [
              "EXO.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "E kpokọtara ozu awọ ndị a niile nʼebe dị iche iche. Isi ọjọọ ha wetara nʼala ahụ dị egwu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.14",
            "verseOrgIds": [
              "EXO.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma mgbe Fero hụrụ na awọ ndị a anwụchaala, o mechiri obi ya jụ ige Mosis na Erọn ntị, dịka",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.15",
            "verseOrgIds": [
              "EXO.8.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.8.15",
                "verseOrgIds": [
                  "EXO.8.11"
                ]
              }
            }
          ]
        },
        {
          "text": "kwuru na ọ ga-eme.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.15",
            "verseOrgIds": [
              "EXO.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ụmụ ndanda nta na-efe efe ejupụta ala Ijipt",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.16",
            "verseOrgIds": [
              "EXO.8.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.8.16",
                "verseOrgIds": [
                  "EXO.8.12"
                ]
              }
            }
          ]
        },
        {
          "text": "gwara Mosis sị ya, \"Gwa Erọn, setịpụ mkpanaka gị, tie nʼaja nke ala nʼala Ijipt niile, aja ya ga-aghọ anwụ nta nke na-ata ata.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.16",
            "verseOrgIds": [
              "EXO.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mosis na Erọn mere nke a. Mgbe Erọn setịpụrụ aka tie mkpanaka ya nʼelu ala, anwụ nta jupụtara nʼala Ijipt niile, nʼahụ ndị mmadụ, na nʼahụ anụmanụ ha. Ndanda ndị a jupụtakwara nʼuzuzu niile dị nʼala ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.17",
            "verseOrgIds": [
              "EXO.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị Ijipt na-eme majiki gbalịrị iji ihe nzuzo ha mee otu ihe ahụ Erọn mere, ma ha enweghị ike ime ka anwụ nta ọbụla pụta.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.18",
            "verseOrgIds": [
              "EXO.8.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EXO 8:18"
      },
      "items": [
        {
          "text": "Ebe ọ bụ na anwụ nta ndị a jupụtara nʼahụ mmadụ na nʼahụ anụmanụ niile.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.18",
            "verseOrgIds": [
              "EXO.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naanị ihe ndị na-eme majiki gwara Fero bụ, \"Nke a bụ akaọrụ Chineke.\" Ma Fero mere ka obi ya sie ike. Ọ chọghị ige, ọ bụladị ndị majiki ya ntị, dịka",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.19",
            "verseOrgIds": [
              "EXO.8.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.8.19",
                "verseOrgIds": [
                  "EXO.8.15"
                ]
              }
            }
          ]
        },
        {
          "text": "kwuru na ọ ga-eme.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.19",
            "verseOrgIds": [
              "EXO.8.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Usuu ijiji ejupụta ala Ijipt",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.8.20",
                "verseOrgIds": [
                  "EXO.8.16"
                ]
              }
            }
          ]
        },
        {
          "text": "gwara Mosis sị ya, \"Bilie nʼisi ụtụtụ echi jekwuru Fero. Mgbe ọ ga-aga nʼosimiri,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.20",
            "verseOrgIds": [
              "EXO.8.16"
            ]
          }
        },
        {
          "text": "gwa ya okwu sị, 'Nke a bụ ihe",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.20",
            "verseOrgIds": [
              "EXO.8.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.8.20",
                "verseOrgIds": [
                  "EXO.8.16"
                ]
              }
            }
          ]
        },
        {
          "text": "kwuru, Hapụ ndị m ka ha gaa fee m ofufe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.20",
            "verseOrgIds": [
              "EXO.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ na ị chọghị ime otu a, aga m eme ka igwe ijiji jupụta nʼala Ijipt niile. Ha ga-ejupụta gị nʼahụ na nʼahụ ndị na-ejere gị ozi, na nʼahụ ndị gị niile, na nʼime ụlọ unu niile.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.21",
            "verseOrgIds": [
              "EXO.8.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 8:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Nʼụbọchị ahụ, igwe ijiji ndị a agaghị emetụ ndị nọ na Goshen ebe ndị m bi. Mgbe ahụ ka ị ga-amata na mụ bụ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.22",
            "verseOrgIds": [
              "EXO.8.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.8.22",
                "verseOrgIds": [
                  "EXO.8.18"
                ]
              }
            }
          ]
        },
        {
          "text": "bịara ije nʼala a.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.22",
            "verseOrgIds": [
              "EXO.8.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 8:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aga m emekwa ka ọ pụta ìhè na o nwere ihe dị iche nʼetiti ndị m na ndị gị. Ihe ịrịbama a ga-emezukwa echi.' \"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.23",
            "verseOrgIds": [
              "EXO.8.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 8:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼechi ya,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.24",
            "verseOrgIds": [
              "EXO.8.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.8.24",
                "verseOrgIds": [
                  "EXO.8.20"
                ]
              }
            }
          ]
        },
        {
          "text": "mere dịka o kwuru. Igwe ijiji dị egwu nʼọnụọgụgụ bịara nʼala Ijipt, jupụta nʼụlọ Fero, na nʼụlọ ndị niile na-ejere ya ozi, na nʼala Ijipt niile. E mere ka ala Ijipt bụrụ ihe e ji ijiji mebie.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.24",
            "verseOrgIds": [
              "EXO.8.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 8:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ihe ndị a na-eme, Fero kpọrọ Mosis na Erọn gwa ha okwu sị, \"Gaanụ chụọrọ Chineke unu aja, ma ka ọ bụrụ nʼala Ijipt.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.25",
            "verseOrgIds": [
              "EXO.8.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 8:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mosis zaghachiri Fero sị, \"Nke ahụ abụghị ihe ziri ezi, nʼihi na aja anyị na-aga ịchụrụ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.26",
            "verseOrgIds": [
              "EXO.8.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.8.26",
                "verseOrgIds": [
                  "EXO.8.22"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke anyị bụ ihe rụrụ arụ nʼanya ndị Ijipt. Ọ bụrụ na anyị achụọ aja a nʼihu ha, ha ga-eji nkume tugbuo anyị.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.26",
            "verseOrgIds": [
              "EXO.8.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 8:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyị ga-aga njem ụbọchị atọ nʼime ọzara gaa chụọrọ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.27",
            "verseOrgIds": [
              "EXO.8.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.8.27",
                "verseOrgIds": [
                  "EXO.8.23"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke anyị aja, dịka o nyere anyị iwu ka anyị mee.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.27",
            "verseOrgIds": [
              "EXO.8.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 8:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fero zaghachiri ha sị, \"Aga m ekwenye ka unu ga chụọrọ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.28",
            "verseOrgIds": [
              "EXO.8.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.8.28",
                "verseOrgIds": [
                  "EXO.8.24"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke unu aja nʼọzara, ma unu agaghị aga ebe dị anya. Ugbu a, kperenụ m ekpere.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.28",
            "verseOrgIds": [
              "EXO.8.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 8:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mosis zara Fero sị ya, \"Ngwangwa m si nʼihu gị pụọ, aga m arịọ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.29",
            "verseOrgIds": [
              "EXO.8.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.8.29",
                "verseOrgIds": [
                  "EXO.8.25"
                ]
              }
            }
          ]
        },
        {
          "text": "arịrịọ. Echi, a ga-esite nʼụlọ Fero, na nʼụlọ ndị na-ejere ya ozi, na nʼụlọ ndị Ijipt niile wezuga ijiji ndị a. Ọ ga-adị mkpa na Fero ga-elezi anya hapụ ịghọ aghụghọ ọzọ site ịjụ ka ụmụ Izrel gaa chụọrọ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.29",
            "verseOrgIds": [
              "EXO.8.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.8.29",
                "verseOrgIds": [
                  "EXO.8.25"
                ]
              }
            }
          ]
        },
        {
          "text": "aja.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.29",
            "verseOrgIds": [
              "EXO.8.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 8:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Mosis sitere nʼihu Fero pụọ rịọọ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.30",
            "verseOrgIds": [
              "EXO.8.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.8.30",
                "verseOrgIds": [
                  "EXO.8.26"
                ]
              }
            }
          ]
        },
        {
          "text": "ka o mee ka ijiji ndị a gabiga.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.30",
            "verseOrgIds": [
              "EXO.8.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 8:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.8.31",
                "verseOrgIds": [
                  "EXO.8.27"
                ]
              }
            }
          ]
        },
        {
          "text": "mere dịka Mosis rịọrọ. Ijiji ndị a sitere nʼụlọ Fero na ụlọ ndị na-ejere ya ozi na ụlọ ndị Ijipt niile pụọ. O nwekwaghị ijiji ọ bụla fọdụrụ nʼala ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.31",
            "verseOrgIds": [
              "EXO.8.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 8:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma nʼoge a, Fero gara nʼihu ime ka obi ya sie ike. O kweghị ka ụmụ Izrel laa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.32",
            "verseOrgIds": [
              "EXO.8.28"
            ]
          }
        }
      ]
    }
