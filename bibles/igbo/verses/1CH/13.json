  "verseCount": 14,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "13",
        "style": "c",
        "sid": "1CH 13"
      },
      "items": [
        {
          "text": "13",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mbughachi igbe ọgbụgba ndụ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Devid na ndịisi agha ya na-achị imerime puku ndị agha, na ọtụtụ narị ndị agha, zukọrọ gbaa izu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.1",
            "verseOrgIds": [
              "1CH.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ gwara ọgbakọ Izrel niile ahụ sị, \"Ọ bụrụ na ọ dị unu mma, ọ bụrụkwa na ọ bụ ọchịchọ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.2",
            "verseOrgIds": [
              "1CH.13.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1CH.13.2",
                "verseOrgIds": [
                  "1CH.13.2"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke anyị, ka anyị ziga ozi zie ụmụnna anyị niile bi nʼakụkụ niile nke ala Izrel, na ndị nchụaja na ndị Livayị niile, bi nʼobodo ha na ndị bi nʼebe ịta nri nke anụ ụlọ ha, ka ha bịa, soro anyị.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.2",
            "verseOrgIds": [
              "1CH.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka anyị gaa bulata igbe ọgbụgba ndụ Chineke nʼihi na e lefuru ya anya nʼoge ahụ niile Sọl bụ eze.\"",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.3",
            "verseOrgIds": [
              "1CH.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha niile kwekọrịtara ime nke a nʼihi na okwu ahụ dị ndị niile zukọrọ mma.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.4",
            "verseOrgIds": [
              "1CH.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Devid kpọrọ ndị Izrel niile oku ka ha zuo ezuo site nʼebe niile ha bi, site nʼoke ala ha na ndị Ijipt, ya bụ iyi Shiho, ruo nʼoke ala dị nʼugwu, ya bụ Lebo Hamat, ka ha gaa bulata igbe ọgbụgba ndụ Chineke site na Kiriat Jearim.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.5",
            "verseOrgIds": [
              "1CH.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Devid na ndị Izrel niile jere Baala nʼime Juda, ya bụ Kiriat Jearim, i si nʼebe ahụ bugota igbe ọgbụgba ndụ Chineke, bụ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.6",
            "verseOrgIds": [
              "1CH.13.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1CH.13.6",
                "verseOrgIds": [
                  "1CH.13.6"
                ]
              }
            }
          ]
        },
        {
          "text": ", onye na-anọkwasị nʼetiti cherubim, igbe ahụ nke akpọkwasịrị aha ya.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.6",
            "verseOrgIds": [
              "1CH.13.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha ji ụgbọala ọhụrụ ehi na-adọkpụ buru igbe ọgbụgba ndụ Chineke site nʼụlọ Abinadab, Ụza na Ahio na-eduzi ụgbọala ahụ ụzọ.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.7",
            "verseOrgIds": [
              "1CH.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Devid na ndị Izrel niile weere ike ha niile na-aṅụ ọṅụ nʼihu Chineke, jiri abụ, ụbọ akwara, opi, une na ogene na iti egwu na-etekwa egwu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.8",
            "verseOrgIds": [
              "1CH.13.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ha rutere nʼebe ịzọcha ọka nke Kidon, Ụza setịpụrụ aka ya ijide igbe ọgbụgba ndụ ahụ, nʼihi na ehi ahụ zọhiere ụkwụ.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.9",
            "verseOrgIds": [
              "1CH.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma iwe",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.10",
            "verseOrgIds": [
              "1CH.13.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1CH.13.10",
                "verseOrgIds": [
                  "1CH.13.10"
                ]
              }
            }
          ]
        },
        {
          "text": "dị ọkụ megide Ụza, o tigburu ya nʼihi na o metụrụ igbe ọgbụgba ndụ ahụ aka. Ya mere, ọ nwụrụ nʼebe ahụ nʼihu Chineke.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.10",
            "verseOrgIds": [
              "1CH.13.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, iwe were Devid nʼihi ọnụma",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.11",
            "verseOrgIds": [
              "1CH.13.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1CH.13.11",
                "verseOrgIds": [
                  "1CH.13.11"
                ]
              }
            }
          ]
        },
        {
          "text": "dakwasịrị Ụza, ruo taa, a na-akpọ ebe ahụ Perez Ụza.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.11",
            "verseOrgIds": [
              "1CH.13.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Devid tụrụ egwu Chineke nʼụbọchị ahụ, o kwuru sị, \"M ga-esi aṅaa bubatara onwe m igbe ọgbụgba ndụ a?\"",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.12",
            "verseOrgIds": [
              "1CH.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "O bubataghị igbe ọgbụgba ndụ ahụ nʼime obodo Devid, kama o bugara ya nʼụlọ Obed-Edọm, onye Git.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.13",
            "verseOrgIds": [
              "1CH.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igbe ọgbụgba ndụ Chineke ahụ nọrọ nʼezinaụlọ Obed-Edọm nʼụlọ ya ọnwa atọ.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.14",
            "verseOrgIds": [
              "1CH.13.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1CH.13.14",
                "verseOrgIds": [
                  "1CH.13.14"
                ]
              }
            }
          ]
        },
        {
          "text": "gọzikwara ezinaụlọ ya na ihe niile o nwere.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.14",
            "verseOrgIds": [
              "1CH.13.14"
            ]
          }
        }
      ]
    }
  ],
