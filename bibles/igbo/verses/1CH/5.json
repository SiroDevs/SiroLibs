  "verseCount": 26,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
        "style": "c",
        "sid": "1CH 5"
      },
      "items": [
        {
          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ụmụ ụmụ Ruben",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọkpara Izrel bụ Ruben. Ma nʼihi na ọ merụrụ ihe ndina nna ya site na idinakwuru nwunye nna ya, a napụrụ ya ọnọdụ ọkpara ya were ya nye ụmụ nwanne ya Josef mụtara. Nʼihi ya, akwụkwọ akụkọ usoro ọmụmụ ụmụ Izrel akpọghị Ruben ọkpara.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ ezie na Juda dị ike karịa ụmụnna ya, bụrụkwa eziokwu na onyendu si na Juda pụta, maọbụ Josef ka e nyere oke ruuru ọkpara.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ruben, ọkpara Izrel mụrụ ndị ikom ndị a:",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "1CH 5:3"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 5:3"
      },
      "items": [
        {
          "text": "Hanok, na Palu, na Hezrọn, na Kami.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.3",
            "verseOrgIds": [
              "1CH.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Juel mụrụ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.4",
            "verseOrgIds": [
              "1CH.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 5:4"
      },
      "items": [
        {
          "text": "Shemaya, nna Gog,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.4",
            "verseOrgIds": [
              "1CH.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 5:4"
      },
      "items": [
        {
          "text": "Gog mụrụ Shimei.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.4",
            "verseOrgIds": [
              "1CH.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shimei mụrụ Maịka,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.5",
            "verseOrgIds": [
              "1CH.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 5:5"
      },
      "items": [
        {
          "text": "Maịka amụọ Reaya. Reaya amụọ Baal.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.5",
            "verseOrgIds": [
              "1CH.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baal mụrụ Beera, onye Tiglat-Pilesa eze ndị Asịrịa dọtara nʼagha. Beera bụkwa onyendu ndị Ruben.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.6",
            "verseOrgIds": [
              "1CH.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị ụmụnna ha dịka agbụrụ niile ha si dị, bụ ndị e depụtara aha ha dịka usoro ọmụmụ ha si dị;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.7",
            "verseOrgIds": [
              "1CH.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 5:7"
      },
      "items": [
        {
          "text": "Jeiel onyeisi, na Zekaraya,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.7",
            "verseOrgIds": [
              "1CH.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Bela nwa Azaz nwa Shema, nwa Juel.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.8",
            "verseOrgIds": [
              "1CH.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "1CH 5:8"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1CH 5:8"
      },
      "items": [
        {
          "text": "Ha nwere ebe obibi ha site nʼAroea ruo nʼugwu Nebo, rukwaa Baal-Meon.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.8",
            "verseOrgIds": [
              "1CH.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha bụ ndị ọzụzụ atụrụ, nwekwa ọtụtụ igwe anụ ụlọ. Ọ bụkwa nʼakụkụ ọwụwa anyanwụ, nʼọnụ ọzara ruo nʼosimiri Yufretis ka ha na-azụ ha, nʼihi na anụ ụlọ ha nwere bara ụba na Gilead.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.9",
            "verseOrgIds": [
              "1CH.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼoge Sọl bụ eze Izrel, ụmụ Ruben meriri ndị Haga nʼagha, bichie ala ha niile dị nʼọwụwa anyanwụ Gilead.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.10",
            "verseOrgIds": [
              "1CH.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ụmụ ụmụ Gad",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụmụ Gad bi nʼakụkụ ha site na Bashan ruo Saleka.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Juel bụ onyendu na Bashan, Shafam na-esote ya, ya na Janai na Shafat.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.12",
            "verseOrgIds": [
              "1CH.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụmụnna ha, ndị bụ ndị ndu ikwu asaa a bụ,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.13",
            "verseOrgIds": [
              "1CH.5.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 5:13"
      },
      "items": [
        {
          "text": "Maikel, na Meshulam, na Sheba, na Jorai, na Jakan, na Zia, na Eba.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.13",
            "verseOrgIds": [
              "1CH.5.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị a bụ ụmụ ndị ikom Abihail, nwa Huri, nwa Jaroa, nwa Gilead, nwa Maikel, nwa Jehishai, nwa Jado, nwa Buz.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.14",
            "verseOrgIds": [
              "1CH.5.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahi nwa Abdiel, nwa Guni bụ onyeisi nʼetiti ụmụnna ya.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.15",
            "verseOrgIds": [
              "1CH.5.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị Gad nwere ebe obibi na Gilead nʼime Bashan, na nʼobodo nta niile gbara ya gburugburu. Ha bikwa nʼebe ahịhịa anụ ụlọ na-ata jupụtara na Sharọn ruo nʼebe oke ala ha kwụsịrị.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.16",
            "verseOrgIds": [
              "1CH.5.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "E denyere aha ndị a niile nʼakwụkwọ usoro ọmụmụ nʼoge Jotam bụ eze Juda, na nʼoge Jeroboam bụ eze Izrel.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.17",
            "verseOrgIds": [
              "1CH.5.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị Ruben na ndị Gad, na ọkara ebo Manase nwere iri puku mmadụ anọ na anọ na narị asaa na iri isii (44,760) ndị jikeere ije agha, ndị dị ike, ndị a zụrụ iji ọta na mma agha, na ụta ibu agha.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.18",
            "verseOrgIds": [
              "1CH.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha busoro ndị Haga, na Jetua, na Nafish na ndị Nodab agha.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.19",
            "verseOrgIds": [
              "1CH.5.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "E nyeere ha aka ibuso ha agha, Chineke nyefere ndị Haga na ndị niile na-enyere ha aka nʼaka ha, nʼihi na ha kpọkuru ya nʼoge ọgụ ahụ. Ọ zara ekpere ha nʼihi na ha tụkwasịrị ya obi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.20",
            "verseOrgIds": [
              "1CH.5.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha ji ike chịkọrọ anụ ụlọ ndị Haga, dị iri puku ịnyịnya kamel ise, narị puku atụrụ abụọ na iri puku ise, puku ịnyịnya ibu abụọ. Ha dọkpụkwara narị puku ndị mmadụ nʼagha.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.21",
            "verseOrgIds": [
              "1CH.5.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 5:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "E gbukwara ọtụtụ ndị mmadụ nʼihi na agha ahụ bụ nke Chineke lụrụ nʼonwe ya. Ha bichiri ala ahụ tutu ruo mgbe a dọọrọ Izrel niile nʼagha.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.22",
            "verseOrgIds": [
              "1CH.5.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ọkara ebo Manase",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 5:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọkara ebo Manase dị ukwuu nʼọnụọgụgụ; ha nwere ebe obibi ha site nʼala Bashan ruo Baal-Hemon, ya bụ, ruo Senia, ugwu Hemon.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.23",
            "verseOrgIds": [
              "1CH.5.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
