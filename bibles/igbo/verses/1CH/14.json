  "verseCount": 17,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "14",
        "style": "c",
        "sid": "1CH 14"
      },
      "items": [
        {
          "text": "14",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ezinaụlọ Devid",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiram bụ eze Taịa zitere Devid ndị ozi, na ndị ọkwa ǹka osisi na ndị na-edo nkume, ka ha nyere Devid aka iwu ụlọeze ya. O nyekwara ya osisi sida o ji ewu ụlọ ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.1",
            "verseOrgIds": [
              "1CH.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Devid ghọtara na",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.2",
            "verseOrgIds": [
              "1CH.14.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1CH.14.2",
                "verseOrgIds": [
                  "1CH.14.2"
                ]
              }
            }
          ]
        },
        {
          "text": "emeela ka o guzosie ike dịka eze ndị Izrel, na ebuliela alaeze ya elu nke ukwuu nʼihi ndị ya Izrel.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.2",
            "verseOrgIds": [
              "1CH.14.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Devid lụrụ ndị inyom ọzọ mgbe o jere biri na Jerusalem. Nke a mere ka ọ mụọ ọtụtụ ụmụ nwoke na ụmụ nwanyị.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.3",
            "verseOrgIds": [
              "1CH.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị a bụkwa aha ụmụ a mụụrụ ya nʼebe ahụ: Shamua, Shobab, Netan, Solomọn,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.4",
            "verseOrgIds": [
              "1CH.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibha, Elishua, Elpelet,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.5",
            "verseOrgIds": [
              "1CH.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noga, Nefeg, Jafia,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.6",
            "verseOrgIds": [
              "1CH.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elishama, Beeliada na Elifelet.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.7",
            "verseOrgIds": [
              "1CH.14.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Devid emerie ndị Filistia",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ndị Filistia nụrụ na eteela Devid mmanụ ị bụ eze ndị Izrel niile, ha pụrụ nʼigwe ha ịchọ ya. Ma Devid nụrụ maka ya, jikere pụọ izute ha.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.8",
            "verseOrgIds": [
              "1CH.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ndị Filistia bịara, bukọrọ ihe niile dị na Ndagwurugwu Refaim.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.9",
            "verseOrgIds": [
              "1CH.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Devid jụrụ Chineke ase sị, \"Ọ bụ m gaa buso ndị Filistia agha? Ị ga-enyefe ha nʼaka m?\"",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.10",
            "verseOrgIds": [
              "1CH.14.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1CH 14:10"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1CH.14.10",
                "verseOrgIds": [
                  "1CH.14.10"
                ]
              }
            }
          ]
        },
        {
          "text": "zara sị ya, \"Gaa, aga m enyefe ha nʼaka gị.\"",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.10",
            "verseOrgIds": [
              "1CH.14.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, Devid na ndị ikom ya gara Baal-Perazim, meriekwa ha nʼebe ahụ. O kwuru sị, \"Chineke enupula megide ndị iro m site nʼaka m, dịka idee mmiri si enupu.\" Nʼihi ya, a kpọrọ ebe ahụ Baal Perazim.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.11",
            "verseOrgIds": [
              "1CH.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị Filistia hapụrụ chi niile ha nʼebe ahụ, Devid nyere iwu ka e suo ha niile ọkụ.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.12",
            "verseOrgIds": [
              "1CH.14.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị Filistia bukwara agha bịa na ndagwurugwu ahụ ọzọ.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.13",
            "verseOrgIds": [
              "1CH.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi nke a, Devid jụrụ Chineke ase ọzọ. Chineke sịrị ya, \"Esitekwala nʼihu buso ha agha, kama gbaa ha gburugburu, buso ha agha na ncherita ihu osisi balsam ndị ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.14",
            "verseOrgIds": [
              "1CH.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngwangwa ị nụrụ ụda ikiri ụkwụ nʼelu osisi balsam ndị ahụ, mgbe ahụ ka unu ga-apụ ibu agha, nʼihi na nke a pụtara na Chineke eburula unu ụzọ pụọ, itigbu ndị agha Filistia.\"",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.15",
            "verseOrgIds": [
              "1CH.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Devid mere dịka Chineke nyere ya nʼiwu. Ha tigburu ndị agha Filistia site na Gibiọn ruo Gaza.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.16",
            "verseOrgIds": [
              "1CH.14.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, aha Devid bidoro na-ewu ewu;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.17",
            "verseOrgIds": [
              "1CH.14.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1CH.14.17",
                "verseOrgIds": [
                  "1CH.14.17"
                ]
              }
            }
          ]
        },
        {
          "text": "tinyekwara ụjọ ya nʼobi mba niile.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.17",
            "verseOrgIds": [
              "1CH.14.17"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "1CH.15",
    "number": "15",
    "bookId": "1CH"
  },
