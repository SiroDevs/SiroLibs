  "verseCount": 32,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "23",
        "style": "c",
        "sid": "1CH 23"
      },
      "items": [
        {
          "text": "23",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ndị Livayị",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Devid ghọrọ nnọọ agadi, ụbọchị ndụ ya jukwara ya afọ, o mere Solomọn nwa ya, eze Izrel.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.1",
            "verseOrgIds": [
              "1CH.23.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼoge a, ọ kpọkọtara ndị ndu Izrel niile, tinyekwara ndị nchụaja na ndị Livayị.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.2",
            "verseOrgIds": [
              "1CH.23.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "A gụrụ ndị Livayị niile ọnụ, bụ ndị gbara iri afọ atọ gbagoo, chọpụta na ha dị iri puku ndị ikom atọ na asatọ nʼọnụọgụgụ.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.3",
            "verseOrgIds": [
              "1CH.23.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Devid sịrị, \"Nʼime ndị a, ka iri puku ndị ikom abụọ na anọ bụrụ ndị ga-ahụ maka ọrụ ụlọnsọ ukwu",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.4",
            "verseOrgIds": [
              "1CH.23.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1CH.23.4",
                "verseOrgIds": [
                  "1CH.23.4"
                ]
              }
            }
          ]
        },
        {
          "text": ", puku ndị ikom isii a bụrụ ndịisi na ndị ikpe,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.4",
            "verseOrgIds": [
              "1CH.23.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "puku ndị ikom anọ abụrụ ndị nche ọnụ ụzọ ama, ebe puku ndị ikom anọ ndị ọzọ ga-eji ihe egwu dị iche iche nke m kwadobere maka ito",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.5",
            "verseOrgIds": [
              "1CH.23.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1CH.23.5",
                "verseOrgIds": [
                  "1CH.23.5"
                ]
              }
            }
          ]
        },
        {
          "text": ", na-eto ya.\"",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.5",
            "verseOrgIds": [
              "1CH.23.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Devid kewara ndị Livayị nʼoke, nʼoke dịka ụmụ ndị ikom Livayị si dị: Geshọn, Kohat na Merari.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ikwu Geshọn",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "E kekwara ikwu Geshọn ụzọ abụọ dịka ụmụ ya si dị,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.7",
            "verseOrgIds": [
              "1CH.23.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 23:7"
      },
      "items": [
        {
          "text": "Ladan na Shimei.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.7",
            "verseOrgIds": [
              "1CH.23.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị sitere nʼezinaụlọ Ladan dị ndị ikom atọ:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.8",
            "verseOrgIds": [
              "1CH.23.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 23:8"
      },
      "items": [
        {
          "text": "Jehiel, onyeisi ha, Zetam na Juel.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.8",
            "verseOrgIds": [
              "1CH.23.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụmụ Shimei bụ,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.9",
            "verseOrgIds": [
              "1CH.23.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 23:9"
      },
      "items": [
        {
          "text": "Shelomot, Haziel na Haran, ha dị ndị ikom atọ.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.9",
            "verseOrgIds": [
              "1CH.23.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 23:9"
      },
      "items": [
        {
          "text": "Ndị a niile bụ ndịisi ezinaụlọ nʼikwu Ladan.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.9",
            "verseOrgIds": [
              "1CH.23.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụmụ Shimei bụ,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.10",
            "verseOrgIds": [
              "1CH.23.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 23:10"
      },
      "items": [
        {
          "text": "Jahat, Ziza,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.10",
            "verseOrgIds": [
              "1CH.23.10"
            ]
          }
        },
        {
          "text": "Jeush na Beriya.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.10",
            "verseOrgIds": [
              "1CH.23.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 23:10"
      },
      "items": [
        {
          "text": "Ha dị ndị ikom anọ.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.10",
            "verseOrgIds": [
              "1CH.23.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jahat bụ onye mbụ, Ziza onye nke abụọ. Ma Jeush na Beriya amụtaghị ọtụtụ ụmụ ndị ikom. Nʼihi ya, a gụnyekọtara ha dịka otu ezinaụlọ, kenye ha otu ọrụ.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.11",
            "verseOrgIds": [
              "1CH.23.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ikwu Kohat",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụmụ ndị ikom Kohat bụ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.12",
            "verseOrgIds": [
              "1CH.23.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 23:12"
      },
      "items": [
        {
          "text": "Amram, Izha, Hebrọn na Uziel. Ha dị ndị ikom anọ.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.12",
            "verseOrgIds": [
              "1CH.23.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụmụ ndị ikom Amram bụ,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.13",
            "verseOrgIds": [
              "1CH.23.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 23:13"
      },
      "items": [
        {
          "text": "Erọn na Mosis.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.13",
            "verseOrgIds": [
              "1CH.23.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 23:13"
      },
      "items": [
        {
          "text": "Erọn ka e kewapụrụ iche, ido ya nsọ ya na ụmụ ya ruo ebighị ebi, maka ido ihe niile kachasị nsọ nsọ, ịchụ aja nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.13",
            "verseOrgIds": [
              "1CH.23.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1CH.23.13",
                "verseOrgIds": [
                  "1CH.23.13"
                ]
              }
            }
          ]
        },
        {
          "text": ", ije ozi nʼihu ya nakwa ikwupụta ngọzị nʼaha ya ruo ebighị ebi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.13",
            "verseOrgIds": [
              "1CH.23.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụmụ Mosis, onye nke Chineke ka a gụnyekọtara dịka ndị si nʼebo Livayị.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.14",
            "verseOrgIds": [
              "1CH.23.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụmụ ndị ikom Mosis bụ,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.15",
            "verseOrgIds": [
              "1CH.23.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 23:15"
      },
      "items": [
        {
          "text": "Geshọm na Elieza.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.15",
            "verseOrgIds": [
              "1CH.23.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụmụ ndị ikom Geshọm bụ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.16",
            "verseOrgIds": [
              "1CH.23.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 23:16"
      },
      "items": [
        {
          "text": "Shubuel, onye mbụ.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.16",
            "verseOrgIds": [
              "1CH.23.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụmụ ụmụ Elieza bụ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.17",
            "verseOrgIds": [
              "1CH.23.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 23:17"
      },
      "items": [
        {
          "text": "Rehabaya onye mbụ.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.17",
            "verseOrgIds": [
              "1CH.23.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 23:17"
      },
      "items": [
        {
          "text": "Elieza amụtaghị ụmụ ndị ikom ọzọ, ma ụmụ ndị ikom Rohabaya dị ọtụtụ.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.17",
            "verseOrgIds": [
              "1CH.23.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụmụ ndị ikom Izha bụ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.18",
            "verseOrgIds": [
              "1CH.23.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 23:18"
      },
      "items": [
        {
          "text": "Shelomit onye mbụ.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.18",
            "verseOrgIds": [
              "1CH.23.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 23:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụmụ ndị ikom Hebrọn bụ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.19",
            "verseOrgIds": [
              "1CH.23.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 23:19"
      },
      "items": [
        {
          "text": "Jereaya onye mbụ, na Amaraya, onye nke abụọ,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.19",
            "verseOrgIds": [
              "1CH.23.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 23:19"
      },
      "items": [
        {
          "text": "Jahaziel onye nke atọ, na Jekameam, onye nke anọ.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.19",
            "verseOrgIds": [
              "1CH.23.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 23:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụmụ ndị ikom Uziel bụ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.20",
            "verseOrgIds": [
              "1CH.23.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 23:20"
      },
      "items": [
        {
          "text": "Maịka, onye mbụ, na Ishaya, onye nke abụọ.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.20",
            "verseOrgIds": [
              "1CH.23.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ikwu Merari",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 23:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụmụ ndị ikom Merari bụ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.21",
            "verseOrgIds": [
              "1CH.23.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 23:21"
      },
      "items": [
        {
          "text": "Mahali na Mushi",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.21",
            "verseOrgIds": [
              "1CH.23.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1CH 23:21"
      },
      "items": [
        {
          "text": "Ụmụ ndị ikom Mali bụ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.21",
            "verseOrgIds": [
              "1CH.23.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 23:21"
      },
      "items": [
        {
          "text": "Elieza na Kish",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.21",
            "verseOrgIds": [
              "1CH.23.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 23:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elieza nwụrụ na-amụtaghị ụmụ ndị ikom. Ọ bụ naanị ụmụ ndị inyom ka ọ mụtara. Ụmụ nwanne nna ha, ụmụ ndị ikom Kish, lụrụ ha.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.22",
            "verseOrgIds": [
              "1CH.23.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 23:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụmụ ndị ikom Mushi bụ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.23",
            "verseOrgIds": [
              "1CH.23.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 23:23"
      },
      "items": [
        {
          "text": "Mahali, Eda na Jeremot. Ha dị ndị ikom atọ.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.23",
            "verseOrgIds": [
              "1CH.23.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 23:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị a bụ ụmụ ụmụ Livayị dịka ezinaụlọ ha si dị, ndịisi ezi, dịka e si debanye aha, na dịka e si gụọ ha ọnụ nʼotu nʼotu, ya bụ ndị na-arụ ọrụ nʼụlọnsọ ukwu",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text"
            }
          ]
        },
        {
          "text": ", ndị gbara iri afọ abụọ gbagoo.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 23:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na Devid kwuru sị, \"Ebe ọ bụ na",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text"
            }
          ]
        },
        {
          "text": ", Chineke Izrel enyela ndị ya udo, ebe ọ bụkwa na ọ ga-ebi na Jerusalem ruo ebighị ebi.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CH 23:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ugbu a, ọ dịkwaghị mkpa ọ dị na ndị Livayị ga na-ebugharị ụlọ ikwu, maọbụ ngwongwo ọbụla nke ije ozi niile ya.\"",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 23:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ịgụ ndị Livayị ọnụ bụ otu nʼime ihe ikpeazụ Devid mere tupu ọ nwụọ. A gụrụ ndị Livayị gbara iri afọ abụọ gbagoo ọnụ.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 23:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọrụ e nyere ndị Livayị niile bụ inyere ụmụ Erọn ndị nchụaja aka nʼofufe nʼụlọnsọ ukwu",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.28",
            "verseOrgIds": [
              "1CH.23.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1CH.23.28",
                "verseOrgIds": [
                  "1CH.23.28"
                ]
              }
            }
          ]
        },
        {
          "text": ": ilekọta ogige, na ọnụụlọ nta ndị dị nʼakụkụ ya niile, na ime ka ihe nsọ niile dị ọcha, na ịrụ ọrụ ọbụla e nyere ha nʼụlọ Chineke.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.28",
            "verseOrgIds": [
              "1CH.23.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CH 23:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụkwa ọrụ ha iwebata achịcha a na-eche nʼihu Chineke, na ụtụ ọka e ji enye onyinye mkpụrụ ọka, na achịcha mbadamba a na-ejighị ihe na-eko achịcha mee. Ọrụ ha bụkwa ịgwakọta ihe e ji eme achịcha, na ighe ya, na ilekọta ihe ọtụtụ niile e ji atụ ihe.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.29",
            "verseOrgIds": [
              "1CH.23.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CH 23:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụtụtụ ọbụla, na anyasị ọbụla, ọ bụ ọrụ ha iguzo nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.30",
            "verseOrgIds": [
              "1CH.23.30"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1CH.23.30",
                "verseOrgIds": [
                  "1CH.23.30"
                ]
              }
            }
          ]
        },
        {
          "text": "ịbụ abụ otuto, na ekele.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.30",
            "verseOrgIds": [
              "1CH.23.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CH 23:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha na-enyekwa aka nʼihe gbasara aja nsure ọkụ a na-achụ nʼụbọchị izuike, na nʼoge mmemme ọnwa ọhụrụ, na mmemme ndị ọzọ niile a kara aka. Mgbe niile ka ha ga-eje ozi ha nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.31",
            "verseOrgIds": [
              "1CH.23.31"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1CH.23.31",
                "verseOrgIds": [
                  "1CH.23.31"
                ]
              }
            }
          ]
        },
        {
          "text": "dịka usoro ha na ọnụọgụgụ ha si dị.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.31",
            "verseOrgIds": [
              "1CH.23.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1CH 23:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, e tinyere ọrụ ilekọta ụlọ nzute",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.32",
            "verseOrgIds": [
              "1CH.23.32"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1CH.23.32",
                "verseOrgIds": [
                  "1CH.23.32"
                ]
              }
            }
          ]
        },
        {
          "text": ", na ụlọnsọ ukwu ahụ nʼaka ha. Ha ka ọ dịkwara inyere ndị ikwu ha, bụ ndị nchụaja ahụ, ụmụ Erọn, aka nʼọrụ ha niile nʼụlọnsọ ukwu ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.32",
            "verseOrgIds": [
              "1CH.23.32"
            ]
          }
        }
      ]
    }
  ],
