  "verseCount": 47,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "11",
        "style": "c",
        "sid": "1CH 11"
      },
      "items": [
        {
          "text": "11",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Devid aghọọ eze Izrel",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị Izrel niile gbakọtara bịakwute Devid na Hebrọn sị ya, \"Lee, ọkpụkpụ gị na anụ ahụ gị ka anyị bụ.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.1",
            "verseOrgIds": [
              "1CH.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼoge gara aga, ọ bụladị mgbe Sọl bụ eze, ọ bụ gị duuru ndị agha Izrel nʼọgụ niile, ma ọpụpụ ma mbata.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.2",
            "verseOrgIds": [
              "1CH.11.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1CH.11.2",
                "verseOrgIds": [
                  "1CH.11.2"
                ]
              }
            }
          ]
        },
        {
          "text": "bụ Chineke gị, sịrị gị, 'Ị ga-azụ ndị m, bụ Izrel, ị ga-abụkwa onye ga-achị ha.' \"",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.2",
            "verseOrgIds": [
              "1CH.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ndị okenye Izrel niile bịakwutere eze Devid na Hebrọn, ya na ha gbara ndụ nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.3",
            "verseOrgIds": [
              "1CH.11.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1CH.11.3",
                "verseOrgIds": [
                  "1CH.11.3"
                ]
              }
            }
          ]
        },
        {
          "text": "na Hebrọn. Ha tere ya mmanụ ịbụ eze Izrel, dịka",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.3",
            "verseOrgIds": [
              "1CH.11.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1CH.11.3",
                "verseOrgIds": [
                  "1CH.11.3"
                ]
              }
            }
          ]
        },
        {
          "text": "kwere na nkwa site nʼọnụ Samuel.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.3",
            "verseOrgIds": [
              "1CH.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Devid emerie Jerusalem",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Devid na ndị Izrel zọọrọ ije garuo Jerusalem nke bụ Jebus. Ma ndị Jebus bi nʼebe ahụ,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.4",
            "verseOrgIds": [
              "1CH.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "gwara Devid sị, \"Ị gaghị abata nʼebe a.\" Nʼagbanyeghị okwu ndị a, Devid dọtara ebe ahụ e wusiri ike nke Zayọn nʼagha, ya bụ obodo Devid.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.5",
            "verseOrgIds": [
              "1CH.11.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Devid ekwuolarị sị, \"Onye ọbụla buru ụzọ buo agha megide ndị Jebus ga-abụ onyeisi ọchịagha ndị agha.\" Joab nwa Zeruaya bụ onye mbụ gara, nʼihi ya, o nwetara ike ịbụ ọchịagha.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.6",
            "verseOrgIds": [
              "1CH.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Devid biiri nʼebe ahụ e wusiri ike. Ọ bụ nke a mere e ji akpọ ya obodo Devid.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.7",
            "verseOrgIds": [
              "1CH.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "O wuru obodo gburugburu ya, site na Milo ruo na mgbidi gbara ya gburugburu. Ma Joab wuzikwara akụkụ obodo ahụ nke fọdụrụ.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.8",
            "verseOrgIds": [
              "1CH.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Devid gara nʼihu na-adị ukwuu karịa, nʼihi na",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.9",
            "verseOrgIds": [
              "1CH.11.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1CH.11.9",
                "verseOrgIds": [
                  "1CH.11.9"
                ]
              }
            }
          ]
        },
        {
          "text": ", Onye pụrụ ime ihe niile, nọnyeere ya.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.9",
            "verseOrgIds": [
              "1CH.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ndị ọka agha Devid",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị a bụ ndịisi ndị dike nʼetiti ndị agha Devid. Ha na ndị Izrel niile nyere ịchị eze Devid ezi nkwado ime ka ọchịchị ya ruo nʼakụkụ niile nke ala ahụ, dịka",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.10",
            "verseOrgIds": [
              "1CH.11.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1CH.11.10",
                "verseOrgIds": [
                  "1CH.11.10"
                ]
              }
            }
          ]
        },
        {
          "text": "kwere na nkwa.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.10",
            "verseOrgIds": [
              "1CH.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nke a bụ ndekọ ọnụọgụgụ ndị dike nʼagha Devid nwere:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.11",
            "verseOrgIds": [
              "1CH.11.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1CH 11:11"
      },
      "items": [
        {
          "text": "Jashobeam, onye Hakmon, bụ onyeisi nʼetiti ndịisi ndị ọzọ. O weliri ùbe ya megide narị ndị ikom atọ, bụ ndị o gburu nʼotu mgbe ibu agha.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.11",
            "verseOrgIds": [
              "1CH.11.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye nke na-eso ya bụ Elieza nwa Dodayi, onye Ahohi, onye bụ otu nʼime ndị dike atọ ndị ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.12",
            "verseOrgIds": [
              "1CH.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya na Devid nọ na Pas Damin mgbe ndị Filistia zukọrọ nʼebe ahụ ibu agha. Nʼotu ebe, nke e nwere otu ubi jupụtara nʼọka balị, ma ndị agha Izrel si nʼọgbọ agha gbapụ ọsọ nʼihi ndị Filistia.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.13",
            "verseOrgIds": [
              "1CH.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ha were ọnọdụ ha nʼetiti ubi ahụ, ha napụtara ya, tigbuo ndị Filistia niile ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.14",
            "verseOrgIds": [
              "1CH.11.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1CH.11.14",
                "verseOrgIds": [
                  "1CH.11.14"
                ]
              }
            }
          ]
        },
        {
          "text": "nyere mmeri dị ukwuu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.14",
            "verseOrgIds": [
              "1CH.11.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mmadụ atọ nʼime iri ndịisi agha atọ ahụ jekwuru Devid na nkume dị nʼọgba Adulam, na mgbe otù ndị Filistia mara ụlọ ikwu ha na Ndagwurugwu Refaim.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.15",
            "verseOrgIds": [
              "1CH.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Devid nọ nʼebe ahụ ewusiri ike nʼoge ahụ, ma ọnọdụ ndị agha ndị Filistia dị na Betlehem.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.16",
            "verseOrgIds": [
              "1CH.11.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agụụ mmiri gụrụ Devid nke ukwuu, ọ sị, \"Ọ ga-amasị m ma ọ bụrụ na o nwere onye ga-ekunye m mmiri ọṅụṅụ site nʼolulu mmiri dị nso nʼọnụ ụzọ ama Betlehem!\"",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.17",
            "verseOrgIds": [
              "1CH.11.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, ha atọ wakpuru ọmụma ụlọ ikwu ndị Filistia, seta mmiri site nʼolulu mmiri ahụ dị nʼakụkụ ọnụ ụzọ ama Betlehem, bulatara ya Devid. Ma Devid jụrụ ịṅụ ya, kama ọ wufuru ya nʼala dịka onyinye nye",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.18",
            "verseOrgIds": [
              "1CH.11.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1CH.11.18",
                "verseOrgIds": [
                  "1CH.11.18"
                ]
              }
            }
          ]
        },
        {
          "text": ", kwuo sị,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.18",
            "verseOrgIds": [
              "1CH.11.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Chineke ekwela ka m mee nke a. M ga-aṅụ ọbara ndị ikom a, bụ ndị ji ndụ ha chụọ aja nʼihi ikute mmiri a?\" Nʼihi na ha ji ndụ ha chụọ aja ịga kute ya, Devid ekweghị aṅụ ya.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.19",
            "verseOrgIds": [
              "1CH.11.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1CH 11:19"
      },
      "items": [
        {
          "text": "Nke a bụ ụdị ike dike atọ ahụ kpara.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.19",
            "verseOrgIds": [
              "1CH.11.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abishai, nwanne Joab bụ onyeisi ndị ikom atọ ahụ. O weliri ùbe ya megide narị ndị ikom atọ, tigbukwaa ha niile. Nʼihi nke a, ọ ghọrọ onye a ma ama dịka mmadụ atọ ndị a.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.20",
            "verseOrgIds": [
              "1CH.11.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼetiti mmadụ atọ ahụ, a na-asọpụrụ ya karịa, ọ ghọrọ onyeisi ha. Ọ bụ ezie na-agụnyeghị ya dịka otu onye nʼime ha.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.21",
            "verseOrgIds": [
              "1CH.11.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Benaya, nwa Jehoiada, onye si Kabzeel, bụ dike nʼagha, kpara ike dị ukwuu. O tigburu dimkpa abụọ ndị Moab, ndị bụ ọkaka nʼagha. O rịdakwukwara ọdụm nʼime olulu na-amị amị nʼụbọchị mkpụrụ mmiri na-ezo, gbuo ya.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.22",
            "verseOrgIds": [
              "1CH.11.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "O tigburu otu nwoke onye Ijipt, nke ogologo ya dị mita abụọ na ọkara. Ọ bụ ezie na onye Ijipt ahụ ji ùbe buru ezigbo ibu nʼaka, nke okporo ya dịka nke onye na-ekwe akwa ji ekwe akwa, ma Benaya ji naanị mkpọ jekwuru ya, pụnara onye Ijipt ahụ ùbe dị ya nʼaka, jiri ya magbuo ya.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.23",
            "verseOrgIds": [
              "1CH.11.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 11:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nke a bụ ụdị ike Benaya nwa Jehoiada kpara. Ya onwe ya nwekwara aha dịka ndị dike atọ ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.24",
            "verseOrgIds": [
              "1CH.11.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "A na-asọpụrụ ya nʼebe ọ dị ukwuu karịa onye ọbụla nʼetiti iri dike atọ ndị ahụ, ma o rughị ogugo ndị dike atọ mbụ ahụ. Devid mere ya onyeisi ndị na-eche ya nche.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.25",
            "verseOrgIds": [
              "1CH.11.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
