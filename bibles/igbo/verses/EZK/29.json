          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nʼụbọchị ahụ, aga m eme ka otu mpi",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.21",
            "verseOrgIds": [
              "EZK.29.21"
            ]
          }
        },
        {
          "text": "puputara ụlọ Izrel. Aga m asaghekwa ọnụ gị nʼetiti ha. Mgbe ahụ, ha ga-amata na mụ onwe m bụ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.21",
            "verseOrgIds": [
              "EZK.29.21"
            ]
          }
