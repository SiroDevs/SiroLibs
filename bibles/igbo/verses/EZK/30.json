      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 30:11"
      },
      "items": [
        {
          "text": "Ha ga-amịpụta mma agha ha megide Ijipt,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.11",
            "verseOrgIds": [
              "EZK.30.11"
            ]
