      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 30:12"
      },
      "items": [
        {
          "text": "Aga m ewerekwa ala ahụ resi mba ndị ọjọọ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.12",
            "verseOrgIds": [
              "EZK.30.12"
            ]
