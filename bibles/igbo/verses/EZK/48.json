  "verseCount": 35,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "48",
        "style": "c",
        "sid": "EZK 48"
      },
      "items": [
        {
          "text": "48",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okike e kere ala ahụ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 48:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nke a bụ aha ebo niile, na ala ha ga-eketa:",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "EZK 48:1"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "EZK 48:1"
      },
      "items": [
        {
          "text": "\"Dan otu oke. Site na nsọtụ ugwu, nʼakụkụ ụzọ Hetlon ruo mbata Hamat. Haza Enan na oke ala ugwu Damaskọs, nke dị nʼakụkụ Hamat ga-abụ akụkụ oke ala ha site nʼakụkụ ọwụwa anyanwụ ruo nʼọdịda anyanwụ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.1",
            "verseOrgIds": [
              "EZK.48.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 48:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asha ga-enwe otu oke. Ọ ga-abụ nʼakụkụ oke ala Dan, site nʼọwụwa anyanwụ ruo nʼọdịda anyanwụ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.2",
            "verseOrgIds": [
              "EZK.48.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 48:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naftalị ga-enwe otu oke. Ọ ga-abụ nʼakụkụ oke ala Asha, site nʼọwụwa anyanwụ ruo nʼọdịda anyanwụ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.3",
            "verseOrgIds": [
              "EZK.48.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 48:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Manase nwere otu oke. Ọ ga-abụ nʼakụkụ oke ala Naftalị, site nʼọwụwa anyanwụ ruo nʼọdịda anyanwụ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.4",
            "verseOrgIds": [
              "EZK.48.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 48:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ifrem ga-enwe otu oke. Ọ ga-abụ nʼakụkụ oke ala Manase, site nʼọwụwa anyanwụ ruo nʼọdịda anyanwụ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.5",
            "verseOrgIds": [
              "EZK.48.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 48:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ruben ga-enwe otu oke. Ọ ga-abụ nʼakụkụ oke ala Ifrem, site nʼọwụwa anyanwụ ruo nʼọdịda anyanwụ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.6",
            "verseOrgIds": [
              "EZK.48.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 48:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Juda ga-enwe otu oke. Ọ ga-abụ nʼakụkụ oke ala Ruben, site nʼọwụwa anyanwụ ruo nʼọdịda anyanwụ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.7",
            "verseOrgIds": [
              "EZK.48.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 48:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ala nke ya na oke ala ndị Juda ga-agbatị site nʼọwụwa anyanwụ ruo nʼọdịda anyanwụ, ka ị ga-enye dịka onyinye pụrụ iche. Obosara ya ga-abụ ihe dị kilomita iri na atọ. Ogologo ya site nʼọwụwa anyanwụ ruo nʼọdịda anyanwụ ga-aha ka ala otu ebo ketara. Ụlọnsọ ukwu ahụ ga-adịkwa nʼetiti ya.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.8",
            "verseOrgIds": [
              "EZK.48.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 48:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ogologo ebe a ewepụtara iche nye",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.9",
            "verseOrgIds": [
              "EZK.48.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZK.48.9",
                "verseOrgIds": [
                  "EZK.48.9"
                ]
              }
            }
          ]
        },
        {
          "text": "ga-adị kilomita iri na atọ, obosara ya ga-abụ kilomita ise na ọkara.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.9",
            "verseOrgIds": [
              "EZK.48.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 48:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nke a ga-abụ ala dị nsọ e debere iche nye ndị nchụaja. Nʼakụkụ ugwu, ịdị ogologo ala ahụ ga-abụ kilomita iri na atọ. Nʼakụkụ ọdịda anyanwụ, ogologo ya bụ kilomita ise na ọkara. Ogologo nke akụkụ ndịda na nke ugwu bụ otu. Otu a kwa, ogologo nke akụkụ ọwụwa anyanwụ na ọdịda anyanwụ bụ otu. Ebe nsọ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.10",
            "verseOrgIds": [
              "EZK.48.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZK.48.10",
                "verseOrgIds": [
                  "EZK.48.10"
                ]
              }
            }
          ]
        },
        {
          "text": "ga-adị nʼetiti ya.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.10",
            "verseOrgIds": [
              "EZK.48.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 48:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ ga-adịrị ndị nchụaja, bụ ụmụ Zadọk ndị e doro nsọ, ndị sitere nʼikwesị ntụkwasị obi jeere m ozi, ndị na-esiteghị nʼiso ụzọ m kpafuo dịka ndị Izrel na agbụrụ Livayị mere mgbe ha mehiere.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.11",
            "verseOrgIds": [
              "EZK.48.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 48:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ onyinye pụrụ iche a na-enye ha site nʼala ahụ dị nsọ, bụ ala ahụ kachasị nsọ, nke ya na ala ndị Livayị nwekọrọ oke ala.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.12",
            "verseOrgIds": [
              "EZK.48.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 48:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nʼakụkụ ala ndị nchụaja, a ga-ekenye ndị Livayị ala nke ha. Ha ga-eketa ala nke ogologo ya bụ kilomita iri na atọ, nke obosara ya bụ kilomita ise na ọkara.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.13",
            "verseOrgIds": [
              "EZK.48.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 48:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "O nweghị akụkụ ala nsọ a a ga-ere ere, maọbụ nye ya ndị ọzọ, nʼihi na ihe dị nsọ ka ọ bụ nye",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.14",
            "verseOrgIds": [
              "EZK.48.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZK.48.14",
                "verseOrgIds": [
                  "EZK.48.14"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.14",
            "verseOrgIds": [
              "EZK.48.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 48:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ala nke fọdụrụ, nke ogologo ya dị kilomita iri na atọ, nke obosara ya dị kilomita ise na ọkara ga-abụ ala ọha. A ga-ewu ebe obibi nʼelu ya, wukwaa ebe ịzụ anụ ụlọ. Obodo ga-adị nʼetiti ya,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.15",
            "verseOrgIds": [
              "EZK.48.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 48:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "nke ogologo akụkụ ugwu ruru kilomita abụọ na ụma anọ, akụkụ ndịda ruru kilomita abụọ na ụma anọ, akụkụ ọwụwa anyanwụ ruru kilomita abụọ na ụma anọ, na akụkụ ọdịda anyanwụ rukwara kilomita abụọ na ụma.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.16",
            "verseOrgIds": [
              "EZK.48.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 48:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogologo nke ala ebe ịta nri nke ga-agba obodo ahụ gburugburu ga-aha nʼotu. Ọ ga-adị narị mita na iri mita atọ na ise nʼugwu, na ndịda narị mita na iri mita atọ na ise, nʼọwụwa anyanwụ narị mita na iri mita atọ na ise, nʼakụkụ nʼọdịda anyanwụ narị mita na iri mita atọ na ise.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.17",
            "verseOrgIds": [
              "EZK.48.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 48:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma nke ga-afọdụ na ya, nʼakụkụ oke ala ahụ dị nsọ nke gara ogologo ya niile, ga-abụ nʼakụkụ ọwụwa anyanwụ kilomita ise na ọkara nʼakụkụ ọdịda anyanwụ ga-abụkwa kilomita ise na ọkara. Ihe omume ya ga-abụ nri nye ndị ọrụ nke obodo ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.18",
            "verseOrgIds": [
              "EZK.48.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 48:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị ọrụ si nʼobodo, bụ ndị na-akọ ya ga-abụkwa ndị sị nʼebo niile nke Izrel.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.19",
            "verseOrgIds": [
              "EZK.48.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 48:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ala ahụ niile, ma ala ahụ e doro nsọ, ma ala ndị obodo, ga-adị kilomita iri na atọ nʼakụkụ ya ọbụla.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.20",
            "verseOrgIds": [
              "EZK.48.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 48:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ala niile fọdụrụ nʼakụkụ abụọ nke ala ahụ dị nsọ, na ala ndị obodo ga-abụ nke nwa eze. Ọ ga-agbatị ruo ọwụwa anyanwụ site nʼọtụtụ kilomita iri na atọ nke oke ahụ dọ nsọ ruo nʼoke ala ọwụwa anyanwụ, sitekwa na kilomita iri na atọ nʼakụkụ ọdịda anyanwụ ruo oke ala ọdịda anyanwụ. Akụkụ abụọ ndị a nke gbatịrị ruo nʼoke ala ndị obodo ga-abụ nke onye ọchịchị, ebe nsọ ahụ na ụlọ ukwu ahụ ga-adị nʼetiti ha.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.21",
            "verseOrgIds": [
              "EZK.48.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 48:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, oke ala nke ndị Livayị na ala ndị obodo ga-adị nʼetiti ala nke nwa eze nwee. Oke ala nke nwa eze ahụ ga-adị nʼetiti oke ala Juda na oke ala Benjamin.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.22",
            "verseOrgIds": [
              "EZK.48.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 48:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ala e nyere ebo fọdụrụ dị otu a:",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "EZK 48:23"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "EZK 48:23"
      },
      "items": [
        {
          "text": "\"Benjamin ga-enwe otu oke, nke sitere nʼọwụwa anyanwụ ruo nʼọdịda anyanwụ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.23",
            "verseOrgIds": [
              "EZK.48.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 48:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Simiọn ga-enwe otu oke; ha na ndị Benjamin ga-enwekọ otu oke ala nʼakụkụ ọwụwa anyanwụ na nʼakụkụ ọdịda anyanwụ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.24",
            "verseOrgIds": [
              "EZK.48.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 48:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaka ga-enwe otu oke; ha na ndị Simiọn ga-enwekọ oke ala nʼakụkụ ọwụwa anyanwụ, na nʼakụkụ ọdịda anyanwụ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.25",
            "verseOrgIds": [
              "EZK.48.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 48:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zebụlọn ga-enwe otu oke; ha na ndị Isaka ga-enwekọ oke ala nʼakụkụ ọwụwa anyanwụ, na nʼakụkụ ọdịda anyanwụ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.26",
            "verseOrgIds": [
              "EZK.48.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 48:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gad ga-enwe otu oke; ha na ndị Zebụlọn ga-enwekọ oke ala nʼakụkụ ọwụwa anyanwụ na nʼakụkụ ọdịda anyanwụ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.27",
            "verseOrgIds": [
              "EZK.48.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EZK 48:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma oke ala Gad nke chere ihu nʼakụkụ ndịda ga-esi na Tama ruo nʼiyi Meriba Kadesh, sorokwa ọdọ mmiri Ijipt ruo nʼosimiri Mediterenịa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.28",
            "verseOrgIds": [
              "EZK.48.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EZK 48:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nke a bụ ala unu ga-ekenye ebo Izrel niile dịka oke ha. Ha ga-abụkwara ha ihe nketa.\" Otu a ka Onye kachasị ihe niile elu, bụ",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwubiri ya.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ọnụ ụzọ ama obodo ọhụrụ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EZK 48:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ndị a ga-abụ ọnụ ụzọ ama e si apụ nʼobodo ahụ.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "EZK 48:30"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "EZK 48:30"
      },
      "items": [
        {
          "text": "\"Nʼakụkụ nke ugwu, nke ịdị ogologo mgbidi ya bụ kilomita abụọ,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.30",
            "verseOrgIds": [
              "EZK.48.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EZK 48:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "ọnụ ụzọ ama obodo ahụ ga-abụ aha ebo niile nke Izrel. Ọnụ ụzọ ama atọ nʼakụkụ ugwu ga-abụ ọnụ ụzọ ama Ruben, ọnụ ụzọ ama Juda, na ọnụ ụzọ ama Livayị.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.31",
            "verseOrgIds": [
              "EZK.48.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EZK 48:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼakụkụ ọwụwa anyanwụ, nke mgbidi ya dị kilomita abụọ nʼogologo, ọnụ ụzọ ama atọ ga-adị ya. Ha ga-aza ọnụ ụzọ ama Josef, ọnụ ụzọ ama Benjamin, na ọnụ ụzọ ama Dan.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.32",
            "verseOrgIds": [
              "EZK.48.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EZK 48:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼakụkụ ndịda, nke ogologo ya bụkwa kilomita abụọ, ọnụ ụzọ ama atọ ga-adị ya: ọnụ ụzọ ama Simiọn, ọnụ ụzọ ama Isaka, na ọnụ ụzọ ama Zebụlọn.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.33",
            "verseOrgIds": [
              "EZK.48.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EZK 48:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼakụkụ ọdịda anyanwụ nke ịdị ogologo mgbidi ya bụ kilomita abụọ, ọnụ ụzọ ama atọ ga-adị ya: ọnụ ụzọ ama Gad, ọnụ ụzọ ama Asha, na ọnụ ụzọ ama Naftalị.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.34",
            "verseOrgIds": [
              "EZK.48.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EZK 48:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Gburugburu obodo ahụ bụ kilomita iri.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "EZK 48:35"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EZK 48:35"
      },
      "items": [
        {
          "text": "\"Aha a ga-akpọ obodo ahụ site nʼoge ahụ gawa, ga-abụ, '",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.35",
            "verseOrgIds": [
              "EZK.48.35"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZK.48.35",
                "verseOrgIds": [
                  "EZK.48.35"
                ]
              }
            }
          ]
        },
        {
          "text": "nọ nʼebe ahụ.' \"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.35",
            "verseOrgIds": [
              "EZK.48.35"
            ]
          }
        }
      ]
    }
  ],
