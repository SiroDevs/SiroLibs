            "verseOrgIds": [
              "EZK.21.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mụ onwe m ga-akụkọtakwa ọbụ aka m,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.17",
            "verseOrgIds": [
              "EZK.21.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 21:17"
      },
      "items": [
        {
          "text": "ime ka iwe m jụrụ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.17",
            "verseOrgIds": [
              "EZK.21.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 21:17"
      },
      "items": [
        {
          "text": "Mụ onwe m bụ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.17",
            "verseOrgIds": [
              "EZK.21.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZK.21.17",
                "verseOrgIds": [
                  "EZK.21.22"
                ]
              }
            }
          ]
        },
        {
          "text": "ekwuola.\"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.17",
            "verseOrgIds": [
              "EZK.21.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 21:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okwu nke",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.18",
            "verseOrgIds": [
              "EZK.21.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZK.21.18",
                "verseOrgIds": [
                  "EZK.21.23"
                ]
              }
            }
          ]
        },
        {
          "text": "ruru m ntị, sị,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.18",
            "verseOrgIds": [
              "EZK.21.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nwa nke mmadụ mee ụzọ abụọ nke mma agha eze Babilọn ga-eso. Ka ụzọ abụọ ndị a malite nʼotu obodo. Dee ihe ngosi manye ha nʼebe ahụ ụzọ wara abụọ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.19",
            "verseOrgIds": [
              "EZK.21.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 21:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mee ka otu nʼime ụzọ ndị ahụ bụrụ ebe mma agha ga-esi bịa megide Raba nke Amọn, ka nke ọzọ megide Juda na Jerusalem, bụ ebe e wusiri ike.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.20",
            "verseOrgIds": [
              "EZK.21.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na eze Babilọn ga-abịa guzo nʼebe ahụ ụzọ wara abụọ,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.21",
            "verseOrgIds": [
              "EZK.21.26"
            ]
          }
        },
        {
          "text": "nʼisi ụzọ abụọ ahụ ịchọ ihe ama. Ọ ga-esite nʼịgba àkụ nke ife nza, jụọ ase site nʼaka arụsị ya niile, nyochakwaa umeju ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.21",
            "verseOrgIds": [
              "EZK.21.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 21:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼụzọ dị nʼaka nri, ka ihe ịjụ ase banyere Jerusalem ga-esi bịa. Nʼebe ahụ ka ọ ga-ewu ihe niile ha ji etida mgbidi obodo ahụ. Nʼebe ahụ ka ọ ga-anọ nye iwu maka igbuchapụ ndị niile, na iwu ido ihe e ji etipu mgbidi nʼọnụ ụzọ ama niile, na iwu a ga-eji wuo nkwasa agha na mgbidi e ji ebuso ya agha.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.22",
            "verseOrgIds": [
              "EZK.21.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 21:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ ga-adị ha dịka ọjụjụ ase nke na-abaghị uru, nye ndị ahụ ṅụrụ ha iyi, ma ọ ga-echetara ha ihe ọjọọ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.23",
            "verseOrgIds": [
              "EZK.21.28"
            ]
          }
        },
        {
          "text": "ha mere, dọkpụrụ ha nʼike.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.23",
            "verseOrgIds": [
              "EZK.21.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 21:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nʼihi ya, ihe ndị a ka Onye kachasị ihe niile elu, bụ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.24",
            "verseOrgIds": [
              "EZK.21.29"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZK.21.24",
                "verseOrgIds": [
                  "EZK.21.29"
                ]
              }
            }
          ]
        },
        {
          "text": "kwuru. 'Ebe ọ bụ na unu esitela na nnupu isi unu mee ka e cheta ajọ omume unu, si otu a na-ekpughe mmehie unu nʼihe niile unu na-eme. Ebe ọ bụ na unu emeela ihe dị otu a, a ghaghị ịdọta unu nʼagha.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.24",
            "verseOrgIds": [
              "EZK.21.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 21:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Gị onye rụrụ arụ, onye na-emebi iwu, gị nwa eze nʼIzrel, gị onye ụbọchị ahụhụ ya rurula,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.25",
            "verseOrgIds": [
              "EZK.21.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 21:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "ihe ndị a ka Onye kachasị ihe niile elu, bụ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.26",
            "verseOrgIds": [
              "EZK.21.31"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZK.21.26",
                "verseOrgIds": [
                  "EZK.21.31"
                ]
              }
            }
          ]
        },
        {
          "text": "sịrị, yipụ okpueze gị, ya na akwa ị na-atụghị nʼisi. Ihe agaghị adịkwa dịka o si adị na mbụ. A ga-ebuli ndị dị ala, wedata ndị dị elu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.26",
            "verseOrgIds": [
              "EZK.21.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 21:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbibi, mbibi. Aga m eme ka ọ ghọọ ihe e bibiri ebibi. A gaghị eweghachikwa ya ọzọ tutu ruo mgbe onye ahụ o ruuru nʼizi ezi bịara. Ya ka m ga-enyefe ya nʼaka.'",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.27",
            "verseOrgIds": [
              "EZK.21.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EZK 21:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ma gị onwe gị, Nwa nke mmadụ, buo amụma kwuo, 'Ihe ndị a ka Onye kachasị ihe niile elu, bụ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.28",
            "verseOrgIds": [
              "EZK.21.33"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZK.21.28",
                "verseOrgIds": [
                  "EZK.21.33"
                ]
              }
            }
          ]
        },
        {
          "text": "kwuru megide ndị Amọn nʼihi ịkwa emo ha:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.28",
            "verseOrgIds": [
              "EZK.21.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 21:28"
      },
      "items": [
        {
          "text": "\" 'Lee mma agha, lee mma agha,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.28",
            "verseOrgIds": [
              "EZK.21.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 21:28"
      },
      "items": [
        {
          "text": "nke a mịpụtara maka oke ogbugbu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.28",
            "verseOrgIds": [
              "EZK.21.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 21:28"
      },
      "items": [
        {
          "text": "E hichaziela ya mee ka ọ dị nkọ iripịa,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.28",
            "verseOrgIds": [
              "EZK.21.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 21:28"
      },
      "items": [
        {
          "text": "ka ọ na-egbu amụma dịka amụma egbe eluigwe.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.28",
            "verseOrgIds": [
              "EZK.21.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EZK 21:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼagbanyeghị ọhụ ụgha nke a na-ahụ banyere unu,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.29",
            "verseOrgIds": [
