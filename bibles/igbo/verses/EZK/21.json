      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 21:15"
      },
      "items": [
        {
          "text": "etinyela ya nʼaka onye ga-egbu oke ogbugbu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.15",
            "verseOrgIds": [
              "EZK.21.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gị mma agha, ebe ọbụla ị chọrọ, ebe ọbụla i nwere ike, gbuo onye ọbụla,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.16",
            "verseOrgIds": [
              "EZK.21.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 21:16"
      },
      "items": [
        {
          "text": "ma ọ nọ gị nʼaka nri",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.16",
            "verseOrgIds": [
              "EZK.21.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 21:16"
      },
      "items": [
        {
          "text": "ma ọ nọ gị nʼaka ekpe.",
          "type": "text",
          "attrs": {
