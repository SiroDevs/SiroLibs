          "type": "text",
          "attrs": {
            "verseId": "EZK.21.15",
            "verseOrgIds": [
              "EZK.21.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 21:15"
      },
      "items": [
        {
          "text": "nʼihi na edoziela m mma agha ahụ nʼọnụ ụzọ ama ha niile",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.15",
            "verseOrgIds": [
              "EZK.21.20"
            ]
          }
        }
      ]
    },
    {
