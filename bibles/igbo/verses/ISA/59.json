{
  "id": "ISA.59",
  "number": "59",
  "bookId": "ISA",
  "reference": "Aịzaya 59",
  "copyright": "Biblica® Open Igbo Contemporary Bible™ Copyright © 1980, 1988, 2019, 2020 by Biblica, Inc. Used with permission. All rights reserved worldwide.",
  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "59",
        "style": "c",
        "sid": "ISA 59"
      },
      "items": [
        {
          "text": "59",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mmehie, ikwupụta mmehie, na mgbapụta",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 59:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼezie, aka Onyenwe anyị adịghị mkpụmkpụ nke na o nweghị ike ịzọpụta,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.1",
            "verseOrgIds": [
              "ISA.59.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 59:1"
      },
      "items": [
        {
          "text": "ntị ya adịghịkwa arọ nke na o nweghị ike ịnụ ihe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.1",
            "verseOrgIds": [
              "ISA.59.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 59:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kama mmehie unu ekewapụla unu",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.2",
            "verseOrgIds": [
              "ISA.59.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 59:2"
      },
      "items": [
        {
          "text": "site nʼebe Chineke unu nọ;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.2",
            "verseOrgIds": [
              "ISA.59.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 59:2"
      },
      "items": [
        {
          "text": "mmehie niile unu ezokwala ihu ya site nʼebe unu nọ,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.2",
            "verseOrgIds": [
              "ISA.59.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 59:2"
      },
      "items": [
        {
          "text": "nke mere na ọ chọkwaghị ige ntị ọzọ.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.2",
            "verseOrgIds": [
              "ISA.59.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 59:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na aka unu jupụtara na ntụpọ ọbara,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.3",
            "verseOrgIds": [
              "ISA.59.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 59:3"
      },
      "items": [
        {
          "text": "mkpịsịaka unu bụkwa nke mmehie merụrụ.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.3",
            "verseOrgIds": [
              "ISA.59.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 59:3"
      },
      "items": [
        {
          "text": "Egbugbere ọnụ unu ekwuola okwu ụgha,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.3",
            "verseOrgIds": [
              "ISA.59.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 59:3"
      },
      "items": [
        {
          "text": "ire unu na-atamukwa ihe ọjọọ.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.3",
            "verseOrgIds": [
              "ISA.59.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 59:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ dịghị onye na-ekpe ikpe ziri ezi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.4",
            "verseOrgIds": [
              "ISA.59.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 59:4"
      },
      "items": [
        {
          "text": "ọ dịkwaghị onye na-eji ikwesi ntụkwasị obi kpee ikpe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.4",
            "verseOrgIds": [
              "ISA.59.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 59:4"
      },
      "items": [
        {
          "text": "Ha na-adabere nʼịrụ ụka nʼenweghị isi, ha na-ekwu okwu ụgha,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.4",
            "verseOrgIds": [
              "ISA.59.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 59:4"
      },
      "items": [
        {
          "text": "ha na-atụrụ ime okwu na ụka mụọkwa ajọ ihe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.4",
            "verseOrgIds": [
              "ISA.59.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 59:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha na-avụ akwa ajụala,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.5",
            "verseOrgIds": [
              "ISA.59.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 59:5"
      },
      "items": [
        {
          "text": "na-akpakwa akwụ udide.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.5",
            "verseOrgIds": [
              "ISA.59.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 59:5"
      },
      "items": [
        {
          "text": "Onye ọbụla riri akwa ha ga-anwụ,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.5",
            "verseOrgIds": [
              "ISA.59.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 59:5"
      },
      "items": [
        {
          "text": "mgbe ọbụla otu kụwara, ọ bụ agwọ ajụala na-esi nʼime ya apụta.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.5",
            "verseOrgIds": [
              "ISA.59.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 59:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akwụ udide ha abaghị uru iji mee uwe,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.6",
            "verseOrgIds": [
              "ISA.59.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 59:6"
      },
      "items": [
        {
          "text": "ha enweghị ike iji ihe ha mepụtara kpuchie onwe ha.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.6",
            "verseOrgIds": [
              "ISA.59.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 59:6"
      },
      "items": [
        {
          "text": "Ọrụ ha niile bụ ajọ ọrụ,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.6",
            "verseOrgIds": [
              "ISA.59.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 59:6"
      },
      "items": [
        {
          "text": "omume ihe ike jupụtara ha nʼaka.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.6",
            "verseOrgIds": [
              "ISA.59.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 59:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụkwụ ha na-eme ngwangwa ịgbaba nʼime mmehie,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.7",
            "verseOrgIds": [
              "ISA.59.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 59:7"
      },
      "items": [
        {
          "text": "ha na-emekwa ngwa ịkwafu ọbara ndị o nweghị ihe ọjọọ ha mere.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.7",
            "verseOrgIds": [
              "ISA.59.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 59:7"
      },
      "items": [
        {
          "text": "Ha na-achụso echiche ajọ ihe,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.7",
            "verseOrgIds": [
              "ISA.59.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 59:7"
      },
      "items": [
        {
          "text": "ọrụ mbibi na ntipịa bụ ejiri mara nke ụzọ ha niile.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.7",
            "verseOrgIds": [
              "ISA.59.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 59:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha amaghị ihe ụzọ udo bụ,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.8",
            "verseOrgIds": [
              "ISA.59.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 59:8"
      },
      "items": [
        {
          "text": "ikpe ziri ezi adịghị nʼụzọ ha na-eso.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.8",
            "verseOrgIds": [
              "ISA.59.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 59:8"
      },
      "items": [
        {
          "text": "Ha e mela ụzọ ha ka ha gbagọọ agbagọ.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.8",
            "verseOrgIds": [
              "ISA.59.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 59:8"
      },
      "items": [
        {
          "text": "Ndị niile na-eso ya anaghị enweta udo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.8",
            "verseOrgIds": [
              "ISA.59.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 59:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere ikpe ziri ezi dị anya nʼebe anyị nọ,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.9",
            "verseOrgIds": [
              "ISA.59.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 59:9"
      },
      "items": [
        {
          "text": "ezi omume adịghị erute anyị nso.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.9",
            "verseOrgIds": [
              "ISA.59.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 59:9"
      },
      "items": [
        {
          "text": "Anyị na-ele anya ìhè, ma lee, ọchịchịrị ka anyị na-ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.9",
            "verseOrgIds": [
              "ISA.59.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 59:9"
      },
      "items": [
        {
          "text": "Anyị na-ele anya mmụke ìhè ma anyị na-ejegharị nʼime oke ọchịchịrị.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.9",
            "verseOrgIds": [
              "ISA.59.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 59:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyị na-asọgharị ìsì na mgbidi dịka ndị na-enweghị anya,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.10",
            "verseOrgIds": [
              "ISA.59.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 59:10"
      },
      "items": [
        {
          "text": "na-asọgharị isi dịka ndị na-enweghị anya;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.10",
            "verseOrgIds": [
              "ISA.59.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 59:10"
      },
      "items": [
        {
          "text": "anyị na-ada na-akpọbi ukwu nʼetiti ehihie dịka a ga-asị na ọ bụ oge chi ojiji,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.10",
            "verseOrgIds": [
              "ISA.59.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 59:10"
      },
      "items": [
        {
          "text": "nʼetiti ndị nwere ezi ndụ, anyị nọ ka ndị nwụrụ anwụ.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.10",
            "verseOrgIds": [
              "ISA.59.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 59:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyị na-agbọ ụja dịka bịa;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.11",
            "verseOrgIds": [
              "ISA.59.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 59:11"
      },
      "items": [
        {
          "text": "anyị na-akwasị akwa ike dịka nduru nʼeru ụjụ.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.11",
            "verseOrgIds": [
              "ISA.59.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 59:11"
      },
      "items": [
        {
          "text": "Anyị na-ele anya ikpe ziri ezi, ma ọ dịghị eru anyị aka;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.11",
            "verseOrgIds": [
              "ISA.59.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 59:11"
      },
      "items": [
        {
          "text": "anyị na-ele anya nzọpụta, ma ọ dị anya nʼebe anyị nọ.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.11",
            "verseOrgIds": [
              "ISA.59.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 59:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na mmehie anyị amụbaala nʼihu Onyenwe anyị;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.12",
            "verseOrgIds": [
              "ISA.59.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 59:12"
      },
      "items": [
        {
          "text": "ọ na-agbakwa ama megide anyị.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.12",
            "verseOrgIds": [
              "ISA.59.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 59:12"
      },
      "items": [
        {
          "text": "E, anyị makwaara ụdị ndị mmehie anyị bụ,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.12",
            "verseOrgIds": [
              "ISA.59.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 59:12"
      },
      "items": [
        {
          "text": "nʼihi na mmehie anyị dịkwa nʼihu anyị mgbe niile.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.12",
            "verseOrgIds": [
              "ISA.59.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 59:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyị maara nnupu isi anyị na ngọnarị anyị gọnarịrị",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.13",
            "verseOrgIds": [
              "ISA.59.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ISA.59.13",
                "verseOrgIds": [
                  "ISA.59.13"
                ]
              }
            }
          ]
        },
        {
          "text": ";",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.13",
            "verseOrgIds": [
              "ISA.59.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 59:13"
      },
      "items": [
        {
          "text": "anyị esitela nʼiso",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.13",
            "verseOrgIds": [
              "ISA.59.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ISA.59.13",
                "verseOrgIds": [
                  "ISA.59.13"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke anyị wezuga onwe anyị,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.13",
            "verseOrgIds": [
              "ISA.59.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 59:13"
      },
      "items": [
        {
          "text": "nọgide na-akpali mmegbu na nnupu isi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.13",
            "verseOrgIds": [
              "ISA.59.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 59:13"
      },
      "items": [
        {
          "text": "Okwu ọnụ anyị bụ okwu ụgha, nke anyị si nʼobi anyị tụpụta.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.13",
            "verseOrgIds": [
              "ISA.59.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 59:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụlọ ikpe anyị niile adịghị achọ onye ezi omume;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.14",
            "verseOrgIds": [
              "ISA.59.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 59:14"
      },
      "items": [
        {
          "text": "anyị amaghị ihe a na-akpọ ikpe ziri ezi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.14",
            "verseOrgIds": [
              "ISA.59.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 59:14"
      },
      "items": [
        {
          "text": "Eziokwu asọọla ngọngọ nʼama niile,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.14",
            "verseOrgIds": [
              "ISA.59.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 59:14"
      },
      "items": [
        {
          "text": "ihe ziri ezi apụghị ịbata.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.14",
            "verseOrgIds": [
              "ISA.59.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 59:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "E, eziokwu alaala;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.15",
            "verseOrgIds": [
              "ISA.59.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 59:15"
      },
      "items": [
        {
          "text": "onye ọbụla kwa nke na-achọ ibi ndụ ọma na-etinye onwe ya na nsogbu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.15",
            "verseOrgIds": [
              "ISA.59.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "ISA 59:15"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 59:15"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ISA.59.15",
                "verseOrgIds": [
                  "ISA.59.15"
                ]
              }
            }
          ]
        },
        {
          "text": "lere anya hụ ihe ọjọọ ndị a niile, nke na-enyeghị ya obi ụtọ;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.15",
            "verseOrgIds": [
              "ISA.59.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 59:15"
      },
      "items": [
        {
          "text": "ọ hụkwara na ikpe ziri ezi adịghị.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.15",
            "verseOrgIds": [
              "ISA.59.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 59:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ hụrụ na anyị enweghị onye inyeaka ọbụla;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.16",
            "verseOrgIds": [
              "ISA.59.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 59:16"
      },
      "items": [
        {
          "text": "o wutere ya na ọ dịghị onye na-arịọrọ anyị arịrịọ.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.16",
            "verseOrgIds": [
              "ISA.59.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 59:16"
      },
      "items": [
        {
          "text": "Ọ bụ ya mere o ji bata site nʼike aka ya na nʼezi omume ya,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.16",
            "verseOrgIds": [
              "ISA.59.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 59:16"
      },
      "items": [
        {
          "text": "bịa ịzọpụta anyị.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.16",
            "verseOrgIds": [
              "ISA.59.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 59:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ na-eyikwasị ezi omume dịka ngwa agha ikpuchi obi ya.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.17",
            "verseOrgIds": [
              "ISA.59.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 59:17"
      },
      "items": [
        {
          "text": "Okpu nke nzọpụta ka ọ na-eyikwasịkwa nʼisi ya.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.17",
            "verseOrgIds": [
              "ISA.59.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 59:17"
      },
      "items": [
        {
          "text": "Ọ bụkwa uwe ịbọ ọbọ na nke ekworo",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.17",
            "verseOrgIds": [
              "ISA.59.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 59:17"
      },
      "items": [
        {
          "text": "na ịnụ ọkụ na obi ka o ji kpuchie onwe ya.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.17",
            "verseOrgIds": [
              "ISA.59.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 59:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ ga-akwụghachi ndị iro ya",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.18",
            "verseOrgIds": [
              "ISA.59.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 59:18"
      },
      "items": [
        {
          "text": "dịka ajọ omume ha niile si dị.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.18",
            "verseOrgIds": [
              "ISA.59.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 59:18"
      },
      "items": [
        {
          "text": "Iwe ọkụ ya",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.18",
            "verseOrgIds": [
              "ISA.59.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 59:18"
      },
      "items": [
        {
          "text": "ka ọ ga-eji megide ndị iro ya niile",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.18",
            "verseOrgIds": [
              "ISA.59.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 59:18"
      },
      "items": [
        {
          "text": "bi na mba dị anya.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.18",
            "verseOrgIds": [
              "ISA.59.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 59:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Site nʼọdịda anyanwụ, ndị mmadụ ga-asọpụrụ aha",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.19",
            "verseOrgIds": [
              "ISA.59.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ISA.59.19",
                "verseOrgIds": [
                  "ISA.59.19"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.19",
            "verseOrgIds": [
              "ISA.59.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 59:19"
      },
      "items": [
        {
          "text": "sitekwa nʼọwụwa anyanwụ, ha ga-atụ egwu ebube ya.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.19",
            "verseOrgIds": [
              "ISA.59.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 59:19"
      },
      "items": [
        {
          "text": "Nʼihi na ọ ga-abịa dịka idee mmiri",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.19",
            "verseOrgIds": [
              "ISA.59.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 59:19"
      },
      "items": [
        {
          "text": "nke nkume,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.19",
            "verseOrgIds": [
              "ISA.59.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ISA.59.19",
                "verseOrgIds": [
                  "ISA.59.19"
                ]
              }
            }
          ]
        },
        {
          "text": "na-agba na-aga.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.19",
            "verseOrgIds": [
              "ISA.59.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 59:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Onye mgbapụta ga-abịa na Zayọn;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.20",
            "verseOrgIds": [
              "ISA.59.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 59:20"
      },
      "items": [
        {
          "text": "ọ ga-abịakwute ụmụ Jekọb ndị na-esite na mmehie ha chegharịa.\"",
          "type": "text",
