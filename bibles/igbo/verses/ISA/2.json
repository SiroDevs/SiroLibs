      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ugwu nsọ",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nke a bụ ihe Aịzaya nwa Emọz hụrụ banyere Juda na Jerusalem.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.1",
            "verseOrgIds": [
              "ISA.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼụbọchị ikpeazụ,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.2",
            "verseOrgIds": [
              "ISA.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 2:2"
      },
      "items": [
        {
          "text": "ugwu nke ụlọnsọ ukwu",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.2",
            "verseOrgIds": [
              "ISA.2.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ISA.2.2",
                "verseOrgIds": [
                  "ISA.2.2"
                ]
              }
            }
          ]
        },
        {
          "text": ", ga-abụ nke eguzobere",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.2",
            "verseOrgIds": [
              "ISA.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 2:2"
      },
      "items": [
        {
          "text": "dịka ugwu dị elu karịa ugwu niile,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.2",
            "verseOrgIds": [
              "ISA.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 2:2"
      },
      "items": [
        {
          "text": "a ga-ebuli ya elu karịa ugwu nta niile,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.2",
            "verseOrgIds": [
              "ISA.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 2:2"
      },
      "items": [
        {
          "text": "mba niile dị iche iche ga-eruba nʼime ya dịka iyi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.2",
            "verseOrgIds": [
              "ISA.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọtụtụ ndị mmadụ ga-abịa ma sịkwa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.3",
            "verseOrgIds": [
              "ISA.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 2:3"
      },
      "items": [
        {
          "text": "\"Bịanụ, ka anyị rigoruo ugwu",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.3",
            "verseOrgIds": [
              "ISA.2.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ISA.2.3",
                "verseOrgIds": [
                  "ISA.2.3"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.3",
            "verseOrgIds": [
              "ISA.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 2:3"
      },
      "items": [
        {
          "text": "ka anyị gaa nʼụlọnsọ ukwu Chineke nke Jekọb.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.3",
            "verseOrgIds": [
              "ISA.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 2:3"
      },
      "items": [
        {
          "text": "Ọ ga-akụziri anyị ụzọ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.3",
            "verseOrgIds": [
              "ISA.2.3"
            ]
          }
        },
        {
          "text": "ya niile,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.3",
            "verseOrgIds": [
              "ISA.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 2:3"
      },
      "items": [
        {
          "text": "ka anyị nwe ike jee ije nʼokporoụzọ ya niile.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.3",
            "verseOrgIds": [
              "ISA.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 2:3"
      },
      "items": [
        {
          "text": "Iwu ga-esi na Zayọn pụta,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.3",
            "verseOrgIds": [
              "ISA.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 2:3"
      },
      "items": [
        {
          "text": "okwu",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.3",
            "verseOrgIds": [
              "ISA.2.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ISA.2.3",
                "verseOrgIds": [
                  "ISA.2.3"
                ]
              }
            }
          ]
        },
        {
          "text": "ga-esitekwa na Jerusalem pụta.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.3",
            "verseOrgIds": [
              "ISA.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ ga-ekpe ikpe nʼetiti mba niile,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.4",
            "verseOrgIds": [
              "ISA.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 2:4"
      },
      "items": [
        {
          "text": "doziekwa esemokwu dị nʼetiti ndị dị iche iche.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.4",
            "verseOrgIds": [
              "ISA.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 2:4"
      },
      "items": [
        {
          "text": "Ha ga-akpụgharịkwa mma agha ha niile mee ka ha bụrụ mma oge;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.4",
            "verseOrgIds": [
              "ISA.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 2:4"
      },
      "items": [
        {
          "text": "kpụgharịkwa ùbe ha mee ya ka ọ ghọọ mma ịkwacha osisi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.4",
            "verseOrgIds": [
              "ISA.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 2:4"
      },
      "items": [
        {
          "text": "Mba ọbụla agakwaghị ebuli mma agha megide mba ọzọ,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.4",
            "verseOrgIds": [
              "ISA.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 2:4"
      },
      "items": [
        {
          "text": "maọbụ zụọ onwe ha nʼịlụ agha ọzọ.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.4",
            "verseOrgIds": [
              "ISA.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unu ụlọ Jekọb, bịanụ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.5",
            "verseOrgIds": [
              "ISA.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 2:5"
      },
      "items": [
        {
          "text": "ka anyị na-agbaso ìhè nke",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.5",
            "verseOrgIds": [
              "ISA.2.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ISA.2.5",
                "verseOrgIds": [
                  "ISA.2.5"
                ]
              }
            }
          ]
        },
        {
          "text": "anyị.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.5",
            "verseOrgIds": [
              "ISA.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ụbọchị",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gị, bụ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.6",
            "verseOrgIds": [
              "ISA.2.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ISA.2.6",
                "verseOrgIds": [
                  "ISA.2.6"
                ]
              }
            }
          ]
        },
        {
          "text": ", Ị gbakụtala ndị gị,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.6",
            "verseOrgIds": [
              "ISA.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 2:6"
      },
      "items": [
        {
          "text": "bụ ụlọ Jekọb azụ.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.6",
            "verseOrgIds": [
              "ISA.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 2:6"
      },
      "items": [
        {
          "text": "Nʼihi na ha jupụtara nʼikpere arụsị nke si nʼọwụwa anyanwụ.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.6",
            "verseOrgIds": [
              "ISA.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 2:6"
      },
      "items": [
        {
          "text": "Ha na-ajụkwa ase dịka ndị Filistia.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.6",
            "verseOrgIds": [
              "ISA.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 2:6"
      },
      "items": [
        {
          "text": "Ha na ndị na-ekpere arụsị na-ejikọkwa aka.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.6",
            "verseOrgIds": [
              "ISA.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ala ha jupụtara nʼọlaọcha na ọlaedo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.7",
            "verseOrgIds": [
              "ISA.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 2:7"
      },
      "items": [
        {
          "text": "ha bara ụba nke ukwuu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.7",
            "verseOrgIds": [
              "ISA.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 2:7"
      },
      "items": [
        {
          "text": "Ala ha jupụtara nʼịnyịnya.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.7",
            "verseOrgIds": [
              "ISA.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 2:7"
      },
      "items": [
        {
          "text": "Ụgbọ agha ha dịkwa ukwuu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.7",
            "verseOrgIds": [
              "ISA.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ala ha jupụtara nʼarụsị,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.8",
            "verseOrgIds": [
              "ISA.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 2:8"
      },
      "items": [
        {
          "text": "ha na-akpọ isiala nye ihe ndị ahụ ha ji aka ha kpụọ,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.8",
            "verseOrgIds": [
              "ISA.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 2:8"
      },
      "items": [
        {
          "text": "ihe ndị ahụ mkpịsịaka ha kpụrụ.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.8",
            "verseOrgIds": [
              "ISA.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
