  "verseCount": 6,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "20",
        "style": "c",
        "sid": "ISA 20"
      },
      "items": [
        {
          "text": "20",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Amụma e bụrụ banyere Ijipt na Kush",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 20:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼafọ ahụ, Sagọn, eze Asịrịa, zipụrụ ọchịagha onye ọkwa ya kasị ukwuu, ka ọ gaa buso Ashdọd agha. Ọ gara meriekwa ya nʼagha.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.20.1",
            "verseOrgIds": [
              "ISA.20.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼoge ahụ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.20.2",
            "verseOrgIds": [
              "ISA.20.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ISA.20.2",
                "verseOrgIds": [
                  "ISA.20.2"
                ]
              }
            }
          ]
        },
        {
          "text": "kwuru okwu site nʼọnụ Aịzaya nwa Emọz. Ọ sịrị ya, \"Yipụ uwe mkpe iyi nʼahụ, ya na akpụkpọụkwụ dị gị nʼụkwụ.\" O mere otu a, ọ gbaara ọtọ, jegharịakwa nʼụkwụ efu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.20.2",
            "verseOrgIds": [
              "ISA.20.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.20.3",
            "verseOrgIds": [
              "ISA.20.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ISA.20.3",
                "verseOrgIds": [
                  "ISA.20.3"
                ]
              }
            }
          ]
        },
        {
          "text": "sịrị, \"Dị ka ohu m Aịzaya si gbara ọtọ jegharịa nʼụkwụ efu afọ atọ ndị a niile, ọ bụ ihe ama na ihe ịdọ aka na ntị na-egosi ihe gaje ịbịakwasị ndị Ijipt na ndị Kush.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.20.3",
            "verseOrgIds": [
              "ISA.20.3"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "ISA.20.3",
            "verseOrgIds": [
              "ISA.20.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na otu a ka eze Asịrịa ga-esi kpụrụ ndị Ijipt na ndị Kush ọ dọtara nʼagha. Ha ga-agba ọtọ na-ejegharị nʼụkwụ efu, ma nwantakịrị ma okenye. Otule ha gba ọtọ ga-abụrụ Ijipt ihe ihere.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.20.4",
            "verseOrgIds": [
              "ISA.20.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Egwu ga-ejide ndị ahụ niile nwere nchekwube nʼike Kush, na ndị ahụ niile jiri Ijipt nyaa isi ga-ada mba. Ihere ga-emekwa ha.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.20.5",
            "verseOrgIds": [
              "ISA.20.5"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "ISA.20.5",
            "verseOrgIds": [
              "ISA.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼụbọchị ahụ, ndị ahụ dịnyeere ha, bụ ndị bi nʼọnụ mmiri ha ga-asị, 'Ọ bụrụ na ihe dị otu a dakwasịrị ndị Ijipt anyị tụkwasịrị obi inyere anyị aka, na ịnapụta anyị site nʼaka eze Asịrịa, ebeekwanụ ka anyị ga-agbaga?' \"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.20.6",
            "verseOrgIds": [
              "ISA.20.6"
            ]
          }
        }
      ]
    }
  ],
