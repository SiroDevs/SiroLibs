        "number": "4",
        "style": "c",
        "sid": "ISA 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼoge ahụ, ndị ikom ole na ole ga-afọdụ ndụ.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.1",
            "verseOrgIds": [
              "ISA.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 4:1"
      },
      "items": [
        {
          "text": "Nke a ga-eme ka ndị inyom asaa na-azọ otu nwoke.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.1",
            "verseOrgIds": [
              "ISA.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 4:1"
      },
      "items": [
        {
          "text": "Ha ga-abịakwute ya sị ya \"Kwere ka anyị niile bụrụ ndị nwunye gị!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.1",
            "verseOrgIds": [
              "ISA.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 4:1"
      },
      "items": [
        {
          "text": "Anyị ga-akpara onwe anyị nri,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.1",
            "verseOrgIds": [
              "ISA.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 4:1"
      },
      "items": [
        {
          "text": "zụọra onwe anyị akwa. Naanị kwere ka anyị na-aza aha gị,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.1",
            "verseOrgIds": [
              "ISA.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 4:1"
      },
      "items": [
        {
          "text": "ka a ghara ịkọ anyị ọnụ.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.1",
            "verseOrgIds": [
              "ISA.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Alaka",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼụbọchị ahụ,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.2",
            "verseOrgIds": [
              "ISA.4.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ISA.4.2",
                "verseOrgIds": [
                  "ISA.4.2"
                ]
              }
            }
          ]
        },
        {
          "text": "ga-eme ka Alaka",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.2",
            "verseOrgIds": [
              "ISA.4.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ISA.4.2",
                "verseOrgIds": [
                  "ISA.4.2"
                ]
              }
            }
          ]
        },
        {
          "text": "mabiga mma oke, ma nwekwa ebube dị ukwuu. Ndị fọdụrụ ndụ nʼIzrel ga-enweta ihe ubi ga-enye ha ọṅụ, na nke ga-ewetara ha obi nganga na mmụọ ịnya isi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.2",
            "verseOrgIds": [
              "ISA.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị ahapụrụ na Zayọn, ndị nọ na Jerusalem ka a ga-akpọ ndị dị nsọ, bụ ndị ahụ niile e dere aha ha nʼetiti ndị bi nʼime Jerusalem.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.3",
            "verseOrgIds": [
              "ISA.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onyenwe anyị ga-asachapụ unyi niile nke ndị inyom Zayọn, ọ ga-asachapụkwa ọbara niile dị na Jerusalem site na mmụọ nke ikpe, na mmụọ nke ọkụ.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.4",
            "verseOrgIds": [
              "ISA.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.5",
            "verseOrgIds": [
              "ISA.4.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ISA.4.5",
                "verseOrgIds": [
                  "ISA.4.5"
                ]
              }
            }
          ]
        },
        {
          "text": "ga-ewuru ugwu Zayọn niile na ndị niile zukọrọ nʼebe ahụ ndo ga-ekpuchi ha niile. Ihe ọ ga-eji mee ndo a bụ igwe ojii na anwụrụ ọkụ nke ga-adịrị ha nʼehihie, na ọkụ na-enwu enwu, nke ga-adịrị ha nʼabalị. Ebube ahụ ga-abụ ihe mkpuchi nye ha.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.5",
            "verseOrgIds": [
              "ISA.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ ga-abụrụ ha ebe mgbaba na ndo ime ka okpomọkụ nke ehihie hapụ ịchagbu ha. Ọ ga-abụkwara ha ebe izere ndụ, na ebe nzuzo pụọ nʼoke ifufe na mmiri.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.6",
            "verseOrgIds": [
              "ISA.4.6"
            ]
          }
        }
      ]
    }
  ],
