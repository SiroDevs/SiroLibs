      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 55:10"
      },
      "items": [
        {
          "text": "meekwa ka ọ mịa mkpụrụ nye onye na-akụ ihe ọkụkụ, bụrụkwa ihe oriri nye onye na-eri nri.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.10",
            "verseOrgIds": [
              "ISA.55.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
