      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 55:12"
      },
      "items": [
        {
          "text": "a ga-esikwa nʼebe ahụ dupụta unu nʼudo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.12",
            "verseOrgIds": [
              "ISA.55.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 55:12"
      },
      "items": [
        {
          "text": "Ugwu ukwu niile, na ugwu nta niile",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.12",
            "verseOrgIds": [
              "ISA.55.12"
            ]
          }
        }
      ]
