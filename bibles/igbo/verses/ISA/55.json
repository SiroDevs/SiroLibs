      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 55:12"
      },
      "items": [
        {
          "text": "na osisi niile nke ubi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.12",
            "verseOrgIds": [
              "ISA.55.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 55:12"
      },
      "items": [
        {
          "text": "ga-eti mkpu ọṅụ,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.12",
            "verseOrgIds": [
              "ISA.55.12"
            ]
          }
