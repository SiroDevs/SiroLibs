            "number": "11",
            "style": "v",
            "sid": "ISA 55:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otu a ka okwu si m nʼọnụ pụọ si adị.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.11",
            "verseOrgIds": [
              "ISA.55.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 55:11"
      },
      "items": [
        {
          "text": "Ana m ezipu ya, ọ gaghị alọghachikwute m nʼefu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.11",
            "verseOrgIds": [
              "ISA.55.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 55:11"
      },
      "items": [
        {
          "text": "Ọ ga-emezu ihe niile m chọrọ ka o mee,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.11",
            "verseOrgIds": [
              "ISA.55.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 55:11"
      },
      "items": [
        {
          "text": "baakwa ụba ebe ọbụla m zigara ya.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.11",
            "verseOrgIds": [
              "ISA.55.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
