      "attrs": {
        "style": "q2",
        "vid": "ISA 55:13"
      },
      "items": [
        {
          "text": "ebe uke toro, osisi mietul ga-eto na ya.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.13",
            "verseOrgIds": [
              "ISA.55.13"
            ]
          }
