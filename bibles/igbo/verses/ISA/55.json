  "verseCount": 13,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "55",
        "style": "c",
        "sid": "ISA 55"
      },
      "items": [
        {
          "text": "55",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bịanụ ndị akpịrị na-akpọ nkụ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 55:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gee ntị, bịa onye ọbụla akpịrị na-akpọ nkụ,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.1",
            "verseOrgIds": [
              "ISA.55.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 55:1"
      },
      "items": [
        {
          "text": "bịanụ na mmiri,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.1",
            "verseOrgIds": [
              "ISA.55.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 55:1"
      },
      "items": [
        {
          "text": "unu ndị na-enweghị ego",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.1",
            "verseOrgIds": [
              "ISA.55.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 55:1"
      },
      "items": [
        {
          "text": "bịanụ zụọ, riekwa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.1",
            "verseOrgIds": [
              "ISA.55.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 55:1"
      },
      "items": [
        {
          "text": "Bịanụ, zuru mmanya na mmiri ara ehi",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.1",
            "verseOrgIds": [
              "ISA.55.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 55:1"
      },
      "items": [
        {
          "text": "na-ejighị ego na-arụghị ọnụahịa ọbụla.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.1",
            "verseOrgIds": [
              "ISA.55.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 55:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi gịnị ka i ji na-atụfu ego gị ịzụ ihe na-abụghị ezi nri?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.2",
            "verseOrgIds": [
              "ISA.55.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 55:2"
      },
      "items": [
        {
          "text": "Gịnị mere i ji na-adọgbu onwe gị nʼọrụ nʼihe na-apụghị iju gị afọ?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.2",
            "verseOrgIds": [
              "ISA.55.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 55:2"
      },
      "items": [
        {
          "text": "Gee ntị, geenụ m ntị nke ọma, rie ezigbo nri",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.2",
            "verseOrgIds": [
              "ISA.55.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 55:2"
      },
      "items": [
        {
          "text": "mkpụrụobi gị ga-enwe afọ ojuju na nri dị ezi mma!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.2",
            "verseOrgIds": [
              "ISA.55.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 55:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Tọọnụ ntị unu nʼala, bịakwute m!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.3",
            "verseOrgIds": [
              "ISA.55.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 55:3"
      },
      "items": [
        {
          "text": "Gee ntị, ka inwe ike dị ndụ.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.3",
            "verseOrgIds": [
              "ISA.55.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 55:3"
      },
      "items": [
        {
          "text": "Mụ na unu ga-aba nʼọgbụgba ndụ ebighị ebi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.3",
            "verseOrgIds": [
              "ISA.55.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 55:3"
      },
      "items": [
        {
          "text": "bụ ịhụnanya m kwesiri ntụkwasị obi nke m kwere Devid na nkwa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.3",
            "verseOrgIds": [
              "ISA.55.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 55:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lee, emere m ya ka ọ ghọọrọ ndị niile dị iche iche onyeama,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.4",
            "verseOrgIds": [
              "ISA.55.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 55:4"
      },
      "items": [
        {
          "text": "ka ọ bụrụ onyendu na onyeisi ọchịchị nye ndị niile dị iche iche.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.4",
            "verseOrgIds": [
              "ISA.55.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 55:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼezie, gị onwe gị ga-akpọku mba dị iche iche na i maghị,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.5",
            "verseOrgIds": [
              "ISA.55.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 55:5"
      },
      "items": [
        {
          "text": "mba ndị ahụ na-amaghị gị ga-ejikwa ọsọ gbakwute gị,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.5",
            "verseOrgIds": [
              "ISA.55.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 55:5"
      },
      "items": [
        {
          "text": "nʼihi",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.5",
            "verseOrgIds": [
              "ISA.55.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ISA.55.5",
                "verseOrgIds": [
                  "ISA.55.5"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke gị,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.5",
            "verseOrgIds": [
              "ISA.55.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 55:5"
      },
      "items": [
        {
          "text": "Onye nsọ nke Izrel,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.5",
            "verseOrgIds": [
              "ISA.55.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 55:5"
      },
      "items": [
        {
          "text": "nʼihi na o meela ka ị bụrụ ihe dị oke mma.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.5",
            "verseOrgIds": [
              "ISA.55.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 55:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chọọnụ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.6",
            "verseOrgIds": [
              "ISA.55.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ISA.55.6",
                "verseOrgIds": [
                  "ISA.55.6"
                ]
              }
            }
          ]
        },
        {
          "text": "mgbe a ga-achọta ya.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.6",
            "verseOrgIds": [
              "ISA.55.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 55:6"
      },
      "items": [
        {
          "text": "Kpọkuonụ ya mgbe ọ nọ nso.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.6",
            "verseOrgIds": [
              "ISA.55.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 55:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka onye na-eme ihe ọjọọ hapụ ụzọ ya,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.7",
            "verseOrgIds": [
              "ISA.55.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 55:7"
      },
      "items": [
        {
          "text": "ka onye ajọ omume hapụ echiche ọjọọ ya niile.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.7",
            "verseOrgIds": [
              "ISA.55.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 55:7"
      },
      "items": [
        {
          "text": "Ka ha tụgharịa bịakwute",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.7",
            "verseOrgIds": [
              "ISA.55.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ISA.55.7",
                "verseOrgIds": [
                  "ISA.55.7"
                ]
              }
            }
          ]
        },
        {
          "text": ", ọ ga-emere ha ebere,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.7",
            "verseOrgIds": [
              "ISA.55.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 55:7"
      },
      "items": [
        {
          "text": "ha bịakwute Chineke anyị, nʼihi na ọ ga-agbaghara ha mmehie ha niile.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.7",
            "verseOrgIds": [
              "ISA.55.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 55:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nʼihi na echiche m ha abụghị echiche unu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.8",
            "verseOrgIds": [
              "ISA.55.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 55:8"
      },
      "items": [
        {
          "text": "ụzọ unu niile, ha abụkwaghị ụzọ m,\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.8",
            "verseOrgIds": [
              "ISA.55.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 55:8"
      },
      "items": [
        {
          "text": "ka",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.8",
            "verseOrgIds": [
              "ISA.55.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ISA.55.8",
                "verseOrgIds": [
                  "ISA.55.8"
                ]
              }
            }
          ]
        },
        {
          "text": "kwupụtara.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.8",
            "verseOrgIds": [
              "ISA.55.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 55:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nʼihi na dịka eluigwe si dị elu karịa ụwa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.9",
            "verseOrgIds": [
              "ISA.55.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 55:9"
      },
      "items": [
        {
          "text": "otu a ka ụzọ m niile si dị elu karịa ụzọ unu niile,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.9",
            "verseOrgIds": [
              "ISA.55.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 55:9"
      },
      "items": [
        {
          "text": "otu a kwa ka echiche m niile si dị elu karịa echiche unu niile.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.9",
            "verseOrgIds": [
              "ISA.55.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 55:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dịka mmiri na mkpụrụ mmiri",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.10",
            "verseOrgIds": [
              "ISA.55.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 55:10"
      },
      "items": [
        {
          "text": "si esi nʼeluigwe ada nʼụwa",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.10",
            "verseOrgIds": [
              "ISA.55.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 55:10"
      },
      "items": [
        {
          "text": "na-alaghachighị nʼeluigwe",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.10",
            "verseOrgIds": [
              "ISA.55.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 55:10"
      },
      "items": [
        {
          "text": "ma ọ bụrụ na o meghị ka mmiri dee ala,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.10",
            "verseOrgIds": [
              "ISA.55.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 55:10"
      },
      "items": [
        {
          "text": "mee ka ihe ubi pupụta, too eto,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.10",
            "verseOrgIds": [
              "ISA.55.10"
            ]
          }
        }
      ]
    },
