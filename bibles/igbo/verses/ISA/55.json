              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebe ogwu na-eto na mbụ, osisi junipa ga-eto na ya;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.13",
            "verseOrgIds": [
              "ISA.55.13"
            ]
