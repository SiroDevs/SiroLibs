      "attrs": {
        "style": "q2",
        "vid": "ISA 54:17"
      },
      "items": [
        {
          "text": "Ọzọ, ị ga-emeri ndị niile kpọrọ gị ikpe mmegide.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.17",
            "verseOrgIds": [
              "ISA.54.17"
            ]
          }
        }
      ]
