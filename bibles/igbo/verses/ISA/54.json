      "attrs": {
        "style": "q2",
        "vid": "ISA 54:12"
      },
      "items": [
        {
          "text": "jiri nkume na-egbu nweghenweghe wuo ọnụ ụzọ ama gị niile.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.12",
            "verseOrgIds": [
              "ISA.54.12"
            ]
          }
        }
