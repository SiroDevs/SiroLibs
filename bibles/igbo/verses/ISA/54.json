      "attrs": {
        "style": "q2",
        "vid": "ISA 54:15"
      },
      "items": [
        {
          "text": "onye ọbụla nke na-alụso gị ọgụ ga-abụ onye e meriri emeri.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.15",
            "verseOrgIds": [
              "ISA.54.15"
            ]
