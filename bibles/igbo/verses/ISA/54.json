          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Gị, onye a na-emekpa ahụ, onye oke ikuku ụwa a na-ebugharị, nke onye ọbụla na-adịghị akasị obi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.11",
            "verseOrgIds": [
