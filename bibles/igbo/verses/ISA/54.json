            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 54:11"
      },
      "items": [
        {
          "text": "lee, aga m e ji nkume tọkwọisi wugharịa gị,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.11",
            "verseOrgIds": [
              "ISA.54.11"
            ]
