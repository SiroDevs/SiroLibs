      "attrs": {
        "style": "q2",
        "vid": "ISA 54:10"
      },
      "items": [
        {
          "text": "wezugakwa ugwu nta niile site nʼọnọdụ ha,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.10",
            "verseOrgIds": [
              "ISA.54.10"
