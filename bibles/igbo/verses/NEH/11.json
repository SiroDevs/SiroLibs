{
  "id": "NEH.11",
  "number": "11",
  "bookId": "NEH",
  "reference": "Nehemaya 11",
  "copyright": "Biblica® Open Igbo Contemporary Bible™ Copyright © 1980, 1988, 2019, 2020 by Biblica, Inc. Used with permission. All rights reserved worldwide.",
  "verseCount": 36,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "11",
        "style": "c",
        "sid": "NEH 11"
      },
      "items": [
        {
          "text": "11",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ndị ọhụrụ ga-ebi na Jerusalem",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NEH 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ugbu a, ndịisi Izrel bi nʼobodo nsọ Jerusalem nʼoge a, ma e sitere nʼife nza họpụta otu ụzọ nʼime ụzọ iri nke ndị bi nʼobodo ndị ọzọ niile ka ha bịa biri na Jerusalem, bụ obodo nsọ ahụ, ebe ụzọ itoolu fọdụrụ bikwa nʼobodo nke aka ha.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.1",
            "verseOrgIds": [
              "NEH.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NEH 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị mmadụ toro ndị niile jiri afọ ofufu họrọ ịbịa soro biri na Jerusalem.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.2",
            "verseOrgIds": [
              "NEH.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NEH 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị a bụ ndịisi ala ahụ a na-achị achị ndị bịara biri na Jerusalem (ma ọtụtụ ndị Izrel, ndị nchụaja, ndị Livayị, ndị na-eje ozi nʼụlọnsọ na ụmụ ndị na-ejere Solomọn ozi biiri nʼobodo Juda, onye ọbụla nʼihe onwunwe ya nʼobodo ha dị iche iche.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NEH 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebe ndị ọzọkwa bụ ndị sitere na Juda na Benjamin, biiri na Jerusalem).",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "NEH 11:4"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "NEH 11:4"
      },
      "items": [
        {
          "text": "Ndị sitere nʼagbụrụ Juda bụ ndị a:",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.4",
            "verseOrgIds": [
              "NEH.11.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "NEH 11:4"
      },
      "items": [
        {
          "text": "Ataia nwa Uzaya, nwa Zekaraya, nwa Amaraya, nwa Shefataya, nwa Mahalalel, nwa Perez;",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.4",
            "verseOrgIds": [
              "NEH.11.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NEH 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Maaseia nwa Baruk, nwa Kol-Hoze, nwa Hazaia, nwa Adaya, nwa Joiarib, nwa Zekaraya, nwa onye Shilo.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.5",
            "verseOrgIds": [
              "NEH.11.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NEH 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọnụọgụgụ ụmụ Perez niile bi na Jerusalem dị narị anọ, na iri isii na asatọ (468). Ha bụ ndị ikom gbara dimkpa.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.6",
            "verseOrgIds": [
              "NEH.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NEH 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị sitere nʼagbụrụ Benjamin bụ,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.7",
            "verseOrgIds": [
              "NEH.11.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "NEH 11:7"
      },
      "items": [
        {
          "text": "Salu nwa Meshulam, nwa Joed, nwa Pedaia, nwa Kolaya, nwa Maaseia, nwa Itiel, nwa Jeshaya,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.7",
            "verseOrgIds": [
              "NEH.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NEH 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "ya na ndị na-eso ya bụ ụmụ Gabai na Salai. Ọnụọgụgụ ha dị narị itoolu na iri abụọ na asatọ (928).",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.8",
            "verseOrgIds": [
              "NEH.11.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NEH 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Juel nwa Zikri bụ onyeisi ha. Juda nwa Hasenua bụ onye na-eso ya, na onye na-achị akụkụ ọhụrụ nke obodo ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.9",
            "verseOrgIds": [
              "NEH.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NEH 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị sitere nʼetiti ndị nchụaja bụ,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.10",
            "verseOrgIds": [
              "NEH.11.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "NEH 11:10"
      },
      "items": [
        {
          "text": "Jedaya nwa Joiarib, na Jakin,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.10",
            "verseOrgIds": [
              "NEH.11.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NEH 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Seraya nwa Hilkaya, nwa Meshulam, nwa Zadọk, nwa Meraiot, nwa Ahitub onye na-elekọta ụlọ ukwuu Chineke.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.11",
            "verseOrgIds": [
              "NEH.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NEH 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọnụọgụgụ ndị ikom ha na ha na-arụkọ ọrụ nʼụlọ ukwu ahụ bụ narị asatọ na iri abụọ na abụọ (822).",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.12",
            "verseOrgIds": [
              "NEH.11.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "NEH 11:12"
      },
      "items": [
        {
          "text": "Adaya, nwa Jeroham, nwa Pelalaya, nwa Amzi, nwa Zekaraya, nwa Pashua nwa Malkija,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.12",
            "verseOrgIds": [
              "NEH.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NEH 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "na ndị ikom bụ ndịisi ezinaụlọ ndị so ya rụọ ọrụ dị narị abụọ na iri anọ na abụọ (242) nʼọnụọgụgụ,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.13",
            "verseOrgIds": [
              "NEH.11.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "NEH 11:13"
      },
      "items": [
        {
          "text": "Amashaị nwa Azarel, nwa Ahazai, nwa Meshilemot, nwa Imea,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.13",
            "verseOrgIds": [
              "NEH.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NEH 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "na ndị otu ya nʼọrụ ndị bụkwa dimkpa, dị otu narị na iri abụọ na asatọ (128) nʼọnụọgụgụ.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.14",
            "verseOrgIds": [
              "NEH.11.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "NEH 11:14"
      },
      "items": [
        {
          "text": "Onyeisi ha bụ Zabdiel nwa Hagedolin.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.14",
            "verseOrgIds": [
              "NEH.11.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NEH 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Site na ndị Livayị:",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.15",
            "verseOrgIds": [
              "NEH.11.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "NEH 11:15"
      },
      "items": [
        {
          "text": "Shemaya nwa Hashub, nwa Azrikam, nwa Hashabaya, nwa Buni,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.15",
            "verseOrgIds": [
              "NEH.11.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NEH 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Shabetai, na Jozabad, mmadụ abụọ na ndị ndu ndị Livayị, ndị ọ bụ ha na-arụ ọrụ dị nʼezi nke ụlọ Chineke;",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.16",
            "verseOrgIds": [
              "NEH.11.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NEH 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Matanaya nwa Mika, nwa Zabdi, nwa Asaf, bụ onyendu nke duru nʼekpere na ofufe ekele.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.17",
            "verseOrgIds": [
              "NEH.11.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "NEH 11:17"
      },
      "items": [
        {
          "text": "Bakbukaya onye nke abụọ nʼetiti ndị otu ya,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.17",
            "verseOrgIds": [
              "NEH.11.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "NEH 11:17"
      },
      "items": [
        {
          "text": "na Abda nwa Shamua, nwa Galal, nwa Jedutun, bụ ndị na-enyere ya aka.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.17",
            "verseOrgIds": [
              "NEH.11.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NEH 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọnụọgụgụ ndị Livayị niile nọ na obodo nsọ ahụ dị narị abụọ na iri asatọ na anọ (284).",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.18",
            "verseOrgIds": [
              "NEH.11.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NEH 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị nche ọnụ ụzọ ama,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.19",
            "verseOrgIds": [
              "NEH.11.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "NEH 11:19"
      },
      "items": [
        {
          "text": "Akub, Talmon na ndị otu ha dị otu narị na iri asaa na abụọ (172) nʼọnụọgụgụ, ha bụ ndị na-eche nche nʼọnụ ụzọ ama niile.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.19",
            "verseOrgIds": [
              "NEH.11.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NEH 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị fọdụrụ nʼIzrel, ha na ndị nchụaja, na ndị Livayị, nọ nʼobodo Juda niile, onye ọbụla nʼihe nketa ya.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.20",
            "verseOrgIds": [
              "NEH.11.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NEH 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị ahụ niile na-eje ozi nʼụlọnsọ bi nʼugwu Ofel. Ndịisi ha bụ Ziha na Gishpa.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.21",
            "verseOrgIds": [
              "NEH.11.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NEH 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye na-elekọta ndị Livayị bi na Jerusalem bụ Uzi, nwa Bani, nwa Hashabaya, nwa Matanaya, nwa Matanaia, nwa Mika. Uzi bụ otu onye si nʼikwu Asaf, ndị ọbụ abụ maka ije ozi nke ụlọ Chineke.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.22",
            "verseOrgIds": [
              "NEH.11.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NEH 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eze họpụtara ndị ọbụ abụ nyekwa ha ọrụ ha kwesiri ịrụ ụbọchị niile.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.23",
            "verseOrgIds": [
              "NEH.11.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NEH 11:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Petahaya nwa Meshezabel, onye bụ otu nʼagbụrụ Zera, nwa Juda, bụ onyeozi eze banyere ihe niile gbasara ndị mmadụ ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.24",
            "verseOrgIds": [
              "NEH.11.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NEH 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obodo ụfọdụ ebe ndị Juda bi bụ ndị a: Kiriat Aba, Dibọn, Jekabzeel na obodo nta ndị dị ha gburugburu,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.25",
            "verseOrgIds": [
              "NEH.11.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NEH 11:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jeshua, Molada, Bet-Pelet,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.26",
            "verseOrgIds": [
              "NEH.11.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NEH 11:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haza Shual, Bịasheba na obodo ya niile,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.27",
            "verseOrgIds": [
              "NEH.11.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NEH 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ziklag, Mekona na obodo ya niile,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.28",
            "verseOrgIds": [
              "NEH.11.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NEH 11:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "En-Rimọn, Zora, Jamut,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.29",
            "verseOrgIds": [
              "NEH.11.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NEH 11:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zanoa, Adulam na obodo nta dị ha gburugburu, Lakish, ala dị ya gburugburu, Azeka na obodo ya niile. Nke a pụtara na ndị mmadụ bi site na Bịasheba ruo na Ndagwurugwu Hinom.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.30",
            "verseOrgIds": [
              "NEH.11.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NEH 11:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị agbụrụ Benjamin biri na Geba, Mikmash, Aija, Betel na obodo dị ya gburugburu,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.31",
            "verseOrgIds": [
              "NEH.11.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NEH 11:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anatot, Nob, Ananaya,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.32",
            "verseOrgIds": [
              "NEH.11.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NEH 11:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hazọ, Rema, Gitaim,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.33",
            "verseOrgIds": [
              "NEH.11.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NEH 11:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hadid, Zeboim, Nebalat,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.34",
            "verseOrgIds": [
              "NEH.11.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "NEH 11:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lod, Ono na Ge Harashim.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.35",
            "verseOrgIds": [
              "NEH.11.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "NEH 11:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụfọdụ nʼotu ndị Livayị, ndị ebe obibi ha dị na Juda ka e zigara isoro biri nʼebo Benjamin.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.36",
            "verseOrgIds": [
              "NEH.11.36"
            ]
          }
        }
      ]
    }
  ],
