  "verseCount": 18,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "8",
        "style": "c",
        "sid": "NEH 8"
      },
      "items": [
        {
          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "nb"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NEH 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị mmadụ niile zukọrọ dịka otu onye na mbara ala dị nʼỌnụ Ụzọ Ama Mmiri. Ha gwara Ezra onye nkuzi ka ọ weta akwụkwọ Mosis, nke",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.1",
            "verseOrgIds": [
              "NEH.8.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NEH.8.1",
                "verseOrgIds": [
                  "NEH.8.1"
                ]
              }
            }
          ]
        },
        {
          "text": "nyere ndị Izrel nʼiwu.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.1",
            "verseOrgIds": [
              "NEH.8.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NEH 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, Ezra, onye nchụaja wepụtara akwụkwọ Iwu ahụ nʼụbọchị mbụ nke ọnwa asaa nʼihu mkpọkọta ahụ bụ nke ndị ikom na ndị inyom na onye ọbụla ga-aghọta ihe mejupụtara.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.2",
            "verseOrgIds": [
              "NEH.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NEH 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "O chere ihu nʼỌnụ Ụzọ Ama Mmiri were oke olu gụọ ya site nʼụtụtụ ruokwa ehihie nʼihu ndị nwoke, ndị nwanyị na ndị ọzọ nwere ike ịghọta ihe o na-agụ. Mmadụ niile gekwara ntị na ngụpụta nke akwụkwọ iwu ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.3",
            "verseOrgIds": [
              "NEH.8.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NEH 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezra onye ode akwụkwọ, rigoro nʼelu ihe mgbakwasị ụkwụ ha mere maka nke a. Ndị guzo nʼaka nri ya bụ, Matitaia, Shema, Anaia, Ụraya, Hilkaya na Maaseia. Ndị guzo nʼaka ekpe ya bụkwa ndị a: Pedaia, Mishael, Malkija, Hashum, Hashbadana, Zekaraya na Meshulam.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.4",
            "verseOrgIds": [
              "NEH.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NEH 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezra meghere akwụkwọ ahụ mgbe mmadụ niile na-ahụzu ya nʼihi na o guzoro nʼebe dị elu mgbe ọ na-agụ ya. Mmadụ niile guzoro ọtọ mgbe ọ na-agụ ya.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.5",
            "verseOrgIds": [
              "NEH.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NEH 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Ezra gọziri",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.6",
            "verseOrgIds": [
              "NEH.8.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NEH.8.6",
                "verseOrgIds": [
                  "NEH.8.6"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke ukwu ahụ, mmadụ niile zakwara sị; \"Amen! Amen!\" Ha chịlịri aka ha abụọ elu, kpọọ isiala nye",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.6",
            "verseOrgIds": [
              "NEH.8.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NEH.8.6",
                "verseOrgIds": [
                  "NEH.8.6"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.6",
            "verseOrgIds": [
              "NEH.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NEH 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị Livayị aha ha bụ Jeshua, Bani, Sherebaya, Jamin, Akub, Shabetai, Hodia, Maaseia, Kelita, Azaraya, Jozabad, Hanan na Pelia, kuziri ndị mmadụ ihe dị nʼIwu mee ka ha ghọta ya dịka ha guzo nʼebe ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.7",
            "verseOrgIds": [
              "NEH.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NEH 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha gụpụtara site nʼakwụkwọ iwu Chineke ahụ, sụgharịa ya, kọwazie ọkpụrụkpụ okwu niile dị nʼihe a gụpụtara, mee ka ndị mmadụ ghọta ihe a na-agụpụta nke ọma.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.8",
            "verseOrgIds": [
              "NEH.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NEH 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Nehemaya, onyeisi ọchịchị, na Ezra, ode akwụkwọ na onye nchụaja, na ndị Livayị ahụ na-atụziri ndị mmadụ ihe, gwara ndị ahụ niile sị: \"Taa bụ ụbọchị dị nsọ nye",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.9",
            "verseOrgIds": [
              "NEH.8.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NEH.8.9",
                "verseOrgIds": [
                  "NEH.8.9"
                ]
              }
            }
          ]
        },
        {
          "text": ", Chineke unu. Unu erula ụjụ maọbụ bee akwa.\" Nʼihi na ha niile na-akwa akwa mgbe ha na-ege ntị nʼokwu niile nke iwu ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.9",
            "verseOrgIds": [
              "NEH.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NEH 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nehemaya gwakwara ha sị; \"Laanụ nʼụlọ unu gaa mee mmemme oriri na ọṅụṅụ nyekwanụ ndị na-enweghị nke ha ga-eri. Ụbọchị taa dị nsọ nye Chineke anyị. Unu erukwala ụjụ, nʼihi na ọṅụ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.10",
            "verseOrgIds": [
              "NEH.8.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NEH.8.10",
                "verseOrgIds": [
                  "NEH.8.10"
                ]
              }
            }
          ]
        },
        {
          "text": "bụ ike unu.\"",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.10",
            "verseOrgIds": [
              "NEH.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NEH 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị Livayị mere ka ndị mmadụ ahụ nọrọ nwayọọ, na-asị, \"Nọrọnụ nwayọọ, nʼihi na taa bụ ụbọchị dị nsọ, ọ bụghị ụbọchị iru ụjụ na anya mmiri.\"",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.11",
            "verseOrgIds": [
              "NEH.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NEH 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, ha niile lawara ị ga rie ma ṅụọ, na ikenye ndị ọzọ site nʼihe ha nwere. Ha gakwara ime mmemme nke oke ọṅụ, nʼihi na ha ghọtara okwu agwara ha.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.12",
            "verseOrgIds": [
              "NEH.8.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NEH 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼụbọchị nke abụọ nke ọnwa ahụ, ndịisi ezinaụlọ niile na ndị nchụaja, na ndị Livayị, zukọrọ nʼebe Ezra, bụ onye nkuzi nọ, maka itinye uche nʼakwụkwọ iwu ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.13",
            "verseOrgIds": [
              "NEH.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NEH 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ha na-agụ ya, ha chọpụtara ebe",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.14",
            "verseOrgIds": [
              "NEH.8.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NEH.8.14",
                "verseOrgIds": [
                  "NEH.8.14"
                ]
              }
            }
          ]
        },
        {
          "text": "gwara Mosis sị ya na ụmụ Izrel kwesiri ibi nʼụlọ ikwu mgbe ọbụla a na-eme mmemme ụlọ ikwu nke a ga-eme nʼọnwa ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.14",
            "verseOrgIds": [
              "NEH.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NEH 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "O kwukwara na ha ga-ekwusa okwu a nʼobodo niile nke Juda na Jerusalem sị; \"Gaanụ nʼala ugwu ugwu gbute alaka osisi oliv ụlọ, na alaka oliv ọhịa, na alaka osisi mietul,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.15",
            "verseOrgIds": [
              "NEH.8.15"
            ]
          }
        },
        {
          "text": "na alaka nkwụ, na alaka osisi ndị ọzọ na-enye ndo nke a ga-eji wuo ebe unu ga-ebi tutu ruo mgbe mmemme ahụ ga-agwụsị, dịka e dere ya nʼakwụkwọ iwu.\"",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.15",
            "verseOrgIds": [
              "NEH.8.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NEH 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, ndị ahụ pụrụ gaa weta alaka osisi, jiri ha wuore onwe ha ụlọ ahịhịa ha ga-ebi nwa mgbe nta nʼelu ụlọ ha, na nʼogige ụlọ nke aka ha, nakwa nʼogige ụlọ Chineke, na mbara ala Ọnụ Ụzọ Ama Mmiri, na nʼakụkụ Ọnụ Ụzọ Ama Ifrem.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.16",
            "verseOrgIds": [
              "NEH.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NEH 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị ahụ niile si na ndọta nʼagha lọta wuuru onwe ha ụlọ ikwu biri nʼime ya ụbọchị asaa ahụ niile e mere mmemme ahụ. Oke ọṅụ jupụtara obi mmadụ niile, nʼihi na site nʼoge Joshua nwa Nun ruo nʼoge a, o nwebeghị mgbe ụmụ Izrel mere mmemme a nʼụzọ dị otu a.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.17",
            "verseOrgIds": [
              "NEH.8.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NEH 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezra na-agụpụta site nʼakwụkwọ iwu Chineke kwa ụbọchị, site nʼụbọchị mbụ ruo nʼụbọchị ikpeazụ. Ha mere mmemme ahụ ụbọchị asaa ma nʼụbọchị nke asatọ ha nwere ọgbakọ ofufe mmechi dịka e dere ya nʼiwu.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.18",
            "verseOrgIds": [
              "NEH.8.18"
            ]
          }
        }
      ]
    }
  ],
