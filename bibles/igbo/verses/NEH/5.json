  "verseCount": 19,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
        "style": "c",
        "sid": "NEH 5"
      },
      "items": [
        {
          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nehemaya enyere ndị ogbenye aka",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NEH 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼoge ahụ, ụfọdụ ezinaụlọ bidoro itamu ntamu megide ndị Juu ibe ha.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.1",
            "verseOrgIds": [
              "NEH.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NEH 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụfọdụ na-atamu na-asị, \"Anyị na ụmụ anyị dị ukwuu nʼọnụọgụgụ. Ọ bụrụ na anyị ga-eri nri dị ndụ, o kwesikwara ka anyị nwee ike ịzụrụ ọka.\"",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.2",
            "verseOrgIds": [
              "NEH.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NEH 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị ọzọ na-asịkwa, \"Anyị agbaala ubi anyị, ubi vaịnị anyị na ụlọ anyị nʼibe ka anyị nweta mkpụrụ ubi nʼoge ụnwụ.\"",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.3",
            "verseOrgIds": [
              "NEH.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NEH 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ndị ọzọkwa na-asị, \"Lee na anyị gbazitere ego anyị ji tụọ ụtụ isi eze maka ubi anyị na ubi vaịnị anyị.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.4",
            "verseOrgIds": [
              "NEH.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NEH 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼagbanyeghị na ọ bụ otu anụ ahụ na ọbara ka anyị na ndị Juu ọzọ nwere, dịka ụmụ ha dị ka ụmụ anyị dịkwa, ma anyị emeela ka ụmụ anyị ndị ikom na ndị inyom bụrụ ndị ohu. Ụfọdụ nʼime ụmụ anyị ndị inyom abụrụlarị ndị ohu, ma anyị enweghị ike nke aka anyị, nʼihi na ndị ọzọ bụ ndị nwezi ala ubi anyị na ubi vaịnị anyị niile.\"",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.5",
            "verseOrgIds": [
              "NEH.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NEH 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwe were m nke ukwuu mgbe m nụrụ mkpu akwa ha na mkpesa ndị a.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.6",
            "verseOrgIds": [
              "NEH.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NEH 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, mgbe m chesiri echiche banyere ya, e boro m ndị a na-asọpụrụ na ndị ọchịchị ebubo. A gwara m ha, \"Unu na-anara ụmụnna unu ọmụrụnwa ego unu enyere ha.\" Ya mere, a kpọrọ m nzukọ ọha mmadụ maka imegide ha.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.7",
            "verseOrgIds": [
              "NEH.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NEH 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼụbọchị nzukọ ahụ, agwara m ha okwu sị, \"Ọtụtụ nʼime anyị na-agbalị nʼụzọ niile ịhụ na anyị zụtaghachiri ụmụnna anyị ndị Juu bu ndị e resiri ndị mba ọzọ. Ma unu nọ nʼebe a na-agbalị ime ha ka ha ghọọ ndị ohu unu. Ruo ole mgbe ka anyị ga-anọgide na-agbapụta ha site nʼọnọdụ ibu ohu?\" Ma ha niile ekwughị okwu ọbụla, nʼihi na ha enweghị ihe ha ga-ekwu.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.8",
            "verseOrgIds": [
              "NEH.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NEH 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agwakwara m ha okwu ọzọ sị, \"Ihe unu na-eme jọrọ njọ. O kwesighị ka unu tụọ egwu Chineke si otu a gbanarị nkọcha nke ndị iro anyị, bụ ndị mba ọzọ?\"",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.9",
            "verseOrgIds": [
              "NEH.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NEH 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mụ onwe m na ụmụnna m na ndị na-ejere m ozi na-agbazinye ụmụnne anyị ego na ọka. Ma ka anyị kwụsị ịnara ọmụrụnwa.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.10",
            "verseOrgIds": [
              "NEH.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NEH 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyeghachinụ ha ala ubi ha niile ngwangwa, ma ubi vaịnị ha niile, ubi oliv ha niile, ụlọ ha niile na ọmụrụnwa nke unu na-anara ha nke bụ otu ụzọ nʼime narị nke ego, ọka, mmanya ọhụrụ na mmanụ.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.11",
            "verseOrgIds": [
              "NEH.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NEH 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha sịrị, \"Anyị ga-enyeghachi ha. Anyị agakwaghị anara ha ihe ọzọ. Anyị ga-emezu ihe i kwuru.\"",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.12",
            "verseOrgIds": [
              "NEH.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "NEH 5:12"
      },
      "items": [
        {
          "text": "Mgbe ahụ, akpọkọtara m ndị nchụaja, mee ka ndị ndu na ndịisi ozi ṅụọ iyi imezu nkwa ha.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.12",
            "verseOrgIds": [
              "NEH.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NEH 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayọgharịrị m ọnụ ọnụ uwe mwụda m sị, \"Otu a ka Chineke ga-esi yọchapụ site nʼụlọ ha na ihe nweta ha onye ọbụla nke na-agaghị edebezu nkwa a.\"",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.13",
            "verseOrgIds": [
              "NEH.5.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "NEH 5:13"
      },
      "items": [
        {
          "text": "Ndị niile zukọrọ kwere sị, \"Amen.\" Ha tokwara",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.13",
            "verseOrgIds": [
              "NEH.5.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NEH.5.13",
                "verseOrgIds": [
                  "NEH.5.13"
                ]
              }
            }
          ]
        },
        {
          "text": ": Ha niile mekwara ihe ha kwere na nkwa.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.13",
            "verseOrgIds": [
              "NEH.5.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NEH 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọzọ, nʼime afọ iri na abụọ ahụ a họpụtara m ị bụ onyeisi ọchịchị na Juda, site nʼiri afọ abụọ nke ịbụ eze Ataksekses ruo nʼafọ iri atọ na abụọ ya, mụ na ụmụnne m esiteghị na nri a na-atụkọrọ onyeisi ọchịchị were ihe oriri ọbụla.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.14",
            "verseOrgIds": [
              "NEH.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NEH 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ọ bụghị otu a ka o si dị na mbụ, nʼihi na ndịisi ọchịchị niile buru m ụzọ chịa boro ndị ahụ ibu arọ dị ukwuu. Ha na-anakọta site nʼaka onye ọbụla iri mkpụrụ ọlaọcha anọ, tinyere ihe oriri na mmanya ha na-ewebatakwa. Ọbụladị ndị na-enyere ha aka mekpakwara ndị mmadụ ahụ. Ma emeghị m otu a, nʼihi ịtụ egwu Chineke.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.15",
            "verseOrgIds": [
              "NEH.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NEH 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kama, anọgidesiri m ike nʼọrụ iwugharị mgbidi ahụ, achịkọtara ndị ikom m niile nʼebe ahụ nʼihi ije ozi a. Ọ dịghịkwa ala anyị zụrụ.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.16",
            "verseOrgIds": [
              "NEH.5.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NEH 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma otu ọ dị, ndịisi Juu ọnụọgụgụ ha dị otu narị na iri na ise na-eri nri na tebul m, tinyere ndị na-abịakwute anyị site na mba ndị dị anyị gburugburu.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.17",
            "verseOrgIds": [
              "NEH.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NEH 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihe na-ezu nri a na-eri nʼụlọ m kwa ụbọchị bụ otu ehi na atụrụ isii gbara abụba, na ọtụtụ ọkụkụ,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.18",
            "verseOrgIds": [
              "NEH.5.18"
            ]
          }
        },
        {
          "text": "na ụdị mmanya dị iche iche a na-ebubata kwa ụbọchị iri ọbụla. Nʼagbanyeghị nke a, ọ dịghị mgbe ọbụla m nara site nʼaka ha ụtụ ihe oriri nke onye na-achị ala kwesiri inweta, nʼihi na ha onwe ha nọ na mkpa dị ukwuu.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.18",
            "verseOrgIds": [
              "NEH.5.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NEH 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chineke m biko, echefula ihe m meere ndị a, gọzie m nʼụzọ nke gị.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.19",
            "verseOrgIds": [
              "NEH.5.19"
            ]
          }
        }
      ]
    }
  ],
