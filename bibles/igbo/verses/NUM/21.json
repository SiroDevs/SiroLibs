  "verseCount": 35,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "21",
        "style": "c",
        "sid": "NUM 21"
      },
      "items": [
        {
          "text": "21",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mbibi obodo Arad",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 21:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe eze Kenan, bụ Arad, onye bi na Negev nụrụ na ndị Izrel na-agbaso ụzọ ahụ na-aga obodo Atarim, ọ chịkọtara ndị agha ya, pụkwuru ndị Izrel, lụso ha agha. Ọ dọtara ụfọdụ nʼime ha nʼagha.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.1",
            "verseOrgIds": [
              "NUM.21.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, ndị Izrel kwere",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.2",
            "verseOrgIds": [
              "NUM.21.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NUM.21.2",
                "verseOrgIds": [
                  "NUM.21.2"
                ]
              }
            }
          ]
        },
        {
          "text": "nkwa sị, \"Ọ bụrụ na ị ga-enyere anyị aka imeri eze Arad na ndị ya, anyị ga-ebibi obodo ha niile kpamkpam.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.2",
            "verseOrgIds": [
              "NUM.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NUM.21.3",
                "verseOrgIds": [
                  "NUM.21.3"
                ]
              }
            }
          ]
        },
        {
          "text": "ṅara ntị nʼarịrịọ ha, nyere ha aka imeri ndị Kenan ahụ. Mgbe ahụ, ụmụ Izrel bibiri obodo ha niile, na ndị niile bi nʼime ya. Ya mere, aha a kpọrọ ebe ahụ niile bụ Homa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.3",
            "verseOrgIds": [
              "NUM.21.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Agwọ Bronz Ahụ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, ụmụ Izrel sitere nʼugwu Hor bilie ije ha, si ụzọ gawara Osimiri Uhie, ka ha nwee ike gaa gburugburu ala ndị Edọm. Ma ndị Izrel enweghị ntachiobi oge niile ha nọ nʼije a.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.4",
            "verseOrgIds": [
              "NUM.21.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha kwuru okwu megide Chineke na Mosis sị, \"Gịnị mere i ji site nʼala Ijipt kpọpụta anyị ka anyị nwụsịa nʼọzara a? Lee na nri ọbụla adịghị nʼebe a, mmiri ọṅụṅụ adịghịkwa, ike iri mánà a na-enweghị isi agwụkwala anyị.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.5",
            "verseOrgIds": [
              "NUM.21.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.6",
            "verseOrgIds": [
              "NUM.21.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NUM.21.6",
                "verseOrgIds": [
                  "NUM.21.6"
                ]
              }
            }
          ]
        },
        {
          "text": "zitere agwọ ọjọọ na-ata ata nʼetiti ha. Agwọ ndị a tagbukwara ọtụtụ nʼime ụmụ Izrel.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.6",
            "verseOrgIds": [
              "NUM.21.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, ndị Izrel bịakwutere Mosis sị ya, \"Anyị emehiela, nʼihi na anyị ekwuluola",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.7",
            "verseOrgIds": [
              "NUM.21.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NUM.21.7",
                "verseOrgIds": [
                  "NUM.21.7"
                ]
              }
            }
          ]
        },
        {
          "text": ", kwulukwaa gị onwe gị. Biko rịọrọ anyị",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.7",
            "verseOrgIds": [
              "NUM.21.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NUM.21.7",
                "verseOrgIds": [
                  "NUM.21.7"
                ]
              }
            }
          ]
        },
        {
          "text": "ka o wezugara anyị agwọ ọjọọ ndị a.\" Mosis rịọrọ arịrịọ nʼihi ha.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.7",
            "verseOrgIds": [
              "NUM.21.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.8",
            "verseOrgIds": [
              "NUM.21.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NUM.21.8",
                "verseOrgIds": [
                  "NUM.21.8"
                ]
              }
            }
          ]
        },
        {
          "text": "gwara Mosis okwu sị ya, \"Kpụọ otu agwọ yiri agwọ ndị a. Kwụba ya nʼọnụ ogologo osisi nke ị ga-amanye nʼala ebe mmadụ niile ga-ahụ ya anya. Onye ọbụla agwọ ọjọọ a tara ga-adị ndụ ma ọ bụrụ na ọ ga-ewelite anya ya elu lekwasị agwọ ahụ ị kwụbara nʼelu osisi ahụ.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.8",
            "verseOrgIds": [
              "NUM.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, Mosis ji bronz kpụta agwọ yiri otu nʼime agwọ ndị ahụ, tinye ya nʼọnụ osisi dị ogologo. Onye ọbụla kwa agwọ ahụ tara nke welitere anya ya elu lee agwọ bronz ahụ anya, dịkwara ndụ.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.9",
            "verseOrgIds": [
              "NUM.21.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Njem ịga obodo Moab",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụmụ Izrel biliri njem, manye ụlọ ikwu ha na Obot.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.10",
            "verseOrgIds": [
              "NUM.21.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha sikwa nʼObot bilie njem, maa ụlọ ikwu ha na Iye Abarim, nʼọzara ahụ nke chere ihu nʼobodo Moab, nʼụzọ ọwụwa anyanwụ.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.11",
            "verseOrgIds": [
              "NUM.21.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha si nʼebe ahụ bilie njem, manye ụlọ ikwu ha na Ndagwurugwu Zered.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.12",
            "verseOrgIds": [
              "NUM.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha sitekwara nʼebe ahụ bilie njem, maa ụlọ ikwu ha nʼofe iyi Anọn nke dị nʼọzara ruru nʼoke ala ndị Amọrait. Iyi Anọn bụ oke ala Moab, nʼetiti ndị Moab na ndị Amọrait.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.13",
            "verseOrgIds": [
              "NUM.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi nke a, nʼAkwụkwọ Agha dị iche iche nke",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.14",
            "verseOrgIds": [
              "NUM.21.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NUM.21.14",
                "verseOrgIds": [
                  "NUM.21.14"
                ]
              }
            }
          ]
        },
        {
          "text": "na-asị,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.14",
            "verseOrgIds": [
              "NUM.21.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NUM 21:14"
      },
      "items": [
        {
          "text": "\"Waheb nʼime Sufa ya na ndagwurugwu niile",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.14",
            "verseOrgIds": [
              "NUM.21.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 21:14"
      },
      "items": [
        {
          "text": "Anọn",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.14",
            "verseOrgIds": [
              "NUM.21.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "na mgbadata ndagwurugwu ndị ahụ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.15",
            "verseOrgIds": [
              "NUM.21.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NUM 21:15"
      },
      "items": [
        {
          "text": "nke gbasapụrụ ruo nʼebe Ar dị,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.15",
            "verseOrgIds": [
              "NUM.21.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 21:15"
      },
      "items": [
        {
          "text": "nke tọgbọrọ nʼoke ala Moab.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.15",
            "verseOrgIds": [
              "NUM.21.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, ụmụ Izrel niile biliri njem bịarute Bịa bụ nʼolulu mmiri ahụ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.16",
            "verseOrgIds": [
              "NUM.21.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NUM.21.16",
                "verseOrgIds": [
                  "NUM.21.16"
                ]
              }
            }
          ]
        },
        {
          "text": "nyere Mosis iwu sị, \"Kpọkọtaa ndị Izrel niile, nʼihi na m na-aga inye ha mmiri.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.16",
            "verseOrgIds": [
              "NUM.21.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, ụmụ Izrel bụrụ abụ a.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.17",
            "verseOrgIds": [
              "NUM.21.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NUM 21:17"
      },
      "items": [
        {
          "text": "\"Sọpụta gị olulu mmiri!",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.17",
            "verseOrgIds": [
              "NUM.21.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 21:17"
      },
      "items": [
        {
          "text": "Bụọnụ abụ banyere mmiri a!",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.17",
            "verseOrgIds": [
              "NUM.21.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 21:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olulu mmiri ụmụ ndị eze gwuru",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.18",
            "verseOrgIds": [
              "NUM.21.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 21:18"
      },
      "items": [
        {
          "text": "nke ndị ndu anyị doziri.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.18",
            "verseOrgIds": [
              "NUM.21.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 21:18"
      },
      "items": [
        {
          "text": "Mkpara eze ha na mkpara ha, ka ha ji gwuo ya.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.18",
            "verseOrgIds": [
              "NUM.21.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m",
        "vid": "NUM 21:18"
      },
      "items": [
        {
          "text": "Emesịa, ha hapụrụ ọzara ahụ, gaa nʼihu ruo nʼobodo Matana.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.18",
            "verseOrgIds": [
              "NUM.21.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha si Matana jeruo Nahaliel, si Nahaliel jeruo Bamot.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.19",
            "verseOrgIds": [
              "NUM.21.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 21:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sitekwa Bamot rute na ndagwurugwu ahụ dị nʼọhịa Moab, ruo nʼugwu Pisga, nke chere ihu nʼala ahụ tọgbọrọ nʼefu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.20",
            "verseOrgIds": [
              "NUM.21.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mmeri e meriri Saịhọn na Ọg",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị Izrel zipụrụ ndị ozi ka ha jekwuru Saịhọn, eze ndị Amọrait, sị ya,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.21",
            "verseOrgIds": [
              "NUM.21.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 21:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Biko, kwere ka anyị site nʼobodo gị gafee. Anyị agaghị atụgharị banye nʼime ala ubi gị maọbụ nʼubi vaịnị, maọbụ ṅụọ mmiri site nʼolulu mmiri ọbụla dị nʼala gị. Anyị ga-eje nʼokporoụzọ eze tutu ruo mgbe anyị ga-agabiga oke ala gị.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.22",
            "verseOrgIds": [
              "NUM.21.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 21:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Saịhọn ekweghị na ụmụ Izrel ga-esi nʼoke ala ya gafee. Ọ chịkọtara ndị agha ya niile, zọpụ ije ibu agha megide ndị Izrel nʼime ọzara ahụ. Mgbe o rutere Jehaz, ọ lụsoro Izrel agha.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.23",
            "verseOrgIds": [
              "NUM.21.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 21:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Izrel jiri mma agha gbuo ya. Nwetara onwe ha ala ya, site nʼiyi Anọn ruo nʼiyi Jabọk, gamiekwa rute nʼoke ala ha na ndị Amọn, ha kwụsịrị nʼihi nʼoke ala ndị Amọn siri ike karịa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.24",
            "verseOrgIds": [
              "NUM.21.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 21:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị Izrel lụgburu obodo niile nke ndị Amọrait bichie nʼime ha, tinyere Heshbọn na obodo nta niile gbara ya gburugburu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.25",
            "verseOrgIds": [
              "NUM.21.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 21:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Heshbọn bụ isi obodo Saịhọn, eze ndị Amọrait onye busoro eze naara achị Moab agha dọta ala ya niile nʼagha ruo Anọn.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.26",
            "verseOrgIds": [
              "NUM.21.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 21:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ nke a mere ndị na-arọ abụ ji kwuo sị,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.27",
            "verseOrgIds": [
              "NUM.21.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NUM 21:27"
      },
      "items": [
        {
          "text": "\"Bịa na Heshbọn ka e wukwaa ya,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.27",
            "verseOrgIds": [
              "NUM.21.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 21:27"
      },
      "items": [
        {
          "text": "ka e mee ka isi obodo eze Saịhọn guzosie ike.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.27",
            "verseOrgIds": [
              "NUM.21.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 21:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nʼihi na ọkụ esitela na Heshbọn pụọ.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.28",
            "verseOrgIds": [
              "NUM.21.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 21:28"
      },
      "items": [
        {
          "text": "Ire ọkụ esitela nʼobodo ukwu Saịhọn,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.28",
            "verseOrgIds": [
              "NUM.21.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NUM 21:28"
      },
      "items": [
        {
          "text": "rechapụ obodo Ar, nke dị na Moab,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.28",
            "verseOrgIds": [
              "NUM.21.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 21:28"
      },
      "items": [
        {
          "text": "ndị nwe ebe niile dị elu nke Anọn.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.28",
            "verseOrgIds": [
              "NUM.21.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 21:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahụhụ dịrị gị Moab!",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.29",
            "verseOrgIds": [
              "NUM.21.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 21:29"
      },
      "items": [
        {
          "text": "Ndị a lara nʼiyi ka unu bụ, unu ndị Kemosh.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.29",
            "verseOrgIds": [
              "NUM.21.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NUM 21:29"
      },
      "items": [
        {
          "text": "Ụmụ ya ndị ikom aghọọla ndị na-enweghị ebe obibi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.29",
            "verseOrgIds": [
              "NUM.21.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 21:29"
      },
      "items": [
        {
          "text": "A dọtala ụmụ ndị inyom nʼagha,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.29",
            "verseOrgIds": [
              "NUM.21.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 21:29"
      },
      "items": [
        {
          "text": "nye Saịhọn eze ndị Amọrait.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.29",
            "verseOrgIds": [
              "NUM.21.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 21:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ma anyị ebibiela ha,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.30",
            "verseOrgIds": [
              "NUM.21.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 21:30"
      },
      "items": [
        {
          "text": "bibie Heshbọn ruo rịị na Dibọn,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.30",
            "verseOrgIds": [
              "NUM.21.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NUM 21:30"
      },
      "items": [
        {
          "text": "bibie ha ruo Nofa,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.30",
            "verseOrgIds": [
              "NUM.21.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 21:30"
      },
      "items": [
        {
          "text": "ruokwa rịị Medeba.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.30",
            "verseOrgIds": [
              "NUM.21.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NUM 21:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, ụmụ Izrel bichiri nʼala ndị Amọrait.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.31",
            "verseOrgIds": [
              "NUM.21.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NUM 21:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emesịa, Mosis zipụrụ ndị nnyopụta ka ha ga nyochaa Jeza. Ụmụ Izrel tigburu obodo niile dị gburugburu ya chụpụkwa ndị Amọrait bi nʼebe ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.32",
            "verseOrgIds": [
              "NUM.21.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NUM 21:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, ha chigharịrị gbagoo nʼụzọ gawara Bashan. Ma Ọg, eze Bashan, na ndị agha ya niile biliri chịrị agha pụọ izute ha na Edrei.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.33",
            "verseOrgIds": [
              "NUM.21.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NUM 21:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.34",
            "verseOrgIds": [
              "NUM.21.34"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NUM.21.34",
                "verseOrgIds": [
                  "NUM.21.34"
                ]
              }
            }
          ]
        },
        {
          "text": "gwara Mosis okwu, sị, \"Atụla ya egwu nʼihi na ewerela m ya na ndị agha ya niile, na ala ya, nyefee gị nʼaka. Mee ya ihe i mere Saịhọn eze ndị Amọrait onyeisi obodo ya bụ Heshbọn.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.34",
            "verseOrgIds": [
              "NUM.21.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "NUM 21:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, ha gburu ya, tinyere ụmụ ya na ndị agha ya niile, na-ahapụghị onye ọbụla ndụ nye ha. Ha nwetakwara ala ha, biri nʼime ya.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.35",
            "verseOrgIds": [
              "NUM.21.35"
            ]
          }
        }
      ]
    }
  ],
