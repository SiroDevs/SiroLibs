  "verseCount": 49,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "NUM 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ụmụ Kohat",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NUM.4.1",
                "verseOrgIds": [
                  "NUM.4.1"
                ]
              }
            }
          ]
        },
        {
          "text": "gwara Mosis na Erọn okwu sị,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.1",
            "verseOrgIds": [
              "NUM.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Gụọ ọnụ chọpụta, ọnụọgụgụ ụmụ Kohat dị nʼebo Livayị dịka ikwu ha na ezinaụlọ ha si dị.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.2",
            "verseOrgIds": [
              "NUM.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gụọ ndị ikom niile gbarala iri afọ atọ ruo iri afọ ise, ndị tozuru ije ozi nʼụlọ nzute.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.3",
            "verseOrgIds": [
              "NUM.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nke a bụ ọrụ dịrị ndị Kohat nʼụlọ nzute, ilekọta ihe ndị ahụ kachasị ịdị nsọ.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.4",
            "verseOrgIds": [
              "NUM.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ọmụma ụlọ ikwu ahụ ga-ebili ije ha, Erọn na ụmụ ya ndị ikom ga-eburu ụzọ banye nʼụlọ nzute ahụ wetuo akwa mgbochi ahụ, jiri ya kpuchie igbe iwu ọgbụgba ndụ ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.5",
            "verseOrgIds": [
              "NUM.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, ha ga-agbakwasị akpụkpọ anụ ehi mmiri nʼelu akwa mgbochi ahụ, sakwasịkwa akwa na-acha anụnụ anụnụ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.6",
            "verseOrgIds": [
              "NUM.4.6"
            ]
          }
        },
        {
          "text": "nʼelu ya, tinyekwa mkpọrọ osisi niile nʼoghere ha kwesiri ịdị.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.6",
            "verseOrgIds": [
              "NUM.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nʼelu tebul ahụ na-adị nʼihu Onyenwe anyị, ha ga-agbasa akwa anụnụ anụnụ tụkwasịkwa efere niile, ngaji niile, ọkwa niile na iko aja ihe ọṅụṅụ. Achịcha ahụ na-adịgide nʼelu ya ga-adịkwa ebe ọ dị.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.7",
            "verseOrgIds": [
              "NUM.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha ga-agbasakwa akwa uhie nʼelu ya, jiri akpụkpọ anụ ehi mmiri gbokwasịkwa nʼelu akwa uhie ahụ. Mgbe ahụ, ha ga-etinyekwa mkpọrọ osisi e ji ebu tebul nʼime oghere o kwesiri ịdị.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.8",
            "verseOrgIds": [
              "NUM.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ọzọ, ha ga-eji akwa anụnụ anụnụ sachie ihe ịdọba oriọna ahụ nke na-enye ìhè, ya na oriọna ya niile, mkpa ya niile na ihe ịkpakepụ ọkụ ya niile na ite mmanụ ya niile, e ji awụnye ya mmanụ.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.9",
            "verseOrgIds": [
              "NUM.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emesịa, ha ga-eji akpụkpọ anụ ehi mmiri sachie ya na ngwongwo ya niile, tụkwasị ya nʼelu ihe e ji ebu ya.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.10",
            "verseOrgIds": [
              "NUM.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ha ga-ejikwa akwa anụnụ anụnụ tụsaa nʼelu ebe ịchụ aja ahụ e jiri ọlaedo mee, werekwa akpụkpọ anụ ehi mmiri sachie ya, tinyekwa mkpọrọ osisi e ji ebu ya nʼoghere dị nʼakụkụ ebe ịchụ aja ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.11",
            "verseOrgIds": [
              "NUM.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ihe ndị ọzọ niile e ji eje ozi nʼebe nsọ ahụ ka ha ga-eji akwa anụnụ anụnụ kekọtaa, jirikwa akpụkpọ anụ ehi mmiri sachie ha, tụkwasị ha nʼelu ihe e ji ebu ha.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.12",
            "verseOrgIds": [
              "NUM.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"A ga-ekpopụ ntụ dị nʼebe ịchụ aja bronz ahụ, jiri akwa na-acha ngwakọta anụnụ na uhie, sachie ebe ịchụ aja bronz ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.13",
            "verseOrgIds": [
              "NUM.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emesịa ha ga-atụkwasị ihe niile e ji eje ozi nʼebe ịchụ aja ahụ nʼelu akwa ahụ, ihe dịka ite ịgụ ọkụ, na ndụdụ, na ihe ikpofu ntụ, na efere ịkwọsa mmiri niile. Akpụkpọ anụ ehi mmiri ka a ga-eji sachie ha niile. Ma nʼikpeazụ, mkpọrọ osisi e ji ebu ya ka a ga-etinye nʼebe ha kwesiri ịdị.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.14",
            "verseOrgIds": [
              "NUM.4.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mgbe Erọn na ụmụ ya kpuchisịrị ụlọnsọ ahụ na ngwongwo niile nke ebe nsọ ahụ, dịka ndị Izrel niile na-ejikere ibili ije, mgbe ahụ ka ndị Kohat ga-abata buru ihe ndị a. Ma ha agaghị emetụ ihe nsọ ndị a aka ka ha ghara ịnwụ. Ọrụ ibu ihe ndị a niile dị nʼime ụlọ nzute dịrị Ndị Kohat.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.15",
            "verseOrgIds": [
              "NUM.4.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Elieza nwa Erọn, onye nchụaja, ka ọrụ ndị a dị nʼaka: mmanụ e ji amụ ọkụ, na ihe nsure ọkụ e ji ụda dị iche iche na-esi isi ụtọ mee, na onyinye mkpụrụ ọka a na-enye ụbọchị niile, na mmanụ nsọ ahụ. Nʼaka ya ka ọrụ metụtara nlekọta ụlọ nzute ahụ niile, ihe niile dị nʼime ya na ngwongwo nsọ ya dị iche iche dị.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.16",
            "verseOrgIds": [
              "NUM.4.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NUM.4.17",
                "verseOrgIds": [
                  "NUM.4.17"
                ]
              }
            }
          ]
        },
        {
          "text": "gwara Mosis na Erọn sị,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.17",
            "verseOrgIds": [
              "NUM.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Unu ekwekwala ka agbụrụ Kohat bụrụ ndị e bipụrụ site nʼebo Livayị.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.18",
            "verseOrgIds": [
              "NUM.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otu a ka unu ga-esi meso ha mmeso ime ka ha dịrị ndụ, ghara ịnwụ, mgbe ha bịara nso ihe ndị ahụ dịkarịsịrị nsọ, Erọn na ụmụ ya ga-esoro ha banye gosi onye ọ bụla nʼime ha ihe ha ga-ebu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.19",
            "verseOrgIds": [
              "NUM.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ndị Kohat ekwesighị ịbanye ilekwasị ihe nsọ ndị ahụ anya, ka ha ghara ịnwụ.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.20",
            "verseOrgIds": [
              "NUM.4.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ụmụ Geshọn",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.21",
            "verseOrgIds": [
              "NUM.4.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NUM.4.21",
                "verseOrgIds": [
                  "NUM.4.21"
                ]
              }
            }
          ]
        },
        {
          "text": "gwara Mosis okwu sị,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.21",
            "verseOrgIds": [
              "NUM.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Gụọ ọnụ chọpụta ọnụọgụgụ ụmụ Geshọn, dịka ikwu ha na ezinaụlọ ha si dị.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.22",
            "verseOrgIds": [
              "NUM.4.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mata ọnụọgụgụ ndị ikom ole ha dị, ndị kwesiri ịrụ ọrụ nʼụlọ nzute, ndị gbara iri afọ atọ ruo iri afọ ise.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.23",
            "verseOrgIds": [
              "NUM.4.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 4:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ihe ga-abụ ọrụ ndị ikwu Geshọn ga-abụ ije ozi na ibu ibu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.24",
            "verseOrgIds": [
              "NUM.4.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 4:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha ga-ebu akwa mgbochi ebe obibi ahụ na nke ụlọ nzute ahụ, tinyere akwa e ji sachie ya na akpụkpọ anụ ehi mmiri e ji mee elu ụlọ ya na akwa mgbochi dị nʼọnụ ụzọ ụlọ nzute ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.25",
            "verseOrgIds": [
              "NUM.4.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 4:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha ga-ebukwa akwa mgbochi niile e ji gechie ogige ahụ, akwa e ji gechie ọnụ ụzọ ama ogige gbara ebe ịchụ aja na ụlọ nzute ahụ gburugburu, ụdọ ya niile na ngwongwo niile e ji eje ozi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.26",
            "verseOrgIds": [
              "NUM.4.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 4:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọrụ ha niile, maọbụ ibu ihe ma ọ bụkwanụ ịrụ ọrụ ọzọ, ga-abụ site na ntụziaka Erọn na ụmụ ya. Ị ga-ekenye ha ọrụ dịrị ha nʼihe niile bụ ihe ha ga-ebu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.27",
            "verseOrgIds": [
              "NUM.4.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 4:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nke a bụ ọrụ dịịrị ikwu Geshọn nʼụlọ nzute. Ha ga-anọ nʼokpuru Itama, nwa Erọn, onye nchụaja, onye bụ onyeisi ha.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.28",
            "verseOrgIds": [
              "NUM.4.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ụmụ Merari",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 4:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Gụọ, chọpụta ọnụọgụgụ ụmụ Merari dịka ikwu ha na ezinaụlọ ha si dị.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.29",
            "verseOrgIds": [
              "NUM.4.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 4:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chọpụta ọnụọgụgụ ndị ikom ole ha dị, ndị gbara iri afọ atọ ruo iri afọ ise, ndị toruru ịrụ ọrụ nʼụlọ nzute Onyenwe anyị.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.30",
            "verseOrgIds": [
              "NUM.4.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NUM 4:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ije ozi ha dịka o si metụta ọrụ ụlọ nzute bụ ibu mbudo ụlọ nzute ahụ niile, osisi ntụbichi ya niile, ogidi osisi na ụkwụ ya niile;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.31",
            "verseOrgIds": [
              "NUM.4.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NUM 4:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "tinyere ogidi osisi niile dị ogige ahụ gburugburu na ụkwụ ha niile, ǹtu niile, ụdọ ha niile na ngwongwo ndị ọzọ e ji arụ ọrụ metụtara ihe ndị a ha ga-ebu. Kenye nwoke ọbụla ọrụ nke ya. Kpọ onye ahụ aha nye ya ọrụ nke ya.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.32",
            "verseOrgIds": [
              "NUM.4.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NUM 4:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nke a bụ ọrụ dịịrị ndị agbụrụ Merari mgbe ha na-aga ozi ha nʼụlọ nzute. Ha ga-anọ nʼokpuru Itama, nwa Erọn, onye nchụaja, onye bụ onyeisi ha.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.33",
            "verseOrgIds": [
              "NUM.4.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ịgụ agbụrụ Livayị niile ọnụ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NUM 4:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, Mosis na Erọn na ndị ndu nzukọ ụmụ Izrel gụrụ ma chọpụta ọnụọgụgụ ụmụ Kohat, dịka ikwu ha na ezinaụlọ ha si dị.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.34",
            "verseOrgIds": [
              "NUM.4.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "NUM 4:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị ikom niile gbara iri afọ atọ ruo iri afọ ise, ndị toruru ije ozi nʼụlọ nzute ahụ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.35",
            "verseOrgIds": [
              "NUM.4.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "NUM 4:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "dịka ikwu ha si dị bụ puku abụọ na narị asaa na iri ise (2,750).",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.36",
            "verseOrgIds": [
              "NUM.4.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "NUM 4:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị a niile bụ ndị si nʼikwu Kohat ndị na-eje ozi nʼụlọ nzute. Mosis na Erọn gụrụ ha ọnụ dịka iwu",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.37",
            "verseOrgIds": [
              "NUM.4.37"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NUM.4.37",
                "verseOrgIds": [
                  "NUM.4.37"
                ]
              }
            }
          ]
        },
        {
          "text": "nyere Mosis si dị.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.37",
            "verseOrgIds": [
              "NUM.4.37"
            ]
          }
        }
      ]
