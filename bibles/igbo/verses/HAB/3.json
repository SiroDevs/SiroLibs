  "verseCount": 19,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "3",
        "style": "c",
        "sid": "HAB 3"
      },
      "items": [
        {
          "text": "3",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ekpere Habakuk",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HAB 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nke a bụ ekpere Habakuk onye amụma kpere. Ọ dị nʼusoro",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "it"
          },
          "items": [
            {
              "text": "Shiginot.",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nke a bụ ihe o kwuru.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HAB 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "HAB.3.2",
                "verseOrgIds": [
                  "HAB.3.2"
                ]
              }
            }
          ]
        },
        {
          "text": "anụla m ihe niile e kwuru banyere ude gị.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.2",
            "verseOrgIds": [
              "HAB.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 3:2"
      },
      "items": [
        {
          "text": "Ịdị ukwuu nke ọrụ gị niile na-emekwa ka m dere duu nʼegwu nʼihu gị,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.2",
            "verseOrgIds": [
              "HAB.3.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "HAB.3.2",
                "verseOrgIds": [
                  "HAB.3.2"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.2",
            "verseOrgIds": [
              "HAB.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HAB 3:2"
      },
      "items": [
        {
          "text": "Mekwaa ya ọzọ nʼoge nke anyị,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.2",
            "verseOrgIds": [
              "HAB.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 3:2"
      },
      "items": [
        {
          "text": "mekwaa ka anụ akụkọ ya nʼọgbọ anyị.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.2",
            "verseOrgIds": [
              "HAB.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 3:2"
      },
      "items": [
        {
          "text": "Nʼoke iwe gị chetakwa ebere.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.2",
            "verseOrgIds": [
              "HAB.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HAB 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chineke si na Teman bịa,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.3",
            "verseOrgIds": [
              "HAB.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 3:3"
      },
      "items": [
        {
          "text": "Onye Nsọ ahụ sikwa nʼugwu Paran.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.3",
            "verseOrgIds": [
              "HAB.3.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "qs"
          },
          "items": [
            {
              "text": "Sela",
              "type": "text",
              "attrs": {
                "verseId": "HAB.3.3",
                "verseOrgIds": [
                  "HAB.3.3"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HAB 3:3"
      },
      "items": [
        {
          "text": "Ebube ya na-ekpuchi eluigwe,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.3",
            "verseOrgIds": [
              "HAB.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 3:3"
      },
      "items": [
        {
          "text": "otuto ya jupụtakwara nʼụwa.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.3",
            "verseOrgIds": [
              "HAB.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HAB 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ịma mma ya na-achapụta dịka ihe anyanwụ ụtụtụ,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.4",
            "verseOrgIds": [
              "HAB.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 3:4"
      },
      "items": [
        {
          "text": "ihe na-enwupụta site nʼaka ya,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.4",
            "verseOrgIds": [
              "HAB.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 3:4"
      },
      "items": [
        {
          "text": "ọ bụkwa nʼebe ahụ ka e zoro ike ya.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.4",
            "verseOrgIds": [
              "HAB.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HAB 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihu ya ka ajọ ọrịa na-efe efe na-aga,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.5",
            "verseOrgIds": [
              "HAB.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 3:5"
      },
      "items": [
        {
          "text": "oke mbibi na-esokwa ya nʼazụ.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.5",
            "verseOrgIds": [
              "HAB.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HAB 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "O guzoro ọtọ yọgharịa ụwa;",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.6",
            "verseOrgIds": [
              "HAB.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 3:6"
      },
      "items": [
        {
          "text": "o lere anya, mee ka mba niile maa jijiji.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.6",
            "verseOrgIds": [
              "HAB.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HAB 3:6"
      },
      "items": [
        {
          "text": "Ugwu ukwu ochie ahụ niile dara,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.6",
            "verseOrgIds": [
              "HAB.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 3:6"
      },
      "items": [
        {
          "text": "ugwu nta ochie ndị ahụ dakwara.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.6",
            "verseOrgIds": [
              "HAB.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 3:6"
      },
      "items": [
        {
          "text": "Nʼihi na ụzọ ya ga-adịgide ruo mgbe niile ebighị ebi.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.6",
            "verseOrgIds": [
              "HAB.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HAB 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahụrụ m ụlọ ikwu nke Kushan ka ha nọ ọnọdụ ụbọchị ọjọọ,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.7",
            "verseOrgIds": [
              "HAB.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 3:7"
      },
      "items": [
        {
          "text": "na ebe obibi ndị Midia ka ha nọ na oke ahụ ụfụ.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.7",
            "verseOrgIds": [
              "HAB.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HAB 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ osimiri, ka gị bụ",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.8",
            "verseOrgIds": [
              "HAB.3.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "HAB.3.8",
                "verseOrgIds": [
                  "HAB.3.8"
                ]
              }
            }
          ]
        },
        {
          "text": "were iwe megide?",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.8",
            "verseOrgIds": [
              "HAB.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 3:8"
      },
      "items": [
        {
          "text": "Ọnụma gị, ọ dị ukwuu megide iyi niile?",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.8",
            "verseOrgIds": [
              "HAB.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HAB 3:8"
      },
      "items": [
        {
          "text": "Oke iwe gị ọ bụ megide oke osimiri",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.8",
            "verseOrgIds": [
              "HAB.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 3:8"
      },
      "items": [
        {
          "text": "mgbe ị nọkwasịrị nʼelu ịnyịnya gị,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.8",
            "verseOrgIds": [
              "HAB.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 3:8"
      },
      "items": [
        {
          "text": "nakwa nʼelu ụgbọ ịnyịnya ị wetara ndị nke gị mmeri?",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.8",
            "verseOrgIds": [
              "HAB.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HAB 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "I kpughepụrụ ụta gị,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.9",
            "verseOrgIds": [
              "HAB.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 3:9"
      },
      "items": [
        {
          "text": "kpọọ oku ka a chịtara gị ọtụtụ àkụ.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.9",
            "verseOrgIds": [
              "HAB.3.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "qs"
          },
          "items": [
            {
              "text": "Sela",
              "type": "text",
              "attrs": {
                "verseId": "HAB.3.9",
                "verseOrgIds": [
                  "HAB.3.9"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HAB 3:9"
      },
      "items": [
        {
          "text": "I ji osimiri dị iche iche kewaa ụwa.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.9",
            "verseOrgIds": [
              "HAB.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HAB 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ugwu niile hụrụ gị ha nyagharịrị onwe ha nʼihi ihe mgbu bịakwasịrị ha.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.10",
            "verseOrgIds": [
              "HAB.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HAB 3:10"
      },
      "items": [
        {
          "text": "Oke mmiri ozuzo gabigakwara.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.10",
            "verseOrgIds": [
              "HAB.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 3:10"
      },
      "items": [
        {
          "text": "Ogbu mmiri mere ka olu ya daa ụda,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.10",
            "verseOrgIds": [
              "HAB.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 3:10"
      },
      "items": [
        {
          "text": "buliekwa ebili mmiri elu.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.10",
            "verseOrgIds": [
              "HAB.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HAB 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
