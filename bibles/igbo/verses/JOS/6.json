  "verseCount": 27,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
        "style": "c",
        "sid": "JOS 6"
      },
      "items": [
        {
          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma e mechiri ọnụ ụzọ e si abata Jeriko nke ọma, nʼihi ụmụ Izrel. Ọ dịghị onye ọbụla na-apụ nʼezi, ọ dịghịkwa onye na-abata nʼime ya.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.1",
            "verseOrgIds": [
              "JOS.6.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.2",
            "verseOrgIds": [
              "JOS.6.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JOS.6.2",
                "verseOrgIds": [
                  "JOS.6.2"
                ]
              }
            }
          ]
        },
        {
          "text": "gwara Joshua sị, \"Lee, enyefela m obodo a bụ Jeriko, ya na eze ya, na ndị dị ike ibu agha nọ nʼime ya, nʼaka gị.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.2",
            "verseOrgIds": [
              "JOS.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gị na ndị agha gị zọọnụ ije gburugburu obodo a. Unu ga-ejegharị gburugburu mgbidi obodo a otu ugbo nʼụbọchị. Unu ga-esi otu a jegharịa ụbọchị isii.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.3",
            "verseOrgIds": [
              "JOS.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị nchụaja asaa, ndị ga-eji opi mpi ebule asaa ga-ebu ụzọ gawa nʼihu. Ndị nchụaja ndị ọzọ ga-ebu igbe ọgbụgba ndụ. Nʼụbọchị nke asaa, unu ga-agba obodo ahụ gburugburu ugboro asaa. Mgbe unu na-eme nke a, ndị nchụaja asaa ahụ ga na-afụ opi mpi ebule ha.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.4",
            "verseOrgIds": [
              "JOS.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emesịa, ndị nchụaja ga-afụsi opi ahụ ike otu ugbo ọzọ, ha ga-afụ ya ka ọ daa ụda nke ukwu. Mgbe mmadụ niile nụrụ ụda opi a, ha niile ga-eti mkpu nke ga-ada ezi ụda. Nke a ga-eme ka mgbidi obodo ahụ daa. Mgbe ahụ, onye agha ọbụla ga-esite nʼebe ọbụla ọ nọ banye nʼime obodo ahụ.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.5",
            "verseOrgIds": [
              "JOS.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, Joshua nwa Nun kpọrọ ndị nchụaja sị ha, \"Burunu igbe ọgbụgba ndụ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.6",
            "verseOrgIds": [
              "JOS.6.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JOS.6.6",
                "verseOrgIds": [
                  "JOS.6.6"
                ]
              }
            }
          ]
        },
        {
          "text": "ahụ, ka ndị nchụaja asaa nʼime unu werekwa opi mpi ebule buru ụzọ na-aga nʼihu ya.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.6",
            "verseOrgIds": [
              "JOS.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ Joshua nyere ndị Izrel iwu sị ha, \"Zọlịenụ ije! Gbaanụ obodo a gburugburu, ka ndị agha na-aga nʼihu igbe ọgbụgba ndụ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.7",
            "verseOrgIds": [
              "JOS.6.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JOS.6.7",
                "verseOrgIds": [
                  "JOS.6.7"
                ]
              }
            }
          ]
        },
        {
          "text": ".\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.7",
            "verseOrgIds": [
              "JOS.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Joshua gwachara ndị Izrel okwu, ndị nchụaja asaa ahụ bu opi ike nʼaka ha, nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.8",
            "verseOrgIds": [
              "JOS.6.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JOS.6.8",
                "verseOrgIds": [
                  "JOS.6.8"
                ]
              }
            }
          ]
        },
        {
          "text": ", gafere nʼihu na-afụ opi ike ha. Ndị bu igbe ọgbụgba ndụ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.8",
            "verseOrgIds": [
              "JOS.6.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JOS.6.8",
                "verseOrgIds": [
                  "JOS.6.8"
                ]
              }
            }
          ]
        },
        {
          "text": "sochiri ha azụ.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.8",
            "verseOrgIds": [
              "JOS.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị agha na-aga nʼihu ndị nchụaja bụ ndị na-afụ opi ike, ebe ndị agha ndị ọzọ na-esote igbe ọgbụgba ndụ nʼazụ. Nʼoge a niile ha na-azọ ije, ndị na-afụ opi ike gara nʼihu na-eme nke a.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.9",
            "verseOrgIds": [
              "JOS.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Joshua nyere ndị Izrel iwu sị ha, \"Unu emela mkpọtụ agha ọbụla, maọbụ kwee ka anụ olu unu, maọbụ kwuo okwu ọbụla, tutu ruo ụbọchị m ga-asị unu tie mkpu. Mgbe m nyere unu iwu a, tienụ ezi mkpu.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.10",
            "verseOrgIds": [
              "JOS.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, e buuru igbe ọgbụgba ndụ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.11",
            "verseOrgIds": [
              "JOS.6.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JOS.6.11",
                "verseOrgIds": [
                  "JOS.6.11"
                ]
              }
            }
          ]
        },
        {
          "text": "ahụ jegharịa obodo ahụ gburugburu otu ugboro nʼụbọchị ahụ. Mgbe ha mesịrị nke a, onye ọbụla laghachiri nʼebe ụlọ ikwu ya dị rahụ ụra abalị.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.11",
            "verseOrgIds": [
              "JOS.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joshua biliri nʼisi ụtụtụ echi ya, ndị nchụaja bulikwara igbe ọgbụgba ndụ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.12",
            "verseOrgIds": [
              "JOS.6.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JOS.6.12",
                "verseOrgIds": [
                  "JOS.6.12"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.12",
            "verseOrgIds": [
              "JOS.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị nchụaja asaa ahụ bu opi ike asaa ndị ahụ, na-aga nʼihu igbe ọgbụgba ndụ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.13",
            "verseOrgIds": [
              "JOS.6.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JOS.6.13",
                "verseOrgIds": [
                  "JOS.6.13"
                ]
              }
            }
          ]
        },
        {
          "text": ", na-afụ opi ike ha na-esepụghị aka. Ndị agha nọ nʼihu ha, ebe ndị nche na-eso ndị bu igbe ọgbụgba ndụ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.13",
            "verseOrgIds": [
              "JOS.6.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JOS.6.13",
                "verseOrgIds": [
                  "JOS.6.13"
                ]
              }
            }
          ]
        },
        {
          "text": "nʼazụ, nʼoge niile a a na-afụ opi ike ndị a na-esepụghị aka.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.13",
            "verseOrgIds": [
              "JOS.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼụbọchị nke abụọ, ha gbara obodo ahụ gburugburu otu ugboro, laghachikwa nʼụlọ ikwu ha. Otu a ka ha mere ruo nʼụbọchị nke isii.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.14",
            "verseOrgIds": [
              "JOS.6.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma nʼisi ụtụtụ ụbọchị nke asaa, ha bilitere mgbe chi na-abọbeghị, gbaa obodo ahụ gburugburu ugboro asaa dịka ha na-eme. Ma ọ dị iche nʼụbọchị ahụ, bụ naanị na ha gbara obodo ahụ gburugburu ugboro asaa.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.15",
            "verseOrgIds": [
              "JOS.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "O ruo, nʼoge njegharị nke ugboro asaa ahụ, mgbe ndị nchụaja asaa ndị a fụsiri opi ike asaa ndị ahụ ike karịa, ka Joshua gwara ndị Izrel sị ha, \"Tienụ mkpu! Nʼihi na",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.16",
            "verseOrgIds": [
              "JOS.6.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JOS.6.16",
                "verseOrgIds": [
                  "JOS.6.16"
                ]
              }
            }
          ]
        },
        {
          "text": "enyela unu obodo a!",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.16",
            "verseOrgIds": [
              "JOS.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbuonụ ihe niile na-eku ume ndụ, nʼihi na obodo a na ihe niile dị nʼime ha bụ ihe e doro nsọ nye",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.17",
            "verseOrgIds": [
              "JOS.6.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JOS.6.17",
                "verseOrgIds": [
                  "JOS.6.17"
                ]
              }
            }
          ]
        },
        {
          "text": ". Ma ọ bụ naanị Rehab, nwanyị akwụna ahụ ka unu ga-ahapụ ndụ, ya na ndị ọbụla nọ nʼụlọ ya. Nʼihi na o zoro ndị anyị zigara inyochapụta obodo ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.17",
            "verseOrgIds": [
              "JOS.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOS 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma unu onwe unu, wezuganụ onwe unu pụọ nʼebe ihe ndị a kwadoro mbibi dị, ka unu gharakwa iweta ịla nʼiyi nye onwe unu site na iwere ihe ọbụla nʼime ha. Ma ọ bụghị otu a, unu ga-eme ka mbibi dakwasị ụlọ ikwu ụmụ Izrel niile.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.18",
            "verseOrgIds": [
              "JOS.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOS 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ihe niile e ji ọlaọcha na ọlaedo kpụọ, na ihe niile e ji bronz na igwe kpụọ, ka a ga-edo iche nye",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.19",
            "verseOrgIds": [
              "JOS.6.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JOS.6.19",
                "verseOrgIds": [
                  "JOS.6.19"
                ]
              }
            }
          ]
        },
        {
          "text": ". A ga-ewebata ha nʼụlọakụ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.19",
            "verseOrgIds": [
              "JOS.6.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JOS.6.19",
                "verseOrgIds": [
                  "JOS.6.19"
                ]
              }
            }
          ]
        },
        {
          "text": ".\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.19",
            "verseOrgIds": [
              "JOS.6.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOS 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ụda opi ike ahụ dasiri ike, ndị agha tiri mkpu, na ụda opi ike ahụ. Mgbe ndị ikom tiri oke mkpu, mgbidi ahụ dara dapịasịa, nke mere na onye ọbụla chere ihu banye nʼime obodo ahụ, lụgbuo obodo ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.20",
            "verseOrgIds": [
              "JOS.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOS 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha debere obodo a iche nye",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.21",
            "verseOrgIds": [
              "JOS.6.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JOS.6.21",
                "verseOrgIds": [
                  "JOS.6.21"
                ]
              }
            }
          ]
        },
        {
          "text": "site nʼiji mma agha ha gbuchapụ ihe niile dị ndụ nʼobodo ahụ, ma nwoke, ma nwanyị, ma nwantakịrị, ma okenye, ma ehi, ma atụrụ, ma ịnyịnya ibu, ihe niile dị nʼime ya.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.21",
            "verseOrgIds": [
              "JOS.6.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOS 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Joshua gwara ndị ikom abụọ ahụ buru ụzọ gaa nnyochapụta obodo ahụ anya sị ha, \"Mezuonụ nkwa unu kwere. Gaanụ nʼụlọ nwanyị akwụna, kpọpụta ya na ndị niile dị nʼụlọ ya.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.22",
            "verseOrgIds": [
              "JOS.6.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOS 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, ụmụ okorobịa abụọ ahụ bụ ndị mere nledo ala ahụ, bara nʼụlọ ahụ, kpọpụta Rehab na nna ya na nne ya na ụmụnne ya na ndị ikwu ya niile. Ha kpọpụtara ndị ezinaụlọ ya niile debe ha nʼotu ebe nke dị nʼazụ ọmụma ụlọ ikwu ụmụ Izrel.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.23",
            "verseOrgIds": [
              "JOS.6.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOS 6:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha kpọrọ obodo ahụ ọkụ, ya na ihe niile dị nʼime ya. Ma ha wepụtara naanị ọlaọcha na ọlaedo, na ihe niile e ji bronz na igwe kpụọ, tinye nʼụlọakụ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.24",
            "verseOrgIds": [
              "JOS.6.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JOS.6.24",
                "verseOrgIds": [
                  "JOS.6.24"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.24",
            "verseOrgIds": [
              "JOS.6.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOS 6:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joshua mere ka Rehab, nwanyị akwụna ahụ, na ndị ezinaụlọ ya niile dịrị ndụ. Nʼihi na Rehab zoro ndị ikom abụọ Joshua zigara, mee ka ha dị ndụ, bụ ndị gara inyochapụta obodo Jeriko. Ya mere, o binyere ndị Izrel ruo taa.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.25",
            "verseOrgIds": [
              "JOS.6.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOS 6:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Joshua gbara obodo Jeriko iyi sị, \"Ọbụbụ ọnụ ka a na-abụ nwoke ọbụla nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.26",
            "verseOrgIds": [
              "JOS.6.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JOS.6.26",
                "verseOrgIds": [
                  "JOS.6.26"
                ]
              }
            }
          ]
        },
        {
          "text": "nke ga-ebili wuokwa obodo Jeriko ọzọ.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.26",
            "verseOrgIds": [
              "JOS.6.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOS 6:26"
      },
      "items": [
        {
          "text": "\"Ndụ ọkpara",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.26",
            "verseOrgIds": [
              "JOS.6.26"
            ]
          }
        },
        {
          "text": "ya ka ọ ga-eji",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.26",
            "verseOrgIds": [
              "JOS.6.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOS 6:26"
      },
      "items": [
        {
          "text": "tọọ ntọala ya niile,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.26",
            "verseOrgIds": [
              "JOS.6.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOS 6:26"
      },
      "items": [
        {
          "text": "ndụ nwa ya nke nta,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.26",
            "verseOrgIds": [
              "JOS.6.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOS 6:26"
      },
      "items": [
        {
          "text": "ka ọ ga-eji guzobe ọnụ ụzọ ama ya niile ọtọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.26",
            "verseOrgIds": [
              "JOS.6.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JOS 6:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.27",
            "verseOrgIds": [
              "JOS.6.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JOS.6.27",
                "verseOrgIds": [
                  "JOS.6.27"
                ]
              }
            }
          ]
        },
        {
          "text": "nọnyeere Joshua. Akụkọ a kọrọ banyere ya gbasara nke ukwuu nʼala ahụ niile.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.27",
            "verseOrgIds": [
              "JOS.6.27"
            ]
          }
        }
      ]
    }
