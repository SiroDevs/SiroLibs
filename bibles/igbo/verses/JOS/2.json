  "verseCount": 24,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
        "style": "c",
        "sid": "JOS 2"
      },
      "items": [
        {
          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Rehab na ndị Nnyopụta",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joshua nwa Nun sitere na Shitim zipụ ndị nnyopụta abụọ na nzuzo sị ha, \"Gaanụ leta otu ihe si aga nʼala ahụ, karịsịa nʼobodo Jeriko.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.1",
            "verseOrgIds": [
              "JOS.2.1"
            ]
          }
        },
        {
          "text": "Ha gara nʼobodo ahụ baa nʼụlọ nwanyị akwụna aha ya bụ Rehab nọọ ọnọdụ nʼebe ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.1",
            "verseOrgIds": [
              "JOS.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma otu onye gwara eze Jeriko okwu sị, \"Lee, ụfọdụ ụmụ ndị ikom Izrel batara obodo a nʼabalị inyochapụta ala anyị.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.2",
            "verseOrgIds": [
              "JOS.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe eze Jeriko nụrụ okwu a, o zigaara Rehab ozi sị, \"Kpọpụta ndị ikom ahụ batara nʼụlọ gị nʼihi na ha bịara iledo ala anyị.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.3",
            "verseOrgIds": [
              "JOS.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma nwanyị ahụ zoro mmadụ abụọ ahụ. Mgbe ndị ahụ e ziri ozi bịarutere, ọ gwara ha okwu sị, \"Ọ bụ eziokwu na ndị ikom ahụ bakwutere m, ma amaghị m ebe ha si bịa.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.4",
            "verseOrgIds": [
              "JOS.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ha apụọlarị. Ha hapụrụ obodo a mgbe a na-achọ imechi ọnụ ụzọ ama, nʼoge ọchịchịrị bidoro ịgba. Amaghị m ebe ha gara. Ma, nʼuche m, ọ bụrụ na unu achụso ha ọsọ ọsịịsọ unu nwere ike ijide ha.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.5",
            "verseOrgIds": [
              "JOS.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Nʼeziokwu ọ bụ Rehab nʼonwe ya mere ka mmadụ abụọ ahụ rigoro nʼelu ụlọ ebe o zoro ha nʼokpuru ahịhịa flakisi ọ wụsara nʼebe ahụ.)",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.6",
            "verseOrgIds": [
              "JOS.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, ndị ikom ahụ pụrụ na-achụ ndị nnyopụta ahụ nʼakụkụ ụzọ gara ngabiga Jọdan. Ma ngwangwa ha pụrụ, e mechiri ọnụ ụzọ ama e si abata obodo ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.7",
            "verseOrgIds": [
              "JOS.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma tupu ndị nnyopụta ahụ edina ala ịrahụ ụra nʼabalị ahụ, Rehab rịgokwuru ha,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.8",
            "verseOrgIds": [
              "JOS.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "gwa ha sị, \"Ama m na",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.9",
            "verseOrgIds": [
              "JOS.2.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JOS.2.9",
                "verseOrgIds": [
                  "JOS.2.9"
                ]
              }
            }
          ]
        },
        {
          "text": "enyela unu ala a,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.9",
            "verseOrgIds": [
              "JOS.2.9"
            ]
          }
        },
        {
          "text": "marakwa na oke ụjọ nke egwu unu adakwasịla anyị, nke mere na ndị niile bi nʼime ala a na-agbaze nʼegwu nʼihi unu,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.9",
            "verseOrgIds": [
              "JOS.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "nʼihi na anyị anụla otu",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.10",
            "verseOrgIds": [
              "JOS.2.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JOS.2.10",
                "verseOrgIds": [
                  "JOS.2.10"
                ]
              }
            }
          ]
        },
        {
          "text": "si mee ka mmiri dị nʼOsimiri Uhie taa nʼihi unu, mgbe unu si nʼIjipt pụta. Anyị nụkwara ihe unu mere Saịhọn, na Ọg, bụ eze abụọ ndị Amọrị, ndị bi nʼọwụwa anyanwụ osimiri Jọdan, otu unu si bibie ha, gbuchapụ ndị niile bi nʼala ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.10",
            "verseOrgIds": [
              "JOS.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma mgbe anyị nụrụ ihe ndị a, obi anyị gbazere nʼihi ụjọ, mmụọ onye ọbụla dara mba nʼihi unu, nʼihi na",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.11",
            "verseOrgIds": [
              "JOS.2.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JOS.2.11",
                "verseOrgIds": [
                  "JOS.2.11"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke unu bụ Chineke nʼeluigwe na nʼụwa.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.11",
            "verseOrgIds": [
              "JOS.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ugbu a, ebe ọ bụ na m emeelara unu ebere, jirinụ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.12",
            "verseOrgIds": [
              "JOS.2.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JOS.2.12",
                "verseOrgIds": [
                  "JOS.2.12"
                ]
              }
            }
          ]
        },
        {
          "text": "ṅụọrọ m iyi na unu ga-emere ezinaụlọ m ebere. Gosinụ m ihe ịrịbama nʼeziokwu,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.12",
            "verseOrgIds": [
              "JOS.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "na unu ga-emekwa ka ndụ nna m, na nne m, na ụmụnne m ndị ikom na ndị inyom, na ndị ezinaụlọ ha niile dịrị, na unu ga-anapụta anyị site nʼọnwụ.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.13",
            "verseOrgIds": [
              "JOS.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị ikom ahụ kwere ya nkwa sị, \"Ndụ anyị lara ndụ unu. Ọ bụrụ na ị gbaghị anyị ama, anyị ga-egosi gị obi ebere na ikwesi ntụkwasị obi mgbe",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.14",
            "verseOrgIds": [
              "JOS.2.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JOS.2.14",
                "verseOrgIds": [
                  "JOS.2.14"
                ]
              }
            }
          ]
        },
        {
          "text": "ga-enye anyị ala a.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.14",
            "verseOrgIds": [
              "JOS.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụlọ Rehab dị nʼakụkụ mgbidi obodo ahụ. O ji ụdọ site na oghereikuku wedata ndị ikom abụọ ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.15",
            "verseOrgIds": [
              "JOS.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ gwakwara ha sị, \"Gbalaganụ nʼugwu, zoonụ onwe unu nʼebe ahụ ụbọchị atọ, tutu ndị ahụ na-achọ unu alaghachi azụ. Mgbe ahụ, unu nwere ike ịpụta laghachi ebe unu si bịa.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.16",
            "verseOrgIds": [
              "JOS.2.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị ahụ gwara ya sị, \"Iyi a i mere ka anyị ṅụọ agaghị adị ire megide anyị,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.17",
            "verseOrgIds": [
              "JOS.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOS 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "ma ọ bụrụ na nʼụbọchị ahụ anyị ga-abata ala a, i wereghị ụdọ ahụ na-acha uhie uhie kenye ya na oghereikuku i si wedata anyị, ma ọ bụrụkwa na ịkpọbataghị nʼụlọ gị nna gị, na nne gị, na ụmụnne gị ndị ikom, na ndị ezinaụlọ gị niile.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.18",
            "verseOrgIds": [
              "JOS.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOS 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ na onye ọbụla esite nʼụlọ gị pụọ nʼezi, ọbara ya agaghị adị anyị nʼisi, anyị agaghị abụkwa ndị ikpe mara. Ma ikpe ọmụma dịrị anyị ma ọ bụrụ nʼihe ọbụla emee onye ọbụla gị na ya so nọdụ nʼime ụlọ.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.19",
            "verseOrgIds": [
              "JOS.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOS 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ọ bụrụ na ị gbaa anyị ama, ọ dịkwaghị iwu ji anyị imezu iyi a i mere ka anyị ṅụọrọ gị.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.20",
            "verseOrgIds": [
              "JOS.2.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOS 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rehab zara sị ha, \"Dịka okwu niile unu kwuru si dị, otu a ka ọ ga-adị.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.21",
            "verseOrgIds": [
              "JOS.2.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JOS 2:21"
      },
      "items": [
        {
          "text": "O zilagara ha. Ha pụkwara gaara onwe ha. Ma Rehab kekwasịrị ụdọ uhie uhie ahụ nʼọnụ oghereikuku ụlọ ya.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.21",
            "verseOrgIds": [
              "JOS.2.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOS 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị ikom abụọ ahụ gara zoo onwe ha nʼugwu ahụ. Ha nọrọ ụbọchị atọ nʼebe ahụ dịka Rehab gwara ha, tutu ndị ahụ na-achụ ha laghachiri nʼobodo Jeriko. Ndị a chọọrọ ha gaa ebe niile, nʼokporoụzọ niile, ma ha ahụghị ha.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.22",
            "verseOrgIds": [
              "JOS.2.22"
            ]
          }
        },
        {
