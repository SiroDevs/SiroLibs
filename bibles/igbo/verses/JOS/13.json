  "verseCount": 33,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "13",
        "style": "c",
        "sid": "JOS 13"
      },
      "items": [
        {
          "text": "13",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ala fọdụrụ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼoge a, Joshua aghọọla agadi nwoke,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.1",
            "verseOrgIds": [
              "JOS.13.1"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.1",
            "verseOrgIds": [
              "JOS.13.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JOS.13.1",
                "verseOrgIds": [
                  "JOS.13.1"
                ]
              }
            }
          ]
        },
        {
          "text": "kpọrọ ya sị ya, \"Ugbu a, ị ghọọla agadi, ụbọchị ọgwụgwụ ndụ gị abịala nso, ma ọtụtụ ala fọdụrụ ndị a ga-emeri.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.1",
            "verseOrgIds": [
              "JOS.13.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ndị a bụ ala nke fọdụrụ unu ga-enweta:",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "JOS 13:2"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "JOS 13:2"
      },
      "items": [
        {
          "text": "\"ala ndị Filistia niile na ala ndị Geshua niile,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.2",
            "verseOrgIds": [
              "JOS.13.2"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.2",
            "verseOrgIds": [
              "JOS.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "site nʼosimiri Shaịho dị nʼọnụ Ijipt ruo nʼoke ala Ekrọn, nʼakụkụ ugwu ya, nke a gụnyere ndị Kenan, na ndịisi ise ndị Filistia: ndị Gaza, ndị Ashdọd, ndị Ashkelọn, ndị Gat, na ndị Ekrọn;",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.3",
            "verseOrgIds": [
              "JOS.13.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "JOS 13:3"
      },
      "items": [
        {
          "text": "nakwa ala ndị Ava,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.3",
            "verseOrgIds": [
              "JOS.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "site na ndịda ala ahụ niile dị nʼugwu;",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.4",
            "verseOrgIds": [
              "JOS.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "JOS 13:4"
      },
      "items": [
        {
          "text": "nʼala ndị Kenan, na Meara, nke bụ ala ndị Saịdọn, ruo nʼAfek, na oke ala ndị Amọrait;",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.4",
            "verseOrgIds": [
              "JOS.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "na ala ndị Gebal niile;",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.5",
            "verseOrgIds": [
              "JOS.13.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "JOS 13:5"
      },
      "items": [
        {
          "text": "na Lebanọn niile ruo nʼọwụwa anyanwụ, site Baal-Gad nʼokpuru ugwu Hemon ruo na mbata Hamat.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.5",
            "verseOrgIds": [
              "JOS.13.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ndị niile bi nʼala ugwu site na Lebanọn ruo Mizrefot Maim, ya bụ, ndị Saịdọn niile, Mụ onwe m ga-achụpụ ha site nʼihu ụmụ Izrel. Ihe dịrị gị bụ ike ala ahụ ka ọ bụrụ ihe nketa nye ndị Izrel, dịka mụ onwe m nyere gị iwu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.6",
            "verseOrgIds": [
              "JOS.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, kere ebo itoolu, na ọkara Manase, ala ndị a niile, ka ọ bụrụ ihe nketa ha.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.7",
            "verseOrgIds": [
              "JOS.13.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ala dị nʼọwụwa anyanwụ Jọdan",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọkara ebo Manase, na ebo Ruben, na Gad, enwetala ihe nketa ha nʼofe ọzọ nke Jọdan, nʼakụkụ ọwụwa anyanwụ, dịka Mosis onyeozi",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text"
            }
          ]
        },
        {
          "text": "nyere ha.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ala ha gbatịrị site nʼAroea nke dị na ndagwurugwu Anọn, na site nʼobodo dị nʼetiti ndagwurugwu ahụ, ruo nʼala dị larịị nke gbatịrị site na Medeba ruo Dibọn.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.9",
            "verseOrgIds": [
              "JOS.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ gbatịkwara ruo nʼoke ala ndị Amọn, tinyere obodo niile nke Saịhọn, eze ndị Amọrait na-achị mgbe o bi na Heshbọn.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.10",
            "verseOrgIds": [
              "JOS.13.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ gụnyekwara Gilead, nʼoke ala ndị Geshua, na ndị Maaka, na ugwu Hemon niile, na Bashan niile, ruokwa Saleka.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.11",
            "verseOrgIds": [
              "JOS.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya bụ, obodo niile nke Ọg eze ndị Bashan na-achị, mgbe isi alaeze ya dị nʼAshtarọt na Edrei. (Ọ bụ eze ikpeazụ nʼagbụrụ ndị Refaim.) Mosis busoro Saịhọn na Ọg agha, tigbuo ha, napụkwa ha ala ha.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.12",
            "verseOrgIds": [
              "JOS.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ndị Izrel achụpụghị ndị Geshua na ndị Maaka, ya mere, ha nọgidere na-ebi nʼetiti ụmụ Izrel ruo taa.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.13",
            "verseOrgIds": [
              "JOS.13.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "O nweghị ala o kenyere ebo Livayị. Nʼihi na",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.14",
            "verseOrgIds": [
              "JOS.13.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JOS.13.14",
                "verseOrgIds": [
                  "JOS.13.14"
                ]
              }
            }
          ]
        },
        {
          "text": "kwere ha nkwa na ihe nketa ha ga-abụ ihe aja onyinye niile e si nʼọkụ na-ewetara Onyenwe anyị Chineke Izrel.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.14",
            "verseOrgIds": [
              "JOS.13.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nke a bụ ala Mosis nyere ebo Ruben dịka agbụrụ ha si dị, ka ọ bụrụ ihe nketa ha.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ala ha gbatịrị site nʼAroea, na ndagwurugwu iyi Anọn, sitekwa nʼobodo dị nʼetiti ndagwurugwu ahụ na ala dị larịị gabiga gafee Medeba,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.16",
            "verseOrgIds": [
              "JOS.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "ruo Heshbọn, na obodo ndị ọzọ dị nʼala larịị ahụ, tinyere obodo Dibọn, na Bamot Baal, na Bet-Baal-Meon,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.17",
            "verseOrgIds": [
              "JOS.13.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOS 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Jahaz, na Kedemot, na Mefaat,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.18",
            "verseOrgIds": [
              "JOS.13.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOS 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Kiriatem, na Sibma, na Zeret Shaha, nke dị nʼugwu nta dị na ndagwurugwu ahụ;",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.19",
            "verseOrgIds": [
              "JOS.13.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOS 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Bet-Peoa, na Bet-Jeshimọt, nke dị nʼebe dị na mgbada ugwu Pisga;",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.20",
            "verseOrgIds": [
              "JOS.13.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOS 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "na obodo niile dị nʼala larịị ahụ, na ala Saịhọn niile, onye bụ eze ndị Amọrị nke chịrị na Heshbọn. Mosis lụgburu ya, lụgbukwaa ndịisi Midia bụ Evi, na nke Rekem, na nke Zua, na nke Hua, na nke Reba, ụmụ ndị eze ha na Saịhọn jikọtara aka buo agha.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.21",
            "verseOrgIds": [
              "JOS.13.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOS 13:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tinyere ndị ha gburu nʼọgbọ agha, ụmụ Izrel ji mma agha gbuo Belam nwa Beoa, onye na-agba aja.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.22",
            "verseOrgIds": [
              "JOS.13.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOS 13:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, oke ala ebo Ruben dị nʼọnụ mmiri osimiri Jọdan. Obodo ukwu na obodo nta ndị a bụ ihe ha nwetara dịka ihe nketa ha. Ezinaụlọ ọbụla nwetakwara oke nke ha dịka ikwu ha si dị.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOS 13:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mosis nyekwara ebo Gad ala nke ha site nʼala ahụ ha lụgburu, dịka ikwu ha si dị.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOS 13:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị a bụ ala ebo Gad nwetara: ala ahụ niile dị na Jeza, na obodo Gilead niile, na ọkara ala ndị Amọn nke ruru Areoa, nʼakụkụ Raba.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.25",
            "verseOrgIds": [
              "JOS.13.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOS 13:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ala sitere Heshbọn ruo Ramat Mizpa, na Betonim, na sitekwa Mahanaim ruo oke ala Debịa.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.26",
            "verseOrgIds": [
              "JOS.13.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JOS 13:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼime ndagwurugwu ala ha bụ Bet-Haram, na Bet-Nimra, na Sukọt, na Zafọn, na ala fọdụrụ nʼalaeze Saịhọn eze Heshbọn, nke dị nʼakụkụ ọwụwa anyanwụ osimiri Jọdan nʼoke ala ya ruokwa nsọtụ osimiri Galili.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.27",
            "verseOrgIds": [
              "JOS.13.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JOS 13:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obodo ndị a na obodo nta ndị ọzọ bụ ihe nketa ụmụ Gad dịka agbụrụ ha si dị.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JOS 13:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mosis nyekwara ikwu ọbụla dị nʼọkara ebo Manase ala nke ha, dịka mkpa ha si dị.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JOS 13:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ala ha ketara gbatịrị ruo Mahanaim. Ọ bụ ha nwekwa ala Bashan niile, na ala niile Ọg, eze Bashan, na-achị, tinyere iri obodo nta isii dị na Bashan, nke Jaịa wuru. Ha nwetakwara",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.30",
            "verseOrgIds": [
              "JOS.13.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JOS 13:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "ọkara Gilead, na Ashtarọt, na Edrei bụ isi obodo alaeze Ọg nʼime Bashan.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.31",
            "verseOrgIds": [
              "JOS.13.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4",
        "vid": "JOS 13:31"
      },
      "items": [
        {
          "text": "Ala ndị a niile ka e nyere ọkara ebo Manase, ya bụ ikwu niile e nwere site nʼụmụ Makia, ọkpara Manase.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JOS 13:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị a bụ otu Mosis si keere ụmụ Izrel ala dị nʼakụkụ ọwụwa anyanwụ osimiri Jọdan, mgbe ụmụ Izrel mara ụlọ ikwu ha nʼobosara ala Moab, na ncherita ihu obodo Jeriko.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JOS 13:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Mosis enyeghị ebo Livayị ala ọbụla, nʼihi na ọ gwara ha na",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text"
            }
          ]
        },
        {
          "text": ", Chineke Izrel bụ ihe nketa ha nwere, dịka o kwere ha na nkwa.",
          "type": "text"
        }
      ]
    }
  ],
