  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
        "style": "c",
        "sid": "1TI 6"
      },
      "items": [
        {
          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1TI 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị niile bụ ohu ga-ahụ ndị nwe ha dị ka ndị ekwesiri inye ugwu na nsọpụrụ, ka a ghara ikwujọ aha Chineke na ozizi anyị.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.1",
            "verseOrgIds": [
              "1TI.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1TI 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị nke nwere ndị kwere ekwe dịka ndị nwe ha ekwesighị ilelị ha anya nʼihi na ha bụ ụmụnna ha. Kama, ha kwesiri ijere ndị nwe ha ozi nke ọma karịa, nʼihi na ndị na-erite uru nʼọrụ ha bụ ndị kwere ekwe bụrụkwa ndị anyị hụrụ nʼanya.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.2",
            "verseOrgIds": [
              "1TI.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1",
        "vid": "1TI 6:2"
      },
      "items": [
        {
          "text": "Ndị ozizi ụgha na ịhụ ego nʼanya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1TI 6:2"
      },
      "items": [
        {
          "text": "Ihe ndị a ka ị ga-akụziri ha, dụkwaa ha ọdụ banyere ime nke a.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.2",
            "verseOrgIds": [
              "1TI.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1TI 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye ọbụla na-ezi ihe ọzọ nke na-adabaghị nʼokwu ezi ntọala na-enye ndụ nke Onyenwe anyị Jisọs Kraịst, ya na ozizi nke ibi ndụ kwesiri onye nke Chineke,",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.3",
            "verseOrgIds": [
              "1TI.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1TI 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "bụ onye nganga na-afụli elu, ma bụrụkwa onye na-amaghị ihe. Ọchịchọ obi ya bụ nke na-ezighị ezi ma jupụtakwa nʼịrụ ụka na ekworo nke na-eweta ịkpọ asị na esemokwu, na nkwulu nakwa ajọ echiche,",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.4",
            "verseOrgIds": [
              "1TI.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1TI 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "na isi ịrụ ụka niile nke na-esite nʼaka ụmụ mmadụ ndị echiche ha na-enweghịkwa eziokwu. Ha na-eche na ife Chineke bụ ụzọ e si aba ọgaranya.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.5",
            "verseOrgIds": [
              "1TI.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1TI 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ikpere Chineke bara uru nke ukwuu nye onye nwere afọ ojuju nʼihe ọbụla o nwere.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.6",
            "verseOrgIds": [
              "1TI.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1TI 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na o nweghị ihe anyị ji nʼaka mgbe anyị bịara nʼụwa, otu a kwa, o nweghị ihe anyị ga-ewerekwa mgbe anyị ga-esi nʼụwa pụọ.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.7",
            "verseOrgIds": [
              "1TI.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1TI 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, ọ bụrụ na anyị enwe ihe oriri na uwe anyị ji ekpuchi ọtọ anyị, afọ kwesiri iju anyị nʼihe anyị nwere.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.8",
            "verseOrgIds": [
              "1TI.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1TI 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ndị na-achọ ịba ọgaranya na-adaba nʼọnwụnwa na nʼime ọnya na ọtụtụ ihe nzuzu na ọchịchọ ọjọọ niile dị iche iche nke na-enubanye ha nʼịla nʼiyi na mbibi.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.9",
            "verseOrgIds": [
              "1TI.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1TI 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na ịhụ ego nʼanya bụ mgbọrọgwụ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.10",
            "verseOrgIds": [
              "1TI.6.10"
            ]
          }
        },
        {
          "text": "nke ime ihe ọjọọ niile dị iche iche. Ụfọdụ ndị hụrụ ego nʼanya, ndị na-achọsi ya ike, adapụla nʼokwukwe ha, si otu a tinye onwe ha nʼọtụtụ ọnọdụ na-ewetara ha obi ọjọọ na iru ụjụ.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.10",
            "verseOrgIds": [
              "1TI.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ndụmọdụ mmechi Pọl dụrụ Timoti",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1TI 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma gị bụ onye nke Chineke, gbaara ihe ndị a niile ọsọ. Ma chụsoo ezi omume na iyi Chineke, na okwukwe, na ịhụnanya, na ntachiobi, na ịdị nwayọ.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.11",
            "verseOrgIds": [
              "1TI.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1TI 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na-agbasi mgba ọma nke okwukwe gị ike, jidesiekwa ndụ ebighị ebi ahụ aka ike bụ nke a kpọrọ gị oku maka ya mgbe i mere ezi nkwupụta gị nʼihu ọtụtụ ndị akaebe.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.12",
            "verseOrgIds": [
              "1TI.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1TI 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihu Chineke, onye na-enye ihe niile ndụ, na nʼihu Kraịst Jisọs onye gbara ama nkwupụta ọma nʼihu Pọntiọs Pailet. Ana m enye gị iwu",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.13",
            "verseOrgIds": [
              "1TI.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1TI 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka i debezuo ihe niile e nyere nʼiwu na-enweghị ntụpọ ọbụla maọbụ ịta ụta ruo mgbe Onyenwe anyị Jisọs Kraịst ga-apụta ihe.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.14",
            "verseOrgIds": [
              "1TI.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1TI 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nke a ga-emezu mgbe oge zuru site nʼike ya, Chineke, onye dị ngọzị na onye naanị ya na-achị, Eze kachasị eze niile, na Onyenwenụ kachasị ndị nwenụ niile.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.15",
            "verseOrgIds": [
              "1TI.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1TI 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye naanị ya na-adịghị anwụ anwụ. Onye na-ebikwa nʼime ìhè nke mmadụ ọbụla na-apụghị ịbịaru nso. Onye mmadụ ọbụla na-ahụbeghị anya mgbe ọbụla, onye a na-apụghịkwa ịhụ anya. Ọ bụ ya ka nsọpụrụ na ike dịrị ruo mgbe ebighị ebi. Amen.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.16",
            "verseOrgIds": [
              "1TI.6.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ndị ọgaranya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1TI 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nye ndị bụ ọgaranya nʼoge ugbu a iwu ka ha ghara ịnya isi, maọbụ tụkwasị obi ha nʼakụnụba, nke a na-ejighị aka. Kama ka ntụkwasị obi ha dịrị na Chineke onye na-enyezu anyị ihe niile site nʼakụ ya nʼihi ime anyị obi ụtọ.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.17",
            "verseOrgIds": [
              "1TI.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1TI 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gwa ha ka ha na-eme ezi ihe, ka ha bụrụ ọgaranya nʼọrụ ọma niile, ka ha nwee obiọma na inyere ndị ọzọ aka, dịkwa njikere ikenye ndị ọzọ ihe site nʼihe ha nwere.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.18",
            "verseOrgIds": [
              "1TI.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1TI 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼụzọ dị otu a, ha na-akpadoro onwe ha akụ nke ga-abụrụ ha ntọala siri ike nʼọgbọ dị nʼihu, nke a ga-eme ka ha rite ndụ ahụ nke bụ ezigbo ndụ nʼuru.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.19",
            "verseOrgIds": [
              "1TI.6.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1TI 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Timoti chebekwa ihe ndị ahụ e nyefere gị nʼaka, wezuga onwe gị site nʼokwu nzuzu nke rụrụ arụ, na ịrụ ụka nzuzu nke ha na-akpọ ihe ọmụma,",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.20",
            "verseOrgIds": [
              "1TI.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1TI 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "bụ nke ụfọdụ kwupụtara, ma na ime nke a, ha esitela nʼụzọ okwukwe kpafuo.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.21",
            "verseOrgIds": [
              "1TI.6.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "1TI 6:21"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "1TI 6:21"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1TI 6:21"
      },
      "items": [
        {
          "text": "Ka amara dịnyere gị. Amen.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.21",
            "verseOrgIds": [
              "1TI.6.21"
            ]
          }
        }
      ]
    }
  ],
