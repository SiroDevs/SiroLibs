{
  "id": "LUK.5",
  "number": "5",
  "bookId": "LUK",
  "reference": "Luk 5",
  "copyright": "Biblica® Open Igbo Contemporary Bible™ Copyright © 1980, 1988, 2019, 2020 by Biblica, Inc. Used with permission. All rights reserved worldwide.",
  "verseCount": 39,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
        "style": "c",
        "sid": "LUK 5"
      },
      "items": [
        {
          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ọkpụkpọ ndị mbụ na-eso ụzọ ya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LUK 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otu oge, ka Jisọs guzo nʼakụkụ ọdọ mmiri Genesaret.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.1",
            "verseOrgIds": [
              "LUK.5.1"
            ]
          }
        },
        {
          "text": "Igwe mmadụ gbara ya gburugburu ka ha nụrụ okwu Chineke.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.1",
            "verseOrgIds": [
              "LUK.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ hụrụ nʼọnụ mmiri ahụ, ụgbọ mmiri abụọ nke ndị ọkụ azụ nwe ha hapụrụ gaa ịsa ụgbụ ha ji egbu azụ.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.2",
            "verseOrgIds": [
              "LUK.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ banyere nʼime otu ụgbọ mmiri ndị ahụ, nke bụ nke Saimọn, ọ rịọrọ ya ka ọ kwọrọ ya banyetụ ntakịrị nʼime mmiri. Ọ nọdụrụ ala nʼime ya bido na-ezi igwe mmadụ ihe.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.3",
            "verseOrgIds": [
              "LUK.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe o kwusiri okwu, ọ gwara Saimọn sị,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.4",
            "verseOrgIds": [
              "LUK.5.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Banyetụkwuo nʼime mmiri, tụnye ụgbụ gị ka i gbute azụ.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.5.4",
                "verseOrgIds": [
                  "LUK.5.4"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saimọn zara sị, \"Nna anyị ukwuu, anyị rụsịrị ọrụ ike abalị niile na-egbutaghị ihe ọbụla, ma otu i sịrị kwuo, aga m awụnye ụgbụ azụ niile.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.5",
            "verseOrgIds": [
              "LUK.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ha mere nke a, ha gbutere ọtụtụ azụ nke mere na ụgbụ azụ ha malitere ịdọkasị.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.6",
            "verseOrgIds": [
              "LUK.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha kpọrọ ndị ọkụ azụ ibe ha nọ nʼụgbọ mmiri ọzọ ka ha bịa nyere ha aka. Ha bịara kpojuo azụ nʼụgbọ mmiri abụọ ahụ nke malitere imikpu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.7",
            "verseOrgIds": [
              "LUK.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma mgbe Saimọn Pita hụrụ nke a, ọ dara nʼukwu Jisọs sị, \"Si nʼebe m nọ pụọ, Onyenwe m, nʼihi na abụ m onye mmehie.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.8",
            "verseOrgIds": [
              "LUK.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na o juru ya na ndị ya na ha so anya ịhụ ọtụtụ azụ ndị a ha gbutere.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.9",
            "verseOrgIds": [
              "LUK.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụladị Jemis na Jọn ụmụ Zebedi, ndị ha na Saimọn na-arụkọ ọrụ, ka ihe a jukwara anya.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.10",
            "verseOrgIds": [
              "LUK.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "LUK 5:10"
      },
      "items": [
        {
          "text": "Mgbe ahụ Jisọs gwara Saimọn sị,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.10",
            "verseOrgIds": [
              "LUK.5.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Atụla egwu, nʼihi na site ugbu a gaa nʼihu, ị ga na-akụta mmadụ.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.5.10",
                "verseOrgIds": [
                  "LUK.5.10"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.10",
            "verseOrgIds": [
              "LUK.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ha kwọpụtara ụgbọ mmiri ha nʼelu ala, ha hapụrụ ihe niile soro ya.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.11",
            "verseOrgIds": [
              "LUK.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nwoke onye ekpenta",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Jisọs nọ nʼotu obodo, otu nwoke onye ekpenta juru ahụ, bịara daa, kpudo ihu ya nʼala mgbe ọ hụrụ ya, rịọ ya sị, \"Onyenwe m, ọ bụrụ na ị chọrọ, ị pụrụ ime ka m dị ọcha.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.12",
            "verseOrgIds": [
              "LUK.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jisọs setịpụrụ aka ya metụ ya sị,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.13",
            "verseOrgIds": [
              "LUK.5.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Achọrọ m, bụrụ onye dị ọcha!\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.5.13",
                "verseOrgIds": [
                  "LUK.5.13"
                ]
              }
            }
          ]
        },
        {
          "text": "Ngwangwa ekpenta ahụ hapụrụ ya.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.13",
            "verseOrgIds": [
              "LUK.5.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "O nyere ya iwu,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.14",
            "verseOrgIds": [
              "LUK.5.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"A gwakwala onye ọbụla, kama gaa gosi onye nchụaja onwe gị, chụọkwa aja dị ka Mosis nyere nʼiwu maka ime ka ị dị ọcha, ka ọ bụrụ ihe ama nye ha.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.5.14",
                "verseOrgIds": [
                  "LUK.5.14"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma akụkọ banyere ya gbasara karịa, nke mere na igwe mmadụ bịara ịnụrụ ihe ọ na-ekwu, na ka a gwọọkwa ha nrịa nrịa.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.15",
            "verseOrgIds": [
              "LUK.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma site nʼoge ruo nʼoge, Jisọs na-ewezuga onwe ya gaa nʼebe ọ ga-anọ naanị ya ikpe ekpere.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.16",
            "verseOrgIds": [
              "LUK.5.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ọgwụgwọ onye akụkụ ahụ ya kpọnwụrụ akpọnwụ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otu ụbọchị, mgbe ọ nọ na-ezi ndị mmadụ ihe, ndị Farisii na ndị ozizi iwu (sitere nʼobodo nta niile dị na Galili na Judịa na Jerusalem bịa nọdụkwa ebe) ahụ. Ike Chineke dịnyekwaara ya ịgwọ ndị ọrịa.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.17",
            "verseOrgIds": [
              "LUK.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼoge ahụ ndị ikom ụfọdụ bu otu nwoke akụkụ ahụ ya kpọnwụrụ akpọnwụ nʼihe ndina ya, bịara gbalịa isite nʼọnụ ụzọ ụlọ ahụ bubata ya tọgbọ ya nʼụkwụ ya.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.18",
            "verseOrgIds": [
              "LUK.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ha na-enweghị ike ime nke a nʼihi igwe mmadụ, ha rigooro nʼelu ụlọ, site nʼoghere wetuo nwoke ahụ nʼute ya nʼetiti igwe mmadụ nʼihu Jisọs.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.19",
            "verseOrgIds": [
              "LUK.5.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Jisọs hụrụ okwukwe ha, ọ sịrị,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.20",
            "verseOrgIds": [
              "LUK.5.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Enyi m, a gbagharala gị mmehie gị.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.5.20",
                "verseOrgIds": [
                  "LUK.5.20"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị Farisii na ndị ozizi iwu malitere iche nʼime obi ha sị, \"Onye bụ onye a na-ekwulu Chineke? Onye pụrụ ịgbaghara mmadụ mmehie, ma ọ bụghị naanị Chineke?\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.21",
            "verseOrgIds": [
              "LUK.5.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 5:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Jisọs matara ihe ha na-ajụ, ọ zara ha sị,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.22",
            "verseOrgIds": [
              "LUK.5.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Gịnị mere unu ji na-eche ihe ndị a nʼobi unu?",
              "type": "text",
              "attrs": {
                "verseId": "LUK.5.22",
                "verseOrgIds": [
                  "LUK.5.22"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.22",
            "verseOrgIds": [
              "LUK.5.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 5:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Olee nke ka mfe ikwu: Ọ bụ a gbagharala gị mmehie gị niile, ka ọ bụ ị sị, Bilie jee ije?",
              "type": "text",
              "attrs": {
                "verseId": "LUK.5.23",
                "verseOrgIds": [
                  "LUK.5.23"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.23",
            "verseOrgIds": [
              "LUK.5.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 5:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ma ka unu mata na Nwa nke Mmadụ nwere ikike nʼụwa ịgbaghara mmehie.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.5.24",
                "verseOrgIds": [
                  "LUK.5.24"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọ sịrị onye ahụ akụkụ ahụ ya kpọnwụrụ akpọnwụ,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.24",
            "verseOrgIds": [
              "LUK.5.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Asị m gị, bilie, chịrị ute gị laa nʼụlọ gị!\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.5.24",
                "verseOrgIds": [
                  "LUK.5.24"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.24",
            "verseOrgIds": [
              "LUK.5.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 5:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngwangwa, o biliri ọtọ nʼihu mmadụ niile, chịrị ihe ndina ya bido na-eto Chineke na-ala nʼụlọ ya.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.25",
            "verseOrgIds": [
              "LUK.5.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 5:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihe ndị a juru onye ọbụla anya, ha tokwara Chineke. Oke egwu jupụtakwara ha nʼahụ, ha sịrị, \"Anyị ahụla ihe ebube taa.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.26",
            "verseOrgIds": [
              "LUK.5.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ọkpụkpọ Livayị",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 5:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe nke a gasịrị, ọ pụrụ hụ otu onye ọna ụtụ aha ya bụ Livayị, ka ọ nọdụrụ ala nʼụlọ ịnakọta ụtụ ya. Ọ sịrị ya,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.27",
            "verseOrgIds": [
              "LUK.5.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Soro m.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.5.27",
                "verseOrgIds": [
                  "LUK.5.27"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.27",
            "verseOrgIds": [
              "LUK.5.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 5:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngwangwa, o biliri, hapụ ihe niile soro ya.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.28",
            "verseOrgIds": [
              "LUK.5.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 5:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emesịa, Livayị kwadooro Jisọs oke oriri nʼụlọ ya, ọtụtụ igwe ndị ọna ụtụ na ndị ọzọ soo ha nʼoriri ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.29",
            "verseOrgIds": [
              "LUK.5.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 5:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ndị Farisii na ndị ozizi iwu tamuru ntamu na-ajụ ndị na-eso ụzọ ya sị, \"Gịnị mere unu ji soro ndị ọna ụtụ na ndị mmehie na-erikọ nri na-aṅụkọkwa ihe ọṅụṅụ?\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.30",
            "verseOrgIds": [
              "LUK.5.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 5:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jisọs zara sị,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.31",
            "verseOrgIds": [
              "LUK.5.31"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mkpa dibịa adịghị akpa ndị ahụ dị ike, kama ọ bụ ndị ahụ na-esighị ike.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.5.31",
                "verseOrgIds": [
                  "LUK.5.31"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.31",
            "verseOrgIds": [
              "LUK.5.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 5:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Abịaghị m ịkpọ ndị ezi omume, kama abịara m ịkpọ ndị mmehie ka ha chegharịa.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.5.32",
                "verseOrgIds": [
                  "LUK.5.32"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ajụjụ banyere ibu ọnụ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LUK 5:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha sịrị, \"Ndị na-eso ụzọ Jọn na ndị na-eso ụzọ ndị Farisii na-ebu ọnụ, na-ekpe ekpere oge niile, ma ndị na-eso ụzọ gị na-eri, na-aṅụkwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.33",
            "verseOrgIds": [
              "LUK.5.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LUK 5:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jisọs sịrị ha,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.34",
            "verseOrgIds": [
              "LUK.5.34"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ndị a kpọrọ oriri nʼọlụlụ di na nwunye, ha ga-ebu ọnụ mgbe ha na onye na-alụ nwunye ọhụrụ nọ?",
              "type": "text",
              "attrs": {
                "verseId": "LUK.5.34",
                "verseOrgIds": [
                  "LUK.5.34"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.34",
            "verseOrgIds": [
              "LUK.5.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 5:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ma oge na-abịa mgbe a ga-ewepụ onye na-alụ nwunye nʼetiti ha, mgbe ahụ ka ha ga-ebu ọnụ.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.5.35",
                "verseOrgIds": [
                  "LUK.5.35"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LUK 5:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ tụụrụ ha ilu a,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.36",
            "verseOrgIds": [
              "LUK.5.36"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"O nweghị onye na-adọkara akwa ọhụrụ were ya kwachie akwa ochie. Ọ bụrụ na e mee nke a, ọ pụtara na a dọwaala akwa ọhụrụ ahụ nʼihi na nke ahụ eji kwachie ya agaghị adaba.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.5.36",
                "verseOrgIds": [
                  "LUK.5.36"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.36",
            "verseOrgIds": [
              "LUK.5.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LUK 5:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nʼụzọ dị otu a kwa, mmadụ adịghị agbanye mmanya ọhụrụ dị ike nʼime karama akpụkpọ ochie. Nʼihi na ike si na mmanya ọhụrụ ahụ ga-eme ka karama ahụ gbawaa. Mmanya ahụ ga-awụfukwa, karama ahụ a laa nʼiyi.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.5.37",
                "verseOrgIds": [
                  "LUK.5.37"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.37",
            "verseOrgIds": [
              "LUK.5.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LUK 5:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ma ọ dị mma ịgbanye mmanya ọhụrụ nʼime karama akpụkpọ ọhụrụ.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.5.38",
                "verseOrgIds": [
                  "LUK.5.38"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.38",
            "verseOrgIds": [
              "LUK.5.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LUK 5:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "O nweghị onye ṅụsịrị mmanya ochie ga-achọ ịṅụ mmanya ọhụrụ, nʼihi na ọ ga-asị, 'Nke ochie ahụ ka mma.' \"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.5.39",
                "verseOrgIds": [
                  "LUK.5.39"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
