  "verseCount": 35,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "14",
        "style": "c",
        "sid": "LUK 14"
      },
      "items": [
        {
          "text": "14",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jisọs agaa nʼụlọ onye Farisii",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LUK 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otu ụbọchị izuike, mgbe ọ gara iri ihe nʼụlọ otu onyendu ndị Farisii, ha nọ na-ele ya anya nke ọma.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.1",
            "verseOrgIds": [
              "LUK.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma lee, otu nwoke ahụ ya zara aza nọkwa nʼihu ya ebe ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.2",
            "verseOrgIds": [
              "LUK.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jisọs jụrụ ndị Farisii na ndị ozizi iwu sị,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.3",
            "verseOrgIds": [
              "LUK.14.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"O ziri ezi nʼiwu ịgwọ ọrịa nʼụbọchị izuike ka ọ bụ na o zighị?\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.3",
                "verseOrgIds": [
                  "LUK.14.3"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.3",
            "verseOrgIds": [
              "LUK.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ha e kwughị okwu ọbụla. Ya mere ọ kpọrọ ya, gwọọ ya ma sị ya laa.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.4",
            "verseOrgIds": [
              "LUK.14.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ sịrị ha,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.5",
            "verseOrgIds": [
              "LUK.14.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ọ bụrụ na otu nʼime unu nwere nwa nwoke maọbụ oke ehi nke dabara nʼime olulu mmiri nʼụbọchị izuike, ọ bụ na ọ gaghị eme ngwangwa dọpụta ya?\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.5",
                "verseOrgIds": [
                  "LUK.14.5"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.5",
            "verseOrgIds": [
              "LUK.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ha enweghị ike ịza ajụjụ a.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.6",
            "verseOrgIds": [
              "LUK.14.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ọ hụrụ otu ndị a kpọrọ oriri si họrọ naanị oche ndị a na-asọpụrụ, oche ndị a na-asọpụrụ, ọ tụrụ ha ilu sị,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.7",
            "verseOrgIds": [
              "LUK.14.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mgbe mmadụ ọbụla kpọrọ gị oriri nʼọlụlụ di na nwunye, abatala nọdụ nʼoche ndị a na-asọpụrụ, nʼihi na eleghị anya, onye kpọrọ gị oriri kpọkwara onye ka gị nwe nsọpụrụ.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.8",
                "verseOrgIds": [
                  "LUK.14.8"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.8",
            "verseOrgIds": [
              "LUK.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nʼihi na onye ahụ kpọrọ unu oriri nwere ike bịakwute gị sị gị, nye nwoke a ọnọdụ gị. Mgbe ahụ, ị ga-ebili nʼanya ihere gaa nọdụ nʼoche dịkarịsịrị ala.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.9",
                "verseOrgIds": [
                  "LUK.14.9"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.9",
            "verseOrgIds": [
              "LUK.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ma mgbe a kpọrọ gị, nọdụ nʼoche dị ala, ka ọ ga-abụ na onye kpọrọ gị oriri bịa, ọ ga-asị gị 'Enyi m, rigota nʼebe a ka elu.' Mgbe ahụ, ị ga-enwekwa ugwu nʼanya ndị niile a kpọrọ gị na ha oriri.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.10",
                "verseOrgIds": [
                  "LUK.14.10"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.10",
            "verseOrgIds": [
              "LUK.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nʼihi na onye ọbụla ga-ebuli onwe ya elu ka a ga-eweda nʼala, ma onye ọbụla na-eweda onwe ya ala ka a ga-ebuli elu.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.11",
                "verseOrgIds": [
                  "LUK.14.11"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ gwara onye ahụ kpọrọ ya oriri sị,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.12",
            "verseOrgIds": [
              "LUK.14.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mgbe ị na-akpọ oriri nke nri ehihie maọbụ nke nri anyasị, akpọla naanị ndị enyi gị maọbụ ụmụnne gị ndị nwoke maọbụ ndị ikwu na ibe gị, maọbụ ndị agbataobi gị bara ọgaranya, nʼihi ma eleghị anya, ha pụrụ ịkpọkwa gị na mgbe nke ha, sị otu a kwụghachi gị ụgwọ.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.12",
                "verseOrgIds": [
                  "LUK.14.12"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.12",
            "verseOrgIds": [
              "LUK.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kama mgbe ị na-akpọ oriri, kpọọ ndị ogbenye na ndị ọlụsị na ndị ngwụrọ na ndị ìsì.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.13",
                "verseOrgIds": [
                  "LUK.14.13"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.13",
            "verseOrgIds": [
              "LUK.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "A ga-agọzikwa gị, nʼihi na ha enweghị ike ịkwụghachi gị, a ga-akwụghachikwa gị mgbe ndị ezi omume ga-ebili nʼọnwụ.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.14",
                "verseOrgIds": [
                  "LUK.14.14"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ilu banyere oke oriri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe otu nʼime ndị a kpọrọ oriri nụrụ nke a, ọ sịrị ya, \"Ngọzị ga-adịrị onye ga-eso rie oriri nʼalaeze Chineke.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.15",
            "verseOrgIds": [
              "LUK.14.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ọ sịrị ya,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.16",
            "verseOrgIds": [
              "LUK.14.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Otu onye na-akwado oke oriri kpọkwa ọtụtụ mmadụ oku.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.16",
                "verseOrgIds": [
                  "LUK.14.16"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.16",
            "verseOrgIds": [
              "LUK.14.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mgbe oge oriri ahụ ruru, o zipụrụ ohu ya ka ọ ga gwa ndị ahụ ọ kpọrọ sị, 'Bịanụ, nʼihi na e dozichaala ihe niile.'",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.17",
                "verseOrgIds": [
                  "LUK.14.17"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ma ha niile nʼotu nʼotu malitere inye ọsịsa. Onye nke mbụ sịrị, 'Azụrụ m iberibe ala ọhụrụ, ọ dịkwa mkpa na m ga-eje hụ ya, biko gbaghara m, agaghị m abịa.'",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.18",
                "verseOrgIds": [
                  "LUK.14.18"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Onye nke ọzọ sịrị, 'Azụrụ m ehi e ji arụ ọrụ ubi, iri e jikọrọ abụọ abụọ. Ana m aga ugbu a ka m nwalee ha, biko gbaghara m, agaghị m abịa.'",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.19",
                "verseOrgIds": [
                  "LUK.14.19"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ma onye ọzọ sịkwara, 'Alụrụ m nwunye ọhụrụ, nʼihi nke a agaghị m abịa.'",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.20",
                "verseOrgIds": [
                  "LUK.14.20"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ohu ahụ lọtara, kọọrọ nna ya ukwu ihe ndị ahụ a kpọrọ oriri kwuru. Mgbe ahụ, iwe dị ukwuu were nna ya ukwu, nke a mere ka o zipụ ohu ya sị ya, 'Gaa ngwangwa nʼokporoụzọ ukwu na nʼokporoụzọ nta dị nʼobodo a, kpọbata ndị ogbenye, na ndị ụkwụ rụrụ, na ndị ìsì na ndị ngwụrọ.'",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.21",
                "verseOrgIds": [
                  "LUK.14.21"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 14:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ohu ahụ sịrị, 'Nna m ukwu, emeela m ihe i kwuru, ma ohere ka fọdụrụ.'",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.22",
                "verseOrgIds": [
                  "LUK.14.22"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Nna ukwu ahụ sịrị ohu ahụ, 'Gaakwa nʼokporoụzọ ukwu na okporoụzọ nta, mee ka ndị mmadụ bata nʼụlọ m, ka ụlọ m jupụta na mmadụ.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.23",
                "verseOrgIds": [
                  "LUK.14.23"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.23",
            "verseOrgIds": [
              "LUK.14.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 14:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nʼihi na agwa m unu, ọ dịghị otu onye nʼime ndị ahụ a kpọrọ oriri ga-edetụ nri m ọnụ.' \"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.24",
                "verseOrgIds": [
                  "LUK.14.24"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ihe ọ na-efu iso Jisọs",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 14:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ugbu a, oke igwe mmadụ na-eso ya ma ọ tụgharịrị sị ha:",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.25",
            "verseOrgIds": [
              "LUK.14.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 14:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Onye ọbụla chọrọ iso m, ma o bụghị ụzọ kpọ nne na nna ya, na nwunye ya, na ụmụ ya, na ụmụnne ya ndị nwoke na ndị nwanyị tinyekwara ndụ nke ya onwe ya asị, apụghị ịbụ onye na-eso ụzọ m.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.26",
                "verseOrgIds": [
                  "LUK.14.26"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.26",
            "verseOrgIds": [
              "LUK.14.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 14:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Onye ọbụla na-eburughị obe ya soro m, enweghị ike ịbụ onye na-eso ụzọ m.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.27",
                "verseOrgIds": [
                  "LUK.14.27"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 14:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ọ dị onye ọbụla nʼime unu chọrọ iwu ụlọ elu, na-agaghị ebu ụzọ nọdụ ala, gbakọọ ihe ọ ga-efu ya, iji chọpụta ma o nwekwara ego ga-ezu iwucha ya?",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.28",
                "verseOrgIds": [
                  "LUK.14.28"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.28",
            "verseOrgIds": [
              "LUK.14.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 14:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nʼihi na ọ bụrụ na ọ tọọ ntọala ma o nwekwaghị ike wuchaa ya, onye ọbụla hụrụ ya ga-achị ya ọchị,",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.29",
                "verseOrgIds": [
                  "LUK.14.29"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.29",
            "verseOrgIds": [
              "LUK.14.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 14:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "na-asị, 'Nwoke a malitere iwu ụlọ, ma o nweghị ike wuchaa ya.'",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.30",
                "verseOrgIds": [
                  "LUK.14.30"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 14:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Maọbụ olee eze chọrọ ịlụso eze ibe ya ọgụ, ọ gaghị ebu ụzọ nọdụ ala tulee ma puku ndị agha iri ya ọ ga-ezuru ya iji lụso onye ji iri puku ndị agha abụọ abịakwute ya ọgụ?",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.31",
                "verseOrgIds": [
                  "LUK.14.31"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.31",
            "verseOrgIds": [
              "LUK.14.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 14:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ọ bụrụ na o nweghị ike, ọ ga-ezipụ ozi rịọ ka e kpee udo mgbe onye nke ọzọ ka nọ nʼebe dị anya.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.32",
                "verseOrgIds": [
                  "LUK.14.32"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.32",
            "verseOrgIds": [
              "LUK.14.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LUK 14:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nʼụzọ dị otu a, onye ọbụla na-ajụghị ihe niile o nwere, apụghị ịbụ onye na-eso ụzọ m.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.33",
                "verseOrgIds": [
                  "LUK.14.33"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LUK 14:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Nnu dị mma, ma ọ bụrụ na ọ dịghị atọkwa ụtọ, a ga-eji gịnị mee ka ọ tọọ ụtọ ọzọ?",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.34",
                "verseOrgIds": [
                  "LUK.14.34"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.34",
            "verseOrgIds": [
              "LUK.14.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 14:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ọ bakwaghị uru nye ala maọbụ iji mee nri ala. Kama ọ bụ itufu ya.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.35",
                "verseOrgIds": [
                  "LUK.14.35"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "LUK 14:35"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Onye ọbụla nwere ntị ịnụ ihe, ya nụrụ.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.35",
                "verseOrgIds": [
                  "LUK.14.35"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
