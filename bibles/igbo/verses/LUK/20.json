        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Devid nʼonwe ya kpọrọ ya 'Onyenwe anyị.' Oleekwanụ otu o si bụrụ nwa ya?\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.20.44",
