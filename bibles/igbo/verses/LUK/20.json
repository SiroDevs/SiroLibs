              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ndị mmadụ na-ege ntị, ọ sịrị ndị na-eso ụzọ ya,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.45",
            "verseOrgIds": [
              "LUK.20.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "LUK 20:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kpacharanụ anya nʼebe ndị ozizi iwu nọ. Ndị iyi uwe mwụda na-ejegharị ebe niile na-amasị, ndị hụrụ ekele pụrụ iche bụ nke a na-ekele ha nʼọma ahịa nʼanya. Ndị ọ na-amasịkwa ịnọkwasị nʼoche kachasị elu nʼụlọ ekpere nakwa nʼoche pụrụ iche na mmemme oriri ọbụla.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.20.46",
                "verseOrgIds": [
                  "LUK.20.46"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.46",
            "verseOrgIds": [
              "LUK.20.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "LUK 20:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ha na-eripịa ihe niile dị nʼụlọ ndị inyom ndị di ha nwụrụ anwụ, nʼekpe ogologo ekpere ka a hụta ha. Ndị dị otu a ka a ga-ata ahụhụ dị ukwuu.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.20.47",
                "verseOrgIds": [
                  "LUK.20.47"
                ]
              }
            }
          ]
        }
      ]
