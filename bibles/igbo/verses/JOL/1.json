      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOL 1:11"
      },
      "items": [
        {
          "text": "Tienụ aka nʼobi nʼihi ọka wiiti na ọka balị,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.11",
            "verseOrgIds": [
