      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 1:12"
      },
      "items": [
        {
          "text": "Osisi fiig akpọnwụọla.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.12",
            "verseOrgIds": [
              "JOL.1.12"
            ]
          }
        }
      ]
    },
