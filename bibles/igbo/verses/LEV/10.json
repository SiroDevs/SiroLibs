                  "LEV.10.19"
                ]
              }
            }
          ]
        },
        {
          "text": "ụtọ ma a sị na m riri anụ aja mmehie ndị a nʼụbọchị dị otu a?\"",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.19",
            "verseOrgIds": [
              "LEV.10.19"
            ]
          }
        },
        {
