              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Erọn zara Mosis sị ya, \"Lee, taa ka ha chụrụ aja mmehie na aja nsure ọkụ ha nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.19",
            "verseOrgIds": [
              "LEV.10.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "LEV.10.19",
                "verseOrgIds": [
                  "LEV.10.19"
                ]
              }
            }
          ]
        },
        {
          "text": ". Ma lee ụdị ihe dakwasịrị m. Ọ gaara atọ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.19",
            "verseOrgIds": [
              "LEV.10.19"
            ]
          }
        },
        {
