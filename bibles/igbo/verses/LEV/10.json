          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebe ọ bụ na e webataghị ọbara ya nʼime Ebe Nsọ ahụ, unu gaara anọ nʼakụkụ ebe nsọ ahụ rie anụ ewu ahụ, dịka m nyere unu nʼiwu.\"",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.18",
            "verseOrgIds": [
              "LEV.10.18"
            ]
          }
        }
      ]
    },
