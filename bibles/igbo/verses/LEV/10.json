              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Mosis jụrụ ajụjụ banyere mkpi ahụ e ji chụọ aja mmehie, ọ chọpụtara na a kpọọla ya ọkụ. O wesoro Elieza na Itama ụmụ ndị ikom Erọn iwe sị ha,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.16",
            "verseOrgIds": [
              "LEV.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Gịnị mere unu erighị anụ ahụ e ji chụọ aja mmehie nʼakụkụ ebe nsọ ahụ? Ọ bụ nke dịkarịsịrị nsọ; e nyere unu ya maka iwepụ ọmụma ikpe dịrị ọgbakọ Izrel, na ikpuchi mmehie ha nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.17",
            "verseOrgIds": [
              "LEV.10.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "LEV.10.17",
                "verseOrgIds": [
                  "LEV.10.17"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.17",
            "verseOrgIds": [
              "LEV.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
