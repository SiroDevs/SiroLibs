        "sid": "LEV 6"
      },
      "items": [
        {
          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "LEV.6.1",
                "verseOrgIds": [
                  "LEV.5.20"
                ]
              }
            }
          ]
        },
        {
          "text": "gwara Mosis sị,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.1",
            "verseOrgIds": [
              "LEV.5.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ọ bụrụ na onye ọbụla emehie bụrụ onye na-ekwesighị ntụkwasị obi nye",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.2",
            "verseOrgIds": [
              "LEV.5.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "LEV.6.2",
                "verseOrgIds": [
                  "LEV.5.21"
                ]
              }
            }
          ]
        },
        {
          "text": ", site nʼiduhie onye agbataobi ya banyere ihe e tinyere ya nʼaka idebe, maọbụ izunarị mmadụ ihe, maọbụ iji aghụghọ nara mmadụ ibe ya ihe;",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.2",
            "verseOrgIds": [
              "LEV.5.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "maọbụ site nʼijide ihe furu efu nke ọ chọtara ghaa ụgha banyere ya. Ma ọ bụrụ na ha a ṅụọ iyi na ha ejighị ya, maọbụ gbasara ụdị mmehie mmadụ pụrụ ime.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.3",
            "verseOrgIds": [
              "LEV.5.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ha mehiere nʼụzọ ọbụla nʼime ụzọ ndị a niile, ghọta na ikpe mara ha. Ha aghaghị inyeghachi onye nwe ihe ahụ ha zuru nʼohi, maọbụ ihe ha pụnara nʼike, maọbụ ihe e nyere ya idebe, ma ọ bụkwanụ ihe ahụ furu efu ọ chọtara,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.4",
            "verseOrgIds": [
              "LEV.5.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "maọbụ ihe ọbụla ọ ṅụrụ nʼiyi ụgha. Ọ ga-akwụghachi ihe ndị a niile nʼuju, tụkwasịkwa otu ụzọ nʼime ụzọ ise",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.5",
            "verseOrgIds": [
              "LEV.5.24"
            ]
          }
        },
        {
          "text": "nke ọnụahịa ihe ahụ, nyeghachi ya onye nwe ya, nʼụbọchị ahụ ọ ga-eweta aja ikpe ọmụma ya.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.5",
            "verseOrgIds": [
              "LEV.5.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ ga-ewetara onye nchụaja nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.6",
            "verseOrgIds": [
              "LEV.5.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "LEV.6.6",
                "verseOrgIds": [
                  "LEV.5.25"
                ]
              }
            }
          ]
        },
        {
          "text": ", aja ikpe ọmụma ya nke bụ ebule na-enweghị ntụpọ site nʼigwe anụ, nke ọnụahịa ya ga-abụ ihe ahụ e gbubiri iji ịkwụ ụgwọ mmehie.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.6",
            "verseOrgIds": [
              "LEV.5.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼụzọ dị otu a, onye nchụaja ga-ekpuchikwara ya mmehie ya nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.7",
            "verseOrgIds": [
              "LEV.5.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "LEV.6.7",
                "verseOrgIds": [
                  "LEV.5.26"
                ]
              }
            }
          ]
        },
        {
          "text": ", a ga-agbaghakwara ha nʼihi ihe ọbụla ha mere nke ikpe ji maa ha.\"",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.7",
            "verseOrgIds": [
              "LEV.5.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aja nsure ọkụ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "LEV.6.8",
                "verseOrgIds": [
                  "LEV.6.1"
                ]
              }
            }
          ]
        },
        {
          "text": "gwara Mosis okwu sị ya,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.8",
            "verseOrgIds": [
              "LEV.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nye Erọn na ụmụ ya ndị ikom iwu sị: 'Ndị a bụ usoro iwu metụtara aja nsure ọkụ. Aja nsure ọkụ ga-adịgide nʼekwu ahụ dị nʼebe ịchụ aja site nʼabalị ruo nʼụtụtụ. A ga-akwanyekwa ọkụ na-adị nʼebe ịchụ aja hapụ ya ka o nwuo abalị niile.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.9",
            "verseOrgIds": [
              "LEV.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe chi bọrọ, onye nchụaja ga-eyiri uwe ime ahụ ya nke akwa ọcha, nakwa uwe elu ahụ ya, gaa kpopu ntụ dị nʼekwu nke ebe ịchụ aja nsure ọkụ ahụ, wụsa ha nʼakụkụ ebe ịchụ aja ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.10",
            "verseOrgIds": [
              "LEV.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe o mesịrị nke a, ọ ga-agbanwe uwe ya, kporo ntụ ahụ, buru ya pụọ nʼazụ ogige ahụ gaa wufuo ya nʼebe ahụ e mere ka ọ dị ọcha.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.11",
            "verseOrgIds": [
              "LEV.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọkụ dị nʼebe ịchụ aja ga na-enwu mgbe niile, a gaghị ekwe ka ọ nyụọ. Nʼụtụtụ niile onye nchụaja ga-akwanye ya nkụ ọhụrụ, tụkwasịkwa aja nsure ọkụ nʼelu ya surekwaa abụba aja udo nʼelu ya.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.12",
            "verseOrgIds": [
              "LEV.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọkụ ga-enwugide nʼebe ịchụ aja mgbe niile. A gaghị ekwe ka ọ nyụọ mgbe ọbụla.'",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.13",
            "verseOrgIds": [
              "LEV.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aja mkpụrụ ọka",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ndị a bụ usoro iwu gbasara onyinye mkpụrụ ọka. Ụmụ Erọn ndị ikom ga-eguzo nʼihu ebe ịchụ aja iche ya nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.14",
            "verseOrgIds": [
              "LEV.6.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "LEV.6.14",
                "verseOrgIds": [
                  "LEV.6.7"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.14",
            "verseOrgIds": [
              "LEV.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, onye nchụaja ga-ekpoju ọka ahụ a kwọrọ nke ọma, na ụfọdụ mmanụ oliv, tinyere ụda na-esi isi ụtọ nʼaka ya dịka oke ncheta. Kpọọ ya ọkụ nʼelu ebe ịchụ aja ka ọ nọchie anya onyinye ahụ niile, nke isisi ya dị",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.15",
            "verseOrgIds": [
              "LEV.6.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "LEV.6.15",
                "verseOrgIds": [
                  "LEV.6.8"
                ]
              }
            }
          ]
        },
        {
          "text": "ezi mma.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.15",
            "verseOrgIds": [
              "LEV.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erọn na ụmụ ya ndị ikom ga-eri nke fọdụrụnụ. Ma a ga-eri ya na-ejighị ihe na-eko achịcha, nʼime ebe nsọ, nʼogige ụlọ nzute ka a ga-anọ eri ya.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.16",
            "verseOrgIds": [
              "LEV.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agaghị etinye ya ihe na-eko achịcha ma a na-eghe ya. Enyela ya ka ọ bụrụ oke ruuru ha site nʼonyinye nsure ọkụ e chere nʼihu m. Ha bụkwa ihe dịkarịsịrị nsọ, dịka aja ikpe ọmụma na aja mmehie.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.17",
            "verseOrgIds": [
              "LEV.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwoke ọbụla sitere nʼagbụrụ Erọn, onye nchụaja, nwere ike iri ya. Ọ bụ oke ọ ga na-eketa site nʼonyinye nsure ọkụ niile echere nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.18",
            "verseOrgIds": [
              "LEV.6.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "LEV.6.18",
                "verseOrgIds": [
                  "LEV.6.11"
                ]
              }
            }
          ]
        },
        {
          "text": "ruo nʼọgbọ niile na-abịa. Ihe ọbụla metụrụ ha ahụ ga-aghọ ihe dị nsọ.' \"",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.18",
            "verseOrgIds": [
              "LEV.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "LEV.6.19",
                "verseOrgIds": [
                  "LEV.6.12"
                ]
              }
            }
          ]
        },
        {
          "text": "gwakwara Mosis sị,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.19",
            "verseOrgIds": [
              "LEV.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nke a bụ aja Erọn na ụmụ ya ndị ikom ga-achụrụ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.20",
            "verseOrgIds": [
              "LEV.6.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "LEV.6.20",
                "verseOrgIds": [
                  "LEV.6.13"
                ]
              }
            }
          ]
        },
        {
          "text": "nʼụbọchị a ga-ete ya mmanụ. Ọ ga-abụ ọtụtụ ruru lita abụọ nke ọka dị ezi mma dịka aja onyinye a na-achụ mgbe niile. Ha ga-enye otu ọkara ya nʼụtụtụ, nye nke ọzọ nʼuhuruchi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.20",
            "verseOrgIds": [
              "LEV.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha ga-etinye ya mmanụ, ghee ya nʼite. Ị ga-ebubata ya mgbe a gwọkọrọ ya nke ọma, chee ya dịka aja ọka a nyawasịrị anyawasị nke isisi ya dị",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.21",
            "verseOrgIds": [
              "LEV.6.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "LEV.6.21",
                "verseOrgIds": [
                  "LEV.6.14"
                ]
              }
            }
          ]
        },
        {
          "text": "ezi mma.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.21",
            "verseOrgIds": [
              "LEV.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwa nwoke ahụ nke ga-anọchi ya dịka onye nchụaja e tere mmanụ bụ onye ga-akwado ya. Ọ bụ oke ruuru",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.22",
            "verseOrgIds": [
              "LEV.6.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "LEV.6.22",
                "verseOrgIds": [
                  "LEV.6.15"
                ]
              }
            }
          ]
        },
        {
          "text": "ebighị ebi, bụrụkwa nke a ga-esure ọkụ kpamkpam.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.22",
            "verseOrgIds": [
              "LEV.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onyinye mkpụrụ ọka ọbụla nke onye nchụaja nyere ka a ga-akpọ ọkụ kpamkpam. A gaghị eri ya eri.\"",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.23",
            "verseOrgIds": [
              "LEV.6.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aja mmehie",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 6:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "LEV.6.24",
                "verseOrgIds": [
                  "LEV.6.17"
                ]
              }
            }
          ]
        },
        {
          "text": "sịrị Mosis,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.24",
            "verseOrgIds": [
              "LEV.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 6:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Gwa Erọn na ụmụ ya ndị ikom, sị, 'Ndị a bụ usoro iwu unu ga-edebe banyere aja mmehie. A ga-egbu anụ aja mmehie nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.25",
            "verseOrgIds": [
              "LEV.6.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "LEV.6.25",
                "verseOrgIds": [
                  "LEV.6.18"
                ]
              }
            }
          ]
        },
        {
          "text": ", nʼebe ahụ a na-egbu anụ aja nsure ọkụ. Ọ bụ ihe dịkarịsịrị nsọ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.25",
            "verseOrgIds": [
              "LEV.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 6:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye nchụaja chụrụ ya ga-eri anụ ya, ọ bụ nʼakụkụ ebe nsọ ahụ, ya bụ nʼogige ụlọ nzute ahụ ka a ga-anọ rie ya.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.26",
            "verseOrgIds": [
              "LEV.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 6:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihe ọbụla metụrụ anụ nke ọbụla aka, ga-aghọ ihe dị nsọ. Ọ bụrụkwa na ọbara ya efesa nʼuwe ọbụla, ị ga-asụ uwe ahụ nʼakụkụ ebe nsọ ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.27",
            "verseOrgIds": [
              "LEV.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 6:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "A ghaghị itiwa ite aja e ji sie anụ ahụ. Ọ bụrụkwanụ nʼite bronz ka e siri ya, a ga-asa ite ahụ mmiri nke ọma, saa ya ka ọ dị ezi ọcha.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.28",
            "verseOrgIds": [
              "LEV.6.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 6:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwoke ọbụla a mụrụ nʼezinaụlọ ndị nchụaja nwere ike iri anụ ahụ, ọ bụ ihe dịkarịsịrị nsọ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.29",
            "verseOrgIds": [
              "LEV.6.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 6:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma a gaghị eri anụ aja mmehie ọbụla, bụ nke e webatara ọbara ya nʼime ụlọ nzute maka ikpuchi mmehie nʼEbe nsọ ahụ. Aghaghị ịkpọ ya ọkụ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.30",
            "verseOrgIds": [
              "LEV.6.23"
            ]
          }
        }
      ]
    }
  ],
