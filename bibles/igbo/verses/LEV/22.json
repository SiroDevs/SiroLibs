            "sid": "LEV 22:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Riekwanụ anụ aja ahụ nʼotu ụbọchị ahụ, ka ọ hapụ ịfọdụ ruo echi ya. Abụ m",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.30",
            "verseOrgIds": [
              "LEV.22.30"
            ]
          }
        },
        {
