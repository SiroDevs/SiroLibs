                ]
              }
            }
          ]
        },
        {
          "text": "aja ekele, chụọnụ ya nʼụzọ ahụ a ga-anabata ya.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.29",
            "verseOrgIds": [
              "LEV.22.29"
            ]
          }
        },
        {
          "name": "verse",
