          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unu emekwala ka aha m ghara ịdị nsọ. A ga-edo aha m nsọ nʼetiti ụmụ Izrel, nʼihi na abụ m",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.32",
            "verseOrgIds": [
              "LEV.22.32"
            ]
          }
        },
