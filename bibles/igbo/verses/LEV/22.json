            "number": "27",
            "style": "v",
            "sid": "LEV 22:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mgbe a mụrụ nwa ehi, maọbụ nwa atụrụ, maọbụ ewu ọhụrụ, a ga-ahapụ ya na nne ya ụbọchị asaa. Site nʼụbọchị nke asatọ gaa nʼihu a ga-anabata ya dịka onyinye ihe oriri i ji chụọ aja nsure ọkụ nye",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.27",
            "verseOrgIds": [
              "LEV.22.27"
            ]
          }
        },
        {
          "name": "char",
