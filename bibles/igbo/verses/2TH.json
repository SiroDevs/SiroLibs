  "2TH.3": {
    "id": "2TH.3",
    "number": "3",
    "bookId": "2TH",
    "reference": "2 Ndị Tesalonaịka 3",
    "copyright": "Biblica® Open Igbo Contemporary Bible™ Copyright © 1980, 1988, 2019, 2020 by Biblica, Inc. Used with permission. All rights reserved worldwide.",
    "verseCount": 18,
    "content": [
      {
        "name": "chapter",
        "type": "tag",
        "attrs": {
          "number": "3",
          "style": "c",
          "sid": "2TH 3"
        },
        "items": [
          {
            "text": "3",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "s1"
        },
        "items": [
          {
            "text": "Arịrịọ ekpere",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "1",
              "style": "v",
              "sid": "2TH 3:1"
            },
            "items": [
              {
                "text": "1",
                "type": "text"
              }
            ]
          },
          {
            "text": "Nʼikpeazụ, ụmụnna, na-ekperenụ anyị ekpere ka ozi Onyenwe anyị gaa nʼihu na-agbasa ruo ebe niile ma bụrụ ihe a na-asọpụrụ, dị ka ọ gbasara nʼetiti unu.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.3.1",
              "verseOrgIds": [
                "2TH.3.1"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "2",
              "style": "v",
              "sid": "2TH 3:2"
            },
            "items": [
              {
                "text": "2",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ka e nwee ike napụta anyị nʼaka ndị ajọ mmadụ, nʼihi na ọ bụghị mmadụ niile nwere okwukwe.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.3.2",
              "verseOrgIds": [
                "2TH.3.2"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "3",
              "style": "v",
              "sid": "2TH 3:3"
            },
            "items": [
              {
                "text": "3",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ma Onyenwe anyị kwesiri ntụkwasị obi, ọ ga-echebe unu ma gbaakwa unu ume ka unu hapụ ịdaba nʼaka ajọ onye ahụ.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.3.3",
              "verseOrgIds": [
                "2TH.3.3"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "4",
              "style": "v",
              "sid": "2TH 3:4"
            },
            "items": [
              {
                "text": "4",
                "type": "text"
              }
            ]
          },
          {
            "text": "Anyị nwere nchekwube nʼime Onyenwe anyị na unu na-eme ma ga-anọgidekwa na-eme ihe niile anyị nyere unu nʼiwu.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.3.4",
              "verseOrgIds": [
                "2TH.3.4"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "5",
              "style": "v",
              "sid": "2TH 3:5"
            },
            "items": [
              {
                "text": "5",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ka Onyenwe anyị duzie obi unu ịghọta ịhụnanya Chineke ya na ụdị ntachiobi Kraịst nwere.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.3.5",
              "verseOrgIds": [
                "2TH.3.5"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "s1"
        },
        "items": [
          {
            "text": "Ịdọ aka na ntị banyere ịnọ nkịtị",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "6",
              "style": "v",
              "sid": "2TH 3:6"
            },
            "items": [
              {
                "text": "6",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ụmụnna, nke a bụ iwu anyị na-enye unu site nʼaha Onyenwe anyị Jisọs Kraịst. Ka unu zere onye ọbụla kpọrọ onwe ya onye kwere ekwe nʼime unu na-ebi ndụ umengwụ na onye na-adịghị eso ozizi nke unu natara nʼaka anyị.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.3.6",
              "verseOrgIds": [
                "2TH.3.6"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "7",
              "style": "v",
              "sid": "2TH 3:7"
            },
            "items": [
              {
                "text": "7",
                "type": "text"
              }
            ]
          },
          {
            "text": "Nʼihi na unu maara nke ọma nʼime onwe unu na unu kwesiri ịgbaso omume anyị. O nweghị mgbe ọbụla unu hụrụ anyị ka anyị na-agagharị hapụ ọrụ anyị kwesiri ịrụ.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.3.7",
              "verseOrgIds": [
                "2TH.3.7"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "8",
              "style": "v",
              "sid": "2TH 3:8"
            },
            "items": [
              {
                "text": "8",
                "type": "text"
              }
            ]
          },
          {
            "text": "O nweghị onye ọbụla anyị riri nri ya nke anyị na-ebughị ụzọ kwụọ ya ụgwọ. Kama anyị rụsịrị ọrụ ike, dọgbukwaa onwe anyị nʼọrụ ehihie na abalị, ka anyị ghara ịbụ ibu arọ nye onye ọbụla.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.3.8",
              "verseOrgIds": [
                "2TH.3.8"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "9",
              "style": "v",
              "sid": "2TH 3:9"
            },
            "items": [
              {
                "text": "9",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ọ bụghị na anyị enweghị ikike ịnara unu ihe oriri, kama ọ bụ ka anyị kuziere unu site nʼomume anyị ihe unu ga na-eṅomi.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.3.9",
              "verseOrgIds": [
                "2TH.3.9"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "10",
              "style": "v",
              "sid": "2TH 3:10"
            },
            "items": [
              {
                "text": "10",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ọ bụladị mgbe anyị na unu nọ, anyị nyere unu iwu a sị, \"Onye ọbụla na-agaghị ọrụ ya erila nri.\"",
            "type": "text",
            "attrs": {
              "verseId": "2TH.3.10",
              "verseOrgIds": [
                "2TH.3.10"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "11",
              "style": "v",
              "sid": "2TH 3:11"
            },
            "items": [
              {
                "text": "11",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ma anyị anụla na ụfọdụ nʼetiti unu na-anọ nkịtị na-arụghị ọrụ ọbụla, kama ndị dị otu a na-agagharị, na-etinye anya nʼihe na-agbasaghị ha. Ha anaghị arụ ọrụ ọbụla.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.3.11",
              "verseOrgIds": [
                "2TH.3.11"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "12",
              "style": "v",
              "sid": "2TH 3:12"
            },
            "items": [
              {
                "text": "12",
                "type": "text"
              }
            ]
          },
          {
            "text": "Anyị na-enye ndị a iwu, na-adụsịkwa ha ọdụ ike site nʼaha Onyenwe anyị Jisọs Kraịst, si ha wetuo obi ha ala rụsie ọrụ ha ike. Ka ha riekwa nri ha ji aka ha rụpụta.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.3.12",
              "verseOrgIds": [
                "2TH.3.12"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "13",
              "style": "v",
              "sid": "2TH 3:13"
            },
            "items": [
              {
                "text": "13",
                "type": "text"
              }
            ]
          },
          {
            "text": "Otu ọ dị ụmụnna, unu ekwela ka ike ịrụ ọrụ ọma gwụ unu.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.3.13",
              "verseOrgIds": [
                "2TH.3.13"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "14",
              "style": "v",
              "sid": "2TH 3:14"
            },
            "items": [
              {
                "text": "14",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ma ọ bụrụ na ndị ọbụla adịghị erube isi nye ihe anyị kwuru nʼime akwụkwọ ozi a, hụbanụ ndị dị otu a ama ma kwụsịkwa iso ha nwekọ ihe ọbụla, ka ihere mekwa ha.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.3.14",
              "verseOrgIds": [
                "2TH.3.14"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "15",
              "style": "v",
              "sid": "2TH 3:15"
            },
            "items": [
              {
                "text": "15",
                "type": "text"
              }
            ]
          },
          {
            "text": "Nʼagbanyeghị nke a, unu agụkwala ha dị ka ndị iro unu, kama nyenụ ha ndụmọdụ dị ka ụmụnna.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.3.15",
              "verseOrgIds": [
                "2TH.3.15"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "b"
        },
        "items": []
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "s1"
        },
        "items": [
          {
            "text": "Ekele ikpeazụ",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "16",
              "style": "v",
              "sid": "2TH 3:16"
            },
            "items": [
              {
                "text": "16",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ugbu a, ka Onyenwe anyị, onye udo na-esi nʼaka ya abịa tụkwasịrị unu udo ya mgbe niile, nʼime ọnọdụ ọbụla unu nọ nʼime ya. Onyenwe anyị nọnyekwara unu.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.3.16",
              "verseOrgIds": [
                "2TH.3.16"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "b"
        },
        "items": []
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "17",
              "style": "v",
              "sid": "2TH 3:17"
            },
            "items": [
              {
                "text": "17",
                "type": "text"
              }
            ]
          },
          {
            "text": "Mụ onwe m bụ Pọl ji aka m depụta ekele a, nke m na-ekele unu niile. Nke a bụ ihe e ji arịba akwụkwọ niile m dere ama. Otu a ka m si ede ihe.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.3.17",
              "verseOrgIds": [
                "2TH.3.17"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "b"
        },
        "items": []
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "18",
              "style": "v",
              "sid": "2TH 3:18"
            },
            "items": [
              {
                "text": "18",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ka amara Onyenwe anyị Jisọs Kraịst dịnyere unu niile.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.3.18",
              "verseOrgIds": [
                "2TH.3.18"
              ]
            }
          }
        ]
      }
    ],
