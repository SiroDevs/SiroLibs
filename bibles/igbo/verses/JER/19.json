  "verseCount": 15,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "19",
        "style": "c",
        "sid": "JER 19"
      },
      "items": [
        {
          "text": "19",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 19:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihe ndị a ka",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.1",
            "verseOrgIds": [
              "JER.19.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.19.1",
                "verseOrgIds": [
                  "JER.19.1"
                ]
              }
            }
          ]
        },
        {
          "text": "kwuru, \"Jee, zụta otu ite aja site nʼaka ọkpụ ite. Duru ụfọdụ nʼime ndị okenye na ndị nchụaja,",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.1",
            "verseOrgIds": [
              "JER.19.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "jee na Ndagwurugwu nke Ben Hinom, nke dị nso nʼọnụ ụzọ ama Ejuju dị nʼọwụwa anyanwụ. Nọdụ nʼebe ahụ kwupụtara ha okwu ndị m gwara gị.",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.2",
            "verseOrgIds": [
              "JER.19.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sị ha, 'Nụrụnụ okwu",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.3",
            "verseOrgIds": [
              "JER.19.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.19.3",
                "verseOrgIds": [
                  "JER.19.3"
                ]
              }
            }
          ]
        },
        {
          "text": ", unu ndị eze Juda, na ndị Jerusalem. Ihe ndị a ka",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.3",
            "verseOrgIds": [
              "JER.19.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.19.3",
                "verseOrgIds": [
                  "JER.19.3"
                ]
              }
            }
          ]
        },
        {
          "text": ", Onye pụrụ ime ihe niile, onye bụ Chineke Izrel kwuru. Geenụ ntị! Aga m eme ka ihe ọjọọ bịakwasị ala a, ụdị ihe ọjọọ ga-eme ka ntị ọbụla nụrụ ya zụọ wuruwuru.",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.3",
            "verseOrgIds": [
              "JER.19.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na ha ahapụla m, mee ka ebe a ghọọ nke chi ndị mba ọzọ. Ha achụọla aja nsure ọkụ nʼime ya nye chi ndị ahụ ha na nna nna ha, maọbụ ndị eze Juda, na-amaghị. Ha ejirila ọbara ndị aka ha dị ọcha mejupụta ebe a.",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.4",
            "verseOrgIds": [
              "JER.19.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha ewuola ebe ịchụ aja dị elu nye chi Baal. Nʼelu ya kwa ka ha na-esure ụmụ ha dịka aja nye Baal, bụ nke m na-enyeghị nʼiwu, ekwughịkwa m ya, o nwekwaghị mgbe o ji bata m nʼobi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.5",
            "verseOrgIds": [
              "JER.19.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, kpacharanụ anya, nʼihi na ụbọchị ahụ na-abịa, ka",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.6",
            "verseOrgIds": [
              "JER.19.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.19.6",
                "verseOrgIds": [
                  "JER.19.6"
                ]
              }
            }
          ]
        },
        {
          "text": "kwubiri, mgbe ndị mmadụ agaghị akpọkwa ebe a Tofet ma ọ bụkwanụ Ndagwurugwu nke Ben Hinom, kama a ga-akpọ ya Ndagwurugwu Ogbugbu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.6",
            "verseOrgIds": [
              "JER.19.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Nʼebe a ka m ga-anọ laa nzube niile nke Juda na Jerusalem nʼiyi. Aga m eme ka ha daa site na mma agha nʼihu ndị iro ha, nʼaka ndị ahụ na-achọsi ndụ ha ike. Aga m enye ụmụ anụ ufe na anụ ọhịa ozu ha dịka nri.",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.7",
            "verseOrgIds": [
              "JER.19.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aga m ebibi obodo a mee ka ọ ghọọ ihe iju anya na ihe ịma ọsụ. Ndị niile na-esi nʼakụkụ ya agafe ga-anọ nʼọnọdụ iju anya, ha ga-eledakwa ya anya nʼihi ọnya ya niile.",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.8",
            "verseOrgIds": [
              "JER.19.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aga m emekwa ka ha rie anụ ahụ nke ụmụ ha ndị ikom na ndị inyom. Ha ga-erikwa anụ ahụ ibe ha, nʼihi na ndị iro ha ga-agba ha gburugburu nọchibido ha nʼime oke mkpagbu",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.9",
            "verseOrgIds": [
              "JER.19.9"
            ]
          }
        },
        {
          "text": "ka ha bibie ndụ ha.'",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.9",
            "verseOrgIds": [
              "JER.19.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kụwaa ite ahụ mgbe ndị gị na ha so nọ na-ele gị anya.",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.10",
            "verseOrgIds": [
              "JER.19.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gwa ha sị, 'Otu a ka",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.11",
            "verseOrgIds": [
              "JER.19.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.19.11",
                "verseOrgIds": [
                  "JER.19.11"
                ]
              }
            }
          ]
        },
        {
          "text": ", Onye pụrụ ime ihe niile sịrị: Aga m etipịa mba a na obodo a, dịka ite aja nke ọkpụ ite a si daa tipịasịa nʼụzọ a na-apụghị imezikwa ya ọzọ. Ha ga-eli ndị nwụrụ anwụ na Tofet tutu ruo mgbe ohere na-agaghị adịkwa ili ozu ọzọ.",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.11",
            "verseOrgIds": [
              "JER.19.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihe dị otu a ka m ga-eme nʼebe a, meekwa ndị bi na ya. Otu a ka",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.12",
            "verseOrgIds": [
              "JER.19.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.19.12",
                "verseOrgIds": [
                  "JER.19.12"
                ]
              }
            }
          ]
        },
        {
          "text": "kwubiri. Aga m eme obodo a ka ọ dịrị ka Tofet.",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.12",
            "verseOrgIds": [
              "JER.19.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụlọ niile dị na Jerusalem na ụlọ niile nke ndị eze Juda ka a ga-emerụ dịka ebe a, bụ Tofet, otu a ka a ga-esi merụọkwa ụlọ niile a suree ihe nsure ọkụ na-esi isi ụtọ nʼelu ha nye usuu niile nke eluigwe, wụsakwara chi ndị ọzọ ihe ọṅụṅụ dịka onyinye.' \"",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.13",
            "verseOrgIds": [
              "JER.19.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Jeremaya si na Tofet, ebe ahụ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.14",
            "verseOrgIds": [
              "JER.19.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.19.14",
                "verseOrgIds": [
                  "JER.19.14"
                ]
              }
            }
          ]
        },
        {
          "text": "zigara ya ibu amụma lọta, o guzoro nʼogige ụlọnsọ ukwu Chineke ahụ, gwa ndị mmadụ niile okwu sị ha,",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.14",
            "verseOrgIds": [
              "JER.19.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Otu a ka",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.15",
            "verseOrgIds": [
              "JER.19.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.19.15",
                "verseOrgIds": [
                  "JER.19.15"
                ]
              }
            }
          ]
        },
        {
          "text": ", Onye pụrụ ime ihe niile, onye bụ Chineke nke Izrel sịrị, 'Geenụ ntị! Ana m aga ime ka ihe ọjọọ ahụ m kwuru okwu ya bịakwasị obodo a, na obodo nta niile gbara ya gburugburu, nʼihi na ha bụ ndị isiike, ndị jụrụ ige ntị nʼokwu m.' \"",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.15",
            "verseOrgIds": [
              "JER.19.15"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "JER.20",
    "number": "20",
