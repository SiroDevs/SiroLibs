              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Unu bụ ndị fọdụrụ na Juda, lee na",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.19",
            "verseOrgIds": [
              "JER.42.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
