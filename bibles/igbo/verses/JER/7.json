  "verseCount": 34,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "7",
        "style": "c",
        "sid": "JER 7"
      },
      "items": [
        {
          "text": "7",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Enweghị isi nke okpukpe aghụghọ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị a bụ okwu nke sị nʼebe",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.1",
            "verseOrgIds": [
              "JER.7.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.7.1",
                "verseOrgIds": [
                  "JER.7.1"
                ]
              }
            }
          ]
        },
        {
          "text": "nọ bịakwute Jeremaya.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.1",
            "verseOrgIds": [
              "JER.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Guzo nʼọnụ ụzọ ama nke ụlọ",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.2",
            "verseOrgIds": [
              "JER.7.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.7.2",
                "verseOrgIds": [
                  "JER.7.2"
                ]
              }
            }
          ]
        },
        {
          "text": "kwusaa ozi a nʼebe ahụ,",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.2",
            "verseOrgIds": [
              "JER.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JER 7:2"
      },
      "items": [
        {
          "text": "\" 'Nụrụnụ okwu",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.2",
            "verseOrgIds": [
              "JER.7.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.7.2",
                "verseOrgIds": [
                  "JER.7.2"
                ]
              }
            }
          ]
        },
        {
          "text": ", unu ndị Juda niile, ndị na-esi nʼọnụ ụzọ a niile na-abata ife",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.2",
            "verseOrgIds": [
              "JER.7.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.7.2",
                "verseOrgIds": [
                  "JER.7.2"
                ]
              }
            }
          ]
        },
        {
          "text": "ofufe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.2",
            "verseOrgIds": [
              "JER.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihe ndị a bụ ihe",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.3",
            "verseOrgIds": [
              "JER.7.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.7.3",
                "verseOrgIds": [
                  "JER.7.3"
                ]
              }
            }
          ]
        },
        {
          "text": ", Onye pụrụ ime ihe niile, bụ Chineke Izrel na-ekwu. Mezienụ ụzọ unu na omume unu niile, m ga-ekwe ka unu biri nʼebe a.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.3",
            "verseOrgIds": [
              "JER.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unu atụkwasịla uche unu nʼokwu aghụghọ niile a na-agwa unu na-asị, \"Nke a bụ ụlọnsọ ukwu",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.4",
            "verseOrgIds": [
              "JER.7.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.7.4",
                "verseOrgIds": [
                  "JER.7.4"
                ]
              }
            }
          ]
        },
        {
          "text": ", ụlọnsọ ukwu",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.4",
            "verseOrgIds": [
              "JER.7.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.7.4",
                "verseOrgIds": [
                  "JER.7.4"
                ]
              }
            }
          ]
        },
        {
          "text": ", ụlọnsọ ukwu",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.4",
            "verseOrgIds": [
              "JER.7.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.7.4",
                "verseOrgIds": [
                  "JER.7.4"
                ]
              }
            }
          ]
        },
        {
          "text": "!\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.4",
            "verseOrgIds": [
              "JER.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ na unu emee ka ụzọ unu na omume unu guzozie, ọ bụrụ na unu emesoo ibe unu mmeso nʼụzọ ikpe ziri ezi,",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.5",
            "verseOrgIds": [
              "JER.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "ọ bụrụ na unu ahapụ imegbu ndị ọbịa, na ndị na-enweghị nna, maọbụ nwanyị di ya nwụrụ; ọ bụrụ na unu ajụ iwufu ọbara onye aka ya dị ọcha nʼebe a, ọ bụrụkwa na unu ajụ ịgbaso chi ndị ọzọ nke na-ewetara unu nsogbu,",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.6",
            "verseOrgIds": [
              "JER.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "mgbe ahụ, aga m ekwere ka unu biri nʼebe a, nʼala a m nyere nna nna unu ha, ruo mgbe ebighị ebi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.7",
            "verseOrgIds": [
              "JER.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma lee, ihe unu na-eme ugbu a bụ ịtụkwasị uche unu nʼokwu aghụghọ nke na-enweghị isi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.8",
            "verseOrgIds": [
              "JER.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Unu ga-aga nʼihu na-ezu ohi, na-egbu mmadụ ibe unu, na-akwa iko, ma na-eji chi ndị ọzọ na-aṅụ iyi? Unu ga-anọgide na-achụ aja ihe nsure ọkụ na-esi isi ụtọ nye Baal, ma na-agbaso chi ndị ọzọ unu na-amaghị?",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.9",
            "verseOrgIds": [
              "JER.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unu ga-emecha bịa guzo nʼihu m nʼụlọnsọ a, nke a kpọkwasịrị aha m, na-asị, \"Anyị nọ na nchekwa,\" ọ bụ ịnọ na nchekwa maka ime ihe arụ niile ndị a?",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.10",
            "verseOrgIds": [
              "JER.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ pụtara na ụlọ a, nke a kpọkwasịrị aha m aghọọla ogige nye ndị ohi? Ma anọkwa m ya na-ele unu anya, ka",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.11",
            "verseOrgIds": [
              "JER.7.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.7.11",
                "verseOrgIds": [
                  "JER.7.11"
                ]
              }
            }
          ]
        },
        {
          "text": "kwupụtara.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.11",
            "verseOrgIds": [
              "JER.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Otu ọ dị, biko, Jeruonụ ebe ahụ dị na Shaịlo, ebe ahụ m buru ụzọ mee ka ọ bụrụ ebe a kpọkwasịrị aha m, ka unu chọpụta ihe m mere ya nʼihi ajọ omume ndị m, ụmụ Izrel.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.12",
            "verseOrgIds": [
              "JER.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe unu nọ na-eme ihe ndị a niile, ka",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.13",
            "verseOrgIds": [
              "JER.7.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.7.13",
                "verseOrgIds": [
                  "JER.7.13"
                ]
              }
            }
          ]
        },
        {
          "text": "kwupụtara, agwara m unu okwu mgbe mgbe, ma unu jụrụ ige ntị. Akpọrọ m unu oku, ma unu jụrụ ịza.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.13",
            "verseOrgIds": [
              "JER.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi ya, ihe ahụ m mere na Shaịlo ka m ga-emekwa ọzọ megide ụlọ ahụ a kpọkwasịrị aha m. E, aga m eme ya megide ụlọnsọ ukwu ahụ unu na-atụkwasị obi unu nʼime ya, ụlọnsọ ukwu ahụ m nyere unu na nna nna unu ha.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.14",
            "verseOrgIds": [
              "JER.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "A ga-esite nʼihu m wezuga unu, tufuo unu, dịka m wezugara ma tufukwaa ụmụnna unu, bụ ndị Ifrem.'",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.15",
            "verseOrgIds": [
              "JER.7.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ya mere, unu ekperela m ekpere nʼihi ndị a; unu atụfula oge unu ịrịọ m arịrịọ nʼihi ha. Agaghị m ege ntị nʼekpere na arịrịọ unu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.16",
            "verseOrgIds": [
              "JER.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ na unu adịghị ahụ ihe na-eme nʼobodo niile nke Juda, na ihe ha na-eme nʼokporoụzọ niile nke Jerusalem?",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.17",
            "verseOrgIds": [
              "JER.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụmụ na-achịkọta nkụ nke nna ha ji emenye ọkụ, ebe nne ha na-eghe achịcha ha na-eche nʼihu Eze nwanyị mbara Eluigwe. Ha na-awụpụrụ chi ndị ọzọ mmanya nʼihi ịkpasu m iwe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.18",
            "verseOrgIds": [
              "JER.7.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ m ka ha na-akpasu iwe? Otu a ka",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.19",
            "verseOrgIds": [
              "JER.7.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.7.19",
                "verseOrgIds": [
                  "JER.7.19"
                ]
              }
            }
          ]
        },
        {
          "text": "kwupụtara. Ọ bụghị onwe ha ka ha na-emesi ike, ka ihe ihere mee ha?",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.19",
            "verseOrgIds": [
              "JER.7.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ya mere, otu a ka Onye kachasị ihe niile elu, bụ",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.20",
            "verseOrgIds": [
              "JER.7.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.7.20",
                "verseOrgIds": [
                  "JER.7.20"
                ]
              }
            }
          ]
        },
        {
          "text": "sịrị: Iwe m na ọnụma m ka a ga-awụkwasị nʼebe a, nʼelu ndị mmadụ, na anụmanụ, na osisi dị nʼọhịa, na mkpụrụ nke ala ubi. Ọ ga-ere ọkụ ma agaghị emenyụ ya.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.20",
            "verseOrgIds": [
              "JER.7.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ihe ndị a ka",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.21",
            "verseOrgIds": [
              "JER.7.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.7.21",
                "verseOrgIds": [
                  "JER.7.21"
                ]
              }
            }
          ]
        },
        {
          "text": ", Onye pụrụ ime ihe niile, bụ Chineke Izrel kwuru, Gaanụ nʼihu, tụkwasịnụ aja nsure ọkụ unu nʼelu aja unu ndị ọzọ niile. Riekwanụ anụ ndị a nʼonwe unu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.21",
            "verseOrgIds": [
              "JER.7.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na mgbe m si nʼala Ijipt kpọpụta nna nna unu ha, gwa ha okwu, e nyeghị ha naanị iwu maọbụ gwa ha okwu banyere ịchụ aja nsure ọkụ na aja ndị ọzọ.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.22",
            "verseOrgIds": [
              "JER.7.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma iwu m nyere ha bụ nke a, ruberenụ m isi, aga m abụ Chineke unu, unu ga-abụkwa ndị nke m. Bienụ ndụ nʼiwu niile m nyere unu, ka ihe gaara unu nke ọma.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.23",
            "verseOrgIds": [
              "JER.7.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ha jụrụ ige ntị, jụkwa ilezi anya ime ihe ndị ahụ m nyere nʼiwu. Kama ha gbasoro ọchịchọ ọjọọ nke obi rụrụ arụ ha. Kama ịga nʼihu, ha daghachiri azụ.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.24",
            "verseOrgIds": [
              "JER.7.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 7:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Site na mgbe nna nna unu ha hapụrụ ala Ijipt, esepụbeghị m aka izitere unu ndị amụma bụ ndị ohu m.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.25",
            "verseOrgIds": [
              "JER.7.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 7:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ha jụrụ ige ntị, jụkwa ilezi anya ime ihe m nyere nʼiwu. Ha bụ ndị ntị ike, ndị nọgidere na-eme ihe ọjọọ karịrị nke nna nna ha mere.'",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.26",
            "verseOrgIds": [
              "JER.7.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 7:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mgbe ị gwara ha ihe ndị a niile, ha agaghị ege ntị. Ọ bụrụkwa na ị kpọọ ha oku ha agaghị aza.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.27",
            "verseOrgIds": [
              "JER.7.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JER 7:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, ihe ndị a ka ị ga-agwa ha, 'Nke a bụ mba na-enwebeghị oge ha ji rubere",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.28",
            "verseOrgIds": [
              "JER.7.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.7.28",
                "verseOrgIds": [
                  "JER.7.28"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke ha isi. O nwebekwaghị oge ọbụla ha ji nabata ịdọ aka na ntị ya. Eziokwu ọbụla adịghịkwa; okwu ọnụ ha bụ naanị ụgha ụgha.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.28",
            "verseOrgIds": [
              "JER.7.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JER 7:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Kpụchaanụ agịrị isi unu, tufuo ya, nọọnụ nʼebe dị elu nke tọgbọrọ nʼefu bulie abụ akwa, nʼihi na",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.29",
            "verseOrgIds": [
              "JER.7.29"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.7.29",
                "verseOrgIds": [
                  "JER.7.29"
                ]
              }
            }
          ]
        },
        {
          "text": "esitela nʼoke ọnụma ya jụ ọgbọ a. Ọ gbakụtala ha azụ bụ ọgbọ nke a iwe ya na-adakwasị.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.29",
            "verseOrgIds": [
              "JER.7.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ndagwurugwu ogbugbu mmadụ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JER 7:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" '",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.30",
            "verseOrgIds": [
              "JER.7.30"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.7.30",
                "verseOrgIds": [
                  "JER.7.30"
                ]
              }
            }
          ]
        },
        {
          "text": "kwupụtara sị, ndị Juda emeela ihe ọjọọ dị iche iche nʼihu m. Ha akpụọla arụsị rụrụ arụ nke ha tinyere nʼime ụlọnsọ ukwu ahụ a kpọkwasịrị aha m. Ha emerụọla ya.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.30",
            "verseOrgIds": [
              "JER.7.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JER 7:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha ewuolara onwe ha ebe ịchụ aja dị elu na Tofet, nke dị na Ndagwurugwu nke Ben Hinom. Ebe ahụ ka ha na-anọ na-esure ụmụ ha ndị ikom na ndị inyom ọkụ. Ihe dị otu a abụkwaghị ụdị ihe m nyere ha nʼiwu ka ha mee. O nwekwaghị oge ihe dị otu a batara m nʼobi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.31",
            "verseOrgIds": [
              "JER.7.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JER 7:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, kpacharanụ anya, nʼihi na otu a ka",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.32",
            "verseOrgIds": [
              "JER.7.32"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.7.32",
                "verseOrgIds": [
                  "JER.7.32"
                ]
              }
            }
          ]
        },
        {
          "text": "kwubiri, ụbọchị ndị ahụ na-abịa, mgbe ndị mmadụ na-agaghị akpọkwa ebe ahụ Tofet maọbụ Ndagwurugwu nke Ben Hinom. Kama ha ga-akpọ ya ndagwurugwu ogbugbu mmadụ, nʼihi na ha ga-eli ọtụtụ ndị ha na Tofet ruo mgbe ha na-agaghị ahụkwa ebe ha ga-eli ndị fọdụrụ.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.32",
            "verseOrgIds": [
              "JER.7.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JER 7:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, ozu ndị mmadụ ndị a ga-aghọrọ ụmụ anụ ufe na anụ ọhịa ihe oriri. O nwekwaghị onye ga-anọ menye ha egwu chụpụ ha.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.33",
            "verseOrgIds": [
              "JER.7.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JER 7:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, aga m eme ka ụzụ ọṅụ na obi ụtọ, na olu ndị ikom na ndị inyom na-alụ di na nwunye nʼobodo niile nke Juda, na nʼokporoụzọ Jerusalem kwụsị. Ala ahụ ga-aghọkwa ebe tọgbọrọ nʼefu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.34",
            "verseOrgIds": [
              "JER.7.34"
            ]
          }
        }
      ]
    }
  ],
