  "verseCount": 19,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "35",
        "style": "c",
        "sid": "JER 35"
      },
      "items": [
        {
          "text": "35",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ụmụ Rekab",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 35:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị a bụ okwu",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.1",
            "verseOrgIds": [
              "JER.35.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.35.1",
                "verseOrgIds": [
                  "JER.35.1"
                ]
              }
            }
          ]
        },
        {
          "text": "nke ruru Jeremaya ntị nʼoge ọchịchị Jehoiakim nwa Josaya eze Juda sị ya,",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.1",
            "verseOrgIds": [
              "JER.35.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 35:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Jee nʼụlọ ụmụ Rekab kpọọ ha oku ka ha bịa nʼụlọnsọ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.2",
            "verseOrgIds": [
              "JER.35.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.35.2",
                "verseOrgIds": [
                  "JER.35.2"
                ]
              }
            }
          ]
        },
        {
          "text": ", nʼotu nʼime ọnụụlọ ya, nọdụ nʼebe ahụ nye ha mmanya ka ha ṅụọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.2",
            "verseOrgIds": [
              "JER.35.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 35:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, ejekwuuru m Jaazanaya nwa Jeremaya, nwa Habazinaya na ụmụnne ya, na ụmụ ya ndị ikom, ya bụ, ndị ezinaụlọ Rekab niile.",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.3",
            "verseOrgIds": [
              "JER.35.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 35:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akpọbatara m ha nʼụlọnsọ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.4",
            "verseOrgIds": [
              "JER.35.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.35.4",
                "verseOrgIds": [
                  "JER.35.4"
                ]
              }
            }
          ]
        },
        {
          "text": ", nʼime ọnụụlọ ụmụ Hanan nwa Igdalaya, onye nke Chineke. Ọnụụlọ a dị nso nʼọnụụlọ ndịisi ụlọnsọ, nke dị nʼelu ọnụụlọ Maaseia nwa Shalum, onye nche ọnụ ụzọ ụlọnsọ.",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.4",
            "verseOrgIds": [
              "JER.35.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 35:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, e doziri m ọkwa ụfọdụ jupụtara na mmanya na iko ụfọdụ nʼihu ụmụ Rekab, sị ha, \"Ngwanụ, ṅụanụ mmanya.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.5",
            "verseOrgIds": [
              "JER.35.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 35:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ha zara sị, \"Anyị adịghị aṅụ mmanya, nʼihi na nna nna anyị Jehonadab nwa Rekab nyere anyị iwu sị anyị, 'Unu aṅụkwala mmanya, unu na ụmụ ụmụ unu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.6",
            "verseOrgIds": [
              "JER.35.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 35:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọzọkwa, unu ewurula onwe unu ụlọ, unu akụla mkpụrụ ubi, maọbụ kụọ ubi vaịnị. Unu adọtarala onwe unu ihe ndị a niile, kama na-ebinụ nʼụlọ ikwuu. Ọ bụ nʼụzọ dị otu a ka unu ga-esi bie ogologo ndụ nʼala ahụ unu bụ ndị ọbịa nʼime ya.'",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.7",
            "verseOrgIds": [
              "JER.35.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 35:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyị erubela isi nʼihe niile nna nna anyị Jehonadab nwa Rekab gwara anyị. Anyị na ndị nwunye anyị na ụmụ anyị ndị ikom na ndị inyom adịghị aṅụ mmanya,",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.8",
            "verseOrgIds": [
              "JER.35.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 35:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "maọbụ wuo ụlọ, maọbụ nwee ubi vaịnị, ala ubi maọbụ mkpụrụ ọkụkụ.",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.9",
            "verseOrgIds": [
              "JER.35.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 35:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụkwa nʼụlọ ikwuu ka anyị na-ebi dị ka nna nna anyị Jehonadab nyere anyị nʼiwu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.10",
            "verseOrgIds": [
              "JER.35.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 35:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma mgbe Nebukadneza eze Babilọn busoro ala anyị agha, anyị kpebiri sị, 'Bịanụ ka anyị gbaba Jerusalem si otu a gbanarị ndị agha Babilọn, na ndị agha ndị Aram.' Ọ bụ nke a mere anyị ji biri na Jerusalem.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.11",
            "verseOrgIds": [
              "JER.35.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 35:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, okwu",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.12",
            "verseOrgIds": [
              "JER.35.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.35.12",
                "verseOrgIds": [
                  "JER.35.12"
                ]
              }
            }
          ]
        },
        {
          "text": "ruru Jeremaya ntị sị ya",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.12",
            "verseOrgIds": [
              "JER.35.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 35:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihe ndị a ka",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.13",
            "verseOrgIds": [
              "JER.35.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.35.13",
                "verseOrgIds": [
                  "JER.35.13"
                ]
              }
            }
          ]
        },
        {
          "text": ", Onye pụrụ ime ihe niile, bụ Chineke Izrel kwuru, \"Gaa gwa ndị Juda na ndị bi na Jerusalem, 'Ọ bụ na unu agaghị esite nʼịdọ aka na ntị mụta irubere okwu m isi?' ka",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.13",
            "verseOrgIds": [
              "JER.35.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.35.13",
                "verseOrgIds": [
                  "JER.35.13"
                ]
              }
            }
          ]
        },
        {
          "text": "kwupụtara.",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.13",
            "verseOrgIds": [
              "JER.35.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 35:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "'Jehonadab nwa Rekab nyere ụmụ ụmụ ya iwu sị ha aṅụla mmanya, ha na-edebe iwu ahụ. Ruo taa, ha adịghị aṅụ mmanya, nʼihi na ha na-edebe iwu nna nna ha nyere ha. Ma mụ onwe m agwala unu okwu mgbe na mgbe, ma unu jụrụ irubere m isi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.14",
            "verseOrgIds": [
              "JER.35.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 35:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe mgbe ka m ziteere unu ụmụ ohu m bụ ndị amụma, ndị bịara gwa unu okwu sị, \"Dozienụ ụzọ unu, sitekwanụ nʼajọ omume unu tụgharịa. Unu niile nʼotu nʼotu, unu agbasola chi ndị ọzọ ife ha. Ọ bụrụ na unu emee otu a, unu ga-ebi nʼala a m nyere unu na nna nna unu ha.\" Ma unu jụrụ ịṅa ntị, jụkwa ige m ntị.",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.15",
            "verseOrgIds": [
              "JER.35.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 35:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụmụ ụmụ Jehonadab, nwa Rekab, emeela ihe nna nna ha nyere ha nʼiwu, ma ndị a jụrụ irubere m isi.'",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.16",
            "verseOrgIds": [
              "JER.35.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 35:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nʼihi ya, ihe ndị a ka",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.17",
            "verseOrgIds": [
              "JER.35.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.35.17",
                "verseOrgIds": [
                  "JER.35.17"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke Onye pụrụ ime ihe niile, Chineke Izrel kwuru: 'Geenụ ntị! Lee, ana m aga ime ka ihe ọjọọ bịakwasị Juda na ndị niile bi na Jerusalem, dịka m kwuru na ọ ga-adị. Nʼihi na agwala m ha okwu, ma ha jụrụ ige m ntị. Akpọrọ m ha oku, ma ha jụrụ ịza.' \"",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.17",
            "verseOrgIds": [
              "JER.35.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 35:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Jeremaya gwara ndị ezinaụlọ Rekab, \"Ihe ndị a ka",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.18",
            "verseOrgIds": [
              "JER.35.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.35.18",
                "verseOrgIds": [
                  "JER.35.18"
                ]
              }
            }
          ]
        },
        {
          "text": ", Onye pụrụ ime ihe niile, bụ Chineke Izrel kwuru, 'Unu erubeela isi mee ihe niile nna nna unu bụ Jehonadab nyere unu nʼiwu.'",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.18",
            "verseOrgIds": [
              "JER.35.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 35:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi ya,",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.19",
            "verseOrgIds": [
              "JER.35.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.35.19",
                "verseOrgIds": [
                  "JER.35.19"
                ]
              }
            }
          ]
        },
        {
          "text": ", Onye pụrụ ime ihe niile, bụ Chineke Izrel, kwuru sị, 'O nweghị mgbe ọbụla nwoke ga-ejere m ozi ga-akọ nʼezinaụlọ Jehonadab nwa Rekab.' \"",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.19",
            "verseOrgIds": [
              "JER.35.19"
            ]
          }
        }
      ]
    }
  ],
