  "verseCount": 31,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "14",
        "style": "c",
        "sid": "1KI 14"
      },
      "items": [
        {
          "text": "14",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Amụma Ahija megide Jeroboam",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1KI 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼoge a, Abija nwa Jeroboam nọ nʼọrịa nke dị ukwuu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.1",
            "verseOrgIds": [
              "1KI.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi ya, Jeroboam sịrị nwunye ya, \"Gaa, jikwaa onwe gị nʼụzọ mmadụ na-enweghị ike ịmata na ị bụ nwunye Jeroboam. Ị ga-ejekwa Shaịlo, Ahija onye amụma nọ nʼebe ahụ, bụ nwoke ahụ gwara m okwu na m ga-abụ eze ndị nke a.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.2",
            "verseOrgIds": [
              "1KI.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chịrịkwa ogbe achịcha iri, na achịcha nta ole na ole, na otu karama mmanụ aṅụ, jekwuru ya. Ọ ga-agwa gị ihe ga-eme banyere nwantakịrị a.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.3",
            "verseOrgIds": [
              "1KI.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwunye Jeroboam mere ihe o kwuru, o biliri jee nʼụlọ Ahija na Shaịlo.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.4",
            "verseOrgIds": [
              "1KI.14.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1KI 14:4"
      },
      "items": [
        {
          "text": "Ahija bụ agadi nwoke nʼoge a. Ọ naghị ahụkwa ụzọ nʼihi nka ọ kara.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.4",
            "verseOrgIds": [
              "1KI.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.5",
            "verseOrgIds": [
              "1KI.14.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1KI.14.5",
                "verseOrgIds": [
                  "1KI.14.5"
                ]
              }
            }
          ]
        },
        {
          "text": "agwalarị Ahija okwu sị ya, \"Nwunye Jeroboam na-abịa ịjụta ase nʼaka gị banyere nwa ya nwoke ahụ na-adịghị ike, ọsịsa dị otu a ka i ganye ya. Mgbe ọ ga-abịa ịhụ gị ọ ga-eme onwe ya dịka ọ bụghị nwunye Jeroboam.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.5",
            "verseOrgIds": [
              "1KI.14.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Ahija nụrụ ụda nzọ ụkwụ ya ka ọ na-abata nʼọnụ ụzọ, ọ kpọrọ ya oku sị ya, \"Bata, nwunye Jeroboam. Gịnị mere i ji jie ejiji dịka onye ọzọ? Enwere m akụkọ ọjọọ m ga-akọrọ gị",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.6",
            "verseOrgIds": [
              "1KI.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ga gwa Jeroboam sị ya, Otu a ka",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.7",
            "verseOrgIds": [
              "1KI.14.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1KI.14.7",
                "verseOrgIds": [
                  "1KI.14.7"
                ]
              }
            }
          ]
        },
        {
          "text": ", Chineke Izrel kwuru, 'Esi m nʼetiti ndị m welie gị elu, mee gị ka ị bụrụ onye ga-achị ndị m, bụ Izrel.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.7",
            "verseOrgIds": [
              "1KI.14.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adọwapụrụ m alaeze Izrel site nʼụlọ Devid nye gị ya, ma ị geghị ntị nʼiwu m, maọbụ debe ha dịka ohu m Devid debere ihe niile m nyere ya nʼiwu. Onye echiche obi ya na ihe na-atọ obi ya ụtọ mgbe niile bụ idebe iwu m, na ime ihe ziri ezi nʼanya m.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.8",
            "verseOrgIds": [
              "1KI.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ihe ọjọọ i mere adịla ukwuu karịa nke ndị niile bu gị ụzọ bụrụ eze mere. Ị kpụọlara onwe gị chi ndị ọzọ, chi ndị e ji ọla kpụọ, si otu a kpasuo m iwe, gbakụta m azụ gị.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.9",
            "verseOrgIds": [
              "1KI.14.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Nʼihi ihe ndị a, aga m eme ka ihe ọjọọ bịakwasị ezinaụlọ Jeroboam. Aga m ekpochapụkwa ụmụ ndị ikom gị niile, ma ndị ohu, ma ndị nwe onwe ha nọ nʼala Izrel. Aga m ekpochapụkwa ụlọ Jeroboam dịka mmadụ si ekpochapụ nsị anụ, ruo mgbe e kpochapụrụ ha niile.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.10",
            "verseOrgIds": [
              "1KI.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkịta ga-eri ozu ndị nke Jeroboam ndị nwụrụ nʼime obodo, ma ndị nwụrụ nʼọhịa ka anụ ufe nke eluigwe ga-eri ozu ha.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.11",
            "verseOrgIds": [
              "1KI.14.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1KI.14.11",
                "verseOrgIds": [
                  "1KI.14.11"
                ]
              }
            }
          ]
        },
        {
          "text": "ekwuola ya.'",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.11",
            "verseOrgIds": [
              "1KI.14.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ma gị onwe gị, Laa nʼụlọ gị. Mgbe ị na-azọbanye ụkwụ gị nʼobodo, nwokorobịa ahụ ga-anwụ.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.12",
            "verseOrgIds": [
              "1KI.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị Izrel niile ga-akwa akwa nʼihi ya lie ya. Ọ bụ naanị ya bụ onye a ga-eli eli, nʼihi na nʼime ezinaụlọ Jeroboam, ọ bụ naanị nʼime nwokorobịa a ka",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.13",
            "verseOrgIds": [
              "1KI.14.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1KI.14.13",
                "verseOrgIds": [
                  "1KI.14.13"
                ]
              }
            }
          ]
        },
        {
          "text": ", Chineke Izrel chọtara ihe dị mma.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.13",
            "verseOrgIds": [
              "1KI.14.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ma",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.14",
            "verseOrgIds": [
              "1KI.14.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1KI.14.14",
                "verseOrgIds": [
                  "1KI.14.14"
                ]
              }
            }
          ]
        },
        {
          "text": "ga-emekwa ka eze ọzọ bilie nʼIzrel, onye ga-ekpochapụ ezinaụlọ Jeroboam niile. O bidola taa, e, ma ugbu a kwa!",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.14",
            "verseOrgIds": [
              "1KI.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1KI.14.15",
                "verseOrgIds": [
                  "1KI.14.15"
                ]
              }
            }
          ]
        },
        {
          "text": "ga-eti Izrel ihe, mee ka ọ maa jijiji dịka osisi achara nke ikuku na-ebugharị nʼime mmiri. Ọ ga-ehopu Izrel site nʼezi ala o nyere nna nna ha, fesaa ha nʼofe osimiri Yufretis, nʼihi na ha akpasuola iwe",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.15",
            "verseOrgIds": [
              "1KI.14.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1KI.14.15",
                "verseOrgIds": [
                  "1KI.14.15"
                ]
              }
            }
          ]
        },
        {
          "text": "site nʼiguzobe ogidi ofufe Ashera.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.15",
            "verseOrgIds": [
              "1KI.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ ga-agbakụta Izrel azụ nʼihi mmehie Jeroboam mere, ma meekwa ka Izrel niile soro ya mehie.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.16",
            "verseOrgIds": [
              "1KI.14.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, nwunye Jeroboam biliri laghachi Tịaza. Ma nwokorobịa ahụ nwụrụ mgbe ọ na-azọbata ụkwụ ya nʼọnụ ụzọ ụlọ ha.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.17",
            "verseOrgIds": [
              "1KI.14.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha liri ya, ndị Izrel niile rukwara ụjụ nʼihi ya, dịka okwu",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.18",
            "verseOrgIds": [
              "1KI.14.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1KI.14.18",
                "verseOrgIds": [
                  "1KI.14.18"
                ]
              }
            }
          ]
        },
        {
          "text": "si dị, nke o kwuru site nʼọnụ Ahija, onye amụma.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.18",
            "verseOrgIds": [
              "1KI.14.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihe niile ọzọ Jeroboam mere, na ihe niile banyere ibu agha ya niile, na ọtụtụ ihe ọzọ dị iche iche banyere ọchịchị ya, ka e dere nʼakwụkwọ akụkọ ihe ndị eze Izrel mere.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.19",
            "verseOrgIds": [
              "1KI.14.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jeroboam chịrị Izrel iri afọ abụọ na abụọ. O sooro ndị nna nna ya ha dina nʼọnwụ, nwa ya Nadab ghọrọ eze nʼọnọdụ ya.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.20",
            "verseOrgIds": [
              "1KI.14.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Rehoboam, eze Juda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼoge a, Rehoboam nwa Solomọn, bụ eze Juda. Ọ gbara iri afọ anọ na otu mgbe ọ malitere ịbụ eze. Ọ chịrị afọ iri na asaa na Jerusalem, bụ obodo ahụ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.21",
            "verseOrgIds": [
              "1KI.14.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1KI.14.21",
                "verseOrgIds": [
                  "1KI.14.21"
                ]
              }
            }
          ]
        },
        {
          "text": "họọrọ site nʼetiti ebo niile nke Izrel, bụ ebe ọ ga-akpọkwasị Aha ya. Aha nne ya bụ Naama, onye Amọn.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.21",
            "verseOrgIds": [
              "1KI.14.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 14:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, ndị Juda mehiekwara megide",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.22",
            "verseOrgIds": [
              "1KI.14.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1KI.14.22",
                "verseOrgIds": [
                  "1KI.14.22"
                ]
              }
            }
          ]
        },
        {
          "text": ". Ha sitere nʼọtụtụ mmehie ha mere, nke karịrị mmehie nke ndị nna nna ha ochie mere, kpasuo ekworo ya.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.22",
            "verseOrgIds": [
              "1KI.14.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1KI 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha wukwara nye onwe ha ebe ịchụ aja na ogidi arụsị nʼelu ugwu niile, na ogidi chi Ashera, na nʼokpuru osisi ọbụla akwụkwọ ndụ dị nʼelu ya.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.23",
            "verseOrgIds": [
              "1KI.14.23"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.23",
            "verseOrgIds": [
              "1KI.14.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 14:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "E nwere ndị ikom akwụna nʼala ahụ, ndị nọ nʼụlọ arụsị ha dị iche iche. Ndị mmadụ mere ụdị ihe arụ ahụ nke ndị mba niile ndị ahụ na-eme, bụ mba ndị ahụ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.24",
            "verseOrgIds": [
              "1KI.14.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1KI.14.24",
                "verseOrgIds": [
                  "1KI.14.24"
                ]
              }
            }
          ]
        },
        {
          "text": "sitere nʼihu ndị Izrel chụpụ.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.24",
            "verseOrgIds": [
              "1KI.14.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 14:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼafọ nke ise, nke ọchịchị eze Rehoboam, Shishak, eze Ijipt, busoro Jerusalem agha.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.25",
            "verseOrgIds": [
              "1KI.14.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 14:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "O bukọrọ akụ niile dị nʼime ụlọ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.26",
            "verseOrgIds": [
              "1KI.14.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1KI.14.26",
                "verseOrgIds": [
                  "1KI.14.26"
                ]
              }
            }
          ]
        },
        {
          "text": ", na akụ niile dịkwa nʼụlọeze. Ọ kwakọọrọ ihe niile, werekwa ọta ọlaedo niile ndị ahụ Solomọn kpụrụ.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.26",
            "verseOrgIds": [
              "1KI.14.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 14:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma eze Rehoboam kpụrụ ọta bronz i ji dochie ndị ahụ, nyefee ha nʼaka ndịisi ndị nche, bụ ndị na-eche nʼọnụ ụzọ ụlọeze nche ka a lekọta ha anya.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.27",
            "verseOrgIds": [
              "1KI.14.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 14:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ọbụla eze na-aga nʼụlọnsọ ukwu",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.28",
            "verseOrgIds": [
              "1KI.14.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1KI.14.28",
                "verseOrgIds": [
                  "1KI.14.28"
                ]
              }
            }
          ]
        },
        {
          "text": ", ndị nche na-ebu ọta ndị ahụ, emesịa, ha na-ebughachikwa ha nʼime ụlọ ndị nche.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.28",
            "verseOrgIds": [
              "1KI.14.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 14:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma banyere ihe ndị ọzọ niile mere nʼoge ọchịchị Rehoboam, na ihe niile o mere, ọ bụ na e deghị ha nʼakwụkwọ akụkọ ndị eze Juda?",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.29",
            "verseOrgIds": [
              "1KI.14.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 14:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agha dịgidere nʼetiti Rehoboam na Jeroboam ụbọchị niile nke ndụ ha.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.30",
            "verseOrgIds": [
              "1KI.14.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1KI 14:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rehoboam sooro ndị nna nna ya ha dina nʼọnwụ, e lie ya nʼebe e liri ha nʼobodo Devid. Aha nne ya bụ Naama, onye Amọn. Abija nwa ya ghọrọ eze nʼọnọdụ ya.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.31",
            "verseOrgIds": [
              "1KI.14.31"
            ]
          }
        }
      ]
    }
  ],
