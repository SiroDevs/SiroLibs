  "verseCount": 53,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "1KI 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Adonaịja echie onwe ya eze",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1KI 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe eze Devid ghọrọ agadi, nʼagbanyeghị na-eji ọtụtụ uwe kpuchie ya, ahụ ya ekpoghị ọkụ.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.1",
            "verseOrgIds": [
              "1KI.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, ndị na-ejere ya ozi sịrị ya, \"Ka anyị chọtara eze otu nwaagbọghọ na-amaghị nwoke, onye ga-akwụ nʼihu eze ma bụrụkwa onye ga-elekọta ya. O nwere ike idina nʼakụkụ onyenwe anyị bụ eze ime ka ahụ kpoo ya ọkụ.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.2",
            "verseOrgIds": [
              "1KI.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha gagharịrị nʼala Izrel niile chọọ nwaagbọghọ mara mma, chọta otu nwaagbọghọ onye Shunem, aha ya bụ Abishag, kpọtaara ya eze.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.3",
            "verseOrgIds": [
              "1KI.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwaagbọghọ a mara mma nke ukwuu; ọ lekọtakwara eze, jekwaara ya ozi ma ya na eze enweghị mmekọ ọbụla.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.4",
            "verseOrgIds": [
              "1KI.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼoge a, Adonaịja",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.5",
            "verseOrgIds": [
              "1KI.1.5"
            ]
          }
        },
        {
          "text": "onye nne ya bụ Hagit, wepụtara onwe ya, kwuo sị, \"Aga m abụ eze.\" Nʼihi nke a, ọ kwadooro onwe ya ụgbọ agha na ọtụtụ ịnyịnya, kpọtakwa iri ndị ikom ise, ndị ga-agba ọsọ nʼihu ya.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.5",
            "verseOrgIds": [
              "1KI.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ndụ Adonaịja niile, o nweghị oge nna ya baara ya mba site nʼịjụ ya, \"Gịnị mere i ji akpa agwa dị otu a?\" Ọ bụ nwokorobịa mara mma nke ukwuu; ọ bụ ya na-esotekwa nwanne ya Absalọm.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.6",
            "verseOrgIds": [
              "1KI.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adonaịja na Joab, nwa Zeruaya",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.7",
            "verseOrgIds": [
              "1KI.1.7"
            ]
          }
        },
        {
          "text": "tinyere Abịata",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.7",
            "verseOrgIds": [
              "1KI.1.7"
            ]
          }
        },
        {
          "text": "onye nchụaja, kparịtara ụka. Ha kwenyere inyere ya aka ka ọ ghọọ eze.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.7",
            "verseOrgIds": [
              "1KI.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Zadọk onye nchụaja, Benaya nwa Jehoiada, Netan onye amụma, Shimei, Rei na ndị agha niile na-eche Devid nche esonyeghị Adonaịja.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.8",
            "verseOrgIds": [
              "1KI.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adonaịja chịịrị atụrụ, ehi na ụmụ ehi gbara abụba, gaa nʼakụkụ En-Rogel chụọ aja na Nkume Zohelet. Ọ kpọrọ ụmụnne ya niile bụ ụmụ ndị ikom eze na ndịisi Juda niile, ndị na-ejere eze ozi oku,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.9",
            "verseOrgIds": [
              "1KI.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "ma ọ kpọghị Netan onye amụma, maọbụ Benaya, maọbụ ndị agha niile na-eche Devid nche. Ọ kpọkwaghị Solomọn nwanne ya.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.10",
            "verseOrgIds": [
              "1KI.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Netan onye amụma jụrụ Batsheba nne Solomọn ajụjụ sị, \"Ị nụghị na Adonaịja nwa Hagit aghọọla eze ugbu a, ma onyenwe anyị bụ Devid amaghị ihe ọbụla banyere ya?",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.11",
            "verseOrgIds": [
              "1KI.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ugbu a, ka m dụọ gị ọdụ otu ị ga-esi zọpụta ndụ gị na ndụ nwa gị Solomọn.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.12",
            "verseOrgIds": [
              "1KI.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakwuru eze Devid sị ya, 'Onyenwe m bụ eze, ọ bụ na i kweghị m bụ ohu gị nkwa sị: \"Nʼezie, Solomọn nwa gị ga-abụ eze nʼọnọdụ m, ọ ga-anọdụ nʼocheeze m\"? Ma gịnị mere Adonaịja ji bụrụ eze?'",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.13",
            "verseOrgIds": [
              "1KI.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ị ka nọ na-akpanyere eze ụka, mụ onwe m ga-abịakwute gị gbaa okwu niile ị na-ekwu ume.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.14",
            "verseOrgIds": [
              "1KI.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batsheba bakwuuru eze nʼime ụlọ. Eze emeela nnọọ agadi nke ukwuu. Abishag onye Shunem nọkwa na-elekọta ya.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.15",
            "verseOrgIds": [
              "1KI.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batsheba gburu ikpere nʼala, kpọọ isiala nye eze.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.16",
            "verseOrgIds": [
              "1KI.1.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1KI 1:16"
      },
      "items": [
        {
          "text": "Mgbe ahụ, eze jụrụ ya sị, \"Gịnị ka ị na-achọ?\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.16",
            "verseOrgIds": [
              "1KI.1.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batsheba zara sị ya, \"Onyenwe m, i jiri",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.17",
            "verseOrgIds": [
              "1KI.1.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1KI.1.17",
                "verseOrgIds": [
                  "1KI.1.17"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke gị ṅụọrọ m iyi, kwee m nkwa sị na nwa m Solomọn ga-abụ eze, nọdụkwa nʼocheeze gị.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.17",
            "verseOrgIds": [
              "1KI.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ugbu a, Adonaịja aghọọla eze, ma gị onyenwe m bụ eze amaghị ihe banyere nke a.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.18",
            "verseOrgIds": [
              "1KI.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "O jirila ọtụtụ igwe ehi na ụmụ ehi gbara abụba, na atụrụ chụọ aja. Ọ kpọkwara ụmụ ndị ikom eze niile na Abịata onye nchụaja, na Joab onyeisi agha. Ma ọ kpọghị Solomọn bụ ohu gị.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.19",
            "verseOrgIds": [
              "1KI.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ugbu a, onyenwe m eze, ndị Izrel niile na-ele gị anya isi nʼọnụ gị nụta onye ga-anọchi anya gị, ịnọkwasị nʼocheeze eze gị.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.20",
            "verseOrgIds": [
              "1KI.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ọ bụghị otu a, ngwangwa onyenwe m bụ eze ga-esoro ndị nna nna ya ha dina nʼọnwụ, mụ onwe m na nwa m Solomọn ka a ga-emeso mmeso dịka ndị mmebi iwu.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.21",
            "verseOrgIds": [
              "1KI.1.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Batsheba nọ na-akpanyere eze ụka, Netan onye amụma batara.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.22",
            "verseOrgIds": [
              "1KI.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1KI 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "A gwara eze okwu sị, \"Netan onye amụma nọ nʼebe a.\" Ya mere, ọ gara nʼihu eze kpọọ isiala nye ya.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.23",
            "verseOrgIds": [
              "1KI.1.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Netan sịrị, \"Onyenwe m, bụ eze, ọ bụ gị onwe gị sịrị Adonaịja ga-abụ eze mgbe ị nwụrụ, na ọ ga-anọkwasịkwa nʼocheeze gị?",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.24",
            "verseOrgIds": [
              "1KI.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Taa, ọ gaala jiri ọtụtụ igwe ehi, na ụmụ ehi gbara abụba, na ụmụ atụrụ chụọ aja. Ọ kpọọkwala ụmụ ndị ikom eze niile. Ọ kpọkwara ndịisi agha, na Abịata onye nchụaja. Ha na ya na-eri ihe oriri, na-aṅụkwa ihe ọṅụṅụ, na-eti mkpu na-asị, 'Eze Adonaịja ga-adị ruo mgbe ebighị ebi.'",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.25",
            "verseOrgIds": [
              "1KI.1.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 1:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ha akpọghị mụ bụ ohu gị na Zadọk, onye nchụaja, na Benaya nwa Jehoiada, na ohu gị bụ Solomọn.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.26",
            "verseOrgIds": [
              "1KI.1.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 1:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ site nʼaka onyenwe m bụ eze ka ihe nke a siri mee, ma i meghị ka ndị ohu ya mata onye ga-anọdụ nʼocheeze onyenwe m eze, mgbe ọ nọghịkwa ya?\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.27",
            "verseOrgIds": [
              "1KI.1.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Devid emee Solomọn eze",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 1:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Devid kwuru okwu sị, \"Kpọọrọnụ m Batsheba.\" Batsheba batara, guzo nʼihu eze.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.28",
            "verseOrgIds": [
              "1KI.1.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 1:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, eze ṅụrụ iyi sị ya, \"Dịka",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.29",
            "verseOrgIds": [
              "1KI.1.29"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1KI.1.29",
                "verseOrgIds": [
                  "1KI.1.29"
                ]
              }
            }
          ]
        },
        {
          "text": "na-adị ndụ, Onye ahụ napụtara m site na nsogbu m niile,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.29",
            "verseOrgIds": [
              "1KI.1.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 1:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "otu ahụ m siri ṅụrụ gị iyi nʼaha",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.30",
            "verseOrgIds": [
              "1KI.1.30"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1KI.1.30",
                "verseOrgIds": [
                  "1KI.1.30"
                ]
              }
            }
          ]
        },
        {
          "text": ", Chineke Izrel, sị, na Solomọn nwa gị ga-abụ eze nʼọnọdụ m, ọ bụ ya ga-anọchi anya m, nọdụkwa nʼocheeze m. Otu ahụ ka m ga-eme nʼụbọchị taa.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.30",
            "verseOrgIds": [
              "1KI.1.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1KI 1:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Batsheba kpọrọ isiala, gbukwaa ikpere nʼihu eze sị ya, \"Ka onyenwe m eze Devid dịrị ndụ ruo mgbe ebighị ebi.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.31",
            "verseOrgIds": [
              "1KI.1.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1KI 1:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Devid nyere iwu sị, \"Kpọọrọ m Zadọk onye nchụaja, na Netan onye amụma, na Benaya, nwa Jehoiada.\" Mgbe ha niile bịara nʼihu eze,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.32",
            "verseOrgIds": [
              "1KI.1.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1KI 1:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "ọ sịrị ha, \"Duru ndị ozi",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.33",
            "verseOrgIds": [
              "1KI.1.33"
            ]
          }
        },
        {
          "text": "onyenwe unu, tinyere unu onwe unu, mee ka Solomọn nwa m nọkwasị nʼelu ịnyịnya muul nke mụ onwe m, kpọrọnụ ya gbada Gaihọn.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.33",
            "verseOrgIds": [
              "1KI.1.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1KI 1:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼebe ahụ, ka Zadọk onye nchụaja, na Netan onye amụma, tee ya mmanụ ịbụ eze Izrel. Fụkwaanụ opi, tiekwanụ mkpu sị, 'Eze Solomọn ga-adị ndụ ruo mgbe ebighị ebi.'",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.34",
            "verseOrgIds": [
              "1KI.1.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1KI 1:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, unu na ya ga-esokwa gbagota, ọ ga-abịa nọkwasị nʼocheeze m ịchị nʼọnọdụ m. Nʼihi na ọ bụ ya ka m họpụtara ịchị eze nʼIzrel na Juda.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.35",
            "verseOrgIds": [
              "1KI.1.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1KI 1:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Benaya nwa Jehoiada zara eze sị, \"Amen, ka",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.36",
            "verseOrgIds": [
              "1KI.1.36"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1KI.1.36",
                "verseOrgIds": [
                  "1KI.1.36"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke onyenwe m na eze, kwupụta ya ka ọ dị otu a.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.36",
            "verseOrgIds": [
              "1KI.1.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1KI 1:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dịka",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.37",
            "verseOrgIds": [
              "1KI.1.37"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1KI.1.37",
                "verseOrgIds": [
                  "1KI.1.37"
                ]
              }
            }
          ]
        },
        {
          "text": "si nọnyere onyenwe m bụ eze, biko, ka o si otu a nọnyere Solomọn ime ka ocheeze ya dị ukwuu karịa ocheeze onyenwe m bụ eze Devid.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.37",
            "verseOrgIds": [
              "1KI.1.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1KI 1:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, Zadọk, onye nchụaja, na Netan onye amụma, na Benaya, nwa Jehoiada, na ndị Keret na ndị Pelet,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.38",
            "verseOrgIds": [
              "1KI.1.38"
            ]
          }
        },
        {
          "text": "duuru Solomọn mee ya ka ọ nọkwasị nʼelu ịnyịnya muul nke eze Devid. Emesịa, ha duuru ya gaa Gaihọn.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.38",
            "verseOrgIds": [
              "1KI.1.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1KI 1:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼebe ahụ, Zadọk onye nchụaja wepụtara mpi mmanụ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.39",
            "verseOrgIds": [
              "1KI.1.39"
            ]
          }
        },
        {
          "text": "ahụ dị nʼụlọ nzute",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.39",
            "verseOrgIds": [
              "1KI.1.39"
            ]
          }
        },
        {
          "text": "Chineke, were tee Solomọn nʼisi. Ha fụkwara opi. Mgbe ahụ, ndị mmadụ niile tiri mkpu sị, \"Ka eze Solomọn dịrị ndụ ruo mgbe ebighị ebi.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.39",
            "verseOrgIds": [
              "1KI.1.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1KI 1:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị Izrel niile sooro ya rigoo, na-afụ ọja na-aṅụrịkwa oke ọnụ, ruo nʼala mara jijiji nʼihi oke ụzụ.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.40",
            "verseOrgIds": [
              "1KI.1.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1KI 1:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adonaịja na ndị ọbịa ya niile nụrụ mkpu ọṅụ ahụ mgbe ha onwe ha na-erisi nri. Mgbe Joab nụrụ opi ike ka ọ na-ada, ọ jụrụ sị, \"Gịnị mere oke ụzụ dị otu a ji na-ada nʼime obodo.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.41",
            "verseOrgIds": [
              "1KI.1.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1KI 1:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma mgbe ọ ka kpụ okwu ahụ nʼọnụ, lee Jonatan nwa Abịata onye nchụaja, ka ọ batara. Adonaịja sịrị, \"Bata! Nʼihi na ị bụ ezi mmadụ amaara m na ọ bụ oziọma ka i ji bịa.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.42",
            "verseOrgIds": [
              "1KI.1.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "1KI 1:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jonatan zara ya sị, \"Mba, ọ dịghị otu ahụ! Onyenwe anyị eze Devid emeela Solomọn eze.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.43",
            "verseOrgIds": [
              "1KI.1.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "1KI 1:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eze e zigala ya na Zadọk onye nchụaja, na Netan onye amụma, na Benaya nwa Jehoiada, ndị Keret na ndị Pelet sokwa duru ya gaa. Ha mere ka ọ nọkwasị nʼelu ịnyịnya muul eze.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.44",
            "verseOrgIds": [
              "1KI.1.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "1KI 1:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zadọk onye nchụaja na Netan onye amụma eteela ya mmanụ na Gaihọn ịbụ eze. Ha esitekwala nʼebe ahụ ṅụrụ ọṅụ na-alaghachikwa, ndị obodo niile nọkwa ugbu a na-eme mkpọtụ, na-aṅụrịkwa ọṅụ. Ọ bụkwa ụzụ ọṅụ ha ka unu nụrụ.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.45",
            "verseOrgIds": [
              "1KI.1.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "1KI 1:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomọn na-anọkwasị nʼocheeze ugbu a.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.46",
            "verseOrgIds": [
              "1KI.1.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "1KI 1:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọzọkwa, ndị na-ejere eze ozi abịala ikele onyenwe anyị eze Devid ekele, na-asị, 'ka Chineke gị mee ka aha Solomọn bụrụ aha a ma ama karịa nke gị, ka ocheeze Solomọn dịkwa ukwuu karịa nke gị.' Eze nọkwa nʼelu ihe ndina ya kpọọ isiala ofufe,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.47",
            "verseOrgIds": [
              "1KI.1.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "1KI 1:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "sị, 'Otuto dịrị",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.48",
            "verseOrgIds": [
              "1KI.1.48"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1KI.1.48",
                "verseOrgIds": [
                  "1KI.1.48"
                ]
              }
            }
          ]
        },
        {
          "text": ", Chineke Izrel onye mere ka m jiri anya m hụ onye nọchiri anya nʼocheeze m taa.' \"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.48",
            "verseOrgIds": [
              "1KI.1.48"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "1KI 1:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Adonaịja, na ndị ọbịa ya si nʼebe ha na-eri ihe malie. Onye ọbụla sikwa nʼebe ahụ gbapụ ọsọ, nʼihi ụjọ.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.49",
            "verseOrgIds": [
              "1KI.1.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "1KI 1:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Adonaịja tụrụ egwu nke ukwuu ihe Solomọn ga-eme ya, nʼihi ya, ọ gara jide mpi dị nʼebe ịchụ aja aka.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.50",
            "verseOrgIds": [
              "1KI.1.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "1KI 1:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, a gwara Solomọn sị, \"Adonaịja na-atụ egwu ihe Solomọn ga-eme ya, nʼihi ya ọ na-ejide mpi ebe nchụaja aka. Ọ na-asị, 'Ka eze Solomọn ṅụọra m iyi taa sị na ọ gaghị eji mma agha gbuo ohu ya.' \"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.51",
            "verseOrgIds": [
              "1KI.1.51"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "1KI 1:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomọn zara sị, \"Ọ bụrụ na o gosi onwe ya dịka onye kwesiri ntụkwasị obi, otu agịrị isi dị ya nʼisi agaghị ada nʼala, ma ọ bụrụ na a hụta ihe ọjọọ na nʼaka ya, ọ ga-anwụ.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.52",
            "verseOrgIds": [
              "1KI.1.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "1KI 1:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, eze Solomọn, zigara ndị ozi mere ka o site nʼebe nchụaja rịdata. Adonaịja bịara kpọọ isiala nye eze Solomọn. Mgbe ahụ, Solomọn sịrị ya, \"Laa nʼụlọ gị.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.53",
            "verseOrgIds": [
              "1KI.1.53"
            ]
          }
        }
      ]
    }
