  "verseCount": 18,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "2KI 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ikpe ọmụma dịrị Ahazaya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moab nupuru isi megide Izrel mgbe Ehab nwụrụ.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.1",
            "verseOrgIds": [
              "2KI.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼoge a, Ahazaya sitere na mgbe ụlọ elu ya dị na Sameria daa, merụọ ahụ nke ukwuu. Nʼihi ọrịa a, o zigara ndị ozi, sị ha, \"Gaa jụta ase nʼaka Baal-Zebub,",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.2",
            "verseOrgIds": [
              "2KI.1.2"
            ]
          }
        },
        {
          "text": "bụ chi Ekrọn, ma m ga-adịrị site nʼihe mmerụ ahụ a.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.2",
            "verseOrgIds": [
              "2KI.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma mmụọ ozi",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.3",
            "verseOrgIds": [
              "2KI.1.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.1.3",
                "verseOrgIds": [
                  "2KI.1.3"
                ]
              }
            }
          ]
        },
        {
          "text": "gwara Ịlaịja onye Tishbe okwu sị ya, \"Gaa zute ndị ozi eze Sameria zipụrụ, jụọ ha sị, 'Gịnị mere unu ji aga Ekrọn ịjụ ase? Ọ bụ na Chineke anọghị nʼIzrel mere unu ji aga ịjụ Baal-Zebub ase ịmata ma eze ọ ga-adị ndụ?'",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.3",
            "verseOrgIds": [
              "2KI.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi nke a, otu a ka",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.4",
            "verseOrgIds": [
              "2KI.1.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.1.4",
                "verseOrgIds": [
                  "2KI.1.4"
                ]
              }
            }
          ]
        },
        {
          "text": "kwuru, 'Ị gaghị esite nʼelu ihe ndina ahụ bilie. Ị ghaghị ịnwụ!' \" Ya mere Ịlaịja pụrụ gaa zie ndị ozi eze ozi ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.4",
            "verseOrgIds": [
              "2KI.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị ozi ahụ laghachiri azụ. Ma mgbe eze hụrụ ha, ọ jụrụ ha sị, \"Gịnị mere unu ji lọghachi?\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.5",
            "verseOrgIds": [
              "2KI.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha zara ya, \"Otu nwoke zutere anyị nʼụzọ sị anyị, 'Laghachi ga zie eze ahụ zitere unu sị ya: \"Ihe ndị a, ka",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.6",
            "verseOrgIds": [
              "2KI.1.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.1.6",
                "verseOrgIds": [
                  "2KI.1.6"
                ]
              }
            }
          ]
        },
        {
          "text": "kwuru, Ọ bụ nʼihi na Chineke anọghị nʼIzrel ka i ji zipụ ndị mmadụ ka ha gaa jụta ase site nʼaka Baal-Zebub, chi ndị Ekrọn? Nʼihi nke a, ị gaghị esite nʼihe ndina gị bilie. Ya doo gị anya na ị ghaghị ịnwụ!\" ' \"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.6",
            "verseOrgIds": [
              "2KI.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eze jụrụ ha sị, \"Onye bụ nwoke a zutere unu nʼụzọ gwa unu okwu ndị a? Olee ụdị mmadụ ọ bụ?\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.7",
            "verseOrgIds": [
              "2KI.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha zaghachiri ya, \"Ọ bụ nwoke yi uwe e ji ajị anụ kpaa; o kere ihe okike akpụkpọ anụ nʼukwu ya.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.8",
            "verseOrgIds": [
              "2KI.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 1:8"
      },
      "items": [
        {
          "text": "Eze sịrị, \"Ọ bụ Ịlaịja, onye amụma si Tishbe!\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.8",
            "verseOrgIds": [
              "2KI.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, eze zigara otu onyeisi agha ya, na iri ndị agha ise ka ha gaa jide Ịlaịja. Mgbe ndị agha ahụ bịarutere hụ Ịlaịja ka ọ nọ ala nʼelu ugwu, onyeisi agha ahụ kpọrọ Ịlaịja sị ya, \"Onye nke Chineke, eze sị gị, 'rituo!' \"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.9",
            "verseOrgIds": [
              "2KI.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ịlaịja zara sị ha, \"Ọ bụrụ na m bụ onye nke Chineke dịka i kwuru, ka ọkụ si nʼeluigwe daa rechapụ gị na iri ndị a agha ise so gị.\" Otu mgbe ahụ, ọkụ sitere nʼeluigwe daa rechapụ iri ndị agha ise ahụ na onyeisi ha.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.10",
            "verseOrgIds": [
              "2KI.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọzọkwa, eze zigara otu onyeisi agha na iri ndị agha ise ọzọ ka ha gaa jide Ịlaịja. Mgbe ha bịarutere hụ Ịlaịja, onyeisi agha ahụ kpọkuru ya sị ya, \"Onye nke Chineke, eze sị gị, 'rituo, bịa ngwangwa!' \"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.11",
            "verseOrgIds": [
              "2KI.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ịlaịja zara sị ya, \"Ọ bụrụ na m bụ onye nke Chineke dịka i kwuru, ka ọkụ si nʼeluigwe daa rechapụ gị na iri ndị agha ise gị na ha so.\" Ngwangwa, ọkụ Chineke si nʼeluigwe daa rechapụ ha.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.12",
            "verseOrgIds": [
              "2KI.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọzọkwa, eze zigara otu onyeisi agha na iri ndị agha ise ọzọ ka ha gaa jide Ịlaịja. Mgbe ndị agha a bịara hụ Ịlaịja, onyeisi agha ahụ rigoro nʼelu ugwu gbuo ikpere nʼala nʼihu Ịlaịja rịọọ ya amara sị ya, \"Onye nke Chineke, biko, meere ohu gị na iri ndị agha ise mụ na ha so ebere.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.13",
            "verseOrgIds": [
              "2KI.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lee, ọkụ esitela nʼeluigwe rechapụ ndịisi agha abụọ ahụ buru ụzọ, ha na ndị agha ha. Ugbu a, biko, arịọ m gị, chebe ndụ anyị.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.14",
            "verseOrgIds": [
              "2KI.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, mmụọ ozi",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.15",
            "verseOrgIds": [
              "2KI.1.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.1.15",
                "verseOrgIds": [
                  "2KI.1.15"
                ]
              }
            }
          ]
        },
        {
          "text": "gwara Ịlaịja okwu sị ya, \"Atụla egwu! Soro ya gaa!\" Ya mere, Ịlaịja sooro onyeisi agha ahụ gaa nʼihu eze.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.15",
            "verseOrgIds": [
              "2KI.1.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Ịlaịja ruru nʼihu eze, ọ gwara eze okwu sị ya, \"Ihe ndị a ka",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.16",
            "verseOrgIds": [
              "2KI.1.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.1.16",
                "verseOrgIds": [
                  "2KI.1.16"
                ]
              }
            }
          ]
        },
        {
          "text": "kwuru, ọ bụ nʼihi na Chineke anọghị nʼIzrel ka i ji zipụ ndị ozi ka ha gaa jụta ase site nʼaka Baal-Zebub, chi ndị Ekrọn? Ebe ọ bụ na i mere ihe dị otu a, ị gaghị esite nʼihe ndina gị bilie. Ị ga-anwụrịrị!\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.16",
            "verseOrgIds": [
              "2KI.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ nwụrụ dịka okwu",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.17",
            "verseOrgIds": [
              "2KI.1.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.1.17",
                "verseOrgIds": [
                  "2KI.1.17"
                ]
              }
            }
          ]
        },
        {
          "text": "nke Ịlaịja kwuru si dị.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.17",
            "verseOrgIds": [
              "2KI.1.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 1:17"
      },
      "items": [
        {
          "text": "Nʼihi na Ahazaya enweghị nwa nwoke ọbụla, Jehoram",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.17",
            "verseOrgIds": [
              "2KI.1.17"
            ]
          }
        },
        {
          "text": "nọchiri anya ya dịka eze, nʼafọ nke abụọ nke ịbụ eze Jehoram nwa Jehoshafat, bụ eze Juda.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.17",
            "verseOrgIds": [
              "2KI.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akụkọ banyere ịbụ eze nke Ahazaya, na ihe niile o mere, e deghị ha nʼakwụkwọ akụkọ ndị eze Izrel?",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.18",
            "verseOrgIds": [
              "2KI.1.18"
            ]
          }
        }
      ]
    }
  ],
