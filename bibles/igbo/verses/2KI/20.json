              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Aịzaya sịrị Hezekaya, \"Gee ntị nụrụ okwu",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.16",
            "verseOrgIds": [
              "2KI.20.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.20.16",
                "verseOrgIds": [
                  "2KI.20.16"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.16",
            "verseOrgIds": [
              "2KI.20.16"
            ]
          }
        },
        {
          "name": "verse",
