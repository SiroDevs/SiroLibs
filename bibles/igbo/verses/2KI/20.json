          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hezekaya zaghachiri, \"Okwu",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.19",
            "verseOrgIds": [
              "2KI.20.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.20.19",
                "verseOrgIds": [
                  "2KI.20.19"
                ]
              }
            }
          ]
        },
        {
          "text": "nke i kwuru dị mma.\" Nʼihi na o chere nʼobi ya sị, \"Ọ bụ na udo na nchekwa agaghị adị nʼoge ndụ m?\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.19",
            "verseOrgIds": [
              "2KI.20.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 20:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma banyere ihe ndị ọzọ niile mere nʼoge ọchịchị Hezekaya, ọrụ niile ọ rụrụ, tinyere ọdọ mmiri o gwuru, na olulu ọwa mmiri",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.20",
            "verseOrgIds": [
              "2KI.20.20"
            ]
          }
        },
        {
          "text": "na-aga o gwuru, nke o ji webata mmiri nʼime obodo, ọ bụ na e deghị ha nʼakwụkwọ akụkọ ihe mere nʼoge ndị eze Juda?",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.20",
            "verseOrgIds": [
              "2KI.20.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 20:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hezekaya sooro ndị nna nna ya dinaa nʼọnwụ. Manase nwa ya ghọrọ eze nʼọnọdụ ya.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.21",
            "verseOrgIds": [
              "2KI.20.21"
            ]
          }
        }
