  "verseCount": 26,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "21",
        "style": "c",
        "sid": "2KI 21"
      },
      "items": [
        {
          "text": "21",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Manase eze Juda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 21:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Manase gbara afọ iri na abụọ mgbe ọ malitere ịbụ eze. Ọ chịrị iri afọ ise na ise na Jerusalem. Aha nne ya bụ Hefziba.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.1",
            "verseOrgIds": [
              "2KI.21.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "O mere ihe dị njọ nʼanya",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.2",
            "verseOrgIds": [
              "2KI.21.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.21.2",
                "verseOrgIds": [
                  "2KI.21.2"
                ]
              }
            }
          ]
        },
        {
          "text": ", site nʼịgbaso ihe arụ niile nke ndị mba ọzọ bi nʼala ahụ na mbụ mere, bụ ndị",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.2",
            "verseOrgIds": [
              "2KI.21.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.21.2",
                "verseOrgIds": [
                  "2KI.21.2"
                ]
              }
            }
          ]
        },
        {
          "text": "chụpụrụ nʼihu ndị Izrel.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.2",
            "verseOrgIds": [
              "2KI.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "O wugharịrị ebe dị elu niile nke nna ya Hezekaya lara nʼiyi. O wukwara ebe ịchụ aja dị iche iche nye Baal, pịakwa ogidi Ashera, dịka Ehab eze Izrel mere. Ọ kpọrọ isiala nye usuu ihe niile nke dị na mbara eluigwe,",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.3",
            "verseOrgIds": [
              "2KI.21.3"
            ]
          }
        },
        {
          "text": "feekwa ha ofufe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.3",
            "verseOrgIds": [
              "2KI.21.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "O wuru ebe ịchụ aja dị iche iche, nʼime ụlọnsọ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.4",
            "verseOrgIds": [
              "2KI.21.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.21.4",
                "verseOrgIds": [
                  "2KI.21.4"
                ]
              }
            }
          ]
        },
        {
          "text": ", nke",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.4",
            "verseOrgIds": [
              "2KI.21.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.21.4",
                "verseOrgIds": [
                  "2KI.21.4"
                ]
              }
            }
          ]
        },
        {
          "text": ", kwuru okwu banyere ya sị, \"Ọ bụ na Jerusalem ka m ga-etinye Aha m.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.4",
            "verseOrgIds": [
              "2KI.21.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "O wuru ebe ịchụ aja nye usuu ihe niile dị na mbara eluigwe,",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.5",
            "verseOrgIds": [
              "2KI.21.5"
            ]
          }
        },
        {
          "text": "nʼogige abụọ nke nʼụlọnsọ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.5",
            "verseOrgIds": [
              "2KI.21.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.21.5",
                "verseOrgIds": [
                  "2KI.21.5"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.5",
            "verseOrgIds": [
              "2KI.21.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "O jikwa nwa ya nwoke chụọ aja nʼime ọkụ, ọ gbara aja, chọọ ọsịsa nʼaka ndị mgbaasị, jụta ase nʼaka ndị na-ajụ mmụọ ọjọọ ase, ya na ndị dibịa afa mekọkwara ihe. O mere ihe dị njọ nʼebe ọ dị ukwuu nʼanya",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.6",
            "verseOrgIds": [
              "2KI.21.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.21.6",
                "verseOrgIds": [
                  "2KI.21.6"
                ]
              }
            }
          ]
        },
        {
          "text": ", si otu a kpasuo ya iwe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.6",
            "verseOrgIds": [
              "2KI.21.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "O were chi Ashera a pịrị apị, bụ nke o mere, debe nʼime ụlọnsọ ahụ, nke",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.7",
            "verseOrgIds": [
              "2KI.21.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.21.7",
                "verseOrgIds": [
                  "2KI.21.7"
                ]
              }
            }
          ]
        },
        {
          "text": "gwara Devid na nwa ya Solomọn okwu, sị, \"Nʼụlọnsọ a na nʼime Jerusalem, nke mụ onwe m họpụtara site nʼebo niile nke Izrel, ka m ga-akpọkwasị Aha m ruo mgbe ebighị ebi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.7",
            "verseOrgIds": [
              "2KI.21.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma agaghị emekwa ka ụkwụ ndị Izrel wagharịa ọzọ site nʼala ahụ nke m nyere ndị nna nna ha, naanị ma ọ bụrụ na ha elezie anya debe ihe niile m nyere ha nʼiwu ma debekwa iwu niile nke ohu m bụ Mosis nyere ha.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.8",
            "verseOrgIds": [
              "2KI.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ha egeghị ntị, Manase duhiere ha, mee ka ha mee ihe dị njọ karịa nke ndị mba niile ndị",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.9",
            "verseOrgIds": [
              "2KI.21.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.21.9",
                "verseOrgIds": [
                  "2KI.21.9"
                ]
              }
            }
          ]
        },
        {
          "text": "lara nʼiyi site nʼihu ndị Izrel.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.9",
            "verseOrgIds": [
              "2KI.21.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ,",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.10",
            "verseOrgIds": [
              "2KI.21.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.21.10",
                "verseOrgIds": [
                  "2KI.21.10"
                ]
              }
            }
          ]
        },
        {
          "text": "kwuru okwu site nʼọnụ ndị amụma ya, sị,",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.10",
            "verseOrgIds": [
              "2KI.21.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nʼihi na Manase, eze Juda emeela ihe arụ ndị a, o meela ihe dị njọ karịa nke ndị Amọrait,",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.11",
            "verseOrgIds": [
              "2KI.21.11"
            ]
          }
        },
        {
          "text": "bụ ndị bụ ya ụzọ, o werela arụsị ya duba Juda nʼime mmehie.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.11",
            "verseOrgIds": [
              "2KI.21.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, nke a bụ ihe",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.12",
            "verseOrgIds": [
              "2KI.21.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.21.12",
                "verseOrgIds": [
                  "2KI.21.12"
                ]
              }
            }
          ]
        },
        {
          "text": ", bụ Chineke nke Izrel, sịrị: Lee, ana m aga iweta mbibi dị ukwuu nke ga-adakwasị Jerusalem na Juda, nke ntị ọbụla nụrụ ya ga-azụ wuruwuru.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.12",
            "verseOrgIds": [
              "2KI.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aga m esetipụ eriri ịtụ ọtụtụ nke m ji megide Sameria na ihe ịtụ mgbidi nke m ji megide ụlọ Ehab, nʼelu Jerusalem. Aga m ehichapụ Jerusalem dịka mmadụ si ehichapụ efere, hichaa ya ihu na azụ ma kpuo ya ihu nʼala.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.13",
            "verseOrgIds": [
              "2KI.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aga m agbakụtakwa ndị fọdụrụ nʼihe nketa m azụ, were ha nyefee nʼaka ndị iro ha. Ha ga-aghọ ihe anaara nʼike, ghọọkwa ihe nkwata nʼagha nye ndị iro ha niile,",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.14",
            "verseOrgIds": [
              "2KI.21.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "nʼihi na ha emeela ihe dị njọ nʼanya m, kpasukwaa m iwe, site nʼụbọchị nna nna ha si Ijipt pụta ọbụladị ruo taa.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.15",
            "verseOrgIds": [
              "2KI.21.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nke ka nke, Manase gbukwara ọtụtụ ndị aka ha dị ọcha, ruo na ọ wụsaara ọbara ha site nʼotu akụkụ Jerusalem ruo nʼakụkụ nke ọzọ ya, nke a agụnyeghị mmehie ahụ nke o dubara ndị Juda ime, nke mere ka ha mee ihe dị njọ nʼanya",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.16",
            "verseOrgIds": [
              "2KI.21.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.21.16",
                "verseOrgIds": [
                  "2KI.21.16"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.16",
            "verseOrgIds": [
              "2KI.21.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma banyere ihe ndị ọzọ niile mere nʼoge ọchịchị Manase na ihe niile o mere, tinyere mmehie niile nke o mere, ọ bụ na e deghị ha nʼakwụkwọ akụkọ ihe mere nʼoge ndị eze Juda?",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.17",
            "verseOrgIds": [
              "2KI.21.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 21:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Manase soro ndị nna nna ya ha dina nʼọnwụ, e lie ya nʼime ubi a gbara ogige nʼụlọeze ya, bụ ubi Ụza a gbara ogige. Amọn nwa ya ghọrọ eze nʼọnọdụ ya.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.18",
            "verseOrgIds": [
              "2KI.21.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Amọn eze Juda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
