  "verseCount": 27,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
        "style": "c",
        "sid": "2KI 5"
      },
      "items": [
        {
          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Neeman onye ekpenta",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼoge a, Neeman bụ ọchịagha ndị agha eze Aram,",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.1",
            "verseOrgIds": [
              "2KI.5.1"
            ]
          }
        },
        {
          "text": "Ọ bụ onye dị ukwuu nʼanya nna ya ukwu, bụrụkwa onye a na-enye nsọpụrụ nʼihi na",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.1",
            "verseOrgIds": [
              "2KI.5.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.5.1",
                "verseOrgIds": [
                  "2KI.5.1"
                ]
              }
            }
          ]
        },
        {
          "text": "sitere nʼaka ya nye ndị agha Aram mmeri nʼọgbọ agha dị iche iche. Ọ bụ dike na dimkpa nʼagha, maọbụ onye ekpenta.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.1",
            "verseOrgIds": [
              "2KI.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otu mgbe, ụfọdụ nʼime ndị agha Aram na-apụnara ndị mmadụ ihe pụrụ ga dọta otu nwaagbọghọ nta site nʼIzrel, onye na-ejere nwunye Neeman ozi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.2",
            "verseOrgIds": [
              "2KI.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ sịrị nne ya ukwu, \"Ọ gaara atọ m ụtọ ma a sị na nna m ukwu ga-aga hụ onye amụma nọ na Sameria. Ọ ga-agwọ ya ọrịa ekpenta a.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.3",
            "verseOrgIds": [
              "2KI.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neeman nụrụ nke a, bilie gaa kọọrọ eze Aram ihe niile nwaagbọghọ a si Izrel kwuru.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.4",
            "verseOrgIds": [
              "2KI.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eze Aram sịrị, \"Bilie, gaa, aga m ezigakwara eze Izrel",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.5",
            "verseOrgIds": [
              "2KI.5.5"
            ]
          }
        },
        {
          "text": "akwụkwọ ozi.\" Ya mere Neeman gara, ọ chịịrị talenti ọlaọcha iri, na puku shekel ọlaedo isii, na uwe ọma dị iche iche, nke dị iri nʼọnụọgụgụ.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.5",
            "verseOrgIds": [
              "2KI.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nke a bụkwa ihe dị nʼime akwụkwọ ahụ eze Aram degaara eze Izrel: \"Nwoke a ji akwụkwọ a bịakwute gị bụ Neeman, onyeisi ndị agha m. Biko, achọrọ m ka ị gwọọ ya ọrịa ekpenta dị ya nʼahụ.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.6",
            "verseOrgIds": [
              "2KI.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngwangwa eze Izrel gụrụ akwụkwọ ahụ, ọ dọwara uwe ya sị, \"Abụ m Chineke? A pụrụ m ime ka mmadụ nwụọ na ime ka mmadụ dị ndụ? Gịnị mere nwoke a ji ezitere m onye m ga-agwọ ọrịa ekpenta? Lee ka o si na-achọ ụzọ anyị ga-eji nwee esemokwu.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.7",
            "verseOrgIds": [
              "2KI.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Ịlaisha onye Chineke nụrụ na eze Izrel dọwara uwe ya, o ziri ozi a zigara ya sị, \"Gịnị mere i ji dọwaa uwe gị? Zitere m Neeman. Ọ ga-amatakwa na e nwere onye amụma nʼIzrel.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.8",
            "verseOrgIds": [
              "2KI.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, Neeman bịarutere guzo nʼọnụ ụzọ ụlọ Ịlaisha, ya na ịnyịnya ya, na ụgbọ agha ya.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.9",
            "verseOrgIds": [
              "2KI.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ịlaisha zigara onyeozi ya nke bịara zie sị ya, \"Jee saa ahụ gị ugboro asaa nʼosimiri Jọdan. I mee nke a, ekpenta ahụ ga-esi nʼakụkụ ahụ gị niile pụọ. Ị ga-adịkwa ọcha.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.10",
            "verseOrgIds": [
              "2KI.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Neeman were iwe nke ukwuu tụgharịa bido ịlaghachi ebe o si bịa. Mgbe ọ na-ala, ọ na-ekwu na-asị, \"Echere m na ọ ga-apụkwute m, guzo, kpọkuo aha",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.11",
            "verseOrgIds": [
              "2KI.5.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.5.11",
                "verseOrgIds": [
                  "2KI.5.11"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke ya, fufee aka ya nʼebe ahụ ọrịa m dị, gwọọ m ọrịa ekpenta m.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.11",
            "verseOrgIds": [
              "2KI.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abana",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.12",
            "verseOrgIds": [
              "2KI.5.12"
            ]
          }
        },
        {
          "text": "na Fapa, bụ osimiri dị na Damaskọs, ha adịghị mma karịa mmiri Izrel niile? Ọ bụ na m enweghị ike ịsa ahụ nʼime ha ma dị ọcha.\" Ọ tụgharịrị jiri ọnụma pụọ.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.12",
            "verseOrgIds": [
              "2KI.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ndị ozi Neeman jekwuru ya sị ya, \"Nna anyị, a sị na ọ bụ ihe sịrị ike nke ukwuu ka onye amụma ahụ gwara gị sị gị mee, ị garaghị eme ya? Ma ihe ọ sị gị mee bụ naanị 'Gaa saa ahụ gị ka ị dị ọcha.' \"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.13",
            "verseOrgIds": [
              "2KI.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, ọ gara sụnye onwe ya nʼime osimiri Jọdan ugboro asaa, dịka onye nke Chineke gwara ya. Anụ ahụ ya lọghachiri dị ọcha ka anụ ahụ nwantakịrị.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.14",
            "verseOrgIds": [
              "2KI.5.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Neeman na ndị niile ya na ha so laghachikwutere onye nke Chineke. O guzoro nʼihu ya sị, \"Ugbu a amatala m na ọ dịghị Chineke ọzọ dị nʼụwa niile ma ọ bụghị naanị nʼIzrel. Ya mere, biko, nara onyinye a site nʼaka ohu gị.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.15",
            "verseOrgIds": [
              "2KI.5.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Ịlaisha zara sị ya, \"Dịka",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.16",
            "verseOrgIds": [
              "2KI.5.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.5.16",
                "verseOrgIds": [
                  "2KI.5.16"
                ]
              }
            }
          ]
        },
        {
          "text": "na-adị ndụ, bụ onye m na-ejere ozi, agaghị m ana gị ihe ọbụla.\" Ma Neeman rịọrọ ya arịrịọ ka ọ nara ya, ma ọ jụrụ ajụ.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.16",
            "verseOrgIds": [
              "2KI.5.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ Neeman sịrị, \"Ọ bụrụ na ị gaghị anara, biko, kwerenụ ka m kporo aja nke ịnyịnya abụọ nwere ike ibu. Nʼihi na site ugbu a gaa nʼihu, agaghị m achụrụ chi ọzọ aja nsure ọkụ, ma ọ bụghị naanị",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.17",
            "verseOrgIds": [
              "2KI.5.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.5.17",
                "verseOrgIds": [
                  "2KI.5.17"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.17",
            "verseOrgIds": [
              "2KI.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ka",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.18",
            "verseOrgIds": [
              "2KI.5.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.5.18",
                "verseOrgIds": [
                  "2KI.5.18"
                ]
              }
            }
          ]
        },
        {
          "text": "gbaghara ohu gị naanị otu ihe a. Mgbe nna m ukwu banyere nʼụlọ arụsị Rimọn ịkpọ isiala, mgbe ọ na-adabere nʼaka m, nke ga-eme ka mụ onwe m kpọọkwa isiala. Mgbe m si otu a kpọọ isiala nʼụlọ arụsị Rimọn, ka",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.18",
            "verseOrgIds": [
              "2KI.5.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.5.18",
                "verseOrgIds": [
                  "2KI.5.18"
                ]
              }
            }
          ]
        },
        {
          "text": "gbaghara ohu gị nʼihi nke a.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.18",
            "verseOrgIds": [
              "2KI.5.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ịlaisha zara sị ya, \"Ọ dị mma, laa nʼudo.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.19",
            "verseOrgIds": [
              "2KI.5.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 5:19"
      },
      "items": [
        {
          "text": "Mgbe Neeman lawara, o jerubeghị ebe dị anya,",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.19",
            "verseOrgIds": [
              "2KI.5.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gehazi, bụ onyeozi Ịlaisha onye nke Chineke, sịrị nʼobi ya, \"Nna m ukwu emezighị ikwere ka Neeman onye Aram laa na-anataghị ya ihe o ji bịa. Dịka",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.20",
            "verseOrgIds": [
              "2KI.5.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.5.20",
                "verseOrgIds": [
                  "2KI.5.20"
                ]
              }
            }
          ]
        },
        {
          "text": "na-adị ndụ, aga m eji ọsọ gbakwuru ya napụta ya ụfọdụ ihe ahụ.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.20",
            "verseOrgIds": [
              "2KI.5.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, Gehazi gbara ọsọ gbakwuru Neeman. Mgbe Neeman hụrụ ya ka ọ gba ọsọ na-abịa, o si nʼelu ụgbọ agha ya wudata gaa zute ya, jụọ ya sị: \"Udo ọ dịkwa?\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.21",
            "verseOrgIds": [
              "2KI.5.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 5:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"E, udo dị,\" ka Gehazi zara, \"Onyenwe m zitere m ka m gwa gị, 'Lee, ụmụ okorobịa abụọ nʼetiti ndị amụma si nʼugwu Ifrem bịakwute m. Biko nye ha otu talenti ọlaọcha na uwe mgbanwe abụọ.' \"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.22",
            "verseOrgIds": [
              "2KI.5.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 5:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Neeman zara sị ya, \"Biko, were talenti abụọ.\" Ọ kwagidere Gehazi ka ọ nara ha. O kechiri talenti ọlaọcha abụọ ahụ nʼakpa abụọ, tinyere uwe mgbanwe abụọ. O bunyere ndị ohu ya ka ha buru ya na-aga nʼihu Gehazi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.23",
            "verseOrgIds": [
              "2KI.5.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2KI 5:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma mgbe ha rutere nʼugwu, Gehazi naara ndị ohu Neeman ihe ndị ahụ, sị ha laghachikwa. O zoro ihe ndị ahụ nʼime ụlọ.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.24",
            "verseOrgIds": [
              "2KI.5.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 5:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ọ batara nʼụlọ guzo nʼihu nna ya ukwu, Ịlaisha jụrụ ya sị, \"Ebee ka i si na-abịa Gehazi?\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.25",
            "verseOrgIds": [
              "2KI.5.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 5:25"
      },
      "items": [
        {
          "text": "Ọ zara, \"Ohu gị ejeghị ebe ọbụla.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.25",
            "verseOrgIds": [
              "2KI.5.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 5:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ Ịlaisha zara ya, \"Ọ bụ na mmụọ m esoghị gị mgbe nwoke ahụ si nʼụgbọ ya rịdata izute gị? Oge a ọ bụ oge ịnara ego, na ịnara uwe, na ịnara ubi oliv, na ubi vaịnị, na igwe ehi, na igwe atụrụ, na ndị ohu ndị ikom, na ndị ohu ndị inyom na-eje ozi?",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.26",
            "verseOrgIds": [
              "2KI.5.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 5:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi nke a, ekpenta ahụ dị Neeman ga-abịakwasị gị, na ụmụ ụmụ gị, ruo mgbe ebighị ebi.\" Ya mere, Gehazi ghọrọ onye ekpenta si nʼihu ya pụọ. Anụ ahụ ya bidokwara ịcha ọcha dịka ogho ọcha.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.27",
            "verseOrgIds": [
              "2KI.5.27"
            ]
          }
        }
      ]
    }
  ],
