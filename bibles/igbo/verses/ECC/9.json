          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okwu nke onye maara ihe na-ekwu na nwayọọ ka a na-anụ,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.17",
            "verseOrgIds": [
              "ECC.9.17"
            ]
          }
        }
      ]
