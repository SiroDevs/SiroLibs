      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 9:17"
      },
      "items": [
        {
          "text": "karịa iti mkpu nke onye na-achị achị nʼetiti ndị nzuzu.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.17",
            "verseOrgIds": [
