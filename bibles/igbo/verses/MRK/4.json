  "verseCount": 41,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "MRK 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ilu banyere ọgha mkpụrụ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MRK 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼoge ọzọ, ọ malitere izi ihe nʼakụkụ osimiri. Igwe mmadụ dị ukwuu gbara ya gburugburu, nke mere na ọ banyere nʼime ụgbọ nọdụ ala nʼime ya nʼelu mmiri ahụ, ma igwe mmadụ ahụ nọkwa nʼakụkụ osimiri ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.1",
            "verseOrgIds": [
              "MRK.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MRK 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "O bidoro i kuziri ha ọtụtụ ihe nʼilu, ma nʼozizi ya, ọ sịrị ha,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.2",
            "verseOrgIds": [
              "MRK.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MRK 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Geenụ ntị! Otu onye ọrụ ubi pụrụ gaa ịkụ mkpụrụ ya.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.3",
                "verseOrgIds": [
                  "MRK.4.3"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.3",
            "verseOrgIds": [
              "MRK.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MRK 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mgbe ọ na-agha mkpụrụ, ụfọdụ mkpụrụ dara nʼakụkụ ụzọ, ụmụ nnụnụ bịara tụtụrịa ha.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.4",
                "verseOrgIds": [
                  "MRK.4.4"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.4",
            "verseOrgIds": [
              "MRK.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MRK 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ụfọdụ mkpụrụ dara nʼala nkume, ebe aja ntakịrị dị. Ha puputara ngwangwa nʼihi na ala dị nʼebe ahụ emighị emi.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.5",
                "verseOrgIds": [
                  "MRK.4.5"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.5",
            "verseOrgIds": [
              "MRK.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MRK 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ma mgbe anwụ wara, ọ chagburu ha, ha kpọnwụọ nʼihi na ha enweghị mgbọrọgwụ.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.6",
                "verseOrgIds": [
                  "MRK.4.6"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.6",
            "verseOrgIds": [
              "MRK.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MRK 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mkpụrụ ndị ọzọ dara nʼetiti ogwu; ogwu ahụ tolitere kpagbuo ha. Ha amịkwaghị mkpụrụ.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.7",
                "verseOrgIds": [
                  "MRK.4.7"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.7",
            "verseOrgIds": [
              "MRK.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MRK 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mkpụrụ ndị ọzọ nke dara nʼezi ala, puru, tolite, ma mịa mkpụrụ na mmụba iri atọ, iri isii, ọ bụladị otu narị.\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.8",
                "verseOrgIds": [
                  "MRK.4.8"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MRK 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ sịrị ha,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.9",
            "verseOrgIds": [
              "MRK.4.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Onye ọbụla nwere ntị ịnụ ihe, ya nụrụ.\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.9",
                "verseOrgIds": [
                  "MRK.4.9"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MRK 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma mgbe ọ nọ naanị ya, ndị ozi iri na abụọ ahụ na ndị ọzọ nọ ya gburugburu jụrụ ya ajụjụ banyere ilu ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.10",
            "verseOrgIds": [
              "MRK.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MRK 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ gwara ha sị,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.11",
            "verseOrgIds": [
              "MRK.4.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Enyela unu ihe omimi nke alaeze Chineke. Ma ndị nọ nʼezi, a na-agwa ha ihe niile nʼilu,",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.11",
                "verseOrgIds": [
                  "MRK.4.11"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.11",
            "verseOrgIds": [
              "MRK.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MRK 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "nke mere na,",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.12",
                "verseOrgIds": [
                  "MRK.4.12"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MRK 4:12"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\" 'Ha ga na-ele anya, hụkwa, ma ha agaghị ahụ ihe ọbụla,",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.12",
                "verseOrgIds": [
                  "MRK.4.12"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MRK 4:12"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "ha ga na-anụ, nụkwa, ma ha agaghị aghọta ihe ọbụla,",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.12",
                "verseOrgIds": [
                  "MRK.4.12"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MRK 4:12"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "ma ọ bụghị ya, ha nwere ike chigharịa bụrụ ndị a gbaghaara.'",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.12",
                "verseOrgIds": [
                  "MRK.4.12"
                ]
              }
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.12",
                "verseOrgIds": [
                  "MRK.4.12"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MRK 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, ọ jụrụ ha sị,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.13",
            "verseOrgIds": [
              "MRK.4.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ọ bụ na unu aghọtaghị ilu a? Unu ga-esikwa aṅaa ghọta ilu ndị ọzọ?",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.13",
                "verseOrgIds": [
                  "MRK.4.13"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.13",
            "verseOrgIds": [
              "MRK.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MRK 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ọgha mkpụrụ ahụ na-agha okwu Chineke.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.14",
                "verseOrgIds": [
                  "MRK.4.14"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.14",
            "verseOrgIds": [
              "MRK.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MRK 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mmadụ ụfọdụ dị ka mkpụrụ ndị ahụ dara nʼakụkụ ụzọ, ebe a kụrụ okwu ahụ. Ngwangwa ha nụrụ ya, ekwensu na-abịa napụ ha okwu ahụ nke a kụrụ nʼime ha.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.15",
                "verseOrgIds": [
                  "MRK.4.15"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.15",
            "verseOrgIds": [
              "MRK.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MRK 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ndị ọzọ dị ka mkpụrụ a kụrụ nʼala nkume. Ha nụrụ okwu ahụ, were ọṅụ nabata ya nʼotu mgbe ahụ.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.16",
                "verseOrgIds": [
                  "MRK.4.16"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.16",
            "verseOrgIds": [
              "MRK.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MRK 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ma ebe ha na-enweghị mgbọrọgwụ nʼime ha, ha na-anọ nwa oge nta. Mgbe nsogbu maọbụ mkpagbu bịara nʼihi okwu ahụ, ngwangwa ha na-adachapụ.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.17",
                "verseOrgIds": [
                  "MRK.4.17"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.17",
            "verseOrgIds": [
              "MRK.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MRK 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ndị nke ọzọkwa, dị ka mkpụrụ dara nʼetiti ogwu, nụrụ okwu ahụ;",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.18",
                "verseOrgIds": [
                  "MRK.4.18"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.18",
            "verseOrgIds": [
              "MRK.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MRK 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "ma nchekasị nke ndụ a,",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.19",
                "verseOrgIds": [
                  "MRK.4.19"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.19",
            "verseOrgIds": [
              "MRK.4.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "na nghọgbu nke akụnụba, na oke ọchịchọ, nakwa ihe ndị ọzọ na-abata, kpagbuo okwu ahụ, mee ka ọ ghara ịmị mkpụrụ.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.19",
                "verseOrgIds": [
                  "MRK.4.19"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.19",
            "verseOrgIds": [
              "MRK.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MRK 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ndị ọzọ, dị ka mkpụrụ a kụrụ nʼezi ala, nụrụ okwu ahụ, nabata ya ma mịa mkpụrụ dị iri atọ, iri isii, maọbụ otu narị.\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.20",
                "verseOrgIds": [
                  "MRK.4.20"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Iheọkụ dị nʼelu tebul",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MRK 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ sịrị ha,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.21",
            "verseOrgIds": [
              "MRK.4.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"A na-ebute oriọna ka e jiri efere kpuchie ya maọbụ dọnye ya nʼokpuru akwa ndina? Ọ bụghị ka a dọba ya nʼelu ihe ịdọba iheọkụ?",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.21",
                "verseOrgIds": [
                  "MRK.4.21"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.21",
            "verseOrgIds": [
              "MRK.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MRK 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nʼihi na ihe niile e zoro ezo ga-apụta ihe ma ihe niile e kpuchiri ekpuchi ka a ga-emesịa kpughee.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.22",
                "verseOrgIds": [
                  "MRK.4.22"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.22",
            "verseOrgIds": [
              "MRK.4.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MRK 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Onye ọbụla nwere ntị ịnụ ihe, ya nụrụ.\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.23",
                "verseOrgIds": [
                  "MRK.4.23"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MRK 4:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ sịrị ha,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.24",
            "verseOrgIds": [
              "MRK.4.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kpacharanụ anya ihe unu na-anụ. Ọ bụkwa ihe unu ji tụọrọ ndị ọzọ ka a ga-eji tụọrọ unu, maọbụ karịa.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.24",
                "verseOrgIds": [
                  "MRK.4.24"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.24",
            "verseOrgIds": [
              "MRK.4.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MRK 4:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Onye nwere ihe ka a ga-enye karịa; onye na-enweghị, ọ bụladị nke o nwere ka a ga-anapụ ya.\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.25",
                "verseOrgIds": [
                  "MRK.4.25"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ilu banyere otu mkpụrụ si eto",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MRK 4:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ sịkwara,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.26",
            "verseOrgIds": [
              "MRK.4.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Alaeze Chineke yiri ihe dị otu a. Ọ dịka mgbe otu onye ghara mkpụrụ nʼala ubi.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.26",
                "verseOrgIds": [
                  "MRK.4.26"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.26",
            "verseOrgIds": [
              "MRK.4.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MRK 4:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ehihie na abalị, ma ọ nọ nʼụra ma o tetara, mkpụrụ ahụ na-epupụte na-etokwa, ma ọ maghị ka o si na-eme.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.27",
                "verseOrgIds": [
                  "MRK.4.27"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.27",
            "verseOrgIds": [
              "MRK.4.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MRK 4:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ala ahụ nʼonwe ya na-eme ka mkpụrụ ahụ puo. Ọ na-epupụte na mbụ, too oko, emesịa isi ọka, nʼikpeazụ ọ mịkwara mkpụrụ kara aka nʼoko ya.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.28",
                "verseOrgIds": [
                  "MRK.4.28"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.28",
            "verseOrgIds": [
              "MRK.4.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MRK 4:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mgbe ọka ahụ chara ịghọ ya, o na-eji mma iwe ihe ubi ya bịa gbutuo ọka ahụ, ghọrọkwa ogbe ọka laa, nʼihi na oge iwe ihe nʼubi eruola.\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.29",
                "verseOrgIds": [
                  "MRK.4.29"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ilu banyere mkpụrụ Mọstaadị",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MRK 4:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọzọkwa, ọ sịrị,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.30",
            "verseOrgIds": [
              "MRK.4.30"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Gịnị ọzọ ka anyị pụrụ ịsị na alaeze Chineke yiri? Ụdị ilu dị aṅaa ka anyị ga-eji kọwaa ya?",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.30",
                "verseOrgIds": [
                  "MRK.4.30"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.30",
            "verseOrgIds": [
              "MRK.4.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MRK 4:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ọ dị ka mkpụrụ mọstaadị, nke bụ mkpụrụ dịkarịsịrị nta nke a na-akụ nʼala.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.31",
                "verseOrgIds": [
                  "MRK.4.31"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.31",
            "verseOrgIds": [
              "MRK.4.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MRK 4:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ma mgbe a kụrụ ya, ọ na-eto bukarịa ihe niile a kụrụ nʼubi, ọ na-enwe alaka dị ukwuu nke bụ na ụmụ anụ ufe nke eluigwe na-ezukwa ike nʼokpuru ya.\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.32",
                "verseOrgIds": [
                  "MRK.4.32"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MRK 4:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "O jiri ọtụtụ ilu yiri ndị a gwa ha okwu dị ka ha pụrụ ịghọta.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.33",
            "verseOrgIds": [
              "MRK.4.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MRK 4:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "O nweghị oge ọbụla ọ gwara ha okwu hapụ iji ilu. Ma ya na ndị na-eso ụzọ ya naanị nọdụ, ọ na-akọwara ha ihe niile.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.34",
            "verseOrgIds": [
              "MRK.4.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jisọs emee ka ifufe kwụsị",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MRK 4:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼụbọchị ahụ nʼoge uhuruchi, ọ gwara ndị na-eso ụzọ ya sị,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.35",
            "verseOrgIds": [
              "MRK.4.35"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ka anyị gafee nʼofe nke ọzọ.\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.35",
                "verseOrgIds": [
                  "MRK.4.35"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.35",
            "verseOrgIds": [
              "MRK.4.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MRK 4:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha hapụrụ igwe mmadụ ahụ ma kpọrọ ya, otu ọ dị, ya na ha banyere nʼime ụgbọ. Ụgbọ ndị ọzọ dịkwa na-eso ya.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.36",
            "verseOrgIds": [
              "MRK.4.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MRK 4:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oke ifufe dị ike bidoro ife, ebili mmiri na-awụbakwa nʼụgbọ ahụ ruo na ụgbọ ha fọdụrụ ntakịrị ka mmiri mie ya.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.37",
            "verseOrgIds": [
              "MRK.4.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MRK 4:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Jisọs nọ nʼazụ azụ ụgbọ ahụ na-arahụ ụra nʼelu ohiri isi. Ndị na-eso ụzọ ya kpọtere ya sị ya, \"Onye ozizi, o metụghị gị nʼobi na anyị nʼala nʼiyi?\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.38",
            "verseOrgIds": [
              "MRK.4.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "MRK 4:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ biliri ọtọ, baara ifufe ahụ mba sịkwa osimiri ahụ,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.39",
            "verseOrgIds": [
              "MRK.4.39"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kwụsị! Dere jii!\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.39",
                "verseOrgIds": [
                  "MRK.4.39"
                ]
              }
            }
          ]
        },
        {
          "text": "Ifufe ahụ kwụsịrị, ebe niile dajụrụ deere jii.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.39",
            "verseOrgIds": [
              "MRK.4.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
