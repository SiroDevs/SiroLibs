  "verseCount": 28,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
        "style": "c",
        "sid": "MRK 2"
      },
      "items": [
        {
          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jisọs agwọọ onye ahụ ya kpọnwụrụ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MRK 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ụbọchị ole na ole gafesịrị, ọ bataghachiri na Kapanọm. Ndị mmadụ nụrụ na ọ lọghachila.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.1",
            "verseOrgIds": [
              "MRK.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MRK 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igwe mmadụ zukọtara nʼime ụlọ ahụ nke mere na ohere afọdụghị ọ bụladị nʼọnụ ụzọ. O kwusakwaara ha oziọma.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.2",
            "verseOrgIds": [
              "MRK.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MRK 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị ikom ụfọdụ buteere ya otu nwoke ahụ ya kpọnwụrụ akpọnwụ. Ọ bụ mmadụ anọ bu ya.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.3",
            "verseOrgIds": [
              "MRK.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MRK 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebe ha na-enweghị ike ibutere ya Jisọs nʼihi igwe mmadụ, ha gwupuru oghere nʼelu ụlọ ebe ahụ ọ nọ. Mgbe ha gwupusiri ya, ha budatara onye ahụ ahụ ya kpọnwụrụ akpọnwụ nʼute o jiri dina.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.4",
            "verseOrgIds": [
              "MRK.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MRK 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Jisọs hụrụ okwukwe ha, ọ sịrị onye ahụ ahụ ya kpọnwụrụ akpọnwụ,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.5",
            "verseOrgIds": [
              "MRK.2.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Nwa m nwoke, agbagharala gị mmehie gị.\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.2.5",
                "verseOrgIds": [
                  "MRK.2.5"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MRK 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ụfọdụ ndị ozizi iwu nọdụrụ ala nʼebe ahụ na-eche nʼime obi ha sị,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.6",
            "verseOrgIds": [
              "MRK.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MRK 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Gịnị mere onye a ji na-ekwulu Chineke? Onye pụrụ ịgbaghara mmehie ma ọ bụghị naanị Chineke?\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.7",
            "verseOrgIds": [
              "MRK.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MRK 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngwangwa Jisọs matara nʼime mmụọ ya na ha na-atule okwu a nʼime obi ha. Ọ sịrị ha,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.8",
            "verseOrgIds": [
              "MRK.2.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Gịnị mere unu ji na-eche ihe dị otu a nʼobi unu?",
              "type": "text",
              "attrs": {
                "verseId": "MRK.2.8",
                "verseOrgIds": [
                  "MRK.2.8"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.8",
            "verseOrgIds": [
              "MRK.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MRK 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Olee nke ka mfe: ọ bụ ịgwa onye a akụkụ ahụ ya kpọnwụrụ akpọnwụ, 'A gbagharala gị mmehie gị niile,' ka ọ bụ i sị, 'Bilie chịrị ute gị jegharịa?'",
              "type": "text",
              "attrs": {
                "verseId": "MRK.2.9",
                "verseOrgIds": [
                  "MRK.2.9"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.9",
            "verseOrgIds": [
              "MRK.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MRK 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ma igosi unu na Nwa nke Mmadụ nwere ikike nʼụwa ịgbaghara mmehie.\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.2.10",
                "verseOrgIds": [
                  "MRK.2.10"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọ sịrị onye ahụ akụkụ ahụ ya kpọnwụrụ akpọnwụ,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.10",
            "verseOrgIds": [
              "MRK.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MRK 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ana m asị gị, bilie, chịrị ute gị laa nʼụlọ gị.\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.2.11",
                "verseOrgIds": [
                  "MRK.2.11"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.11",
            "verseOrgIds": [
              "MRK.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MRK 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "O biliri, chịrị ute ya pụọ nʼihu mmadụ niile. Nke a juru ndị niile nọ nʼebe ahụ anya. Ha toro Chineke na-asị, \"Anyị ahụbeghị ihe dị otu a mbụ!\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.12",
            "verseOrgIds": [
              "MRK.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ọkpụkpọ Livayị",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MRK 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emesịa, Jisọs pụrụ gaa nʼakụkụ osimiri ahụ. Igwe mmadụ bịakwutere ya. Ọ malitere izi ha ihe.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.13",
            "verseOrgIds": [
              "MRK.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MRK 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ọ na-aga nʼihu, ọ hụrụ Livayị nwa Alfiọs ka ọ nọdụrụ ala nʼụlọ ịnakọta ụtụ. Ọ sịrị ya,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.14",
            "verseOrgIds": [
              "MRK.2.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Soro m,\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.2.14",
                "verseOrgIds": [
                  "MRK.2.14"
                ]
              }
            }
          ]
        },
        {
          "text": "o biliri sooro ya.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.14",
            "verseOrgIds": [
              "MRK.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MRK 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ọ na-eri nri uhuruchi nʼụlọ Livayị, ọtụtụ ndị ọna ụtụ na ndị mmehie soro ya na ndị na-eso ụzọ ya nọrọ ebe ahụ, nʼihi na ndị na-esogharị ya dị ọtụtụ.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.15",
            "verseOrgIds": [
              "MRK.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MRK 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ndị ozizi iwu nke ndị Farisii hụrụ ya ka o so ndị mmehie na ndị ọna ụtụ na-eri nri, ha jụrụ ndị na-eso ụzọ ya sị, \"Gịnị mere o ji eso ndị mmehie na ndị ọna ụtụ na-erikọ nri?\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.16",
            "verseOrgIds": [
              "MRK.2.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MRK 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ọ nụrụ nke a, Jisọs sịrị ha,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.17",
            "verseOrgIds": [
              "MRK.2.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mkpa dibịa adịghị akpa ndị ahụ dị ike, kama ọ bụ ndị ahụ na-esighị ike. Abịaghị m ịkpọ ndị ezi omume kama ndị mmehie.\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.2.17",
                "verseOrgIds": [
                  "MRK.2.17"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ajụjụ banyere ibu ọnụ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MRK 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼoge a, ndị na-eso ụzọ Jọn na ndị Farisii na-ebu ọnụ. Ndị mmadụ bịara jụọ ya sị, \"Gịnị mere ndị na-eso ụzọ Jọn na ndị na-eso ụzọ ndị Farisii ji ebu ọnụ, ma ndị nke gị adịghị ebu ọnụ?\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.18",
            "verseOrgIds": [
              "MRK.2.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MRK 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jisọs sịrị ha,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.19",
            "verseOrgIds": [
              "MRK.2.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"O kwesiri na ndị a kpọrọ oriri ọlụlụ di na nwunye ga-ebu ọnụ mgbe onye na-alụ nwunye ọhụrụ nọ nʼetiti ha? Ha apụghị ibu ọnụ ogologo oge ya na ha nọ.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.2.19",
                "verseOrgIds": [
                  "MRK.2.19"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.19",
            "verseOrgIds": [
              "MRK.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MRK 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ma oge na-abịa mgbe a ga-ewepụ onye na-alụ nwunye ọhụrụ. Nʼụbọchị ahụ ka ha ga-ebu ọnụ.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.2.20",
                "verseOrgIds": [
                  "MRK.2.20"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MRK 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ọ dịghị onye na-eji akwa ọhụrụ kwachie ebe akwa ochie siri dọkaa. Ọ bụrụ na o mee nke a, akwa ọhụrụ ahụ ga-adọkapụ site na nke ochie mee ka ndọka ya dị njọ karịa.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.2.21",
                "verseOrgIds": [
                  "MRK.2.21"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.21",
            "verseOrgIds": [
              "MRK.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MRK 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ọ dịghị onye na-agbanye mmanya ọhụrụ na karama akpụkpọ ochie. O mee nke a, mmanya ahụ ga-agbawa karama akpụkpọ ochie ahụ, mee ka karama na mmanya laa nʼiyi. Ee, a na-agbanye mmanya ọhụrụ nʼime karama akpụkpọ ọhụrụ.\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.2.22",
                "verseOrgIds": [
                  "MRK.2.22"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Onyenwe ụbọchị izuike",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MRK 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otu ụbọchị izuike, ya na ndị na-eso ụzọ ya na-agafe nʼubi a kụrụ ọka. Dị ka ha na-agafe, ndị na-eso ụzọ ya malitere ịghọ ụfọdụ ogbe ọka nʼime ọka ndị ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.23",
            "verseOrgIds": [
              "MRK.2.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MRK 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị Farisii siri ya, \"Lee, gịnị mere ha ji na-eme ihe megidere iwu nʼụbọchị izuike.\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.24",
            "verseOrgIds": [
              "MRK.2.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MRK 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ọ sịrị ha,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.25",
            "verseOrgIds": [
              "MRK.2.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Unu agụtaghị ihe Devid na ndị so ya mere mgbe agụụ gụrụ ha?",
              "type": "text",
              "attrs": {
                "verseId": "MRK.2.25",
                "verseOrgIds": [
                  "MRK.2.25"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.25",
            "verseOrgIds": [
              "MRK.2.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MRK 2:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nʼoge Abịata bụ onyeisi nchụaja, ọ banyere nʼụlọ Chineke taa achịcha e chere nʼihu ya, nke ziri ezi na ọ bụ naanị ndị nchụaja kwesiri ịta ya. O nyetụkwara ndị ya na ha so.\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.2.26",
                "verseOrgIds": [
                  "MRK.2.26"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MRK 2:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, ọ gwakwara ha sị,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.27",
            "verseOrgIds": [
              "MRK.2.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"E mere ụbọchị izuike maka mmadụ, emeghị mmadụ maka ụbọchị izuike.\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.2.27",
                "verseOrgIds": [
                  "MRK.2.27"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.27",
            "verseOrgIds": [
              "MRK.2.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MRK 2:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ya mere, Nwa nke Mmadụ bụ Onyenwe ọ bụladị ụbọchị izuike.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.2.28",
                "verseOrgIds": [
                  "MRK.2.28"
                ]
              }
            }
          ]
        }
      ]
    }
