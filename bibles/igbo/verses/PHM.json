{
  "PHM.1": {
    "id": "PHM.1",
    "number": "1",
    "bookId": "PHM",
    "reference": "Fịlịmọn 1",
    "copyright": "Biblica® Open Igbo Contemporary Bible™ Copyright © 1980, 1988, 2019, 2020 by Biblica, Inc. Used with permission. All rights reserved worldwide.",
    "verseCount": 25,
    "content": [
      {
        "name": "chapter",
        "type": "tag",
        "attrs": {
          "number": "1",
          "style": "c",
          "sid": "PHM 1"
        },
        "items": [
          {
            "text": "1",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "1",
              "style": "v",
              "sid": "PHM 1:1"
            },
            "items": [
              {
                "text": "1",
                "type": "text"
              }
            ]
          },
          {
            "text": "Pọl, onye e tinyere nʼụlọ mkpọrọ nʼihi Kraịst Jisọs na site nʼaka nwanna anyị Timoti,",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.1",
              "verseOrgIds": [
                "PHM.1.1"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "b",
          "vid": "PHM 1:1"
        },
        "items": []
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p",
          "vid": "PHM 1:1"
        },
        "items": [
          {
            "text": "Anyị na-edetara gị ya ezi enyi anyị na onye anyị na ya na-arụkọ ọrụ, Fịlịmọn.",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.1",
              "verseOrgIds": [
                "PHM.1.1"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "2",
              "style": "v",
              "sid": "PHM 1:2"
            },
            "items": [
              {
                "text": "2",
                "type": "text"
              }
            ]
          },
          {
            "text": "Anyị na-edetakwara ya nzukọ Kraịst dị nʼụlọ gị, na nwanna anyị nwanyị Afịa, na Akipos onye anyị na ya so na-alụ agha a.",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.2",
              "verseOrgIds": [
                "PHM.1.2"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "b"
        },
        "items": []
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "3",
              "style": "v",
              "sid": "PHM 1:3"
            },
            "items": [
              {
                "text": "3",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ka amara na udo nke sitere na Chineke bụ Nna, na Kraịst Jisọs Onyenwe anyị dịrị unu.",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.3",
              "verseOrgIds": [
                "PHM.1.3"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "b"
        },
        "items": []
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "s1"
        },
        "items": [
          {
            "text": "Ekele na ekpere",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "4",
              "style": "v",
              "sid": "PHM 1:4"
            },
            "items": [
              {
                "text": "4",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ana m ekele Chineke ekele mgbe ọbụla m na-echeta gị nʼekpere niile m na-ekpe.",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.4",
              "verseOrgIds": [
                "PHM.1.4"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "5",
              "style": "v",
              "sid": "PHM 1:5"
            },
            "items": [
              {
                "text": "5",
                "type": "text"
              }
            ]
          },
          {
            "text": "Nʼihi na ana m anụ ihe banyere okwukwe i nwere nʼime Onyenwe anyị Jisọs, na ịhụnanya i na-egosi ndị nsọ niile.",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.5",
              "verseOrgIds": [
                "PHM.1.5"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "6",
              "style": "v",
              "sid": "PHM 1:6"
            },
            "items": [
              {
                "text": "6",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ekpere m na-ekpe banyere gị bụ ka mmekọrịta anyị na gị dịka ndị kwere ekwe, mee ka ị matazuo ihe ọma niile anyị nwere nʼime Kraịst.",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.6",
              "verseOrgIds": [
                "PHM.1.6"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "7",
              "style": "v",
              "sid": "PHM 1:7"
            },
            "items": [
              {
                "text": "7",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ịhụnanya gị na-enye m oke ọṅụ na ịgbaume, ezi nwanna m, nʼihi na emeela ka ndị nsọ nwee ume ọhụrụ site nʼinyeaka gị.",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.7",
              "verseOrgIds": [
                "PHM.1.7"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "s1"
        },
        "items": [
          {
            "text": "Arịrịọ Pọl nʼisi Onisimọs",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "8",
              "style": "v",
              "sid": "PHM 1:8"
            },
            "items": [
              {
                "text": "8",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ọ bụ ezie na-enwere m ike nʼime Kraịst inye gị iwu banyere ihe kwesiri ka i mee, ma agaghị m eme otu a.",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.8",
              "verseOrgIds": [
                "PHM.1.8"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "9",
              "style": "v",
              "sid": "PHM 1:9"
            },
            "items": [
              {
                "text": "9",
                "type": "text"
              }
            ]
          },
          {
            "text": "Kama, ọ kaara m mma site na ndabere nke ịhụnanya, ịrịọ gị ya dị ka arịrịọ. Ee, ọ bụ mụ Pọl, agadi nwoke ahụ na onye mkpọrọ nʼihi Kraịst Jisọs na-arịọ gị arịrịọ a.",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.9",
              "verseOrgIds": [
                "PHM.1.9"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "10",
              "style": "v",
              "sid": "PHM 1:10"
            },
            "items": [
              {
                "text": "10",
                "type": "text"
              }
            ]
          },
          {
            "text": "Biko, arịọ m gị nʼisi Onisimọs, onye e mere ka ọ bụrụ nwa m oge m nọ nʼụlọ mkpọrọ.",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.10",
              "verseOrgIds": [
                "PHM.1.10"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "11",
              "style": "v",
              "sid": "PHM 1:11"
            },
            "items": [
              {
                "text": "11",
                "type": "text"
              }
            ]
          },
          {
            "text": "Na mbụ, o nweghị uru ọbụla ọ baara gị, ma ugbu a, ọ baara mụ na gị uru.",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.11",
              "verseOrgIds": [
                "PHM.1.11"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "12",
              "style": "v",
              "sid": "PHM 1:12"
            },
            "items": [
              {
                "text": "12",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ana m ezighachiri gị ya ugbu a, ya bụ, onye bụ obi",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.12",
              "verseOrgIds": [
                "PHM.1.12"
              ]
            }
          },
          {
            "text": "m ka m na-ezitere gị.",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.12",
              "verseOrgIds": [
                "PHM.1.12"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "13",
              "style": "v",
              "sid": "PHM 1:13"
            },
            "items": [
              {
                "text": "13",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ọ gụsịrị m agụụ ike ime ka mụ na ya nọdụ nʼebe a, ka o were ọnọdụ gị na-ejere m ozi ọ bụladị dị ka m nọ na mkpọrọ nʼihi oziọma.",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.13",
              "verseOrgIds": [
                "PHM.1.13"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "14",
              "style": "v",
              "sid": "PHM 1:14"
            },
            "items": [
              {
                "text": "14",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ma, a chọghị m ime ihe ọbụla na-enwetaghị nkwenye gị, ka ọ ghara ịdị ka i mere obiọma gị na mmanye. Kama, achọrọ m ka i mee ihe si gị nʼobi pụta.",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.14",
              "verseOrgIds": [
                "PHM.1.14"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "15",
              "style": "v",
              "sid": "PHM 1:15"
            },
            "items": [
              {
                "text": "15",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ma eleghị anya, ọ bụ nʼihi nke a ka eji kewapụ ya nwa oge nta site nʼebe ị nọ, bụ ka i mesịa nweghachi ya ebighị ebi.",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.15",
              "verseOrgIds": [
                "PHM.1.15"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "16",
              "style": "v",
              "sid": "PHM 1:16"
            },
            "items": [
              {
                "text": "16",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ọ bụghịkwa ohu ọzọ, kama ọ karịrị ohu, maka ọ dịka nwanna a hụrụ nʼanya, ọkachasị nʼebe mụ onwe m nọ, ma ọ ga-abụkwara gị karịchasịa, ma nʼanụ ahụ nakwa nʼime Onyenwe anyị.",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.16",
              "verseOrgIds": [
                "PHM.1.16"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "17",
              "style": "v",
              "sid": "PHM 1:17"
            },
            "items": [
              {
                "text": "17",
                "type": "text"
              }
            ]
          },
          {
            "text": "Nʼihi nke a, ọ bụrụ na ị gụrụ m dị ka onye nnwekọ ihe, nabata ya dị ka ị ga-esi nabata m.",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.17",
              "verseOrgIds": [
                "PHM.1.17"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "18",
              "style": "v",
              "sid": "PHM 1:18"
            },
            "items": [
              {
                "text": "18",
                "type": "text"
              }
            ]
          },
          {
            "text": "Biko, ọ bụrụ na o mejọrọ gị nʼụzọ ọbụla, ọ bụrụkwa na o ji ụgwọ ọbụla, gụọ ya dị ka ụgwọ m ji gị.",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.18",
              "verseOrgIds": [
                "PHM.1.18"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "19",
              "style": "v",
              "sid": "PHM 1:19"
            },
            "items": [
              {
                "text": "19",
                "type": "text"
              }
            ]
          },
          {
            "text": "Mụ bụ Pọl ji aka m dee nke a; aga m akwụghachi gị. Ọ bakwaghị uru ichetara gị ụgwọ i ji m. Nʼihi na ụgwọ i ji m bụ gị onwe gị.",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.19",
              "verseOrgIds": [
                "PHM.1.19"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "20",
              "style": "v",
              "sid": "PHM 1:20"
            },
            "items": [
              {
                "text": "20",
                "type": "text"
              }
            ]
          },
          {
            "text": "Nwanna m, mere m ihe a m na-arịọ gị nʼihi Onyenwe anyị. Mekwa ka obi m dị ọhụrụ nʼime Kraịst.",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.20",
              "verseOrgIds": [
                "PHM.1.20"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "21",
              "style": "v",
              "sid": "PHM 1:21"
            },
            "items": [
              {
                "text": "21",
                "type": "text"
              }
            ]
          },
          {
            "text": "Olileanya m siri m ike na ị ga-aṅa m ntị, ana m edere gị akwụkwọ a, na ị ga-eme, ma karịakwa ka m rịọrọ.",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.21",
              "verseOrgIds": [
                "PHM.1.21"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "22",
              "style": "v",
              "sid": "PHM 1:22"
            },
            "items": [
              {
                "text": "22",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ihe ọzọkwa, bụ na m chọrọ ka ị kwadoro m ọnụụlọ ebe m ga-anọ dị ka ọbịa ma m bịa, maka enwere m olileanya na a ga-aza ekpere unu ime ka m si nʼebe a pụta bịakwute unu.",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.22",
              "verseOrgIds": [
                "PHM.1.22"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "b"
        },
        "items": []
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "b"
        },
        "items": []
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "23",
              "style": "v",
              "sid": "PHM 1:23"
            },
            "items": [
              {
                "text": "23",
                "type": "text"
              }
            ]
          },
          {
            "text": "Epafras, onye mụ na ya nọ nʼụlọ mkpọrọ nʼihi Kraịst Jisọs na-ekele gị.",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.23",
              "verseOrgIds": [
                "PHM.1.23"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "24",
              "style": "v",
              "sid": "PHM 1:24"
            },
            "items": [
              {
                "text": "24",
                "type": "text"
              }
            ]
          },
          {
            "text": "Mak, na Arịstakọs, na Dimas, na Luk, ndị mụ na ha na-arụkọ ọrụ na-ekelekwa unu.",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.24",
              "verseOrgIds": [
                "PHM.1.24"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "b"
        },
        "items": []
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "25",
              "style": "v",
              "sid": "PHM 1:25"
            },
            "items": [
              {
                "text": "25",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ka amara Onyenwe anyị Jisọs Kraịst dịnyere mmụọ unu.",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.25",
              "verseOrgIds": [
                "PHM.1.25"
              ]
            }
          }
        ]
      }
    ],
