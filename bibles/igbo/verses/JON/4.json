  "verseCount": 11,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "JON 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Iwe Jona nʼihi ọmịiko",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JON 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ihe a jọrọ Jona njọ nʼobi nke ukwuu, iwe ya dịkwa ọkụ.",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.1",
            "verseOrgIds": [
              "JON.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JON 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi ya, o kpeere",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.2",
            "verseOrgIds": [
              "JON.4.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JON.4.2",
                "verseOrgIds": [
                  "JON.4.2"
                ]
              }
            }
          ]
        },
        {
          "text": "ekpere sị, \"O,",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.2",
            "verseOrgIds": [
              "JON.4.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JON.4.2",
                "verseOrgIds": [
                  "JON.4.2"
                ]
              }
            }
          ]
        },
        {
          "text": ", nke a ọ bụghị ihe m kwuru, mgbe m nọ nʼala m? Ọ bụ ya mere m ji chọọ ịgbalaga na Tashish na mbụ nʼihi na amaara m na ị bụ Chineke onye na-eme amara, na onye jupụtara nʼobi ebere, na onye na-adịghị ewe iwe ọsịịsọ, nke bara ụba nʼịhụnanya, onye na-anaghị ata mmadụ ahụhụ dịka mmehie ya siri dị.",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.2",
            "verseOrgIds": [
              "JON.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JON 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ugbu a, O,",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.3",
            "verseOrgIds": [
              "JON.4.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JON.4.3",
                "verseOrgIds": [
                  "JON.4.3"
                ]
              }
            }
          ]
        },
        {
          "text": "napụ m ndụ m. Ọ ga-adị m mma ịnwụ anwụ karịa ịdị ndụ.\"",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.3",
            "verseOrgIds": [
              "JON.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JON 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.4",
            "verseOrgIds": [
              "JON.4.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JON.4.4",
                "verseOrgIds": [
                  "JON.4.4"
                ]
              }
            }
          ]
        },
        {
          "text": "sịrị, \"O ziri ezi na ị ga-esi otu a wee oke iwe dị ọkụ?\"",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.4",
            "verseOrgIds": [
              "JON.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JON 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Jona si nʼebe ahụ pụọ jee nọdụ ala nʼakụkụ ọwụwa anyanwụ nke obodo ahụ. O weere ahịhịa meere onwe ya ụlọ ndo, nọdụ nʼime ya, chere ka ọ hụ ihe gaje ime obodo ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.5",
            "verseOrgIds": [
              "JON.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JON 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.6",
            "verseOrgIds": [
              "JON.4.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JON.4.6",
                "verseOrgIds": [
                  "JON.4.6"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke rọpụtara otu osisi nwere akwụkwọ sara mbara,",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.6",
            "verseOrgIds": [
              "JON.4.6"
            ]
          }
        },
        {
          "text": "nke tolitere nʼelu isi Jona, ka o ghọọrọ ya ndo ịnapụta ya nʼọnọdụ ahụ mgbakasị. Jona ṅụrịrị ọṅụ maka osisi ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.6",
            "verseOrgIds": [
              "JON.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JON 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma nʼisi ụtụtụ echi ya, Chineke mere ka otu ikpuru pụta nke riri osisi ahụ site nʼogwe ya, si otu a mee ka ọ kpọnwụọ.",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.7",
            "verseOrgIds": [
              "JON.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JON 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "O ruo, mgbe anyanwụ wara, Chineke mere ka ifufe na-ekpo ọkụ site nʼọwụwa anyanwụ, anyanwụ a chara Jona nʼisi nke ukwuu nke mere nʼike gwụsịrị ya. Ọ rịọrọ ka ọnwụ gbuo ya, na-asị, \"ọ ga a kaara m mma na m nwụrụ anwụ, karịa na m dị ndụ.\"",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.8",
            "verseOrgIds": [
              "JON.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JON 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Chineke sịrị Jona, \"Ọ bụ ihe ziri ezi ka i wee iwe maka osisi a?\"",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.9",
            "verseOrgIds": [
              "JON.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JON 4:9"
      },
      "items": [
        {
          "text": "Ọ sịrị, \"E, ana m ewe oke iwe, ọ bụladị na m chọrọ ịnwụ.\"",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.9",
            "verseOrgIds": [
              "JON.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JON 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.10",
            "verseOrgIds": [
              "JON.4.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JON.4.10",
                "verseOrgIds": [
                  "JON.4.10"
                ]
              }
            }
          ]
        },
        {
          "text": "kwuru, \"I nwere obi ebere nʼebe osisi a dị, nke ị na-akụghị na nke i mekwaghị ka o too, bụ nke toro nʼanyasị, nwụọkwa nʼanyasị.",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.10",
            "verseOrgIds": [
              "JON.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JON 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mụ onwe m, m ga-aghara inwe obi ebere nʼahụ obodo ukwu a dịka Ninive, nke nwere ihe karịrị narị puku ndị mmadụ na iri puku mmadụ abụọ, bụ ndị na-amaghị nke bụ aka nri ha maọbụ aka ekpe ha, na nke ọtụtụ anụmanụ dịkwa nʼime ya?\"",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.11",
            "verseOrgIds": [
              "JON.4.11"
            ]
          }
        }
      ]
    }
  ],
