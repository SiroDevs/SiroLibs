      },
      "items": [
        {
          "text": "13",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Abụ Ọma 13",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Abụ Ọma nke dịrị onyeisi abụ. Abụ ọma Devid.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ekpere maka nnapụta",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ruo ole mgbe ka i ga-echefu m",
          "type": "text",
          "attrs": {
            "verseId": "PSA.13.1",
            "verseOrgIds": [
              "PSA.13.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.13.1",
                "verseOrgIds": [
                  "PSA.13.2"
                ]
              }
            }
          ]
        },
        {
          "text": "?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.13.1",
            "verseOrgIds": [
              "PSA.13.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 13:1"
      },
      "items": [
        {
          "text": "Ruo ole mgbe ka i ga-ezonarị m ihu gị?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.13.1",
            "verseOrgIds": [
              "PSA.13.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ruo ole mgbe ka mụ na mmụọ m ga na-agba mgba",
          "type": "text",
          "attrs": {
            "verseId": "PSA.13.2",
            "verseOrgIds": [
              "PSA.13.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 13:2"
      },
      "items": [
        {
          "text": "nọdụkwa na-eru ụjụ kwa ụbọchị nʼime mkpụrụobi m?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.13.2",
            "verseOrgIds": [
              "PSA.13.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 13:2"
      },
      "items": [
        {
          "text": "Ruo ole mgbe ka ndị iro m ga-anọgide na-emeri m?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.13.2",
            "verseOrgIds": [
              "PSA.13.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lekwasị m anya, ma zaa m, O",
          "type": "text",
          "attrs": {
            "verseId": "PSA.13.3",
            "verseOrgIds": [
              "PSA.13.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.13.3",
                "verseOrgIds": [
                  "PSA.13.4"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke m.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.13.3",
            "verseOrgIds": [
              "PSA.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 13:3"
      },
      "items": [
        {
          "text": "Nyeghachi m ìhè nke anya m ka m ghara ịnwụ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.13.3",
            "verseOrgIds": [
              "PSA.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "mgbe ahụ onye iro m ga-asị, \"Emeriela m ya,\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.13.4",
            "verseOrgIds": [
              "PSA.13.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 13:4"
      },
      "items": [
        {
          "text": "mgbe m ga-ada, ndị kpọrọ m asị ga-aṅụrịkwa ọṅụ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.13.4",
            "verseOrgIds": [
              "PSA.13.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma atụkwasịrị m obi nʼịhụnanya gị nke na-enweghị ọgwụgwụ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.13.5",
            "verseOrgIds": [
              "PSA.13.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 13:5"
      },
      "items": [
        {
          "text": "mkpụrụobi m na-aṅụrị ọṅụ na nzọpụta gị.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.13.5",
            "verseOrgIds": [
              "PSA.13.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aga m abụku",
          "type": "text",
          "attrs": {
            "verseId": "PSA.13.6",
            "verseOrgIds": [
              "PSA.13.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.13.6",
                "verseOrgIds": [
                  "PSA.13.6"
                ]
              }
            }
          ]
        },
        {
          "text": "abụ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.13.6",
            "verseOrgIds": [
              "PSA.13.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 13:6"
      },
      "items": [
        {
          "text": "nʼihi na o mesoro m mmeso ọma.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.13.6",
            "verseOrgIds": [
              "PSA.13.6"
            ]
          }
        }
      ]
    }
  ],
