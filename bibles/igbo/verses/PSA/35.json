        "sid": "PSA 35"
      },
      "items": [
        {
          "text": "35",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Abụ Ọma 35",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Abụ Ọma Devid.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ekpere maka enyemaka",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 35:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "O",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.1",
            "verseOrgIds": [
              "PSA.35.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.35.1",
                "verseOrgIds": [
                  "PSA.35.1"
                ]
              }
            }
          ]
        },
        {
          "text": ", lụso ha ọgụ bụ ndị na-alụso m ọgụ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.1",
            "verseOrgIds": [
              "PSA.35.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:1"
      },
      "items": [
        {
          "text": "buso ha agha bụ ndị na-ebuso m agha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.1",
            "verseOrgIds": [
              "PSA.35.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 35:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yikwasị uwe agha gị, werekwa ọta gị;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.2",
            "verseOrgIds": [
              "PSA.35.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:2"
      },
      "items": [
        {
          "text": "bilie bịa nyere m aka.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.2",
            "verseOrgIds": [
              "PSA.35.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 35:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sepụta ùbe gị na anyụike agha gị;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.3",
            "verseOrgIds": [
              "PSA.35.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:3"
      },
      "items": [
        {
          "text": "bịa zute ndị na-achụ m ọsọ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.3",
            "verseOrgIds": [
              "PSA.35.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 35:3"
      },
      "items": [
        {
          "text": "Gwa mkpụrụobi m,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.3",
            "verseOrgIds": [
              "PSA.35.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:3"
      },
      "items": [
        {
          "text": "\"Abụ m nzọpụta gị.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.3",
            "verseOrgIds": [
              "PSA.35.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 35:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mee ka ihere mee",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.4",
            "verseOrgIds": [
              "PSA.35.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:4"
      },
      "items": [
        {
          "text": "ndị niile na-agbalịsị ike igbu m.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.4",
            "verseOrgIds": [
              "PSA.35.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 35:4"
      },
      "items": [
        {
          "text": "Ka ndị na-agba izuzu igbu m bụrụkwa ndị a chụghachiri azụ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.4",
            "verseOrgIds": [
              "PSA.35.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:4"
      },
      "items": [
        {
          "text": "na ndị ihere mere.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.4",
            "verseOrgIds": [
              "PSA.35.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 35:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka ha dịka igbugbo ọka mgbe oke ifufe na-efe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.5",
            "verseOrgIds": [
              "PSA.35.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:5"
      },
      "items": [
        {
          "text": "ka mmụọ ozi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.5",
            "verseOrgIds": [
              "PSA.35.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.35.5",
                "verseOrgIds": [
                  "PSA.35.5"
                ]
              }
            }
          ]
        },
        {
          "text": "bụrụ onye na-achụfu ha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.5",
            "verseOrgIds": [
              "PSA.35.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 35:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mee ka ụzọ ha gbaa ọchịchịrị, bụrụkwa ebe na-amị amị;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.6",
            "verseOrgIds": [
              "PSA.35.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:6"
      },
      "items": [
        {
          "text": "ka mmụọ ozi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.6",
            "verseOrgIds": [
              "PSA.35.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.35.6",
                "verseOrgIds": [
                  "PSA.35.6"
                ]
              }
            }
          ]
        },
        {
          "text": "bụrụ onye na-achụ ha ọsọ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.6",
            "verseOrgIds": [
              "PSA.35.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 35:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ ezie na ọ dịghị ihe ọjọọ ọbụla m mere ha,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.7",
            "verseOrgIds": [
              "PSA.35.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:7"
      },
      "items": [
        {
          "text": "ma ha siere m ọnya, gwukwaara m olulu nʼụzọ m.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.7",
            "verseOrgIds": [
              "PSA.35.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 35:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka mbibi bịakwasị ha na mberede,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.8",
            "verseOrgIds": [
              "PSA.35.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:8"
      },
      "items": [
        {
          "text": "ka ụgbụ ha zobeere m kee ha;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.8",
            "verseOrgIds": [
              "PSA.35.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:8"
      },
      "items": [
        {
          "text": "ka ha lakwaa nʼiyi site nʼidaba nʼolulu ahụ ha gwuru.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.8",
            "verseOrgIds": [
              "PSA.35.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 35:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, mkpụrụobi m ga-aṅụrị ọṅụ na",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.9",
            "verseOrgIds": [
              "PSA.35.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.35.9",
                "verseOrgIds": [
                  "PSA.35.9"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.9",
            "verseOrgIds": [
              "PSA.35.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:9"
      },
      "items": [
        {
          "text": "ọ ga-enwekwa obi ụtọ nʼime nzọpụta ya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.9",
            "verseOrgIds": [
              "PSA.35.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 35:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihe niile dị nʼime m ga-eti mkpu sị,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.10",
            "verseOrgIds": [
              "PSA.35.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:10"
      },
      "items": [
        {
          "text": "\"O",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.10",
            "verseOrgIds": [
              "PSA.35.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.35.10",
                "verseOrgIds": [
                  "PSA.35.10"
                ]
              }
            }
          ]
        },
        {
          "text": ", ọ bụ onye dịka gị?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.10",
            "verseOrgIds": [
              "PSA.35.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 35:10"
      },
      "items": [
        {
          "text": "Ị na-agbapụta ndị na-adịghị ike site nʼaka ndị dị ike karịa ha,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.10",
            "verseOrgIds": [
              "PSA.35.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:10"
      },
      "items": [
        {
          "text": "ma na-anapụta ndị ogbenye ndị chọrọ enyemaka site nʼaka ndị na-apụnara ha ihe ha nwere nʼike.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.10",
            "verseOrgIds": [
              "PSA.35.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 35:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị akaebe, ndị kwara obi nʼazụ na-apụkwute m;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.11",
            "verseOrgIds": [
              "PSA.35.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:11"
      },
      "items": [
        {
          "text": "ha na-ebo m ebubo ihe ndị m na-anụbeghị ihe banyere ha na mbụ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.11",
            "verseOrgIds": [
              "PSA.35.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 35:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ana m emere ha ihe ọma, ma ha na-akwụghachi m ihe ọjọọ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.12",
            "verseOrgIds": [
              "PSA.35.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:12"
      },
      "items": [
        {
          "text": "Nke a na-ewute mmụọ m ruo nʼọnwụ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.12",
            "verseOrgIds": [
              "PSA.35.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 35:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ha na-arịa ọrịa, eyiri m akwa mkpe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.13",
            "verseOrgIds": [
              "PSA.35.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:13"
      },
      "items": [
        {
          "text": "site na ibu ọnụ weda onwe m nʼala.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.13",
            "verseOrgIds": [
              "PSA.35.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 35:13"
      },
      "items": [
        {
          "text": "Mgbe ekpere m lọghachikwutere m na-enweghị ọsịsa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.13",
            "verseOrgIds": [
              "PSA.35.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 35:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "ejegharịrị m nʼọnọdụ iru ụjụ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.14",
            "verseOrgIds": [
              "PSA.35.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:14"
      },
      "items": [
        {
          "text": "dịka a ga-asị na ọ bụ nwanne m, maọbụ enyi m,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.14",
            "verseOrgIds": [
              "PSA.35.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 35:14"
      },
      "items": [
        {
          "text": "jegharịakwa nʼobi ọjọọ dịka a ga-asị",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.14",
            "verseOrgIds": [
              "PSA.35.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:14"
      },
      "items": [
        {
          "text": "na ọ bụ nne m na-arịa ọrịa ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.14",
            "verseOrgIds": [
              "PSA.35.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 35:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma mgbe m dahiere, ha zukọtara na-aṅụrị ọṅụ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.15",
            "verseOrgIds": [
              "PSA.35.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:15"
      },
      "items": [
        {
          "text": "mgbe m na-adịghị ele anya, ha biliri imegide m.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.15",
            "verseOrgIds": [
              "PSA.35.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:15"
      },
      "items": [
        {
          "text": "Ha na-ekwulu m na-esepụghị aka.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.15",
            "verseOrgIds": [
              "PSA.35.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 35:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dịka ndị ajọ omume, ha na-akwa m emo nʼiwe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.16",
            "verseOrgIds": [
              "PSA.35.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:16"
      },
      "items": [
        {
          "text": "na-atakwara m ikikere eze ha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.16",
            "verseOrgIds": [
              "PSA.35.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PSA 35:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "O Onyenwe anyị, ọ bụ ruo ole mgbe ka ị ga-anọ na-ele ihe na-eme?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.17",
            "verseOrgIds": [
              "PSA.35.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:17"
      },
      "items": [
        {
          "text": "Gbapụta ndụ m site na mbibi ha niile,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.17",
            "verseOrgIds": [
              "PSA.35.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:17"
      },
      "items": [
        {
          "text": "site nʼaka ụmụ ọdụm ndị a, gbapụta ndụ m dị oke ọnụahịa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.17",
            "verseOrgIds": [
              "PSA.35.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PSA 35:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aga m enye gị ekele nʼihu ọha mmadụ dị ukwuu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.18",
            "verseOrgIds": [
              "PSA.35.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:18"
      },
      "items": [
        {
          "text": "nʼetiti ọha kachasị ibe ya dị ukwuu, ka m ga-anọ too gị.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.18",
            "verseOrgIds": [
              "PSA.35.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PSA 35:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekwekwala ka ndị ahụ bụ ndị iro m,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.19",
            "verseOrgIds": [
              "PSA.35.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:19"
      },
      "items": [
        {
          "text": "mgbe o nweghị ihe m mere ha, chịa m ọchị;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.19",
            "verseOrgIds": [
              "PSA.35.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 35:19"
      },
      "items": [
        {
          "text": "ekwekwala ka ndị ahụ kpọrọ m asị nʼihi iro,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.19",
            "verseOrgIds": [
              "PSA.35.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:19"
      },
      "items": [
        {
          "text": "mgbe o nweghị ihe m mere ha nwee izuike.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.19",
            "verseOrgIds": [
              "PSA.35.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PSA 35:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na ọ bụghị okwu udo ka ha na-ekwu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.20",
            "verseOrgIds": [
              "PSA.35.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:20"
      },
      "items": [
        {
          "text": "kama ha na-echepụta ebubo ụgha dị iche iche",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.20",
            "verseOrgIds": [
              "PSA.35.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:20"
      },
      "items": [
        {
          "text": "megide ndị ahụ na-anọrọ onwe ha jụụ nʼime ala ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.20",
            "verseOrgIds": [
              "PSA.35.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "PSA 35:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼiju anya, ha na-ele m anya na-eti mkpu na-asị,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.21",
            "verseOrgIds": [
              "PSA.35.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:21"
      },
      "items": [
        {
          "text": "\"Ewoo! Ewoo! Anya anyị abụọ ka anyị ji hụ ya.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.21",
            "verseOrgIds": [
              "PSA.35.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "PSA 35:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "O",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.22",
            "verseOrgIds": [
              "PSA.35.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.35.22",
                "verseOrgIds": [
                  "PSA.35.22"
                ]
              }
            }
          ]
        },
        {
          "text": ", ị hụla nke a, agbakwala nkịtị;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.22",
            "verseOrgIds": [
              "PSA.35.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:22"
      },
      "items": [
        {
          "text": "anọkwala m nʼebe dị anya, O Onyenwe anyị.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.22",
            "verseOrgIds": [
              "PSA.35.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "PSA 35:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Teta, bilie bụụrụ m onye mkpepụta m.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.23",
            "verseOrgIds": [
              "PSA.35.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:23"
      },
      "items": [
        {
          "text": "Kpechitere m ọnụ m, Chineke m na onyenwe m.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.23",
            "verseOrgIds": [
              "PSA.35.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "PSA 35:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "O",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.24",
            "verseOrgIds": [
              "PSA.35.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.35.24",
                "verseOrgIds": [
                  "PSA.35.24"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke m, kpepụta m nʼihi ezi omume gị;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.24",
            "verseOrgIds": [
              "PSA.35.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:24"
      },
      "items": [
        {
          "text": "ekwekwala ka ha chịa m ọchị.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.24",
            "verseOrgIds": [
              "PSA.35.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "PSA 35:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekwekwala ka ha sị, \"Ahaa, ọ dị ka anyị tụrụ anya ya!\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.25",
            "verseOrgIds": [
              "PSA.35.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:25"
      },
      "items": [
        {
          "text": "Maọbụ sị, \"Anyị eloola ya!\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.25",
            "verseOrgIds": [
              "PSA.35.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "PSA 35:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mee ka ihere na ọgbaaghara",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.26",
            "verseOrgIds": [
              "PSA.35.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:26"
      },
      "items": [
        {
          "text": "bụrụ nke ndị na-achị m ọchị nʼime mkpagbu m;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.26",
            "verseOrgIds": [
              "PSA.35.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 35:26"
      },
      "items": [
        {
          "text": "were ihere na nweda nʼala yinye ha dịka uwe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.26",
            "verseOrgIds": [
