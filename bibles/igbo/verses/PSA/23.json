      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Abụ Ọma 23",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Abụ Ọma Devid.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Onyenwe anyị na-azụ anyị dị ka atụrụ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.23.1",
                "verseOrgIds": [
                  "PSA.23.1"
                ]
              }
            }
          ]
        },
        {
          "text": "na-azụ m dịka atụrụ, ọ dịghị ihe akọrọ m.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.23.1",
            "verseOrgIds": [
              "PSA.23.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ na-eme ka m dinaa ala nʼebe ahịhịa ndụ na-eto,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.23.2",
            "verseOrgIds": [
              "PSA.23.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 23:2"
      },
      "items": [
        {
          "text": "ọ na-edugharị m nʼakụkụ mmiri dị jụụ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.23.2",
            "verseOrgIds": [
              "PSA.23.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ọ na-atụte mkpụrụobi m.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.23.3",
            "verseOrgIds": [
              "PSA.23.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 23:3"
      },
      "items": [
        {
          "text": "Ọ na-edu m nʼụzọ niile nke ezi omume",
          "type": "text",
          "attrs": {
            "verseId": "PSA.23.3",
            "verseOrgIds": [
              "PSA.23.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 23:3"
      },
      "items": [
        {
          "text": "nʼihi aha ya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.23.3",
            "verseOrgIds": [
              "PSA.23.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "A sịkwarị na m na-aga ije,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.23.4",
            "verseOrgIds": [
              "PSA.23.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 23:4"
      },
      "items": [
        {
          "text": "na ndagwurugwu nke ọchịchịrị ọnwụ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.23.4",
            "verseOrgIds": [
              "PSA.23.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 23:4"
      },
      "items": [
        {
          "text": "agaghị m atụ egwu ihe ọjọọ ọbụla;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.23.4",
            "verseOrgIds": [
              "PSA.23.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 23:4"
      },
      "items": [
        {
          "text": "nʼihi na ị nọnyeere m,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.23.4",
            "verseOrgIds": [
              "PSA.23.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 23:4"
      },
      "items": [
        {
          "text": "mkpọrọ gị na mkpanaka gị",
          "type": "text",
          "attrs": {
            "verseId": "PSA.23.4",
            "verseOrgIds": [
              "PSA.23.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 23:4"
      },
      "items": [
        {
          "text": "na-akasị m obi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.23.4",
            "verseOrgIds": [
              "PSA.23.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ị na-akwado tebul",
          "type": "text",
          "attrs": {
            "verseId": "PSA.23.5",
            "verseOrgIds": [
              "PSA.23.5"
            ]
          }
        },
        {
          "text": "nʼihu m,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.23.5",
            "verseOrgIds": [
              "PSA.23.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 23:5"
      },
      "items": [
        {
          "text": "nʼanya ndị iro m.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.23.5",
            "verseOrgIds": [
              "PSA.23.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 23:5"
      },
      "items": [
        {
          "text": "I tere isi m mmanụ",
          "type": "text",
          "attrs": {
            "verseId": "PSA.23.5",
            "verseOrgIds": [
              "PSA.23.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 23:5"
      },
      "items": [
        {
          "text": "iko m na-ejubiga oke.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.23.5",
            "verseOrgIds": [
              "PSA.23.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼezie, ịdị mma na ebere ga-agbaso m",
          "type": "text",
          "attrs": {
            "verseId": "PSA.23.6",
            "verseOrgIds": [
              "PSA.23.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 23:6"
      },
      "items": [
        {
          "text": "ogologo ụbọchị niile nke ndụ m,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.23.6",
            "verseOrgIds": [
              "PSA.23.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 23:6"
      },
      "items": [
        {
          "text": "m ga-ebikwa nʼụlọ",
          "type": "text",
          "attrs": {
            "verseId": "PSA.23.6",
            "verseOrgIds": [
              "PSA.23.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.23.6",
                "verseOrgIds": [
                  "PSA.23.6"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 23:6"
      },
      "items": [
        {
          "text": "mgbe niile ebighị ebi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.23.6",
            "verseOrgIds": [
              "PSA.23.6"
            ]
          }
        }
      ]
    }
  ],
