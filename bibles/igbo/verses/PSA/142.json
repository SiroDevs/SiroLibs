    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Abụ Ọma 142",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Abụ",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "tl"
          },
          "items": [
            {
              "text": "maskil",
              "type": "text"
            }
          ]
        },
        {
          "text": "nke Devid. Mgbe ọ nọ nʼọgba nkume. Ekpere.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ekpere nke onye mkpọrọ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 142:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Etikuru m",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.1",
            "verseOrgIds": [
              "PSA.142.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.142.1",
                "verseOrgIds": [
                  "PSA.142.2"
                ]
              }
            }
          ]
        },
        {
          "text": "mkpu akwa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.1",
            "verseOrgIds": [
              "PSA.142.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 142:1"
      },
      "items": [
        {
          "text": "ewelitara m olu m rịọ",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.1",
            "verseOrgIds": [
              "PSA.142.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.142.1",
                "verseOrgIds": [
                  "PSA.142.2"
                ]
              }
            }
          ]
        },
        {
          "text": "ka o meere m ebere.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.1",
            "verseOrgIds": [
              "PSA.142.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 142:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekwupụtara m ihe na-esogbu m nʼihu ya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.2",
            "verseOrgIds": [
              "PSA.142.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 142:2"
      },
      "items": [
        {
          "text": "gwakwa ya ahụhụ nke m nọ nʼime ya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.2",
            "verseOrgIds": [
              "PSA.142.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 142:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe mmụọ m dara mba nʼime m,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.3",
            "verseOrgIds": [
              "PSA.142.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 142:3"
      },
      "items": [
        {
          "text": "ọ bụ gị maara ụzọ m.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.3",
            "verseOrgIds": [
              "PSA.142.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 142:3"
      },
      "items": [
        {
          "text": "Nʼụzọ ebe m na-esi aga",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.3",
            "verseOrgIds": [
              "PSA.142.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 142:3"
      },
      "items": [
        {
          "text": "ka ndị mmadụ siiri m ọnya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.3",
            "verseOrgIds": [
              "PSA.142.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 142:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lee anya nʼaka nri m ma hụ",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.4",
            "verseOrgIds": [
              "PSA.142.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 142:4"
      },
      "items": [
        {
          "text": "na ọ dịghị onye ọbụla na-eche ihe banyere m.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.4",
            "verseOrgIds": [
              "PSA.142.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 142:4"
      },
      "items": [
        {
          "text": "Enweghị m ebe mgbaba.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.4",
            "verseOrgIds": [
              "PSA.142.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 142:4"
      },
      "items": [
        {
          "text": "Ọ dịghị onye ọbụla ihe banyere m na-emetụta nʼobi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.4",
            "verseOrgIds": [
              "PSA.142.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 142:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ana m etiku gị mkpu akwa, o",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.5",
            "verseOrgIds": [
              "PSA.142.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.142.5",
                "verseOrgIds": [
                  "PSA.142.6"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.5",
            "verseOrgIds": [
              "PSA.142.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 142:5"
      },
      "items": [
        {
          "text": "na-asị, \"Gị bụ ebe mgbaba m,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.5",
            "verseOrgIds": [
              "PSA.142.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 142:5"
      },
      "items": [
        {
          "text": "oke m nʼala ndị dị ndụ.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.5",
            "verseOrgIds": [
              "PSA.142.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 142:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gee ntị na mkpu akwa m,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.6",
            "verseOrgIds": [
              "PSA.142.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 142:6"
      },
      "items": [
        {
          "text": "nʼihi na anọ m nʼọnọdụ ihe isiike;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.6",
            "verseOrgIds": [
              "PSA.142.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 142:6"
      },
      "items": [
        {
          "text": "gbapụta m site nʼaka ndị na-achụ m ọsọ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.6",
            "verseOrgIds": [
              "PSA.142.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 142:6"
      },
      "items": [
        {
          "text": "nʼihi na ha siri ike karịa m.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.6",
            "verseOrgIds": [
              "PSA.142.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 142:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mee ka m nwere onwe m site nʼụlọ mkpọrọ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.7",
            "verseOrgIds": [
              "PSA.142.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 142:7"
      },
      "items": [
        {
          "text": "ka m nwee ike too aha gị.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.7",
            "verseOrgIds": [
              "PSA.142.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 142:7"
      },
      "items": [
        {
          "text": "Mgbe ahụ ndị ezi omume ga-agba m gburugburu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.7",
            "verseOrgIds": [
              "PSA.142.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 142:7"
      },
      "items": [
        {
          "text": "nʼihi ịdị mma gị nʼebe m nọ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.7",
            "verseOrgIds": [
              "PSA.142.8"
            ]
          }
        }
      ]
    }
  ],
