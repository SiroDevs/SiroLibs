          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị Izrel, ka olileanya unu dịrị na",
          "type": "text",
          "attrs": {
            "verseId": "PSA.131.3",
            "verseOrgIds": [
              "PSA.131.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.131.3",
                "verseOrgIds": [
                  "PSA.131.3"
                ]
              }
            }
          ]
        }
      ]
    },
