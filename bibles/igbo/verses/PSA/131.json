          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ana m edere duu, mkpụrụobi m nọkwa jụụ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.131.2",
            "verseOrgIds": [
              "PSA.131.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 131:2"
      },
      "items": [
        {
          "text": "dịka nwantakịrị a napụrụ ara, ya na nne ya nọ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.131.2",
            "verseOrgIds": [
              "PSA.131.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 131:2"
      },
      "items": [
        {
          "text": "e, dịka nwantakịrị a napụrụ ara, otu a ka mkpụrụobi m nọ nʼime m.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.131.2",
            "verseOrgIds": [
              "PSA.131.2"
            ]
          }
        }
      ]
    },
