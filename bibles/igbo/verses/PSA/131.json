                "verseId": "PSA.131.1",
                "verseOrgIds": [
                  "PSA.131.1"
                ]
              }
            }
          ]
        },
        {
          "text": ", nganga adịghị nʼobi m,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.131.1",
            "verseOrgIds": [
              "PSA.131.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 131:1"
      },
      "items": [
        {
          "text": "ndụ mpako abụkwaghị ọchịchọ m;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.131.1",
            "verseOrgIds": [
              "PSA.131.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 131:1"
      },
      "items": [
        {
          "text": "adịghị m etinye onwe m nʼokwu karịrị m",
          "type": "text",
          "attrs": {
            "verseId": "PSA.131.1",
            "verseOrgIds": [
              "PSA.131.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 131:1"
      },
      "items": [
        {
          "text": "maọbụ nʼihe ndị dị ukwuu karịa m.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.131.1",
            "verseOrgIds": [
              "PSA.131.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
