              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chee m ihu, mekwaara m amara.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.16",
            "verseOrgIds": [
              "PSA.86.16"
            ]
