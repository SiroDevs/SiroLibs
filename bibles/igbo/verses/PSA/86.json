      "attrs": {
        "style": "q2",
        "vid": "PSA 86:15"
      },
      "items": [
        {
          "text": "iwe adịghị ewe gị ngwangwa, i jupụtara nʼịhụnanya na ikwesi ntụkwasị obi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.15",
            "verseOrgIds": [
              "PSA.86.15"
            ]
          }
