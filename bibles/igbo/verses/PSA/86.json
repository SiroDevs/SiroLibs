          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma gị, Onyenwe anyị, ị bụ Chineke onye ọmịiko na onye amara,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.15",
            "verseOrgIds": [
