  "verseCount": 12,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "36",
        "style": "c",
        "sid": "PSA 36"
      },
      "items": [
        {
          "text": "36",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Abụ Ọma 36",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Abụ Ọma dịrị onyeisi abụ. Abụ Ọma Devid, bụ ohu",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text"
            }
          ]
        },
        {
          "text": ".",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ajọ omume mmadụ na ịdị mma Chineke",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 36:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "E nwere m ozi dị nʼime obi nke sitere nʼaka Chineke",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.1",
            "verseOrgIds": [
              "PSA.36.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 36:1"
      },
      "items": [
        {
          "text": "banyere ndụ mmehie nke ndị na-eme ajọ ihe:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.1",
            "verseOrgIds": [
              "PSA.36.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 36:1"
      },
      "items": [
        {
          "text": "Ọ dịghị ịtụ egwu Chineke",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.1",
            "verseOrgIds": [
              "PSA.36.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 36:1"
      },
      "items": [
        {
          "text": "dị nʼanya ha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.1",
            "verseOrgIds": [
              "PSA.36.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 36:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi ha na-agwarịta onwe ha okwu ire ụtọ nʼanya ha onwe ha,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.2",
            "verseOrgIds": [
              "PSA.36.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 36:2"
      },
      "items": [
        {
          "text": "na o nweghị ụzọ a ga-esi nwe ike ịchọpụta mmehie ha maọbụ kpọọ ya asị.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.2",
            "verseOrgIds": [
              "PSA.36.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 36:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okwu ọnụ ha niile bụ ihe ọjọọ na aghụghọ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.3",
            "verseOrgIds": [
              "PSA.36.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 36:3"
      },
      "items": [
        {
          "text": "ha adịghị eji uche eme ihe maọbụ mee ihe dị mma.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.3",
            "verseOrgIds": [
              "PSA.36.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 36:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụladị mgbe ha nọ nʼelu ihe ndina ha, ha na-eche echiche ajọ ihe;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.4",
            "verseOrgIds": [
              "PSA.36.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 36:4"
      },
      "items": [
        {
          "text": "ha enyefeela onwe ha nʼaka ndụ ajọ omume,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.4",
            "verseOrgIds": [
              "PSA.36.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 36:4"
      },
      "items": [
        {
          "text": "ha adịghị ajụkwa ihe na-ezighị ezi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.4",
            "verseOrgIds": [
              "PSA.36.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 36:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "O",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.5",
            "verseOrgIds": [
              "PSA.36.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.36.5",
                "verseOrgIds": [
                  "PSA.36.6"
                ]
              }
            }
          ]
        },
        {
          "text": ", ịhụnanya gị na-eru mbara eluigwe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.5",
            "verseOrgIds": [
              "PSA.36.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 36:5"
      },
      "items": [
        {
          "text": "ikwesi ntụkwasị obi gị na-erukwa igwe ojii nke eluigwe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.5",
            "verseOrgIds": [
              "PSA.36.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 36:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezi omume gị dịka ugwu dị ukwuu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.6",
            "verseOrgIds": [
              "PSA.36.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 36:6"
      },
      "items": [
        {
          "text": "ikpe ikpe ziri ezi gị dịka omimi nke oke osimiri.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.6",
            "verseOrgIds": [
              "PSA.36.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 36:6"
      },
      "items": [
        {
          "text": "O",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.6",
            "verseOrgIds": [
              "PSA.36.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.36.6",
                "verseOrgIds": [
                  "PSA.36.7"
                ]
              }
            }
          ]
        },
        {
          "text": ", ị na-echebe ụmụ mmadụ na anụmanụ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.6",
            "verseOrgIds": [
              "PSA.36.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 36:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lee ka ịhụnanya gị nke na-adịghị agwụ agwụ si dị oke ọnụahịa, O Chineke!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.7",
            "verseOrgIds": [
              "PSA.36.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 36:7"
      },
      "items": [
        {
          "text": "Ụmụ mmadụ na-agbaba nʼokpuru ndo nke nku gị abụọ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.7",
            "verseOrgIds": [
              "PSA.36.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 36:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha na-eri oriri site nʼịba ụba nke ụlọakụ gị;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.8",
            "verseOrgIds": [
              "PSA.36.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 36:8"
      },
      "items": [
        {
          "text": "Ị na-enyekwa ha mmiri site nʼiyi nke obi ụtọ gị.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.8",
            "verseOrgIds": [
              "PSA.36.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 36:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na mmiri na-enye ndụ dị na gị;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.9",
            "verseOrgIds": [
              "PSA.36.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 36:9"
      },
      "items": [
        {
          "text": "ọ bụkwa nʼìhè gị ka anyị na-ahụ ìhè.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.9",
            "verseOrgIds": [
              "PSA.36.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 36:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mee ka ịhụnanya gị na-adịgidere ndị maara gị,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.10",
            "verseOrgIds": [
              "PSA.36.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 36:10"
      },
      "items": [
        {
          "text": "ka ezi omume gị na-adịgidekwara ndị ziri ezi nʼobi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.10",
            "verseOrgIds": [
              "PSA.36.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 36:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekwela ka ndị mpako a zọọ m ụkwụ nʼisi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.11",
            "verseOrgIds": [
              "PSA.36.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 36:11"
      },
      "items": [
        {
          "text": "ekwekwala ka aka ndị ajọ omume nupu m nʼebe m guzo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.11",
            "verseOrgIds": [
              "PSA.36.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 36:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lee ka ndị na-eme ajọ ihe si daa nʼala,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.12",
            "verseOrgIds": [
              "PSA.36.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 36:12"
      },
      "items": [
        {
          "text": "a kwatuola ha nʼala, ha apụghịkwa ibilite ọzọ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.12",
            "verseOrgIds": [
              "PSA.36.13"
            ]
          }
        }
      ]
    }
  ],
