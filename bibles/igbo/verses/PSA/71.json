        "vid": "PSA 71:17"
      },
      "items": [
        {
          "text": "ruo taa, ana m ekwupụta banyere ọrụ ebube gị niile.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.17",
            "verseOrgIds": [
              "PSA.71.17"
            ]
