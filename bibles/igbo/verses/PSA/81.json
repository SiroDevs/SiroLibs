{
  "id": "PSA.81",
  "number": "81",
  "bookId": "PSA",
  "reference": "Abụ Ọma 81",
  "copyright": "Biblica® Open Igbo Contemporary Bible™ Copyright © 1980, 1988, 2019, 2020 by Biblica, Inc. Used with permission. All rights reserved worldwide.",
  "verseCount": 16,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "81",
        "style": "c",
        "sid": "PSA 81"
      },
      "items": [
        {
          "text": "81",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Abụ Ọma 81",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Abụ Ọma nke dịrị onyeisi Abụ. Abụ nke Asaf nʼusoro gittit.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ịdị mma nke Chineke",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 81:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bụkuo Chineke bụ ike anyị abụ ọṅụ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.1",
            "verseOrgIds": [
              "PSA.81.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 81:1"
      },
      "items": [
        {
          "text": "tikusie Chineke Jekọb mkpu ike!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.1",
            "verseOrgIds": [
              "PSA.81.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 81:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bidonụ iti egwu, kụọ ihe iti egwu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.2",
            "verseOrgIds": [
              "PSA.81.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 81:2"
      },
      "items": [
        {
          "text": "kpọọnụ ụbọ akwara na-enye abụ ụtọ na une.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.2",
            "verseOrgIds": [
              "PSA.81.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 81:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fụọnụ opi ike nʼoge ọnwa ọhụrụ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.3",
            "verseOrgIds": [
              "PSA.81.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 81:3"
      },
      "items": [
        {
          "text": "na mgbe ọnwa gbapụtara nʼuju ya, nʼụbọchị mmemme anyị;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.3",
            "verseOrgIds": [
              "PSA.81.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 81:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "nke a bụ iwu dịrị Izrel,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.4",
            "verseOrgIds": [
              "PSA.81.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 81:4"
      },
      "items": [
        {
          "text": "ụkpụrụ Chineke nke Jekọb.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.4",
            "verseOrgIds": [
              "PSA.81.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 81:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "O mere ka o guzosie ike dịka iwu nye Josef",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.5",
            "verseOrgIds": [
              "PSA.81.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 81:5"
      },
      "items": [
        {
          "text": "mgbe ọ pụrụ imegide Ijipt.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.5",
            "verseOrgIds": [
              "PSA.81.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "PSA 81:5"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 81:5"
      },
      "items": [
        {
          "text": "Anụkwara m olu nʼasụsụ nke m na-amaghị, ka ọ na-asị:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.5",
            "verseOrgIds": [
              "PSA.81.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 81:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ewezugala m ibu arọ site nʼubu ha;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.6",
            "verseOrgIds": [
              "PSA.81.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 81:6"
      },
      "items": [
        {
          "text": "aka ha abụọ nwere onwe ha site nʼịrụ ọrụ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.6",
            "verseOrgIds": [
              "PSA.81.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 81:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼime ihe mgbu unu, unu kpọrọ oku, anapụtara m unu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.7",
            "verseOrgIds": [
              "PSA.81.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 81:7"
      },
      "items": [
        {
          "text": "azara m unu site nʼegbe eluigwe;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.7",
            "verseOrgIds": [
              "PSA.81.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 81:7"
      },
      "items": [
        {
          "text": "anwara m unu na mmiri nke Meriba.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.7",
            "verseOrgIds": [
              "PSA.81.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "qs"
          },
          "items": [
            {
              "text": "Sela",
              "type": "text",
              "attrs": {
                "verseId": "PSA.81.7",
                "verseOrgIds": [
                  "PSA.81.8"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 81:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nụrụnụ, ndị m, aga m adọ unu aka na ntị,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.8",
            "verseOrgIds": [
              "PSA.81.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 81:8"
      },
      "items": [
        {
          "text": "a sịkwarị na unu ga-ege m ntị, unu ndị Izrel!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.8",
            "verseOrgIds": [
              "PSA.81.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 81:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unu agaghị enwe chi ndị mba ọzọ nʼetiti unu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.9",
            "verseOrgIds": [
              "PSA.81.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 81:9"
      },
      "items": [
        {
          "text": "unu agaghị akpọkwa isiala nye chi si ala ọzọ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.9",
            "verseOrgIds": [
              "PSA.81.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 81:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abụ m",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.10",
            "verseOrgIds": [
              "PSA.81.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.81.10",
                "verseOrgIds": [
                  "PSA.81.11"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke unu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.10",
            "verseOrgIds": [
              "PSA.81.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 81:10"
      },
      "items": [
        {
          "text": "onye kpọpụtara unu site nʼala Ijipt.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.10",
            "verseOrgIds": [
              "PSA.81.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 81:10"
      },
      "items": [
        {
          "text": "Meghe ọnụ unu ka ọ saa mbara, aga m emeju ya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.10",
            "verseOrgIds": [
              "PSA.81.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 81:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ma ndị m ekweghị ige m ntị.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.11",
            "verseOrgIds": [
              "PSA.81.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 81:11"
      },
      "items": [
        {
          "text": "Izrel emekwaghị dịka m gwara ha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.11",
            "verseOrgIds": [
              "PSA.81.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 81:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, ahapụrụ m ha na ndụ isiike ha,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.12",
            "verseOrgIds": [
              "PSA.81.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 81:12"
      },
      "items": [
        {
          "text": "ka ha soro nchepụta nke echiche ha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.12",
            "verseOrgIds": [
              "PSA.81.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 81:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ewoo, a sị na ndị m gaara ege m ntị,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.13",
            "verseOrgIds": [
              "PSA.81.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 81:13"
      },
      "items": [
        {
          "text": "a sịkwa na Izrel ga-eso ụzọ m niile.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.13",
            "verseOrgIds": [
              "PSA.81.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 81:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ gaghị adị anya mgbe m ga-eji ike m, wezuga ndị iro ya site nʼọnọdụ ha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.14",
            "verseOrgIds": [
              "PSA.81.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 81:14"
      },
      "items": [
        {
          "text": "Aga m eweli aka m, megide ndị iro ya niile.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.14",
            "verseOrgIds": [
              "PSA.81.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 81:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị niile kpọrọ",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.15",
            "verseOrgIds": [
              "PSA.81.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.81.15",
                "verseOrgIds": [
                  "PSA.81.16"
                ]
              }
            }
          ]
        },
        {
          "text": "asị, ga-ada nʼihu ya nʼụjọ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.15",
