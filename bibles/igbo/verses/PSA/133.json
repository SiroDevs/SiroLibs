        {
          "text": "Abụ Ọma 133",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Abụ nrigo, nke Devid.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ngọzị nke ibi nʼotu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 133:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lee ka o si bụrụ ihe dị mma",
          "type": "text",
          "attrs": {
            "verseId": "PSA.133.1",
            "verseOrgIds": [
              "PSA.133.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 133:1"
      },
      "items": [
        {
          "text": "na ihe ọṅụ mgbe ụmụnne na-ebikọ nʼotu!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.133.1",
            "verseOrgIds": [
              "PSA.133.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 133:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ dị ka mmanụ dị oke ọnụahịa a wụrụ nʼisi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.133.2",
            "verseOrgIds": [
              "PSA.133.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 133:2"
      },
      "items": [
        {
          "text": "nke na-asọdata ruo nʼahụọnụ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.133.2",
            "verseOrgIds": [
              "PSA.133.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 133:2"
      },
      "items": [
        {
          "text": "e, nke na-asọdata ruo nʼahụọnụ Erọn,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.133.2",
            "verseOrgIds": [
              "PSA.133.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 133:2"
      },
      "items": [
        {
          "text": "ruokwa nʼolu uwe mwụda ya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.133.2",
            "verseOrgIds": [
              "PSA.133.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 133:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ dị ka a ga-asị na igirigi si na Hemon",
          "type": "text",
          "attrs": {
            "verseId": "PSA.133.3",
            "verseOrgIds": [
              "PSA.133.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 133:3"
      },
      "items": [
        {
          "text": "na-ada nʼelu nʼugwu Zayọn.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.133.3",
            "verseOrgIds": [
              "PSA.133.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 133:3"
      },
      "items": [
        {
          "text": "Nʼihi na nʼebe ahụ ka",
          "type": "text",
          "attrs": {
            "verseId": "PSA.133.3",
            "verseOrgIds": [
              "PSA.133.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.133.3",
                "verseOrgIds": [
                  "PSA.133.3"
                ]
              }
            }
          ]
        },
        {
          "text": "na-enye onyinye ngọzị ya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.133.3",
            "verseOrgIds": [
              "PSA.133.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 133:3"
      },
      "items": [
        {
          "text": "ọ bụladị ndụ na-adị ruo mgbe ebighị ebi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.133.3",
            "verseOrgIds": [
              "PSA.133.3"
            ]
          }
        }
      ]
    }
