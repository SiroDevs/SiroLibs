          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwere",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.14",
            "verseOrgIds": [
              "PSA.19.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.19.14",
                "verseOrgIds": [
                  "PSA.19.15"
                ]
              }
            }
          ]
        },
        {
          "text": ", Onye mgbapụta m, na Oke nkume nchebe m,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.14",
            "verseOrgIds": [
              "PSA.19.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 19:14"
      },
      "items": [
        {
          "text": "ka okwu ọnụ m niile, na echiche obi m niile,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.14",
            "verseOrgIds": [
              "PSA.19.15"
            ]
          }
        }
      ]
    },
