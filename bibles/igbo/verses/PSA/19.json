      "attrs": {
        "style": "q2",
        "vid": "PSA 19:14"
      },
      "items": [
        {
          "text": "bụrụ ihe na-atọ gị ụtọ, na nke ị na-anabata.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.14",
            "verseOrgIds": [
              "PSA.19.15"
            ]
          }
        }
