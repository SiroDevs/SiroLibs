{
  "id": "PSA.60",
  "number": "60",
  "bookId": "PSA",
  "reference": "Abụ Ọma 60",
  "copyright": "Biblica® Open Igbo Contemporary Bible™ Copyright © 1980, 1988, 2019, 2020 by Biblica, Inc. Used with permission. All rights reserved worldwide.",
  "verseCount": 12,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "60",
        "style": "c",
        "sid": "PSA 60"
      },
      "items": [
        {
          "text": "60",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Abụ Ọma 60",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Abụ Ọma nke dịrị onyeisi Abụ. Ọ bụ olu abụ eji ekwe \"Okoko lili nke Ọgbụgba Ndụ.\" Abụ miktam nke Devid maka izi ihe. Mgbe ọ lụsoro Aram Naharaim na Aram Zoba ọgụ, nakwa mgbe Joab lọghachitara, tigbuo narị ndị Edọm iri nʼabụọ na Ndagwurugwu Nnu.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ekpere maka nnapụta",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 60:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "O Chineke, ị jụla anyị, ị tịwawo anyị nʼike;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.1",
            "verseOrgIds": [
              "PSA.60.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 60:1"
      },
      "items": [
        {
          "text": "i wesola anyị iwe, ugbu a, kpọghachi anyị.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.1",
            "verseOrgIds": [
              "PSA.60.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 60:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "I meela ka ala a maa jijiji, ị dọwakwala ya;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.2",
            "verseOrgIds": [
              "PSA.60.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 60:2"
      },
      "items": [
        {
          "text": "mezie ntiwa ya niile, nʼihi na ọ na-ama jijiji.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.2",
            "verseOrgIds": [
              "PSA.60.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 60:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "I meela ka ndị gị gabiga ọnọdụ ihe isi ike;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.3",
            "verseOrgIds": [
              "PSA.60.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 60:3"
      },
      "items": [
        {
          "text": "i nyela anyị mmanya nke mere ka anyị na-adagharị.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.3",
            "verseOrgIds": [
              "PSA.60.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 60:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma nye ndị na-atụ egwu gị, i weliela otu ọkọlọtọ",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.4",
            "verseOrgIds": [
              "PSA.60.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 60:4"
      },
      "items": [
        {
          "text": "nke a ga-agbasa nʼihi eziokwu imegide ụta nke ndị iro.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.4",
            "verseOrgIds": [
              "PSA.60.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "qs"
          },
          "items": [
            {
              "text": "Sela",
              "type": "text",
              "attrs": {
                "verseId": "PSA.60.4",
                "verseOrgIds": [
                  "PSA.60.6"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 60:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Were aka nri gị zọpụta anyị ma nyere anyị aka,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.5",
            "verseOrgIds": [
              "PSA.60.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 60:5"
      },
      "items": [
        {
          "text": "ka a gbapụta ndị ị hụrụ nʼanya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.5",
            "verseOrgIds": [
              "PSA.60.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 60:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chineke esitela nʼịdị nsọ ya kwuo, sị,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.6",
            "verseOrgIds": [
              "PSA.60.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 60:6"
      },
      "items": [
        {
          "text": "\"Nʼọnọdụ ọṅụ nke mmeri, aga m ekesa Shekem,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.6",
            "verseOrgIds": [
              "PSA.60.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 60:6"
      },
      "items": [
        {
          "text": "tụkwaa Ndagwurugwu Sukọt nʼihe ọtụtụ nyepụ ya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.6",
            "verseOrgIds": [
              "PSA.60.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 60:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gilead bụ nke m,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.7",
            "verseOrgIds": [
              "PSA.60.9"
            ]
          }
        },
        {
          "text": "otu a kwa, Manase bụkwa nke m;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.7",
            "verseOrgIds": [
              "PSA.60.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 60:7"
      },
      "items": [
        {
          "text": "Ifrem bụ okpu igwe m,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.7",
            "verseOrgIds": [
              "PSA.60.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 60:7"
      },
      "items": [
        {
          "text": "Juda bụ mkpara eze m.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.7",
            "verseOrgIds": [
              "PSA.60.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 60:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moab bụ efere ịkwọ aka m,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.8",
            "verseOrgIds": [
              "PSA.60.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 60:8"
      },
      "items": [
        {
          "text": "aga m atụsa akpụkpọụkwụ m nʼelu Edọm;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.8",
            "verseOrgIds": [
              "PSA.60.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 60:8"
      },
      "items": [
        {
          "text": "nʼelu isi Filistia, ana m eti mkpu mmeri.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.8",
            "verseOrgIds": [
              "PSA.60.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 60:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye ga-akpọrọ m gaa nʼobodo e wusiri ike?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.9",
            "verseOrgIds": [
              "PSA.60.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 60:9"
      },
      "items": [
        {
          "text": "Onye ga-edu m gaa Edọm?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.9",
            "verseOrgIds": [
              "PSA.60.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 60:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụghị gị, O Chineke? Gị onye jụrụ anyị,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.10",
            "verseOrgIds": [
              "PSA.60.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 60:10"
      },
      "items": [
        {
          "text": "onye na-adịghị esokwa ndị agha anyị aga agha?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.10",
            "verseOrgIds": [
              "PSA.60.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 60:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyere anyị aka ka anyị pụọ nʼaka ndị iro,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.11",
            "verseOrgIds": [
              "PSA.60.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 60:11"
      },
      "items": [
        {
          "text": "nʼihi na inyeaka mmadụ bụ ihe efu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.11",
            "verseOrgIds": [
              "PSA.60.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 60:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Site na Chineke, anyị ga-enwe mmeri,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.12",
            "verseOrgIds": [
              "PSA.60.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 60:12"
      },
      "items": [
        {
          "text": "ọ ga-azọpịa ndị iro anyị niile nʼala.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.12",
            "verseOrgIds": [
              "PSA.60.14"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "PSA.61",
    "number": "61",
