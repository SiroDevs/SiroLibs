    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "ms"
      },
      "items": [
        {
          "text": "Nchịkọta Akwụkwọ nke mbụ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "mr"
      },
      "items": [
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "PSA.1-PSA.41"
          },
          "items": [
            {
              "text": "Abụ Ọma 1–41",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Abụ Ọma 1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Onye ihe na-agara nke ọma",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye ihe na-agara nke ọma ka mmadụ ahụ bụ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.1.1",
            "verseOrgIds": [
              "PSA.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 1:1"
      },
      "items": [
        {
          "text": "onye na-adịghị aga ije na ndụmọdụ ndị na-emebi iwu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.1.1",
            "verseOrgIds": [
              "PSA.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 1:1"
      },
      "items": [
        {
          "text": "onye na-adịghị eguzokwa nʼụzọ ndị mmehie",
          "type": "text",
          "attrs": {
            "verseId": "PSA.1.1",
            "verseOrgIds": [
              "PSA.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 1:1"
      },
      "items": [
        {
          "text": "maọbụ soro nʼotu ndị nkwutọ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.1.1",
            "verseOrgIds": [
              "PSA.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kama ihe na-atọ ya ụtọ bụ ime ihe niile dị nʼiwu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.1.2",
            "verseOrgIds": [
              "PSA.1.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.1.2",
                "verseOrgIds": [
                  "PSA.1.2"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "PSA.1.2",
            "verseOrgIds": [
              "PSA.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 1:2"
      },
      "items": [
        {
          "text": "Ọ na-atụgharịkwa uche ya nʼiwu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.1.2",
            "verseOrgIds": [
              "PSA.1.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.1.2",
                "verseOrgIds": [
                  "PSA.1.2"
                ]
              }
            }
          ]
        },
        {
          "text": "ehihie na abalị,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.1.2",
            "verseOrgIds": [
              "PSA.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ dị ka osisi a kụrụ nʼakụkụ iyi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.1.3",
            "verseOrgIds": [
              "PSA.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 1:3"
      },
      "items": [
        {
          "text": "nke na-amịpụta mkpụrụ ya nʼoge ya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.1.3",
            "verseOrgIds": [
              "PSA.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 1:3"
      },
      "items": [
        {
          "text": "nke ahịhịa ya na-adịghị akpọnwụ akpọnwụ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.1.3",
            "verseOrgIds": [
              "PSA.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 1:3"
      },
      "items": [
        {
          "text": "Ihe niile ọ na-eme na-agara ya nke ọma.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.1.3",
            "verseOrgIds": [
              "PSA.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ndị ajọ omume adịghị otu a.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.1.4",
            "verseOrgIds": [
              "PSA.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 1:4"
      },
      "items": [
        {
          "text": "Ha dị ka igbugbo ọka",
          "type": "text",
          "attrs": {
            "verseId": "PSA.1.4",
            "verseOrgIds": [
              "PSA.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 1:4"
      },
      "items": [
        {
          "text": "nke oke ifufe na-efesasị.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.1.4",
            "verseOrgIds": [
              "PSA.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, ndị ajọ omume agaghị eguzosi ike nʼụbọchị ikpe;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.1.5",
            "verseOrgIds": [
              "PSA.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 1:5"
      },
      "items": [
        {
          "text": "ndị mmehie agaghị eguzokwa na nzukọ ndị ezi omume.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.1.5",
            "verseOrgIds": [
              "PSA.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na",
          "type": "text",
          "attrs": {
            "verseId": "PSA.1.6",
            "verseOrgIds": [
              "PSA.1.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.1.6",
                "verseOrgIds": [
                  "PSA.1.6"
                ]
              }
            }
          ]
        },
        {
          "text": "na-eche ụzọ ndị ezi omume nche.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.1.6",
            "verseOrgIds": [
              "PSA.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 1:6"
      },
      "items": [
        {
          "text": "Ma ụzọ ndị ajọ omume ga-eduba ha nʼịla nʼiyi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.1.6",
            "verseOrgIds": [
              "PSA.1.6"
            ]
          }
        }
      ]
    }
  ],
