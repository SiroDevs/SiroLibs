{
  "id": "PSA.84",
  "number": "84",
  "bookId": "PSA",
  "reference": "Abụ Ọma 84",
  "copyright": "Biblica® Open Igbo Contemporary Bible™ Copyright © 1980, 1988, 2019, 2020 by Biblica, Inc. Used with permission. All rights reserved worldwide.",
  "verseCount": 12,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "84",
        "style": "c",
        "sid": "PSA 84"
      },
      "items": [
        {
          "text": "84",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Abụ Ọma 84",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Abụ Ọma nke dịrị onyeisi Abụ. Abụ Ọma ụmụ Kora nʼusoro gittit.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Agụụ nke ụlọnsọ Chineke",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 84:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lee ka ebe obibi gị sị maa mma,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.1",
            "verseOrgIds": [
              "PSA.84.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 84:1"
      },
      "items": [
        {
          "text": "O",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.1",
            "verseOrgIds": [
              "PSA.84.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.84.1",
                "verseOrgIds": [
                  "PSA.84.2"
                ]
              }
            }
          ]
        },
        {
          "text": ", Onye pụrụ ime ihe niile!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.1",
            "verseOrgIds": [
              "PSA.84.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 84:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ na-agụsị mkpụrụobi m agụụ ike, e mkpụrụobi m na-adakwa mba,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.2",
            "verseOrgIds": [
              "PSA.84.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 84:2"
      },
      "items": [
        {
          "text": "ịbata nʼogige",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.2",
            "verseOrgIds": [
              "PSA.84.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.84.2",
                "verseOrgIds": [
                  "PSA.84.3"
                ]
              }
            }
          ]
        },
        {
          "text": ";",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.2",
            "verseOrgIds": [
              "PSA.84.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 84:2"
      },
      "items": [
        {
          "text": "mkpụrụobi m na anụ ahụ m na-eti mkpu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.2",
            "verseOrgIds": [
              "PSA.84.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 84:2"
      },
      "items": [
        {
          "text": "na-achọ Chineke dị ndụ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.2",
            "verseOrgIds": [
              "PSA.84.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 84:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụladị ụmụ nnụnụ nta nke eluigwe, achọtala ebe obibi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.3",
            "verseOrgIds": [
              "PSA.84.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 84:3"
      },
      "items": [
        {
          "text": "eleke achọtakwarala onwe ya akwụ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.3",
            "verseOrgIds": [
              "PSA.84.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 84:3"
      },
      "items": [
        {
          "text": "ebe ọ ga na-edebe ụmụ ya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.3",
            "verseOrgIds": [
              "PSA.84.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 84:3"
      },
      "items": [
        {
          "text": "nʼakụkụ ebe ịchụ aja nsọ gị,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.3",
            "verseOrgIds": [
              "PSA.84.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 84:3"
      },
      "items": [
        {
          "text": "O",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.3",
            "verseOrgIds": [
              "PSA.84.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.84.3",
                "verseOrgIds": [
                  "PSA.84.4"
                ]
              }
            }
          ]
        },
        {
          "text": ", Onye pụrụ ime ihe niile, Eze m na Chineke m.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.3",
            "verseOrgIds": [
              "PSA.84.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 84:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị a gọziri agọzi ka ndị bi nʼụlọ gị bụ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.4",
            "verseOrgIds": [
              "PSA.84.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 84:4"
      },
      "items": [
        {
          "text": "ha na-eto gị mgbe niile.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.4",
            "verseOrgIds": [
              "PSA.84.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "qs"
          },
          "items": [
            {
              "text": "Sela",
              "type": "text",
              "attrs": {
                "verseId": "PSA.84.4",
                "verseOrgIds": [
                  "PSA.84.5"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 84:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị a gọziri agọzi ka ha bụ, bụ ndị ike ha nwere dị na gị,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.5",
            "verseOrgIds": [
              "PSA.84.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 84:5"
      },
      "items": [
        {
          "text": "ndị kpebiri nʼobi ha ịga njem.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.5",
            "verseOrgIds": [
              "PSA.84.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 84:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ha na-esite na Ndagwurugwu Baka na-agafe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.6",
            "verseOrgIds": [
              "PSA.84.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 84:6"
      },
      "items": [
        {
          "text": "ha na-eme ya ka ọ bụrụ ebe isi iyi dị iche iche na-asọpụta;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.6",
            "verseOrgIds": [
              "PSA.84.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 84:6"
      },
      "items": [
        {
          "text": "mmiri ozuzo mbụ na-ewere ngọzị niile kpuchie ya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.6",
            "verseOrgIds": [
              "PSA.84.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 84:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ike ha na-abawanye abawanye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.7",
            "verseOrgIds": [
              "PSA.84.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 84:7"
      },
      "items": [
        {
          "text": "tutu ha niile nʼotu na otu, abịa guzo nʼihu Chineke na Zayọn.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.7",
            "verseOrgIds": [
              "PSA.84.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 84:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "O",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.8",
            "verseOrgIds": [
              "PSA.84.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.84.8",
                "verseOrgIds": [
                  "PSA.84.9"
                ]
              }
            }
          ]
        },
        {
          "text": ", Onye pụrụ ime ihe niile, nụrụ ekpere m.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.8",
            "verseOrgIds": [
              "PSA.84.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 84:8"
      },
      "items": [
        {
          "text": "Gee m ntị, gị Chineke nke Jekọb.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.8",
            "verseOrgIds": [
              "PSA.84.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 84:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lekwasị anya nʼọta anyị, O Chineke,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.9",
            "verseOrgIds": [
              "PSA.84.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 84:9"
      },
      "items": [
        {
          "text": "jiri ihuọma lekwasị onye gị e tere mmanụ anya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.9",
            "verseOrgIds": [
              "PSA.84.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 84:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otu mkpụrụ ụbọchị a nọrọ nʼime ogige gị,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.10",
            "verseOrgIds": [
              "PSA.84.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 84:10"
      },
      "items": [
        {
          "text": "karịrị puku ụbọchị a nọrọ ebe ọzọ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.10",
            "verseOrgIds": [
              "PSA.84.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 84:10"
      },
      "items": [
        {
          "text": "ọ ga-akara m mma ịbụ onye nche nʼọnụ ụzọ ụlọnsọ Chineke m,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.10",
            "verseOrgIds": [
              "PSA.84.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 84:10"
      },
      "items": [
        {
          "text": "karịa ibi nʼụlọ ikwu nke ndị ajọ omume.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.10",
            "verseOrgIds": [
              "PSA.84.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 84:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.84.11",
                "verseOrgIds": [
                  "PSA.84.12"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke bụ anyanwụ",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.11",
            "verseOrgIds": [
              "PSA.84.12"
            ]
          }
        },
        {
          "text": "na ọta;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.11",
            "verseOrgIds": [
              "PSA.84.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 84:11"
      },
      "items": [
        {
          "text": "Onyenwe anyị na-enye ihuọma na nsọpụrụ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.11",
            "verseOrgIds": [
              "PSA.84.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 84:11"
      },
      "items": [
        {
          "text": "ọ naghị egbochi ihe ọma ọbụla",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.11",
            "verseOrgIds": [
