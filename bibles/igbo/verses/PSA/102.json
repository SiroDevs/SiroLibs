        "vid": "PSA 102:26"
      },
      "items": [
        {
          "text": "ha ga-abụ ndị ewezugara ewezuga.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.26",
            "verseOrgIds": [
              "PSA.102.27"
            ]
