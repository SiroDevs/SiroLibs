  "verseCount": 28,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "102",
        "style": "c",
        "sid": "PSA 102"
      },
      "items": [
        {
          "text": "102",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Abụ Ọma 102",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Ekpere nke onye nọ na mmekpa ahụ na ọnọdụ ịda mba, na-ekwupụta otu o si dịrị ya nʼihu",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text"
            }
          ]
        },
        {
          "text": ".",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Arịrịọ maka ime ebere",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 102:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nụrụ ekpere m, O",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.1",
            "verseOrgIds": [
              "PSA.102.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.102.1",
                "verseOrgIds": [
                  "PSA.102.2"
                ]
              }
            }
          ]
        },
        {
          "text": ";",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.1",
            "verseOrgIds": [
              "PSA.102.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 102:1"
      },
      "items": [
        {
          "text": "ka ịkwa akwa m maka inyeaka ruo gị ntị.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.1",
            "verseOrgIds": [
              "PSA.102.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 102:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezonarịla m ihu gị",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.2",
            "verseOrgIds": [
              "PSA.102.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 102:2"
      },
      "items": [
        {
          "text": "nʼụbọchị nsogbu m.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.2",
            "verseOrgIds": [
              "PSA.102.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 102:2"
      },
      "items": [
        {
          "text": "Gee ntị nʼekpere m,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.2",
            "verseOrgIds": [
              "PSA.102.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 102:2"
      },
      "items": [
        {
          "text": "zakwaa m ngwangwa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.2",
            "verseOrgIds": [
              "PSA.102.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 102:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na ụbọchị m niile na-agabiga, dịka anwụrụ ọkụ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.3",
            "verseOrgIds": [
              "PSA.102.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 102:3"
      },
      "items": [
        {
          "text": "ọkpụkpụ m niile dịkwa ka ọlọkọ ọkụ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.3",
            "verseOrgIds": [
              "PSA.102.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 102:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkpụrụobi m etiwaala abụọ na-achanwụkwa dịka ahịhịa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.4",
            "verseOrgIds": [
              "PSA.102.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 102:4"
      },
      "items": [
        {
          "text": "ana m echefu iri nri m.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.4",
            "verseOrgIds": [
              "PSA.102.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 102:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi oke ịsụ ude m na-asụ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.5",
            "verseOrgIds": [
              "PSA.102.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 102:5"
      },
      "items": [
        {
          "text": "enwekwaghị m anụ ahụ ọbụla nʼahụ m. Abụ m naanị ọkpụkpụ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.5",
            "verseOrgIds": [
              "PSA.102.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 102:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adị m ka ikwighịkwighị nke ọzara,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.6",
            "verseOrgIds": [
              "PSA.102.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 102:6"
      },
      "items": [
        {
          "text": "a dị m ka ikwighịkwighị nʼetiti ebe dakpọsịrị adakpọsị.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.6",
            "verseOrgIds": [
              "PSA.102.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 102:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ana m amụ anya abalị niile;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.7",
            "verseOrgIds": [
              "PSA.102.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 102:7"
      },
      "items": [
        {
          "text": "adị m ka nwa nnụnụ naanị ya bekwasịrị nʼelu ụlọ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.7",
            "verseOrgIds": [
              "PSA.102.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 102:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụbọchị niile, ndị iro m na-eji m eme ihe ọchị;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.8",
            "verseOrgIds": [
              "PSA.102.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 102:8"
      },
      "items": [
        {
          "text": "ndị na-akwa m emo na-eji aha m mere ihe ịbụ ọnụ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.8",
            "verseOrgIds": [
              "PSA.102.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 102:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na ejirila m ntụ mere ihe oriri m,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.9",
            "verseOrgIds": [
              "PSA.102.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 102:9"
      },
      "items": [
        {
          "text": "anya mmiri m na-agwakọta nʼiko ihe ọṅụṅụ m",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.9",
            "verseOrgIds": [
              "PSA.102.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 102:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "nʼihi oke iwe gị,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.10",
            "verseOrgIds": [
              "PSA.102.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 102:10"
      },
      "items": [
        {
          "text": "i bulitela m, ma tụpụ m nʼakụkụ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.10",
            "verseOrgIds": [
              "PSA.102.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 102:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụbọchị m niile dịka onyinyo nke a na-ahụ anya mgbe anwụ na-ada.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.11",
            "verseOrgIds": [
              "PSA.102.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 102:11"
      },
      "items": [
        {
          "text": "Ana m akpọnwụ akpọnwụ, dịka ahịhịa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.11",
            "verseOrgIds": [
              "PSA.102.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 102:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma gị",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.12",
            "verseOrgIds": [
              "PSA.102.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.102.12",
                "verseOrgIds": [
                  "PSA.102.13"
                ]
              }
            }
          ]
        },
        {
          "text": ", na-anọgide nʼocheeze gị ruo mgbe ebighị ebi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.12",
            "verseOrgIds": [
              "PSA.102.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 102:12"
      },
      "items": [
        {
          "text": "aha gị ga-adịgide site nʼọgbọ ruo nʼọgbọ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.12",
            "verseOrgIds": [
              "PSA.102.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 102:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ị ga-ebili nwee ọmịiko nʼebe Zayọn nọ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.13",
            "verseOrgIds": [
              "PSA.102.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 102:13"
      },
      "items": [
        {
          "text": "nʼihi na oge izi ya ihuọma eruola;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.13",
            "verseOrgIds": [
              "PSA.102.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 102:13"
      },
      "items": [
        {
          "text": "oge ahụ a kara aka eruola.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.13",
            "verseOrgIds": [
              "PSA.102.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 102:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na nkume ya niile dị oke ọnụahịa nye ndị ohu gị;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.14",
            "verseOrgIds": [
              "PSA.102.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 102:14"
      },
      "items": [
        {
          "text": "mgbe ha hụrụ uzuzu ya, ha na-emere ya ebere.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.14",
            "verseOrgIds": [
              "PSA.102.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 102:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mba niile ga-atụ egwu aha",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.15",
            "verseOrgIds": [
              "PSA.102.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.102.15",
                "verseOrgIds": [
                  "PSA.102.16"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
