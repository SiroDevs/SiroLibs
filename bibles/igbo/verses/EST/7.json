  "verseCount": 10,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "7",
        "style": "c",
        "sid": "EST 7"
      },
      "items": [
        {
          "text": "7",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mkwụgbu Heman",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EST 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eze na Heman gara iri oriri ahụ Esta nwunye eze kpọrọ ha,",
          "type": "text",
          "attrs": {
            "verseId": "EST.7.1",
            "verseOrgIds": [
              "EST.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EST 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "mgbe ha nọ na-aṅụ mmanya, nʼụbọchị nke abụọ ahụ, eze jụrụ Esta ajụjụ sị, \"Gịnị bụ arịrịọ gị, Esta, eze nwanyị? Gịnị ka ị chọrọ? Ihe ọbụla ọ bụ, aga m enye gị ya, ọ bụladị otu ọkara alaeze m.\"",
          "type": "text",
          "attrs": {
            "verseId": "EST.7.2",
            "verseOrgIds": [
              "EST.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EST 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼikpeazụ, Esta nwunye eze zara sị, \"Eze biko, ọ bụrụ na m ahụtala amara nʼihu gị, ọ bụrụkwa na ọ masịrị gị, zọpụta ndụ m na ndụ ndị m.",
          "type": "text",
          "attrs": {
            "verseId": "EST.7.3",
            "verseOrgIds": [
              "EST.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EST 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na mụ na ndị m abụrụla ndị erere ere nʼaka ndị ga-ala anyị nʼiyi. Anyị abụrụla ndị a ga-egbu, na ndị aghaghị ịla nʼiyi. A sị na e rere anyị dịka ndị ohu nwoke na nwanyị, agaara m agba nkịtị, hapụ inye gị nsogbu, ma nʼihi nʼọdịghị ihe ga-akwụ ụgwọ isogbu eze.\"",
          "type": "text",
          "attrs": {
            "verseId": "EST.7.4",
            "verseOrgIds": [
              "EST.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EST 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eze, bụ Sekses, jụrụ Esta, bụ nwunye eze, \"Onye ka mmadụ ahụ bụ, olee ebe ọ nọ, bụ onye na-ezube ime ihe ọjọọ dị otu a?\"",
          "type": "text",
          "attrs": {
            "verseId": "EST.7.5",
            "verseOrgIds": [
              "EST.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EST 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esta zara, \"Ọ bụ onye iro na onye mmegide. Ọ bụ Heman, nwoke ọjọọ a!\"",
          "type": "text",
          "attrs": {
            "verseId": "EST.7.6",
            "verseOrgIds": [
              "EST.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EST 7:6"
      },
      "items": [
        {
          "text": "Mgbe ahụ, ụjọ dị ukwu jidere Heman nʼihu eze na nwunye eze.",
          "type": "text",
          "attrs": {
            "verseId": "EST.7.6",
            "verseOrgIds": [
              "EST.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EST 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eze biliri ọtọ nʼiwe,",
          "type": "text",
          "attrs": {
            "verseId": "EST.7.7",
            "verseOrgIds": [
              "EST.7.7"
            ]
          }
        },
        {
          "text": "hapụ mmanya ya site nʼebe oriri ahụ pụọ, gaa nʼime ubi ya a gbara ogige dị nʼụlọeze. Ma Heman nọdụrụ ịrịọ eze nwanyị, bụ Esta arịrịọ maka ndụ ya, nʼihi na ọ maara na eze ekpebiela ịla ndụ ya nʼiyi.",
          "type": "text",
          "attrs": {
            "verseId": "EST.7.7",
            "verseOrgIds": [
              "EST.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EST 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe eze sitere nʼubi a gbara ogige lọghachita nʼụlọ oriri ahụ, lee ka Heman tụrụ onwe ya nʼelu oche ahụ Esta na-adabere nʼelu ya.",
          "type": "text",
          "attrs": {
            "verseId": "EST.7.8",
            "verseOrgIds": [
              "EST.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EST 7:8"
      },
      "items": [
        {
          "text": "Eze sịrị, \"Ọ chọrọ iwedakwa nwunye eze nʼala nʼihu m nʼụlọ m?\"",
          "type": "text",
          "attrs": {
            "verseId": "EST.7.8",
            "verseOrgIds": [
              "EST.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EST 7:8"
      },
      "items": [
        {
          "text": "Ngwangwa okwu a si nʼọnụ eze pụta, ha kpuchiri Heman akwa nʼihu.",
          "type": "text",
          "attrs": {
            "verseId": "EST.7.8",
            "verseOrgIds": [
              "EST.7.8"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "EST.7.8",
            "verseOrgIds": [
              "EST.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EST 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ kwa, Habona otu nʼime ndị ozi eze gwara eze sị, \"Onyenwe m, lee na Heman enyela iwu ka a kwadoo osisi nke ịdị elu ya bụ iri mita abụọ na atọ, ebe ọ chọrọrị ịnọ kwụgbuo Mọdekai, nwoke ahụ mere ka a ghara igbu eze. Osisi ahụ guzokwa ugbu a nʼihu ụlọ Heman.\"",
          "type": "text",
          "attrs": {
            "verseId": "EST.7.9",
            "verseOrgIds": [
              "EST.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EST 7:9"
      },
      "items": [
        {
          "text": "Eze sịrị, \"Kwụgbuonụ ya nʼosisi ahụ!\"",
          "type": "text",
          "attrs": {
            "verseId": "EST.7.9",
            "verseOrgIds": [
              "EST.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EST 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, ha kwụgburu Heman nʼosisi ahụ ọ kwadoro maka Mọdekai. Iwe eze dajụkwara.",
          "type": "text",
          "attrs": {
            "verseId": "EST.7.10",
            "verseOrgIds": [
              "EST.7.10"
            ]
          }
        }
      ]
    }
  ],
