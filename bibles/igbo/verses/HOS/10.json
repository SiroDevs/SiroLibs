          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aga m abịa buso ndị mmehie a agha, nye ya ahụhụ;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.10",
            "verseOrgIds": [
              "HOS.10.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:10"
      },
      "items": [
        {
          "text": "mba ndị ọzọ ga-ebilite megide ha,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.10",
            "verseOrgIds": [
              "HOS.10.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:10"
      },
      "items": [
        {
          "text": "taa ha ahụhụ nʼihi ajọ omume abụọ ha.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.10",
            "verseOrgIds": [
              "HOS.10.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HOS 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ifrem bụ nne ehi a zụrụ azụ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.11",
            "verseOrgIds": [
              "HOS.10.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:11"
      },
      "items": [
        {
          "text": "nke hụrụ ịzọcha ọka nʼanya,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.11",
            "verseOrgIds": [
              "HOS.10.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 10:11"
      },
      "items": [
        {
          "text": "nʼihi ya, M ga-ekonye ịyagba nʼolu",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.11",
            "verseOrgIds": [
              "HOS.10.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:11"
      },
      "items": [
        {
          "text": "nʼolu ọma ya ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.11",
            "verseOrgIds": [
              "HOS.10.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 10:11"
      },
      "items": [
        {
          "text": "Aga m agba Ifrem dịka ịnyịnya,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.11",
            "verseOrgIds": [
              "HOS.10.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:11"
      },
      "items": [
        {
          "text": "Juda aghaghị ịkọ ala ubi",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.11",
            "verseOrgIds": [
              "HOS.10.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:11"
      },
      "items": [
        {
          "text": "Jekọb ga-akọze ala nye onwe ya.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.11",
            "verseOrgIds": [
              "HOS.10.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HOS 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, ghaanụ mkpụrụ ezi omume maka onwe unu,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.12",
            "verseOrgIds": [
              "HOS.10.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:12"
      },
      "items": [
        {
          "text": "unu ga-aghọtakwa mkpụrụ ịhụnanya.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.12",
            "verseOrgIds": [
              "HOS.10.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 10:12"
      },
      "items": [
        {
          "text": "Kọgharịakwanụ obi unu siri ike,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.12",
            "verseOrgIds": [
              "HOS.10.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:12"
      },
      "items": [
        {
          "text": "nʼihi na ugbu a bụ oge ịchọ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.12",
            "verseOrgIds": [
              "HOS.10.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "HOS.10.12",
                "verseOrgIds": [
                  "HOS.10.12"
                ]
              }
            }
          ]
