      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 10:12"
      },
      "items": [
        {
          "text": "tutu ruo mgbe ọ bịara",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.12",
            "verseOrgIds": [
              "HOS.10.12"
            ]
          }
        }
      ]
