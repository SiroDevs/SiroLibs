      "attrs": {
        "style": "q2",
        "vid": "HOS 10:15"
      },
      "items": [
        {
          "text": "a ga-ala eze Izrel nʼiyi kpamkpam.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.15",
            "verseOrgIds": [
              "HOS.10.15"
            ]
          }
        }
