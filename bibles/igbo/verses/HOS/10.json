          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma unu akụọla mkpụrụ ajọ omume;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.13",
            "verseOrgIds": [
              "HOS.10.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:13"
      },
      "items": [
        {
          "text": "unu aghọtakwala ihe ọjọọ dịka ihe ubi.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.13",
            "verseOrgIds": [
              "HOS.10.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:13"
      },
      "items": [
        {
          "text": "Unu eriela mkpụrụ osisi ụgha.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.13",
            "verseOrgIds": [
              "HOS.10.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 10:13"
      },
      "items": [
        {
          "text": "Nʼihi na unu atụkwasịla obi unu nʼịdị ike nke onwe unu,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.13",
            "verseOrgIds": [
              "HOS.10.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:13"
      },
      "items": [
        {
          "text": "na nʼịdị ọtụtụ nke ndị bụ dike nʼagha unu.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.13",
            "verseOrgIds": [
              "HOS.10.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
