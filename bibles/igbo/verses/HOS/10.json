      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:12"
      },
      "items": [
        {
          "text": "wụkwasị unu mmiri ozuzo dịka ezi omume.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.12",
            "verseOrgIds": [
              "HOS.10.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
