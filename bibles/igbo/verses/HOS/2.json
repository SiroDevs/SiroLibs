      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:13"
      },
      "items": [
        {
          "text": "bụ nke o surere ihe na-esi isi ụtọ nye chi Baal niile,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.13",
            "verseOrgIds": [
