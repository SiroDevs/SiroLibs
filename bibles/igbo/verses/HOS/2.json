          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nʼihi nke a, aga m arara ya,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.14",
            "verseOrgIds": [
              "HOS.2.16"
