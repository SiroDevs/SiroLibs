      "attrs": {
        "style": "q2",
        "vid": "HOS 2:12"
      },
      "items": [
        {
          "text": "nke ọ sịrị bụ ụgwọ ọrụ ya site nʼaka ndị hụrụ ya nʼanya;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.12",
            "verseOrgIds": [
