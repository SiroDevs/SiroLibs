              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aga m ala ubi vaịnị ya na osisi fiig ya niile nʼiyi,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.12",
            "verseOrgIds": [
