      "attrs": {
        "style": "q2",
        "vid": "HOS 9:11"
      },
      "items": [
        {
          "text": "nʼihi na ọmụmụ nwa agaghị adị, a gaghị atụkwa ime, agaghị adịkwa ime.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.11",
            "verseOrgIds": [
              "HOS.9.11"
            ]
          }
        }
      ]
