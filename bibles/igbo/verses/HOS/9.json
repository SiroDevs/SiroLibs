      "attrs": {
        "style": "q2",
        "vid": "HOS 9:10"
      },
      "items": [
        {
          "text": "ọ dị ka m chọtara mkpụrụ grepu nʼọzara;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.10",
            "verseOrgIds": [
              "HOS.9.10"
            ]
