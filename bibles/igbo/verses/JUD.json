    "verseCount": 25,
    "content": [
      {
        "name": "chapter",
        "type": "tag",
        "attrs": {
          "number": "1",
          "style": "c",
          "sid": "JUD 1"
        },
        "items": [
          {
            "text": "1",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "1",
              "style": "v",
              "sid": "JUD 1:1"
            },
            "items": [
              {
                "text": "1",
                "type": "text"
              }
            ]
          },
          {
            "text": "Jud, odibo Jisọs Kraịst, na nwanne Jemis,",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.1",
              "verseOrgIds": [
                "JUD.1.1"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "b",
          "vid": "JUD 1:1"
        },
        "items": []
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p",
          "vid": "JUD 1:1"
        },
        "items": [
          {
            "text": "Na-edegara ndị niile a kpọrọ, ndị ahụrụ nʼanya nʼime Chineke, bụ Nna, na ndị nọkwa nʼokpuru nchebe Jisọs Kraịst akwụkwọ ozi a:",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.1",
              "verseOrgIds": [
                "JUD.1.1"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "b"
        },
        "items": []
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "2",
              "style": "v",
              "sid": "JUD 1:2"
            },
            "items": [
              {
                "text": "2",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ka ebere na udo na ịhụnanya bara unu ụba.",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.2",
              "verseOrgIds": [
                "JUD.1.2"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "b"
        },
        "items": []
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "s1"
        },
        "items": [
          {
            "text": "Mmehie na ịla nʼiyi nke ndị ajọ omume",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "3",
              "style": "v",
              "sid": "JUD 1:3"
            },
            "items": [
              {
                "text": "3",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ndị m hụrụ nʼanya, ebe ọ na-anụ m ọkụ nʼobi idere unu akwụkwọ banyere nzọpụta ahụ anyị nwekọrọ nʼotu, ma ahụrụ m mkpa ọ dị idere unu akwụkwọ a, ịrịọ unu ka unu guzosie ike buo agha ichebe okwukwe ahụ, nke e nyefere ndị nsọ nʼaka idebe.",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.3",
              "verseOrgIds": [
                "JUD.1.3"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "4",
              "style": "v",
              "sid": "JUD 1:4"
            },
            "items": [
              {
                "text": "4",
                "type": "text"
              }
            ]
          },
          {
            "text": "Nʼihi na ụfọdụ mmadụ, bụ ndị e dere ihe banyere ọmụma ikpe dịrị ha, siterị nʼoge gara aga, ezobatala nʼetiti unu. Ha bụ ndị na-adịghị asọpụrụ Chineke, ndị na-agbanwe amara Chineke anyị, mee ya ka ọ bụrụ ohere ha nwere ibi ndụ ịkwa iko, na nke ịgọnarị Jisọs Kraịst, onye naanị ya bụ Onye kachasị ihe niile elu na Onyenwe.",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.4",
              "verseOrgIds": [
                "JUD.1.4"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "5",
              "style": "v",
              "sid": "JUD 1:5"
            },
            "items": [
              {
                "text": "5",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ọ bụ ezie na unu maa ihe ndị a niile, ma achọrọ m ichetara unu otu Onyenwe anyị si zọpụta ndị ya site nʼala Ijipt, ma mesịa laa ndị niile na-ekweghị ekwe nʼiyi.",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.5",
              "verseOrgIds": [
                "JUD.1.5"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "6",
              "style": "v",
              "sid": "JUD 1:6"
            },
            "items": [
              {
                "text": "6",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ndị mmụọ ozi nupuru isi, ndị na-anọgideghị nʼọnọdụ e nyere ha, kama ha si nʼebe obibi ha gbapụ. O jirila igwe kee ha agbụ ebighị ebi, debe ha nʼọchịchịrị nʼime ala, ebe ha ga-anọ ruo ụbọchị ikpe ahụ dị egwu.",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.6",
              "verseOrgIds": [
                "JUD.1.6"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "7",
              "style": "v",
              "sid": "JUD 1:7"
            },
            "items": [
              {
                "text": "7",
                "type": "text"
              }
            ]
          },
          {
            "text": "Otu a kwa, Sọdọm na Gọmọra na obodo niile gbara ha gburugburu, bụ ndị nyefere onwe ha na ndụ ịkwa iko nakwa omume ibi ndụ ọjọọ dị iche iche nke anụ ahụ, bụ ihe ịdọ aka na ntị nye ndị mmadụ site nʼahụhụ ha tara nʼihi mmehie nʼime ọkụ ebighị ebi.",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.7",
              "verseOrgIds": [
                "JUD.1.7"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "8",
              "style": "v",
              "sid": "JUD 1:8"
            },
            "items": [
              {
                "text": "8",
                "type": "text"
              }
            ]
          },
          {
            "text": "Nʼụzọ dị otu a kwa, ndị a na-emerụ anụ ahụ ha nʼirọ nrọ ha, na-ajụkwa ike ọchịchị niile, ma na-ekwulukwa ndị ahụ jupụtara nʼebube nke anya na-adịghị ahụ.",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.8",
              "verseOrgIds": [
                "JUD.1.8"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "9",
              "style": "v",
              "sid": "JUD 1:9"
            },
            "items": [
              {
                "text": "9",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ma Maikel onyeisi ndị mmụọ ozi, mgbe o guzogidere ekwensu na-arụrịtakwa ụka banyere ozu Mosis, ya onwe ya enweghị anya ike ịma ya ikpe nʼihi okwu nkwulu, kama ọ sịrị, \"Ka Onyenwe anyị baara gị mba.\"",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.9",
              "verseOrgIds": [
                "JUD.1.9"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "10",
              "style": "v",
              "sid": "JUD 1:10"
            },
            "items": [
              {
                "text": "10",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ma ndị a na-ekwulu ihe niile ọbụla ha na-aghọtaghị. Dịka ụmụ anụmanụ a na-azụghị azụ, ha na-eme ihe ọbụla dị ha mma nʼanya si otu a na-ala onwe ha nʼiyi.",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.10",
              "verseOrgIds": [
                "JUD.1.10"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "11",
              "style": "v",
              "sid": "JUD 1:11"
            },
            "items": [
              {
                "text": "11",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ahụhụ ga-adịrị ha, nʼihi na ha soro nzọ ụkwụ Ken, nyefee onwe ha na ndahie Belam nʼihi ihe nrite nʼuru, ma laa nʼiyi na nnupu isi Kora.",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.11",
              "verseOrgIds": [
                "JUD.1.11"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "12",
              "style": "v",
              "sid": "JUD 1:12"
            },
            "items": [
              {
                "text": "12",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ndị a bụ ihe ntụpọ nʼetiti unu nʼoge mmemme oriri ịhụnanya unu, ha na-eso unu na-erikọ nri na-atụghị egwu ọbụla. Ha bụ ndị na-elekọta naanị onwe ha. Ha dị ka igwe ojii nke na-adịghị ezo mmiri, nke ifufe na-ebugharị. Ha bụ osisi a na-ahụ nʼoge ọkọchị nke na-adịghị amị mkpụrụ, nke e si na mgbọrọgwụ ya hoputa, nke nwụrụ anwụ ugboro abụọ.",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.12",
              "verseOrgIds": [
                "JUD.1.12"
              ]
            }
          },
          {
            "text": "",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.12",
              "verseOrgIds": [
                "JUD.1.12"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "13",
              "style": "v",
              "sid": "JUD 1:13"
            },
            "items": [
              {
                "text": "13",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ha bụ ebili mmiri na-amagharị nʼosimiri, nke na-asọpụta ihere ha dịka ụfụfụ, kpakpando na-awagharị awagharị, bụ ndị nke a kwadooro ebe kachasị ịgba ọchịchịrị ruo ebighị ebi.",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.13",
              "verseOrgIds": [
                "JUD.1.13"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "14",
              "style": "v",
              "sid": "JUD 1:14"
            },
            "items": [
              {
                "text": "14",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ọ bụ nʼihi ihe ndị a ka Enọk, onye bụ agbụrụ nke asaa site nʼAdam buru nʼamụma banyere ha sị, \"Lee! Onyenwe anyị na-abịa, ya na puku kwụrụ puku ndị nsọ ya.",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.14",
              "verseOrgIds": [
                "JUD.1.14"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "15",
              "style": "v",
              "sid": "JUD 1:15"
            },
            "items": [
              {
                "text": "15",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ọ na-abịa ikpe mmadụ niile ikpe, na ịtụ ha niile mmehie ajọ omume niile ha nʼanya, bụ nke ha mere nʼụzọ na-ezighị ezi. Tinyere okwu ọjọọ niile nke ndị mmehie ndị na-adịghị asọpụrụ Chineke kwuru megide ya.\"",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.15",
              "verseOrgIds": [
                "JUD.1.15"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "16",
              "style": "v",
              "sid": "JUD 1:16"
            },
            "items": [
              {
                "text": "16",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ndị a bụ ndị na-atamu ntamu oge niile, ndị o nweghị ihe ọbụla na-adị ha mma. Ndị na-agbaso agụ ihe ọjọọ niile nke anụ ahụ ha chọrọ. Ha na-anya isi banyere onwe ha, na-aja ndị ọzọ mma; ka ha nwee ike nweta ihe ha na-achọ nʼaka ha.",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.16",
              "verseOrgIds": [
                "JUD.1.16"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "s1"
        },
        "items": [
          {
            "text": "Ịdọ aka na ntị na ndụmọdụ",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "17",
              "style": "v",
              "sid": "JUD 1:17"
            },
            "items": [
              {
                "text": "17",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ma unu, ndị m hụrụ nʼanya, chetanụ ihe ndị ozi Onyenwe anyị Jisọs Kraịst kwuru na ha ga-emezu.",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.17",
              "verseOrgIds": [
                "JUD.1.17"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "18",
              "style": "v",
              "sid": "JUD 1:18"
            },
            "items": [
              {
                "text": "18",
                "type": "text"
              }
            ]
          },
          {
            "text": "Nʼihi na ha sịrị unu, \"Nʼọgwụgwụ oge ahụ, ndị na-eji ihe niile na-emere ihe ọchị ga-adị. Ndị na-agbaso agụ ihe ọjọọ niile nke anụ ahụ ha chọrọ.",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.18",
              "verseOrgIds": [
                "JUD.1.18"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "19",
              "style": "v",
              "sid": "JUD 1:19"
            },
            "items": [
              {
                "text": "19",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ọ bụ ndị anụ ahụ ha na-achị, ndị na-enweghị Mmụọ Nsọ nʼime ha, bụ ndị na-eweta nkewa nʼetiti unu.\"",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.19",
              "verseOrgIds": [
                "JUD.1.19"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "20",
              "style": "v",
              "sid": "JUD 1:20"
            },
            "items": [
              {
                "text": "20",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ma unu, ndị m hụrụ nʼanya, nọgidenụ na-ewuli onwe unu elu na ntọala okwukwe unu dịkarịsịrị nsọ. Na-ekpekwanụ ekpere nʼime Mmụọ Nsọ.",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.20",
              "verseOrgIds": [
                "JUD.1.20"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "21",
              "style": "v",
              "sid": "JUD 1:21"
            },
            "items": [
              {
                "text": "21",
                "type": "text"
              }
            ]
          },
          {
            "text": "Doonụ onwe unu nʼokpuru ịhụnanya Chineke, dịka unu na-echere ebere Onyenwe anyị Jisọs Kraịst nke na-eduba na ndụ ebighị ebi.",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.21",
              "verseOrgIds": [
                "JUD.1.21"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "22",
              "style": "v",
              "sid": "JUD 1:22"
            },
            "items": [
              {
                "text": "22",
                "type": "text"
              }
            ]
          },
          {
            "text": "Gosinụ ụfọdụ ndị na-enwe obi abụọ ebere.",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.22",
              "verseOrgIds": [
                "JUD.1.22"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "23",
              "style": "v",
              "sid": "JUD 1:23"
            },
            "items": [
              {
                "text": "23",
                "type": "text"
              }
            ]
          },
          {
            "text": "Zọpụtanụ ndị ọzọ site nʼịgụpụta ha nʼọkụ. Nʼebe ndị ọzọ nọ gosinụ ha obi ebere, kama jirinụ ịtụ egwu mee nke a, kpọọnụ ọ bụladị uwe nke anụ ahụ mmehie merụrụ asị.",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.23",
              "verseOrgIds": [
                "JUD.1.23"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "b"
        },
        "items": []
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "s1"
        },
