      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "ms1"
      },
      "items": [
        {
          "text": "Masumu ememaka na libebi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kosambisama ya Isalaele",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HOS 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bana ya Isalaele, boyoka Liloba na Yawe !",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.1",
            "verseOrgIds": [
              "HOS.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 4:1"
      },
      "items": [
        {
          "text": "Pamba te Yawe azali kosamba",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.1",
            "verseOrgIds": [
              "HOS.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 4:1"
      },
      "items": [
        {
          "text": "na bino, bavandi ya mokili,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.1",
            "verseOrgIds": [
              "HOS.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 4:1"
      },
      "items": [
        {
          "text": "mpo ete bosolo, bolingo mpe boyebi ya Nzambe",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.1",
            "verseOrgIds": [
              "HOS.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 4:1"
      },
      "items": [
        {
          "text": "ezali lisusu te kati na mokili ;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.1",
            "verseOrgIds": [
              "HOS.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HOS 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "etikali kaka kolakelana mabe, lokuta,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.2",
            "verseOrgIds": [
              "HOS.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 4:2"
      },
      "items": [
        {
          "text": "makambo ya somo, moyibi, kindumba,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.2",
            "verseOrgIds": [
              "HOS.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 4:2"
      },
      "items": [
        {
          "text": "mobulu mpe kobomana se kobomana.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.2",
            "verseOrgIds": [
              "HOS.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HOS 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpo na yango, mokili ekokoma na mawa,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.3",
            "verseOrgIds": [
              "HOS.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 4:3"
      },
      "items": [
        {
          "text": "bavandi na yango nyonso bakolemba nzoto,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.3",
            "verseOrgIds": [
              "HOS.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 4:3"
      },
      "items": [
        {
          "text": "nyama ya zamba, ndeke ya likolo",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.3",
            "verseOrgIds": [
              "HOS.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 4:3"
      },
      "items": [
        {
          "text": "mpe mbisi ya ebale monene ekokufa.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.3",
            "verseOrgIds": [
              "HOS.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HOS 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasi tika ete moto moko te amilongisa",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.4",
            "verseOrgIds": [
              "HOS.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 4:4"
      },
      "items": [
        {
          "text": "to apamela moninga na ye,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.4",
            "verseOrgIds": [
              "HOS.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 4:4"
      },
      "items": [
        {
          "text": "pamba te bato na yo bazali lokola bato",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.4",
            "verseOrgIds": [
              "HOS.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 4:4"
      },
      "items": [
        {
          "text": "oyo batiaka tembe na Banganga-Nzambe !",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.4",
            "verseOrgIds": [
              "HOS.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HOS 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bokobeta mabaku, na moyi makasi ;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.5",
            "verseOrgIds": [
              "HOS.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 4:5"
      },
      "items": [
        {
          "text": "basakoli mpe bakobeta mabaku elongo na bino, na butu,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.5",
            "verseOrgIds": [
              "HOS.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 4:5"
      },
      "items": [
        {
          "text": "mpe nakobebisa mama na bino.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.5",
            "verseOrgIds": [
              "HOS.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HOS 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bato na Ngai bakobebisama",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.6",
            "verseOrgIds": [
              "HOS.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 4:6"
      },
      "items": [
        {
          "text": "mpo ete bazangi boyebi.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.6",
            "verseOrgIds": [
              "HOS.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "HOS 4:6"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 4:6"
      },
      "items": [
        {
          "text": "Lokola bobwaki boyebi,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.6",
            "verseOrgIds": [
              "HOS.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 4:6"
      },
      "items": [
        {
          "text": "Ngai mpe nakobwaka bino",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.6",
            "verseOrgIds": [
              "HOS.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 4:6"
      },
      "items": [
        {
          "text": "mpe nakolongola bino na bonganga-Nzambe na Ngai.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.6",
            "verseOrgIds": [
              "HOS.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 4:6"
      },
      "items": [
        {
          "text": "Lokola bobosani Mobeko ya Nzambe na bino,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.6",
            "verseOrgIds": [
              "HOS.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 4:6"
      },
      "items": [
        {
          "text": "Ngai mpe nakobosana bana na bino.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.6",
            "verseOrgIds": [
              "HOS.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HOS 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndenge Banganga-Nzambe bakomaki ebele,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.7",
            "verseOrgIds": [
              "HOS.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 4:7"
      },
      "items": [
        {
          "text": "ndenge wana mpe basalaki masumu na miso na Ngai.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.7",
            "verseOrgIds": [
              "HOS.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 4:7"
      },
      "items": [
        {
          "text": "Nakobongola nkembo na bango soni.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.7",
            "verseOrgIds": [
              "HOS.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HOS 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Banganga-Nzambe baliaka",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.8",
            "verseOrgIds": [
              "HOS.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 4:8"
      },
      "items": [
        {
          "text": "na sima ya masumu ya bato na Ngai",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.8",
            "verseOrgIds": [
              "HOS.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 4:8"
      },
      "items": [
        {
          "text": "mpe basepelaka ete bato basala kaka mabe.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.8",
            "verseOrgIds": [
              "HOS.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HOS 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makambo oyo ekokomela bato yango",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.9",
            "verseOrgIds": [
              "HOS.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 4:9"
      },
      "items": [
        {
          "text": "ekokomela mpe Banganga-Nzambe :",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.9",
            "verseOrgIds": [
              "HOS.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 4:9"
      },
      "items": [
        {
          "text": "nakopesa bango nyonso etumbu nzela moko",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.9",
            "verseOrgIds": [
              "HOS.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 4:9"
      },
      "items": [
        {
          "text": "mpo na etamboli na bango",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.9",
            "verseOrgIds": [
              "HOS.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 4:9"
      },
      "items": [
        {
          "text": "mpe nakofuta bango kolanda misala na bango.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.9",
            "verseOrgIds": [
              "HOS.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HOS 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakolia, kasi bakotonda te ;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.10",
            "verseOrgIds": [
              "HOS.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 4:10"
      },
      "items": [
        {
          "text": "bakosala kindumba, kasi bakobotana te ;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.10",
            "verseOrgIds": [
              "HOS.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 4:10"
      },
      "items": [
        {
          "text": "pamba te basundolaki Yawe",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.10",
            "verseOrgIds": [
              "HOS.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HOS 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "mpo na komipesa na kindumba,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.11",
            "verseOrgIds": [
              "HOS.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
