  "verseCount": 14,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "8",
        "style": "c",
        "sid": "HOS 8"
      },
      "items": [
        {
          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Etumbu ya Isalaele",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HOS 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tia kelelo na monoko na yo !",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.1",
            "verseOrgIds": [
              "HOS.8.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 8:1"
      },
      "items": [
        {
          "text": "Lokola mpongo, pasi ekokitela Ndako ya Yawe,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.1",
            "verseOrgIds": [
              "HOS.8.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 8:1"
      },
      "items": [
        {
          "text": "mpo ete babebisi boyokani na Ngai",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.1",
            "verseOrgIds": [
              "HOS.8.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 8:1"
      },
      "items": [
        {
          "text": "mpe batombokeli Mobeko na Ngai.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.1",
            "verseOrgIds": [
              "HOS.8.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HOS 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isalaele azali kobelela Ngai :",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.2",
            "verseOrgIds": [
              "HOS.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 8:2"
      },
      "items": [
        {
          "text": "« Oh Nzambe na biso, toyebi Yo ! »",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.2",
            "verseOrgIds": [
              "HOS.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HOS 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasi Isalaele abwaki makambo malamu ;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.3",
            "verseOrgIds": [
              "HOS.8.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 8:3"
      },
      "items": [
        {
          "text": "yango wana, monguna akolanda ye.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.3",
            "verseOrgIds": [
              "HOS.8.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HOS 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batunaki Ngai te",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.4",
            "verseOrgIds": [
              "HOS.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 8:4"
      },
      "items": [
        {
          "text": "tango batiaki bakonzi mpe baponaki bakambi.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.4",
            "verseOrgIds": [
              "HOS.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 8:4"
      },
      "items": [
        {
          "text": "Bamisalelaki banzambe ya bikeko",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.4",
            "verseOrgIds": [
              "HOS.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 8:4"
      },
      "items": [
        {
          "text": "na palata mpe na wolo na bango",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.4",
            "verseOrgIds": [
              "HOS.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 8:4"
      },
      "items": [
        {
          "text": "mpo na libebi na bango moko.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.4",
            "verseOrgIds": [
              "HOS.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HOS 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oh Samari, nzambe na yo ya ekeko",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.5",
            "verseOrgIds": [
              "HOS.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 8:5"
      },
      "items": [
        {
          "text": "ya mwana ngombe ya mobali ezali nkele !",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.5",
            "verseOrgIds": [
              "HOS.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 8:5"
      },
      "items": [
        {
          "text": "Kanda na Ngai epeli mpo na kobebisa bango.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.5",
            "verseOrgIds": [
              "HOS.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 8:5"
      },
      "items": [
        {
          "text": "Kino tango nini bakokoka te kotambola na bopeto ?",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.5",
            "verseOrgIds": [
              "HOS.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HOS 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ewuti na Isalaele !",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.6",
            "verseOrgIds": [
              "HOS.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 8:6"
      },
      "items": [
        {
          "text": "Ekeko wana ya mwana ngombe ya mobali,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.6",
            "verseOrgIds": [
              "HOS.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 8:6"
      },
      "items": [
        {
          "text": "ezali monyangwisi bibende na moto nde asala yango ;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.6",
            "verseOrgIds": [
              "HOS.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 8:6"
      },
      "items": [
        {
          "text": "ezali Nzambe te.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.6",
            "verseOrgIds": [
              "HOS.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 8:6"
      },
      "items": [
        {
          "text": "Bakobuka yango biteni-biteni,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.6",
            "verseOrgIds": [
              "HOS.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 8:6"
      },
      "items": [
        {
          "text": "mwana ngombe wana ya Samari.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.6",
            "verseOrgIds": [
              "HOS.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HOS 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "« Lokola baloni mopepe,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.7",
            "verseOrgIds": [
              "HOS.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 8:7"
      },
      "items": [
        {
          "text": "bakobuka mopepe ya makasi.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.7",
            "verseOrgIds": [
              "HOS.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 8:7"
      },
      "items": [
        {
          "text": "Nzete ya ble oyo ezanga moto ebimisaka farine te.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.7",
            "verseOrgIds": [
              "HOS.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 8:7"
      },
      "items": [
        {
          "text": "Ezala soki ebimisi mito,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.7",
            "verseOrgIds": [
              "HOS.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 8:7"
      },
      "items": [
        {
          "text": "ezali bapaya nde bakolia yango.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.7",
            "verseOrgIds": [
              "HOS.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HOS 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isalaele abebisami ;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.8",
            "verseOrgIds": [
              "HOS.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 8:8"
      },
      "items": [
        {
          "text": "tala bango wana kati na bikolo,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.8",
            "verseOrgIds": [
              "HOS.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 8:8"
      },
      "items": [
        {
          "text": "bazali komonana lokola biloko pamba !",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.8",
            "verseOrgIds": [
              "HOS.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HOS 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamba te bakendeki na Asiri",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.9",
            "verseOrgIds": [
              "HOS.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 8:9"
      },
      "items": [
        {
          "text": "lokola ane ya zamba oyo ezali kotelengana yango moko.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.9",
            "verseOrgIds": [
              "HOS.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 8:9"
      },
      "items": [
        {
          "text": "Efrayimi apesaki bakado epai ya bamakangu na ye.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.9",
            "verseOrgIds": [
              "HOS.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HOS 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ata apesaki bakado kati na bikolo,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.10",
            "verseOrgIds": [
              "HOS.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 8:10"
      },
      "items": [
        {
          "text": "sik'oyo Ngai nakosangisa bango esika moko",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.10",
            "verseOrgIds": [
              "HOS.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 8:10"
      },
      "items": [
        {
          "text": "mpe bakobanda kosila kokufa na se ya minyoko",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.10",
            "verseOrgIds": [
              "HOS.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 8:10"
      },
      "items": [
        {
          "text": "ya mokonzi moko ya nguya.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.10",
            "verseOrgIds": [
              "HOS.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HOS 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ata Efrayimi atongi bitumbelo ebele",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.11",
            "verseOrgIds": [
              "HOS.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 8:11"
      },
      "items": [
        {
          "text": "mpo na kolongola masumu na ye,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.11",
            "verseOrgIds": [
              "HOS.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 8:11"
      },
      "items": [
        {
          "text": "kasi bitumbelo yango ekomemisa ye kaka masumu.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.11",
            "verseOrgIds": [
              "HOS.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HOS 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
