      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EPH 1:3"
      },
      "items": [
        {
          "text": "oyo apesi biso kati na bisika ya Likolo,",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.3",
            "verseOrgIds": [
              "EPH.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EPH 1:3"
      },
      "items": [
        {
          "text": "mapamboli nyonso ya Molimo kati na Klisto.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.3",
            "verseOrgIds": [
              "EPH.1.3"
            ]
          }
        }
      ]
    },
    {
