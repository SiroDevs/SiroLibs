          "text": "Tika ete lokumu epesamela",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.3",
            "verseOrgIds": [
              "EPH.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EPH 1:3"
      },
      "items": [
        {
          "text": "Nzambe mpe Tata ya Yesu-Klisto, Nkolo na biso,",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.3",
            "verseOrgIds": [
              "EPH.1.3"
