  "verseCount": 28,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "25",
        "style": "c",
        "sid": "2CH 25"
      },
      "items": [
        {
          "text": "25",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Amatsia, mokonzi ya Yuda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "2KI.14.1-2KI.14.6"
          },
          "items": [
            {
              "text": "2Ba 14.1-6",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 25:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amatsia azalaki na mibu tuku mibale na mitano ya mbotama tango akomaki mokonzi, mpe akonzaki mibu tuku mibale na libwa na Yelusalemi. Kombo ya mama na ye ezalaki « Yeoyadani. » Yeoyadani azalaki moto ya Yelusalemi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.1",
            "verseOrgIds": [
              "2CH.25.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asalaki makambo ya sembo na miso ya Yawe, kasi na motema na ye mobimba te.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.2",
            "verseOrgIds": [
              "2CH.25.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sima na Amatsia kolendisa bokonzi na ye, abomaki bakalaka oyo babomaki tata na ye, mokonzi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.3",
            "verseOrgIds": [
              "2CH.25.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzokande, abomaki te bana mibali ya babomi ya tata na ye, pamba te kolanda ndenge ekomama kati na Mobeko, kati na buku ya Moyize, Yawe apesaki mitindo oyo : « Bakoboma batata te mpo na bana na bango to mpe bakoboma bana te mpo na batata ; bakoboma moto na moto mpo na masumu na ye moko. »",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.4",
            "verseOrgIds": [
              "2CH.25.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amatsia abengisaki bato ya Yuda mpe atiaki, kolanda mabota na bango, bakonzi ya bankoto mpe ya bankama mpo na Yuda mobimba mpe Benjame. Atangaki motango ya bato oyo bazalaki na mibu kobanda tuku mibale mpe komata : bazalaki mibali nkoto nkama misato oyo baselingwa mpo na kosala mosala ya soda, kobunda na makonga mpe na nguba.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.5",
            "verseOrgIds": [
              "2CH.25.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kati na Isalaele, azwaki lisusu na mosala ya soda, na motuya ya bakilo nkoto misato na nkama mitano ya palata, basoda ya mpiko nkoto nkama moko.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.6",
            "verseOrgIds": [
              "2CH.25.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasi moto moko ya Nzambe ayaki epai na ye mpe alobaki :",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.7",
            "verseOrgIds": [
              "2CH.25.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "2CH 25:7"
      },
      "items": [
        {
          "text": "— Oh mokonzi, tika ete basoda ya Isalaele bakende te elongo na yo na bitumba, pamba te Yawe azali te elongo na Isalaele mpe elongo na bato ya Efrayimi.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ata soki okeyi kobunda na mpiko nyonso, Nzambe akokweyisa yo liboso ya monguna, pamba te azali na makoki ya kosunga mpe ya kokweyisa.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amatsia atunaki moto na Nzambe :",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.9",
            "verseOrgIds": [
              "2CH.25.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "2CH 25:9"
      },
      "items": [
        {
          "text": "— Boni, nkoto misato na nkama mitano ya bakilo ya palata oyo napesaki mampinga ya Isalaele ekosuka ndenge nini ?",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2CH 25:9"
      },
      "items": [
        {
          "text": "Moto na Nzambe azongisaki :",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.9",
            "verseOrgIds": [
              "2CH.25.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "2CH 25:9"
      },
      "items": [
        {
          "text": "— Yawe akoki kopesa yo koleka oyo wana.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boye, Amatsia azongisaki na bandako na bango, basoda oyo bayaki epai na ye wuta na Efrayimi. Kasi basoda yango basilikelaki Yuda mpe bazongaki na bandako na bango na kanda makasi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.10",
            "verseOrgIds": [
              "2CH.25.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "2KI.14.7-2KI.14.14"
          },
          "items": [
            {
              "text": "2Ba 14.7-14",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amatsia azwaki mpiko mpe akambaki mampinga na ye kino na Lubwaku ya mungwa epai wapi abomaki bato ya Seiri nkoto zomi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.11",
            "verseOrgIds": [
              "2CH.25.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bato ya Yuda bakangaki lisusu bato ya bomoi nkoto zomi, bamemaki bango na songe ya ngomba mpe batindikaki bango wuta na songe ya ngomba ; mpe bango nyonso bakweyaki na se, banzoto na epanzanaki na biteni.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.12",
            "verseOrgIds": [
              "2CH.25.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 25:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na tango wana, basoda oyo Amatsia azongisaki mpe apekisaki kokende na bitumba bakotaki na makasi kati na bingumba ya Yuda longwa na Samari kino na Beti-Oroni. Babomaki bato nkoto misato mpe bamemaki bomengo ebele ya bitumba.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.13",
            "verseOrgIds": [
              "2CH.25.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Joasi alongi Amatsia",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 25:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sima na ye kolonga bato ya Edomi na bitumba, Amatsia azongaki epai na ye ; amemaki banzambe ya bikeko ya bato ya Seiri, akomisaki yango banzambe na ye moko, agumbamelaki yango mpe atumbelaki yango mbeka ya malasi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.14",
            "verseOrgIds": [
              "2CH.25.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 25:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpo na yango, kanda ya Yawe epelelaki Amatsia ; mpe Yawe atindaki mosakoli moko kotuna Amatsia :",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.15",
            "verseOrgIds": [
              "2CH.25.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "2CH 25:15"
      },
      "items": [
        {
          "text": "— Mpo na nini ozali kogumbamela banzambe ya bato wana oyo ekokaki ata kokangola bato na yango te na loboko na yo ?",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 25:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wana azalaki nanu koloba, mokonzi alobaki na ye :",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.16",
            "verseOrgIds": [
              "2CH.25.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "2CH 25:16"
      },
      "items": [
        {
          "text": "— Kata ! Nani atie yo mopesi toli ya mokonzi ? Kanga monoko na yo, soki te bakoboma yo !",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2CH 25:16"
      },
      "items": [
        {
          "text": "Mosakoli abendaki nzoto ; kasi, liboso ya kokende, alobaki :",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.16",
            "verseOrgIds": [
              "2CH.25.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "2CH 25:16"
      },
      "items": [
        {
          "text": "— Lokola osali boye mpe oboyi koyoka toli na ngai, nandimisami ete Nzambe azwi mokano ya koboma yo.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "2KI.14.8-2KI.14.20"
          },
          "items": [
            {
              "text": "2Ba 14.8-20",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 25:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sima na Amatsia, mokonzi ya Yuda, kotuna toli epai ya bapesi toli na ye, abetaki mondenge na Joasi, mwana mobali ya Yoakazi mpe koko ya Jewu, mokonzi ya Isalaele ; alobaki :",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.17",
            "verseOrgIds": [
              "2CH.25.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "2CH 25:17"
      },
      "items": [
        {
          "text": "— Yaka tobunda !",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 25:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasi Joasi, mokonzi ya Isalaele, azongiselaki Amatsia, mokonzi ya Yuda :",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.18",
            "verseOrgIds": [
              "2CH.25.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "2CH 25:18"
      },
      "items": [
        {
          "text": "— Mokolo moko, nzete ya sende ya Libani etindaki maloba epai ya nzete ya sedele ya Libani : « Balisa mwana na yo ya mwasi epai ya mwana na ngai ya mobali. » Kasi nyama moko ya zamba ya Libani elekaki mpe enyataki nzete ya sende.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 25:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solo, ozali komilobela ete olongi Edomi, mpe motema ezali kosepela mpe komikumisa. Tala, ekoleka malamu ete ovanda na ndako na yo. Mpo na nini koluka ete pasi makasi ekweyela yo elongo na Yuda ?",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 25:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasi Amatsia ayokaki ye te, pamba te Nzambe nde asalaki bongo mpo na kokaba bango na maboko ya Joasi, mpo ete basambelaki banzambe ya Edomi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.20",
            "verseOrgIds": [
              "2CH.25.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 25:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boye Joasi, mokonzi ya Isalaele, akendeki kobundisa Amatsia, mokonzi ya Yuda. Ye mpe Amatsia, mokonzi ya Yuda, babundaki na Beti-Shemeshi kati na mokili ya Yuda.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.21",
            "verseOrgIds": [
              "2CH.25.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 25:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isalaele alongaki Yuda, mpe bato ya Yuda bakimaki, moto na moto na ndako na ye.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.22",
            "verseOrgIds": [
              "2CH.25.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 25:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joasi, mokonzi ya Isalaele, akangaki Amatsia, mokonzi ya Yuda, mwana mobali ya Joasi mpe koko ya Yoakazi, na Beti-Shemeshi. Amemaki ye na Yelusalemi mpe abukaki mir ya Yelusalemi, na molayi ya bametele pene nkama moko na tuku mwambe, longwa na ekuke ya Efrayimi kino na ekuke ya suka.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.23",
            "verseOrgIds": [
              "2CH.25.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 25:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joasi akamataki palata nyonso, wolo nyonso mpe biloko nyonso oyo ezalaki kati na Tempelo ya Nzambe oyo Obedi-Edomi azalaki kobatela, kati na bibombelo ya ndako ya mokonzi ; akangaki bato na bowumbu mpe azongaki na Samari.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.24",
            "verseOrgIds": [
              "2CH.25.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 25:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amatsia, mwana mobali ya Joasi, mokonzi ya Yuda, awumelaki lisusu na bomoi mibu zomi na mitano sima na kufa ya Joasi, mwana mobali ya Yoakazi, mokonzi ya Isalaele.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.25",
            "verseOrgIds": [
              "2CH.25.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CH 25:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makambo mosusu oyo etali bokonzi ya Amatsia mpe misala na ye, kobanda na ebandeli kino na suka, ekomama kati na buku ya masolo ya bakonzi ya Yuda mpe ya Isalaele.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.26",
            "verseOrgIds": [
              "2CH.25.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 25:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kobanda na tango oyo Amatsia apesaki Yawe mokongo, basalelaki ye likita, na Yelusalemi, mpo na kotelemela ye ; mpe akimaki na Lakishi. Kasi batindaki bato mpo ete balanda ye kino na Lakishi, mpe babomaki ye kuna.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.27",
            "verseOrgIds": [
              "2CH.25.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2CH 25:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bamemaki nzoto na ye na likolo ya mpunda mpe bakundaki ye esika moko na bakoko na ye kati na engumba ya Yuda.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.28",
            "verseOrgIds": [
              "2CH.25.28"
            ]
          }
        }
      ]
    }
