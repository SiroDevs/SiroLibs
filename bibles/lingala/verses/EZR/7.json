          "text": "7",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Esidrasi azongi na Yelusalemi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZR 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sima na makambo oyo, tango Aritakizerisesi azalaki mokonzi ya Persi, Esidrasi, mwana mobali ya Seraya, mwana mobali ya Azaria, mwana mobali ya Ilikia,",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.1",
            "verseOrgIds": [
              "EZR.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZR 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "mwana mobali ya Shalumi, mwana mobali ya Tsadoki, mwana mobali ya Ayitubi,",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.2",
            "verseOrgIds": [
              "EZR.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZR 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "mwana mobali ya Amaria, mwana mobali ya Azaria, mwana mobali ya Merayoti,",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.3",
            "verseOrgIds": [
              "EZR.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZR 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "mwana mobali ya Zerakia, mwana mobali ya Uzi, mwana ya Buki,",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.4",
            "verseOrgIds": [
              "EZR.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZR 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "mwana mobali ya Abishuwa, mwana mobali ya Pineasi, mwana mobali ya Eleazari, mwana mobali ya Aron, mokonzi ya Banganga-Nzambe,",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.5",
            "verseOrgIds": [
              "EZR.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZR 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "alongwaki na Babiloni. Esidrasi yango azalaki molakisi malamu ya mibeko mpe ayebaki penza malamu Mobeko ya Moyize oyo Yawe, Nzambe ya Isalaele, apesaki na bato na Ye. Bongo lokola loboko ya Yawe, Nzambe na ye, ezalaki likolo na ye, mokonzi apesaki ye biloko nyonso oyo asengaki.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.6",
            "verseOrgIds": [
              "EZR.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZR 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kati na bana ya Isalaele, Banganga-Nzambe, Balevi, bayembi, bakengeli bikuke mpe basali ya Tempelo, ndambo bazongaki na Yelusalemi na mobu ya sambo ya mokonzi Aritakizerisesi.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.7",
            "verseOrgIds": [
              "EZR.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZR 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esidrasi mpe akomaki elongo na bango na Yelusalemi na sanza ya mitano ya mobu ya sambo ya mokonzi.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.8",
            "verseOrgIds": [
              "EZR.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZR 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alongwaki na Babiloni na mokolo ya liboso ya sanza ya liboso mpe akomaki na Yelusalemi na mokolo ya liboso ya sanza ya mitano, pamba te loboko ya ngolu ya Nzambe na ye ezalaki likolo na ye,",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.9",
            "verseOrgIds": [
              "EZR.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZR 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "mpo ete Esidrasi amipesaki ye moko penza, na motema na ye mobimba, mpo na koyekola mpe kotia na misala mibeko ya Yawe mpe mpo na kolakisa na bana ya Isalaele bikateli mpe mitindo ya mibeko yango.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.10",
            "verseOrgIds": [
              "EZR.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mokanda ya Aritakizerisesi epai ya Esidrasi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZR 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tala mokanda oyo mokonzi Aritakizerisesi apesaki epai ya Esidrasi, Nganga-Nzambe mpe molakisi ya Mobeko, oyo ayebaki penza malamu makambo oyo etali mitindo mpe bikateli ya Yawe mpo na Isalaele :",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.11",
            "verseOrgIds": [
              "EZR.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pmo"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZR 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "« Aritakizerisesi, mokonzi ya bakonzi ;",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.12",
            "verseOrgIds": [
              "EZR.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pmo",
        "vid": "EZR 7:12"
      },
      "items": [
        {
          "text": "Epai ya Esidrasi, Nganga-Nzambe mpe molakisi ya Mobeko ya Nzambe ya Likolo :",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.12",
            "verseOrgIds": [
              "EZR.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pmo",
        "vid": "EZR 7:12"
      },
      "items": [
        {
          "text": "Mbote na yo !",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.12",
            "verseOrgIds": [
              "EZR.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZR 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Napesi mitindo ete, kati na bokonzi na ngai, moto nyonso kati na bato ya Isalaele, kati na Banganga-Nzambe mpe Balevi na bango, oyo alingi kokende na Yelusalemi akende elongo na yo.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.13",
            "verseOrgIds": [
              "EZR.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZR 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngai, mokonzi elongo na bapesi toli na ngai sambo, totindi yo koluka koyeba makambo oyo ezali koleka na Yuda mpe na Yelusalemi, kolanda Mobeko ya Nzambe na yo, oyo ezali na maboko na yo,",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.14",
            "verseOrgIds": [
              "EZR.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZR 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "mpe komema palata mpe wolo oyo mokonzi mpe bapesi toli na ye bapesi bango moko wuta na mokano ya mitema na bango, epai ya Nzambe ya Isalaele, oyo Ndako na Ye ezali na Yelusalemi ;",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.15",
            "verseOrgIds": [
              "EZR.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZR 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "elongo na palata mpe wolo nyonso oyo okozwa na etuka ya Babiloni, makabo oyo bato mpe Banganga-Nzambe bakataki bango moko kopesa wuta na mokano ya mitema na bango, mpo na Tempelo ya Nzambe na bango kati na Yelusalemi.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.16",
            "verseOrgIds": [
              "EZR.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZR 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boye, okosala keba ete osomba bangombe, bameme ya mibali mpe bana meme elongo na nyonso oyo esengeli mpo na makabo na yango ya gato mpe ya masanga, mpe okobonza yango na etumbelo ya Nzambe na bino kati na Yelusalemi.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.17",
            "verseOrgIds": [
              "EZR.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZR 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na palata mpe wolo oyo etikali, yo mpe bandeko na yo, Bayuda, bokoki kosala nyonso oyo bokomona ete ezali malamu kolanda mokano ya Yawe, Nzambe na bino.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.18",
            "verseOrgIds": [
              "EZR.7.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZR 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okopesa epai ya Nzambe ya Yelusalemi, biloko nyonso oyo bakopesa yo mpo na mosala ya Tempelo ya Nzambe na yo.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.19",
            "verseOrgIds": [
              "EZR.7.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZR 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na nzela ya bomengo ya mokonzi, okoki kozwa biloko nyonso mosusu oyo okozala na yango na bosenga mpo na misala ya Ndako ya Nzambe na yo.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.20",
            "verseOrgIds": [
              "EZR.7.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZR 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sik'oyo, ngai, mokonzi Aritakizerisesi, napesi mitindo epai ya babateli bomengo nyonso ya mokonzi kati na etuka ya ngambo ya weste ya ebale Efrate, ete bopesa na lombangu eloko nyonso oyo Esidrasi, Nganga-Nzambe mpe molakisi ya Mobeko ya Nzambe ya Likolo, akosenga bino",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.21",
            "verseOrgIds": [
              "EZR.7.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZR 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "kino na kilo ya palata nkoto misato na nkama mitano, kilo ya ble nkoto tuku minei na mitano, balitele ya vino nkoto minei na nkama mitano, balitele ya mafuta nkoto minei na nkama mitano mpe kilo ya mungwa oyo bakoki kotanga te.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.22",
            "verseOrgIds": [
              "EZR.7.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZR 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tika ete makambo nyonso oyo Nzambe ya Likolo atindi mpo na Tempelo na Ye esalema ndenge kaka atindi yango, mpo ete kanda na Ye ekitela te mokili ya mokonzi mpe bana na ye ya mibali.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.23",
            "verseOrgIds": [
              "EZR.7.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZR 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bosengeli lisusu koyeba ete bozali lisusu na ndingisa te ya kosenga na Nganga-Nzambe nyonso, Molevi nyonso, moyembi nyonso, mokengeli nyonso ya ekuke, mosali nyonso ya Tempelo, mpe na mosali nyonso mosusu ya Ndako ya Nzambe ete afuta mpako ya mokonzi, mpako ya mabele mpe mpako ya nzela.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.24",
            "verseOrgIds": [
              "EZR.7.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZR 7:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bongo yo, Esidrasi, kolanda bwanya ya Nzambe na yo, oyo ozali na yango, pona bilombe mpe basambisi mpo na mosala ya kokata makambo ya bato nyonso oyo, kati na etuka ya ngambo ya weste ya ebale Efrate, bayebi mibeko ya Nzambe na yo ; mpe lakisa yango na bato oyo bayebi yango te.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.25",
            "verseOrgIds": [
              "EZR.7.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZR 7:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moto nyonso oyo akotosa te Mobeko ya Nzambe na yo mpe mobeko ya mokonzi asengeli bongo kozwa etumbu ya kufa to kokende na bowumbu to kokaba bomengo na ye mpo ete babotola yango to mpe kokota na boloko. »",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.26",
            "verseOrgIds": [
              "EZR.7.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZR 7:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tika ete Yawe, Nzambe ya batata na biso, akumisama, Ye oyo atiaki makanisi ya lolenge oyo na motema ya mokonzi, mpo ete akoka kopesa lokumu na Tempelo ya Yawe kati na Yelusalemi,",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.27",
            "verseOrgIds": [
              "EZR.7.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EZR 7:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
