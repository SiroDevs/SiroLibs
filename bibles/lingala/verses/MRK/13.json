          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "minzoto ekokweya longwa na Likolo,",
              "type": "text",
              "attrs": {
                "verseId": "MRK.13.25",
                "verseOrgIds": [
                  "MRK.13.25"
                ]
              }
            }
          ]
