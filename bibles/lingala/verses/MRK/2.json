  "verseCount": 28,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
        "style": "c",
        "sid": "MRK 2"
      },
      "items": [
        {
          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu alimbisi mpe abikisi ebosono",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "MAT.9.1-MAT.9.8"
          },
          "items": [
            {
              "text": "Mat 9.1-8",
              "type": "text"
            }
          ]
        },
        {
          "text": ";",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "LUK.5.17-LUK.5.26"
          },
          "items": [
            {
              "text": "Lk 5.17-26",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MRK 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sima na mwa mikolo, Yesu azongaki lisusu na Kapernawumi. Tango bato bayokaki ete azali na ndako,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.1",
            "verseOrgIds": [
              "MRK.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MRK 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "bayaki ebele kosangana kati na ndako yango kino esika ezalaki lisusu te, ezala na liboso ya ekuke, mpe Yesu ateyaki bango Sango Malamu.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.2",
            "verseOrgIds": [
              "MRK.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MRK 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bato mosusu bamemelaki Ye ebosono oyo bato minei batomboli.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.3",
            "verseOrgIds": [
              "MRK.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MRK 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lokola balongaki te kokomisa ebosono yango kino na esika oyo Yesu azalaki, pamba te bato bazalaki ebele penza, bamataki likolo ya mwanza ya ndako kino na esika oyo Yesu azalaki mpe batobolaki lidusu. Bongo na nzela ya lidusu yango, bakitisaki na tsipoyi ebosono yango.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.4",
            "verseOrgIds": [
              "MRK.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MRK 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tango Yesu amonaki kondima na bango, alobaki na ebosono :",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.5",
            "verseOrgIds": [
              "MRK.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "MRK 2:5"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "— Mwana na Ngai, masumu na yo elimbisami.",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MRK 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasi ndambo ya balakisi ya Mobeko oyo bazalaki wana bakomaki kolobaloba na se ya mitema :",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.6",
            "verseOrgIds": [
              "MRK.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MRK 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "« Mpo na nini moto oyo azali koloba bongo ? Azali kotiola Nzambe ! Nani akoki kolimbisa masumu soki kaka Ye moko Nzambe te ? »",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.7",
            "verseOrgIds": [
              "MRK.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MRK 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbala moko, kati na molimo na Ye, Yesu asosolaki makanisi na bango ; alobaki na bango :",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.8",
            "verseOrgIds": [
              "MRK.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "MRK 2:8"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "— Mpo na nini mitema na bino ezali kokanisa bongo ?",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MRK 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Likambo nini eleki pete mpo na koloba na ebosono : « Masumu na yo elimbisami to telema, kamata tsipoyi na yo mpe tambola ? »",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MRK 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ezali mpo boyeba ete Mwana na Moto azali na bokonzi ya kolimbisa masumu kati na mokili.",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "MRK 2:10"
      },
      "items": [
        {
          "text": "Bongo alobaki na ebosono :",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.10",
            "verseOrgIds": [
              "MRK.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MRK 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "— Nalobi na yo : Telema, kamata tsipoyi na yo mpe zonga na ndako na yo.",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MRK 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbala moko, atelemaki, akamataki tsipoyi na ye mpe abimaki na miso ya bato nyonso. Bato nyonso bakamwaki makasi mpe bakomaki kokumisa Nzambe na maloba oyo : « Totikala nanu komona likambo ya boye te ! »",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.12",
            "verseOrgIds": [
              "MRK.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Tembe na tina na Yesu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "MAT.9.9-MAT.9.13"
          },
          "items": [
            {
              "text": "Mat 9.9-13",
              "type": "text"
            }
          ]
        },
        {
          "text": ";",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "LUK.5.27-LUK.5.32"
          },
          "items": [
            {
              "text": "Lk 5.27-32",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MRK 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu abimaki lisusu mpe akendeki pembeni ya ebale. Bato ebele bayaki epai na Ye mpe ateyaki bango.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.13",
            "verseOrgIds": [
              "MRK.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MRK 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wana azalaki kotambola, amonaki Levi, mwana mobali ya Alife, avandi na ndako ya mosala epai wapi bafutaka mpako. Yesu alobaki na ye :",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.14",
            "verseOrgIds": [
              "MRK.2.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "« Landa Ngai. »",
              "type": "text",
              "attrs": {
                "verseId": "MRK.2.14",
                "verseOrgIds": [
                  "MRK.2.14"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "MRK 2:14"
      },
      "items": [
        {
          "text": "Levi atelemaki mpe alandaki Ye.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.14",
            "verseOrgIds": [
              "MRK.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MRK 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wana Yesu azalaki kolia na ndako ya Levi, bafutisi mpako ebele mpe bato mosusu ya masumu bazalaki kolia mesa moko na Yesu elongo na bayekoli na Ye ; pamba te bato ebele penza bazalaki kolanda Ye.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.15",
            "verseOrgIds": [
              "MRK.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MRK 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tango balakisi ya Mobeko ya lingomba ya Bafarizeo bamonaki Yesu kolia mesa moko na bato ya masumu mpe bafutisi mpako, batunaki bayekoli na Ye :",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.16",
            "verseOrgIds": [
              "MRK.2.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "MRK 2:16"
      },
      "items": [
        {
          "text": "— Mpo na nini azali kolia mesa moko na bafutisi mpako mpe bato ya masumu ?",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MRK 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tango Yesu ayokaki bongo, alobaki na bango :",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.17",
            "verseOrgIds": [
              "MRK.2.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "MRK 2:17"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "— Bato oyo bazali kolongono na nzoto bazalaka na posa ya monganga te ; ezali babeli nde bazalaka na posa na ye. Nayaki te koluka bato ya sembo, kasi bato ya masumu.",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "MAT.9.14-MAT.9.17"
          },
          "items": [
            {
              "text": "Mat 9.14-17",
              "type": "text"
            }
          ]
        },
        {
          "text": ";",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "LUK.5.33-LUK.5.39"
          },
          "items": [
            {
              "text": "Lk 5.33-39",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MRK 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzokande bayekoli ya Yoane mpe Bafarizeo bazalaki kokila bilei. Bongo bato bayaki kotuna Yesu :",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.18",
            "verseOrgIds": [
              "MRK.2.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "MRK 2:18"
      },
      "items": [
        {
          "text": "— Mpo na nini bayekoli ya Yoane mpe Bafarizeo bakilaka bilei, kasi bayekoli na yo bakilaka bilei te ?",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MRK 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu azongiselaki bango :",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.19",
            "verseOrgIds": [
              "MRK.2.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "MRK 2:19"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "— Ndenge nini bato oyo babengami na feti ya libala bakoki kokila bilei, wana mobali ya libala azali nanu elongo na bango ? Tango nyonso mobali ya libala azali elongo na bango, bakoki kokila bilei te.",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MRK 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kasi tango ezali koya oyo bakolongola mobali ya libala kati na bango ; mpe ekozala na tango wana nde bakokila bilei.",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MRK 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Moto moko te asalelaka eteni ya elamba ya sika mpo na kobamba elamba ya kala, noki te eteni ya elamba ya sika ekopasola elamba ya kala mpe ekosala lidusu ya monene koleka.",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MRK 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Moto moko te atiaka vino ya sika kati na bambeki ya kala, noki te vino ya sika ekopasola bambeki ; vino ekosopana mpe bambeki ekopasuka. Nzokande, batiaka kaka vino ya sika kati na bambeki ya sika !",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu azali Nkolo ya mokolo ya Saba",
          "type": "text"
        }
      ]
    },
    {
