  "verseCount": 33,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "22",
        "style": "c",
        "sid": "LEV 22"
      },
      "items": [
        {
          "text": "22",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s2"
      },
      "items": [
        {
          "text": "Mibeko mpo na kolia makabo ya etumbelo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 22:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe alobaki na Moyize :",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.1",
            "verseOrgIds": [
              "LEV.22.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "« Talisa Aron mpe bana na ye ya mibali ndenge nini basengeli kozala mosika ya makabo oyo bana ya Isalaele babonzelaka Ngai, mpo ete babebisa te bosantu ya Kombo na Ngai ya bule ; Ngai nazali Yawe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.2",
            "verseOrgIds": [
              "LEV.22.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Loba na bango : ‹ Mpo na milongo oyo ekoya na sima mpe kati na bakitani na bino, soki moko azali mbindo mpe apusani pembeni ya makabo ya bule oyo bana ya Isalaele babonzeli Ngai Yawe, esengeli balongola moto wana na miso na Ngai. Nazali Yawe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.3",
            "verseOrgIds": [
              "LEV.22.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Soki moko ya bakitani ya Aron azali na bokono na poso ya nzoto lokola maba, bokono ya kobima tofina to makila na nzoto ya mibali, akoki te kolia likabo ya bule kino tango akokoma peto. Ndenge moko mpe, akozala mbindo soki asimbi eloko oyo ekomi mbindo mpo ete etuti ebembe to mobali oyo abimisi mayi ya mibali ;",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.4",
            "verseOrgIds": [
              "LEV.22.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "soki asimbi nyama oyo etambolaka na libumu mpe ekomisaka mbindo to soki asimbi moto nyonso oyo akoki kokomisa ye mbindo ata na nzela ya ndenge nini.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.5",
            "verseOrgIds": [
              "LEV.22.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moto oyo akosimba eloko ya ndenge wana akozala mbindo kino na pokwa. Akoki kolia likabo ya bule te kino tango akosukola na mayi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.6",
            "verseOrgIds": [
              "LEV.22.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akokoma peto tango moyi ekolala mpe sima na yango nde akoki kolia makabo ya bule, pamba te ezali bilei na ye.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.7",
            "verseOrgIds": [
              "LEV.22.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akoki te kolia nyama oyo ekufi yango moko to oyo nyama ya zamba ebomi, noki te akokoma mbindo na nzela na yango. Nazali Yawe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.8",
            "verseOrgIds": [
              "LEV.22.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Banganga-Nzambe bakotosa malako na Ngai tango nyonso mpo ete bamema ngambo te mpe bakufa te, noki te bakokufa solo. Ngai nazali Yawe oyo abulisaki bango mpe akomisaka bango basantu mpo na mosala na Ngai.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.9",
            "verseOrgIds": [
              "LEV.22.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moto moko te oyo azali na libota ya Banganga-Nzambe te akoki kolia makabo ya bule : ezala mopaya oyo Nganga-Nzambe abengi to mosali oyo Nganga-Nzambe azwi na mosala.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.10",
            "verseOrgIds": [
              "LEV.22.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasi soki Nganga-Nzambe asombi mowumbu na mbongo na ye to soki mowumbu abotami na ndako na ye, mowumbu wana akolia makabo ya bule.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.11",
            "verseOrgIds": [
              "LEV.22.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Soki mwana mwasi ya Nganga-Nzambe abali mobali oyo azali Nganga-Nzambe te, akolia te makabo ya bule.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.12",
            "verseOrgIds": [
              "LEV.22.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasi soki mwana mwasi ya Nganga-Nzambe akufisi mobali to akabwani na mobali, bongo amiboteli mwana te mpe azongi kovanda na ndako ya tata na ye lokola tango azalaki elenge, akoki kolia biloko ya ndenge moko na tata na ye ; kasi moto oyo azali Nganga-Nzambe te akolia yango te.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.13",
            "verseOrgIds": [
              "LEV.22.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Soki moto alie likabo ya bule na kozanga koyeba, asengeli kozongisa epai ya Nganga-Nzambe motuya ya likabo yango mpe akobakisa eteni moko kati na mitano ya motuya na yango.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.14",
            "verseOrgIds": [
              "LEV.22.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Banganga-Nzambe basengeli te kobebisa lokumu ya makabo ya bule oyo bana ya Isalaele babonzeli Yawe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.15",
            "verseOrgIds": [
              "LEV.22.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Soki, wana bazali mbindo, balie yango, bakomemisa bana ya Isalaele ngambo oyo ekosala ete bapesa likabo mpo na kozongisa boyokani, pamba te ezali Ngai Yawe nde nabulisaka bango mpo na mosala na Ngai. › »",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.16",
            "verseOrgIds": [
              "LEV.22.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ndenge nini kopona banyama ya kobonza",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 22:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe alobaki na Moyize :",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.17",
            "verseOrgIds": [
              "LEV.22.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 22:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "« Yebisa Aron, bana na ye ya mibali mpe bana nyonso ya Isalaele : ‹ Soki moto ya Isalaele to mopaya oyo azali kovanda kati na Isalaele alingi kobonza mbeka ya kotumba epai na Yawe mpo na kokokisa ndayi to likabo oyo apesi kolanda mokano ya motema na ye moko,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.18",
            "verseOrgIds": [
              "LEV.22.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 22:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "asengeli kobonza nyama ya mobali oyo ezangi mbeba kati na bangombe, bameme to bantaba mpo ete Nzambe andima yango.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.19",
            "verseOrgIds": [
              "LEV.22.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 22:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asengeli te kobonza nyama oyo ezali na mbeba, pamba te ekondimama te.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.20",
            "verseOrgIds": [
              "LEV.22.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 22:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndenge moko mpe, soki moto alingi kobonza epai na Yawe mbeka ya boyokani oyo azwi kati na bangombe, bameme to bantaba, mpo na kokokisa ndayi to likabo oyo apesi kolanda mokano ya motema na ye moko, nyama yango esengeli kozala ezanga mbeba.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.21",
            "verseOrgIds": [
              "LEV.22.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 22:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bokobonza te epai na Yawe nyama oyo ekufa liso to ezoka, oyo ezali kotambola tengu-tengu to oyo ezali na bokono na poso ya nzoto, oyo ezali na makwanza to na mapalata ; bokoki te kotia nyama ya boye na likolo ya etumbelo lokola likabo bazikisa na moto mpo na Yawe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.22",
            "verseOrgIds": [
              "LEV.22.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 22:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzokande bokoki mpe te kobonza mpo na Yawe lokola likabo oyo bopesi kolanda mokano ya mitema na bino moko, ngombe ya mobali to meme oyo ezali na makolo to maboko ekokana te. Mbeka ya boye ekoki kondimama te mpo na kokokisa ndayi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.23",
            "verseOrgIds": [
              "LEV.22.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 22:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bokobonza kaka epai na Yawe, nyama oyo mapumbu na yango bafina penza to banika, balongola to bakata ; bokoki kosala bongo te kati na mboka na bino moko.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.24",
            "verseOrgIds": [
              "LEV.22.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 22:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bokoki kondima nyama ya lolenge oyo te na maboko ya bapaya mpo na kobonza yango epai na Yawe lokola bilei ya Nzambe na bino. Ekoki kondimama te, pamba te ezali na mbeba. › »",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.25",
            "verseOrgIds": [
              "LEV.22.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 22:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe alobaki na Moyize :",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.26",
            "verseOrgIds": [
              "LEV.22.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 22:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "« Soki mwana ngombe, mwana meme to mwana ntaba ebotami, ekosala mikolo sambo epai ya mama na yango, bongo na mokolo ya mwambe, ekondimama lokola likabo bazikisa na moto mpo na Yawe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.27",
            "verseOrgIds": [
              "LEV.22.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 22:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bokoki te kokata kingo ya ngombe ya mwasi to ya meme ya mwasi mokolo moko na mwana na yango.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.28",
            "verseOrgIds": [
              "LEV.22.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 22:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tango bokobonza mbeka ya kozongisa matondi epai na Yawe, bobonza yango na lolenge oyo ekosala ete Nzambe andima bino.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.29",
            "verseOrgIds": [
              "LEV.22.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 22:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esengeli bolia yango kaka mokolo wana. Bokotika eloko moko te kino na tongo. Nazali Yawe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.30",
            "verseOrgIds": [
              "LEV.22.30"
            ]
          }
        }
      ]
    },
    {
