  "verseCount": 36,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "8",
        "style": "c",
        "sid": "LEV 8"
      },
      "items": [
        {
          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "ms1"
      },
      "items": [
        {
          "text": "Libulisi ya Banganga-Nzambe ya liboso",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Libulisi ya Aron mpe bana na ye ya mibali",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe alobaki na Moyize :",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.1",
            "verseOrgIds": [
              "LEV.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "« Mema Aron mpe bana na ye ya mibali, bilamba na bango ya mosala ya bonganga-Nzambe, mafuta ya epakolami, mwana ngombe ya mobali mpo na mbeka ya masumu, bameme mibale ya mibali, mpe kitunga oyo ezali na mapa ezanga levire ;",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.2",
            "verseOrgIds": [
              "LEV.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "mpe sangisa lisanga mobimba na ekotelo ya Ndako ya kapo ya Bokutani. »",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.3",
            "verseOrgIds": [
              "LEV.8.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moyize asalaki ndenge Yawe atindaki ye mpe lisanga esanganaki na ekotelo ya Ndako ya kapo ya Bokutani.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.4",
            "verseOrgIds": [
              "LEV.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moyize alobaki na lisanga makambo oyo Yawe atindaki ye kosala.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.5",
            "verseOrgIds": [
              "LEV.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moyize amemaki Aron elongo na bana na ye ya mibali liboso mpe asukolaki bango na mayi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.6",
            "verseOrgIds": [
              "LEV.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alatisaki Aron nzambala mpe akangaki ye mokaba na loketo ; alatisaki ye kazaka mpe efode, azingelaki ye na mokaba ya efode.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.7",
            "verseOrgIds": [
              "LEV.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alatisaki Aron elamba ya tolo mpe atiaki Urimi mpe tumimi likolo ya elamba yango.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.8",
            "verseOrgIds": [
              "LEV.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akangaki kitendi na moto ya Aron ; bongo liboso na yango, atiaki medaye ya wolo, elembo ya libulisi, ndenge kaka Yawe atindaki Moyize.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.9",
            "verseOrgIds": [
              "LEV.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moyize azwaki mafuta ya epakolami mpe apakolaki Mongombo elongo na biloko nyonso oyo ezalaki kati na yango ; na bongo nde abulisaki yango.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.10",
            "verseOrgIds": [
              "LEV.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asopaki na etumbelo ndambo ya mafuta mbala sambo mpe apakolaki mafuta mpo na kobulisa etumbelo, bisalelo na yango nyonso, sani monene mpe se na yango.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.11",
            "verseOrgIds": [
              "LEV.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asopaki ndambo ya mafuta ya epakolami na moto ya Aron mpe apakolaki ye mafuta yango mpo na kobulisa ye.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.12",
            "verseOrgIds": [
              "LEV.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moyize amemaki bana mibali ya Aron liboso, alatisaki bango banzambala, akangaki bango mikaba na loketo mpe alatisaki bango bikoti, ndenge kaka Yawe atindaki Moyize.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.13",
            "verseOrgIds": [
              "LEV.8.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bongo amemaki ngombe ya mobali lokola mbeka ya masumu ; Aron elongo na bana na ye ya mibali batiaki maboko na bango na moto ya ngombe yango.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.14",
            "verseOrgIds": [
              "LEV.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moyize akataki yango kingo mpe asalelaki mosapi na ye mpo na kotia makila ya ngombe yango na maseke ya etumbelo. Boye, apetolaki etumbelo ; bongo asopaki makila oyo etikalaki, na makolo ya etumbelo oyo abulisaki mpo na mosala ya bolimbisi masumu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.15",
            "verseOrgIds": [
              "LEV.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moyize azwaki lisusu mafuta nyonso oyo ezalaki pembeni-pembeni ya biloko ya kati, mafuta oyo ezipaka bafwa mpe bambuma nyonso mibale oyo ezalaka kati na loketo elongo na mafuta na yango, atumbaki yango na etumbelo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.16",
            "verseOrgIds": [
              "LEV.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasi atumbaki na libanda ya molako ngombe yango ya mobali, poso na yango, misuni na yango mpe nyei na yango, ndenge kaka Yawe atindaki Moyize.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.17",
            "verseOrgIds": [
              "LEV.8.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bongo amemaki meme ya mobali mpo na kobonza yango lokola mbeka ya kotumba ; Aron mpe bana na ye ya mibali batiaki maboko na bango na moto na yango.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.18",
            "verseOrgIds": [
              "LEV.8.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moyize akataki kingo ya meme yango mpe asopaki makila na yango na bapembeni nyonso ya etumbelo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.19",
            "verseOrgIds": [
              "LEV.8.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akataki-kataki meme yango na biteni. Moyize atumbaki biteni yango, moto mpe mafuta.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.20",
            "verseOrgIds": [
              "LEV.8.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asukolaki na mayi biloko ya kati mpe makolo, atumbaki meme yango mobimba na likolo ya etumbelo ; ezalaki mbeka ya kotumba, likabo bazikisa na moto mpo na Yawe, oyo solo kitoko na yango esepelisaki Yawe, ndenge kaka Yawe atindaki Moyize.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.21",
            "verseOrgIds": [
              "LEV.8.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 8:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bongo amemaki meme mosusu ya mobali mpo na libulisi ; Aron mpe bana na ye ya mibali batiaki maboko na bango na moto na yango.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.22",
            "verseOrgIds": [
              "LEV.8.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 8:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moyize akataki yango kingo, azwaki ndambo ya makila na yango mpe atiaki yango na songe ya litoyi ya ngambo ya loboko ya mobali ya Aron, na mosapi ya monene ya loboko ya mobali ya Aron mpe na mosapi ya monene ya lokolo ya ngambo ya loboko ya mobali ya Aron.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.23",
            "verseOrgIds": [
              "LEV.8.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 8:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moyize amemaki bana mibali ya Aron liboso, atiaki ndambo ya makila na basonge ya matoyi na bango ya ngambo ya loboko ya mobali, na misapi ya minene ya maboko na bango ya mobali mpe na misapi ya minene ya makolo na bango ya ngambo ya loboko ya mobali. Sima, asopaki makila na bangambo nyonso ya etumbelo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.24",
            "verseOrgIds": [
              "LEV.8.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 8:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azwaki biteni oyo ya mafuta : mokila, mafuta nyonso oyo ezalaka pembeni-pembeni ya biloko ya kati, mafuta oyo ezipi bafwa, bambuma mibale oyo ezalaka kati na loketo elongo na mafuta na yango mpe mopende ya lokolo ya ngambo ya loboko ya mobali.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.25",
            "verseOrgIds": [
              "LEV.8.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 8:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kati na kitunga ya mapa ezanga levire oyo ezalaki liboso ya Yawe, azwaki lipa moko, gato moko balamba na mafuta mpe galeti moko ; atiaki yango likolo ya biteni ya mafuta mpe ya mopende ya ngambo ya loboko ya mobali.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.26",
            "verseOrgIds": [
              "LEV.8.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 8:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atiaki biloko yango nyonso na maboko ya Aron mpe ya bana na ye ya mibali ; bongo ayebisaki bango ete batombola yango liboso ya Yawe lokola likabo ya kotombola.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.27",
            "verseOrgIds": [
              "LEV.8.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 8:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moyize azwaki yango lisusu na maboko na bango mpe atumbaki yango na etumbelo, na likolo ya mbeka ya kotumba. Ezalaki mbeka ya libulisi, likabo bazikisa na moto mpo na Yawe, oyo solo kitoko na yango esepelisaka Yawe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.28",
            "verseOrgIds": [
              "LEV.8.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 8:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moyize azwaki tolo ya meme ya libulisi, atombolaki yango liboso ya Yawe lokola mbeka ya kotombola ndenge kaka Yawe atindaki Moyize.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.29",
            "verseOrgIds": [
              "LEV.8.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 8:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moyize azwaki na etumbelo, mafuta ya epakolami mpe ndambo ya makila ; asopelaki yango Aron, bilamba na ye, bana na ye ya mibali mpe bilamba na bango. Bongo abulisaki Aron, bilamba na ye, bana na ye ya mibali mpe bilamba na bango.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.30",
            "verseOrgIds": [
              "LEV.8.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 8:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moyize alobaki na Aron mpe na bana na ye ya mibali : « Bolamba mosuni na ekotelo ya Ndako ya kapo ya Bokutani, mpe bolia yango wana elongo na lipa oyo ezali kati na kitunga oyo ezali na mbeka ya libulisi, ndenge kaka natindaki tango nalobaki : ‹ Aron mpe bana na ye ya mibali nde bakolia yango. ›",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.31",
            "verseOrgIds": [
              "LEV.8.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 8:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oyo ekotikala kati na mosuni ya mbeka ya libulisi mpe lipa, bokotumba yango na moto.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.32",
            "verseOrgIds": [
              "LEV.8.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LEV 8:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mikolo sambo, bokolongwa te na ekotelo ya Ndako ya kapo ya Bokutani kino mikolo ya libulisi na bino ekokoka, pamba te libulisi na bino ekowumela mikolo sambo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.33",
            "verseOrgIds": [
              "LEV.8.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LEV 8:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makambo oyo esalemi lelo, yango nde Yawe atindi mpo na kosala mosala ya bolimbisi masumu na bino.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.34",
            "verseOrgIds": [
              "LEV.8.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LEV 8:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bokovanda mikolo sambo, butu mpe moyi, na ekotelo ya Ndako ya kapo ya Bokutani mpe bokosala makambo oyo Yawe atindi mpo ete bokufa te. Pamba te, yango nde epesamelaki ngai lokola mitindo. »",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.35",
            "verseOrgIds": [
              "LEV.8.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LEV 8:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aron mpe bana na ye ya mibali basalaki makambo nyonso oyo Yawe atindaki Moyize.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.36",
            "verseOrgIds": [
              "LEV.8.36"
            ]
          }
        }
      ]
