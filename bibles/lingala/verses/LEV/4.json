          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akotia loboko na ye na moto ya mbeka mpo na masumu, na esika oyo bakataka kingo ya bambeka ya kotumba.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.33",
