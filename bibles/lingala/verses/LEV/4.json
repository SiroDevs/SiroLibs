              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Soki abonzi mwana meme lokola mbeka mpo na masumu na ye, asengeli komema mwana meme ya mwasi ezanga mbeba.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.32",
            "verseOrgIds": [
              "LEV.4.32"
            ]
