      },
      "items": [
        {
          "text": "41",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Babomi Gedalia",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 41:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na sanza ya sambo, Isimaeli, mwana mobali ya Netania mpe koko ya Elishama, oyo azalaki na molongo ya libota ya bokonzi mpe moko kati na bakengeli ya mokonzi, ayaki elongo na basoda zomi epai ya Gedalia, mwana mobali ya Ayikami, na Mitsipa. Wana bazalaki kolia na Mitsipa,",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.1",
            "verseOrgIds": [
              "JER.41.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 41:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isimaeli, mwana mobali ya Netania, elongo na basoda wana zomi oyo bazalaki elongo na ye babomaki na mopanga Gedalia, mwana mobali ya Ayikami, mwana mobali ya Shafani, oyo mokonzi ya Babiloni akomisaki moyangeli kati na mokili.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.2",
            "verseOrgIds": [
              "JER.41.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 41:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isimaeli abomaki lisusu Bayuda oyo bazalaki elongo na Gedalia, na Mitsipa, elongo na basoda ya Babiloni oyo bazalaki wana.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.3",
            "verseOrgIds": [
              "JER.41.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 41:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mokolo oyo elandaki kufa ya Gedalia, liboso ete sango eyebana epai ya bato,",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.4",
            "verseOrgIds": [
              "JER.41.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 41:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "bato tuku mwambe bawutaki na Sishemi, na Silo mpe na Samari ; bazalaki na mandefu bakata, bilamba epasuka-pasuka, mpe bamizokisaki-zokisaki bapota na banzoto. Bamemaki makabo ya bagato mpe malasi ya ansa mpo na kobonza yango kati na Tempelo ya Yawe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.5",
            "verseOrgIds": [
              "JER.41.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 41:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isimaeli, mwana mobali ya Netania, abimaki na Mitsipa mpo na kokende kokutana na bango ; wana azalaki kokende kokutana na bango, azalaki kolela nzela-nzela. Bongo tango akutanaki na bango, alobaki na bango :",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.6",
            "verseOrgIds": [
              "JER.41.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "JER 41:6"
      },
      "items": [
        {
          "text": "— Boya kotala Gedalia, mwana mobali ya Ayikami !",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 41:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tango bakotaki kati na engumba, Isimaeli, mwana mobali ya Netania, mpe bato oyo bazalaki elongo na ye babomaki bango mpe babwakaki bango na libulu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.7",
            "verseOrgIds": [
              "JER.41.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 41:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasi bato zomi kati na bango balobaki na Isimaeli :",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.8",
            "verseOrgIds": [
              "JER.41.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "JER 41:8"
      },
      "items": [
        {
          "text": "— Koboma biso te ! Tozali na ble, na orje, na mafuta mpe na mafuta ya nzoyi, oyo tobombaki kati na bilanga.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JER 41:8"
      },
      "items": [
        {
          "text": "Boye, abomaki bango lisusu te, abikisaki bango elongo na bandeko na bango.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.8",
            "verseOrgIds": [
              "JER.41.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 41:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Libulu epai wapi Isimaeli abwakaki bato nyonso oyo abomaki ezalaki libulu ya Gedalia, libulu oyo mokonzi Asa asalaki mpo na komibatela liboso ya Baesha, mokonzi ya Isalaele. Isimaeli, mwana mobali ya Netania, atondisaki yango na bibembe ;",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.9",
            "verseOrgIds": [
              "JER.41.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 41:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "bongo akomisaki bato nyonso oyo batikalaki na Mitsipa bawumbu : bana basi ya mokonzi mpe bato mosusu oyo batikalaki kuna na Mitsipa, oyo Nebuzaradani, mokonzi ya bakengeli ya mokonzi, atiaki na se ya bokonzi ya Gedalia, mwana mobali ya Ayikami. Isimaeli, mwana mobali ya Netania, amemaki bato oyo amemaki bango lokola bawumbu kati na mokili ya bato ya Amoni.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.10",
            "verseOrgIds": [
              "JER.41.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 41:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tango Yoanani, mwana mobali ya Karea, mpe bakonzi nyonso ya basoda, oyo bazalaki elongo na ye bayokaki sango ya makambo mabe oyo Isimaeli, mwana mobali ya Netania, asalaki,",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.11",
            "verseOrgIds": [
              "JER.41.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 41:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "basangisaki bato na bango nyonso mpe bakendeki kobundisa Isimaeli, mwana mobali ya Netania ; bakutanaki na ye pene ya liziba monene ya Gabaoni.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.12",
            "verseOrgIds": [
              "JER.41.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 41:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tango bawumbu nyonso oyo Isimaeli akangaki bamonaki Yoanani, mwana mobali ya Karea, mpe bakonzi nyonso ya basoda, oyo bazalaki elongo na ye, batondisamaki na esengo makasi ;",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.13",
            "verseOrgIds": [
              "JER.41.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 41:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "mpe bato nyonso oyo Isimaeli amemaki lokola bawumbu, na Mitsipa, babalukaki mpe bakendeki kosangana na Yoanani, mwana mobali ya Karea.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.14",
            "verseOrgIds": [
              "JER.41.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 41:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasi Isimaeli, mwana mobali ya Netania, mpe bato mwambe oyo bazalaki elongo na ye babikaki na maboko ya Yoanani mpe bakimaki epai ya bato ya Amoni.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.15",
            "verseOrgIds": [
              "JER.41.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 41:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sima na yango, Yoanani, mwana mobali ya Karea, mpe bakonzi nyonso ya basoda oyo bazalaki elongo na ye bamemaki bato nyonso ya Mitsipa oyo babikaki, oyo Isimaeli, mwana mobali ya Netania, amemaki na bowumbu wuta na Mitsipa sima na ye koboma Gedalia, mwana mobali ya Ayikami : basoda, basi, bana mpe bakalaka ya lokumu ya mokonzi ; elingi koloba bato nyonso oyo azongisaki wuta na Gabaoni.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.16",
            "verseOrgIds": [
              "JER.41.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 41:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakobaki nzela na bango mpe batelemaki na molako ya Kimeami, pene ya Beteleemi, mpo ete bazalaki na posa ya kokende na Ejipito",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.17",
            "verseOrgIds": [
              "JER.41.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 41:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "mpo na kokima bato ya Babiloni, pamba te bazalaki kobanga bango ; mpe mpo ete Isimaeli, mwana mobali ya Netania, abomaki Gedalia, mwana mobali ya Ayikami, oyo mokonzi ya Babiloni akomisaki moyangeli ya mokili.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.18",
            "verseOrgIds": [
              "JER.41.18"
            ]
          }
        }
      ]
    }
  ],
