          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "« Boni ! Bozali koyoka te makambo bato oyo bazali kosala ? Bazali koloba : ‹ Yawe asundoli bituka mibale oyo aponaki. › Na bongo, bazali kotiola bato na Ngai, mpe moto ata moko te azali kozwa bango lokola ekolo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.24",
            "verseOrgIds": [
              "JER.33.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
