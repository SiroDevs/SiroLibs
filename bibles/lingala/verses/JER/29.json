  "verseCount": 32,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "29",
        "style": "c",
        "sid": "JER 29"
      },
      "items": [
        {
          "text": "29",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mokanda epai ya bato oyo bakendeki na bowumbu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 29:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tala makomi ya mokanda oyo mosakoli Jeremi atindaki, wuta na Yelusalemi, epai ya bakambi oyo batikalaki kati na bato oyo bakendeki na bowumbu, epai ya Banganga-Nzambe, epai ya basakoli mpe epai ya bato nyonso oyo Nabukodonozori amemaki na bowumbu, na Babiloni wuta na Yelusalemi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.1",
            "verseOrgIds": [
              "JER.29.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 29:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mokanda yango etindamaki sima na bato oyo kokende na bawumbu longwa na Yelusalemi : mokonzi Yekonia, mama ya mokonzi, bakalaka na ye ya lokumu, bakambi ya Yuda mpe ya Yelusalemi, bato oyo balambaka bibende na moto mpe bato ya misala ya maboko.",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.2",
            "verseOrgIds": [
              "JER.29.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 29:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apesaki mokanda yango na maboko ya Eleasa, mwana mobali ya Shafani ; mpe na maboko ya Gemaria, mwana mobali ya Ilikia. Ezali bango nde Sedesiasi, mokonzi ya Yuda, atindaki na Babiloni epai ya Nabukodonozori, mokonzi ya Babiloni. Mokanda yango elobaki boye :",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.3",
            "verseOrgIds": [
              "JER.29.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 29:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tala liloba oyo Yawe, Mokonzi ya mampinga, Nzambe ya Isalaele, alobi epai ya bato nyonso oyo namemaki na bowumbu, na Babiloni wuta na Yelusalemi :",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.4",
            "verseOrgIds": [
              "JER.29.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 29:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "« Botonga bandako mpe bovanda kuna ; bolona banzete mpe bolia mbuma na yango ;",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.5",
            "verseOrgIds": [
              "JER.29.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 29:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "bobalana, bobota bana mibali mpe bana basi, bolukela bana na bino ya mibali basi mpe bobalisa bana na bino ya basi, mpo ete bango mpe babota bana mibali mpe bana basi. Bobotana kuna mpe bokoma ebele, mpe botika te ete motango na bino ekita.",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.6",
            "verseOrgIds": [
              "JER.29.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 29:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boluka kimia mpe bolamu ya engumba epai wapi namemaki bino na bowumbu ; bobondela Yawe mpo na yango, pamba te soki yango ebongi, bino mpe bokozala malamu. »",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.7",
            "verseOrgIds": [
              "JER.29.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 29:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solo, tala liloba oyo Yawe, Mokonzi ya mampinga, Nzambe ya Isalaele, alobi : « Bomitika te ete basakoli mpe bato ya soloka oyo bazali kati na bino bakosa bino : bondimela te bato oyo bazali kolimbolela bino bandoto.",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.8",
            "verseOrgIds": [
              "JER.29.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 29:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamba te bazali nde kosakola makambo ya lokuta na Kombo na Ngai ; natindi bango te, » elobi Yawe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.9",
            "verseOrgIds": [
              "JER.29.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 29:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasi tala liloba oyo Yawe alobi : « Tango mibu tuku sambo ekokoka mpo na Babiloni, nakoya epai na bino mpe nakokokisa elaka na Ngai ya ngolu mpo na kozongisa bino na esika oyo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.10",
            "verseOrgIds": [
              "JER.29.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 29:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamba te nayebi malamu mabongisi oyo nasalaki mpo na bino, » elobi Yawe, « mabongisi ya kosalela bino bolamu, kasi ya konyokola bino te, mabongisi mpo na kopesa bino elikya mpe bomoi malamu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.11",
            "verseOrgIds": [
              "JER.29.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 29:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boye bokobelela Ngai, bokoya epai na Ngai mpe bokobondela Ngai ; mpe Ngai nakoyoka bino.",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.12",
            "verseOrgIds": [
              "JER.29.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 29:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bokoluka Ngai mpe bokomona Ngai, soki boluki Ngai na motema na bino mobimba.",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.13",
            "verseOrgIds": [
              "JER.29.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 29:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakomimonisa epai na bino, » elobi Yawe, « mpe nakozongisa bino longwa na bowumbu. Nakosangisa bino longwa na bikolo nyonso mpe na bisika nyonso epai wapi nabenganaki bino, » elobi Yawe, « nakozongisa bino na esika oyo namemelaki bino na bowumbu. »",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.14",
            "verseOrgIds": [
              "JER.29.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 29:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solo, bokoki koloba : « Yawe abimisi basakoli kati na biso awa na Babiloni ! »",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.15",
            "verseOrgIds": [
              "JER.29.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 29:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasi tala liloba oyo Yawe alobi na tina na mokonzi oyo avandi na kiti ya bokonzi ya Davidi, na tina na bavandi nyonso ya engumba oyo, mpe na tina na bandeko na bino oyo bakendeki te na bowumbu elongo na bino ;",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.16",
            "verseOrgIds": [
              "JER.29.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 29:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "tala liloba oyo Yawe, Mokonzi ya mampinga, alobi : « Nakotindela bango mopanga, nzala makasi mpe bokono oyo ebomaka, mpe nakokomisa bango lokola mbuma ya figi oyo epola, oyo moto ata moko te akokoka kolia.",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.17",
            "verseOrgIds": [
              "JER.29.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 29:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakolanda bango na mopanga, na nzala makasi mpe na bokono oyo ebomaka ; mpe na miso ya bikolo nyonso ya mabele, nakokomisa bango eloko ya koyoka somo, ndakisa mpo na koloba maloba ya bosoloka, eloko ya lisuma, eloko ya kobanga mpe ya kotiola kati na bikolo nyonso epai wapi nakobengana bango.",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.18",
            "verseOrgIds": [
              "JER.29.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 29:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamba te bayokaki maloba na Ngai te, » elobi Yawe, « maloba oyo nazalaki kotindela bango tango na tango na nzela ya basali na Ngai, basakoli. Mpe bino bato oyo bokendeki na bowumbu, bino mpe boyokaki te, » elobi Yawe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.19",
            "verseOrgIds": [
              "JER.29.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 29:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yango wana, boyoka Liloba na Yawe, bino bawumbu nyonso oyo natindaki na Babiloni longwa na Yelusalemi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.20",
            "verseOrgIds": [
              "JER.29.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 29:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tala liloba oyo Yawe, Mokonzi ya mampinga, Nzambe ya Isalaele, alobi na tina na Akabi, mwana mobali ya Kolaya, mpe na tina na Sedesiasi, mwana mobali ya Maaseya, oyo bazali kosakola makambo ya lokuta epai na bino, na Kombo na Ngai : « Nakokaba bango na maboko ya Nabukodonozori, mokonzi ya Babiloni, mpe akoboma bango na miso na bino.",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.21",
            "verseOrgIds": [
              "JER.29.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 29:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Likolo na bango, bawumbu nyonso oyo bawutaki na Yuda, bongo bazali na Babiloni, bakosalela elakeli mabe oyo : ‹ Tika ete Yawe asala bino ndenge asalaki Sedesiasi mpe Akabi, oyo mokonzi ya Babiloni atumbaki na moto ! ›",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.22",
            "verseOrgIds": [
              "JER.29.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 29:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamba te basalaki kati na Isalaele ekobo elongo na basi ya baninga na bango, bapaya, mpe balobaki lokuta na Kombo na Ngai, nzokande Ngai natindaki bango te kosala bongo. Nayebi yango malamu, mpe Ngai moko nazali Motatoli na yango, » elobi Yawe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.23",
            "verseOrgIds": [
              "JER.29.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Maloba epai ya Shemaya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 29:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yebisa Shemaya, moto ya Nekelami, maloba oyo :",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.24",
            "verseOrgIds": [
              "JER.29.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 29:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "« Tala liloba oyo Yawe, Mokonzi ya mampinga, Nzambe ya Isalaele, alobi : Otindaki mikanda na kombo na yo moko epai ya bato nyonso ya Yelusalemi, epai ya Nganga-Nzambe Sofoni, mwana mobali ya Maaseya, mpe epai ya Banganga-Nzambe. Olobaki na Sofoni :",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.25",
            "verseOrgIds": [
              "JER.29.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 29:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "‹ Yawe aponaki yo Nganga-Nzambe na esika ya Yeoyada mpo ete obatela Tempelo ya Yawe. Osengelaki kobwaka na boloko mpe kokanga bibende na makolo, bato pamba oyo bazali komimona lokola basakoli.",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.26",
            "verseOrgIds": [
              "JER.29.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 29:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boye, mpo na nini opamelaki te mosakoli Jeremi, moto ya Anatoti, oyo azali komimona lokola mosakoli kati na bino ?",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.27",
            "verseOrgIds": [
              "JER.29.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JER 29:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atindelaki biso sango oyo kati na Babiloni : Bowumbu na bino ekowumela tango molayi. Yango wana, botonga bandako mpe bovanda kuna, bolona bilanga mpe bolia mbuma na yango. › »",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.28",
            "verseOrgIds": [
              "JER.29.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JER 29:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzokande, Nganga-Nzambe Sofoni atangisaki mosakoli Jeremi mokanda yango.",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.29",
            "verseOrgIds": [
              "JER.29.29"
            ]
          }
        },
