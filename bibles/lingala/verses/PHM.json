    "verseCount": 25,
    "content": [
      {
        "name": "chapter",
        "type": "tag",
        "attrs": {
          "number": "1",
          "style": "c",
          "sid": "PHM 1"
        },
        "items": [
          {
            "text": "1",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "s1"
        },
        "items": [
          {
            "text": "Mbote",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "m"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "1",
              "style": "v",
              "sid": "PHM 1:1"
            },
            "items": [
              {
                "text": "1",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ngai Polo, mokangami na boloko mpo na Yesu-Klisto, mpe Timote, ndeko na biso ;",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.1",
              "verseOrgIds": [
                "PHM.1.1"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "b",
          "vid": "PHM 1:1"
        },
        "items": []
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "mi",
          "vid": "PHM 1:1"
        },
        "items": [
          {
            "text": "Epai ya Filemo, molingami na biso mpe moninga ya mosala ;",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.1",
              "verseOrgIds": [
                "PHM.1.1"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "mi"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "2",
              "style": "v",
              "sid": "PHM 1:2"
            },
            "items": [
              {
                "text": "2",
                "type": "text"
              }
            ]
          },
          {
            "text": "epai ya Apia, ndeko na biso ya mwasi ;",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.2",
              "verseOrgIds": [
                "PHM.1.2"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "mi",
          "vid": "PHM 1:2"
        },
        "items": [
          {
            "text": "epai ya Arshipe, moninga na biso ya etumba ;",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.2",
              "verseOrgIds": [
                "PHM.1.2"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "mi",
          "vid": "PHM 1:2"
        },
        "items": [
          {
            "text": "mpe epai ya Lingomba oyo esanganaka na ndako ya Filemo :",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.2",
              "verseOrgIds": [
                "PHM.1.2"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "b"
        },
        "items": []
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "m"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "3",
              "style": "v",
              "sid": "PHM 1:3"
            },
            "items": [
              {
                "text": "3",
                "type": "text"
              }
            ]
          },
          {
            "text": "Tika ete ngolu mpe kimia epesamela bino kowuta na Nzambe, Tata na biso, mpe na Nkolo Yesu-Klisto !",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.3",
              "verseOrgIds": [
                "PHM.1.3"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "b"
        },
        "items": []
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "s1"
        },
        "items": [
          {
            "text": "Matondi mpe libondeli",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "4",
              "style": "v",
              "sid": "PHM 1:4"
            },
            "items": [
              {
                "text": "4",
                "type": "text"
              }
            ]
          },
          {
            "text": "Tango nyonso nasambelaka, natangaka kombo na yo mpe nazongisaka matondi epai ya Nzambe na ngai,",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.4",
              "verseOrgIds": [
                "PHM.1.4"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "5",
              "style": "v",
              "sid": "PHM 1:5"
            },
            "items": [
              {
                "text": "5",
                "type": "text"
              }
            ]
          },
          {
            "text": "pamba te nazali koyoka sango ya bolingo na yo mpo na basantu nyonso, mpe ya kondima na yo kati na Nkolo Yesu.",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.5",
              "verseOrgIds": [
                "PHM.1.5"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "6",
              "style": "v",
              "sid": "PHM 1:6"
            },
            "items": [
              {
                "text": "6",
                "type": "text"
              }
            ]
          },
          {
            "text": "Nabondelaka ete kondima oyo ezali kosangisa biso emonisama na misala, mpo ete ososola malamu bolamu nyonso oyo tozali na yango kati na Klisto.",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.6",
              "verseOrgIds": [
                "PHM.1.6"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "7",
              "style": "v",
              "sid": "PHM 1:7"
            },
            "items": [
              {
                "text": "7",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ndeko na ngai, bolingo na yo mpo na basantu ezali penza kopesa ngai esengo mingi mpe kolendisa ngai, pamba te okitisaki bango mitema.",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.7",
              "verseOrgIds": [
                "PHM.1.7"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "s1"
        },
        "items": [
          {
            "text": "Polo asengi mpo na Onezime",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "8",
              "style": "v",
              "sid": "PHM 1:8"
            },
            "items": [
              {
                "text": "8",
                "type": "text"
              }
            ]
          },
          {
            "text": "Yango wana, atako, kati na Klisto, nazali na makoki ya kotinda yo kosala likambo songolo to pakala,",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.8",
              "verseOrgIds": [
                "PHM.1.8"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "9",
              "style": "v",
              "sid": "PHM 1:9"
            },
            "items": [
              {
                "text": "9",
                "type": "text"
              }
            ]
          },
          {
            "text": "kasi nasepeli kosenga na yo na kombo ya bolingo, ngai Polo, mobange mpe sik'oyo mokangami na boloko mpo na Yesu-Klisto ;",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.9",
              "verseOrgIds": [
                "PHM.1.9"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "10",
              "style": "v",
              "sid": "PHM 1:10"
            },
            "items": [
              {
                "text": "10",
                "type": "text"
              }
            ]
          },
          {
            "text": "nasepeli kosenga na yo na tina na Onezime oyo azali mwana na ngai kati na Klisto, pamba te nakomaki tata na ye ya molimo awa, kati na boloko.",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.10",
              "verseOrgIds": [
                "PHM.1.10"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "11",
              "style": "v",
              "sid": "PHM 1:11"
            },
            "items": [
              {
                "text": "11",
                "type": "text"
              }
            ]
          },
          {
            "text": "Na kala, azalaki na tina ata moko te na miso na yo, kasi sik'oyo akomi na tina mingi na miso na yo mpe na miso na ngai.",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.11",
              "verseOrgIds": [
                "PHM.1.11"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "12",
              "style": "v",
              "sid": "PHM 1:12"
            },
            "items": [
              {
                "text": "12",
                "type": "text"
              }
            ]
          },
          {
            "text": "Nazali kozongisa ye epai na yo, pamba te azali penza motema na ngai.",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.12",
              "verseOrgIds": [
                "PHM.1.12"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "13",
              "style": "v",
              "sid": "PHM 1:13"
            },
            "items": [
              {
                "text": "13",
                "type": "text"
              }
            ]
          },
          {
            "text": "Nalingaki ete atikala elongo na ngai awa, na boloko epai wapi nazali mpo na Sango Malamu, mpo ete asalisa ngai na esika na yo.",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.13",
              "verseOrgIds": [
                "PHM.1.13"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "14",
              "style": "v",
              "sid": "PHM 1:14"
            },
            "items": [
              {
                "text": "14",
                "type": "text"
              }
            ]
          },
          {
            "text": "Nzokande nakokaki te kosala yango, pamba te nazwaki ndingisa na yo te, mpo ete bolamu oyo okosala ezala oyo ewuti na motema na yo moko, kasi na kotindika te.",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.14",
              "verseOrgIds": [
                "PHM.1.14"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "15",
              "style": "v",
              "sid": "PHM 1:15"
            },
            "items": [
              {
                "text": "15",
                "type": "text"
              }
            ]
          },
          {
            "text": "Tango mosusu, mwa tango moke oyo bozalaki ya kokabwana na Onezime ezalaki mpo ete ozwa ye mpo na libela,",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.15",
              "verseOrgIds": [
                "PHM.1.15"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "16",
              "style": "v",
              "sid": "PHM 1:16"
            },
            "items": [
              {
                "text": "16",
                "type": "text"
              }
            ]
          },
          {
            "text": "lokola mowumbu lisusu te kasi koleka kutu ata mowumbu, lokola ndeko ya bolingo. Azali na litomba mingi mpo na ngai, kasi azali mpe na litomba mingi lisusu koleka mpo na yo, lokola moto mpe lokola ndeko kati na Nkolo.",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.16",
              "verseOrgIds": [
                "PHM.1.16"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "17",
              "style": "v",
              "sid": "PHM 1:17"
            },
            "items": [
              {
                "text": "17",
                "type": "text"
              }
            ]
          },
          {
            "text": "Soki ya solo ozwaka ngai lokola ndeko na yo kati na kondima, yamba ye lokola nde oyambi ngai.",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.17",
              "verseOrgIds": [
                "PHM.1.17"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "18",
              "style": "v",
              "sid": "PHM 1:18"
            },
            "items": [
              {
                "text": "18",
                "type": "text"
              }
            ]
          },
          {
            "text": "Soki asalaki yo mabe to mpe azali na niongo na yo, tanga yango na moto na ngai.",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.18",
              "verseOrgIds": [
                "PHM.1.18"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "19",
              "style": "v",
              "sid": "PHM 1:19"
            },
            "items": [
              {
                "text": "19",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ezali loboko na ngai moko Polo nde ezali kokoma makambo oyo : ngai moko nakofuta yo niongo yango. Nazali mpe na posa te ya kokanisela yo ete yo mpe ozali na niongo na ngai : niongo yango ezali nde bomoi na yo.",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.19",
              "verseOrgIds": [
                "PHM.1.19"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "20",
              "style": "v",
              "sid": "PHM 1:20"
            },
            "items": [
              {
                "text": "20",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ndeko na ngai, mpo na bolingo ya Nkolo, salela ngai bolamu wana ; kitisa ngai motema lokola ndeko na yo kati na Klisto.",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.20",
              "verseOrgIds": [
                "PHM.1.20"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "21",
              "style": "v",
              "sid": "PHM 1:21"
            },
            "items": [
              {
                "text": "21",
                "type": "text"
              }
            ]
          },
          {
            "text": "Nakomeli yo na elikya ete okosala makambo oyo nasengi yo, mpe nayebi ete okosala kutu koleka.",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.21",
              "verseOrgIds": [
                "PHM.1.21"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "22",
              "style": "v",
              "sid": "PHM 1:22"
            },
            "items": [
              {
                "text": "22",
                "type": "text"
              }
            ]
          },
          {
            "text": "Nasengi na yo lisusu ete obongisela ngai esika ya kolala, pamba te nazali na elikya ete Nzambe akozongisa ngai epai na bino lokola eyano na mabondeli na bino.",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.22",
              "verseOrgIds": [
                "PHM.1.22"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "b"
        },
        "items": []
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "s1"
        },
        "items": [
          {
            "text": "Bambote ya suka",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "23",
              "style": "v",
              "sid": "PHM 1:23"
            },
            "items": [
              {
                "text": "23",
                "type": "text"
              }
            ]
          },
          {
            "text": "Epafrasi, moninga na ngai ya boloko kati na Yesu-Klisto, atindeli yo mbote.",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.23",
              "verseOrgIds": [
                "PHM.1.23"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "24",
              "style": "v",
              "sid": "PHM 1:24"
            },
            "items": [
              {
                "text": "24",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ndenge moko mpe Malako, Arisitarke, Demasi mpe Luka, baninga na ngai ya mosala, bango mpe batindeli yo mbote.",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.24",
              "verseOrgIds": [
                "PHM.1.24"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "b"
        },
        "items": []
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "25",
              "style": "v",
              "sid": "PHM 1:25"
            },
            "items": [
              {
                "text": "25",
                "type": "text"
              }
            ]
          },
          {
            "text": "Tika ete ngolu ya Yesu-Klisto, Nkolo na biso, ezala elongo na molimo na yo !",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.25",
              "verseOrgIds": [
                "PHM.1.25"
              ]
            }
          }
        ]
      }
    ],
