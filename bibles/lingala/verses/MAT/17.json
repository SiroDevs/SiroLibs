    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 17:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mokolo moko, bayekoli basanganaki bango nyonso kati na Galile ; Yesu alobaki na bango :",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.22",
            "verseOrgIds": [
              "MAT.17.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "MAT 17:22"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "— Bakokaba Mwana na Moto na maboko ya bato,",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 17:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "bakoboma Ye, mpe, na mokolo ya misato, akosekwa.",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "MAT 17:23"
      },
      "items": [
        {
          "text": "Bayekoli bayokaki mawa mingi.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.23",
            "verseOrgIds": [
              "MAT.17.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu mpe Petelo bafuti mpako",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 17:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tango Yesu mpe bayekoli na Ye bakomaki na Kapernawumi, bafutisi mpako ya Ndako ya Nzambe bayaki epai ya Petelo mpe batunaki :",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.24",
            "verseOrgIds": [
              "MAT.17.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "MAT 17:24"
      },
      "items": [
        {
          "text": "— Boni, moteyi na bino afutaka mpako ya Ndako ya Nzambe te ?",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 17:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Petelo azongisaki :",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.25",
            "verseOrgIds": [
              "MAT.17.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "MAT 17:25"
      },
      "items": [
        {
          "text": "— Afutaka !",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "MAT 17:25"
      },
      "items": [
        {
          "text": "Tango Petelo akotaki na ndako, Yesu azwaki maloba moto ya liboso mpe atunaki ye :",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.25",
            "verseOrgIds": [
              "MAT.17.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "MAT 17:25"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "— Simona, okanisi nini ? Banani bafutaka mpako epai ya bakonzi ya mokili : bana na bango to bapaya ?",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 17:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Petelo azongisaki :",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.26",
            "verseOrgIds": [
              "MAT.17.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "MAT 17:26"
      },
      "items": [
        {
          "text": "— Bapaya.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "MAT 17:26"
      },
      "items": [
        {
          "text": "Yesu alobaki na ye :",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.26",
            "verseOrgIds": [
              "MAT.17.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "MAT 17:26"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "— Lokola ezali bongo, bana mboka basengeli kofuta te.",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 17:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nzokande, mpo ete totia mobulu te kati na makanisi na bango, kende na ebale, bwaka ndobo na mayi mpe kamata mbisi oyo okozwa ya liboso ; fungola monoko na yango mpe okomona mbongo moko ya bibende kati na yango ; kamata mbongo yango mpe futa mpako na Ngai mpe mpako na yo, na maboko na bango.",
              "type": "text"
            }
          ]
        }
      ]
    }
