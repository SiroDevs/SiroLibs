        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Moto nyonso oyo akotatola liboso ya bato ete azali moto na Ngai, Ngai mpe nakotatola liboso ya Tata na Ngai, oyo azali kati na Likolo, ete nazali mpo na ye ;",
              "type": "text"
