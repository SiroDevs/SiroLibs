          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "kasi ye oyo akowangana Ngai na miso ya bato, Ngai mpe nakowangana ye liboso ya Tata na Ngai, oyo azali kati na Likolo.",
              "type": "text"
            }
          ]
        }
      ]
    },
