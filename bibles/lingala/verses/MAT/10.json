        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Bokanisa te ete nayaki mpo na komema kimia na mokili. Nayaki mpo na komema kimia te, kasi mopanga.",
