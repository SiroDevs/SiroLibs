            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Moto oyo ayambaka mosakoli mpo ete azali mosakoli akozwa lifuti ya ndenge moko na mosakoli, mpe moto oyo ayambaka moto ya sembo mpo ete azali moto ya sembo akozwa lifuti ya ndenge moko na moto ya sembo.",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "MAT 10:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Moto nyonso oyo apesaka ata kopo moko kaka ya mayi ya malili epai ya moko kati na bana mike oyo, mpo ete azali moyekoli na Ngai, nazali koloba na bino penza ya solo, akotikala kobungisa te lifuti na ye.",
              "type": "text"
            }
          ]
        }
      ]
