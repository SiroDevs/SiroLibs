          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "mpe kati na mwasi ya libala mpe mama-bokilo na ye :",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.35",
                "verseOrgIds": [
                  "MAT.10.35"
