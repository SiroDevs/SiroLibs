  "verseCount": 14,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "7",
        "style": "c",
        "sid": "SNG 7"
      },
      "items": [
        {
          "text": "7",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s2"
      },
      "items": [
        {
          "text": "Baninga",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "SNG 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zonga, zonga, oh mwasi ya Sulami !",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.1",
            "verseOrgIds": [
              "SNG.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 7:1"
      },
      "items": [
        {
          "text": "Zonga, zonga mpo ete tokoka kotala yo malamu !",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.1",
            "verseOrgIds": [
              "SNG.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 7:1"
      },
      "items": [
        {
          "text": "Mpo na nini bolingi kotala malamu mwasi ya Sulami",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.1",
            "verseOrgIds": [
              "SNG.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 7:1"
      },
      "items": [
        {
          "text": "ndenge batalaka mabina ya mindule ya masanga mibale ?",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.1",
            "verseOrgIds": [
              "SNG.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s2"
      },
      "items": [
        {
          "text": "Elenge mobali",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "SNG 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oh elenge mwasi ya lokumu !",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.2",
            "verseOrgIds": [
              "SNG.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 7:2"
      },
      "items": [
        {
          "text": "Makolo na yo ebimaka kitoko soki olati basandale.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.2",
            "verseOrgIds": [
              "SNG.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 7:2"
      },
      "items": [
        {
          "text": "Zingazinga ya loketo na yo ezali lokola lopete",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.2",
            "verseOrgIds": [
              "SNG.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 7:2"
      },
      "items": [
        {
          "text": "oyo esalemi na maboko ya basali bikeko.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.2",
            "verseOrgIds": [
              "SNG.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "SNG 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Motolu na yo ezali lokola kopo ya kitoko",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.3",
            "verseOrgIds": [
              "SNG.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 7:3"
      },
      "items": [
        {
          "text": "oyo ezangaka vino ya kitoko te.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.3",
            "verseOrgIds": [
              "SNG.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 7:3"
      },
      "items": [
        {
          "text": "Libumu na yo ezali lokola mopiku ya ble",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.3",
            "verseOrgIds": [
              "SNG.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 7:3"
      },
      "items": [
        {
          "text": "oyo ezingami na fololo oyo babengaka lisi.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.3",
            "verseOrgIds": [
              "SNG.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "SNG 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mabele na yo nyonso mibale ezali",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.4",
            "verseOrgIds": [
              "SNG.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 7:4"
      },
      "items": [
        {
          "text": "lokola bana mapasa mibale ya mboloko.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.4",
            "verseOrgIds": [
              "SNG.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "SNG 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kingo na yo ezali lokola ndako molayi",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.5",
            "verseOrgIds": [
              "SNG.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 7:5"
      },
      "items": [
        {
          "text": "oyo batonga na pembe ya nzoko.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.5",
            "verseOrgIds": [
              "SNG.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 7:5"
      },
      "items": [
        {
          "text": "Miso na yo ezali lokola maziba ya engumba Eshiboni,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.5",
            "verseOrgIds": [
              "SNG.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 7:5"
      },
      "items": [
        {
          "text": "pembeni ya ekuke ya Bati-Rabimi.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.5",
            "verseOrgIds": [
              "SNG.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 7:5"
      },
      "items": [
        {
          "text": "Zolo na yo ezali lokola ndako molayi ya Libani",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.5",
            "verseOrgIds": [
              "SNG.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 7:5"
      },
      "items": [
        {
          "text": "oyo etalani na Damasi.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.5",
            "verseOrgIds": [
              "SNG.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "SNG 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moto na yo ezali lokola ngomba Karimeli,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.6",
            "verseOrgIds": [
              "SNG.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 7:6"
      },
      "items": [
        {
          "text": "mpe suki ya moto na yo ezali lokola elamba ya motane ;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.6",
            "verseOrgIds": [
              "SNG.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 7:6"
      },
      "items": [
        {
          "text": "mokonzi akangami na mazita na yango.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.6",
            "verseOrgIds": [
              "SNG.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "SNG 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oh tala ndenge ozali penza kitoko !",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.7",
            "verseOrgIds": [
              "SNG.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 7:7"
      },
      "items": [
        {
          "text": "Bolingo na ngai, osalaka esengo ya motema na ngai ;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.7",
            "verseOrgIds": [
              "SNG.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 7:7"
      },
      "items": [
        {
          "text": "kitoko na yo esalaka ngai esengo na motema !",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.7",
            "verseOrgIds": [
              "SNG.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "SNG 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Molayi na yo ezali lokola nzete ya mbila,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.8",
            "verseOrgIds": [
              "SNG.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 7:8"
      },
      "items": [
        {
          "text": "mabele na yo ezali lokola maboke ya bambuma.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.8",
            "verseOrgIds": [
              "SNG.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "SNG 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namilobeli : « Nakomata na nzete ya mbila,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.9",
            "verseOrgIds": [
              "SNG.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 7:9"
      },
      "items": [
        {
          "text": "nakobuka bambuma na yango ! »",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.9",
            "verseOrgIds": [
              "SNG.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "SNG 7:9"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 7:9"
      },
      "items": [
        {
          "text": "Tika ete mabele na yo ezala lokola maboke",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.9",
            "verseOrgIds": [
              "SNG.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 7:9"
      },
      "items": [
        {
          "text": "ya bambuma ya vino !",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.9",
            "verseOrgIds": [
              "SNG.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 7:9"
      },
      "items": [
        {
          "text": "Tika ete solo ya monoko na yo ezala lokola bapome !",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.9",
            "verseOrgIds": [
              "SNG.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "SNG 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpe tika ete monoko na yo ezala",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.10",
            "verseOrgIds": [
              "SNG.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 7:10"
      },
      "items": [
        {
          "text": "lokola vino ya kitoko koleka !",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.10",
            "verseOrgIds": [
              "SNG.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s2",
        "vid": "SNG 7:10"
      },
      "items": [
        {
          "text": "Elenge mwasi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 7:10"
      },
      "items": [
        {
          "text": "Tika ete vino yango esopanela bolingo na ngai na pete,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.10",
            "verseOrgIds": [
              "SNG.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 7:10"
      },
      "items": [
        {
          "text": "eleka na bibebu ya bato oyo bazali kolala.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.10",
            "verseOrgIds": [
              "SNG.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "SNG 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngai, nazali ya mobali na ngai ;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.11",
            "verseOrgIds": [
              "SNG.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 7:11"
      },
      "items": [
        {
          "text": "mpe ye, azalaka kaka na posa na ngai.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.11",
            "verseOrgIds": [
              "SNG.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "SNG 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaka, mobali na ngai ; tika ete tokende na biso na elanga,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.12",
            "verseOrgIds": [
              "SNG.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
