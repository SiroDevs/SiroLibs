            {
              "text": "Mlk 16.1-8",
              "type": "text"
            }
          ]
        },
        {
          "text": ";",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "JHN.20.1-JHN.20.13"
          },
          "items": [
            {
              "text": "Yn 20.1-13",
              "type": "text"
            }
          ]
        },
        {
