        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Na mokolo yango, moto oyo akozala na likolo ya ndako na ye asengeli te kokita mpo na kozwa biloko kati na ndako na ye, mpe moto oyo akozala kati na bilanga na ye asengeli te kozonga na ndako mpo na likambo songolo.",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
