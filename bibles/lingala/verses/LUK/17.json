      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "— Tango ezali koya, tango oyo bokozala na posa makasi ya komona ata mokolo moko kati na mikolo ya Mwana na Moto, kasi bokomona yango te.",
              "type": "text"
            }
          ]
