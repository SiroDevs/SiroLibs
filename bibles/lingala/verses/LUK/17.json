          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Moto oyo akoluka kobatela bomoi na ye akobungisa yango, mpe moto oyo akobungisa bomoi na ye akobatela yango.",
              "type": "text"
            }
          ]
        }
