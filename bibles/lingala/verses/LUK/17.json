          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kasi liboso ete mokolo yango ekoma, asengeli komona pasi mingi, mpe bato ya ekeke oyo basengeli koboya Ye.",
              "type": "text"
            }
          ]
        }
      ]
    },
