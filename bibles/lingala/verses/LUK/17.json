        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Bokanisa makambo oyo ekomelaki mwasi ya Loti !",
              "type": "text"
            }
          ]
