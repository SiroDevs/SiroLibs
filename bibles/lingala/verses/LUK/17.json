            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "basi mibale bakozala konika bambuma elongo : moko akokamatama, mpe mosusu akotikala ;",
              "type": "text"
            }
          ]
        },
        {
          "text": "[",
          "type": "text"
        },
