      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "LUK 17:37"
      },
      "items": [
        {
          "text": "— Nkolo, makambo yango ekosalema wapi ?",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "LUK 17:37"
      },
      "items": [
        {
          "text": "Yesu azongiselaki bango :",
