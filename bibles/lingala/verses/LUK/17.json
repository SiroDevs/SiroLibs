          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "mibali mibale bakozala kati na elanga moko : moko akokamatama, mpe mosusu akotikala.",
              "type": "text"
            }
          ]
        },
        {
          "text": "]",
          "type": "text"
