  "verseCount": 12,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "25",
        "style": "c",
        "sid": "ISA 25"
      },
      "items": [
        {
          "text": "25",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nzembo mpo na kokumisa Yawe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 25:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe, ozali Nzambe na ngai ;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.1",
            "verseOrgIds": [
              "ISA.25.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 25:1"
      },
      "items": [
        {
          "text": "nakonetola Yo mpe nakosanzola Kombo na Yo ;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.1",
            "verseOrgIds": [
              "ISA.25.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 25:1"
      },
      "items": [
        {
          "text": "pamba te na boyengebene na Yo ya kokoka,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.1",
            "verseOrgIds": [
              "ISA.25.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 25:1"
      },
      "items": [
        {
          "text": "osalaki mabongisi ya kokamwa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.1",
            "verseOrgIds": [
              "ISA.25.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 25:1"
      },
      "items": [
        {
          "text": "makambo oyo obongisa wuta kala.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.1",
            "verseOrgIds": [
              "ISA.25.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okomisaki engumba mopiku ya mabanga,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.2",
            "verseOrgIds": [
              "ISA.25.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 25:2"
      },
      "items": [
        {
          "text": "okomisaki bingumba ya makasi maboke ya mabanga ;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.2",
            "verseOrgIds": [
              "ISA.25.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 25:2"
      },
      "items": [
        {
          "text": "bandako batonga makasi ya bapaya etikali",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.2",
            "verseOrgIds": [
              "ISA.25.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 25:2"
      },
      "items": [
        {
          "text": "lisusu na bilongi ya engumba te,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.2",
            "verseOrgIds": [
              "ISA.25.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 25:2"
      },
      "items": [
        {
          "text": "bakotonga yango lisusu te.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.2",
            "verseOrgIds": [
              "ISA.25.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yango wana, bato ya nguya bakopesa Yo lokumu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.3",
            "verseOrgIds": [
              "ISA.25.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 25:3"
      },
      "items": [
        {
          "text": "bingumba ya bikolo ya kanza ekotosa Yo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.3",
            "verseOrgIds": [
              "ISA.25.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ozalaki ekimelo mpo na mobola,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.4",
            "verseOrgIds": [
              "ISA.25.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 25:4"
      },
      "items": [
        {
          "text": "ekimelo mpo na moto oyo akelela, na tango ya pasi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.4",
            "verseOrgIds": [
              "ISA.25.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 25:4"
      },
      "items": [
        {
          "text": "ebombamelo na tango ya mvula makasi",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.4",
            "verseOrgIds": [
              "ISA.25.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 25:4"
      },
      "items": [
        {
          "text": "mpe pio na tango ya molunge.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.4",
            "verseOrgIds": [
              "ISA.25.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 25:4"
      },
      "items": [
        {
          "text": "Pamba te pema ya banyokoli ezali",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.4",
            "verseOrgIds": [
              "ISA.25.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 25:4"
      },
      "items": [
        {
          "text": "lokola mvula ya makasi oyo ebukaka bamir ;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.4",
            "verseOrgIds": [
              "ISA.25.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "mpe lokola moto ya moyi na zelo ya esobe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.5",
            "verseOrgIds": [
              "ISA.25.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 25:5"
      },
      "items": [
        {
          "text": "Osilisaki makelele ya bapaya",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.5",
            "verseOrgIds": [
              "ISA.25.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 25:5"
      },
      "items": [
        {
          "text": "ndenge pio ya mapata esilisaka molunge ;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.5",
            "verseOrgIds": [
              "ISA.25.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 25:5"
      },
      "items": [
        {
          "text": "boye nde nzembo ya banyokoli esilaki.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.5",
            "verseOrgIds": [
              "ISA.25.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ngomba oyo, Yawe, Mokonzi ya mampinga,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.6",
            "verseOrgIds": [
              "ISA.25.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 25:6"
      },
      "items": [
        {
          "text": "akobongisa feti ya biloko kitoko mpo na bato nyonso,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.6",
            "verseOrgIds": [
              "ISA.25.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 25:6"
      },
      "items": [
        {
          "text": "feti monene ya vino ya kala,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.6",
            "verseOrgIds": [
              "ISA.25.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 25:6"
      },
      "items": [
        {
          "text": "ya misuni oyo eleki mafuta mpe ya vino ya kala oyo balongola malamu salite.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.6",
            "verseOrgIds": [
              "ISA.25.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaka na ngomba oyo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.7",
            "verseOrgIds": [
              "ISA.25.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 25:7"
      },
      "items": [
        {
          "text": "akobebisa vwale oyo esili kozipa bato nyonso,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.7",
            "verseOrgIds": [
              "ISA.25.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 25:7"
      },
      "items": [
        {
          "text": "bulangeti oyo ezipi bikolo nyonso ;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.7",
            "verseOrgIds": [
              "ISA.25.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "akolimwisa kufa mpo na libela.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.8",
            "verseOrgIds": [
              "ISA.25.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 25:8"
      },
      "items": [
        {
          "text": "Nkolo Yawe akopangusa mpinzoli na bilongi nyonso,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.8",
            "verseOrgIds": [
              "ISA.25.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 25:8"
      },
      "items": [
        {
          "text": "akolongola soni ya bato na Ye kati na mokili mobimba.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.8",
            "verseOrgIds": [
              "ISA.25.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 25:8"
      },
      "items": [
        {
          "text": "Solo, Yawe alobi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.8",
            "verseOrgIds": [
              "ISA.25.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mokolo wana, bakoloba :",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.9",
            "verseOrgIds": [
              "ISA.25.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 25:9"
      },
      "items": [
        {
          "text": "« Solo, Oyo azali penza Nzambe na biso !",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.9",
            "verseOrgIds": [
              "ISA.25.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 25:9"
      },
      "items": [
        {
          "text": "Totiaki mitema epai na Ye mpe abikisi biso.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.9",
            "verseOrgIds": [
              "ISA.25.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 25:9"
      },
      "items": [
        {
          "text": "Oyo azali solo Yawe, totiaki mitema epai na Ye ;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.9",
            "verseOrgIds": [
              "ISA.25.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 25:9"
      },
      "items": [
        {
          "text": "tika ete tosepela mpe tozala na esengo",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.9",
            "verseOrgIds": [
              "ISA.25.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 25:9"
      },
      "items": [
        {
          "text": "mpo na lobiko oyo apesi biso ! »",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.9",
            "verseOrgIds": [
              "ISA.25.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Loboko na Yawe ekozala na ngomba oyo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.10",
            "verseOrgIds": [
              "ISA.25.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 25:10"
      },
      "items": [
        {
          "text": "kasi bakonyata-nyata Moabi na mokili na bango",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.10",
            "verseOrgIds": [
              "ISA.25.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 25:10"
      },
      "items": [
        {
          "text": "ndenge banyataka matiti kati na libulu ya fimie.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.10",
            "verseOrgIds": [
              "ISA.25.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akosembola maboko na Ye kati na yango",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.11",
            "verseOrgIds": [
              "ISA.25.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
