  "verseCount": 17,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "54",
        "style": "c",
        "sid": "ISA 54"
      },
      "items": [
        {
          "text": "54",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nkembo oyo ekoya na Yelusalemi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 54:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oh mwasi ekomba, yemba nzembo na esengo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.1",
            "verseOrgIds": [
              "ISA.54.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 54:1"
      },
      "items": [
        {
          "text": "yo oyo obotaka te !",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.1",
            "verseOrgIds": [
              "ISA.54.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 54:1"
      },
      "items": [
        {
          "text": "Yemba nzembo mpe ganga na esengo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.1",
            "verseOrgIds": [
              "ISA.54.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 54:1"
      },
      "items": [
        {
          "text": "yo mwasi oyo oyoki nanu pasi ya kobota te !",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.1",
            "verseOrgIds": [
              "ISA.54.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 54:1"
      },
      "items": [
        {
          "text": "Pamba te bana ya mwasi oyo basundola bakozala ebele",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.1",
            "verseOrgIds": [
              "ISA.54.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 54:1"
      },
      "items": [
        {
          "text": "koleka bana ya mwasi ya libala, elobi Yawe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.1",
            "verseOrgIds": [
              "ISA.54.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 54:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeisa ndako na yo ya kapo monene,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.2",
            "verseOrgIds": [
              "ISA.54.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 54:2"
      },
      "items": [
        {
          "text": "bakisa bakapo na ndako yango",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.2",
            "verseOrgIds": [
              "ISA.54.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 54:2"
      },
      "items": [
        {
          "text": "mpo ete eya monene ;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.2",
            "verseOrgIds": [
              "ISA.54.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 54:2"
      },
      "items": [
        {
          "text": "kokanga motema te !",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.2",
            "verseOrgIds": [
              "ISA.54.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 54:2"
      },
      "items": [
        {
          "text": "Benda na molayi basinga na yo",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.2",
            "verseOrgIds": [
              "ISA.54.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 54:2"
      },
      "items": [
        {
          "text": "mpe pika banzete na yo makasi !",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.2",
            "verseOrgIds": [
              "ISA.54.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 54:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamba te okofungwama",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.3",
            "verseOrgIds": [
              "ISA.54.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 54:3"
      },
      "items": [
        {
          "text": "na ngambo ya loboko na yo ya mobali",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.3",
            "verseOrgIds": [
              "ISA.54.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 54:3"
      },
      "items": [
        {
          "text": "mpe na ngambo ya loboko na yo ya mwasi ;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.3",
            "verseOrgIds": [
              "ISA.54.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 54:3"
      },
      "items": [
        {
          "text": "bakitani na yo bakokonza bikolo mosusu",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.3",
            "verseOrgIds": [
              "ISA.54.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 54:3"
      },
      "items": [
        {
          "text": "mpe bakosala ete bato bavanda lisusu",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.3",
            "verseOrgIds": [
              "ISA.54.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 54:3"
      },
      "items": [
        {
          "text": "na bingumba na bango oyo etikalaki lisusu na bato te.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.3",
            "verseOrgIds": [
              "ISA.54.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 54:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kobanga te, pamba te okoyoka lisusu soni te !",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.4",
            "verseOrgIds": [
              "ISA.54.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 54:4"
      },
      "items": [
        {
          "text": "Kozala na mawa te, pamba te okotiolama lisusu te !",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.4",
            "verseOrgIds": [
              "ISA.54.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 54:4"
      },
      "items": [
        {
          "text": "Okobosana soni ya bolenge na yo",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.4",
            "verseOrgIds": [
              "ISA.54.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 54:4"
      },
      "items": [
        {
          "text": "mpe okokanisa lisusu te",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.4",
            "verseOrgIds": [
              "ISA.54.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 54:4"
      },
      "items": [
        {
          "text": "pasi na yo ya kokufisa mobali ;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.4",
            "verseOrgIds": [
              "ISA.54.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 54:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "pamba te Mokeli na yo nde mobali na yo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.5",
            "verseOrgIds": [
              "ISA.54.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 54:5"
      },
      "items": [
        {
          "text": "Kombo na Ye : Yawe, Mokonzi ya mampinga ;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.5",
            "verseOrgIds": [
              "ISA.54.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 54:5"
      },
      "items": [
        {
          "text": "Mosantu ya Isalaele azali Mosikoli na yo ;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.5",
            "verseOrgIds": [
              "ISA.54.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 54:5"
      },
      "items": [
        {
          "text": "babengaka Ye : Nzambe ya mokili mobimba.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.5",
            "verseOrgIds": [
              "ISA.54.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 54:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamba te Yawe abengi yo lisusu",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.6",
            "verseOrgIds": [
              "ISA.54.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 54:6"
      },
      "items": [
        {
          "text": "lokola mwasi oyo basundola,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.6",
            "verseOrgIds": [
              "ISA.54.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 54:6"
      },
      "items": [
        {
          "text": "bongo azali na pasi na motema.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.6",
            "verseOrgIds": [
              "ISA.54.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 54:6"
      },
      "items": [
        {
          "text": "Ndenge nini bakoki solo kosundola",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.6",
            "verseOrgIds": [
              "ISA.54.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 54:6"
      },
      "items": [
        {
          "text": "mwasi oyo babala na bolenge, elobi Nzambe na yo ?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.6",
            "verseOrgIds": [
              "ISA.54.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 54:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nasundolaki yo kaka mpo na tango moke ;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.7",
            "verseOrgIds": [
              "ISA.54.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 54:7"
      },
      "items": [
        {
          "text": "kasi na bolingo nyonso, nakozongisa yo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.7",
            "verseOrgIds": [
              "ISA.54.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 54:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpo ete nazalaki na kanda makasi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.8",
            "verseOrgIds": [
              "ISA.54.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 54:8"
      },
      "items": [
        {
          "text": "nabombelaki yo elongi na Ngai",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.8",
            "verseOrgIds": [
              "ISA.54.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 54:8"
      },
      "items": [
        {
          "text": "kaka mpo na tango moke ;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.8",
            "verseOrgIds": [
              "ISA.54.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 54:8"
      },
      "items": [
        {
          "text": "kasi nakolakisa yo bolamu mpo na bolingo oyo ezangi suka,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.8",
            "verseOrgIds": [
              "ISA.54.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 54:8"
      },
      "items": [
        {
          "text": "elobi Yawe, Mosikoli na yo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.8",
            "verseOrgIds": [
              "ISA.54.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 54:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na miso na Ngai, ezali lokola na mikolo ya Noa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.9",
            "verseOrgIds": [
              "ISA.54.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 54:9"
      },
      "items": [
        {
          "text": "tango nalapaki ndayi ete mayi ya Noa",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.9",
            "verseOrgIds": [
              "ISA.54.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 54:9"
      },
      "items": [
        {
          "text": "ekozindisa lisusu mabele te.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.9",
            "verseOrgIds": [
              "ISA.54.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 54:9"
      },
      "items": [
        {
          "text": "Boye, nalapi solo ndayi sik'oyo",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.9",
            "verseOrgIds": [
              "ISA.54.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 54:9"
      },
      "items": [
        {
          "text": "ete nakosilikela yo lisusu te",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.9",
            "verseOrgIds": [
              "ISA.54.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
