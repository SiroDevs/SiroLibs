      },
      "items": [
        {
          "text": "32",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bokonzi ya sembo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 32:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tala, mokonzi moko akokonza na bosembo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.1",
            "verseOrgIds": [
              "ISA.32.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 32:1"
      },
      "items": [
        {
          "text": "mpe bakambi na ye bakokamba na solo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.1",
            "verseOrgIds": [
              "ISA.32.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 32:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moko na moko kati na bango akozala",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.2",
            "verseOrgIds": [
              "ISA.32.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 32:2"
      },
      "items": [
        {
          "text": "lokola ekimelo liboso ya mopepe",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.2",
            "verseOrgIds": [
              "ISA.32.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 32:2"
      },
      "items": [
        {
          "text": "mpe ebombamelo liboso ya mvula ya makasi ;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.2",
            "verseOrgIds": [
              "ISA.32.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 32:2"
      },
      "items": [
        {
          "text": "akozala lokola miluka ya mayi kati na esobe,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.2",
            "verseOrgIds": [
              "ISA.32.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 32:2"
      },
      "items": [
        {
          "text": "lokola elili ya libanga monene kati na mokili ya mabele ekawuka.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.2",
            "verseOrgIds": [
              "ISA.32.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 32:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Miso ya bato oyo bamonaka ekozipama lisusu te,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.3",
            "verseOrgIds": [
              "ISA.32.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 32:3"
      },
      "items": [
        {
          "text": "mpe matoyi ya bato oyo bayokaka ekoyoka malamu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.3",
            "verseOrgIds": [
              "ISA.32.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 32:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mito ya bato oyo bazangi mayele",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.4",
            "verseOrgIds": [
              "ISA.32.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 32:4"
      },
      "items": [
        {
          "text": "ekozwa boyebi mpe bososoli,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.4",
            "verseOrgIds": [
              "ISA.32.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 32:4"
      },
      "items": [
        {
          "text": "bongo lolemo ya bato ya likukuma ekokoma koloba",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.4",
            "verseOrgIds": [
              "ISA.32.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 32:4"
      },
      "items": [
        {
          "text": "noki-noki mpe malamu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.4",
            "verseOrgIds": [
              "ISA.32.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 32:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakobenga lisusu te moto ya lokumu zoba,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.5",
            "verseOrgIds": [
              "ISA.32.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 32:5"
      },
      "items": [
        {
          "text": "mpe bakobenga lisusu te moto oyo akabaka moyimi ;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.5",
            "verseOrgIds": [
              "ISA.32.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 32:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "pamba te zoba alobaka kaka na bozoba,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.6",
            "verseOrgIds": [
              "ISA.32.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 32:6"
      },
      "items": [
        {
          "text": "motema na ye ekanisaka kaka makambo mabe :",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.6",
            "verseOrgIds": [
              "ISA.32.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 32:6"
      },
      "items": [
        {
          "text": "atiolaka nzela ya bule,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.6",
            "verseOrgIds": [
              "ISA.32.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 32:6"
      },
      "items": [
        {
          "text": "alobaka maloba ya nkele mpo na kotelemela Yawe,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.6",
            "verseOrgIds": [
              "ISA.32.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 32:6"
      },
      "items": [
        {
          "text": "atikaka libumu ya moto oyo azali na nzala pamba",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.6",
            "verseOrgIds": [
              "ISA.32.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 32:6"
      },
      "items": [
        {
          "text": "mpe apesaka te mayi na moto oyo azali na yango posa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.6",
            "verseOrgIds": [
              "ISA.32.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 32:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Misala ya moyimi ezalaka mabe,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.7",
            "verseOrgIds": [
              "ISA.32.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 32:7"
      },
      "items": [
        {
          "text": "abongisaka kaka miango ya mabe",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.7",
            "verseOrgIds": [
              "ISA.32.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 32:7"
      },
      "items": [
        {
          "text": "mpo na kopengwisa mobola na maloba ya lokuta",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.7",
            "verseOrgIds": [
              "ISA.32.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 32:7"
      },
      "items": [
        {
          "text": "na tango oyo mobola azali na mbeba te.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.7",
            "verseOrgIds": [
              "ISA.32.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 32:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasi moto ya lokumu asalaka mabongisi ya lokumu",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.8",
            "verseOrgIds": [
              "ISA.32.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 32:8"
      },
      "items": [
        {
          "text": "mpe alendaka mpo na misala na ye ya lokumu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.8",
            "verseOrgIds": [
              "ISA.32.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Basi ya Yelusalemi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 32:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bino basi oyo bovandaka na kimia,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.9",
            "verseOrgIds": [
              "ISA.32.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 32:9"
      },
      "items": [
        {
          "text": "botelema mpe boyoka ngai ;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.9",
            "verseOrgIds": [
              "ISA.32.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 32:9"
      },
      "items": [
        {
          "text": "bino bilenge basi oyo bomitungisaka na eloko moko te,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.9",
            "verseOrgIds": [
              "ISA.32.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 32:9"
      },
      "items": [
        {
          "text": "boyoka makambo oyo nalingi koloba :",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.9",
            "verseOrgIds": [
              "ISA.32.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 32:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Etikali kaka mikolo moke kati na mobu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.10",
            "verseOrgIds": [
              "ISA.32.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 32:10"
      },
      "items": [
        {
          "text": "bino basi oyo bozali na kimia, bokoningana ;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.10",
            "verseOrgIds": [
              "ISA.32.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 32:10"
      },
      "items": [
        {
          "text": "pamba te tango ya kosangisa milona ya vino esili koleka,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.10",
            "verseOrgIds": [
              "ISA.32.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 32:10"
      },
      "items": [
        {
          "text": "mpe tango ya kobuka bambuma ekozala lisusu te.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.10",
            "verseOrgIds": [
              "ISA.32.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 32:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bolenga, bino basi oyo bovandaka na kimia ;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.11",
            "verseOrgIds": [
              "ISA.32.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 32:11"
      },
      "items": [
        {
          "text": "boningana, bino bilenge basi oyo bomitungisaka na eloko moko te !",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.11",
            "verseOrgIds": [
              "ISA.32.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 32:11"
      },
      "items": [
        {
          "text": "Bolongola bilamba na bino mpe botikala bolumbu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.11",
            "verseOrgIds": [
              "ISA.32.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 32:11"
      },
      "items": [
        {
          "text": "bolata basaki na loketo na bino !",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.11",
            "verseOrgIds": [
              "ISA.32.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 32:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bolela na kobeta tolo mpo na bilanga ya kitoko,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.12",
            "verseOrgIds": [
              "ISA.32.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 32:12"
      },
      "items": [
        {
          "text": "mpo na bilanga ya vino oyo ebotaka malamu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.12",
            "verseOrgIds": [
              "ISA.32.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 32:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
