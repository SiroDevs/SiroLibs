        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nakoboma bana ya Jezabeli ; bongo Mangomba nyonso ekondima ete Ngai nazali penza Ye oyo akundolaka mozindo ya mitema mpe ya milimo ya bato. Nakofuta moko na moko na bino kolanda etamboli na ye.",
              "type": "text"
            }
          ]
        }
