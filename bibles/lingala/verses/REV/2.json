        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Boye, nakobwaka ye na mbeto ya pasi makasi elongo na bato oyo basalaka kindumba elongo na ye. Kasi soki babongoli mitema mpe batiki kotambola kolanda mateya ya Jezabeli, nakobwaka bango te na mbeto ya pasi makasi.",
              "type": "text"
            }
