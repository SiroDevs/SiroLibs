  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "9",
        "style": "c",
        "sid": "PRO 9"
      },
      "items": [
        {
          "text": "9",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Feti ya Bwanya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanya atongi ndako na ye,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.1",
            "verseOrgIds": [
              "PRO.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 9:1"
      },
      "items": [
        {
          "text": "atelemisi yango na makonzi sambo ;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.1",
            "verseOrgIds": [
              "PRO.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "abomi banyama na ye, akamoli masanga na ye ya vino",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.2",
            "verseOrgIds": [
              "PRO.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 9:2"
      },
      "items": [
        {
          "text": "mpe, na sima, atandi mesa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.2",
            "verseOrgIds": [
              "PRO.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atindi basali na ye ya basi mpo ete babelela",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.3",
            "verseOrgIds": [
              "PRO.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 9:3"
      },
      "items": [
        {
          "text": "wuta na basonge ya bangomba ya engumba :",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.3",
            "verseOrgIds": [
              "PRO.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "« Tika ete moto nyonso oyo azangi mayele aya awa ! »",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.4",
            "verseOrgIds": [
              "PRO.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 9:4"
      },
      "items": [
        {
          "text": "Atindi maloba epai ya bato oyo bazangi bososoli :",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.4",
            "verseOrgIds": [
              "PRO.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "« Boya kolia bilei na ngai",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.5",
            "verseOrgIds": [
              "PRO.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 9:5"
      },
      "items": [
        {
          "text": "mpe komela vino oyo nakamoli,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.5",
            "verseOrgIds": [
              "PRO.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "botika nzela na bino ya bozoba mpe bokozala na bomoi,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.6",
            "verseOrgIds": [
              "PRO.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 9:6"
      },
      "items": [
        {
          "text": "botambola na nzela ya mayele. »",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.6",
            "verseOrgIds": [
              "PRO.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moto nyonso oyo apamelaka motioli",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.7",
            "verseOrgIds": [
              "PRO.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 9:7"
      },
      "items": [
        {
          "text": "amilukelaka kosambwa,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.7",
            "verseOrgIds": [
              "PRO.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PRO 9:7"
      },
      "items": [
        {
          "text": "moto nyonso oyo apamelaka moto mabe",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.7",
            "verseOrgIds": [
              "PRO.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 9:7"
      },
      "items": [
        {
          "text": "amilukelaka ngambo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.7",
            "verseOrgIds": [
              "PRO.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kopamela motioli te, noki te akoyina yo ;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.8",
            "verseOrgIds": [
              "PRO.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 9:8"
      },
      "items": [
        {
          "text": "kasi pamela moto ya bwanya, mpe akolinga yo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.8",
            "verseOrgIds": [
              "PRO.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Teya moto ya bwanya, mpe akokoma lisusu",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.9",
            "verseOrgIds": [
              "PRO.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 9:9"
      },
      "items": [
        {
          "text": "na bwanya koleka ;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.9",
            "verseOrgIds": [
              "PRO.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 9:9"
      },
      "items": [
        {
          "text": "teya moto ya sembo, mpe akobakisa lisusu boyebi na ye.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.9",
            "verseOrgIds": [
              "PRO.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotosa Yawe ezali mosisa ya bwanya ;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.10",
            "verseOrgIds": [
              "PRO.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 9:10"
      },
      "items": [
        {
          "text": "koyeba Mosantu, yango nde kozala mayele.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.10",
            "verseOrgIds": [
              "PRO.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamba te, na nzela na ngai,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.11",
            "verseOrgIds": [
              "PRO.9.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 9:11"
      },
      "items": [
        {
          "text": "mikolo ya bomoi na yo ekokoma ebele,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.11",
            "verseOrgIds": [
              "PRO.9.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 9:11"
      },
      "items": [
        {
          "text": "mpe mibu ya bomoi na yo ekobakisama.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.11",
            "verseOrgIds": [
              "PRO.9.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Soki ozali moto ya bwanya, bwanya na yo ezali",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.12",
            "verseOrgIds": [
              "PRO.9.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 9:12"
      },
      "items": [
        {
          "text": "mpo na litomba na yo moko ;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.12",
            "verseOrgIds": [
              "PRO.9.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 9:12"
      },
      "items": [
        {
          "text": "kasi soki ozali motioli, yo moko kaka nde okomona pasi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.12",
            "verseOrgIds": [
              "PRO.9.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Feti ya liboma",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwasi ya zoba azali mwasi ya makelele,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.13",
            "verseOrgIds": [
              "PRO.9.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 9:13"
      },
      "items": [
        {
          "text": "ayokaka te mpe azanga mayele,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.13",
            "verseOrgIds": [
              "PRO.9.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "avandaka na ekuke ya ndako na ye,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.14",
            "verseOrgIds": [
              "PRO.9.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 9:14"
      },
      "items": [
        {
          "text": "atiaka kiti na ye na bisika ya likolo ya engumba,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.14",
            "verseOrgIds": [
              "PRO.9.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "mpo na kobenga baleki nzela,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.15",
            "verseOrgIds": [
              "PRO.9.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 9:15"
      },
      "items": [
        {
          "text": "bato oyo bazali kokende na nzela na bango.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.15",
            "verseOrgIds": [
              "PRO.9.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tika ete moto oyo azangi mayele aya awa !",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.16",
            "verseOrgIds": [
              "PRO.9.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 9:16"
      },
      "items": [
        {
          "text": "Atindi maloba epai ya bato oyo bazanga bososoli :",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.16",
            "verseOrgIds": [
              "PRO.9.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PRO 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "« Mayi oyo bayibi ezalaka elengi,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.17",
            "verseOrgIds": [
              "PRO.9.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 9:17"
      },
      "items": [
        {
          "text": "mpe lipa oyo baliaka na kobombama ezalaka kitoko. »",
