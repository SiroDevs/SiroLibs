  "verseCount": 34,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "24",
        "style": "c",
        "sid": "PRO 24"
      },
      "items": [
        {
          "text": "24",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 24:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kolulaka te bato oyo basalaka mabe",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.1",
            "verseOrgIds": [
              "PRO.24.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 24:1"
      },
      "items": [
        {
          "text": "mpe kolukaka te kozala elongo na bango,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.1",
            "verseOrgIds": [
              "PRO.24.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "pamba te mitema na bango ekanisaka kaka kosala mabe,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.2",
            "verseOrgIds": [
              "PRO.24.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 24:2"
      },
      "items": [
        {
          "text": "mpe bibebu na bango eyeisaka kaka mobulu soki elobi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.2",
            "verseOrgIds": [
              "PRO.24.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndako etongamaka na nzela ya bwanya,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.3",
            "verseOrgIds": [
              "PRO.24.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 24:3"
      },
      "items": [
        {
          "text": "mpe elendisamaka na nzela ya mayele.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.3",
            "verseOrgIds": [
              "PRO.24.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bashambre ekotondisama na biloko nyonso",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.4",
            "verseOrgIds": [
              "PRO.24.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 24:4"
      },
      "items": [
        {
          "text": "ya talo mpe ya kitoko na nzela ya boyebi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.4",
            "verseOrgIds": [
              "PRO.24.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moto ya bwanya atondi na nguya,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.5",
            "verseOrgIds": [
              "PRO.24.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 24:5"
      },
      "items": [
        {
          "text": "moto oyo azalaka na boyebi alendisaka nguya na ye.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.5",
            "verseOrgIds": [
              "PRO.24.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 24:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamba te kolonga na etumba esengaka bwanya,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.6",
            "verseOrgIds": [
              "PRO.24.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 24:6"
      },
      "items": [
        {
          "text": "mpe lobiko ezalaka kati na motango ebele ya bapesi toli.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.6",
            "verseOrgIds": [
              "PRO.24.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanya ezalaka likolo mingi mpo na zoba,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.7",
            "verseOrgIds": [
              "PRO.24.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 24:7"
      },
      "items": [
        {
          "text": "yango wana azalaka te na likambo ya koloba",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.7",
            "verseOrgIds": [
              "PRO.24.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 24:7"
      },
      "items": [
        {
          "text": "kati na mayangani oyo esalemaka pembeni ya ekuke.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.7",
            "verseOrgIds": [
              "PRO.24.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 24:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moto oyo asalaka mabongisi ya kosala mabe",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.8",
            "verseOrgIds": [
              "PRO.24.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 24:8"
      },
      "items": [
        {
          "text": "akokende sango lokola moteki baninga.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.8",
            "verseOrgIds": [
              "PRO.24.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mabongisi ya bozoba ezali masumu,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.9",
            "verseOrgIds": [
              "PRO.24.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 24:9"
      },
      "items": [
        {
          "text": "mpe bato bayinaka motioli.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.9",
            "verseOrgIds": [
              "PRO.24.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 24:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Soki omilembisi na mokolo ya pasi,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.10",
            "verseOrgIds": [
              "PRO.24.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 24:10"
      },
      "items": [
        {
          "text": "makasi na yo ekozala pamba.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.10",
            "verseOrgIds": [
              "PRO.24.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 24:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kangola bato oyo bazali komema bango na kufa,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.11",
            "verseOrgIds": [
              "PRO.24.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 24:11"
      },
      "items": [
        {
          "text": "mpe bikisa bato oyo bazali kokende na kufa",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.11",
            "verseOrgIds": [
              "PRO.24.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 24:11"
      },
      "items": [
        {
          "text": "lokola bato oyo balangwe masanga.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.11",
            "verseOrgIds": [
              "PRO.24.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 24:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Soki olobi : « Tala, toyebaki likambo moko te",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.12",
            "verseOrgIds": [
              "PRO.24.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 24:12"
      },
      "items": [
        {
          "text": "kati na makambo oyo nyonso ; »",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.12",
            "verseOrgIds": [
              "PRO.24.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PRO 24:12"
      },
      "items": [
        {
          "text": "boni, Ye oyo amekaka mitema asosolaka yango te ?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.12",
            "verseOrgIds": [
              "PRO.24.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 24:12"
      },
      "items": [
        {
          "text": "Ye oyo abatelaka molimo na yo ayebaka yango te ?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.12",
            "verseOrgIds": [
              "PRO.24.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 24:12"
      },
      "items": [
        {
          "text": "Afutaka te moto na moto kolanda misala na ye ?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.12",
            "verseOrgIds": [
              "PRO.24.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 24:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana na ngai, lia mafuta ya nzoyi,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.13",
            "verseOrgIds": [
              "PRO.24.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 24:13"
      },
      "items": [
        {
          "text": "pamba te ezalaka kitoko !",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.13",
            "verseOrgIds": [
              "PRO.24.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PRO 24:13"
      },
      "items": [
        {
          "text": "Mwa ndambo ya mafuta ya nzoyi ekozala",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.13",
            "verseOrgIds": [
              "PRO.24.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 24:13"
      },
      "items": [
        {
          "text": "elengi na lolemo na yo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.13",
            "verseOrgIds": [
              "PRO.24.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 24:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeba lisusu ete bwanya ezali elengi",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.14",
            "verseOrgIds": [
              "PRO.24.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 24:14"
      },
      "items": [
        {
          "text": "mpo na molimo na yo ;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.14",
            "verseOrgIds": [
              "PRO.24.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PRO 24:14"
      },
      "items": [
        {
          "text": "soki ozwi yango, yeba ete lobi na yo ekozala malamu,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.14",
            "verseOrgIds": [
              "PRO.24.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 24:14"
      },
      "items": [
        {
          "text": "mpe elikya na yo ekozala ya pamba te.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.14",
            "verseOrgIds": [
              "PRO.24.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 24:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yo moto mabe, komeka te kotia mitambo",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.15",
            "verseOrgIds": [
              "PRO.24.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 24:15"
      },
      "items": [
        {
          "text": "kati na ndako ya moto ya sembo,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.15",
            "verseOrgIds": [
              "PRO.24.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 24:15"
      },
      "items": [
        {
          "text": "mpe komeka te kopanza yango,",
