      },
      "items": [
        {
          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Maloba ya Bwanya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boni, Bwanya azali kobelela te ?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.1",
            "verseOrgIds": [
              "PRO.8.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 8:1"
      },
      "items": [
        {
          "text": "Mayele azali koyokisa mongongo na ye te ?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.1",
            "verseOrgIds": [
              "PRO.8.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atelemi na songe ya bangomba, na pembeni ya nzela,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.2",
            "verseOrgIds": [
              "PRO.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 8:2"
      },
      "items": [
        {
          "text": "na bisika oyo banzela ekutana,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.2",
            "verseOrgIds": [
              "PRO.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "azali koganga pene ya bikuke,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.3",
            "verseOrgIds": [
              "PRO.8.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 8:3"
      },
      "items": [
        {
          "text": "na ekotelo ya engumba :",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.3",
            "verseOrgIds": [
              "PRO.8.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "« Bato, nazali koganga makasi epai na bino,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.4",
            "verseOrgIds": [
              "PRO.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 8:4"
      },
      "items": [
        {
          "text": "nazali nde koloba na bino bato !",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.4",
            "verseOrgIds": [
              "PRO.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bino bato oyo bozanga mayele, bokoma na bososoli !",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.5",
            "verseOrgIds": [
              "PRO.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 8:5"
      },
      "items": [
        {
          "text": "Bino bazoba, bokoma mayele !",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.5",
            "verseOrgIds": [
              "PRO.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boyoka, pamba te nazali na makambo ya motuya",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.6",
            "verseOrgIds": [
              "PRO.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 8:6"
      },
      "items": [
        {
          "text": "ya koyebisa bino,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.6",
            "verseOrgIds": [
              "PRO.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PRO 8:6"
      },
      "items": [
        {
          "text": "nafungoli monoko na ngai",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.6",
            "verseOrgIds": [
              "PRO.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 8:6"
      },
      "items": [
        {
          "text": "mpo na koloba makambo ya sembo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.6",
            "verseOrgIds": [
              "PRO.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamba te monoko na ngai ebimisaka maloba ya solo,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.7",
            "verseOrgIds": [
              "PRO.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 8:7"
      },
      "items": [
        {
          "text": "mpe bibebu na ngai eyinaka mabe.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.7",
            "verseOrgIds": [
              "PRO.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maloba nyonso oyo ebimaka na monoko na ngai",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.8",
            "verseOrgIds": [
              "PRO.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 8:8"
      },
      "items": [
        {
          "text": "ezali sembo,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.8",
            "verseOrgIds": [
              "PRO.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 8:8"
      },
      "items": [
        {
          "text": "ezalaka na likambo moko te ya lokuta to ya mabe ;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.8",
            "verseOrgIds": [
              "PRO.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "nyonso ezali pole mpo na moto ya mayele,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.9",
            "verseOrgIds": [
              "PRO.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 8:9"
      },
      "items": [
        {
          "text": "mpe sembo mpo na bato oyo bazali na bososoli.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.9",
            "verseOrgIds": [
              "PRO.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boluka mateya na ngai kasi palata te,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.10",
            "verseOrgIds": [
              "PRO.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 8:10"
      },
      "items": [
        {
          "text": "boyebi kasi wolo te oyo eleki peto,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.10",
            "verseOrgIds": [
              "PRO.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "pamba te bwanya ezali na motuya",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.11",
            "verseOrgIds": [
              "PRO.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 8:11"
      },
      "items": [
        {
          "text": "koleka mayaka ya kitoko,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.11",
            "verseOrgIds": [
              "PRO.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 8:11"
      },
      "items": [
        {
          "text": "bongo eloko moko te ya motuya ekokani na yango.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.11",
            "verseOrgIds": [
              "PRO.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngai, Bwanya, navandaka elongo na kokanisa,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.12",
            "verseOrgIds": [
              "PRO.8.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 8:12"
      },
      "items": [
        {
          "text": "boye nayebi kokundola mayele mpe bososoli.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.12",
            "verseOrgIds": [
              "PRO.8.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotosa Yawe ezali koyina mabe.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.13",
            "verseOrgIds": [
              "PRO.8.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 8:13"
      },
      "items": [
        {
          "text": "Nayinaka lolendo, lofundu, nzela ya masumu",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.13",
            "verseOrgIds": [
              "PRO.8.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 8:13"
      },
      "items": [
        {
          "text": "mpe monoko ya lokuta.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.13",
            "verseOrgIds": [
              "PRO.8.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Toli mpe bososoli ezali ya ngai,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.14",
            "verseOrgIds": [
              "PRO.8.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 8:14"
      },
      "items": [
        {
          "text": "ngai nde mayele mpe makasi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.14",
            "verseOrgIds": [
              "PRO.8.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezali na nzela na ngai nde bakonzi batambolisaka mokili,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.15",
            "verseOrgIds": [
              "PRO.8.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 8:15"
      },
      "items": [
        {
          "text": "mpe bakambi basalaka mibeko ya sembo ;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.15",
            "verseOrgIds": [
              "PRO.8.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "ezali na nzela na ngai nde bakambi, bankumu",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.16",
            "verseOrgIds": [
              "PRO.8.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 8:16"
      },
      "items": [
        {
          "text": "mpe basambisi nyonso ya mokili bayangelaka.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.16",
            "verseOrgIds": [
              "PRO.8.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PRO 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nalingaka bato oyo balingaka ngai,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.17",
            "verseOrgIds": [
              "PRO.8.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 8:17"
      },
      "items": [
        {
          "text": "mpe bato oyo balukaka ngai bamonaka ngai.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.17",
            "verseOrgIds": [
              "PRO.8.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PRO 8:18"
          },
          "items": [
