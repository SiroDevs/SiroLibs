    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Sala keba na ekobo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana na ngai, zala na bokebi na bwanya na ngai,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.1",
            "verseOrgIds": [
              "PRO.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 5:1"
      },
      "items": [
        {
          "text": "mpe pesa litoyi na yo na mayele na ngai,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.1",
            "verseOrgIds": [
              "PRO.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "mpo ete ozala na bososoli,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.2",
            "verseOrgIds": [
              "PRO.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 5:2"
      },
      "items": [
        {
          "text": "mpe bibebu na yo ebomba boyebi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.2",
            "verseOrgIds": [
              "PRO.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamba te bibebu ya mwasi ya ndumba ebimisaka",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.3",
            "verseOrgIds": [
              "PRO.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 5:3"
      },
      "items": [
        {
          "text": "mafuta ya nzoyi,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.3",
            "verseOrgIds": [
              "PRO.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 5:3"
      },
      "items": [
        {
          "text": "mpe lolemo na ye ezali elengi lokola mafuta ;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.3",
            "verseOrgIds": [
              "PRO.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "kasi na suka na nyonso,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.4",
            "verseOrgIds": [
              "PRO.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 5:4"
      },
      "items": [
        {
          "text": "azali bololo lokola masanga ya bololo,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.4",
            "verseOrgIds": [
              "PRO.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 5:4"
      },
      "items": [
        {
          "text": "songe lokola mopanga ya minu mibale.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.4",
            "verseOrgIds": [
              "PRO.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makolo na ye ekokita kino na kufa,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.5",
            "verseOrgIds": [
              "PRO.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 5:5"
      },
      "items": [
        {
          "text": "ekokende kino na mokili ya bakufi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.5",
            "verseOrgIds": [
              "PRO.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amitungisaka te mpo na nzela ya bomoi,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.6",
            "verseOrgIds": [
              "PRO.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 5:6"
      },
      "items": [
        {
          "text": "alandaka nzela oyo ayebi te esika nini ekosuka.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.6",
            "verseOrgIds": [
              "PRO.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sik'oyo mwana na ngai, yoka ngai,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.7",
            "verseOrgIds": [
              "PRO.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 5:7"
      },
      "items": [
        {
          "text": "kopesa maloba na ngai mokongo te ;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.7",
            "verseOrgIds": [
              "PRO.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "longola nzela na yo pembeni na ye",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.8",
            "verseOrgIds": [
              "PRO.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 5:8"
      },
      "items": [
        {
          "text": "mpe kopusana te liboso ya ndako na ye,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.8",
            "verseOrgIds": [
              "PRO.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "noki te akoya kokaba lokumu na yo",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.9",
            "verseOrgIds": [
              "PRO.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 5:9"
      },
      "items": [
        {
          "text": "epai ya bato mosusu,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.9",
            "verseOrgIds": [
              "PRO.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 5:9"
      },
      "items": [
        {
          "text": "mpe mibu na yo epai ya moto mabe ;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.9",
            "verseOrgIds": [
              "PRO.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "noki te bapaya bakotonda na biloko oyo yo omoneli pasi,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.10",
            "verseOrgIds": [
              "PRO.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 5:10"
      },
      "items": [
        {
          "text": "mpe mbuma ya mosala na yo ekokende",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.10",
            "verseOrgIds": [
              "PRO.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 5:10"
      },
      "items": [
        {
          "text": "na ndako ya mopaya ;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.10",
            "verseOrgIds": [
              "PRO.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "noki te okokoma kolelalela na suka",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.11",
            "verseOrgIds": [
              "PRO.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 5:11"
      },
      "items": [
        {
          "text": "tango nzoto na yo ekolemba mpe makasi na yo ekosila,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.11",
            "verseOrgIds": [
              "PRO.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "mpe oloba : « Mpo na nini nayinaki mateya,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.12",
            "verseOrgIds": [
              "PRO.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 5:12"
      },
      "items": [
        {
          "text": "mpe motema na ngai eboyaki koyoka toli ?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.12",
            "verseOrgIds": [
              "PRO.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpo na nini nayokaki te mongongo ya balakisi na ngai",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.13",
            "verseOrgIds": [
              "PRO.5.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 5:13"
      },
      "items": [
        {
          "text": "mpe napesaki litoyi te epai ya bato",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.13",
            "verseOrgIds": [
              "PRO.5.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 5:13"
      },
      "items": [
        {
          "text": "oyo bazalaki koteya ngai ?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.13",
            "verseOrgIds": [
              "PRO.5.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Etikalaki kaka moke ete nakweya na mabe ya mozindo,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.14",
            "verseOrgIds": [
              "PRO.5.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 5:14"
      },
      "items": [
        {
          "text": "kati na Lingomba ya bato ya Nzambe. »",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.14",
            "verseOrgIds": [
              "PRO.5.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mwasi ya bolenge na yo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Melaka mayi ya libulu na yo moko,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.15",
            "verseOrgIds": [
              "PRO.5.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 5:15"
      },
      "items": [
        {
          "text": "oyo ezali kobima penza na libulu na yo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.15",
            "verseOrgIds": [
              "PRO.5.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boni, bitima na yo esopa penza mayi na libanda",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.16",
            "verseOrgIds": [
              "PRO.5.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 5:16"
      },
      "items": [
        {
          "text": "to miluka na yo esopa penza mayi na balabala ?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.16",
            "verseOrgIds": [
              "PRO.5.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PRO 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tika ete ezala kaka mpo na yo moko,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.17",
            "verseOrgIds": [
              "PRO.5.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 5:17"
      },
      "items": [
        {
          "text": "kasi kokabola yango te na bapaya.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.17",
            "verseOrgIds": [
              "PRO.5.17"
            ]
          }
        }
      ]
