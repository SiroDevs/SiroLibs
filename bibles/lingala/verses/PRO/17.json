          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moto oyo asalaka mabe ayokaka maloba ya bato mabe,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.4",
            "verseOrgIds": [
              "PRO.17.4"
            ]
          }
        }
      ]
    },
    {
