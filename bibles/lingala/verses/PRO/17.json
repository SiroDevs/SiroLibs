      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 17:7"
      },
      "items": [
        {
          "text": "ndenge mpe maloba ya lokuta ebongi te mpo na mokonzi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.7",
            "verseOrgIds": [
              "PRO.17.7"
            ]
          }
        }
      ]
