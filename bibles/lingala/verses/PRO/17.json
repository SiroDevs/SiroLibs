          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakitani bazali motole ya bakoko,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.6",
            "verseOrgIds": [
              "PRO.17.6"
            ]
