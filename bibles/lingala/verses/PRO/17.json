      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PRO 17:5"
      },
      "items": [
        {
          "text": "moto oyo asepelaka na pasi ya moninga",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.5",
            "verseOrgIds": [
              "PRO.17.5"
            ]
          }
        }
      ]
    },
