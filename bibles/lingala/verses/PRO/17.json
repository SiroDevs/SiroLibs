          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pasi etikaka ata moke te ndako ya moto",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.13",
            "verseOrgIds": [
              "PRO.17.13"
            ]
          }
        }
      ]
    },
