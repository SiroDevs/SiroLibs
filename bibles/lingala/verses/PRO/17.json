      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mosali ya bwanya akozala na bokonzi",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.2",
            "verseOrgIds": [
              "PRO.17.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 17:2"
      },
      "items": [
        {
          "text": "likolo ya mwana mobali oyo asalaka soni,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.2",
            "verseOrgIds": [
              "PRO.17.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 17:2"
      },
      "items": [
        {
          "text": "mpe akozwa libula elongo na bandeko.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.2",
            "verseOrgIds": [
              "PRO.17.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
