      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 17:12"
      },
      "items": [
        {
          "text": "koleka kokutana na zoba oyo azali kati na bolema.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.12",
            "verseOrgIds": [
              "PRO.17.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
