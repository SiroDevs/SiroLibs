          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moto oyo abombaka mabe alukaka bolingo,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.9",
            "verseOrgIds": [
              "PRO.17.9"
