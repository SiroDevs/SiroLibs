      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 17:10"
      },
      "items": [
        {
          "text": "kasi kobeta zoba bafimbu nkama moko ezalaka",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.10",
            "verseOrgIds": [
              "PRO.17.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 17:10"
      },
      "items": [
        {
          "text": "na litomba te.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.10",
            "verseOrgIds": [
              "PRO.17.10"
            ]
          }
        }
      ]
