      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 17:4"
      },
      "items": [
        {
          "text": "mokosi apesaka litoyi na ye na maloba ya lokuta.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.4",
            "verseOrgIds": [
              "PRO.17.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
