      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 17:13"
      },
      "items": [
        {
          "text": "oyo azongisaka mabe mpo na malamu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.13",
            "verseOrgIds": [
              "PRO.17.13"
            ]
          }
        }
      ]
    },
