      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 17:8"
      },
      "items": [
        {
          "text": "oyo azali na yango ;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.8",
            "verseOrgIds": [
              "PRO.17.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 17:8"
      },
      "items": [
        {
          "text": "alongaka na esika nyonso oyo akendaka.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.8",
            "verseOrgIds": [
              "PRO.17.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
