      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 17:6"
      },
      "items": [
        {
          "text": "mpe baboti bazali lokumu ya bana.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.6",
            "verseOrgIds": [
              "PRO.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
