      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 17:5"
      },
      "items": [
        {
          "text": "akozanga te kozwa etumbu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.5",
            "verseOrgIds": [
              "PRO.17.5"
            ]
          }
        }
      ]
    },
