          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kolia na kimia ndambo ya lipa ya kokawuka ezali malamu",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.1",
            "verseOrgIds": [
              "PRO.17.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 17:1"
      },
      "items": [
        {
          "text": "koleka kovanda na ndako etonda na misuni elongo na koswana.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.1",
            "verseOrgIds": [
              "PRO.17.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
