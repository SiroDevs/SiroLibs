{
  "id": "GAL.1",
  "number": "1",
  "bookId": "GAL",
  "reference": "Bagalatia 1",
  "copyright": "Biblica® Salela na bonsomi Mokanda na Bomoi™ Makomi na se ya bokonzi © 2002, 2020 Biblica, Inc. Biblica® Open Lingala Contemporary Bible™ Copyright © 2002, 2020 by Biblica, Inc.",
  "verseCount": 24,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "GAL 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ebandeli ya mokanda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GAL 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngai Polo, ntoma oyo abengamaki na bato te to na nzela ya moto te, kasi na Yesu-Klisto mpe na Nzambe Tata oyo asekwisaki Ye kati na bakufi,",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.1",
            "verseOrgIds": [
              "GAL.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GAL 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "mpe bandeko nyonso oyo bazali elongo na ngai ;",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.2",
            "verseOrgIds": [
              "GAL.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "GAL 1:2"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "mi",
        "vid": "GAL 1:2"
      },
      "items": [
        {
          "text": "Epai ya Mangomba ya Galatia :",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.2",
            "verseOrgIds": [
              "GAL.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GAL 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tika ete ngolu mpe kimia epesamela bino kowuta na Nzambe, Tata na biso, mpe na Nkolo Yesu-Klisto !",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.3",
            "verseOrgIds": [
              "GAL.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GAL 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu amipesaki mpo na masumu na biso mpo ete, kolanda mokano ya Nzambe, Tata na biso, akangola biso longwa na ekeke oyo ya mabe.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.4",
            "verseOrgIds": [
              "GAL.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GAL 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tika ete nkembo ezonga epai na Ye libela na libela ! Amen !",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.5",
            "verseOrgIds": [
              "GAL.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Sango Malamu moko kaka",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GAL 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nazali kokamwa ete bozali kosundola noki Ye oyo abengaki bino na nzela ya ngolu ya Klisto mpe bozali kolanda sango malamu mosusu",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.6",
            "verseOrgIds": [
              "GAL.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GAL 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "oyo ezalaka kutu te. Solo, ezali na bato oyo bazali kotia mobulu kati na bino mpe bazali koluka kobongola Sango Malamu ya Klisto.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.7",
            "verseOrgIds": [
              "GAL.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GAL 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasi soki moto moko, ezala biso to Anjelu moko kowuta na Likolo, ateyi bino sango malamu oyo ekeseni na Sango Malamu oyo biso toteyaki bino, wana tika ete Nzambe alakela ye mabe !",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.8",
            "verseOrgIds": [
              "GAL.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GAL 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndenge tolobaki yango liboso, mpe nazali lisusu koloba yango sik'oyo : soki moto moko ateyi bino sango malamu oyo ekeseni na Sango Malamu oyo boyambaki, wana tika ete Nzambe alakela ye mabe !",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.9",
            "verseOrgIds": [
              "GAL.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GAL 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bozali sik'oyo kokanisa nini na likambo oyo : nazali koluka kosepelisa bato to nazali koluka kosepelisa Nzambe ? Boni, nazali koluka kosepelisa bato ? Soki nazalaki nanu koluka kosepelisa bato, nalingaki kozala mosali ya Klisto te.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.10",
            "verseOrgIds": [
              "GAL.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Sango Malamu kowuta na Klisto",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GAL 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bandeko na ngai, nalingi boyeba malamu ete Sango Malamu oyo nateyaki bino ezalaki mbuma ya makanisi ya bomoto te.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.11",
            "verseOrgIds": [
              "GAL.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GAL 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nazwaki yango na moto moko te, nayekolaki yango mpe te ; kasi ezali Yesu-Klisto nde alakisaki ngai yango na nzela ya emoniseli.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.12",
            "verseOrgIds": [
              "GAL.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GAL 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solo, boyokaki sango ya bizaleli na ngai ya kala tango nazalaki nanu mondimi kati na lingomba ya Bayuda ; boyebi mpe ndenge nini nazalaki konyokola Lingomba ya Nzambe mpo na kopanza yango.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.13",
            "verseOrgIds": [
              "GAL.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GAL 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kati na lingomba ya Bayuda, nazalaki komata koleka Bayuda ebele ya ekeke na ngai, oyo tozalaki na bango mibu moko ya mbotama ; nalekaki bango kutu na bolingo eleka ndelo mpo na bokoko ya batata na ngai.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.14",
            "verseOrgIds": [
              "GAL.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GAL 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasi tango Nzambe oyo aponaki ngai wuta na libumu ya mama na ngai mpe abengaki ngai na nzela ya ngolu na Ye, asepelaki",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.15",
            "verseOrgIds": [
              "GAL.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GAL 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "kotalisa ngai Mwana na Ye na nzela ya emoniseli mpo ete nakoka kosakola Ye kati na Bapagano, natunaki na mbala moko toli epai ya moto ata moko te.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.16",
            "verseOrgIds": [
              "GAL.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GAL 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakendeki kutu na Yelusalemi te mpo na kokutana na bato oyo bakomaki bantoma liboso na ngai, kasi nakendeki nde na Arabi. Sima na yango, nazongaki na Damasi.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.17",
            "verseOrgIds": [
              "GAL.1.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GAL 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezali sima na mibu misato nde nakendeki na Yelusalemi mpo na koyeba Petelo, mpe navandaki epai na ye mikolo zomi na mitano.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.18",
            "verseOrgIds": [
              "GAL.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GAL 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Natikalaki komona ntoma mosusu te, longola kaka Jake, ndeko ya Nkolo.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.19",
            "verseOrgIds": [
              "GAL.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GAL 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzambe azali Motatoli na ngai ete makambo oyo nazali kokomela bino ezali ya lokuta te.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.20",
            "verseOrgIds": [
              "GAL.1.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GAL 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sima na yango, nakendeki na bituka ya Siri mpe ya Silisi.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.21",
            "verseOrgIds": [
              "GAL.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GAL 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasi Baklisto ya Mangomba ya Yuda bayebaki ngai te,",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.22",
            "verseOrgIds": [
              "GAL.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GAL 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "bayokaki kaka sango : « Moto oyo azalaki konyokola biso na kala akomi sik'oyo koteya kondima oyo azalaki koluka kobebisa. »",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.23",
            "verseOrgIds": [
              "GAL.1.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GAL 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpe bazalaki kokumisa Nzambe na tina na ngai.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.24",
            "verseOrgIds": [
              "GAL.1.24"
            ]
          }
        }
      ]
    }
  ],
