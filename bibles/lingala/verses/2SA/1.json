      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "2SA 1:21"
      },
      "items": [
        {
          "text": "ata na likolo ya bilanga oyo ebotaka bambuma",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.21",
            "verseOrgIds": [
              "2SA.1.21"
            ]
