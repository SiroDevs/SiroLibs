      "attrs": {
        "style": "q2",
        "vid": "2SA 1:20"
      },
      "items": [
        {
          "text": "bakopumbwa na esengo.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.20",
            "verseOrgIds": [
