{
  "id": "2SA.1",
  "number": "1",
  "bookId": "2SA",
  "reference": "2 Samuele 1",
  "copyright": "Biblica® Salela na bonsomi Mokanda na Bomoi™ Makomi na se ya bokonzi © 2002, 2020 Biblica, Inc. Biblica® Open Lingala Contemporary Bible™ Copyright © 2002, 2020 by Biblica, Inc.",
  "verseCount": 27,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "2SA 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "ms1"
      },
      "items": [
        {
          "text": "Bokonzi ya Davidi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Davidi azwi sango ya kufa ya Saulo mpe ya Jonatan",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2SA 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wana Saulo asilaki kokufa, Davidi azongaki na Tsikilagi sima na ye kolonga bato ya Amaleki. Mpe avandaki kuna mikolo mibale.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.1",
            "verseOrgIds": [
              "2SA.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mokolo ya misato, moto moko awutaki na molako ya Saulo mpe ayaki na bilamba epasuka, moto etonda na putulu. Tango akomaki epai ya Davidi, amibwakaki na mabele mpo na kogumbama liboso ya Davidi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.2",
            "verseOrgIds": [
              "2SA.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davidi atunaki ye :",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.3",
            "verseOrgIds": [
              "2SA.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "2SA 1:3"
      },
      "items": [
        {
          "text": "— Owuti wapi ?",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 1:3"
      },
      "items": [
        {
          "text": "Azongisaki :",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.3",
            "verseOrgIds": [
              "2SA.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "2SA 1:3"
      },
      "items": [
        {
          "text": "— Nakimi wuta na molako ya Isalaele.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davidi atunaki lisusu :",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.4",
            "verseOrgIds": [
              "2SA.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "2SA 1:4"
      },
      "items": [
        {
          "text": "— Yebisa ngai makambo nini eleki kuna ?",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 1:4"
      },
      "items": [
        {
          "text": "Moto yango alobaki :",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.4",
            "verseOrgIds": [
              "2SA.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "2SA 1:4"
      },
      "items": [
        {
          "text": "— Mampinga ya Isalaele ekimi bitumba ; ebele kati na bango bakweyi na bitumba mpe bakufi, ata Saulo mpe mwana na ye ya mobali, Jonatan, bakufi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bongo Davidi alobaki na elenge mobali oyo azalaki kopesa ye sango :",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.5",
            "verseOrgIds": [
              "2SA.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "2SA 1:5"
      },
      "items": [
        {
          "text": "— Oyebi ndenge nini ete Saulo mpe mwana na ye ya mobali, Jonatan, bakufi ?",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elenge mobali azongisaki :",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.6",
            "verseOrgIds": [
              "2SA.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "2SA 1:6"
      },
      "items": [
        {
          "text": "— Nazalaki na ngai koleka na likolo ya ngomba Giliboa, mpe namonaki Saulo alaleli likonga na ye. Namonaki lisusu bashar mpe basoda oyo babundaka likolo ya bampunda kokoma pene ya kokanga ye.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tango kaka abalukaki mpe amonaki ngai, abengaki ngai ; mpe ngai nazongisaki : « Ngai oyo. »",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atunaki ngai :",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "2SA 1:8"
      },
      "items": [
        {
          "text": "— Ozali nani ?",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 1:8"
      },
      "items": [
        {
          "text": "Nazongiselaki ye :",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.8",
            "verseOrgIds": [
              "2SA.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "2SA 1:8"
      },
      "items": [
        {
          "text": "— Nazali moto ya Amaleki.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alobaki na ngai :",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.9",
            "verseOrgIds": [
              "2SA.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "2SA 1:9"
      },
      "items": [
        {
          "text": "— Pusana pene na ngai mpe boma ngai, pamba te nazali koyoka lisusu nzoto malamu te, atako nazali nanu na bomoi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boye napusanaki pene na ye mpe nabomaki ye, pamba te nayebaki ete akobika te na kotala ndenge babetaki ye. Sima, nazwaki ekoti na ye ya bokonzi, oyo azalaki na yango na moto mpe singa oyo alataki na loboko na ye, mpe namemi yango epai na yo, nkolo na ngai.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.10",
            "verseOrgIds": [
              "2SA.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bongo Davidi mpe basoda nyonso oyo bazalaki elongo na ye basimbaki bilamba na bango mpe bapasolaki yango.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.11",
            "verseOrgIds": [
              "2SA.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basalaki matanga, balelaki mpe bakilaki bilei kino na pokwa, mpo na Saulo mpe Jonatan, mwana na ye ya mobali ; mpo na mampinga ya Yawe mpe mpo na libota ya Isalaele, mpo ete bakufaki na nzela ya mopanga.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.12",
            "verseOrgIds": [
              "2SA.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davidi atunaki elenge mobali oyo amemelaki ye sango :",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.13",
            "verseOrgIds": [
              "2SA.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "2SA 1:13"
      },
      "items": [
        {
          "text": "— Ozali moto ya mboka nini ?",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 1:13"
      },
      "items": [
        {
          "text": "Azongisaki :",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.13",
            "verseOrgIds": [
              "2SA.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "2SA 1:13"
      },
      "items": [
        {
          "text": "— Nazali mwana mobali ya mopaya moko, moto ya Amaleki.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davidi atunaki ye :",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.14",
            "verseOrgIds": [
              "2SA.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "2SA 1:14"
      },
      "items": [
        {
          "text": "— Mpo na nini obangaki te kosembola loboko na yo mpo na koboma mopakolami na Yawe ?",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bongo Davidi abengaki moko kati na basoda na ye mpe alobaki : « Yaka, boma ye ! » Mpe soda yango abomaki ye.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.15",
            "verseOrgIds": [
              "2SA.1.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davidi alobaki na moto oyo amemelaki ye sango : « Tika ete makila na yo etangama na moto na yo moko, pamba te maloba na yo moko nde efundi yo mpo ete olobi : ‹ Nabomaki mopakolami na Yawe. › »",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.16",
            "verseOrgIds": [
              "2SA.1.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nzembo ya mawa mpo na Saulo mpe Jonatan",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davidi asalaki nzembo oyo ya mawa mpo na Saulo mpe Jonatan, mwana na ye ya mobali.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.17",
            "verseOrgIds": [
              "2SA.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apesaki mitindo ete balakisa yango epai ya bato ya Yuda. Nzembo yango ya mawa ekomama kati na buku ya Moto ya Sembo.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.18",
            "verseOrgIds": [
              "2SA.1.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oh Isalaele, lokumu na yo ekweyi",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.19",
            "verseOrgIds": [
              "2SA.1.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2SA 1:19"
      },
      "items": [
        {
          "text": "na likolo ya bangomba na yo.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.19",
            "verseOrgIds": [
              "2SA.1.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2SA 1:19"
      },
      "items": [
        {
          "text": "Ndenge nini bilombe bakweyi !",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.19",
            "verseOrgIds": [
              "2SA.1.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bopanza sango yango te kati na Gati,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.20",
            "verseOrgIds": [
              "2SA.1.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2SA 1:20"
      },
      "items": [
        {
          "text": "bopanza yango te na babalabala ya Ashikeloni,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.20",
            "verseOrgIds": [
              "2SA.1.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "2SA 1:20"
      },
      "items": [
        {
          "text": "noki te bana basi ya bato ya Filisitia bakosepela,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.20",
            "verseOrgIds": [
              "2SA.1.20"
            ]
