    }
  },
  "2TH.3": {
    "id": "2TH.3",
    "number": "3",
    "bookId": "2TH",
    "reference": "2 Batesalonika 3",
    "copyright": "Biblica® Salela na bonsomi Mokanda na Bomoi™ Makomi na se ya bokonzi © 2002, 2020 Biblica, Inc. Biblica® Open Lingala Contemporary Bible™ Copyright © 2002, 2020 by Biblica, Inc.",
    "verseCount": 18,
    "content": [
      {
        "name": "chapter",
        "type": "tag",
        "attrs": {
          "number": "3",
          "style": "c",
          "sid": "2TH 3"
        },
        "items": [
          {
            "text": "3",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "s1"
        },
        "items": [
          {
            "text": "Lilendisi mpo na kobondela",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "1",
              "style": "v",
              "sid": "2TH 3:1"
            },
            "items": [
              {
                "text": "1",
                "type": "text"
              }
            ]
          },
          {
            "text": "Bandeko, bobondelaka mpo na biso na tina na makambo mosusu, mpo ete Liloba na Nkolo epanzana noki mpe epesamela lokumu ndenge ezalaki kozwa lokumu epai na bino.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.3.1",
              "verseOrgIds": [
                "2TH.3.1"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "2",
              "style": "v",
              "sid": "2TH 3:2"
            },
            "items": [
              {
                "text": "2",
                "type": "text"
              }
            ]
          },
          {
            "text": "Bobondelaka mpe mpo ete Nzambe akangola biso wuta na maboko ya bato mabe mpe ya batomboki, pamba te bato nyonso bazali na kondima te.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.3.2",
              "verseOrgIds": [
                "2TH.3.2"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "3",
              "style": "v",
              "sid": "2TH 3:3"
            },
            "items": [
              {
                "text": "3",
                "type": "text"
              }
            ]
          },
          {
            "text": "Kasi Nkolo azali sembo, akopesa bino makasi mpe akobatela bino liboso ya Satana.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.3.3",
              "verseOrgIds": [
                "2TH.3.3"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "4",
              "style": "v",
              "sid": "2TH 3:4"
            },
            "items": [
              {
                "text": "4",
                "type": "text"
              }
            ]
          },
          {
            "text": "Tondimisami kati na Nkolo ete bozali kosala mpe bokokoba kosala makambo nyonso oyo tozali kotinda bino.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.3.4",
              "verseOrgIds": [
                "2TH.3.4"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "5",
              "style": "v",
              "sid": "2TH 3:5"
            },
            "items": [
              {
                "text": "5",
                "type": "text"
              }
            ]
          },
          {
            "text": "Tika ete Nkolo akamba mitema na bino kino na bolingo ya Nzambe mpe na molende ya Klisto !",
            "type": "text",
            "attrs": {
              "verseId": "2TH.3.5",
              "verseOrgIds": [
                "2TH.3.5"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "s1"
        },
        "items": [
          {
            "text": "Tina ya kosala mosala",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "6",
              "style": "v",
              "sid": "2TH 3:6"
            },
            "items": [
              {
                "text": "6",
                "type": "text"
              }
            ]
          },
          {
            "text": "Bandeko, totindi bino na Kombo ya Nkolo Yesu-Klisto ete bokima ndeko nyonso oyo atambolaka na bomoi ya mobulu mpe alingaka te kotambola kolanda malakisi oyo bozwaki kowuta na biso.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.3.6",
              "verseOrgIds": [
                "2TH.3.6"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "7",
              "style": "v",
              "sid": "2TH 3:7"
            },
            "items": [
              {
                "text": "7",
                "type": "text"
              }
            ]
          },
          {
            "text": "Pamba te boyebi bino moko ndenge nini bosengeli kolanda ndakisa na biso. Tango tozalaki elongo na bino, tozalaki bagoyigoyi te",
            "type": "text",
            "attrs": {
              "verseId": "2TH.3.7",
              "verseOrgIds": [
                "2TH.3.7"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "8",
              "style": "v",
              "sid": "2TH 3:8"
            },
            "items": [
              {
                "text": "8",
                "type": "text"
              }
            ]
          },
          {
            "text": "mpe toliaki epai ya moto moko te bilei ya ofele ; kasi tozalaki, butu mpe moyi, kosala mosala ya makasi mpe ya pasi, mpo ete topesa mokumba na biso epai ya moto moko te kati na bino.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.3.8",
              "verseOrgIds": [
                "2TH.3.8"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "9",
              "style": "v",
              "sid": "2TH 3:9"
            },
            "items": [
              {
                "text": "9",
                "type": "text"
              }
            ]
          },
          {
            "text": "Nzokande elingi koloba te ete tozangaki makoki mpo na lisungi ya ndenge wana, kasi tosalaki bongo mpo ete tokoma ndakisa mpo na bino.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.3.9",
              "verseOrgIds": [
                "2TH.3.9"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "10",
              "style": "v",
              "sid": "2TH 3:10"
            },
            "items": [
              {
                "text": "10",
                "type": "text"
              }
            ]
          },
          {
            "text": "Pamba te, ezala tango tozalaki elongo na bino, topesaki bino mobeko oyo : « Tika ete moto oyo aboyi kosala mosala alia mpe te ! »",
            "type": "text",
            "attrs": {
              "verseId": "2TH.3.10",
              "verseOrgIds": [
                "2TH.3.10"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "11",
              "style": "v",
              "sid": "2TH 3:11"
            },
            "items": [
              {
                "text": "11",
                "type": "text"
              }
            ]
          },
          {
            "text": "Tozali koyoka ete mingi kati na bino bazali bagoyigoyi mpe bazali kotambola na bomoi ya mobulu, bazali kosala eloko moko te, kasi bazali kaka kokota na makambo ya bato mosusu.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.3.11",
              "verseOrgIds": [
                "2TH.3.11"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "12",
              "style": "v",
              "sid": "2TH 3:12"
            },
            "items": [
              {
                "text": "12",
                "type": "text"
              }
            ]
          },
          {
            "text": "Tozali kokomela bato ya lolenge wana malako mpe kosenga na bango, na Kombo ya Nkolo Yesu-Klisto, ete basala mosala na kimia mpe balia bilei oyo bakozwa na motoki na bango moko.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.3.12",
              "verseOrgIds": [
                "2TH.3.12"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "13",
              "style": "v",
              "sid": "2TH 3:13"
            },
            "items": [
              {
                "text": "13",
                "type": "text"
              }
            ]
          },
          {
            "text": "Kasi mpo na bino bandeko, bolemba te kosala bolamu.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.3.13",
              "verseOrgIds": [
                "2TH.3.13"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "14",
              "style": "v",
              "sid": "2TH 3:14"
            },
            "items": [
              {
                "text": "14",
                "type": "text"
              }
            ]
          },
          {
            "text": "Soki moto aboyi kotosa mitindo oyo topesi bino kati na mokanda oyo, bokebisa bato nyonso na tina na ye mpe bosangana na ye lisusu te mpo ete ayoka soni.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.3.14",
              "verseOrgIds": [
                "2TH.3.14"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "15",
              "style": "v",
              "sid": "2TH 3:15"
            },
            "items": [
              {
                "text": "15",
                "type": "text"
              }
            ]
          },
          {
            "text": "Bozwa ye lokola monguna te, kasi bopamela ye lokola ndeko.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.3.15",
              "verseOrgIds": [
                "2TH.3.15"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "b"
        },
        "items": []
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "s1"
        },
        "items": [
          {
            "text": "Bambote",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "16",
              "style": "v",
              "sid": "2TH 3:16"
            },
            "items": [
              {
                "text": "16",
                "type": "text"
              }
            ]
          },
          {
            "text": "Tika ete Ye moko Nkolo na kimia apesaka bino kimia tango nyonso mpe na lolenge nyonso ! Tika ete Nkolo azala elongo na bino nyonso !",
            "type": "text",
            "attrs": {
              "verseId": "2TH.3.16",
              "verseOrgIds": [
                "2TH.3.16"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "b"
        },
        "items": []
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "17",
              "style": "v",
              "sid": "2TH 3:17"
            },
            "items": [
              {
                "text": "17",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ngai Polo, nakomi mbote oyo na nzela ya loboko na ngai moko ; yango nde ezali elembo kati na mikanda na ngai nyonso. Nakomaka nde bongo.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.3.17",
              "verseOrgIds": [
                "2TH.3.17"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "b"
        },
        "items": []
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "18",
              "style": "v",
              "sid": "2TH 3:18"
            },
            "items": [
              {
                "text": "18",
                "type": "text"
              }
            ]
          },
          {
            "text": "Tika ete ngolu ya Yesu-Klisto, Nkolo na biso, ezala na bino nyonso !",
            "type": "text",
            "attrs": {
              "verseId": "2TH.3.18",
              "verseOrgIds": [
                "2TH.3.18"
              ]
            }
          }
        ]
      }
    ],
