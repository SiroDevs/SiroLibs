          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamba te Yawe asepelaka na bato na Ye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.149.4",
            "verseOrgIds": [
              "PSA.149.4"
            ]
          }
        }
