      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 149:4"
      },
      "items": [
        {
          "text": "alatisaka babola motole ya elonga.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.149.4",
            "verseOrgIds": [
              "PSA.149.4"
            ]
          }
        }
      ]
    },
