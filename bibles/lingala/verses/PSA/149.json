            "sid": "PSA 149:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tika ete Isalaele asepela na Mokeli na Ye !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.149.2",
            "verseOrgIds": [
              "PSA.149.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 149:2"
      },
      "items": [
        {
          "text": "Tika ete bato ya Siona bazala na esengo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.149.2",
            "verseOrgIds": [
              "PSA.149.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 149:2"
      },
      "items": [
        {
          "text": "mpo na Mokonzi na bango !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.149.2",
            "verseOrgIds": [
              "PSA.149.2"
            ]
          }
        }
      ]
    },
    {
