      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 149:1"
      },
      "items": [
        {
          "text": "Boyembela Yawe nzembo ya sika,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.149.1",
            "verseOrgIds": [
              "PSA.149.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 149:1"
      },
      "items": [
        {
          "text": "bokumisa Ye na banzembo kati na mayangani ya bayengebene !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.149.1",
            "verseOrgIds": [
              "PSA.149.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
