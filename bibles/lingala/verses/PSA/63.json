      "attrs": {
        "style": "q2",
        "vid": "PSA 63:12"
      },
      "items": [
        {
          "text": "moto nyonso oyo alapaka ndayi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.12",
            "verseOrgIds": [
              "PSA.63.12"
            ]
          }
        }
      ]
    },
