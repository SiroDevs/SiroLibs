            "sid": "PSA 63:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakotonda lokola moto oyo asili kolia",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.6",
            "verseOrgIds": [
              "PSA.63.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 63:6"
      },
      "items": [
        {
          "text": "misuni kitoko mpe mafuta ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.6",
            "verseOrgIds": [
              "PSA.63.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 63:6"
      },
      "items": [
        {
          "text": "bibebu na ngai ekoganga na esengo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.6",
            "verseOrgIds": [
              "PSA.63.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 63:6"
      },
      "items": [
        {
          "text": "mpe monoko na ngai ekokumisa Yo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.6",
            "verseOrgIds": [
              "PSA.63.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
