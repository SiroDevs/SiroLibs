        {
          "text": "Nzembo 63",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Boboto ya Nzambe eleki bomoi na motuya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 63:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzembo ya Davidi. Ayembaki yango tango azalaki kati na esobe ya Yuda.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 63:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oh Nzambe, ozali Nzambe na ngai ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.2",
            "verseOrgIds": [
              "PSA.63.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 63:2"
      },
      "items": [
        {
          "text": "nazali koluka Yo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.2",
            "verseOrgIds": [
              "PSA.63.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 63:2"
      },
      "items": [
        {
          "text": "molimo na ngai ezali na posa na Yo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.2",
            "verseOrgIds": [
              "PSA.63.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 63:2"
      },
      "items": [
        {
          "text": "bomoi na ngai ezali na posa na Yo makasi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.2",
            "verseOrgIds": [
              "PSA.63.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 63:2"
      },
      "items": [
        {
          "text": "kati na mabele ekawuka mpe ezanga mayi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.2",
            "verseOrgIds": [
              "PSA.63.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 63:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Natalaki Yo kati na Esika ya bule",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.3",
            "verseOrgIds": [
              "PSA.63.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 63:3"
      },
      "items": [
        {
          "text": "mpo na komona makasi mpe nkembo na Yo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.3",
            "verseOrgIds": [
              "PSA.63.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 63:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamba te bolingo na Yo ezali malamu koleka bomoi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.4",
            "verseOrgIds": [
              "PSA.63.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 63:4"
      },
      "items": [
        {
          "text": "bibebu na ngai ekosanzola Yo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.4",
            "verseOrgIds": [
              "PSA.63.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 63:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boye, nakopambola Yo bomoi na ngai mobimba,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.5",
            "verseOrgIds": [
              "PSA.63.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 63:5"
      },
      "items": [
        {
          "text": "nakotombola maboko na ngai",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.5",
            "verseOrgIds": [
              "PSA.63.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 63:5"
      },
      "items": [
        {
          "text": "mpo na lokumu ya Kombo na Yo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.5",
            "verseOrgIds": [
              "PSA.63.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
