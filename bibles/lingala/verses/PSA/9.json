      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 9:6"
      },
      "items": [
        {
          "text": "olimwisaki kombo na bango mpo na libela.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.6",
            "verseOrgIds": [
              "PSA.9.6"
            ]
          }
        }
      ]
    },
    {
