        {
          "text": "Nzembo 9",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Nzambe akataka makambo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wuta na buku ya mokambi ya bayembi. Nzembo ya Davidi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakosanzola Yawe na motema na ngai mobimba,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.2",
            "verseOrgIds": [
              "PSA.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 9:2"
      },
      "items": [
        {
          "text": "nakotatola misala minene na Yo nyonso.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.2",
            "verseOrgIds": [
              "PSA.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakozala na esengo mpe nakosepela kati na Yo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.3",
            "verseOrgIds": [
              "PSA.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 9:3"
      },
      "items": [
        {
          "text": "nakoyemba mpo na lokumu ya Kombo na Yo-Oyo-Oleki-Likolo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.3",
            "verseOrgIds": [
              "PSA.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Banguna na ngai bazongaka sima,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.4",
            "verseOrgIds": [
              "PSA.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 9:4"
      },
      "items": [
        {
          "text": "bakweyaka mpe balimwaka liboso na Yo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.4",
            "verseOrgIds": [
              "PSA.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamba te, okataki likambo na ngai",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.5",
            "verseOrgIds": [
              "PSA.9.5"
            ]
