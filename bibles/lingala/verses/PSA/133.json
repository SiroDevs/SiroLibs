    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Tango bandeko basangani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 133:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzembo ya Davidi. Nzembo ya mobembo mpo na kokende na Tempelo ya Yawe.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 133:1"
      },
      "items": [
        {
          "text": "Tala ndenge ezali malamu mpe ndenge ezali kitoko",
          "type": "text",
          "attrs": {
            "verseId": "PSA.133.1",
            "verseOrgIds": [
              "PSA.133.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 133:1"
      },
      "items": [
        {
          "text": "mpo na bandeko kozala lisanga kati na bomoko !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.133.1",
            "verseOrgIds": [
              "PSA.133.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 133:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezali lokola malasi ya motuya",
          "type": "text",
          "attrs": {
            "verseId": "PSA.133.2",
            "verseOrgIds": [
              "PSA.133.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 133:2"
      },
      "items": [
        {
          "text": "oyo basopi na moto,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.133.2",
            "verseOrgIds": [
              "PSA.133.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 133:2"
      },
      "items": [
        {
          "text": "bongo ezali kokita na mandefu, na mandefu ya Aron,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.133.2",
            "verseOrgIds": [
              "PSA.133.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 133:2"
      },
      "items": [
        {
          "text": "ezali kokita kino na songe ya bilamba na ye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.133.2",
            "verseOrgIds": [
              "PSA.133.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 133:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezali lokola mamwe ya Erimoni,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.133.3",
            "verseOrgIds": [
              "PSA.133.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 133:3"
      },
      "items": [
        {
          "text": "oyo ekitaka na bangomba ya Siona.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.133.3",
            "verseOrgIds": [
              "PSA.133.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 133:3"
      },
      "items": [
        {
          "text": "Pamba te kuna, Yawe apesaka lipamboli na Ye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.133.3",
            "verseOrgIds": [
              "PSA.133.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 133:3"
      },
      "items": [
        {
          "text": "mpe bomoi, mpo na libela.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.133.3",
            "verseOrgIds": [
              "PSA.133.3"
            ]
          }
        }
      ]
    }
