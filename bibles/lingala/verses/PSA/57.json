      "attrs": {
        "style": "q2",
        "vid": "PSA 57:5"
      },
      "items": [
        {
          "text": "mpe lolemo na bango ezali mopanga ya minu makasi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.5",
            "verseOrgIds": [
              "PSA.57.5"
            ]
