      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 57:4"
      },
      "items": [
        {
          "text": "mpe boyengebene na Ye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.4",
            "verseOrgIds": [
              "PSA.57.4"
            ]
          }
        }
      ]
    },
