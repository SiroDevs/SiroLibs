      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 57:6"
      },
      "items": [
        {
          "text": "tika ete nkembo na Yo ezala",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.6",
            "verseOrgIds": [
              "PSA.57.6"
