  "verseCount": 24,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "55",
        "style": "c",
        "sid": "PSA 55"
      },
      "items": [
        {
          "text": "55",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Nzembo 55",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Libondeli ya moto oyo bateki",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 55:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wuta na buku ya mokambi ya bayembi. Eyembamaki na lindanda. Nzembo ya Davidi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 55:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oh Nzambe, yoka libondeli na ngai,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.2",
            "verseOrgIds": [
              "PSA.55.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 55:2"
      },
      "items": [
        {
          "text": "komibomba te wana nazali kobelela Yo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.2",
            "verseOrgIds": [
              "PSA.55.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 55:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoka ngai mpe yanola ngai.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.3",
            "verseOrgIds": [
              "PSA.55.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 55:3"
      },
      "items": [
        {
          "text": "Kati na kolela na ngai, nakomi koyengayenga",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.3",
            "verseOrgIds": [
              "PSA.55.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 55:3"
      },
      "items": [
        {
          "text": "mpe nazangi kimia,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.3",
            "verseOrgIds": [
              "PSA.55.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 55:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "mpo na maloba ya monguna na ngai",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.4",
            "verseOrgIds": [
              "PSA.55.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 55:4"
      },
      "items": [
        {
          "text": "mpe kanda ya moto mabe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.4",
            "verseOrgIds": [
              "PSA.55.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 55:4"
      },
      "items": [
        {
          "text": "pamba te bazali kokweyisela ngai misala mabe",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.4",
            "verseOrgIds": [
              "PSA.55.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 55:4"
      },
      "items": [
        {
          "text": "mpe konyokola ngai na kanda.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.4",
            "verseOrgIds": [
              "PSA.55.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 55:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Motema na ngai etondi na mawa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.5",
            "verseOrgIds": [
              "PSA.55.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 55:5"
      },
      "items": [
        {
          "text": "mpe somo ya kufa ekangi ngai.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.5",
            "verseOrgIds": [
              "PSA.55.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 55:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakomi kobanga mpe kolenga,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.6",
            "verseOrgIds": [
              "PSA.55.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 55:6"
      },
      "items": [
        {
          "text": "somo monene ekangi ngai.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.6",
            "verseOrgIds": [
              "PSA.55.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 55:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakomi komilobela :",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.7",
            "verseOrgIds": [
              "PSA.55.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 55:7"
      },
      "items": [
        {
          "text": "« Soki nazalaki ata na mapapu ya ebenga,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.7",
            "verseOrgIds": [
              "PSA.55.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 55:7"
      },
      "items": [
        {
          "text": "nalingaki kopumbwa mpo na koluka bopemi ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.7",
            "verseOrgIds": [
              "PSA.55.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 55:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "nalingaki kokima mosika penza,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.8",
            "verseOrgIds": [
              "PSA.55.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 55:8"
      },
      "items": [
        {
          "text": "mpo na kokende kovanda ata na esobe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.8",
            "verseOrgIds": [
              "PSA.55.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 55:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solo, na lombangu penza,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.9",
            "verseOrgIds": [
              "PSA.55.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 55:9"
      },
      "items": [
        {
          "text": "nalingaki kokende koluka ebombamelo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.9",
            "verseOrgIds": [
              "PSA.55.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 55:9"
      },
      "items": [
        {
          "text": "mpo na kokima mopepe makasi mpe ekumbaki. »",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.9",
            "verseOrgIds": [
              "PSA.55.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 55:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkolo, bebisa mabongisi ya banguna na ngai",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.10",
            "verseOrgIds": [
              "PSA.55.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 55:10"
      },
      "items": [
        {
          "text": "mpe kotisa mobulu kati na bango ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.10",
            "verseOrgIds": [
              "PSA.55.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 55:10"
      },
      "items": [
        {
          "text": "pamba te, kati na engumba,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.10",
            "verseOrgIds": [
              "PSA.55.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 55:10"
      },
      "items": [
        {
          "text": "nazali komona mobulu mpe bokabwani.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.10",
            "verseOrgIds": [
              "PSA.55.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 55:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Butu mpe moyi, ezali kotambola",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.11",
            "verseOrgIds": [
              "PSA.55.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 55:11"
      },
      "items": [
        {
          "text": "na bamir na yango ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.11",
            "verseOrgIds": [
              "PSA.55.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 55:11"
      },
      "items": [
        {
          "text": "misala mabe mpe ya kanza etondi kati na yango.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.11",
            "verseOrgIds": [
              "PSA.55.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 55:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Banguya oyo ebebisaka ezali kosala kati na yango,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.12",
            "verseOrgIds": [
              "PSA.55.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 55:12"
      },
      "items": [
        {
          "text": "minyoko mpe lokuta ezali kosila te.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.12",
            "verseOrgIds": [
              "PSA.55.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 55:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Soki monguna nde azalaki kofinga ngai,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.13",
            "verseOrgIds": [
              "PSA.55.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 55:13"
      },
      "items": [
        {
          "text": "nalingaki kokanga motema ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.13",
            "verseOrgIds": [
              "PSA.55.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 55:13"
      },
      "items": [
        {
          "text": "soki ezalaki mpe moyini nde azalaki kotelemela ngai,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.13",
            "verseOrgIds": [
              "PSA.55.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 55:13"
      },
      "items": [
        {
          "text": "nalingaki komibomba mpo ete amona ngai te.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.13",
            "verseOrgIds": [
              "PSA.55.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 55:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasi ezali yo, moto lokola ngai,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.14",
            "verseOrgIds": [
              "PSA.55.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 55:14"
      },
      "items": [
        {
          "text": "oyo otambolaka elongo na ngai,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.14",
            "verseOrgIds": [
              "PSA.55.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 55:14"
      },
      "items": [
        {
          "text": "molingami mpe moninga na ngai ya motema",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.14",
            "verseOrgIds": [
              "PSA.55.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 55:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "oyo nazalaki kokabola elongo na yo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.15",
            "verseOrgIds": [
              "PSA.55.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
