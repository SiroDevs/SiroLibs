    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Nzembo 12",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Nzambe akokisaka bilaka na Ye",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wuta na buku ya mokambi ya bayembi. Nzembo ya Davidi ; ya koyemba na lindanda ya basinga mwambe.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe, sunga biso !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.2",
            "verseOrgIds": [
              "PSA.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 12:2"
      },
      "items": [
        {
          "text": "Pamba te bayengebene bazali lisusu te ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.2",
            "verseOrgIds": [
              "PSA.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 12:2"
      },
      "items": [
        {
          "text": "bato ya kotiela motema bazali lisusu te",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.2",
            "verseOrgIds": [
              "PSA.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 12:2"
      },
      "items": [
        {
          "text": "kati na bana na bato.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.2",
            "verseOrgIds": [
              "PSA.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bato nyonso bazali kokosana bango na bango,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.3",
            "verseOrgIds": [
              "PSA.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 12:3"
      },
      "items": [
        {
          "text": "bazali kolobana maloba ya sukali,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.3",
            "verseOrgIds": [
              "PSA.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 12:3"
      },
      "items": [
        {
          "text": "kasi mitema na bango ezali sembo te.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.3",
            "verseOrgIds": [
              "PSA.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tika ete Yawe aboma bato nyonso",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.4",
            "verseOrgIds": [
              "PSA.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 12:4"
      },
      "items": [
        {
          "text": "oyo balobaka maloba ya sukali",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.4",
            "verseOrgIds": [
              "PSA.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 12:4"
      },
      "items": [
        {
          "text": "mpe batondi na lolendo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.4",
            "verseOrgIds": [
              "PSA.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "ba-oyo balobaka :",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.5",
            "verseOrgIds": [
              "PSA.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 12:5"
      },
      "items": [
        {
          "text": "« Tokolonga na nzela ya lolemo na biso,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.5",
            "verseOrgIds": [
              "PSA.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 12:5"
      },
      "items": [
        {
          "text": "bibebu na biso ekolobela biso ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.5",
            "verseOrgIds": [
              "PSA.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 12:5"
      },
      "items": [
        {
          "text": "nani akoluka kozala nkolo na biso ? »",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.5",
            "verseOrgIds": [
              "PSA.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe alobi :",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.6",
            "verseOrgIds": [
              "PSA.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 12:6"
      },
      "items": [
        {
          "text": "« Mpo ete bazali konyokola babola",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.6",
            "verseOrgIds": [
              "PSA.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 12:6"
      },
      "items": [
        {
          "text": "mpe kolelisa bato oyo bakelela,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.6",
            "verseOrgIds": [
              "PSA.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 12:6"
      },
      "items": [
        {
          "text": "natelemi sik'oyo mpo na kobikisa batiolami. »",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.6",
            "verseOrgIds": [
              "PSA.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maloba ya Yawe ezalaka peto",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.7",
            "verseOrgIds": [
              "PSA.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 12:7"
      },
      "items": [
        {
          "text": "lokola palata oyo balekisi na moto",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.7",
            "verseOrgIds": [
              "PSA.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 12:7"
      },
      "items": [
        {
          "text": "mpe bapetoli mbala sambo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.7",
            "verseOrgIds": [
              "PSA.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yo, Yawe, okobatela bato oyo bakelela,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.8",
            "verseOrgIds": [
              "PSA.12.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 12:8"
      },
      "items": [
        {
          "text": "okobikisa biso mpo na libela liboso ya bato mabe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.8",
            "verseOrgIds": [
              "PSA.12.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bato mabe batambolaka na bonsomi bipai na bipai",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.9",
            "verseOrgIds": [
              "PSA.12.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 12:9"
      },
      "items": [
        {
          "text": "soki bato bapesi bozoba lokumu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.9",
            "verseOrgIds": [
              "PSA.12.9"
            ]
          }
        }
      ]
    }
  ],
