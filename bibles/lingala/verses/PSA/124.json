          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzembo ya Davidi. Nzembo ya mobembo mpo na kokende na Tempelo ya Yawe.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 124:1"
      },
      "items": [
        {
          "text": "Soki Yawe abatelaki biso te ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.124.1",
            "verseOrgIds": [
              "PSA.124.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 124:1"
      },
      "items": [
        {
          "text": "tika ete Isalaele aloba bongo !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.124.1",
            "verseOrgIds": [
              "PSA.124.1"
            ]
          }
        }
      ]
    },
