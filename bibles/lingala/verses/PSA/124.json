          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tika ete Yawe apambolama,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.124.6",
            "verseOrgIds": [
              "PSA.124.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 124:6"
      },
      "items": [
        {
          "text": "Ye oyo andimaki te ete minu na bango epasola biso !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.124.6",
            "verseOrgIds": [
              "PSA.124.6"
            ]
          }
        }
