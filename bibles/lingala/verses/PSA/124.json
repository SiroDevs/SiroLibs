      "attrs": {
        "style": "q2",
        "vid": "PSA 124:7"
      },
      "items": [
        {
          "text": "ya mokangi bandeke ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.124.7",
            "verseOrgIds": [
              "PSA.124.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 124:7"
      },
      "items": [
        {
          "text": "motambo ekatanaki, mpe tokimaki.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.124.7",
            "verseOrgIds": [
              "PSA.124.7"
            ]
          }
        }
