          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbele bamelaki biso ya bomoi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.124.3",
            "verseOrgIds": [
              "PSA.124.3"
            ]
          }
        }
      ]
