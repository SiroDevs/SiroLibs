              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Soki Yawe abatelaki biso te",
          "type": "text",
          "attrs": {
            "verseId": "PSA.124.2",
            "verseOrgIds": [
              "PSA.124.2"
            ]
          }
