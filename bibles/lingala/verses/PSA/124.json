      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 124:8"
      },
      "items": [
        {
          "text": "oyo akela likolo mpe mabele.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.124.8",
            "verseOrgIds": [
              "PSA.124.8"
            ]
