          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boye mayi elingaki kozindisa biso,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.124.4",
            "verseOrgIds": [
              "PSA.124.4"
            ]
          }
        }
