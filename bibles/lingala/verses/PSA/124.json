      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 124:2"
      },
      "items": [
        {
          "text": "tango bato babundisaki biso,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.124.2",
            "verseOrgIds": [
              "PSA.124.2"
            ]
          }
        }
