          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lisungi na biso ezali kati na Kombo na Yawe",
          "type": "text",
          "attrs": {
            "verseId": "PSA.124.8",
            "verseOrgIds": [
              "PSA.124.8"
            ]
          }
        }
      ]
    },
    {
