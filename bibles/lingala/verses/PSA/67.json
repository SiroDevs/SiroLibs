          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oh Nzambe, tika ete bikolo ekumisa Yo ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.67.4",
            "verseOrgIds": [
              "PSA.67.4"
            ]
