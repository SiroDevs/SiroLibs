      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 128:5"
      },
      "items": [
        {
          "text": "mpe okomona bofuluki ya Yelusalemi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.128.5",
            "verseOrgIds": [
              "PSA.128.5"
            ]
          }
        }
      ]
    },
    {
