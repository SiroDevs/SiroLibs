    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Tika ete Yawe apambola yo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 128:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzembo ya mobembo mpo na kokende na Tempelo ya Yawe.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 128:1"
      },
      "items": [
        {
          "text": "Esengo na moto oyo atosaka Yawe",
          "type": "text",
          "attrs": {
            "verseId": "PSA.128.1",
            "verseOrgIds": [
              "PSA.128.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 128:1"
      },
      "items": [
        {
          "text": "mpe alandaka banzela na Ye !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.128.1",
            "verseOrgIds": [
              "PSA.128.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 128:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oliaka mbuma ya mosala na Yo ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.128.2",
            "verseOrgIds": [
              "PSA.128.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 128:2"
      },
      "items": [
        {
          "text": "ozali moto ya esengo mpe ozali na bofuluki.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.128.2",
            "verseOrgIds": [
              "PSA.128.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 128:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kati na ndako na yo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.128.3",
            "verseOrgIds": [
              "PSA.128.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 128:3"
      },
      "items": [
        {
          "text": "mwasi na yo azali lokola nzete ya vino",
          "type": "text",
          "attrs": {
            "verseId": "PSA.128.3",
            "verseOrgIds": [
              "PSA.128.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 128:3"
      },
      "items": [
        {
          "text": "oyo ebotaka bambuma ebele ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.128.3",
            "verseOrgIds": [
              "PSA.128.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 128:3"
      },
      "items": [
        {
          "text": "bana na yo bazali lokola bankona ya nzete ya olive",
          "type": "text",
          "attrs": {
            "verseId": "PSA.128.3",
            "verseOrgIds": [
              "PSA.128.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 128:3"
      },
      "items": [
        {
          "text": "zingazinga ya mesa na yo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.128.3",
            "verseOrgIds": [
              "PSA.128.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 128:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezali ndenge wana nde Yawe apambolaka",
          "type": "text",
          "attrs": {
            "verseId": "PSA.128.4",
            "verseOrgIds": [
              "PSA.128.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 128:4"
      },
      "items": [
        {
          "text": "moto oyo atosaka Ye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.128.4",
            "verseOrgIds": [
              "PSA.128.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
