      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 128:5"
      },
      "items": [
        {
          "text": "mikolo nyonso ya bomoi na yo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.128.5",
            "verseOrgIds": [
              "PSA.128.5"
            ]
          }
        }
      ]
    },
