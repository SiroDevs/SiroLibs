      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 17:4"
      },
      "items": [
        {
          "text": "mpo ete natambola te na banzela ya bato ya masumu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.4",
            "verseOrgIds": [
              "PSA.17.4"
            ]
          }
        }
      ]
    },
