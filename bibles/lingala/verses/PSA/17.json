      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 17:3"
      },
      "items": [
        {
          "text": "soki olandeli ngai ata na butu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.3",
            "verseOrgIds": [
              "PSA.17.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 17:3"
      },
      "items": [
        {
          "text": "mpe omeki ngai,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.3",
            "verseOrgIds": [
              "PSA.17.3"
            ]
          }
