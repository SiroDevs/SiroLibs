          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Libondeli ya Davidi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 17:1"
      },
      "items": [
        {
          "text": "Oh Yawe, yoka ngai !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.1",
            "verseOrgIds": [
              "PSA.17.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 17:1"
      },
      "items": [
        {
          "text": "Kolela na ngai ezali sembo !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.1",
            "verseOrgIds": [
              "PSA.17.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 17:1"
      },
      "items": [
        {
          "text": "Yoka koganga na ngai !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.1",
            "verseOrgIds": [
              "PSA.17.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 17:1"
      },
      "items": [
        {
          "text": "Landa malamu libondeli na ngai,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.1",
            "verseOrgIds": [
              "PSA.17.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 17:1"
      },
      "items": [
        {
          "text": "oyo ezali kobimela te na bibebu ya lokuta.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.1",
            "verseOrgIds": [
              "PSA.17.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
