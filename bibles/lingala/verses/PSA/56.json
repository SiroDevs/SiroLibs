  "verseCount": 14,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "56",
        "style": "c",
        "sid": "PSA 56"
      },
      "items": [
        {
          "text": "56",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Nzembo 56",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Elongo na Nzambe, kobanga ezali lisusu te",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 56:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wuta na buku ya mokambi ya bayembi. Eyembamaki ndenge moko na « Ebenga ya terebente ya mosika. » Nzembo ya Davidi, tango bato ya Filisitia bakangaki ye kati na mboka Gati.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 56:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzambe, yokela ngai mawa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.2",
            "verseOrgIds": [
              "PSA.56.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 56:2"
      },
      "items": [
        {
          "text": "pamba te bato bazali kotungisa ngai.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.2",
            "verseOrgIds": [
              "PSA.56.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 56:2"
      },
      "items": [
        {
          "text": "Babundisaka mpe banyokolaka ngai mikolo nyonso.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.2",
            "verseOrgIds": [
              "PSA.56.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 56:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayini na ngai batungisaka ngai mikolo nyonso ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.3",
            "verseOrgIds": [
              "PSA.56.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 56:3"
      },
      "items": [
        {
          "text": "bato oyo babundisaka ngai na lolendo bazali ebele.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.3",
            "verseOrgIds": [
              "PSA.56.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 56:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mokolo oyo nazalaka na bobangi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.4",
            "verseOrgIds": [
              "PSA.56.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 56:4"
      },
      "items": [
        {
          "text": "natiaka elikya na ngai kati na Yo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.4",
            "verseOrgIds": [
              "PSA.56.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 56:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Epai ya Nzambe, nakumisaka Liloba na Ye ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.5",
            "verseOrgIds": [
              "PSA.56.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 56:5"
      },
      "items": [
        {
          "text": "Epai ya Nzambe, natiaka motema mpe nabangaka te.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.5",
            "verseOrgIds": [
              "PSA.56.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 56:5"
      },
      "items": [
        {
          "text": "Moto oyo akokufa akoki kosala ngai nini ?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.5",
            "verseOrgIds": [
              "PSA.56.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 56:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babongolaka maloba na ngai mikolo nyonso ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.6",
            "verseOrgIds": [
              "PSA.56.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 56:6"
      },
      "items": [
        {
          "text": "mabongisi na bango nyonso ezalaka",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.6",
            "verseOrgIds": [
              "PSA.56.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 56:6"
      },
      "items": [
        {
          "text": "mpo na kosala ngai mabe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.6",
            "verseOrgIds": [
              "PSA.56.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 56:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basalaka makita, babombamaka,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.7",
            "verseOrgIds": [
              "PSA.56.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 56:7"
      },
      "items": [
        {
          "text": "balandaka ngai mpo na kosala ngai mabe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.7",
            "verseOrgIds": [
              "PSA.56.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 56:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpo na makambo oyo ya mabe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.8",
            "verseOrgIds": [
              "PSA.56.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 56:8"
      },
      "items": [
        {
          "text": "boni, bazanga etumbu ?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.8",
            "verseOrgIds": [
              "PSA.56.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 56:8"
      },
      "items": [
        {
          "text": "Oh Nzambe, kweyisela bikolo kanda na Yo !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.8",
            "verseOrgIds": [
              "PSA.56.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 56:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solo, oyebi motango ya matambe",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.9",
            "verseOrgIds": [
              "PSA.56.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 56:9"
      },
      "items": [
        {
          "text": "ya bomoi na ngai ya mitelengano.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.9",
            "verseOrgIds": [
              "PSA.56.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 56:9"
      },
      "items": [
        {
          "text": "Sopa mpinzoli na ngai kati na mbeki na Yo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.9",
            "verseOrgIds": [
              "PSA.56.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 56:9"
      },
      "items": [
        {
          "text": "oyo ezali buku na Yo ya ekaniseli.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.9",
            "verseOrgIds": [
              "PSA.56.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 56:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bongo, na mokolo oyo nakobelela",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.10",
            "verseOrgIds": [
              "PSA.56.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 56:10"
      },
      "items": [
        {
          "text": "mpo na kosenga lisungi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.10",
            "verseOrgIds": [
              "PSA.56.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 56:10"
      },
      "items": [
        {
          "text": "banguna na ngai bakozonga sima.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.10",
            "verseOrgIds": [
              "PSA.56.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 56:10"
      },
      "items": [
        {
          "text": "Na nzela ya likambo yango,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.10",
            "verseOrgIds": [
              "PSA.56.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 56:10"
      },
      "items": [
        {
          "text": "nakoyeba ete Nzambe azali mpo na ngai.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.10",
            "verseOrgIds": [
              "PSA.56.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 56:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pembeni ya Nzambe oyo nakumisaka Liloba na Ye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.11",
            "verseOrgIds": [
              "PSA.56.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 56:11"
      },
      "items": [
        {
          "text": "pembeni ya Yawe oyo nakumisaka Liloba na Ye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.11",
            "verseOrgIds": [
              "PSA.56.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 56:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "pembeni ya Nzambe oyo natielaka motema",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.12",
            "verseOrgIds": [
              "PSA.56.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 56:12"
      },
      "items": [
        {
          "text": "mpe nazalaka na bobangi te,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.12",
            "verseOrgIds": [
              "PSA.56.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 56:12"
      },
      "items": [
        {
          "text": "moto akoki kosala ngai nini ?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.12",
            "verseOrgIds": [
              "PSA.56.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 56:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Epai na Yo Nzambe, nakokokisa bandayi na ngai",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.13",
            "verseOrgIds": [
              "PSA.56.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 56:13"
      },
      "items": [
        {
          "text": "mpe nakobonza bambeka ya matondi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.13",
            "verseOrgIds": [
              "PSA.56.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 56:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamba te okangoli ngai na kufa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.14",
            "verseOrgIds": [
              "PSA.56.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 56:14"
      },
      "items": [
        {
          "text": "mpe obateli makolo na ngai ete ebeta mabaku te,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.14",
            "verseOrgIds": [
              "PSA.56.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 56:14"
      },
      "items": [
        {
          "text": "mpo ete natambola liboso na Yo Nzambe",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.14",
            "verseOrgIds": [
              "PSA.56.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 56:14"
      },
      "items": [
        {
          "text": "kati na pole ya bomoi.",
