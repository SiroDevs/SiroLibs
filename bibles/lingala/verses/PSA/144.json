    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Nzembo 144",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Bato na Yo bazali na esengo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 144:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzembo ya Davidi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 144:1"
      },
      "items": [
        {
          "text": "Tika ete Yawe, Libanga na ngai, apambolama ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.1",
            "verseOrgIds": [
              "PSA.144.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 144:1"
      },
      "items": [
        {
          "text": "Ye oyo akembisaka maboko",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.1",
            "verseOrgIds": [
              "PSA.144.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 144:1"
      },
      "items": [
        {
          "text": "mpe makofi na ngai mpo na bitumba !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.1",
            "verseOrgIds": [
              "PSA.144.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 144:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azali bolingo na ngai mpe ndako na ngai ya makasi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.2",
            "verseOrgIds": [
              "PSA.144.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 144:2"
      },
      "items": [
        {
          "text": "ebombamelo mpe mokangoli na ngai,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.2",
            "verseOrgIds": [
              "PSA.144.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 144:2"
      },
      "items": [
        {
          "text": "nguba mpe ekimelo na ngai ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.2",
            "verseOrgIds": [
              "PSA.144.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 144:2"
      },
      "items": [
        {
          "text": "Ye nde atiaka bato na ngai na se ya bokonzi na ngai.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.2",
            "verseOrgIds": [
              "PSA.144.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 144:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oh Yawe, moto nde nani mpo ete obatelaka ye ?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.3",
            "verseOrgIds": [
              "PSA.144.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 144:3"
      },
      "items": [
        {
          "text": "Moto nde nani mpo ete okanisaka ye ?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.3",
            "verseOrgIds": [
              "PSA.144.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 144:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moto azali lokola mopepe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.4",
            "verseOrgIds": [
              "PSA.144.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 144:4"
      },
      "items": [
        {
          "text": "mikolo ya bomoi na ye ezali lokola elili oyo ezali koleka.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.4",
            "verseOrgIds": [
              "PSA.144.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 144:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe, fungola likolo mpe kita awa na mabele !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.5",
            "verseOrgIds": [
              "PSA.144.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 144:5"
      },
      "items": [
        {
          "text": "Yaka kosimba bangomba mpe sala ete ebimisa milinga !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.5",
            "verseOrgIds": [
              "PSA.144.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 144:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tinda mikalikali mpe panza banguna na ngai ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.6",
            "verseOrgIds": [
              "PSA.144.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 144:6"
      },
      "items": [
        {
          "text": "bwakela bango makonga na Yo mpe bungisa bango nzela.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.6",
            "verseOrgIds": [
              "PSA.144.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 144:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tanda loboko na Yo wuta kuna na likolo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.7",
            "verseOrgIds": [
              "PSA.144.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 144:7"
      },
      "items": [
        {
          "text": "mpo na kobikisa mpe kokangola ngai",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.7",
            "verseOrgIds": [
              "PSA.144.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 144:7"
      },
      "items": [
        {
          "text": "na mayi minene, na maboko ya bapaya",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.7",
            "verseOrgIds": [
              "PSA.144.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 144:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "oyo minoko na bango elobaka kaka lokuta",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.8",
            "verseOrgIds": [
              "PSA.144.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 144:8"
      },
      "items": [
        {
          "text": "mpe maboko na bango elapaka ndayi ya lokuta.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.8",
            "verseOrgIds": [
              "PSA.144.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 144:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oh Nzambe, nakoyembela Yo nzembo ya sika,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.9",
            "verseOrgIds": [
              "PSA.144.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 144:9"
      },
      "items": [
        {
          "text": "nakobetela Yo lindanda ya basinga zomi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.9",
            "verseOrgIds": [
              "PSA.144.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 144:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezali Yo, Nzambe, nde opesaka bakonzi elonga,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.10",
            "verseOrgIds": [
              "PSA.144.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 144:10"
      },
      "items": [
        {
          "text": "obikisaka Davidi, mosali na Yo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.10",
            "verseOrgIds": [
              "PSA.144.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 144:10"
      },
      "items": [
        {
          "text": "liboso ya mopanga oyo ebomaka.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.10",
            "verseOrgIds": [
              "PSA.144.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 144:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bikisa mpe kangola ngai na maboko ya bapaya",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.11",
            "verseOrgIds": [
              "PSA.144.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 144:11"
      },
      "items": [
        {
          "text": "oyo minoko na bango elobaka kaka lokuta",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.11",
            "verseOrgIds": [
              "PSA.144.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 144:11"
      },
      "items": [
        {
          "text": "mpe maboko na bango elapaka ndayi ya lokuta.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.11",
            "verseOrgIds": [
              "PSA.144.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 144:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bana mibali na biso bazali lokola milona,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.12",
            "verseOrgIds": [
              "PSA.144.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 144:12"
      },
      "items": [
        {
          "text": "bazali kokola malamu wuta na bomwana na bango ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.12",
            "verseOrgIds": [
              "PSA.144.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 144:12"
      },
      "items": [
        {
          "text": "bana basi na biso bazali lokola bililingi kitoko",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.12",
            "verseOrgIds": [
              "PSA.144.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 144:12"
      },
      "items": [
        {
          "text": "oyo batoboli na bamir ya ndako ya mokonzi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.12",
            "verseOrgIds": [
              "PSA.144.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 144:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bibombelo na biso etondi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.13",
            "verseOrgIds": [
              "PSA.144.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 144:13"
      },
      "items": [
        {
          "text": "na biloko ya ndenge na ndenge ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.13",
            "verseOrgIds": [
              "PSA.144.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 144:13"
      },
      "items": [
        {
          "text": "bameme na biso ezali kobotana na minkoko,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.13",
            "verseOrgIds": [
              "PSA.144.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 144:13"
      },
      "items": [
        {
          "text": "na bankoto zomi kati na bitonga na biso ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.13",
            "verseOrgIds": [
              "PSA.144.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 144:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "bangombe na biso ezali minene ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.14",
            "verseOrgIds": [
              "PSA.144.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 144:14"
      },
      "items": [
        {
          "text": "likama ezali te, zemi ezali kosopana te,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.14",
            "verseOrgIds": [
              "PSA.144.14"
            ]
          }
        }
      ]
    },
