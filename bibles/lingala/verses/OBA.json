{
  "OBA.1": {
    "id": "OBA.1",
    "number": "1",
    "bookId": "OBA",
    "reference": "Abidiasi 1",
    "copyright": "Biblica® Salela na bonsomi Mokanda na Bomoi™ Makomi na se ya bokonzi © 2002, 2020 Biblica, Inc. Biblica® Open Lingala Contemporary Bible™ Copyright © 2002, 2020 by Biblica, Inc.",
    "verseCount": 21,
    "content": [
      {
        "name": "chapter",
        "type": "tag",
        "attrs": {
          "number": "1",
          "style": "c",
          "sid": "OBA 1"
        },
        "items": [
          {
            "text": "1",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "s1"
        },
        "items": [
          {
            "text": "EMONISELI YA MOSAKOLI ABIDIASI",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "s1"
        },
        "items": [
          {
            "text": "Etumbu ya mokili ya Edomi",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "1",
              "style": "v",
              "sid": "OBA 1:1"
            },
            "items": [
              {
                "text": "1",
                "type": "text"
              }
            ]
          },
          {
            "text": "Emoniseli ya mosakoli Abidiasi.",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.1",
              "verseOrgIds": [
                "OBA.1.1"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "b",
          "vid": "OBA 1:1"
        },
        "items": []
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p",
          "vid": "OBA 1:1"
        },
        "items": [
          {
            "text": "Tala liloba oyo Nkolo Yawe alobi na tina na Edomi :",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.1",
              "verseOrgIds": [
                "OBA.1.1"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q1",
          "vid": "OBA 1:1"
        },
        "items": [
          {
            "text": "« Toyoki sango moko kowuta na Yawe ;",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.1",
              "verseOrgIds": [
                "OBA.1.1"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q2",
          "vid": "OBA 1:1"
        },
        "items": [
          {
            "text": "mpe ntoma moko atindami na bikolo mpo na koloba :",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.1",
              "verseOrgIds": [
                "OBA.1.1"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q1",
          "vid": "OBA 1:1"
        },
        "items": [
          {
            "text": "‹ Botelema. Tokende kobundisa Edomi. ›",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.1",
              "verseOrgIds": [
                "OBA.1.1"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "b"
        },
        "items": []
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q1"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "2",
              "style": "v",
              "sid": "OBA 1:2"
            },
            "items": [
              {
                "text": "2",
                "type": "text"
              }
            ]
          },
          {
            "text": "Tala, nakokomisa yo moke kati na bikolo,",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.2",
              "verseOrgIds": [
                "OBA.1.2"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q2",
          "vid": "OBA 1:2"
        },
        "items": [
          {
            "text": "mpe okosambwa makasi.",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.2",
              "verseOrgIds": [
                "OBA.1.2"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q1"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "3",
              "style": "v",
              "sid": "OBA 1:3"
            },
            "items": [
              {
                "text": "3",
                "type": "text"
              }
            ]
          },
          {
            "text": "Lolendo ya motema na yo ekosaki yo,",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.3",
              "verseOrgIds": [
                "OBA.1.3"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q2",
          "vid": "OBA 1:3"
        },
        "items": [
          {
            "text": "yo movandi ya madusu ya mabanga,",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.3",
              "verseOrgIds": [
                "OBA.1.3"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q1",
          "vid": "OBA 1:3"
        },
        "items": [
          {
            "text": "yo oyo otonga ndako na yo na basonge ya bangomba",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.3",
              "verseOrgIds": [
                "OBA.1.3"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q2",
          "vid": "OBA 1:3"
        },
        "items": [
          {
            "text": "mpe omilobelaka : ‹ Nani akokweyisa ngai na se ? ›",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.3",
              "verseOrgIds": [
                "OBA.1.3"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q1"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "4",
              "style": "v",
              "sid": "OBA 1:4"
            },
            "items": [
              {
                "text": "4",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ata soki omati likolo makasi lokola mpongo",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.4",
              "verseOrgIds": [
                "OBA.1.4"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q2",
          "vid": "OBA 1:4"
        },
        "items": [
          {
            "text": "mpe otongi zala na yo kati na minzoto,",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.4",
              "verseOrgIds": [
                "OBA.1.4"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q1",
          "vid": "OBA 1:4"
        },
        "items": [
          {
            "text": "nakokweyisa yo longwa kuna kino na se, »",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.4",
              "verseOrgIds": [
                "OBA.1.4"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q2",
          "vid": "OBA 1:4"
        },
        "items": [
          {
            "text": "elobi Yawe.",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.4",
              "verseOrgIds": [
                "OBA.1.4"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "b"
        },
        "items": []
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q1"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "5",
              "style": "v",
              "sid": "OBA 1:5"
            },
            "items": [
              {
                "text": "5",
                "type": "text"
              }
            ]
          },
          {
            "text": "« Soki miyibi to babebisi babimeli yo na butu,",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.5",
              "verseOrgIds": [
                "OBA.1.5"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q2",
          "vid": "OBA 1:5"
        },
        "items": [
          {
            "text": "likama ya ndenge nini ezali kozela yo ?",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.5",
              "verseOrgIds": [
                "OBA.1.5"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q1",
          "vid": "OBA 1:5"
        },
        "items": [
          {
            "text": "Boni, bakozwa kaka biloko oyo bazali na yango posa te ?",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.5",
              "verseOrgIds": [
                "OBA.1.5"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q2",
          "vid": "OBA 1:5"
        },
        "items": [
          {
            "text": "Soki bato oyo babukaka bambuma ya vino bayei epai na yo,",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.5",
              "verseOrgIds": [
                "OBA.1.5"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q2",
          "vid": "OBA 1:5"
        },
        "items": [
          {
            "text": "boni, bakotika ata ndambo ya maboke ya vino ?",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.5",
              "verseOrgIds": [
                "OBA.1.5"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q1"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "6",
              "style": "v",
              "sid": "OBA 1:6"
            },
            "items": [
              {
                "text": "6",
                "type": "text"
              }
            ]
          },
          {
            "text": "Kasi tala ndenge babimeli Ezawu !",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.6",
              "verseOrgIds": [
                "OBA.1.6"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q2",
          "vid": "OBA 1:6"
        },
        "items": [
          {
            "text": "Babotoli ye biloko na ye ya motuya oyo ebombama !",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.6",
              "verseOrgIds": [
                "OBA.1.6"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q1"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "7",
              "style": "v",
              "sid": "OBA 1:7"
            },
            "items": [
              {
                "text": "7",
                "type": "text"
              }
            ]
          },
          {
            "text": "Bikolo nyonso oyo osalaki elongo na yango boyokani",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.7",
              "verseOrgIds": [
                "OBA.1.7"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q2",
          "vid": "OBA 1:7"
        },
        "items": [
          {
            "text": "ekobengana yo na mokili na yo ;",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.7",
              "verseOrgIds": [
                "OBA.1.7"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q1",
          "vid": "OBA 1:7"
        },
        "items": [
          {
            "text": "baninga na yo bakokosa yo, bakokonza yo.",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.7",
              "verseOrgIds": [
                "OBA.1.7"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q2",
          "vid": "OBA 1:7"
        },
        "items": [
          {
            "text": "Ba-oyo bazalaki kolia lipa na yo bakotiela yo motambo.",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.7",
              "verseOrgIds": [
                "OBA.1.7"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q1",
          "vid": "OBA 1:7"
        },
        "items": [
          {
            "text": "Kasi yo, okoyeba yango te",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.7",
              "verseOrgIds": [
                "OBA.1.7"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q2",
          "vid": "OBA 1:7"
        },
        "items": [
          {
            "text": "mpo ete okozala lisusu na mayele te.",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.7",
              "verseOrgIds": [
                "OBA.1.7"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "b"
        },
        "items": []
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q1"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "8",
              "style": "v",
              "sid": "OBA 1:8"
            },
            "items": [
              {
                "text": "8",
                "type": "text"
              }
            ]
          },
          {
            "text": "Na mokolo wana, »",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.8",
              "verseOrgIds": [
                "OBA.1.8"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q2",
          "vid": "OBA 1:8"
        },
        "items": [
          {
            "text": "elobi Yawe,",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.8",
              "verseOrgIds": [
                "OBA.1.8"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q1",
          "vid": "OBA 1:8"
        },
        "items": [
          {
            "text": "« nakoboma bato ya bwanya ya Edomi",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.8",
              "verseOrgIds": [
                "OBA.1.8"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q2",
          "vid": "OBA 1:8"
        },
        "items": [
          {
            "text": "mpe nakolongola bato ya mayele",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.8",
              "verseOrgIds": [
                "OBA.1.8"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q2",
          "vid": "OBA 1:8"
        },
        "items": [
          {
            "text": "na etuka ya bangomba ya Ezawu.",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.8",
              "verseOrgIds": [
                "OBA.1.8"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q1"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "9",
              "style": "v",
              "sid": "OBA 1:9"
            },
            "items": [
              {
                "text": "9",
                "type": "text"
              }
            ]
          },
          {
            "text": "Temani, basoda na yo ya mpiko bakolenga na somo,",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.9",
              "verseOrgIds": [
                "OBA.1.9"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q2",
          "vid": "OBA 1:9"
        },
        "items": [
          {
            "text": "mpe bavandi nyonso ya bangomba ya Ezawu bakokufa na mopanga !",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.9",
              "verseOrgIds": [
                "OBA.1.9"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q1"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "10",
              "style": "v",
              "sid": "OBA 1:10"
            },
            "items": [
              {
                "text": "10",
                "type": "text"
              }
            ]
          },
          {
            "text": "Mpo na mabe oyo osalaki Jakobi, ndeko na yo,",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.10",
              "verseOrgIds": [
                "OBA.1.10"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q2",
          "vid": "OBA 1:10"
        },
        "items": [
          {
            "text": "okotonda na soni",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.10",
              "verseOrgIds": [
                "OBA.1.10"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q2",
          "vid": "OBA 1:10"
        },
        "items": [
          {
            "text": "okobebisama mpo na libela.",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.10",
              "verseOrgIds": [
                "OBA.1.10"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q1"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "11",
              "style": "v",
              "sid": "OBA 1:11"
            },
            "items": [
              {
                "text": "11",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ozalaki kotala kaka bongo",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.11",
              "verseOrgIds": [
                "OBA.1.11"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q2",
          "vid": "OBA 1:11"
        },
        "items": [
          {
            "text": "tango bato mosusu bazalaki kokende",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.11",
              "verseOrgIds": [
                "OBA.1.11"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q1",
          "vid": "OBA 1:11"
        },
        "items": [
          {
