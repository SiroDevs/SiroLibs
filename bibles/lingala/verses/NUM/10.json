{
  "id": "NUM.10",
  "number": "10",
  "bookId": "NUM",
  "reference": "Mitango 10",
  "copyright": "Biblica® Salela na bonsomi Mokanda na Bomoi™ Makomi na se ya bokonzi © 2002, 2020 Biblica, Inc. Biblica® Open Lingala Contemporary Bible™ Copyright © 2002, 2020 by Biblica, Inc.",
  "verseCount": 36,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "10",
        "style": "c",
        "sid": "NUM 10"
      },
      "items": [
        {
          "text": "10",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bakelelo mibale ebeti mpe lisanga esangani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe alobaki na Moyize :",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.1",
            "verseOrgIds": [
              "NUM.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "« Sala bakelelo mibale na palata oyo batuta. Okosalela yango mpo na kobengisa lisanga mpe mpo na kopesa mitindo ya kolongola molako.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.2",
            "verseOrgIds": [
              "NUM.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Soki bakelelo nyonso mibale ebeti nzela moko, lisanga mobimba ekosangana pembeni na yo, na ekotelo ya Ndako ya kapo ya Bokutani.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.3",
            "verseOrgIds": [
              "NUM.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Soki kelelo moko kaka nde ebeti, kaka bakambi, bakonzi ya bituka ya Isalaele nde bakosangana liboso na yo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.4",
            "verseOrgIds": [
              "NUM.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Soki kelelo ebeti makasi, mabota oyo etongi molako na ngambo ya este ekokende.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.5",
            "verseOrgIds": [
              "NUM.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Soki ebeti makasi mpo na mbala ya mibale, mabota oyo etongi molako na ngambo ya sude ekokende. Ebeteli ya kelelo nde ekozala elembo mpo na kopesa mbela ya kokende.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.6",
            "verseOrgIds": [
              "NUM.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpo na kosangisa lisanga, beta bakelelo, kasi makasi te.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.7",
            "verseOrgIds": [
              "NUM.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bana mibali ya Aron, Banganga-Nzambe, bango nde bakobanda kobeta bakelelo yango. Ekozala mobeko ya libela mpo na bino mpe bakitani na bino.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.8",
            "verseOrgIds": [
              "NUM.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tango, kati na mokili na bino moko, bokokende na bitumba mpo na kotelemela monguna oyo azali konyokola bino, bokobeta bakelelo na bino makasi. Boye, Yawe, Nzambe na bino, akokanisa bino mpe akokangola bino na maboko ya banguna na bino.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.9",
            "verseOrgIds": [
              "NUM.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpe lisusu, na batango na bino ya kosepela, na bafeti na bino oyo ekatama mpe ya ebandeli ya sanza, bokobeta bakelelo mpo na kobonza mbeka na bino ya kotumba mpe ya boyokani. Yango ekozala ekaniseli mpo na bino na miso ya Nzambe na bino. Nazali Yawe, Nzambe na bino. »",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.10",
            "verseOrgIds": [
              "NUM.10.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bana ya Isalaele balongwe na Sinai",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mokolo ya tuku mibale, ya sanza ya mibale, ya mobu oyo ya mibale, lipata etelemaki na likolo ya Mongombo ya Litatoli.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.11",
            "verseOrgIds": [
              "NUM.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boye, bana ya Isalaele balongwaki na esobe ya Sinai, basalaki mobembo mpe batambolaki bisika na bisika kino tango lipata eyaki kopema na esobe ya Parani.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.12",
            "verseOrgIds": [
              "NUM.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezalaki mbala na bango ya liboso ya kolongwa na molako mpe kotambola kolanda mitindo oyo Yawe apesaki na nzela ya Moyize.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.13",
            "verseOrgIds": [
              "NUM.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mampinga ya molako ya Yuda ezalaki kotambola liboso, elongo na bendele na bango. Nashoni, mwana mobali ya Aminadabi, nde azalaki mokonzi na bango.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.14",
            "verseOrgIds": [
              "NUM.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Netaneeli, mwana mobali ya Tsuwari, azalaki mokonzi ya mampinga ya libota ya Isakari.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.15",
            "verseOrgIds": [
              "NUM.10.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eliabi, mwana mobali ya Eloni, azalaki mokonzi ya mampinga ya libota ya Zabuloni.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.16",
            "verseOrgIds": [
              "NUM.10.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bongo bakabolaki Mongombo na biteni-biteni. Bakitani ya Gerishoni mpe ya Merari nde bamemaki yango mpe bakendeki.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.17",
            "verseOrgIds": [
              "NUM.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mampinga ya molako ya Ribeni elandaki na sima mpo na kotambola. Elitsuri, mwana mobali ya Shedewuri, nde azalaki mokonzi na bango.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.18",
            "verseOrgIds": [
              "NUM.10.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shelumieli, mwana mobali ya Tsurishadayi, azalaki mokonzi ya mampinga ya libota ya Simeoni.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.19",
            "verseOrgIds": [
              "NUM.10.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eliazafi, mwana mobali ya Deweli, azalaki mokonzi ya mampinga ya libota ya Gadi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.20",
            "verseOrgIds": [
              "NUM.10.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sima, bato ya Keati bakendeki mpe bamemaki biloko ya bule. Balevi mosusu bazalaki kotonga Mongombo liboso ete bakoma.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.21",
            "verseOrgIds": [
              "NUM.10.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 10:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mampinga ya molako ya Efrayimi elandaki mpe na sima mpo na kotambola. Elishama, mwana mobali ya Amiwudi, nde azalaki mokonzi na bango.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.22",
            "verseOrgIds": [
              "NUM.10.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 10:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gamilieli, mwana mobali ya Pedakitsuri, azalaki mokonzi ya mampinga ya libota ya Manase.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.23",
            "verseOrgIds": [
              "NUM.10.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 10:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abidani, mwana mobali ya Gideoni, azalaki mokonzi ya mampinga ya libota ya Benjame.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.24",
            "verseOrgIds": [
              "NUM.10.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 10:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boye, mpo na kosukisa, mampinga ya libota ya Dani mpe elandaki na sima mpo na kotambola na se ya bendele na bango. Akiezeri, mwana mobali ya Amishadayi, nde azalaki mokonzi na bango.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.25",
            "verseOrgIds": [
              "NUM.10.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 10:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pagieli, mwana mobali ya Okirani, azalaki mokonzi ya mampinga ya libota ya Aseri ;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.26",
            "verseOrgIds": [
              "NUM.10.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 10:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "mpe Akira, mwana mobali ya Enani, azalaki mokonzi ya mampinga ya libota ya Nefitali.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.27",
            "verseOrgIds": [
              "NUM.10.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 10:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wana nde ezalaki molongo oyo mampinga ya bana ya Isalaele ezalaki kotambola na yango.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.28",
            "verseOrgIds": [
              "NUM.10.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Moyize aluki motambolisi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 10:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moyize alobaki na Obabi, mwana mobali ya Reweli, moto ya Madiani, bokilo ya Moyize :",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.29",
            "verseOrgIds": [
              "NUM.10.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "NUM 10:29"
      },
      "items": [
        {
          "text": "— Tozali kokende na mokili oyo Yawe alobaki : « Nakopesa bino mokili yango. » Yaka kotambola elongo na biso. Tokosala ete obika bolamu oyo Yawe alakaki kosalela Isalaele.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 10:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obabi azongiselaki ye :",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.30",
            "verseOrgIds": [
              "NUM.10.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "NUM 10:30"
      },
      "items": [
        {
          "text": "— Te ! Nakokende elongo na bino te, nakozonga na mboka na ngai, kati na libota na ngai.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NUM 10:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasi Moyize alobaki :",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.31",
            "verseOrgIds": [
              "NUM.10.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "NUM 10:31"
      },
      "items": [
        {
          "text": "— Nabondeli yo : kotika biso te, pamba te yo nde oyebi bisika oyo tosengeli kotonga molako kati na esobe ; okozala motambolisi na biso.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NUM 10:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Soki otamboli na biso elongo, tokokabola elongo na yo eloko nyonso ya malamu oyo Yawe akopesa biso.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NUM 10:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boye, balongwaki na ngomba ya Yawe mpe batambolaki mikolo misato ya mobembo. Sanduku ya Boyokani ya Yawe etambolaki liboso na bango na mobembo oyo ya mikolo misato mpo na kolukela bango esika ya kopema.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.33",
            "verseOrgIds": [
              "NUM.10.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NUM 10:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na moyi, lipata na Yawe ezalaki likolo na bango, na tango bazalaki kolongola molako.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.34",
            "verseOrgIds": [
              "NUM.10.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "NUM 10:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tango nyonso Sanduku ezalaki kokende, Moyize azalaki koloba :",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.35",
            "verseOrgIds": [
              "NUM.10.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NUM 10:35"
      },
      "items": [
        {
          "text": "« Oh Yawe, telema !",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.35",
            "verseOrgIds": [
              "NUM.10.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 10:35"
      },
      "items": [
        {
          "text": "Tika ete banguna na Yo bapalangana !",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.35",
            "verseOrgIds": [
              "NUM.10.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 10:35"
      },
      "items": [
        {
          "text": "Tika ete banguna na Yo bakima liboso na Yo ! »",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.35",
            "verseOrgIds": [
              "NUM.10.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
