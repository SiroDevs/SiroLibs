      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NUM 10:36"
      },
      "items": [
        {
          "text": "« Oh Yawe, zonga kati na bana ya Isalaele,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.36",
            "verseOrgIds": [
              "NUM.10.36"
            ]
          }
