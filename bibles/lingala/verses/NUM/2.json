      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NUM 2:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Motango nyonso ya bato oyo bazali kati na molako ya Dani ezali bato nkoto nkama moko na tuku mitano na sambo na nkama motoba, kolanda milongo ya mampinga na bango. Bango nde bakozala na sima na bango nyonso, na se ya bendele na bango.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
