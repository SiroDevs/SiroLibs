          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ngambo ya nor,",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "NUM 2:25"
      },
      "items": [
        {
          "text": "milongo ya mampinga ya Dani bakotia molako na bango na se ya bendele na bango. Mokambi ya bato ya Dani ezali Akiezeri, mwana mobali ya Amishadayi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.25",
            "verseOrgIds": [
              "NUM.2.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 2:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mampinga na ye ezali na bato nkoto tuku motoba na mibale na nkama sambo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.26",
            "verseOrgIds": [
              "NUM.2.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
