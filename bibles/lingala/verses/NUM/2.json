            "style": "v",
            "sid": "NUM 2:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpe bato ya libota ya Nefitali bakozala pembeni ya bato ya libota ya Aseri. Mokambi ya bato ya Nefitali ezali Akira, mwana mobali ya Enani.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.29",
            "verseOrgIds": [
              "NUM.2.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 2:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mampinga na ye ezali na bato nkoto tuku mitano na misato na nkama minei.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.30",
            "verseOrgIds": [
              "NUM.2.30"
            ]
          }
        }
      ]
    },
    {
