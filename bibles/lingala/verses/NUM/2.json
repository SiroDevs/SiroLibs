            "sid": "NUM 2:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bato ya libota ya Aseri bakotia molako na bango pembeni ya bato ya libota ya Dani. Mokambi ya bato ya Aseri ezali Pagieli, mwana mobali ya Okirani.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.27",
            "verseOrgIds": [
              "NUM.2.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 2:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mampinga na ye ezali na bato nkoto tuku minei na moko na nkama mitano.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.28",
            "verseOrgIds": [
              "NUM.2.28"
            ]
          }
        }
      ]
    },
    {
