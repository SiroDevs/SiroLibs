          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "makonzi oyo ezingeli lopango, makolo na yango, bapike na yango, basinga na yango, bisalelo na yango nyonso mpe biloko nyonso oyo esungaka mpo na kokangisa yango. Bokobenga moto moko na moko na kombo mpe bokopesa ye biloko oyo akobanda komema.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.32",
            "verseOrgIds": [
