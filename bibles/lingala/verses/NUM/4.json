              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tala biteni ya Ndako ya kapo ya Bokutani, oyo bakobanda komema : mabaya ya Mongombo, balate na yango, makonzi mpe makolo na yango,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.31",
            "verseOrgIds": [
              "NUM.4.31"
