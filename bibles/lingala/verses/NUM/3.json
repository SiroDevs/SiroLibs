      "type": "tag",
      "attrs": {
        "style": "li4",
        "vid": "NUM 3:33"
      },
      "items": [
        {
          "text": "Bango nde bazalaki bato ya bituka ya Merari.",
          "type": "text"
        }
      ]
    },
    {
