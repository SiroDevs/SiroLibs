          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Motango ya mibali nyonso oyo bazalaki na sanza moko ya mbotama mpe koleka, oyo batangamaki ezalaki nkoto motoba na nkama mibale.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.34",
            "verseOrgIds": [
              "NUM.3.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
