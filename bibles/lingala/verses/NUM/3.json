            "sid": "NUM 3:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mokambi ya bakambi ya Balevi ezalaki Eleazari, mwana mobali ya Nganga-Nzambe Aron. Aponamaki mpo ete akamba bato oyo bazalaki na mokumba ya kobatela Esika ya bule.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.32",
            "verseOrgIds": [
              "NUM.3.32"
            ]
          }
        }
      ]
