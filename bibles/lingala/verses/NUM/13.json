              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "mpo na libota ya Jozefi na nzela ya Manase : Gaadi, mwana mobali ya Susi ;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.11",
            "verseOrgIds": [
              "NUM.13.11"
            ]
          }
        }
      ]
    },
    {
