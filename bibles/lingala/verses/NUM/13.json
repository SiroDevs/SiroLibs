      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "NUM 13:4"
      },
      "items": [
        {
          "text": "mpo na libota ya Ribeni : Chamuwa, mwana mobali ya Zakuri ;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.4",
            "verseOrgIds": [
              "NUM.13.4"
            ]
          }
        }
      ]
    },
