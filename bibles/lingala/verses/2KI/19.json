      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2KI 19:29"
      },
      "items": [
        {
          "text": "Na mobu oyo, bokolia biloko oyo ekobima",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.29",
            "verseOrgIds": [
              "2KI.19.29"
            ]
          }
        }
      ]
