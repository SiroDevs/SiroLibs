      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2KI 19:31"
      },
      "items": [
        {
          "text": "mpe na Siona, mwa ndambo bakobika.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.31",
            "verseOrgIds": [
              "2KI.19.31"
            ]
          }
        }
      ]
    },
