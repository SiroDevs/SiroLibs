      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "2KI 19:32"
      },
      "items": [
        {
          "text": "‹ Akokota na engumba oyo te,",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.32",
            "verseOrgIds": [
              "2KI.19.32"
            ]
          }
        }
      ]
    },
