      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2KI 19:30"
      },
      "items": [
        {
          "text": "bakozala lisusu lokola nzete",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.30",
            "verseOrgIds": [
              "2KI.19.30"
            ]
          }
        }
      ]
    },
