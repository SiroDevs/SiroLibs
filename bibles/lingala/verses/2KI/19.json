      "attrs": {
        "style": "q1",
        "vid": "2KI 19:26"
      },
      "items": [
        {
          "text": "lokola matiti oyo ebotaka na mitondo ya bandako,",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.26",
            "verseOrgIds": [
              "2KI.19.26"
            ]
          }
        }
      ]
    },
