      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "2KI 19:29"
      },
      "items": [
        {
          "text": "Kasi na mobu ya misato, bokolona mpe bokobuka bambuma,",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.29",
            "verseOrgIds": [
              "2KI.19.29"
            ]
          }
        }
      ]
