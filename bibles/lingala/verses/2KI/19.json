          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yango wana, tala liloba oyo Yawe alobi na tina na mokonzi ya Asiri :",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.32",
            "verseOrgIds": [
              "2KI.19.32"
            ]
          }
        }
