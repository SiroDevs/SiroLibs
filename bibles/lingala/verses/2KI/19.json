      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2KI 19:29"
      },
      "items": [
        {
          "text": "bokolona banzete ya vino, mpe bokolia bambuma na yango.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.29",
            "verseOrgIds": [
              "2KI.19.29"
            ]
          }
        }
      ]
    },
    {
