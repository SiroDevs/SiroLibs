      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2KI 19:32"
      },
      "items": [
        {
          "text": "akobeta kuna ata mbanzi moko te,",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.32",
            "verseOrgIds": [
              "2KI.19.32"
            ]
          }
        }
      ]
    },
