      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "2KI 19:30"
      },
      "items": [
        {
          "text": "oyo ekotisi misisa na yango ya sika kati na mabele",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.30",
            "verseOrgIds": [
              "2KI.19.30"
            ]
          }
        }
      ]
    },
