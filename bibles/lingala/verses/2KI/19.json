              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boye Senakeribe, mokonzi ya Asiri, alongolaki molako, azongaki na Ninive mpe akomaki kovanda kuna.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.36",
            "verseOrgIds": [
              "2KI.19.36"
            ]
          }
        }
