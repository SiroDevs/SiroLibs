      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m",
        "vid": "2KI 19:31"
      },
      "items": [
        {
          "text": "Bolingo makasi ya Yawe, Mokonzi ya mampinga, nde ekokokisa yango.",
