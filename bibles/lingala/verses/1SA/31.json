              "type": "text"
            }
          ]
        },
        {
          "text": ";",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "1CH.10.1-1CH.10.12"
          },
          "items": [
            {
              "text": "1Ma 10.1-12",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 31:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bato ya Filisitia bazalaki kobundisa Isalaele, kasi bato ya Isalaele bakimaki liboso na bango mpe mingi kati na bango bakufaki na ngomba Giliboa.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.31.1",
            "verseOrgIds": [
              "1SA.31.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 31:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bato ya Filisitia balandaki Saulo elongo na bana na ye ya mibali, kasi babomaki bana na ye ya mibali : Jonatan, Abinadabi mpe Maliki-Shuwa.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.31.2",
            "verseOrgIds": [
              "1SA.31.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 31:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bongo bitumba ekomaki mpo na koboma Saulo. Tango basoda oyo babundaka na matolotolo bamonaki Saulo, ye Saulo alengaki na somo.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.31.3",
            "verseOrgIds": [
              "1SA.31.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 31:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saulo alobaki na soda oyo amemaki bibundeli na ye : « Bimisa mopanga na yo na ebombelo na yango mpe boma ngai, noki te bato oyo bakatama ngenga te bakoya kotuba ngai mpe kosakanela ngai. »",
          "type": "text",
          "attrs": {
            "verseId": "1SA.31.4",
            "verseOrgIds": [
              "1SA.31.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 31:4"
      },
      "items": [
        {
          "text": "Kasi soda oyo amemaki bibundeli na ye aboyaki, pamba te azalaki kobanga. Bongo Saulo akamataki mopanga na ye mpe amibwakaki na likolo na yango.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.31.4",
            "verseOrgIds": [
              "1SA.31.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 31:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tango soda oyo amemaki bibundeli na ye amonaki ete Saulo akufi, ye mpe amibwakaki na likolo ya mopanga na ye mpe akufaki elongo na Saulo.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.31.5",
            "verseOrgIds": [
              "1SA.31.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 31:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezalaki bongo nde Saulo, bana na ye misato ya mibali, soda oyo azalaki komema bibundeli na ye mpe basoda na ye nyonso bakufaki bango nyonso elongo mokolo wana.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.31.6",
            "verseOrgIds": [
              "1SA.31.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 31:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tango bato ya Isalaele, oyo bazalaki na ngambo mosusu ya lubwaku mpe ba-oyo bazalaki na ngambo mosusu ya Yordani bamonaki ete mampinga ya Isalaele esili kopanzana, mpe ete Saulo mpe bana na ye ya mibali bakufi, basundolaki bingumba na bango mpe bakimaki. Bato ya Filisitia bayaki kovanda na bingumba yango.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.31.7",
            "verseOrgIds": [
              "1SA.31.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 31:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mokolo oyo elendaki, tango bato ya Filisitia bayaki mpo na kolongola biloko oyo ezalaki na banzoto ya bibembe, bamonaki Saulo mpe bana na ye misato ya mibali oyo bakufaki na ngomba Giliboa.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.31.8",
            "verseOrgIds": [
              "1SA.31.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 31:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakataki moto ya Saulo, bazwaki bibundeli na ye mpe batindaki bato na mokili mobimba ya bato ya Filisitia mpo ete bapanza sango malamu oyo ya elonga kati na tempelo ya banzambe na bango ya bikeko mpe kati na bato na bango.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.31.9",
            "verseOrgIds": [
              "1SA.31.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 31:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batiaki bibundeli ya Saulo kati na tempelo ya banzambe na bango ya bikeko, Asitarite, mpe badiembikaki nzoto na ye na mir ya Beti-Sheani.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.31.10",
            "verseOrgIds": [
              "1SA.31.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 31:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tango bavandi ya Yabeshi kati na Galadi bayokaki makambo oyo bato ya Filisitia basalaki Saulo,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.31.11",
            "verseOrgIds": [
              "1SA.31.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 31:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "bilombe na bango nyonso batelemaki mpe batambolaki butu mobimba mpo na kokoma na Beti-Sheani. Bongo sima na bango kokitisa bibembe ya Saulo mpe ya bana na ye ya mibali wuta na mir, bazongaki na Yabeshi epai wapi batumbaki yango.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.31.12",
            "verseOrgIds": [
              "1SA.31.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 31:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bazwaki mikuwa na bango, bakundaki yango na Yabeshi, na se ya nzete ya tamarisi, mpe bakilaki bilei mikolo sambo.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.31.13",
            "verseOrgIds": [
              "1SA.31.13"
            ]
          }
        }
      ]
    }
  ],
