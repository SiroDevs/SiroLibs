        },
        {
          "text": "Tango Davidi akomaki na Tsikilagi, atindaki ndambo ya bomengo ya bitumba epai ya bampaka ya Yuda, oyo bazalaki baninga na ye. Alobaki : « Tala kado mpo na bino kowuta na bomengo ya bitumba ya banguna ya Yawe. »",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.26",
            "verseOrgIds": [
              "1SA.30.26"
            ]
          }
        }
      ]
    },
