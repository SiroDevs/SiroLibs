{
  "id": "AMO.7",
  "number": "7",
  "bookId": "AMO",
  "reference": "Amosi 7",
  "copyright": "Biblica® Salela na bonsomi Mokanda na Bomoi™ Makomi na se ya bokonzi © 2002, 2020 Biblica, Inc. Biblica® Open Lingala Contemporary Bible™ Copyright © 2002, 2020 by Biblica, Inc.",
  "verseCount": 17,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "7",
        "style": "c",
        "sid": "AMO 7"
      },
      "items": [
        {
          "text": "7",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "ms1"
      },
      "items": [
        {
          "text": "Bimoniseli ya Amosi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Emoniseli ya mabanki",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "AMO 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tala makambo oyo Nkolo Yawe alakisaki ngai : Tango matiti ebandaki kobota, ebimisaki mabanki ebele. Esalemaki sima na kobuka milona ya mokonzi.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.1",
            "verseOrgIds": [
              "AMO.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "AMO 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tango mabanki yango esilisaki kolia matiti nyonso ya mokili, nagangaki :",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.2",
            "verseOrgIds": [
              "AMO.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "AMO 7:2"
      },
      "items": [
        {
          "text": "— Oh Nkolo Yawe, limbisa bato na Yo ! Ndenge nini Jakobi oyo azali penza moke akoki solo kobika ?",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "AMO 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boye, Yawe abongolaki makanisi na Ye mpe alobaki :",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.3",
            "verseOrgIds": [
              "AMO.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "AMO 7:3"
      },
      "items": [
        {
          "text": "— Makambo yango ekosalema te.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Emoniseli ya moto",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "AMO 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tala makambo oyo Nkolo Yawe alakisaki ngai. Nkolo Yawe asalelaki moto mpo na kopesa etumbu, bongo moto yango ekawusaki mayi minene mpe ezikisaki mokili.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.4",
            "verseOrgIds": [
              "AMO.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "AMO 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boye, nagangaki :",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.5",
            "verseOrgIds": [
              "AMO.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "AMO 7:5"
      },
      "items": [
        {
          "text": "— Oh Nkolo Yawe, nabondeli Yo, kosala boye te ! Ndenge nini Jakobi oyo azali penza moke akoki solo kobika ?",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "AMO 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boye Yawe abongolaki makanisi na Ye.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.6",
            "verseOrgIds": [
              "AMO.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "AMO 7:6"
      },
      "items": [
        {
          "text": "Mpe Nkolo Yawe alobaki :",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.6",
            "verseOrgIds": [
              "AMO.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "AMO 7:6"
      },
      "items": [
        {
          "text": "— Makambo yango ekosalema lisusu te.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Emoniseli ya mbodi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "AMO 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tala makambo oyo alakisaki ngai : Nkolo azalaki ya kotelema na likolo ya mir moko batonga na mbodi mpe, na loboko na Ye, asimbaki nivo oyo batongi ndako basalelaka.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.7",
            "verseOrgIds": [
              "AMO.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "AMO 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe atunaki ngai :",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.8",
            "verseOrgIds": [
              "AMO.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "AMO 7:8"
      },
      "items": [
        {
          "text": "— Amosi, ozali komona nini ?",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "AMO 7:8"
      },
      "items": [
        {
          "text": "Nazongisaki :",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.8",
            "verseOrgIds": [
              "AMO.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "AMO 7:8"
      },
      "items": [
        {
          "text": "— Nazali komona nivo oyo batongi ndako basalelaka.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "AMO 7:8"
      },
      "items": [
        {
          "text": "Nkolo alobaki na ngai :",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.8",
            "verseOrgIds": [
              "AMO.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "AMO 7:8"
      },
      "items": [
        {
          "text": "— Tala, nakotia nivo oyo batongi ndako basalelaka na likolo ya Isalaele, bato na Ngai. Nakolimbisa bango lisusu te.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "AMO 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tango nakotelemela libota ya Jeroboami na nzela ya mopanga na Ngai, nakobebisa bisambelo ya likolo ya bangomba ya Izaki mpe bisika ya bule ya Isalaele.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Amosi mpe Amatsia",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "AMO 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amatsia, Nganga-Nzambe ya Beteli, atindelaki Jeroboami, mokonzi ya Isalaele, maloba oyo : « Amosi azali kosalela yo likita mpo na kosala yo mabe kati na mokili ya Isalaele. Mokili ekoki te kondima koyokaka tango nyonso maloba na ye.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.10",
            "verseOrgIds": [
              "AMO.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "AMO 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamba te, tala maloba oyo Amosi azali koloba :",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.11",
            "verseOrgIds": [
              "AMO.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 7:11"
      },
      "items": [
        {
          "text": "‹ Jeroboami akokufa na mopanga,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.11",
            "verseOrgIds": [
              "AMO.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 7:11"
      },
      "items": [
        {
          "text": "mpe Isalaele akokende na bowumbu, mosika ya mabele na ye. › »",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.11",
            "verseOrgIds": [
              "AMO.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "AMO 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amatsia alobaki na Amosi :",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.12",
            "verseOrgIds": [
              "AMO.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "AMO 7:12"
      },
      "items": [
        {
          "text": "— Yo, momoni makambo, bima na mokili na biso ! Zonga na mokili ya Yuda. Kuna, okosala mbongo na masakoli na yo.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "AMO 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosakola lisusu na Beteli te, pamba te Beteli ezali Esika ya bule ya mokonzi mpe tempelo ya bokonzi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "AMO 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amosi azongiselaki Amatsia :",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.14",
            "verseOrgIds": [
              "AMO.7.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "AMO 7:14"
      },
      "items": [
        {
          "text": "— Nazalaki mosakoli te to mwana ya mosakoli te, kasi nazalaki nde mobateli bibwele mpe moloni ya basikomori.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "AMO 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasi Yawe alongolaki ngai na mosala ya kobatela bibwele mpe alobaki na ngai : « Kende kosakola epai ya bato na Ngai, Isalaele. »",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "AMO 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoka sik'oyo Liloba na Yawe, yo oyo ozali koloba na ngai : « Tika kosakola mpo na kotelemela libota ya Isalaele mpe tika koloba mabe mpo na ndako ya Izaki ! »",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "AMO 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpo na yango, tala liloba oyo Yawe alobi :",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 7:17"
      },
      "items": [
        {
          "text": "« Mwasi na yo akosala kindumba kati na engumba,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.17",
            "verseOrgIds": [
              "AMO.7.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 7:17"
      },
      "items": [
        {
          "text": "bana na yo ya mibali mpe ya basi bakokufa na mopanga,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.17",
            "verseOrgIds": [
              "AMO.7.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 7:17"
      },
      "items": [
        {
          "text": "bakokabola mabele na yo na biteni.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.17",
            "verseOrgIds": [
              "AMO.7.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 7:17"
      },
      "items": [
        {
          "text": "Yo moko, okokufa na mabele ya mbindo,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.17",
            "verseOrgIds": [
              "AMO.7.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 7:17"
      },
      "items": [
        {
          "text": "mpe Isalaele akokende solo na bowumbu,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.17",
            "verseOrgIds": [
              "AMO.7.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 7:17"
      },
      "items": [
        {
          "text": "mosika ya mokili na ye ya mbotama. »",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.17",
            "verseOrgIds": [
              "AMO.7.17"
            ]
          }
        }
      ]
    }
  ],
