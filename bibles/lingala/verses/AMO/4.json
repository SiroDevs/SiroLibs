        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Isalaele aboyi kozongela Yawe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "AMO 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bino bangombe ya basi ya Bashani,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.1",
            "verseOrgIds": [
              "AMO.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 4:1"
      },
      "items": [
        {
          "text": "boyoka maloba oyo ;",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.1",
            "verseOrgIds": [
              "AMO.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 4:1"
      },
      "items": [
        {
          "text": "bozali lokola ngomba ya Samari,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.1",
            "verseOrgIds": [
              "AMO.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 4:1"
      },
      "items": [
        {
          "text": "bino bato oyo bonyokolaka babola,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.1",
            "verseOrgIds": [
              "AMO.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 4:1"
      },
      "items": [
        {
          "text": "bomonisaka bato bakelela pasi",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.1",
            "verseOrgIds": [
              "AMO.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 4:1"
      },
      "items": [
        {
          "text": "mpe bolobaka na mibali na bino :",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.1",
            "verseOrgIds": [
              "AMO.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 4:1"
      },
      "items": [
        {
          "text": "« Bomemela biso masanga mpo tomela. »",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.1",
            "verseOrgIds": [
              "AMO.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "AMO 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkolo Yawe alapi ndayi mpo na bosantu na Ye :",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.2",
            "verseOrgIds": [
              "AMO.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 4:2"
      },
      "items": [
        {
          "text": "« Solo, na mikolo ekoya, bakomema bino",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.2",
            "verseOrgIds": [
              "AMO.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 4:2"
      },
      "items": [
        {
          "text": "mpe bana na bino na bandobo ;",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.2",
            "verseOrgIds": [
              "AMO.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "AMO 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "bokobimela na madusu kati na mir,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.3",
            "verseOrgIds": [
              "AMO.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 4:3"
      },
      "items": [
        {
          "text": "moko na moko na lidusu oyo ezali liboso na ye,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.3",
            "verseOrgIds": [
              "AMO.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 4:3"
      },
      "items": [
        {
          "text": "mpe bakobengana bino kino na ngomba Erimoni, »",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.3",
            "verseOrgIds": [
              "AMO.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 4:3"
      },
      "items": [
        {
          "text": "elobi Yawe.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.3",
            "verseOrgIds": [
              "AMO.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "AMO 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "« Bokende na Beteli mpe bosala masumu,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.4",
            "verseOrgIds": [
              "AMO.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 4:4"
      },
      "items": [
        {
          "text": "bokende na Giligali mpe bosala lisusu masumu koleka.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.4",
            "verseOrgIds": [
              "AMO.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 4:4"
      },
      "items": [
        {
          "text": "Bobonza bambeka na bino tongo nyonso,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.4",
            "verseOrgIds": [
              "AMO.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 4:4"
      },
      "items": [
        {
          "text": "mpe eteni na bino ya zomi sima na mokolo ya misato.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.4",
            "verseOrgIds": [
              "AMO.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "AMO 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Botumba farine oyo batia levire",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.5",
            "verseOrgIds": [
              "AMO.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 4:5"
      },
      "items": [
        {
          "text": "lokola likabo ya kozongisa matondi,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.5",
            "verseOrgIds": [
              "AMO.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 4:5"
      },
      "items": [
        {
          "text": "mpe bobeta tolo mpo na makabo na bino,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.5",
            "verseOrgIds": [
              "AMO.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 4:5"
      },
      "items": [
        {
          "text": "oyo bokati kopesa wuta na mokano ya mitema na bino moko.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.5",
            "verseOrgIds": [
              "AMO.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 4:5"
      },
      "items": [
        {
          "text": "Bino bana ya Isalaele, bolobela yango na mongongo makasi,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.5",
            "verseOrgIds": [
              "AMO.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 4:5"
      },
      "items": [
        {
          "text": "pamba te bolingaka nde kosala bongo,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.5",
            "verseOrgIds": [
              "AMO.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 4:5"
      },
      "items": [
        {
          "text": "elobi Nkolo Yawe.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.5",
            "verseOrgIds": [
              "AMO.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "AMO 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabomaki bino nzala kati na bingumba na bino nyonso,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.6",
            "verseOrgIds": [
              "AMO.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 4:6"
      },
      "items": [
        {
          "text": "napimelaki bino bilei kati na bamboka na bino nyonso ;",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.6",
            "verseOrgIds": [
              "AMO.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 4:6"
      },
      "items": [
        {
          "text": "kasi atako bongo, bozongelaki Ngai te, »",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.6",
            "verseOrgIds": [
              "AMO.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 4:6"
      },
      "items": [
        {
          "text": "elobi Yawe.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.6",
            "verseOrgIds": [
              "AMO.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "AMO 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "« Napimelaki bino lisusu mvula,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.7",
            "verseOrgIds": [
              "AMO.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 4:7"
      },
      "items": [
        {
          "text": "basanza misato mobimba liboso ete tango",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.7",
            "verseOrgIds": [
              "AMO.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 4:7"
      },
      "items": [
        {
          "text": "oyo babukaka bambuma ekoma.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.7",
            "verseOrgIds": [
              "AMO.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 4:7"
      },
      "items": [
        {
          "text": "Natindaki mvula na engumba moko",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.7",
            "verseOrgIds": [
              "AMO.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 4:7"
      },
      "items": [
        {
          "text": "mpe nakangaki yango na engumba mosusu.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.7",
            "verseOrgIds": [
              "AMO.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 4:7"
      },
      "items": [
        {
          "text": "Elanga moko enokelaki mvula,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.7",
            "verseOrgIds": [
              "AMO.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 4:7"
      },
      "items": [
        {
          "text": "kasi mosusu ezangelaki yango mpe ekawukaki.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.7",
            "verseOrgIds": [
              "AMO.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "AMO 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bato bazalaki kotambola-tambola",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.8",
            "verseOrgIds": [
              "AMO.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 4:8"
      },
      "items": [
        {
          "text": "longwa na engumba moko kino na engumba mosusu",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.8",
            "verseOrgIds": [
              "AMO.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 4:8"
      },
      "items": [
        {
          "text": "mpo na koluka mayi,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.8",
            "verseOrgIds": [
              "AMO.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 4:8"
      },
      "items": [
        {
          "text": "kasi bazwaki mayi oyo ekokelaki baposa na bango te ;",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.8",
            "verseOrgIds": [
              "AMO.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 4:8"
      },
      "items": [
        {
          "text": "atako bongo, bozongelaki Ngai te, »",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.8",
            "verseOrgIds": [
              "AMO.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 4:8"
      },
      "items": [
        {
          "text": "elobi Yawe.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.8",
            "verseOrgIds": [
              "AMO.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "AMO 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "« Mbala mingi, nazalaki kobwakela bilanga na bino bokono,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.9",
            "verseOrgIds": [
              "AMO.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 4:9"
      },
