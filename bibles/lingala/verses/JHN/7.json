{
  "id": "JHN.7",
  "number": "7",
  "bookId": "JHN",
  "reference": "Yoane 7",
  "copyright": "Biblica® Salela na bonsomi Mokanda na Bomoi™ Makomi na se ya bokonzi © 2002, 2020 Biblica, Inc. Biblica® Open Lingala Contemporary Bible™ Copyright © 2002, 2020 by Biblica, Inc.",
  "verseCount": 53,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "7",
        "style": "c",
        "sid": "JHN 7"
      },
      "items": [
        {
          "text": "7",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu akei na feti ya Bandako ya kapo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JHN 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sima na yango, Yesu atambolaki na mokili ya Galile, aboyaki kovanda na Yuda, pamba te Bayuda bazalaki koluka koboma Ye.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.1",
            "verseOrgIds": [
              "JHN.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JHN 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzokande, feti ya Bandako ya kapo, feti ya Bayuda, ekomaki pene.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.2",
            "verseOrgIds": [
              "JHN.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JHN 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bandeko ya Yesu balobaki na Ye :",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.3",
            "verseOrgIds": [
              "JHN.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "JHN 7:3"
      },
      "items": [
        {
          "text": "— Longwa awa na Galile mpe kende na Yuda, mpo ete bayekoli na Yo bamona kuna bikamwa oyo ozali kosala.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JHN 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moto moko te asalaka na nkuku soki alingi koyebana. Lokola ozali kosala makambo minene koleka, sala ete moto nyonso kati na mokili ayeba soki ozali nani.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JHN 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamba te, ezala bandeko ya Yesu, bango mpe bazalaki kondima Ye te.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.5",
            "verseOrgIds": [
              "JHN.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JHN 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu azongiselaki bango :",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.6",
            "verseOrgIds": [
              "JHN.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "JHN 7:6"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "— Tango na Ngai ekoki nanu te ; kasi mpo na bino, tango nyonso ezali malamu.",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JHN 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mokili ekoki koyina bino te ; kasi Ngai, ezali koyina Ngai mpo ete natatolaka ete misala na yango ezali mabe.",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JHN 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Bino, bokende na feti wana ; kasi Ngai, nakokende te, pamba te tango na Ngai ekoki nanu te.",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JHN 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sima na Ye koloba na bango bongo, atikalaki na Galile.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.9",
            "verseOrgIds": [
              "JHN.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JHN 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzokande, tango bandeko na Ye bakendeki na feti, Ye mpe akendeki kuna, na komilakisa te, kasi na nkuku.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.10",
            "verseOrgIds": [
              "JHN.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wana bazalaki kati na feti, Bayuda bazalaki koluka Ye mpe bazalaki kotuna-tuna : « Azali wapi ? »",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.11",
            "verseOrgIds": [
              "JHN.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JHN 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kati na bato, tembe ekomaki makasi na tina na Ye. Bamoko bazalaki koloba : Azali moto malamu ; bamosusu : « Te, azali kokosa bato nyonso. »",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.12",
            "verseOrgIds": [
              "JHN.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JHN 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasi, lokola bango nyonso bazalaki kobanga Bayuda, moto ata moko te akokaki koloba na bonsomi nyonso na tina na Yesu.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.13",
            "verseOrgIds": [
              "JHN.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JHN 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tango mikolo ya feti ekomaki na kati-kati, Yesu akendeki na Tempelo mpe akomaki koteya.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.14",
            "verseOrgIds": [
              "JHN.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JHN 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayuda bakamwaki mpe bazalaki kotunana :",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.15",
            "verseOrgIds": [
              "JHN.7.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "JHN 7:15"
      },
      "items": [
        {
          "text": "— Ndenge nini moto oyo ayekola te akoki koyeba Makomi boye ?",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JHN 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu azongiselaki bango :",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.16",
            "verseOrgIds": [
              "JHN.7.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "JHN 7:16"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "— Makambo oyo nazali koteya ewuti epai na Ngai te, kasi ewuti epai na Ye oyo atindi Ngai.",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JHN 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Moto nyonso oyo azwi mokano ya kosala makambo oyo Nzambe alingaka, akososola soki mateya na Ngai ewuti na Nzambe to nazali koloba na ndenge na Ngai moko.",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JHN 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Moto oyo alobaka na kombo na ye moko alukaka lokumu na ye moko ; kaka oyo azali koluka lokumu ya Nzambe oyo atindaki Ye nde azali koloba solo, mpe mabe ezali te kati na Ye.",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JHN 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Boni, Moyize apesaki bino mibeko te ? Nzokande moko te kati na bino atosaka yango ! Bongo mpo na nini bozali koluka koboma Ngai ?",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JHN 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bato kati na ngulupa bazongiselaki Yesu :",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.20",
            "verseOrgIds": [
              "JHN.7.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "JHN 7:20"
      },
      "items": [
        {
          "text": "— Ozali na molimo mabe. Nani azali koluka koboma yo ?",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JHN 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu alobaki na bango :",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.21",
            "verseOrgIds": [
              "JHN.7.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "JHN 7:21"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "— Mpo na likamwisi moko oyo nasalaki, yango wana bino nyonso bokamwe !",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JHN 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Bokanisa nanu : Moyize apesaki bino mitindo ya kokatisa ngenga, —mobeko yango ewutaki kutu na Moyize te, kasi na bakoko— mpe botosaka mitindo yango ata na mokolo ya Saba.",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JHN 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Bongo soki bokataka bato ngenga na mokolo ya Saba, mpe yango ebukaka mobeko ya Moyize te, mpo na nini bozali kosilikela Ngai mpo ete nabikisi moto na mokolo ya Saba ?",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JHN 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Bosambisaka lisusu te kolanda oyo miso na bino ezali komona, kasi bokataka makambo na bosembo.",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JHN 7:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na bongo, ndambo ya bavandi ya Yelusalemi bakomaki komituna : « Azali te moto oyo bazali koluka koboma ?",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.25",
            "verseOrgIds": [
              "JHN.7.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JHN 7:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tala, azali koloba na bonsomi nyonso, mpe bazali koloba na ye eloko moko te mpo na kotelemela ye ! Boni, bokanisi ete bakonzi na biso bayebi ete azali penza Klisto ?",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.26",
            "verseOrgIds": [
              "JHN.7.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JHN 7:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasi biso, toyebi epai moto oyo awuti ; nzokande tango Klisto akoya, moto moko te akoyeba soki azali moto ya engumba nini ! »",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.27",
            "verseOrgIds": [
              "JHN.7.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JHN 7:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaka na tango yango, wana Yesu azalaki koteya kati na Tempelo, alobaki na mongongo makasi :",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.28",
            "verseOrgIds": [
              "JHN.7.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "JHN 7:28"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "— Solo, boyebi Ngai mpe boyebi epai nawuti ! Nzokande, nayei na ndenge na Ngai moko te ; ezali Ye oyo azali penza ya solo nde atindi Ngai, mpe bino, boyebi Ye te.",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JHN 7:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ngai, nayebi Ye, pamba te nawuti epai na Ye, mpe ezali Ye nde atindi Ngai.",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JHN 7:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na bongo, balukaki kokanga Yesu, kasi moto ata moko te alongaki ; pamba te tango na Ye ekokaki nanu te.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.30",
            "verseOrgIds": [
              "JHN.7.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JHN 7:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boye kati na bato, mingi bandimaki Ye ; bazalaki koloba :",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.31",
            "verseOrgIds": [
              "JHN.7.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "JHN 7:31"
      },
      "items": [
        {
          "text": "— Boni, tango Klisto akoya, akosala bikamwa mingi koleka oyo moto oyo ozali kosala ?",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JHN 7:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bafarizeo bayokaki makambo oyo bato bazalaki koloba na se se na tina na Yesu. Bongo bakonzi ya Banganga-Nzambe mpe Bafarizeo batindaki bakengeli ya Tempelo mpo na kokanga Yesu.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.32",
            "verseOrgIds": [
              "JHN.7.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JHN 7:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu alobaki :",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.33",
            "verseOrgIds": [
              "JHN.7.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "JHN 7:33"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "— Nazali nanu elongo na bino mpo na mwa tango moke, bongo nakozonga epai ya Ye oyo atindaki Ngai.",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JHN 7:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Bokoluka Ngai, kasi bokomona Ngai te ; mpe epai Ngai nakozala, bino, bokoki te koya kuna.",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JHN 7:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayuda balobanaki bango na bango :",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.35",
            "verseOrgIds": [
              "JHN.7.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "JHN 7:35"
      },
      "items": [
        {
          "text": "— Asengeli kokende wapi mpo ete tomona ye lisusu te ? Akokende epai ya Bayuda oyo bapalangana kati na Bagreki mpe koteya Bagreki ?",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JHN 7:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alingi penza koloba nini tango azali koloba :",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "« Bokoluka Ngai, kasi bokomona Ngai te ; mpe epai Ngai nakozala, bino, bokoki te koya kuna ? »",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mayi ya bomoi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JHN 7:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mokolo ya suka ya feti, mokolo oyo eleki monene, Yesu atelemaki mpe alobaki na mongongo makasi :",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.37",
            "verseOrgIds": [
              "JHN.7.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "JHN 7:37"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "— Tika ete moto nyonso oyo azali na posa ya mayi aya epai na Ngai mpe amela.",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JHN 7:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Moto oyo akondima Ngai, kolanda ndenge Makomi elobi, bibale ya mayi ya bomoi ekotiola wuta kati na ye.",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JHN 7:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu alobaki bongo na tina na Molimo oyo bato oyo bakotia kondima na bango kati na Ye bakozwa ; mpo ete na tango wana, Molimo apesamaki nanu te, pamba te Yesu akotaki nanu te kati na nkembo na Ye.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.39",
            "verseOrgIds": [
              "JHN.7.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bato bakabwani mpo na Yesu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JHN 7:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kati na bato oyo bayokaki maloba na Ye, bamoko bazalaki koloba : « Moto oyo azali penza Mosakoli, »",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.40",
            "verseOrgIds": [
              "JHN.7.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JHN 7:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "bamosusu : « Azali Klisto, » kasi bamosusu lisusu : « Boni, Klisto akoki kobimela na Galile ?",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.41",
            "verseOrgIds": [
              "JHN.7.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JHN 7:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boni, Makomi ezali koloba te ete Klisto akobimela na libota ya Davidi mpe akobotama na Beteleemi, mboka ya Davidi ? »",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.42",
            "verseOrgIds": [
              "JHN.7.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "JHN 7:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezali bongo nde bato bakabwanaki na tina na Yesu.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.43",
            "verseOrgIds": [
              "JHN.7.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "JHN 7:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bamosusu kati na bango balukaki kokanga Ye, kasi moto ata moko te alongaki.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.44",
            "verseOrgIds": [
              "JHN.7.44"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bakonzi ya Bayuda baboyi kondima Yesu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "JHN 7:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakengeli ya Tempelo bazongaki epai ya bakonzi ya Banganga-Nzambe mpe Bafarizeo. Bakonzi ya Banganga-Nzambe mpe Bafarizeo batunaki bakengeli :",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.45",
            "verseOrgIds": [
              "JHN.7.45"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "JHN 7:45"
      },
      "items": [
        {
          "text": "— Mpo na nini bomemi Yesu awa te ?",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "JHN 7:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakengeli bazongisaki :",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.46",
            "verseOrgIds": [
              "JHN.7.46"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "JHN 7:46"
      },
      "items": [
        {
          "text": "— Ezali na moto ata moko te oyo asila koloba makambo oyo moto wana azali koloba.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "JHN 7:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bafarizeo batunaki lisusu :",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.47",
            "verseOrgIds": [
              "JHN.7.47"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "JHN 7:47"
      },
      "items": [
        {
          "text": "— Bino mpe bomitiki penza mpo ete akosa bino ?",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "JHN 7:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boni, kati na bakonzi to kati na Bafarizeo, ezali ata na moko oyo andimi ye ?",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "JHN 7:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezali kaka bato oyo bayebi mibeko ya Moyize te, bazali penza bato balakelama mabe !",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "JHN 7:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasi moko kati na bango, Nikodemi, oyo, mokolo moko, akendeki epai ya Yesu, alobaki :",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.50",
            "verseOrgIds": [
              "JHN.7.50"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "JHN 7:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "— Boni, mibeko na biso ekoki kokatela moto etumbu na kozanga koyoka ye liboso, mpe na kozanga koyeba mabe oyo asili kosala ?",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "JHN 7:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bazongiselaki ye :",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.52",
            "verseOrgIds": [
              "JHN.7.52"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "JHN 7:52"
      },
      "items": [
        {
          "text": "— Boni, yo mpe ozali moto ya Galile ? Kundola malamu Makomi, mpe okomona penza ete mosakoli moko te abimela na Galile.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JHN 7:52"
      },
      "items": [
        {
          "text": "[",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.52",
            "verseOrgIds": [
              "JHN.7.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "JHN 7:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na bongo, moko na moko azongaki na ndako na ye.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.53",
            "verseOrgIds": [
              "JHN.7.53"
            ]
          }
        }
      ]
    }
  ],
