  "verseCount": 34,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "25",
        "style": "c",
        "sid": "GEN 25"
      },
      "items": [
        {
          "text": "25",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bakitani ya Abrayami",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 25:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abrayami abalaki mwasi mosusu, kombo na ye « Ketura. »",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.1",
            "verseOrgIds": [
              "GEN.25.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ketura abotelaki ye : Zimirani, Yokishani, Medani, Madiani, Ishibaki mpe Shuwa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.2",
            "verseOrgIds": [
              "GEN.25.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yokishani azalaki tata ya Saba mpe Dedani. Tala bato oyo bazalaki bakitani ya Dedani : Bato ya Ashuri, ya Letushi mpe ya Lewumi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.3",
            "verseOrgIds": [
              "GEN.25.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Madiani azalaki tata ya Efa, ya Eferi, ya Enoki, ya Abida mpe ya Elida. Bato oyo nyonso bazalaki bakitani ya Ketura.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.4",
            "verseOrgIds": [
              "GEN.25.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abrayami atikaki biloko na ye nyonso na maboko ya Izaki.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.5",
            "verseOrgIds": [
              "GEN.25.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasi wana Abrayami azalaki nanu na bomoi, apesaki bakado epai ya bana mibali ya bamakangu na ye mpe atindaki bango na mokili ya este, mosika ya mwana na ye ya mobali Izaki.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.6",
            "verseOrgIds": [
              "GEN.25.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abrayami awumelaki na bomoi mibu nkama moko na tuku sambo na mitano.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.7",
            "verseOrgIds": [
              "GEN.25.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bongo Abrayami akataki motema mpe akufaki. Sima na ye kotonda mikolo mpe kokoma mobange makasi, akendeki kokutana na bakoko na ye.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.8",
            "verseOrgIds": [
              "GEN.25.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bana na ye ya mibali, Izaki mpe Isimaeli, bakundaki ye na lilita ya mabanga ya Makipela pene ya Mamire, kati na elanga ya Efroni, mwana mobali ya Tsoari, moto ya Iti.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.9",
            "verseOrgIds": [
              "GEN.25.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abrayami asombaki elanga yango epai ya bato ya Iti. Ezalaki kuna nde bakundaki mwasi na ye Sara.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.10",
            "verseOrgIds": [
              "GEN.25.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sima na kufa ya Abrayami, Nzambe apambolaki Izaki, mwana mobali ya Abrayami. Izaki azalaki kovanda pene ya Lakai-Royi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.11",
            "verseOrgIds": [
              "GEN.25.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bakitani ya Isimaeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tala molongo ya bakitani ya Isimaeli, mwana mobali ya Abrayami, oyo Agari, moto ya Ejipito mpe mwasi mosali ya Sara, abotelaki Abrayami.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.12",
            "verseOrgIds": [
              "GEN.25.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 25:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tala bakombo ya bana mibali ya Isimaeli kolanda ndenge babotamela :",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "GEN 25:13"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "GEN 25:13"
      },
      "items": [
        {
          "text": "Nebayoti, mwana mobali ya liboso ya Isimaeli ;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.13",
            "verseOrgIds": [
              "GEN.25.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "GEN 25:13"
      },
      "items": [
        {
          "text": "Kedari, Adibeli, Mibisami,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.13",
            "verseOrgIds": [
              "GEN.25.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 25:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mishima, Duma, Masa,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.14",
            "verseOrgIds": [
              "GEN.25.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 25:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adadi, Tema, Yeturi,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.15",
            "verseOrgIds": [
              "GEN.25.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "GEN 25:15"
      },
      "items": [
        {
          "text": "Nafishi mpe Kedima.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.15",
            "verseOrgIds": [
              "GEN.25.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 25:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bango nde bazalaki bana mibali zomi na mibale ya Isimaeli. Moko na moko azalaki mokambi ya libota, mpe apesaki kombo na ye na mboka na ye mpe na molako na ye.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 25:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isimaeli awumelaki na bomoi mibu nkama moko na tuku misato na sambo. Akataki motema mpe akufaki ; akendeki kokutana na bakoko na ye.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.17",
            "verseOrgIds": [
              "GEN.25.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 25:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakitani na ye bazalaki kovanda na mokili oyo ezalaki kati na Avila mpe Shuri, pene ya Ejipito, na nzela oyo ekenda na Asiri. Bazalaki tango nyonso kovanda lokola banguna ya bandeko na bango nyonso.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.18",
            "verseOrgIds": [
              "GEN.25.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ezawu mpe Jakobi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 25:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tala libota ya Izaki, mwana mobali ya Abrayami.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.19",
            "verseOrgIds": [
              "GEN.25.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "GEN 25:19"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 25:19"
      },
      "items": [
        {
          "text": "Abrayami azalaki tata ya Izaki,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.19",
            "verseOrgIds": [
              "GEN.25.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 25:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "mpe Izaki azalaki na mibu tuku minei ya mbotama tango abalaki Rebeka, mwana mwasi ya Betweli, moto ya Arami ya Padani-Arami, mpe ndeko mwasi ya Labani, moto ya Arami.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.20",
            "verseOrgIds": [
              "GEN.25.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 25:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izaki abondelaki Yawe mpo na Rebeka, mwasi na ye, oyo azalaki ekomba. Yawe ayanolaki libondeli na ye, mpe Rebeka akomaki na zemi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.21",
            "verseOrgIds": [
              "GEN.25.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 25:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kati na libumu na ye, bana bazalaki kowelana. Alobaki : « Likambo nini oyo ekomeli ngai ? »",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.22",
            "verseOrgIds": [
              "GEN.25.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 25:22"
      },
      "items": [
        {
          "text": "Boye, akendeki kotuna Yawe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.22",
            "verseOrgIds": [
              "GEN.25.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 25:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe alobaki na ye :",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.23",
            "verseOrgIds": [
              "GEN.25.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "GEN 25:23"
      },
      "items": [
        {
          "text": "« Bikolo mibale ezali kati na libumu na yo,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.23",
            "verseOrgIds": [
              "GEN.25.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 25:23"
      },
      "items": [
        {
          "text": "mpe mabota mibale ekabwana ekobima na libumu na yo ;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.23",
            "verseOrgIds": [
              "GEN.25.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "GEN 25:23"
      },
      "items": [
        {
          "text": "ekolo moko ekoleka ekolo mosusu na makasi,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.23",
            "verseOrgIds": [
              "GEN.25.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 25:23"
      },
      "items": [
        {
          "text": "mpe kulutu akosalela leki. »",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.23",
            "verseOrgIds": [
              "GEN.25.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 25:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wana tango na ye ya kobota ekokaki, azalaki na mapasa mibale kati na libumu na ye.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.24",
            "verseOrgIds": [
              "GEN.25.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 25:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lipasa ya liboso oyo abimaki azalaki motane mpe nzoto na ye mobimba ezalaki etonda na bapwale lokola elamba ya bapwale ; yango wana babengaki ye « Ezawu. »",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.25",
            "verseOrgIds": [
              "GEN.25.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 25:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sima na yango, ndeko na ye mpe abimaki, loboko na ye ekanga litindi ya Ezawu ; yango wana bapesaki ye kombo « Jakobi. » Izaki azalaki na mibu tuku motoba ya mbotama tango Rebeka abotaki.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.26",
            "verseOrgIds": [
              "GEN.25.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 25:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bana mibali yango bakolaki. Ezawu akomaki mobomi makasi ya banyama mpe azalaki kolekisa tango mingi na zamba ; Jakobi azalaki moto ya kimia, azalaki kosepela kovanda na ndako.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.27",
            "verseOrgIds": [
              "GEN.25.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 25:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izaki abandaki kosepela mingi na misuni, yango wana alingaki mingi Ezawu ; mpe Rebeka alingaki mingi Jakobi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.28",
            "verseOrgIds": [
              "GEN.25.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 25:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mokolo moko, wana Jakobi azalaki kolamba elubu, Ezawu oyo awutaki na bilanga ayaki na kolemba.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.29",
            "verseOrgIds": [
              "GEN.25.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 25:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezawu alobaki na Jakobi :",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.30",
            "verseOrgIds": [
              "GEN.25.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "GEN 25:30"
      },
      "items": [
        {
          "text": "— Nalembi makasi ; tika ngai nalia elubu oyo, elubu oyo kaka.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 25:30"
      },
      "items": [
        {
          "text": "Yango wana bazalaki mpe kobenga ye Edomi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.30",
            "verseOrgIds": [
              "GEN.25.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 25:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jakobi azongisaki :",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.31",
            "verseOrgIds": [
              "GEN.25.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "GEN 25:31"
      },
      "items": [
        {
          "text": "— Tekela ngai liboso boyaya na yo.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 25:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezawu azongisaki :",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.32",
            "verseOrgIds": [
              "GEN.25.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "GEN 25:32"
      },
      "items": [
        {
          "text": "— Tala, nakokufa na nzala. Boyaya na ngai ekopesa ngai nini ?",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 25:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasi Jakobi alobaki :",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.33",
            "verseOrgIds": [
              "GEN.25.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "GEN 25:33"
      },
      "items": [
        {
          "text": "— Lapa liboso ndayi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 25:33"
      },
      "items": [
        {
          "text": "Ezawu alapaki ndayi epai ya Jakobi ; mpe na nzela wana, atekaki boyaya na ye epai ya Jakobi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.33",
            "verseOrgIds": [
              "GEN.25.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "GEN 25:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jakobi apesaki Ezawu lipa mpe elubu ya misili. Ezawu aliaki mpe amelaki, bongo atelemaki mpe akendeki. Ezali ndenge wana nde Ezawu atiolaki boyaya na ye.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.34",
            "verseOrgIds": [
              "GEN.25.34"
            ]
          }
        }
      ]
    }
  ],
