      },
      "items": [
        {
          "text": "moko, kombo na ye ezalaki « Pelegi, » pamba te na tango na ye nde bakabolaki mabele ; mpe mosusu, « Yokitani. »",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.25",
            "verseOrgIds": [
              "GEN.10.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
