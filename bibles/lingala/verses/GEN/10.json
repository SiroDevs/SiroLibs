          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yokitani abotaki",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.26",
            "verseOrgIds": [
              "GEN.10.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "GEN 10:26"
      },
      "items": [
        {
          "text": "Alimodadi, Shelefi, Atsarimaveti, Yera,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.26",
            "verseOrgIds": [
              "GEN.10.26"
            ]
          }
        },
        {
          "name": "verse",
