  "verseCount": 32,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "10",
        "style": "c",
        "sid": "GEN 10"
      },
      "items": [
        {
          "text": "10",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "ms1"
      },
      "items": [
        {
          "text": "Mabota ya bana ya Noa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tala libota ya Noa : Semi, Cham mpe Jafeti ; bango mpe babotaki bakitani sima na mpela.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Libota ya Jafeti",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bana mibali ya Jafeti :",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.2",
            "verseOrgIds": [
              "GEN.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "GEN 10:2"
      },
      "items": [
        {
          "text": "Gomeri, Magogi, Madayi, Yavani, Tubali, Mesheki mpe Tirasi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.2",
            "verseOrgIds": [
              "GEN.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bana mibali ya Gomeri :",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.3",
            "verseOrgIds": [
              "GEN.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "GEN 10:3"
      },
      "items": [
        {
          "text": "Ashikenazi, Rifati mpe Togarima.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.3",
            "verseOrgIds": [
              "GEN.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bana mibali ya Yavani :",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.4",
            "verseOrgIds": [
              "GEN.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "GEN 10:4"
      },
      "items": [
        {
          "text": "Elisha, Tarsisi, Kitimi mpe Dodanimi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.4",
            "verseOrgIds": [
              "GEN.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakitani na bango nde bavandaki na bisanga mpe na bamboka ya pembeni ya mayi. Moko na moko kati na bango azwaki mokili na ye kolanda lokota na ye, etuka na ye mpe libota na ye.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.5",
            "verseOrgIds": [
              "GEN.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Libota ya Cham",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bana mibali ya Cham :",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.6",
            "verseOrgIds": [
              "GEN.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "GEN 10:6"
      },
      "items": [
        {
          "text": "Kushi, Mitsirayimi, Puti mpe Kanana.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.6",
            "verseOrgIds": [
              "GEN.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bana mibali ya Kushi :",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.7",
            "verseOrgIds": [
              "GEN.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "GEN 10:7"
      },
      "items": [
        {
          "text": "Seba, Avila, Sabita, Raema mpe Sabiteka.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.7",
            "verseOrgIds": [
              "GEN.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "GEN 10:7"
      },
      "items": [
        {
          "text": "Bana mibali ya Raema :",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.7",
            "verseOrgIds": [
              "GEN.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "GEN 10:7"
      },
      "items": [
        {
          "text": "Sheba mpe Dedani.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.7",
            "verseOrgIds": [
              "GEN.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kushi azalaki mpe tata ya Nimirodi oyo azalaki elombe ya liboso ya bitumba kati na mokili.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azalaki mobomi monene ya banyama na miso ya Yawe. Yango wana, balobaka : « Mobomi monene ya banyama lokola Nimirodi na miso ya Yawe. »",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bingumba ya liboso ya mokili na ye ezalaki Babeli, Ereki, Akadi mpe Kaline na mokili ya Shineari.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Longwa na mokili wana, alekaki na Asiri mpe atongaki Ninive, Reoboti-Iri, Kala",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "mpe Reseni, engumba monene na kati-kati ya Ninive mpe Kala.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mitsirayimi azalaki koko",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.13",
            "verseOrgIds": [
              "GEN.10.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "GEN 10:13"
      },
      "items": [
        {
          "text": "ya bato ya Ludi, ya Anami, ya Leabi, ya Nafitu,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.13",
            "verseOrgIds": [
              "GEN.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "ya Patrusi, ya Kasilu (oyo babimisa bato ya Filisitia) mpe ya Kereti.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.14",
            "verseOrgIds": [
              "GEN.10.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanana azalaki tata",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.15",
            "verseOrgIds": [
              "GEN.10.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "GEN 10:15"
      },
      "items": [
        {
          "text": "ya Sidoni, mwana na ye ya liboso, ya Eti,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.15",
            "verseOrgIds": [
              "GEN.10.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "ya Yebusi, ya Amori, ya Girigazi,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.16",
            "verseOrgIds": [
              "GEN.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "ya Evi, ya Ariki, ya Sini,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.17",
            "verseOrgIds": [
              "GEN.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "ya Arivadi, ya Tsemari mpe ya Amati.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.18",
            "verseOrgIds": [
              "GEN.10.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "GEN 10:18"
      },
      "items": [
        {
          "text": "(Mpe na sima, bato ya mabota nyonso ya Kanana bapalanganaki bipai na bipai.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.18",
            "verseOrgIds": [
              "GEN.10.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mokili ya bato ya Kanana ebandaki wuta na Sidoni, na nzela ya Gerari, kino na Gaza ; mpe na nzela ya Sodome, ya Gomore, ya Adima mpe ya Tseboyimi kino na Lesha.)",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.19",
            "verseOrgIds": [
              "GEN.10.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bango nde bazalaki bakitani ya Cham kolanda mabota mpe nkota na bango, kati na mikili mpe bikolo na bango.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Libota ya Semi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Semi, kulutu ya Jafeti, abotaki mpe bana ; azalaki koko ya Eberi mpe ya bakitani na ye.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 10:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bana mibali ya Semi :",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.22",
            "verseOrgIds": [
              "GEN.10.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "GEN 10:22"
      },
      "items": [
        {
          "text": "Elami, Asuri, Aripakishadi, Ludi mpe Arami.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.22",
            "verseOrgIds": [
              "GEN.10.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 10:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bana mibali ya Arami :",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.23",
            "verseOrgIds": [
              "GEN.10.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "GEN 10:23"
      },
      "items": [
        {
          "text": "Utsi, Uli, Geteri mpe Mashi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.23",
            "verseOrgIds": [
              "GEN.10.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 10:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aripakishadi abotaki Shela ;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.24",
            "verseOrgIds": [
              "GEN.10.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "GEN 10:24"
      },
      "items": [
        {
          "text": "Shela abotaki Eberi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.24",
            "verseOrgIds": [
              "GEN.10.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 10:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eberi abotaki bana mibali mibale :",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.25",
            "verseOrgIds": [
              "GEN.10.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
