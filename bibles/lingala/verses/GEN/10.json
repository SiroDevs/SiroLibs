          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Mokili oyo bazalaki kovanda ebandaki wuta na Mesha kino na Sefari, na mokili ya bangomba ya este.)",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.30",
            "verseOrgIds": [
              "GEN.10.30"
            ]
          }
