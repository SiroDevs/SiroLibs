          "text": "« Nakolanda bango kino nakokanga bango,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.9",
            "verseOrgIds": [
              "EXO.15.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EXO 15:9"
      },
      "items": [
        {
          "text": "molimo na ngai ekotonda",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.9",
            "verseOrgIds": [
              "EXO.15.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EXO 15:9"
      },
      "items": [
        {
          "text": "na biloko oyo nakobotola ;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.9",
            "verseOrgIds": [
              "EXO.15.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EXO 15:9"
      },
      "items": [
        {
          "text": "nakobimisa mopanga na ngai,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.9",
            "verseOrgIds": [
              "EXO.15.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EXO 15:9"
      },
      "items": [
        {
          "text": "mpe loboko na ngai ekobebisa bango. »",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.9",
            "verseOrgIds": [
              "EXO.15.9"
            ]
          }
        }
      ]
    },
    {
