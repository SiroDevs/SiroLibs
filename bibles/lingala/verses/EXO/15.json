          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azindisi na ebale monene,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.4",
            "verseOrgIds": [
              "EXO.15.4"
            ]
