      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EXO 15:5"
      },
      "items": [
        {
          "text": "bakiti kino na se ya ebale monene lokola libanga.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.5",
            "verseOrgIds": [
              "EXO.15.5"
            ]
          }
        }
      ]
