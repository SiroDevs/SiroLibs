      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EXO 15:13"
      },
      "items": [
        {
          "text": "Na makasi na Yo, omemi bango na Ndako na Yo ya bule.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.13",
            "verseOrgIds": [
              "EXO.15.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bikolo eyoki sango na yango mpe ekomi kolenga,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.14",
            "verseOrgIds": [
              "EXO.15.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EXO 15:14"
      },
      "items": [
        {
          "text": "somo ekangaki bato ya Filisitia.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.14",
            "verseOrgIds": [
              "EXO.15.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakambi ya Edomi bakomi na somo,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.15",
            "verseOrgIds": [
              "EXO.15.15"
            ]
          }
        }
