      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EXO 15:4"
      },
      "items": [
        {
          "text": "abwaki na ebale monene ya barozo,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.4",
            "verseOrgIds": [
              "EXO.15.4"
            ]
          }
        }
