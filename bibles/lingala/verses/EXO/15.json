      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EXO 15:3"
      },
      "items": [
        {
          "text": "Kombo na Ye ezali Yawe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.3",
            "verseOrgIds": [
              "EXO.15.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
