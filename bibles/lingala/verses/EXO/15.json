      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EXO 15:12"
      },
      "items": [
        {
          "text": "mpe mabele emeli bango.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.12",
            "verseOrgIds": [
              "EXO.15.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
