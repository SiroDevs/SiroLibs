    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Moyize mpe bana ya Isalaele bayembi loyembo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moyize mpe bana ya Isalaele bayembaki loyembo oyo mpo na lokumu ya Yawe :",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.1",
            "verseOrgIds": [
              "EXO.15.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EXO 15:1"
      },
      "items": [
        {
          "text": "Nakoyemba mpo na lokumu ya Yawe,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.1",
            "verseOrgIds": [
              "EXO.15.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EXO 15:1"
      },
      "items": [
        {
          "text": "mpo ete amonisi monene ya nkembo na Ye !",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.1",
            "verseOrgIds": [
              "EXO.15.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EXO 15:1"
      },
      "items": [
        {
          "text": "Azindisi mpunda mpe motambolisi",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.1",
            "verseOrgIds": [
              "EXO.15.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EXO 15:1"
      },
      "items": [
        {
          "text": "na yango kati na ebale monene.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.1",
            "verseOrgIds": [
              "EXO.15.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe azali makasi na ngai,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.2",
            "verseOrgIds": [
              "EXO.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EXO 15:2"
      },
      "items": [
        {
          "text": "azali solo loyembo na ngai,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.2",
            "verseOrgIds": [
              "EXO.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EXO 15:2"
      },
      "items": [
        {
          "text": "azali mobikisi na ngai,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.2",
            "verseOrgIds": [
              "EXO.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EXO 15:2"
      },
      "items": [
        {
          "text": "azali Nzambe na ngai,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.2",
            "verseOrgIds": [
              "EXO.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EXO 15:2"
      },
      "items": [
        {
          "text": "nakokumisa Ye ;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.2",
            "verseOrgIds": [
              "EXO.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EXO 15:2"
      },
      "items": [
        {
          "text": "azali Nzambe ya tata na ngai, nakonetola Ye.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.2",
            "verseOrgIds": [
              "EXO.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
