          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mozindo ya mayi ezipi bango,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.5",
            "verseOrgIds": [
              "EXO.15.5"
            ]
          }
        }
      ]
    },
