          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na bolingo na Yo, otambolisi bato oyo okangoli.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.13",
            "verseOrgIds": [
              "EXO.15.13"
            ]
