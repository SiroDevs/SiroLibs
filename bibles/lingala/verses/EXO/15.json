            "number": "3",
            "style": "v",
            "sid": "EXO 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe azali elombe ya bitumba ;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.3",
            "verseOrgIds": [
              "EXO.15.3"
            ]
