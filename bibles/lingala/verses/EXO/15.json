      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Osembolaki loboko na Yo ya mobali,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.12",
            "verseOrgIds": [
              "EXO.15.12"
            ]
          }
        }
