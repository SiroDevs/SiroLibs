  "verseCount": 43,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "28",
        "style": "c",
        "sid": "EXO 28"
      },
      "items": [
        {
          "text": "28",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bilamba ya Banganga-Nzambe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 28:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kamata kati na bana ya Isalaele Aron, ndeko na yo ya mobali, elongo na bana na ye ya mibali : Nadabi mpe Abiyu, Eleazari mpe Itamari ; mpo ete basala mosala ya bonganga-Nzambe liboso na Ngai.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 28:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okotonga mpo na Aron, ndeko na yo ya mobali, bilamba ya bule lokola elembo ya nkembo mpe ya lokumu.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 28:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bongo yo, okoloba na bato nyonso ya mayele oyo, kati na bango, natondisi molimo ya bwanya mpo ete batonga bilamba ya Aron mpo na kobulisa ye na mosala ya bonganga-Nzambe liboso na Ngai.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 28:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tala bilamba oyo bakotonga : elamba ya tolo, efode",
          "type": "text"
        },
        {
          "text": ", kazaka mpe nzambala oyo batia bililingi likolo na yango, kitendi ya kokanga na moto mpe mokaba. Bakotonga bilamba ya bule mpo na Aron, ndeko na yo ya mobali, mpe mpo na bana na ye ya mibali oyo bakosala mosala ya bonganga-Nzambe liboso na Ngai.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 28:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakosalela wolo, langi ya ble, ya motane ya pete, ya motane makasi mpe lino ya kitoko.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Efode",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 28:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakotonga na wolo efode ya langi ya ble, ya motane ya pete, ya motane makasi mpe na lino ya kitoko oyo bakotonga bililingi na likolo na yango ; ekozala mosala ya bato oyo basalaka bililingi na maboko.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 28:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekozala na bankamba mibale na basuka na yango mibale mpo na kolata efode yango ; bankamba ekoleka likolo ya mapeka.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 28:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mokaba ya efode ekosalema ndenge moko na efode : ekozala ya wolo, ya langi ya ble, ya motane ya pete, ya motane makasi mpe na lino ya kitoko oyo bakotonga bililingi na likolo na yango.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 28:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okozwa mabanga mibale ya onikisi mpe okokoma na likolo na yango bakombo ya bana mibali ya Isalaele",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 28:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "kolanda ndenge babotama : bakombo motoba na libanga ya liboso mpe bakombo motoba oyo etikali, na libanga ya mibale.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 28:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okokoma bakombo ya bana mibali ya Isalaele na mabanga nyonso mibale ndenge bato basalaka bililingi na kashe na libanga ; mpe okozingela yango na wolo.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 28:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okotia mabanga yango na bankamba ya efode lokola mabanga ya ekaniseli mpo na bana mibali ya Isalaele. Aron akomema likolo ya mapeka na ye lokola ekaniseli liboso ya Yawe bakombo na bango.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 28:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okotia bikangelo ya wolo",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 28:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "mpe okosala basheneti mibale ya wolo basangisa na eloko mosusu te ; okosala yango lokola suki ya maboko mpe okokangisa basheneti yango pembeni-pembeni ya mabanga.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Elamba ya tolo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 28:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okosala elamba ya tolo mpo na koyeba mokano ya Nzambe ; ekozala mosala ya bato oyo basalaka bililingi na maboko. Okotonga yango lokola efode : ekozala ya wolo, ya langi ya ble, ya motane ya pete, ya motane makasi mpe na lino ya kitoko oyo bakotonga bililingi na likolo na yango.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 28:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Soki bagumbi yango na biteni mibale, molayi mpe mokuse esengeli kozala ndenge moko : basantimetele pene tuku mibale na mitano.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 28:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okotia na likolo na yango milongo minei ya mabanga ya talo. Na molongo ya liboso, okotia libanga ya saridwane, ya topaze mpe ya emerode ;",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 28:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "na molongo ya mibale, okotia libanga ya ribisi, ya safiri mpe ya diama ;",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 28:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "na molongo ya misato, okotia libanga ya opale, ya agate mpe ya ametisite ;",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 28:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "mpe na molongo ya minei, okotia libanga ya krizolite, ya onikisi mpe ya jasipe. Okokanga mabanga yango na bikangelo ya wolo.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 28:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mabanga yango ekozala zomi na mibale kolanda bakombo ya bana mibali ya Isalaele. Na likolo ya libanga moko na moko, bakokoma kombo ya moko kati na mabota zomi na mibale ; bakokoma yango ndenge basalaka bililingi na kashe.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 28:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okosala basheneti ya wolo ya peto mpo na elamba ya tolo ; okosala yango ndenge bakangaka suki ya maboko.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 28:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okosala bapete mibale ya wolo mpo na elamba ya tolo mpe okokangisa yango na basonge mibale ya elamba yango.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 28:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okolekisa basheneti mibale ya wolo kati na bapete mibale oyo ezali na basonge ya elamba ya tolo,",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 28:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "mpe okokangisa basonge mibale mosusu ya basheneti yango, na bikangelo nyonso mibale ; mpe okokangisa yango na bankamba ya efode ; bankamba yango ekoleka na liboso.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 28:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okosala bapete mibale ya wolo oyo okotia na basonge mibale ya se ya elamba ya tolo, na ngambo ya kati oyo etala efode.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 28:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okosala bapete mosusu mibale ya wolo oyo okotia na bankamba mibale ya efode, na se, na liboso mpe na pembeni ya mokaba ya efode.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 28:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okokangisa na singa ya langi ya ble bapete ya wolo ya elamba ya tolo mpe bapete ya wolo ya efode, mpo ete elamba ya tolo ezala likolo ya efode mpe elongwa te na likolo na yango.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 28:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boye tango Aron akokota na Esika-Oyo-Eleki-Bule, akomema na motema na ye, na elamba ya tolo ya kokata makambo, bakombo ya bana mibali ya Isalaele lokola ekaniseli liboso ya Yawe mpo na libela.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 28:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okotia lisusu Urimi mpe Tumimi kati na elamba ya tolo ya kokata makambo mpe yango ekozala likolo ya motema ya Aron tango akotelema liboso ya Yawe. Boye Aron akomema makambo ya bana ya Isalaele liboso ya Yawe mpo na libela.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bilamba mosusu ya Banganga-Nzambe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 28:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okosala mobimba ya nzambala oyo ekozala na se ya efode na langi ya ble.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 28:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzambala esengeli kozala na lidusu na kati-kati mpo na kokotisa moto ; bakotonga pembeni-pembeni ya lidusu yango poso ya makasi mpo ete epasuka te.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 28:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na se mpe zingazinga ya nzambala, okotia bambuma ya grenade bakangisa na singa ya langi ya ble, ya motane ya pete mpe ya motane makasi ; mpe okotia bangonga ya mike-mike kati na bambuma ya grenade.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 28:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekolandana boye : ngonga moko ya moke ya wolo, mbuma moko ya grenade, mpe bongo na bongo, zingazinga ya basonge nyonso ya nzambala.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 28:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aron asengeli kolata yango tango azali kosala mosala. Makelele ya bangonga ya mike-mike ekoyokana tango akotelema liboso ya Yawe na Esika-Oyo-Eleki-Bule mpe tango akobima ; wana ekolakisa ete akufi te.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "EXO 28:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okosala na wolo ya peto medaye mpe okokoma na likolo na yango ndenge basalaka bililingi na kashe :",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pc",
        "vid": "EXO 28:36"
      },
      "items": [
        {
          "text": "abulisama mpo na Yawe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.36",
            "verseOrgIds": [
              "EXO.28.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "EXO 28:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okokangisa yango na singa ya ble, mpe ekozala na likolo ya kitendi ya kokanga na moto, na mbunzu.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "EXO 28:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Linzanza yango ekozala na mbunzu ya Aron mpo ete akoka komema bambeba oyo bana ya Isalaele bakosala na tina na biloko ya bule oyo bakobonza mpe bakobulisa. Linzanza yango ekozala tango nyonso na mbunzu ya Aron mpo ete Ngai Yawe, nandima makabo yango.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "EXO 28:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okotongela Aron nzambala ya lino mpe kitendi ya lino mpo na moto ; okosalela ye mpe mokaba oyo bato oyo batongaka bililingi na bilamba bakoyeba kotia bililingi.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "EXO 28:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okosala lisusu mpo na bana ya Aron banzambala, mikaba mpe bikoti, lokola elembo ya lokumu mpe ya nkembo.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "EXO 28:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sima na kolatisa Aron, ndeko na yo ya mobali, elongo na bana na ye ya mibali, okopakola bango mafuta mpe okobulisa bango. Okokomisa bango Banganga-Nzambe mpo ete basalela Ngai.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "EXO 28:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okosalela bango bakaputula ya lino mpo na kozipa bolumbu na bango : bakaputula yango ekobanda na loketo kino na mipende.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "EXO 28:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aron mpe bana na ye ya mibali bakolata yango tango nyonso bakobanda kokota na Ndako ya kapo ya Bokutani to kopusana pembeni ya etumbelo mpo na kosala mosala kati na Esika ya bule, mpo ete bazala na ngambo te mpe bakufa te.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "EXO 28:43"
      },
      "items": [
        {
          "text": "Ezali mobeko ya libela mpo na Aron mpe bakitani na ye.",
          "type": "text"
        }
      ]
    }
