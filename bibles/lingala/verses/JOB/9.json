  "verseCount": 35,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "9",
        "style": "c",
        "sid": "JOB 9"
      },
      "items": [
        {
          "text": "9",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Eyano ya Yobo epai ya Bilidadi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yobo azongisaki :",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.1",
            "verseOrgIds": [
              "JOB.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "« Ezali ya solo, ezali penza ndenge osili koloba,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.2",
            "verseOrgIds": [
              "JOB.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:2"
      },
      "items": [
        {
          "text": "mpe nayebi yango malamu !",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.2",
            "verseOrgIds": [
              "JOB.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOB 9:2"
      },
      "items": [
        {
          "text": "Kasi ndenge nini moto oyo asalema na putulu",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.2",
            "verseOrgIds": [
              "JOB.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:2"
      },
      "items": [
        {
          "text": "akoki kozala sembo liboso ya Nzambe ?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.2",
            "verseOrgIds": [
              "JOB.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ata, na mbala nkoto moko,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.3",
            "verseOrgIds": [
              "JOB.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:3"
      },
      "items": [
        {
          "text": "ameki kobeta tembe na Nzambe,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.3",
            "verseOrgIds": [
              "JOB.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:3"
      },
      "items": [
        {
          "text": "akotikala kokoka kolonga ata mbala moko te.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.3",
            "verseOrgIds": [
              "JOB.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanya ya Nzambe ezali na bozindo makasi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.4",
            "verseOrgIds": [
              "JOB.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:4"
      },
      "items": [
        {
          "text": "mpe nguya na Ye ezali monene ;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.4",
            "verseOrgIds": [
              "JOB.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:4"
      },
      "items": [
        {
          "text": "nani asila kotelemela Ye, bongo amona bolamu ?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.4",
            "verseOrgIds": [
              "JOB.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alongolaka bangomba na bisika na yango,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.5",
            "verseOrgIds": [
              "JOB.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:5"
      },
      "items": [
        {
          "text": "wana yango moko eyebaka te,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.5",
            "verseOrgIds": [
              "JOB.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:5"
      },
      "items": [
        {
          "text": "mpe, kati na kanda na Ye, akweyisaka yango ;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.5",
            "verseOrgIds": [
              "JOB.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "aningisaka mabele wuta na esika na yango",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.6",
            "verseOrgIds": [
              "JOB.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:6"
      },
      "items": [
        {
          "text": "mpe alengisaka makonzi na yango ;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.6",
            "verseOrgIds": [
              "JOB.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "apesaka mitindo na moyi, mpe moyi ebimaka te ;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.7",
            "verseOrgIds": [
              "JOB.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:7"
      },
      "items": [
        {
          "text": "atiaka kashe na minzoto.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.7",
            "verseOrgIds": [
              "JOB.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atandaki Ye moko Likolo",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.8",
            "verseOrgIds": [
              "JOB.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:8"
      },
      "items": [
        {
          "text": "mpe atambolaka likolo ya mbonge ya ebale ;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.8",
            "verseOrgIds": [
              "JOB.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "akelaki bangombolo minene,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.9",
            "verseOrgIds": [
              "JOB.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:9"
      },
      "items": [
        {
          "text": "orioni, masanga ya minzoto mpe minzoto ya sude ;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.9",
            "verseOrgIds": [
              "JOB.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "asalaka makambo minene",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.10",
            "verseOrgIds": [
              "JOB.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:10"
      },
      "items": [
        {
          "text": "oyo elekelaka mayele ya bato,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.10",
            "verseOrgIds": [
              "JOB.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:10"
      },
      "items": [
        {
          "text": "bikamwa ya somo oyo bakokaka kotanga te.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.10",
            "verseOrgIds": [
              "JOB.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Soki aleki pene na ngai, nakokoka te komona Ye ;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.11",
            "verseOrgIds": [
              "JOB.9.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:11"
      },
      "items": [
        {
          "text": "soki mpe akei, nakokoka te komona Ye.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.11",
            "verseOrgIds": [
              "JOB.9.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Soki azwi eloko, nani akoki kobotola Ye yango ?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.12",
            "verseOrgIds": [
              "JOB.9.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:12"
      },
      "items": [
        {
          "text": "Nani akoki koloba na Ye : ‹ Ozali kosala nini ? ›",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.12",
            "verseOrgIds": [
              "JOB.9.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzambe azongisaka kanda na Ye sima te ;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.13",
            "verseOrgIds": [
              "JOB.9.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:13"
      },
      "items": [
        {
          "text": "liboso na Ye, ezala bato ya lolendo balengaka.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.13",
            "verseOrgIds": [
              "JOB.9.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bongo, ngai, nakokoka ndenge nini kobeta tembe na Ye ?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.14",
            "verseOrgIds": [
              "JOB.9.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:14"
      },
      "items": [
        {
          "text": "Nakolonga ndenge nini kopona",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.14",
            "verseOrgIds": [
              "JOB.9.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:14"
      },
      "items": [
        {
          "text": "maloba ya komekana na Ye ?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.14",
            "verseOrgIds": [
              "JOB.9.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezala soki nazalaki moto ya sembo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.15",
            "verseOrgIds": [
              "JOB.9.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:15"
      },
      "items": [
        {
          "text": "nalingaki na ngai kokoka te kopesa Ye eyano ;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.15",
            "verseOrgIds": [
              "JOB.9.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOB 9:15"
      },
      "items": [
        {
          "text": "nalingaki kokoka nde kaka kosenga",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.15",
            "verseOrgIds": [
              "JOB.9.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:15"
      },
      "items": [
        {
          "text": "mawa ya Mosambisi na ngai.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.15",
            "verseOrgIds": [
              "JOB.9.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ata nabelelaki Ye, mpe ayanoli ngai,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.16",
            "verseOrgIds": [
              "JOB.9.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:16"
      },
      "items": [
        {
