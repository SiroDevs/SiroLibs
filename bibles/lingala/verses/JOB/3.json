{
  "id": "JOB.3",
  "number": "3",
  "bookId": "JOB",
  "reference": "Yobo 3",
  "copyright": "Biblica® Salela na bonsomi Mokanda na Bomoi™ Makomi na se ya bokonzi © 2002, 2020 Biblica, Inc. Biblica® Open Lingala Contemporary Bible™ Copyright © 2002, 2020 by Biblica, Inc.",
  "verseCount": 26,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "3",
        "style": "c",
        "sid": "JOB 3"
      },
      "items": [
        {
          "text": "3",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "ms1"
      },
      "items": [
        {
          "text": "Maloba ya Yobo mpe ya balingami na ye misato",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yobo alakeli mokolo ya mbotama na ye mabe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sima na yango, Yobo afungolaki monoko na ye mpe alakelaki mokolo ya mbotama na ye mabe.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.1",
            "verseOrgIds": [
              "JOB.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yobo alobaki :",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.2",
            "verseOrgIds": [
              "JOB.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "« Tika ete mokolo ya mbotama na ngai,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.3",
            "verseOrgIds": [
              "JOB.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 3:3"
      },
      "items": [
        {
          "text": "mpe butu oyo elobaki :",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.3",
            "verseOrgIds": [
              "JOB.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 3:3"
      },
      "items": [
        {
          "text": "‹ Mwana mobali moko abotami, › ekufa !",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.3",
            "verseOrgIds": [
              "JOB.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tika ete mokolo yango ebongwana molili !",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.4",
            "verseOrgIds": [
              "JOB.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 3:4"
      },
      "items": [
        {
          "text": "Tika ete, wuta na likolo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.4",
            "verseOrgIds": [
              "JOB.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 3:4"
      },
      "items": [
        {
          "text": "Nzambe akanisa yango lisusu te !",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.4",
            "verseOrgIds": [
              "JOB.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOB 3:4"
      },
      "items": [
        {
          "text": "Tika ete pole engengela yango lisusu te !",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.4",
            "verseOrgIds": [
              "JOB.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tika ete molili mpe elilingi ya kufa ezingela yango !",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.5",
            "verseOrgIds": [
              "JOB.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 3:5"
      },
      "items": [
        {
          "text": "Tika ete lipata ezipa yango,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.5",
            "verseOrgIds": [
              "JOB.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 3:5"
      },
      "items": [
        {
          "text": "mpe molili ebangisa pole na yango !",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.5",
            "verseOrgIds": [
              "JOB.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tika ete molili makasi ekotela butu yango,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.6",
            "verseOrgIds": [
              "JOB.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 3:6"
      },
      "items": [
        {
          "text": "ete batanga yango lisusu te kati na mikolo ya mibu",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.6",
            "verseOrgIds": [
              "JOB.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 3:6"
      },
      "items": [
        {
          "text": "to kati na mikolo ya basanza !",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.6",
            "verseOrgIds": [
              "JOB.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tika ete butu yango etikala ekomba,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.7",
            "verseOrgIds": [
              "JOB.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 3:7"
      },
      "items": [
        {
          "text": "ete koganga moko te ya esengo eyokana na butu yango !",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.7",
            "verseOrgIds": [
              "JOB.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tika ete bato oyo balakelaka mikolo mabe,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.8",
            "verseOrgIds": [
              "JOB.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 3:8"
      },
      "items": [
        {
          "text": "bato oyo balamusaka bilima minene ya mayi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.8",
            "verseOrgIds": [
              "JOB.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 3:8"
      },
      "items": [
        {
          "text": "balakela yango mabe !",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.8",
            "verseOrgIds": [
              "JOB.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tika ete minzoto ya tongo na yango ekoma molili,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.9",
            "verseOrgIds": [
              "JOB.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 3:9"
      },
      "items": [
        {
          "text": "ezela na pamba tongo oyo ekotana",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.9",
            "verseOrgIds": [
              "JOB.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 3:9"
      },
      "items": [
        {
          "text": "mpe emona kongenga ya tongo te.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.9",
            "verseOrgIds": [
              "JOB.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamba te ekangelaki ngai te",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.10",
            "verseOrgIds": [
              "JOB.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 3:10"
      },
      "items": [
        {
          "text": "bikuke ya libumu ya mama na ngai",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.10",
            "verseOrgIds": [
              "JOB.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 3:10"
      },
      "items": [
        {
          "text": "mpo na kobombela miso na ngai pasi ya boye !",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.10",
            "verseOrgIds": [
              "JOB.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpo na nini namikufelaki te",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.11",
            "verseOrgIds": [
              "JOB.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 3:11"
      },
      "items": [
        {
          "text": "kati na libumu ya mama na ngai ?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.11",
            "verseOrgIds": [
              "JOB.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOB 3:11"
      },
      "items": [
        {
          "text": "Mpo na nini nakataki motema te",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.11",
            "verseOrgIds": [
              "JOB.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 3:11"
      },
      "items": [
        {
          "text": "tango nabimaki na libumu ya mama na ngai ?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.11",
            "verseOrgIds": [
              "JOB.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpo na nini mabolongo eyambaki ngai ?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.12",
            "verseOrgIds": [
              "JOB.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 3:12"
      },
      "items": [
        {
          "text": "Mpo na nini mama amelisaki ngai mabele ?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.12",
            "verseOrgIds": [
              "JOB.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamba te sik'oyo, nalingaki na ngai kolala na kimia,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.13",
            "verseOrgIds": [
              "JOB.3.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 3:13"
      },
      "items": [
        {
          "text": "nalingaki na ngai kokufa mpe kopema",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.13",
            "verseOrgIds": [
              "JOB.3.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "elongo na bakonzi mpe bapesi toli ya mokili,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.14",
            "verseOrgIds": [
              "JOB.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 3:14"
      },
      "items": [
        {
          "text": "oyo bamitongelaki malita na bango kasi lelo ebeba,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.14",
            "verseOrgIds": [
              "JOB.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "elongo na bakambi oyo bazalaki na wolo",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.15",
            "verseOrgIds": [
              "JOB.3.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 3:15"
      },
      "items": [
        {
          "text": "mpe batondisa palata kati na bandako na bango.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.15",
            "verseOrgIds": [
              "JOB.3.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpo na nini babombaki ngai te na se ya mabele",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.16",
            "verseOrgIds": [
              "JOB.3.16"
            ]
          }
        }
      ]
    },
    {
