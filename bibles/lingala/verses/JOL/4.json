  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "JOL 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nzambe akosambisa bikolo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOL 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "« Na mikolo mpe na tango wana,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.4.1",
            "verseOrgIds": [
              "JOL.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 4:1"
      },
      "items": [
        {
          "text": "tango nakozongisa bakangami ya Yuda mpe ya Yelusalemi,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.4.1",
            "verseOrgIds": [
              "JOL.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOL 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "nakosangisa bato ya bikolo nyonso",
          "type": "text",
          "attrs": {
            "verseId": "JOL.4.2",
            "verseOrgIds": [
              "JOL.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 4:2"
      },
      "items": [
        {
          "text": "mpe nakokitisa bango na lubwaku ya Jozafati.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.4.2",
            "verseOrgIds": [
              "JOL.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOL 4:2"
      },
      "items": [
        {
          "text": "Nakosambisa bango kuna",
          "type": "text",
          "attrs": {
            "verseId": "JOL.4.2",
            "verseOrgIds": [
              "JOL.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 4:2"
      },
      "items": [
        {
          "text": "na tina na libula na Ngai, Isalaele, bato na Ngai ;",
          "type": "text",
          "attrs": {
            "verseId": "JOL.4.2",
            "verseOrgIds": [
              "JOL.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOL 4:2"
      },
      "items": [
        {
          "text": "pamba te bapanzi bato na Ngai kati na bikolo",
          "type": "text",
          "attrs": {
            "verseId": "JOL.4.2",
            "verseOrgIds": [
              "JOL.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 4:2"
      },
      "items": [
        {
          "text": "mpe bakaboli mokili na Ngai.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.4.2",
            "verseOrgIds": [
              "JOL.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOL 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babeti zeke mpo na kokabola bato na Ngai,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.4.3",
            "verseOrgIds": [
              "JOL.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 4:3"
      },
      "items": [
        {
          "text": "bapesi bilenge mibali basi ya ndumba,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.4.3",
            "verseOrgIds": [
              "JOL.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOL 4:3"
      },
      "items": [
        {
          "text": "bateki bilenge basi mpo na kozwa kaka vino,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.4.3",
            "verseOrgIds": [
              "JOL.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 4:3"
      },
      "items": [
        {
          "text": "mpe balangwe yango.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.4.3",
            "verseOrgIds": [
              "JOL.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOL 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eh bongo bino, Tiri mpe Sidoni,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.4.4",
            "verseOrgIds": [
              "JOL.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 4:4"
      },
      "items": [
        {
          "text": "bituka ya bato ya Filisitia,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.4.4",
            "verseOrgIds": [
              "JOL.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOL 4:4"
      },
      "items": [
        {
          "text": "likambo nini lisusu kati na Ngai mpe bino ?",
          "type": "text",
          "attrs": {
            "verseId": "JOL.4.4",
            "verseOrgIds": [
              "JOL.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 4:4"
      },
      "items": [
        {
          "text": "Bolingi kozongisela Ngai mabe to kotombokela Ngai ?",
          "type": "text",
          "attrs": {
            "verseId": "JOL.4.4",
            "verseOrgIds": [
              "JOL.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOL 4:4"
      },
      "items": [
        {
          "text": "Soki yango nde ezali makanisi na bino,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.4.4",
            "verseOrgIds": [
              "JOL.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 4:4"
      },
      "items": [
        {
          "text": "Ngai nde nasengeli kozongisela bino mabe na lombangu.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.4.4",
            "verseOrgIds": [
              "JOL.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOL 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamba te bozwaki palata mpe wolo na Ngai,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.4.5",
            "verseOrgIds": [
              "JOL.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 4:5"
      },
      "items": [
        {
          "text": "bomengo na Ngai ya motuya makasi",
          "type": "text",
          "attrs": {
            "verseId": "JOL.4.5",
            "verseOrgIds": [
              "JOL.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 4:5"
      },
      "items": [
        {
          "text": "mpe bomemaki yango na batempelo na bino.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.4.5",
            "verseOrgIds": [
              "JOL.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOL 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Botekaki bato ya Yuda mpe ya Yelusalemi epai ya Bagreki",
          "type": "text",
          "attrs": {
            "verseId": "JOL.4.6",
            "verseOrgIds": [
              "JOL.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 4:6"
      },
      "items": [
        {
          "text": "mpo na komema bango mosika ya mokili na bango.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.4.6",
            "verseOrgIds": [
              "JOL.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOL 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngai moko nakopesa bango makasi",
          "type": "text",
          "attrs": {
            "verseId": "JOL.4.7",
            "verseOrgIds": [
              "JOL.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 4:7"
      },
      "items": [
        {
          "text": "mpo ete babima na bisika nyonso",
          "type": "text",
          "attrs": {
            "verseId": "JOL.4.7",
            "verseOrgIds": [
              "JOL.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 4:7"
      },
      "items": [
        {
          "text": "epai wapi botekaki bango.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.4.7",
            "verseOrgIds": [
              "JOL.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOL 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakoteka bana na bino ya mibali mpe ya basi",
          "type": "text",
          "attrs": {
            "verseId": "JOL.4.8",
            "verseOrgIds": [
              "JOL.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 4:8"
      },
      "items": [
        {
          "text": "epai ya bato ya Yuda,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.4.8",
            "verseOrgIds": [
              "JOL.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOL 4:8"
      },
      "items": [
        {
          "text": "mpe bango bakoteka bango epai ya bato ya Sabe,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.4.8",
            "verseOrgIds": [
              "JOL.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 4:8"
      },
      "items": [
        {
          "text": "ekolo ya mosika penza, »",
          "type": "text",
          "attrs": {
            "verseId": "JOL.4.8",
            "verseOrgIds": [
              "JOL.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 4:8"
      },
      "items": [
        {
          "text": "elobi Yawe.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.4.8",
            "verseOrgIds": [
              "JOL.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Etumbu mpe kosambisama",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOL 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "« Bosakola likambo oyo kati na bikolo :",
          "type": "text",
          "attrs": {
            "verseId": "JOL.4.9",
            "verseOrgIds": [
              "JOL.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 4:9"
      },
      "items": [
        {
          "text": "Bobulisa mampinga mpo na bitumba !",
          "type": "text",
          "attrs": {
            "verseId": "JOL.4.9",
            "verseOrgIds": [
              "JOL.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOL 4:9"
      },
      "items": [
        {
          "text": "Bolamusa bilombe !",
          "type": "text",
          "attrs": {
            "verseId": "JOL.4.9",
            "verseOrgIds": [
              "JOL.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 4:9"
      },
      "items": [
        {
          "text": "Tika ete bilombe nyonso ya bitumba bapusana mpe baya !",
          "type": "text",
          "attrs": {
            "verseId": "JOL.4.9",
            "verseOrgIds": [
              "JOL.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOL 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bosala mipanga, na nzela ya bakongo na bino ;",
          "type": "text",
          "attrs": {
            "verseId": "JOL.4.10",
            "verseOrgIds": [
              "JOL.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 4:10"
      },
      "items": [
        {
          "text": "mpe makonga, na nzela ya bipasola na bino !",
          "type": "text",
          "attrs": {
            "verseId": "JOL.4.10",
            "verseOrgIds": [
              "JOL.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOL 4:10"
      },
      "items": [
        {
          "text": "Tika ete moto na bolembu aloba :",
          "type": "text",
          "attrs": {
            "verseId": "JOL.4.10",
            "verseOrgIds": [
              "JOL.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 4:10"
      },
      "items": [
        {
          "text": "‹ Nazali makasi. ›",
          "type": "text",
          "attrs": {
            "verseId": "JOL.4.10",
            "verseOrgIds": [
              "JOL.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOL 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bino bikolo nyonso ya zingazinga,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.4.11",
            "verseOrgIds": [
              "JOL.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 4:11"
      },
      "items": [
        {
          "text": "boya na lombangu mpe bosangana !",
          "type": "text",
          "attrs": {
            "verseId": "JOL.4.11",
            "verseOrgIds": [
              "JOL.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "JOL 4:11"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOL 4:11"
      },
      "items": [
        {
          "text": "Oh Yawe, kitisa bilombe na Yo !",
          "type": "text",
          "attrs": {
