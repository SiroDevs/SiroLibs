  "verseCount": 20,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "JOL 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mampinga ya mabanki",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOL 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tala liloba oyo Yawe alobaki na nzela ya Joeli, mwana mobali ya Petueli :",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.1",
            "verseOrgIds": [
              "JOL.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOL 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "— Bino bakambi ya bato, boyoka liloba oyo ;",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.2",
            "verseOrgIds": [
              "JOL.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 1:2"
      },
      "items": [
        {
          "text": "bino nyonso, bavandi ya mokili,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.2",
            "verseOrgIds": [
              "JOL.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOL 1:2"
      },
      "items": [
        {
          "text": "botia matoyi mpe boyoka !",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.2",
            "verseOrgIds": [
              "JOL.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 1:2"
      },
      "items": [
        {
          "text": "Boni, likambo ya boye esila kosalema",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.2",
            "verseOrgIds": [
              "JOL.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 1:2"
      },
      "items": [
        {
          "text": "na tango na bino to mpe na tango ya bakoko na bino ?",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.2",
            "verseOrgIds": [
              "JOL.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOL 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boyebisa yango epai ya bana na bino,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.3",
            "verseOrgIds": [
              "JOL.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 1:3"
      },
      "items": [
        {
          "text": "mpe tika ete bana na bino bayebisa yango",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.3",
            "verseOrgIds": [
              "JOL.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOL 1:3"
      },
      "items": [
        {
          "text": "epai ya bana na bango ;",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.3",
            "verseOrgIds": [
              "JOL.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 1:3"
      },
      "items": [
        {
          "text": "mpe bana na bango, na milongo ya bato",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.3",
            "verseOrgIds": [
              "JOL.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 1:3"
      },
      "items": [
        {
          "text": "oyo bakoya na sima.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.3",
            "verseOrgIds": [
              "JOL.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOL 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Matiti oyo mampinga ya mabanki etiki,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.4",
            "verseOrgIds": [
              "JOL.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 1:4"
      },
      "items": [
        {
          "text": "mabanki minene elie yango ;",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.4",
            "verseOrgIds": [
              "JOL.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOL 1:4"
      },
      "items": [
        {
          "text": "oyo mabanki minene etiki,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.4",
            "verseOrgIds": [
              "JOL.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 1:4"
      },
      "items": [
        {
          "text": "mabanki mike elie yango ;",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.4",
            "verseOrgIds": [
              "JOL.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOL 1:4"
      },
      "items": [
        {
          "text": "oyo mabanki mike etiki,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.4",
            "verseOrgIds": [
              "JOL.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 1:4"
      },
      "items": [
        {
          "text": "mabanki mosusu elie yango.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.4",
            "verseOrgIds": [
              "JOL.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOL 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bino balangwi masanga, bolamuka mpe bolela ;",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.5",
            "verseOrgIds": [
              "JOL.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 1:5"
      },
      "items": [
        {
          "text": "bolela, bino nyonso bameli vino.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.5",
            "verseOrgIds": [
              "JOL.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 1:5"
      },
      "items": [
        {
          "text": "Pamba te babotoli bino vino ya sika na bibebu.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.5",
            "verseOrgIds": [
              "JOL.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOL 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekolo moko ya bapaya ebundisi mokili na Ngai,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.6",
            "verseOrgIds": [
              "JOL.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 1:6"
      },
      "items": [
        {
          "text": "ezali na nguya makasi mpe bakokoka te kotanga",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.6",
            "verseOrgIds": [
              "JOL.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOL 1:6"
      },
      "items": [
        {
          "text": "motango ya bato na yango.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.6",
            "verseOrgIds": [
              "JOL.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 1:6"
      },
      "items": [
        {
          "text": "Minu na yango ezali lokola minu ya nkosi ya mobali,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.6",
            "verseOrgIds": [
              "JOL.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 1:6"
      },
      "items": [
        {
          "text": "mpe mbanga na yango, lokola mbanga ya nkosi ya mwasi.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.6",
            "verseOrgIds": [
              "JOL.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOL 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekolo yango ekomisi elanga na Ngai ya vino",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.7",
            "verseOrgIds": [
              "JOL.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 1:7"
      },
      "items": [
        {
          "text": "lokola esobe mpe ekati-kati banzete na Ngai ya figi,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.7",
            "verseOrgIds": [
              "JOL.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOL 1:7"
      },
      "items": [
        {
          "text": "elongoli banzete na Ngai nyonso baposo,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.7",
            "verseOrgIds": [
              "JOL.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 1:7"
      },
      "items": [
        {
          "text": "ebwaki yango mpe etiki bitape na yango pembe.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.7",
            "verseOrgIds": [
              "JOL.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOL 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bosala matanga lokola elenge mwasi oyo alati pili",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.8",
            "verseOrgIds": [
              "JOL.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 1:8"
      },
      "items": [
        {
          "text": "mpo na kolela mobandami na ye.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.8",
            "verseOrgIds": [
              "JOL.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOL 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makabo ya bambuma mpe ya masanga",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.9",
            "verseOrgIds": [
              "JOL.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 1:9"
      },
      "items": [
        {
          "text": "ezali kopesama lisusu te na Tempelo ya Yawe.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.9",
            "verseOrgIds": [
              "JOL.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 1:9"
      },
      "items": [
        {
          "text": "Banganga-Nzambe, basali ya Nkolo, bazali na matanga.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.9",
            "verseOrgIds": [
              "JOL.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOL 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bilanga ebebisami, mabele ekawuki,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.10",
            "verseOrgIds": [
              "JOL.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 1:10"
      },
      "items": [
        {
          "text": "mbuma ya ble ezali lisusu te,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.10",
            "verseOrgIds": [
              "JOL.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 1:10"
      },
      "items": [
        {
          "text": "vino esili mpe mafuta ezali lisusu te.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.10",
            "verseOrgIds": [
              "JOL.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOL 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bino basali bilanga, bozala na soni ;",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.11",
            "verseOrgIds": [
              "JOL.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 1:11"
      },
      "items": [
        {
          "text": "bino baloni vino, bolela mpo na mbuma ya ble mpe ya orje,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.11",
            "verseOrgIds": [
              "JOL.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 1:11"
      },
      "items": [
        {
          "text": "pamba te milona ebebisami.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.11",
            "verseOrgIds": [
              "JOL.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOL 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bilanga ya vino ekawuki,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.12",
            "verseOrgIds": [
              "JOL.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 1:12"
      },
      "items": [
        {
          "text": "banzete ya figi elembi-lembi,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.12",
            "verseOrgIds": [
              "JOL.1.12"
            ]
          }
        }
      ]
    },
    {
