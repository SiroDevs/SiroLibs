              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bongo, mokonzi Dariusi akomelaki bato ya bikolo nyonso mpe ya nkota nyonso oyo bazalaki kovanda na mokili mobimba :",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.26",
            "verseOrgIds": [
              "DAN.6.26"
            ]
          }
        }
      ]
    },
