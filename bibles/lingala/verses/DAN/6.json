      "type": "tag",
      "attrs": {
        "style": "pmo",
        "vid": "DAN 6:26"
      },
      "items": [
        {
          "text": "Natombeli bino kimia monene !",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.26",
            "verseOrgIds": [
              "DAN.6.26"
            ]
          }
        }
