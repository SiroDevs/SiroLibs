          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Napesi mitindo ete, na bituka nyonso ya mokili na ngai, bato nyonso batosa mpe bapesa Nzambe ya Daniele lokumu.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.27",
            "verseOrgIds": [
              "DAN.6.27"
            ]
          }
        }
      ]
    },
