      "type": "tag",
      "attrs": {
        "style": "qm1",
        "vid": "DAN 6:27"
      },
      "items": [
        {
          "text": "Pamba te azali Nzambe na bomoi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm2",
        "vid": "DAN 6:27"
      },
      "items": [
        {
          "text": "mpe ya seko na seko ;",
          "type": "text"
