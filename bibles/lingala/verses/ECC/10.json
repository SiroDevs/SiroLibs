      },
      "items": [
        {
          "text": "10",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ECC 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndenge nzinzi ekufa ekomisaka malasi solo mabe,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.1",
            "verseOrgIds": [
              "ECC.10.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 10:1"
      },
      "items": [
        {
          "text": "ndenge wana mpe mwa bozoba ebebisaka",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.1",
            "verseOrgIds": [
              "ECC.10.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 10:1"
      },
      "items": [
        {
          "text": "bwanya mpe lokumu.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.1",
            "verseOrgIds": [
              "ECC.10.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ECC 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Motema ya moto ya bwanya ekendaka",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.2",
            "verseOrgIds": [
              "ECC.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 10:2"
      },
      "items": [
        {
          "text": "na nzela ya malamu,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.2",
            "verseOrgIds": [
              "ECC.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 10:2"
      },
      "items": [
        {
          "text": "kasi motema ya zoba ekendaka na nzela ya mabe.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.2",
            "verseOrgIds": [
              "ECC.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ECC 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ata tango zoba atambolaka na nzela,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.3",
            "verseOrgIds": [
              "ECC.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 10:3"
      },
      "items": [
        {
          "text": "bozangi mayele na ye etalisaka",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.3",
            "verseOrgIds": [
              "ECC.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 10:3"
      },
      "items": [
        {
          "text": "na bato mosusu ete azali zoba.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.3",
            "verseOrgIds": [
              "ECC.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ECC 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Soki mokonzi atombokeli yo,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.4",
            "verseOrgIds": [
              "ECC.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 10:4"
      },
      "items": [
        {
          "text": "kolongwa na esika na yo ya mosala te ;",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.4",
            "verseOrgIds": [
              "ECC.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 10:4"
      },
      "items": [
        {
          "text": "pamba te motema ya kokita epekisaka bambeba minene.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.4",
            "verseOrgIds": [
              "ECC.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ECC 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namonaki mabe moko na se ya moyi,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.5",
            "verseOrgIds": [
              "ECC.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 10:5"
      },
      "items": [
        {
          "text": "lokola libunga epai ya bakonzi :",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.5",
            "verseOrgIds": [
              "ECC.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ECC 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "bazoba batombolami na bisika ya lokumu makasi,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.6",
            "verseOrgIds": [
              "ECC.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 10:6"
      },
      "items": [
        {
          "text": "kasi bazwi batikali na bisika ya se.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.6",
            "verseOrgIds": [
              "ECC.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ECC 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namonaki bawumbu kotambola likolo ya bampunda,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.7",
            "verseOrgIds": [
              "ECC.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 10:7"
      },
      "items": [
        {
          "text": "mpe bakonzi kotambola na makolo lokola bawumbu.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.7",
            "verseOrgIds": [
              "ECC.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ECC 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moto oyo atimoli libulu akoki kokweya",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.8",
            "verseOrgIds": [
              "ECC.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 10:8"
      },
      "items": [
        {
          "text": "kati na yango ;",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.8",
            "verseOrgIds": [
              "ECC.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 10:8"
      },
      "items": [
        {
          "text": "mpe moto oyo abuki mir ya lopango,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.8",
            "verseOrgIds": [
              "ECC.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 10:8"
      },
      "items": [
        {
          "text": "nyoka ekoki koswa ye.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.8",
            "verseOrgIds": [
              "ECC.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ECC 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moto oyo abukaka mabanga akoki kozoka na yango,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.9",
            "verseOrgIds": [
              "ECC.10.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 10:9"
      },
      "items": [
        {
          "text": "oyo apasolaka mabaya akoki mpe kozwa likama.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.9",
            "verseOrgIds": [
              "ECC.10.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ECC 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Soki epasola esili minu mpe bapelisi yango te,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.10",
            "verseOrgIds": [
              "ECC.10.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 10:10"
      },
      "items": [
        {
          "text": "moto oyo akosalela yango akobimisa makasi mingi ;",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.10",
            "verseOrgIds": [
              "ECC.10.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 10:10"
      },
      "items": [
        {
          "text": "kasi bwanya epesaka elonga.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.10",
            "verseOrgIds": [
              "ECC.10.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ECC 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Soki nyoka eswi moto liboso ete asakanisa yango,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.11",
            "verseOrgIds": [
              "ECC.10.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 10:11"
      },
      "items": [
        {
          "text": "litomba ezali lisusu te epai ya moto",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.11",
            "verseOrgIds": [
              "ECC.10.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 10:11"
      },
      "items": [
        {
          "text": "oyo asakanisaka banyoka.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.11",
            "verseOrgIds": [
              "ECC.10.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ECC 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maloba ya moto ya bwanya epesaka esengo,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.12",
            "verseOrgIds": [
              "ECC.10.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 10:12"
      },
      "items": [
        {
          "text": "kasi maloba ya zoba elukelaka ye makambo.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.12",
            "verseOrgIds": [
              "ECC.10.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ECC 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abandaka na maloba ya bozoba",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.13",
            "verseOrgIds": [
              "ECC.10.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 10:13"
      },
      "items": [
        {
          "text": "mpe asukisaka na maloba ya mabe.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.13",
            "verseOrgIds": [
              "ECC.10.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ECC 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zoba alobaka mingi.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.14",
            "verseOrgIds": [
              "ECC.10.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "ECC 10:14"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 10:14"
      },
      "items": [
        {
          "text": "Moto moko te ayebi makambo oyo ekoya ;",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.14",
            "verseOrgIds": [
              "ECC.10.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 10:14"
      },
      "items": [
        {
          "text": "nani akoki koyebisa ye makambo",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.14",
            "verseOrgIds": [
              "ECC.10.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 10:14"
      },
      "items": [
        {
          "text": "oyo ekosalema sima na ye ?",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.14",
            "verseOrgIds": [
              "ECC.10.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
