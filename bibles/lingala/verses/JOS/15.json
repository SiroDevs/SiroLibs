          },
          "items": [
            {
              "text": "60",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiriati-Bala oyo bazalaki mpe kobenga Kiriati-Yearimi, mpe Raba : bingumba nyonso ezalaki mibale elongo na bamboka na yango ya mike-mike.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.60",
            "verseOrgIds": [
