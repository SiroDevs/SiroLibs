          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Keila, Akizibi mpe Maresha : bingumba nyonso ezalaki libwa elongo na bamboka na yango ya mike-mike.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.44",
            "verseOrgIds": [
