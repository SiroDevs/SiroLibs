          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yifita, Ashina, Netsibi,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.43",
            "verseOrgIds": [
              "JOS.15.43"
            ]
          }
