          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Engumba ya Ekroni elongo na bamboka na yango mpe bamboka na yango ya mike-mike oyo ezingelaki yango,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.45",
            "verseOrgIds": [
              "JOS.15.45"
            ]
