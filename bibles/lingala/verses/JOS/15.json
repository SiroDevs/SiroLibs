          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zanoa, Eyini-Ganimi, Tapua, Enami,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.34",
            "verseOrgIds": [
              "JOS.15.34"
            ]
          }
        },
        {
