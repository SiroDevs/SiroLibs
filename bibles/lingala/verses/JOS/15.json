          "items": [
            {
              "text": "59",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maarati, Beti-Anoti mpe Elitekoni : bingumba nyonso ezalaki motoba elongo na bamboka na yango ya mike-mike.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.59",
            "verseOrgIds": [
              "JOS.15.59"
            ]
          }
