{
  "id": "JOS.15",
  "number": "15",
  "bookId": "JOS",
  "reference": "Jozue 15",
  "copyright": "Biblica® Salela na bonsomi Mokanda na Bomoi™ Makomi na se ya bokonzi © 2002, 2020 Biblica, Inc. Biblica® Open Lingala Contemporary Bible™ Copyright © 2002, 2020 by Biblica, Inc.",
  "verseCount": 63,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "15",
        "style": "c",
        "sid": "JOS 15"
      },
      "items": [
        {
          "text": "15",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Eteni ya mabele ya libota ya Yuda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eteni ya mabele ya bato ya libota ya Yuda, kolanda bituka na bango, ezalaki na ngambo ya sude, wuta na bandelo ya Edomi kino na esobe ya Tsini, na suka penza ya sude.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mondelo na yango ya sude ebandaki na suka ya ebale monene ya Barozo, longwa na eteni ya mabele oyo ekota kati na ebale monene oyo etalana na Negevi,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.2",
            "verseOrgIds": [
              "JOS.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "emataki kino na ngambo ya sude ya Akarabimi mpe elekaki na Tsini, sima emataki na ngambo ya sude ya Kadeshi-Barinea mpe ekitaki na Etsironi ; emataki na ngambo ya Adari mpe ebalukaki na ngambo ya Karika.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.3",
            "verseOrgIds": [
              "JOS.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elekaki na Atsimoni, ekendeki kotutana na moluka ya Ejipito mpe esukaki na Ebale monene. Yango nde ezali mondelo na bango na ngambo ya sude.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.4",
            "verseOrgIds": [
              "JOS.15.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ngambo ya este, mondelo ezalaki ebale monene ya Barozo kino na suka ya Yordani.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.5",
            "verseOrgIds": [
              "JOS.15.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "JOS 15:5"
      },
      "items": [
        {
          "text": "Na ngambo ya nor, ezalaki longwa na eteni ya mabele oyo ekota kati na ebale kino na suka ya Yordani.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.5",
            "verseOrgIds": [
              "JOS.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mondelo emataki na Beti-Ogila, elekaki na ngambo ya nor ya Beti-Araba mpe emataki kino na Libanga ya Boani, mwana mobali ya Ribeni.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.6",
            "verseOrgIds": [
              "JOS.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mondelo yango emataki kino na Debiri, longwa na Lubwaku ya Akori, mpe ebalukaki na ngambo ya nor kino na Giligali oyo etalana na nzela oyo emata na Adumimi, na ngambo ya sude ya moluka. Elekaki pene ya mayi ya Eyini-Shemeshi mpe ekendeki kosuka na Eyini-Rogeli.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.7",
            "verseOrgIds": [
              "JOS.15.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bongo mondelo yango emataki na nzela ya Lubwaku ya Beni-Inomi, pene ya mopanzi ya sude ya engumba ya bato ya Yebusi (oyo ezali Yelusalemi). Longwa na esika yango, emataki kino na songe ya ngomba oyo ezali na weste ya Lubwaku ya Inomi, na suka ya ngambo ya nor ya Lubwaku ya Refayimi.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.8",
            "verseOrgIds": [
              "JOS.15.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Longwa na songe ya ngomba, mondelo yango ekatisaki kino na etima ya mayi ya Nefitoa, ebimaki na bingumba ya ngomba Efroni mpe ekitaki na ngambo ya Baala (oyo ezali Kiriati-Yearimi).",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.9",
            "verseOrgIds": [
              "JOS.15.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Longwa na Baala, mondelo yango ekatisaki na ngambo ya weste, pene ya ngomba Seiri ; elekaki na mopanzi ya ngomba ya bazamba, na ngambo ya nor (oyo ezali ngomba Kesaloni) ; ekobaki kokita kino na Beti-Shemeshi mpe ekatisaki kino na Timina.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.10",
            "verseOrgIds": [
              "JOS.15.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mondelo yango ekendeki na mopanzi ya ngambo ya nor ya Ekroni, ebalukaki na Shikeroni, elekaki pene ya ngomba Baala ; ekendeki kino na Yabineyeli mpe esukaki na ebale monene.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.11",
            "verseOrgIds": [
              "JOS.15.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mondelo ya ngambo ya weste elekaki pembeni-pembeni ya ebale monene Mediterane.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.12",
            "verseOrgIds": [
              "JOS.15.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "JOS 15:12"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4",
        "vid": "JOS 15:12"
      },
      "items": [
        {
          "text": "Yango nde ezalaki, na bangambo nyonso, eteni ya mabele ya bato ya libota ya Yuda kolanda bituka na bango.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Eteni ya mabele ya Kalebi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kolanda mitindo oyo Yawe apesaki ye, Jozue apesaki Kalebi, mwana mobali ya Yefune, eteni ya mabele : Kiriati-Ariba (oyo ezali Ebron), kati na libota ya bato ya Yuda. (Ariba azalaki tata ya Anaki).",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.13",
            "verseOrgIds": [
              "JOS.15.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kalebi abenganaki, wuta na Ebron, bakitani misato ya Anaki : Sheshayi, Ayimani mpe Talimayi.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.14",
            "verseOrgIds": [
              "JOS.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Longwa wana, akendeki kobundisa bavandi ya Debiri oyo kombo na yango ezalaki na kala « Kiriati-Seferi. »",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.15",
            "verseOrgIds": [
              "JOS.15.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kalebi alobaki : « Nakopesa na libala Akisa, mwana na ngai ya mwasi, epai ya moto nyonso oyo akobundisa mpe akobotola Kiriati-Seferi. »",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.16",
            "verseOrgIds": [
              "JOS.15.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otinieli, mwana mobali ya Kenazi, ndeko mobali ya Kalebi, abotolaki yango ; boye Kalebi apesaki Akisa, mwana na ye ya mwasi, na libala epai ya Otinieli.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.17",
            "verseOrgIds": [
              "JOS.15.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOS 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzokande, tango Akisa akomaki na ndako ya Otinieli, atindikaki ye ete asenga elanga epai ya Kalebi, tata na ye. Boye, tango Akisa akitaki wuta na ane na ye, Kalebi atunaki ye :",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.18",
            "verseOrgIds": [
              "JOS.15.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "JOS 15:18"
      },
      "items": [
        {
          "text": "— Olingi nini ?",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOS 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akisa azongisaki :",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.19",
            "verseOrgIds": [
              "JOS.15.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "JOS 15:19"
      },
      "items": [
        {
          "text": "— Salela ngai ngolu. Lokola opesaki ngai eteni ya mabele kati na Negevi, pesa ngai lisusu bitima.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JOS 15:19"
      },
      "items": [
        {
          "text": "Boye, Kalebi apesaki ye bitima ya likolo mpe ya se.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.19",
            "verseOrgIds": [
              "JOS.15.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bingumba ya bato ya libota ya Yuda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOS 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yango nde ezalaki eteni ya mabele oyo bato ya libota ya Yuda bazwaki lokola libula, kolanda mabota na bango.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOS 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tala bingumba oyo ezalaki na suka ya eteni ya mabele ya bato ya libota ya Yuda, na ngambo ya mondelo ya Edomi, na Negevi :",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "JOS 15:21"
      },
      "items": [
        {
          "text": "Kabiseyeli, Ederi, Yaguri,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.21",
            "verseOrgIds": [
              "JOS.15.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOS 15:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kina, Dimona, Adada,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.22",
            "verseOrgIds": [
              "JOS.15.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOS 15:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kedeshi, Atsori, Itinani,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.23",
            "verseOrgIds": [
              "JOS.15.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOS 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zifi, Telemi, Bealoti,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.24",
            "verseOrgIds": [
              "JOS.15.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOS 15:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atsori-Adata, Kerioti-Etsironi oyo bazalaki mpe kobenga Atsori,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.25",
            "verseOrgIds": [
              "JOS.15.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOS 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amami, Shema, Molada,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.26",
            "verseOrgIds": [
              "JOS.15.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JOS 15:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atsari-Gada, Eshimoni, Beti-Paleti,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.27",
            "verseOrgIds": [
              "JOS.15.27"
            ]
          }
        },
        {
          "name": "verse",
