      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "JOS 15:33"
      },
      "items": [
        {
          "text": "Eshitaoli, Tsorea, Ashina,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.33",
            "verseOrgIds": [
              "JOS.15.33"
            ]
