          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gederoti, Beti-Dagoni, Naama mpe Makeda : bingumba nyonso ezalaki zomi na motoba elongo na bamboka na yango ya mike-mike.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.41",
            "verseOrgIds": [
              "JOS.15.41"
            ]
          }
        }
      ]
