          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gosheni, Oloni mpe Gilo : bingumba nyonso ezalaki zomi na moko elongo na bamboka na yango ya mike-mike.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.51",
            "verseOrgIds": [
              "JOS.15.51"
            ]
          }
        }
