          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "longwa na Ekroni mpe na ngambo ya weste, mabele nyonso oyo ezalaki pene ya Asidodi mpe bamboka na yango ;",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.46",
            "verseOrgIds": [
              "JOS.15.46"
            ]
          }
        },
