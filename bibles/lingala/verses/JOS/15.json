          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JOS 15:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shaarayimi, Aditayimi, Gedera to Gederotayimi : bingumba nyonso ezalaki zomi na minei elongo na bamboka na yango ya mike-mike.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.36",
            "verseOrgIds": [
              "JOS.15.36"
            ]
          }
        }
      ]
    },
