          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bongo babetaki zeke, mpe zeke ekweyaki epai ya Matiasi ; boye Matiasi aponamaki, mpe babakisaki ye na lisanga ya bantoma zomi na moko.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.26",
