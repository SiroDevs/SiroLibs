  "verseCount": 43,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "19",
        "style": "c",
        "sid": "2SA 19"
      },
      "items": [
        {
          "text": "19",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Joabu bá Dafidi wí gidigidi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2SA 19:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "A sì rò fún Joabu pe, \"Wò ó, ọba ń sọkún, ó sì ń gbààwẹ̀ fún Absalomu.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.1",
            "verseOrgIds": [
              "2SA.19.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìṣẹ́gun ọjọ́ náà sì di àwẹ̀ fún gbogbo àwọn ènìyàn náà, nítorí àwọn ènìyàn náà gbọ́ ní ọjọ́ náà bí inú ọba ti bàjẹ́ nítorí ọmọ rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.2",
            "verseOrgIds": [
              "2SA.19.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ènìyàn náà sì yọ́ lọ sí ìlú ní ọjọ́ náà gẹ́gẹ́ bí àwọn bí ènìyàn tí a dójútì ṣe máa ń yọ́ lọ nígbà tí wọ́n bá sá lójú ìjà.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.3",
            "verseOrgIds": [
              "2SA.19.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọba sì bo ojú rẹ̀, ọba sì kígbe ní ohùn rara pé, \"Á à! Ọmọ mi Absalomu! Absalomu ọmọ mi, ọmọ mi!\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.4",
            "verseOrgIds": [
              "2SA.19.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joabu sì wọ inú ilé tọ ọba lọ, ó sì wí pé, \"Ìwọ dójúti gbogbo àwọn ìránṣẹ́ rẹ lónìí, àwọn tí ó gba ẹ̀mí rẹ̀ là lónìí, àti ẹ̀mí àwọn ọmọkùnrin rẹ̀, àti ti àwọn ọmọbìnrin rẹ̀, àti àwọn aya rẹ̀, àti ẹ̀mí àwọn obìnrin rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.5",
            "verseOrgIds": [
              "2SA.19.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí pé ìwọ fẹ́ àwọn ọ̀tá rẹ, ìwọ sì kórìíra àwọn ọ̀rẹ́ rẹ. Nítorí tí ìwọ wí lónìí pé, Ìwọ kò náání àwọn ọmọ ọba tàbí àwọn ìránṣẹ́; èmi sì rí lónìí pé, ìbá ṣe pé Absalomu wà láààyè, kí gbogbo wa sì kú lónìí, ǹjẹ́ ìbá dùn mọ́ ọ gidigidi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.6",
            "verseOrgIds": [
              "2SA.19.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sì dìde nísinsin yìí, lọ, kí o sì sọ̀rọ̀ ìtùnú fún àwọn ìránṣẹ́ rẹ, nítorí pé èmi fi",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.7",
            "verseOrgIds": [
              "2SA.19.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2SA.19.7",
                "verseOrgIds": [
                  "2SA.19.8"
                ]
              }
            }
          ]
        },
        {
          "text": "búra, bí ìwọ kò bá lọ, ẹnìkan kì yóò bá ọ dúró ni alẹ́ yìí, èyí ni yóò sì burú fún ọ ju gbogbo ibi tí ojú rẹ ti ń rí láti ìgbà èwe rẹ wá títí ó fi di ìsinsin yìí.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.7",
            "verseOrgIds": [
              "2SA.19.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọba sì dìde, ó sì jókòó ní ẹnu-ọ̀nà, wọ́n sì wí fún gbogbo àwọn ènìyàn náà pé, \"Wò ó, ọba jókòó ní ẹnu-ọ̀nà.\" Gbogbo ènìyàn sì wá sí iwájú ọba.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.8",
            "verseOrgIds": [
              "2SA.19.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 19:8"
      },
      "items": [
        {
          "text": "Nítorí pé, Israẹli ti sá, olúkúlùkù sí àgọ́ rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.8",
            "verseOrgIds": [
              "2SA.19.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Àwọn àgbà mú Dafidi ọba padà",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo àwọn ènìyàn náà sì ń bà ara wọn jà nínú gbogbo ẹ̀yà Israẹli, pé, \"Ọba ti gbà wá là lọ́wọ́ àwọn ọ̀tá wa, ó sì ti gbà wá kúrò lọ́wọ́ àwọn Filistini; òun sì wá sá kúrò ní ìlú nítorí Absalomu.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.9",
            "verseOrgIds": [
              "2SA.19.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Absalomu, tí àwa fi jẹ ọba lórí wa sì kú ní ogun, ǹjẹ́ èéṣe tí ẹ̀yin fi dákẹ́ tí ẹ̀yin kò sì sọ̀rọ̀ kan láti mú ọba padà wá?\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.10",
            "verseOrgIds": [
              "2SA.19.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dafidi ọba sì ránṣẹ́ sí Sadoku, àti sí Abiatari àwọn àlùfáà pé, \"Sọ fún àwọn àgbàgbà Juda, pé, 'Èéṣe tí ẹ̀yin fi kẹ́yìn láti mú ọba padà wá sí ilé rẹ̀? Ọ̀rọ̀ gbogbo Israẹli sì ti dé ọ̀dọ̀ ọba àní ní ilé rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.11",
            "verseOrgIds": [
              "2SA.19.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ̀yin ni ara mi, ẹ̀yin ni egungun mi, àti ẹran-ara mi: èéṣì ti ṣe tí ẹ̀yin fi kẹ́yìn láti mú ọba padà wá.'",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.12",
            "verseOrgIds": [
              "2SA.19.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kí ẹ̀yin sì wí fún Amasa pé, 'Egungun àti ẹran-ara mi kọ́ ni ìwọ jẹ́ bí? Kí Ọlọ́run ó ṣe bẹ́ẹ̀ sí mi àti jù bẹ́ẹ̀ lọ pẹ̀lú, bí ìwọ kò ba ṣe olórí ogun níwájú mi títí, ní ipò Joabu.' \"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.13",
            "verseOrgIds": [
              "2SA.19.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Òun sì yí gbogbo àwọn ọkùnrin Juda lọ́kàn padà àní bí ọkàn ènìyàn kan; wọ́n sì ránṣẹ́ sí ọba, pé, \"Ìwọ padà àti gbogbo àwọn ìránṣẹ́ rẹ.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.14",
            "verseOrgIds": [
              "2SA.19.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọba sì padà, o sì wá sí odò Jordani.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.15",
            "verseOrgIds": [
              "2SA.19.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 19:15"
      },
      "items": [
        {
          "text": "Juda sì wá sí Gilgali láti lọ pàdé ọba, àti láti mú ọba kọjá odò Jordani.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.15",
            "verseOrgIds": [
              "2SA.19.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ọba dáríjì Ṣimei",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣimei ọmọ Gera, ará Benjamini ti Bahurimu, ó yára ó sì bá àwọn ọkùnrin Juda sọ̀kalẹ̀ láti pàdé Dafidi ọba.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.16",
            "verseOrgIds": [
              "2SA.19.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹgbẹ̀rún ọmọkùnrin sì wà lọ́dọ̀ rẹ̀ nínú àwọn ọmọkùnrin Benjamini, Ṣiba ìránṣẹ́ ilé Saulu, àti àwọn ọmọkùnrin rẹ̀ mẹ́ẹ̀ẹ́dógún àti ogún ìránṣẹ́ sì pẹ̀lú rẹ̀; wọ́n sì gòkè odò Jordani ṣáájú ọba.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.17",
            "verseOrgIds": [
              "2SA.19.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọkọ̀ èrò kan ti rékọjá láti kó àwọn ènìyàn ilé ọba sí òkè, àti láti ṣe èyí tí ó tọ́ lójú rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.18",
            "verseOrgIds": [
              "2SA.19.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 19:18"
      },
      "items": [
        {
          "text": "Ṣimei ọmọ Gera wólẹ̀. Ó sì dojúbolẹ̀ níwájú ọba, bí ó tí gòkè odò Jordani.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.18",
            "verseOrgIds": [
              "2SA.19.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 19:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì wí fún ọba pé, \"Kí olúwa mi ó má ṣe ka ẹ̀ṣẹ̀ sí mi lọ́rùn, má sì ṣe rántí àfojúdi tí ìránṣẹ́ rẹ̀ ṣe ni ọjọ́ tí olúwa mi ọba jáde ní Jerusalẹmu, kí ọba má sì fi sí inú.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.19",
            "verseOrgIds": [
              "2SA.19.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 19:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí pé ìránṣẹ́ rẹ mọ̀ pé èmi ti ṣẹ̀; sì wò ó, mo wá lónìí yìí, ẹni àkọ́kọ́ ní gbogbo ìdílé Josẹfu tí yóò sọ̀kalẹ̀ wá pàdé olúwa mi ọba.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.20",
            "verseOrgIds": [
              "2SA.19.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 19:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n Abiṣai ọmọ Seruiah dáhùn ó sì wí pé, \"Kò ha tọ́ kí a pa Ṣimei nítorí èyí? Nítorí pé òun ti bú ẹni àmì òróró",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.21",
            "verseOrgIds": [
              "2SA.19.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2SA.19.21",
                "verseOrgIds": [
                  "2SA.19.22"
                ]
              }
            }
          ]
        },
        {
          "text": ".\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.21",
            "verseOrgIds": [
              "2SA.19.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 19:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dafidi sì wí pé, \"Kí ni èmi ní ṣe pẹ̀lú yín, ẹ̀yin ọmọ Seruiah tí ẹ dàbí ọ̀tá fún mi lónìí? A ha lè pa ènìyàn kan lónìí ní Israẹli? Tàbí èmi kò ha mọ̀ pé lónìí èmi ni ọba Israẹli.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.22",
            "verseOrgIds": [
              "2SA.19.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2SA 19:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọba sì wí fún Ṣimei pé, \"Ìwọ kì yóò kú!\" Ọba sì búra fún un.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.23",
            "verseOrgIds": [
              "2SA.19.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mefiboṣeti ṣe àlàyé fún Dafidi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2SA 19:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mefiboṣeti ọmọ Saulu sì sọ̀kalẹ̀ láti wá pàdé ọba, kò wẹ ẹsẹ̀ rẹ̀, kò sí tọ́ irùngbọ̀n rẹ̀, bẹ́ẹ̀ ni kò sì fọ aṣọ rẹ̀ láti ọjọ́ tí ọba ti jáde títí ó fi di ọjọ́ tí ó fi padà ní àlàáfíà.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.24",
            "verseOrgIds": [
              "2SA.19.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2SA 19:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí òun sì wá sí Jerusalẹmu láti pàdé ọba, ọba sì wí fún un pé, \"Èéṣe tí ìwọ kò fi bá mi lọ, Mefiboṣeti?\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.25",
            "verseOrgIds": [
              "2SA.19.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2SA 19:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Òun sì dáhùn wí pé, \"Olúwa mi, ọba, ìránṣẹ́ mi ni ó tàn mí, nítorí ìránṣẹ́ rẹ wí fún un pé, 'Di kẹ́tẹ́kẹ́tẹ́ ní gàárì fún mi èmi ó gùn ún, èmi ó sì tọ ọba lọ.' Nítorí tí ìránṣẹ́ rẹ yarọ.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.26",
            "verseOrgIds": [
              "2SA.19.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2SA 19:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì sọ̀rọ̀ ìbàjẹ́ sí ìránṣẹ́ rẹ, fún olúwa mi ọba, ṣùgbọ́n bí angẹli Ọlọ́run ni olúwa mi ọba rí, nítorí náà ṣe èyí tí ó dára lójú rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.27",
            "verseOrgIds": [
              "2SA.19.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2SA 19:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí pé gbogbo ilé baba mi bí òkú ènìyàn ni wọ́n sá à rí níwájú olúwa mi ọba, ìwọ sì fi ipò fún ìránṣẹ́ rẹ láàrín àwọn tí ó ń jẹun ní ibi oúnjẹ. Nítorí náà àre kín ni èmi ní tí èmi yóò fi máa ké pe ọba síbẹ̀.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.28",
            "verseOrgIds": [
              "2SA.19.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2SA 19:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọba sì wí fún un pé, \"Èéṣe tí ìwọ fi ń sọ ọ̀ràn ara rẹ fún mi èmi sá à ti wí pé, kí ìwọ àti Ṣiba pín ilẹ̀ náà.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.29",
            "verseOrgIds": [
              "2SA.19.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2SA 19:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mefiboṣeti sì wí fún ọba pé, \"Jẹ́ kí ó mú gbogbo rẹ̀, kí olúwa mi ọba sá à ti padà bọ̀ wá ilé rẹ̀ ni àlàáfíà.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.30",
            "verseOrgIds": [
              "2SA.19.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Dafidi súre fún Barsillai",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2SA 19:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Barsillai ará Gileadi sì sọ̀kalẹ̀ láti Rogelimu wá, ó sì bá ọba gòkè odò Jordani, láti ṣe ìkẹ́ rẹ̀ sí ìkọjá odò Jordani.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.31",
            "verseOrgIds": [
              "2SA.19.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2SA 19:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Barsillai sì jẹ́ arúgbó ọkùnrin gidigidi, ẹni ogbó ọgọ́rin ọdún sì ni, ó sì pèsè ohun jíjẹ fún ọba nígbà tí ó ti wà ní Mahanaimu; nítorí pé ọkùnrin ọlọ́lá ni òun ń ṣe.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.32",
            "verseOrgIds": [
              "2SA.19.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2SA 19:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọba sì wí fún Barsillai pé, \"Ìwọ wá bá mi gòkè odò, èmi ó sì máa pèsè fún ọ ní Jerusalẹmu.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.33",
            "verseOrgIds": [
              "2SA.19.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2SA 19:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Barsillai sì wí fún ọba pé, \"Ọjọ́ mélòó ni ọdún ẹ̀mí mi kù, tí èmi ó fi bá ọba gòkè lọ sí Jerusalẹmu.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.34",
            "verseOrgIds": [
              "2SA.19.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2SA 19:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹni ogbó ọgọ́rin ọdún sá à ni èmi lónìí, ǹjẹ́ èmi mọ ìyàtọ̀ nínú rere àti búburú? Ǹjẹ́ ìránṣẹ́ rẹ le mọ adùn ohun tí òun ń jẹ tàbí ohun ti òun ń mu bí? Èmi tún lè mọ adùn ohùn àwọn ọkùnrin tí ń kọrin àti àwọn obìnrin tí ń kọrin bí, ǹjẹ́ nítorí kín ni ìránṣẹ́ rẹ yóò ṣe jẹ́ ìyọnu síbẹ̀ fún olúwa mi ọba.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.35",
            "verseOrgIds": [
              "2SA.19.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "2SA 19:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìránṣẹ́ rẹ yóò sì sin ọba lọ díẹ̀ gòkè odò Jordani; èéṣì ṣe tí ọba yóò fi san ẹ̀san yìí fún mi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.36",
            "verseOrgIds": [
              "2SA.19.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "2SA 19:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi bẹ̀ ọ́, jẹ́ kí ìránṣẹ́ rẹ padà, èmi ó sì kú ní ìlú mi, a ó sì sin mí ní ibojì baba àti ìyá mi. Sì wo Kimhamu ìránṣẹ́ rẹ, yóò bá olúwa mi ọba gòkè; ìwọ ó sì ṣe ohun tí ó bá tọ́ lójú rẹ fún un.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.37",
            "verseOrgIds": [
              "2SA.19.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "2SA 19:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọba sì dáhùn wí pé, \"Kimhamu yóò bá mi gòkè, èmi ó sì ṣe èyí tí ó tọ́ lójú rẹ̀ fún un; ohunkóhun tí ìwọ bá sì béèrè lọ́wọ́ mi, èmi ó ṣe é fún ọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.38",
            "verseOrgIds": [
              "2SA.19.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "2SA 19:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo àwọn ènìyàn sì gòkè odò Jordani ọba sì gòkè; ọba sì fi ẹnu ko Barsillai lẹ́nu, ó sì súre fún un; òun sì padà sí ilé rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.39",
            "verseOrgIds": [
              "2SA.19.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "2SA 19:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọba sì ń lọ́ sí Gilgali, Kimhamu sì ń bà a lọ, gbogbo àwọn ènìyàn Juda sì ń ṣe ìkẹ́ ọba, àti ààbọ̀ àwọn ènìyàn Israẹli.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.40",
            "verseOrgIds": [
              "2SA.19.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Israẹli ń jowú",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "2SA 19:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sì wò ó, gbogbo àwọn ọkùnrin Israẹli sì tọ ọba wá, wọ́n sì wí fún ọba pé, \"Èéṣe tí àwọn arákùnrin wa àwọn ọkùnrin Juda fi jí ọ kúrò, tí wọ́n sì fi mú ọba àti àwọn ará ilé rẹ̀ gòkè odò Jordani, àti gbogbo àwọn ènìyàn Dafidi pẹ̀lú rẹ?\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.41",
            "verseOrgIds": [
              "2SA.19.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "2SA 19:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo ọkùnrin Juda sì dá àwọn ọkùnrin Israẹli lóhùn pé, \"Nítorí pé ọba bá wa tan ni; èéṣe tí ẹ̀yin fi bínú nítorí ọ̀ràn yìí? Àwa jẹ nínú oúnjẹ ọba rárá bí? Tàbí ó fi ẹ̀bùn kan fún wa bí?\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.42",
            "verseOrgIds": [
              "2SA.19.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "2SA 19:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ọkùnrin Israẹli náà sì dá àwọn ọkùnrin Juda lóhùn pé, \"Àwa ní ipá mẹ́wàá nínú ọba, àwa sì ní nínú Dafidi jù yín lọ, èéṣì ṣe tí ẹ̀yin kò fi kà wá sí, tí ìmọ̀ wa kò fi ṣáájú láti mú ọba wa padà?\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.43",
            "verseOrgIds": [
              "2SA.19.44"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 19:43"
      },
      "items": [
        {
          "text": "Ọ̀rọ̀ àwọn ọkùnrin Juda sì le ju ọ̀rọ̀ àwọn ọkùnrin Israẹli.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.43",
            "verseOrgIds": [
              "2SA.19.44"
            ]
          }
        }
      ]
    }
  ],
