          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Solomoni kọ́ ilé náà",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1KI 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ìgbà tí ó pe ọ̀rìnlénírinwó ọdún (480) lẹ́yìn ìgbà tí àwọn ọmọ Israẹli ti jáde kúrò ní ilẹ̀ Ejibiti, ní ọdún kẹrin ìjọba Solomoni lórí Israẹli, ní oṣù Sifi, tí ń ṣe oṣù kejì, ó sì bẹ̀rẹ̀ sí kọ́ ilé",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.1",
            "verseOrgIds": [
              "1KI.6.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1KI.6.1",
                "verseOrgIds": [
                  "1KI.6.1"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.1",
            "verseOrgIds": [
              "1KI.6.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilé náà tí Solomoni ọba kọ́ fún",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.2",
            "verseOrgIds": [
              "1KI.6.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1KI.6.2",
                "verseOrgIds": [
                  "1KI.6.2"
                ]
              }
            }
          ]
        },
        {
          "text": "sì jẹ́ ọgọ́ta ìgbọ̀nwọ́ ní gígùn, ogún ìgbọ̀nwọ́ ní ìbú àti ọgbọ̀n ìgbọ̀nwọ́ ní gíga.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.2",
            "verseOrgIds": [
              "1KI.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìloro níwájú tẹmpili ilé náà, ogún ìgbọ̀nwọ́ ní gígùn rẹ̀, ìbú ilé náà, ìgbọ̀nwọ́ mẹ́wàá láti iwájú ilé náà.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.3",
            "verseOrgIds": [
              "1KI.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì ṣe fèrèsé tí kò fẹ̀ fún ilé náà.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.4",
            "verseOrgIds": [
              "1KI.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lára ògiri ilé náà ni ó bu yàrá yíká; àti tẹmpili àti ibi mímọ́ jùlọ ni ó sì ṣe yàrá yíká.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.5",
            "verseOrgIds": [
              "1KI.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yàrá ìsàlẹ̀ sì jẹ́ ìgbọ̀nwọ́ márùn-ún ní ìbú, ti àárín sì jẹ́ ìgbọ̀nwọ́ mẹ́fà ní ìbú, àti ẹ̀kẹta ìgbọ̀nwọ́ méje sì ni ìbú rẹ̀. Nítorí lóde ilé náà ni ó dín ìgbọ̀nwọ́ kọ̀ọ̀kan káàkiri, kí igi àjà kí ó má ba à wọ inú ògiri ilé náà.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.6",
            "verseOrgIds": [
              "1KI.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní kíkọ́ ilé náà, òkúta tí a ti gbẹ́ sílẹ̀ kí a tó mú un wá ibẹ̀ nìkan ni a lò, a kò sì gbúròó òòlù tàbí àáké tàbí ohun èlò irin kan nígbà tí a ń kọ́ ọ lọ́wọ́.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.7",
            "verseOrgIds": [
              "1KI.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹnu-ọ̀nà yàrá ìsàlẹ̀ sì wà ní ìhà gúúsù ilé náà; wọ́n sì fi àtẹ̀gùn tí ó lórí gòkè sínú yàrá àárín, àti láti yàrá àárín bọ́ sínú ẹ̀kẹta.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.8",
            "verseOrgIds": [
              "1KI.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ ni ó kọ́ ilé náà, ó sì parí rẹ̀, ó sì bo ilé náà pẹ̀lú àwọn ìtí igi àti pákó kedari.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.9",
            "verseOrgIds": [
              "1KI.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì kọ́ yàrá ẹ̀gbẹ́ sí gbogbo ilé náà. Gígùn ọ̀kọ̀ọ̀kan sì jẹ́ ìgbọ̀nwọ́ márùn-ún, ó sì so wọ́n mọ́ ilé náà pẹ̀lú ìtì igi kedari.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.10",
            "verseOrgIds": [
              "1KI.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ̀rọ̀",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.11",
            "verseOrgIds": [
              "1KI.6.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1KI.6.11",
                "verseOrgIds": [
                  "1KI.6.11"
                ]
              }
            }
          ]
        },
        {
          "text": "sì tọ Solomoni wá wí pé,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.11",
            "verseOrgIds": [
              "1KI.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ní ti ilé yìí tí ìwọ ń kọ́ lọ́wọ́, bí ìwọ bá tẹ̀lé àṣẹ mi, tí ìwọ sì ṣe ìdájọ́ mi, tí o sì pa òfin mi mọ́ láti máa ṣe wọ́n, Èmi yóò mú ìlérí tí mo ti ṣe fún Dafidi baba rẹ̀ ṣẹ nípa rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.12",
            "verseOrgIds": [
              "1KI.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò sì máa gbé àárín àwọn ọmọ Israẹli, èmi kì ó sì kọ Israẹli ènìyàn mi.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.13",
            "verseOrgIds": [
              "1KI.6.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ ni Solomoni kọ́ ilé náà, ó sì parí rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.14",
            "verseOrgIds": [
              "1KI.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì fi pákó kedari tẹ́ ògiri ilé náà nínú, láti ilẹ̀ ilé náà dé àjà rẹ̀, ó fi igi bò wọ́n nínú, ó sì fi pákó firi tẹ́ ilẹ̀ ilé náà.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.15",
            "verseOrgIds": [
              "1KI.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó pín ogún ìgbọ̀nwọ́ sí ẹ̀yìn ilé náà, láti ilẹ̀ dé àjà ilé ni ó fi pákó kedari kọ́, èyí ni ó kọ sínú, fún ibi tí a yà sí mímọ́ àní Ibi Mímọ́ Jùlọ.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.16",
            "verseOrgIds": [
              "1KI.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní iwájú ilé náà, ogójì ìgbọ̀nwọ́ ni gígùn rẹ̀ jẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.17",
            "verseOrgIds": [
              "1KI.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inú ilé náà sì jẹ́ kedari, wọ́n ṣe iṣẹ́ ọnà rẹ̀ pẹ̀lú ìrudí àti ìtànná. Gbogbo rẹ̀ sì jẹ́ kedari; a kò sì rí òkúta kan níbẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.18",
            "verseOrgIds": [
              "1KI.6.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì múra ibi mímọ́ jùlọ sílẹ̀ nínú ilé náà láti gbé àpótí ẹ̀rí",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.19",
            "verseOrgIds": [
              "1KI.6.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1KI.6.19",
                "verseOrgIds": [
                  "1KI.6.19"
                ]
              }
            }
          ]
        },
        {
          "text": "ka ibẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.19",
            "verseOrgIds": [
              "1KI.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inú ibi mímọ́ náà sì jẹ́ ogún ìgbọ̀nwọ́ ní gígùn, ogún ìgbọ̀nwọ́ ní ìbú, àti ogún ìgbọ̀nwọ́ ní gíga. Ó sì fi kìkì wúrà bo inú rẹ̀ ó sì fi igi kedari bo pẹpẹ rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.20",
            "verseOrgIds": [
              "1KI.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoni sì fi kìkì wúrà bo inú ilé náà, ó sì tan ẹ̀wọ̀n wúrà dé ojú ibi mímọ́ jùlọ, ó sì fi wúrà bò ó.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.21",
            "verseOrgIds": [
              "1KI.6.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo ilé náà ni ó fi wúrà bò títí ó fi parí gbogbo ilé náà, àti gbogbo pẹpẹ tí ó wà níhà ibi mímọ́ jùlọ, ni ó fi wúrà bò.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.22",
            "verseOrgIds": [
              "1KI.6.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1KI 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní inú ibi mímọ́ jùlọ ni ó fi igi olifi ṣe kérúbù méjì, ọ̀kọ̀ọ̀kan jẹ́ ìgbọ̀nwọ́ mẹ́wàá ní gíga.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.23",
            "verseOrgIds": [
              "1KI.6.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 6:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apá kérúbù kìn-ín-ní sì jẹ́ ìgbọ̀nwọ́ márùn-ún ní gíga, àti apá kérúbù kejì ìgbọ̀nwọ́ márùn-ún; ìgbọ̀nwọ́ mẹ́wàá láti ṣóńṣó apá kan dé ṣóńṣó apá kejì.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.24",
            "verseOrgIds": [
              "1KI.6.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 6:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìgbọ̀nwọ́ mẹ́wàá sì ni kérúbù kejì pẹ̀lú, nítorí kérúbù méjèèjì jọ ara wọn ní ìwọ̀n ní títóbi àti títẹ̀wọ̀n bákan náà.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.25",
            "verseOrgIds": [
              "1KI.6.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 6:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gíga kérúbù kọ̀ọ̀kan jẹ́ ìgbọ̀nwọ́ mẹ́wàá.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.26",
            "verseOrgIds": [
              "1KI.6.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 6:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì gbé àwọn kérúbù náà sínú ilé ti inú lọ́hùn ún, pẹ̀lú ìyẹ́ apá wọn ní nínà jáde. Ìyẹ́ apá kérúbù kan sì kan ògiri kan, nígbà tí ìyẹ́ apá èkejì sì kan ògiri kejì, ìyẹ́ apá wọn sì kan ara wọn láàrín yàrá náà.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.27",
            "verseOrgIds": [
              "1KI.6.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 6:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì fi wúrà bo àwọn kérúbù náà.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.28",
            "verseOrgIds": [
              "1KI.6.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 6:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lára àwọn ògiri tí ó yí ilé náà ká, nínú àti lóde, ó sì ya àwòrán àwọn kérúbù sí i àti ti igi ọ̀pẹ, àti ti ìtànná ewéko.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.29",
            "verseOrgIds": [
              "1KI.6.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 6:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì tún fi wúrà tẹ́ ilẹ̀ ilé náà nínú àti lóde.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.30",
            "verseOrgIds": [
              "1KI.6.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1KI 6:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí ojú ọ̀nà ibi mímọ́ jùlọ ni ó ṣe ìlẹ̀kùn igi olifi sí pẹ̀lú àtẹ́rígbà àti òpó ìhà jẹ́ ìdámárùn-ún ògiri.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.31",
            "verseOrgIds": [
              "1KI.6.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1KI 6:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àti lára ìlẹ̀kùn igi olifi náà ni ó ya àwòrán àwọn kérúbù, igi ọ̀pẹ àti ti ìtànná ewéko sí, ó sì fi wúrà bò wọ́n, ó sì tan wúrà sí ara àwọn kérúbù àti sí ara igi ọ̀pẹ.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.32",
            "verseOrgIds": [
              "1KI.6.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1KI 6:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ ni ó sì ṣe òpó igi olifi onígun mẹ́rin fún ìlẹ̀kùn ilé náà.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.33",
            "verseOrgIds": [
              "1KI.6.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1KI 6:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì tún fi igi firi ṣe ìlẹ̀kùn méjì, ọ̀kọ̀ọ̀kan wọn sì ní ewé méjì tí ó yí sí ihò ìtẹ̀bọ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.34",
            "verseOrgIds": [
              "1KI.6.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1KI 6:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì ya àwòrán kérúbù, àti ti igi ọ̀pẹ àti ti ìtànná ewéko sí ara wọn, ó sì fi wúrà bò ó, èyí tí ó tẹ́ sórí ibi tí ó gbẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.35",
            "verseOrgIds": [
              "1KI.6.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1KI 6:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì fi ẹsẹẹsẹ òkúta mẹ́ta gbígbẹ, àti ẹsẹ̀ kan ìtí kedari kọ́ àgbàlá ti inú lọ́hùn ún.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.36",
            "verseOrgIds": [
              "1KI.6.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1KI 6:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọdún kẹrin ni a fi ìpìlẹ̀ ilé",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.37",
            "verseOrgIds": [
              "1KI.6.37"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1KI.6.37",
                "verseOrgIds": [
                  "1KI.6.37"
                ]
              }
            }
          ]
        },
        {
          "text": "lé ilẹ̀, ní oṣù Sifi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.37",
            "verseOrgIds": [
              "1KI.6.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1KI 6:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọdún kọkànlá ní oṣù Bulu, oṣù kẹjọ, a sì parí ilé náà jálẹ̀ jálẹ̀, pẹ̀lú gbogbo ìpín rẹ̀, gẹ́gẹ́ bí gbogbo èyí tí ó yẹ. Ó sì lo ọdún méje ní kíkọ́ ilé náà.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.38",
            "verseOrgIds": [
              "1KI.6.38"
            ]
          }
        }
      ]
    }
