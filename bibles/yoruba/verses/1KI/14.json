  "verseCount": 31,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "14",
        "style": "c",
        "sid": "1KI 14"
      },
      "items": [
        {
          "text": "14",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ahijah sọtẹ́lẹ̀ fún Jeroboamu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1KI 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní àkókò náà Abijah ọmọ Jeroboamu sì ṣàìsàn,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.1",
            "verseOrgIds": [
              "1KI.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jeroboamu sì wí fún aya rẹ̀ pé, \"Lọ, sì pa ara rẹ dà, kí wọn kí ó má ba à mọ̀ ọ́n ní aya Jeroboamu. Nígbà náà ni kí o lọ sí Ṣilo. Ahijah wòlíì wà níbẹ̀; ẹni tí ó sọ fún mi pé, èmi yóò jẹ ọba lórí àwọn ènìyàn yìí.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.2",
            "verseOrgIds": [
              "1KI.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mú ìṣù àkàrà mẹ́wàá pẹ̀lú rẹ̀, àti àkàrà wẹ́wẹ́ àti ìgò oyin, kí o sì lọ sí ọ̀dọ̀ rẹ̀. Òun yóò sì sọ fún ọ ohun tí yóò ṣẹlẹ̀ sí ọmọkùnrin náà.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.3",
            "verseOrgIds": [
              "1KI.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ ni aya Jeroboamu sì ṣe bí ó ti wí, ó sì lọ sí ilé Ahijah ní Ṣilo.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.4",
            "verseOrgIds": [
              "1KI.14.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1KI 14:4"
      },
      "items": [
        {
          "text": "Ahijah kò sì ríran; ojú rẹ̀ ti fọ́ nítorí ogbó rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.4",
            "verseOrgIds": [
              "1KI.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.5",
            "verseOrgIds": [
              "1KI.14.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1KI.14.5",
                "verseOrgIds": [
                  "1KI.14.5"
                ]
              }
            }
          ]
        },
        {
          "text": "ti sọ fún Ahijah pé, \"Kíyèsi i, aya Jeroboamu ń bọ̀ wá béèrè nípa ọmọ rẹ̀ lọ́wọ́ rẹ, nítorí tí ó ṣàìsàn, báyìí báyìí ni kí ìwọ kí ó wí fún un. Nígbà tí ó bá dé, yóò ṣe ara rẹ̀ bí ẹlòmíràn.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.5",
            "verseOrgIds": [
              "1KI.14.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ ni ó sì rí, nígbà tí Ahijah sì gbọ́ ìró ẹsẹ̀ rẹ̀ ní ẹnu-ọ̀nà, ó sì wí pé, \"Wọlé wá, aya Jeroboamu. Kí ló dé tí ìwọ fi ṣe ara rẹ bí ẹlòmíràn? A ti fi iṣẹ́ búburú rán mi sí ọ.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.6",
            "verseOrgIds": [
              "1KI.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lọ, sọ fún Jeroboamu pé báyìí ni",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.7",
            "verseOrgIds": [
              "1KI.14.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1KI.14.7",
                "verseOrgIds": [
                  "1KI.14.7"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run Israẹli wí, 'Èmi sì gbé ọ ga láti inú àwọn ènìyàn, mo sì fi ọ́ jẹ olórí lórí Israẹli ènìyàn mi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.7",
            "verseOrgIds": [
              "1KI.14.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mo fa ìjọba náà ya kúrò ní ilé Dafidi, mo sì fi fún ọ ṣùgbọ́n, ìwọ kò dàbí Dafidi ìránṣẹ́ mi, tí ó pa àṣẹ mi mọ́, tí ó sì tọ̀ mí lẹ́yìn tọkàntọkàn rẹ̀, láti ṣe kìkì èyí tí ó tọ́ ní ojú mi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.8",
            "verseOrgIds": [
              "1KI.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ sì ti ṣe búburú ju gbogbo àwọn tí ó ti wà ṣáájú rẹ lọ. Ìwọ sì ti ṣe àwọn ọlọ́run mìíràn fún ara rẹ, àwọn òrìṣà tí a gbẹ́; o sì ti mú mi bínú, o sì ti gbé mi sọ sí ẹ̀yìn rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.9",
            "verseOrgIds": [
              "1KI.14.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Nítorí èyí, Èmi yóò mú ibi wá sí ilé Jeroboamu. Èmi yóò ké gbogbo ọ̀dọ́mọkùnrin kúrò lọ́dọ̀ Jeroboamu, àti ọmọ ọ̀dọ̀ àti òmìnira ní Israẹli. Èmi yóò mú ilé Jeroboamu kúrò bí ènìyàn ti ń kó ìgbẹ́ kúrò, títí gbogbo rẹ̀ yóò fi tán.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.10",
            "verseOrgIds": [
              "1KI.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ajá yóò jẹ ẹni Jeroboamu tí ó bá kú ní ìlú, àti ẹni tí ó bá kú ní igbó ni àwọn ẹyẹ ojú ọ̀run yóò jẹ.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.11",
            "verseOrgIds": [
              "1KI.14.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1KI.14.11",
                "verseOrgIds": [
                  "1KI.14.11"
                ]
              }
            }
          ]
        },
        {
          "text": "ti sọ ọ́!'",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.11",
            "verseOrgIds": [
              "1KI.14.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ní ti ìwọ, padà lọ ilé, nígbà tí o bá sì fi ẹsẹ̀ rẹ tẹ ìlú, ọmọ náà yóò kú.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.12",
            "verseOrgIds": [
              "1KI.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo Israẹli yóò sì ṣọ̀fọ̀ fún un, wọn yóò sì sin ín. Òun nìkan ni a ó sì sin nínú ẹni tí ń ṣe ti Jeroboamu, nítorí lọ́dọ̀ rẹ̀ nìkan ni a ti rí ohun rere díẹ̀ sípa",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.13",
            "verseOrgIds": [
              "1KI.14.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1KI.14.13",
                "verseOrgIds": [
                  "1KI.14.13"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run Israẹli, ní ilé Jeroboamu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.13",
            "verseOrgIds": [
              "1KI.14.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.14",
            "verseOrgIds": [
              "1KI.14.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1KI.14.14",
                "verseOrgIds": [
                  "1KI.14.14"
                ]
              }
            }
          ]
        },
        {
          "text": "yóò gbé ọba kan dìde fúnra rẹ̀ lórí Israẹli tí yóò ké ilé Jeroboamu kúrò. Ọjọ́ náà nìyìí! Kí ni? Àní nísinsin yìí.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.14",
            "verseOrgIds": [
              "1KI.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1KI.14.15",
                "verseOrgIds": [
                  "1KI.14.15"
                ]
              }
            }
          ]
        },
        {
          "text": "yóò kọlu Israẹli, yóò sì dàbí koríko ti ń mì nínú omi. Yóò sì fa Israẹli tu kúrò ní ilẹ̀ rere yìí, tí ó ti fi fún àwọn baba wọn, yóò sì fọ́n wọn ká kọjá odò Eufurate, nítorí wọ́n ti rú ìbínú",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.15",
            "verseOrgIds": [
              "1KI.14.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1KI.14.15",
                "verseOrgIds": [
                  "1KI.14.15"
                ]
              }
            }
          ]
        },
        {
          "text": "nípa ṣíṣe ère Aṣerah.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.15",
            "verseOrgIds": [
              "1KI.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yóò sì kọ Israẹli sílẹ̀ nítorí ẹ̀ṣẹ̀ tí Jeroboamu ti ṣẹ̀ àti tí ó mú Israẹli ṣẹ̀.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.16",
            "verseOrgIds": [
              "1KI.14.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni aya Jeroboamu sì dìde, ó sì lọ, ó sì lọ sí Tirsa. Bí ó sì ti fi ẹsẹ̀ tẹ ìloro ilé, ọmọdé náà sì kú.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.17",
            "verseOrgIds": [
              "1KI.14.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n sì sin ín, gbogbo Israẹli sì ṣọ̀fọ̀ rẹ̀, gẹ́gẹ́ bí",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.18",
            "verseOrgIds": [
              "1KI.14.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1KI.14.18",
                "verseOrgIds": [
                  "1KI.14.18"
                ]
              }
            }
          ]
        },
        {
          "text": "ti wí láti ẹnu ìránṣẹ́ rẹ̀, Ahijah wòlíì.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.18",
            "verseOrgIds": [
              "1KI.14.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìyókù ìṣe Jeroboamu, bí ó ti jagun, àti bí ó ti jẹ ọba, ni a kọ sínú ìwé ọ̀rọ̀ ọjọ́ àwọn ọba Israẹli.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.19",
            "verseOrgIds": [
              "1KI.14.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jeroboamu sì jẹ ọba fún ọdún méjìlélógún, ó sì sùn pẹ̀lú àwọn baba rẹ̀. Nadabu ọmọ rẹ̀ sì jẹ ọba ní ipò rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.20",
            "verseOrgIds": [
              "1KI.14.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Rehoboamu ọba Juda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rehoboamu ọmọ Solomoni sì jẹ ọba ní Juda. Ó jẹ́ ẹni ọdún mọ́kànlélógún nígbà tí ó bẹ̀rẹ̀ sí ní jẹ ọba, ó sì jẹ ọba ní ọdún mọ́kànlélógún ní Jerusalẹmu, ìlú tí",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.21",
            "verseOrgIds": [
              "1KI.14.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1KI.14.21",
                "verseOrgIds": [
                  "1KI.14.21"
                ]
              }
            }
          ]
        },
        {
          "text": "ti yàn nínú gbogbo ẹ̀yà Israẹli láti fi orúkọ rẹ̀ síbẹ̀. Orúkọ ìyá rẹ̀ sì ni Naama, ará Ammoni.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.21",
            "verseOrgIds": [
              "1KI.14.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 14:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Juda sì ṣe búburú níwájú",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.22",
            "verseOrgIds": [
              "1KI.14.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1KI.14.22",
                "verseOrgIds": [
                  "1KI.14.22"
                ]
              }
            }
          ]
        },
        {
          "text": "nípa ẹ̀ṣẹ̀ wọn tí wọ́n ti dá, wọ́n sì mú u jowú ju gbogbo èyí tí baba wọn ti ṣe lọ.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.22",
            "verseOrgIds": [
              "1KI.14.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1KI 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n sì tún kọ́ ibi gíga fún ara wọn, àti ère òkúta àti òpó Aṣerah lórí gbogbo òkè gíga, àti lábẹ́ gbogbo igi tútù.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.23",
            "verseOrgIds": [
              "1KI.14.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 14:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn tí wọn jẹ́ ọkùnrin alágbèrè ojúbọ òrìṣà wà ní ilẹ̀ náà, àwọn ènìyàn náà sì ṣe gẹ́gẹ́ bí gbogbo ohun ìríra àwọn orílẹ̀-èdè tí",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.24",
            "verseOrgIds": [
              "1KI.14.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1KI.14.24",
                "verseOrgIds": [
                  "1KI.14.24"
                ]
              }
            }
          ]
        },
        {
          "text": "ti lé jáde kúrò níwájú àwọn ọmọ Israẹli.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.24",
            "verseOrgIds": [
              "1KI.14.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 14:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì ṣe ní ọdún karùn-ún Rehoboamu, Ṣiṣaki ọba Ejibiti kọlu Jerusalẹmu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.25",
            "verseOrgIds": [
              "1KI.14.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 14:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì kó ìṣúra ilé",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.26",
            "verseOrgIds": [
              "1KI.14.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1KI.14.26",
                "verseOrgIds": [
                  "1KI.14.26"
                ]
              }
            }
          ]
        },
        {
          "text": "lọ àti ìṣúra ilé ọba. Gbogbo rẹ̀ ni ó kó lọ, pẹ̀lú asà wúrà tí Solomoni ti ṣe.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.26",
            "verseOrgIds": [
              "1KI.14.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 14:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rehoboamu ọba sì ṣe asà idẹ ní ipò wọn, ó sì fi wọ́n sí ọwọ́ olórí àwọn olùṣọ́ tí ń ṣọ́ ìlẹ̀kùn ilé ọba.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.27",
            "verseOrgIds": [
              "1KI.14.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 14:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbàkígbà tí ọba bá sì lọ sí ilé",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.28",
            "verseOrgIds": [
              "1KI.14.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1KI.14.28",
                "verseOrgIds": [
                  "1KI.14.28"
                ]
              }
            }
          ]
        },
        {
          "text": ", wọ́n á rù wọ́n, wọ́n á sì mú wọn padà sínú yàrá olùṣọ́.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.28",
            "verseOrgIds": [
              "1KI.14.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 14:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ti ìyókù ìṣe Rehoboamu, àti gbogbo ohun tí ó ṣe, ǹjẹ́ a kò ha kọ wọ́n sínú ìwé ọ̀rọ̀ ọjọ́ àwọn ọba Juda bí?",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.29",
            "verseOrgIds": [
              "1KI.14.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 14:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogun sì wà láàrín Rehoboamu àti Jeroboamu ní ọjọ́ wọn gbogbo.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.30",
            "verseOrgIds": [
              "1KI.14.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1KI 14:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rehoboamu sì sùn pẹ̀lú àwọn baba rẹ̀, a sì sin ín pẹ̀lú wọn ní ìlú Dafidi. Orúkọ ìyá rẹ̀ sì ni Naama; ará Ammoni. Abijah ọmọ rẹ̀ sì jẹ ọba ní ipò rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.31",
            "verseOrgIds": [
              "1KI.14.31"
            ]
          }
        }
      ]
    }
  ],
