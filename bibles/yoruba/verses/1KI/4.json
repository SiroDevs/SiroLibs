  "verseCount": 34,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "1KI 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Àwọn aláṣẹ àti alákòóso Solomoni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1KI 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoni ọba sì jẹ ọba lórí gbogbo Israẹli.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.1",
            "verseOrgIds": [
              "1KI.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn wọ̀nyí sì ni ìjòyè rẹ̀:",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "1KI 4:2"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1KI 4:2"
      },
      "items": [
        {
          "text": "Asariah ọmọ Sadoku àlùfáà:",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.2",
            "verseOrgIds": [
              "1KI.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elihorefu àti Ahijah àwọn ọmọ Ṣisa akọ̀wé;",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.3",
            "verseOrgIds": [
              "1KI.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1KI 4:3"
      },
      "items": [
        {
          "text": "Jehoṣafati ọmọ Ahiludi ni akọ̀wé ìlú;",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.3",
            "verseOrgIds": [
              "1KI.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Benaiah ọmọ Jehoiada ni olórí ogun;",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.4",
            "verseOrgIds": [
              "1KI.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1KI 4:4"
      },
      "items": [
        {
          "text": "Sadoku àti Abiatari ni àwọn àlùfáà;",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.4",
            "verseOrgIds": [
              "1KI.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asariah ọmọ Natani ni olórí àwọn agbègbè;",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.5",
            "verseOrgIds": [
              "1KI.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1KI 4:5"
      },
      "items": [
        {
          "text": "Sabudu ọmọ Natani, àlùfáà àti olùgba ọba ní ìmọ̀ràn;",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.5",
            "verseOrgIds": [
              "1KI.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahiṣari ni olùtọ́jú ààfin;",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.6",
            "verseOrgIds": [
              "1KI.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1KI 4:6"
      },
      "items": [
        {
          "text": "Adoniramu ọmọ Abida ni ó ń ṣe olórí iṣẹ́-ìlú.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.6",
            "verseOrgIds": [
              "1KI.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoni sì tún ní ìjòyè méjìlá lórí gbogbo agbègbè Israẹli, tí wọ́n ń pèsè oúnjẹ fún ọba àti agbo ilé rẹ̀. Olúkúlùkù ní láti pèsè fún oṣù kan ní ọdún.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.7",
            "verseOrgIds": [
              "1KI.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orúkọ wọn ni wọ̀nyí:",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "1KI 4:8"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1KI 4:8"
      },
      "items": [
        {
          "text": "Bene-Huri ní ìlú olókè Efraimu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.8",
            "verseOrgIds": [
              "1KI.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bene-Dekeri ní Makasi, Ṣaalbimu, Beti-Ṣemeṣi, àti Eloni Beti-Hanani;",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.9",
            "verseOrgIds": [
              "1KI.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bene-Hesedi, ní Aruboti (tirẹ̀ ni Soko àti gbogbo ilẹ̀ Heferi ń ṣe);",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.10",
            "verseOrgIds": [
              "1KI.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bene-Abinadabu, ní Napoti (Dori; òun ni ó fẹ́ Tafati ọmọbìnrin Solomoni ní aya).",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.11",
            "verseOrgIds": [
              "1KI.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baana ọmọ Ahiludi, ní Taanaki àti Megido, àti ní gbogbo Beti-Ṣeani tí ń bẹ níhà Saretani ní ìsàlẹ̀ Jesreeli, láti Beti-Ṣeani dé Abeli-Mehola títí dé ibi tí ń bẹ ní ìkọjá Jokimeamu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.12",
            "verseOrgIds": [
              "1KI.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọmọ Geberi ní Ramoti Gileadi (tirẹ̀ ni àwọn ìletò Jairi ọmọ Manase tí ń bẹ ní Gileadi, tirẹ̀ sì ni agbègbè Argobu, tí ń bẹ ní Baṣani, ọgọ́ta ìlú tí ó tóbi pẹ̀lú odi tí ẹnu-ọ̀nà rẹ̀ jẹ́ irin).",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.13",
            "verseOrgIds": [
              "1KI.4.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahinadabu ọmọ Iddo ní Mahanaimu",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.14",
            "verseOrgIds": [
              "1KI.4.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahimasi ní Naftali (ó fẹ́ Basemati ọmọbìnrin Solomoni ní aya).",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.15",
            "verseOrgIds": [
              "1KI.4.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baana ọmọ Huṣai ní Aṣeri àti ní Aloti;",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.16",
            "verseOrgIds": [
              "1KI.4.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehoṣafati ọmọ Parua ni ó wà ní Isakari;",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.17",
            "verseOrgIds": [
              "1KI.4.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣimei ọmọ Ela ni Benjamini;",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.18",
            "verseOrgIds": [
              "1KI.4.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Geberi ọmọ Uri ní Gileadi (orílẹ̀-èdè Sihoni ọba àwọn ará Amori àti orílẹ̀-èdè Ogu ọba Baṣani). Òun nìkan ni ìjòyè lórí ilẹ̀ náà.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.19",
            "verseOrgIds": [
              "1KI.4.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Oúnjẹ Solomoni lójoojúmọ́",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ènìyàn Juda àti ti Israẹli pọ̀ gẹ́gẹ́ bí iyanrìn tí ń bẹ ní etí Òkun; wọ́n ń jẹ, wọ́n sì ń mu, wọ́n sì ń yọ ayọ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.20",
            "verseOrgIds": [
              "1KI.4.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoni sì ń ṣàkóso lórí gbogbo àwọn ìjọba láti odò Eufurate títí dé ilẹ̀ àwọn ará Filistini, àti títí dé etí ilẹ̀ Ejibiti. Àwọn orílẹ̀-èdè yìí ń mú owó òde wá, wọ́n sì ń sin Solomoni ní gbogbo ọjọ́ ayé rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.21",
            "verseOrgIds": [
              "1KI.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oúnjẹ Solomoni fún ọjọ́ kan jásí ọgbọ̀n ìyẹ̀fun kíkúnná àti ọgọ́ta òsùwọ̀n ìyẹ̀fun,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.22",
            "verseOrgIds": [
              "1KI.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1KI 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Màlúù mẹ́wàá tí ó sanra, àti ogún màlúù láti inú pápá wá, àti ọgọ́rùn-ún àgùntàn àti ewúrẹ́, láìka àgbọ̀nrín àti èsúró, àti ogbúgbu, àti ẹyẹ tí ó sanra.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.23",
            "verseOrgIds": [
              "1KI.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 4:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí òun ni ó ṣàkóso lórí gbogbo agbègbè ní ìhà ìwọ̀-oòrùn odò Eufurate, láti Tifisa títí dé Gasa, lórí gbogbo àwọn ọba ní ìhà ìhín odò, ó sì ní àlàáfíà ní gbogbo ìlú tí ó yí i káàkiri.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.24",
            "verseOrgIds": [
              "1KI.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 4:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà ayé Solomoni, Juda àti Israẹli, láti Dani títí dé Beerṣeba, wọ́n ń gbé ní àlàáfíà, olúkúlùkù lábẹ́ àjàrà rẹ̀ àti lábẹ́ igi ọ̀pọ̀tọ́ rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.25",
            "verseOrgIds": [
              "1KI.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 4:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoni sì ní ẹgbàajì (4,000) ilé ẹṣin fún kẹ̀kẹ́ rẹ̀, àti ẹgbàá mẹ́fà (12,000) ẹlẹ́ṣin.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.26",
            "verseOrgIds": [
              "1KI.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 4:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ìjòyè agbègbè, olúkúlùkù ní oṣù rẹ̀, ń pèsè oúnjẹ fún Solomoni ọba àti gbogbo àwọn tí ń wá sí ibi tábìlì ọba, wọ́n sì rí i pé ohun kankan kò ṣẹ́kù.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.27",
            "verseOrgIds": [
              "1KI.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 4:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n tún máa ń mú ọkà barle àti koríko fún ẹṣin àti fún ẹṣin sísáré wá pẹ̀lú sí ibi tí ó yẹ, olúkúlùkù gẹ́gẹ́ bí ìlànà tirẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.28",
            "verseOrgIds": [
              "1KI.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ọgbọ́n Solomoni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 4:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọlọ́run sì fún Solomoni ní ọgbọ́n, àti òye ní ọ̀pọ̀lọpọ̀, àti ìmọ̀ gbígbòòrò òye tí a kò le è fiwé iyanrìn tí ó wà létí Òkun.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.29",
            "verseOrgIds": [
              "1KI.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 4:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọgbọ́n Solomoni sì pọ̀ ju ọgbọ́n ọkùnrin ìlà-oòrùn lọ, ó sì pọ̀ ju gbogbo ọgbọ́n Ejibiti lọ.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.30",
            "verseOrgIds": [
              "1KI.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1KI 4:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì ní òye ju gbogbo ènìyàn lọ, ju Etani, ará Esra, àti Hemani àti Kalkoli, àti Darda àwọn ọmọ Maholi lọ. Òkìkí rẹ̀ sì kàn ní gbogbo orílẹ̀-èdè yíká.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.31",
            "verseOrgIds": [
              "1KI.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1KI 4:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì pa ẹgbẹ̀rún mẹ́ta (3,000) òwe, àwọn orin rẹ̀ sì jẹ́ ẹgbẹ̀rún ó lé márùn-ún (1,005).",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.32",
            "verseOrgIds": [
              "1KI.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1KI 4:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì sọ̀rọ̀ ti igi, láti kedari tí ń bẹ ní Lebanoni dé Hísópù tí ń dàgbà lára ògiri. Ó sì tún sọ ti àwọn ẹranko àti ti àwọn ẹyẹ, àti ohun tí ń rákò àti ti ẹja.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.33",
            "verseOrgIds": [
              "1KI.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1KI 4:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ènìyàn sì ń wá láti gbogbo orílẹ̀-èdè láti gbọ́ ọgbọ́n Solomoni, láti ọ̀dọ̀ àwọn ọba ayé láti wá gbọ́ nípa ọgbọ́n rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.34",
            "verseOrgIds": [
              "1KI.5.14"
            ]
          }
        }
      ]
    }
  ],
