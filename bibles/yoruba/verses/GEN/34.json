              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n kó màlúù wọn àti agbo ẹran wọn àti kẹ́tẹ́kẹ́tẹ́, àti ohun gbogbo tí ó wà nínú ìlú àti ní oko.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.28",
            "verseOrgIds": [
              "GEN.34.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 34:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo ọrọ̀ wọn, gbogbo obìnrin ìlú àti àwọn ọmọ wẹẹrẹ pátápátá ni wọ́n kó. Wọ́n sì kó gbogbo ohun tí ó wà nínú ilé wọn bí ìkógun.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.29",
            "verseOrgIds": [
              "GEN.34.29"
            ]
          }
        }
      ]
    },
