        },
        {
          "text": "sì tún wí pé, \"Èmi kì yóò pa ìlú náà run bí mo bá rí olódodo ogójì nínú rẹ̀.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.29",
