                "verseOrgIds": [
                  "GEN.18.30"
                ]
              }
            }
          ]
        },
        {
          "text": "dáhùn pé, \"Bí mó bá rí ọgbọ̀n, èmi kì yóò pa ìlú run.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.30",
            "verseOrgIds": [
              "GEN.18.30"
            ]
          }
        }
