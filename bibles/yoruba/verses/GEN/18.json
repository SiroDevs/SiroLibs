          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Òun sì tún wí lẹ́ẹ̀kan si pé, \"Bí ó bá ṣe pé ogójì ni ń kọ́?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.29",
            "verseOrgIds": [
              "GEN.18.29"
            ]
          }
        }
      ]
    },
    {
