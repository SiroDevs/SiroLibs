          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abrahamu sì tún bẹ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.30",
            "verseOrgIds": [
              "GEN.18.30"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "GEN.18.30",
                "verseOrgIds": [
                  "GEN.18.30"
                ]
              }
            }
          ]
        },
        {
          "text": "pé, \"Kí Olúwa má ṣe bínú, ṣùgbọ́n èmi yóò sọ̀rọ̀. Bí ó bá ṣe pé ọgbọ̀n ni a rí níbẹ̀ ń kọ́?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.30",
            "verseOrgIds": [
              "GEN.18.30"
            ]
          }
        }
      ]
    },
    {
