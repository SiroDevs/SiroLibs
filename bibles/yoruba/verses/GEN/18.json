                "verseOrgIds": [
                  "GEN.18.19"
                ]
              }
            }
          ]
        },
        {
          "text": "le è mú ìlérí rẹ̀ fún Abrahamu ṣẹ.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.19",
            "verseOrgIds": [
              "GEN.18.19"
            ]
          }
        }
