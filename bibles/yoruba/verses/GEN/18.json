              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abrahamu sì wí pé, \"Jọ̀wọ́ má ṣe bínú",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.32",
            "verseOrgIds": [
              "GEN.18.32"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "GEN.18.32",
                "verseOrgIds": [
                  "GEN.18.32"
                ]
              }
            }
          ]
        },
        {
          "text": ". Jẹ́ kí ń béèrè lẹ́ẹ̀kan si. Bí ó bá ṣe pé ènìyàn mẹ́wàá ni ó jẹ́ olódodo ń kọ́?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.32",
            "verseOrgIds": [
              "GEN.18.32"
            ]
          }
        }
      ]
    },
