  "verseCount": 20,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "12",
        "style": "c",
        "sid": "GEN 12"
      },
      "items": [
        {
          "text": "12",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìpè Abramu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "GEN.12.1",
                "verseOrgIds": [
                  "GEN.12.1"
                ]
              }
            }
          ]
        },
        {
          "text": "sì wí fún Abramu, \"Jáde kúrò ní orílẹ̀-èdè rẹ àti kúrò lọ́dọ̀ àwọn ènìyàn rẹ, lọ sí ilẹ̀ kan tí èmi yóò fihàn ọ́.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.1",
            "verseOrgIds": [
              "GEN.12.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Èmi yóò sọ ọ́ di orílẹ̀-èdè ńlá,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.2",
            "verseOrgIds": [
              "GEN.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 12:2"
      },
      "items": [
        {
          "text": "èmi yóò sì bùkún fún ọ;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.2",
            "verseOrgIds": [
              "GEN.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "GEN 12:2"
      },
      "items": [
        {
          "text": "èmi yóò sọ orúkọ rẹ di ńlá,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.2",
            "verseOrgIds": [
              "GEN.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 12:2"
      },
      "items": [
        {
          "text": "ìbùkún ni ìwọ yóò sì jásí.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.2",
            "verseOrgIds": [
              "GEN.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò bùkún fún àwọn tí ó súre fún ọ,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.3",
            "verseOrgIds": [
              "GEN.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 12:3"
      },
      "items": [
        {
          "text": "ẹni tí ó fi ọ́ ré ni Èmi yóò fi ré;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.3",
            "verseOrgIds": [
              "GEN.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "GEN 12:3"
      },
      "items": [
        {
          "text": "nínú rẹ ni a ó bùkún",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.3",
            "verseOrgIds": [
              "GEN.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 12:3"
      },
      "items": [
        {
          "text": "gbogbo ìdílé ayé.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.3",
            "verseOrgIds": [
              "GEN.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ ni Abramu lọ bí",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.4",
            "verseOrgIds": [
              "GEN.12.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "GEN.12.4",
                "verseOrgIds": [
                  "GEN.12.4"
                ]
              }
            }
          ]
        },
        {
          "text": "ti sọ fún un. Lọti náà sì bá a lọ. Abramu jẹ́ ẹni àrùndínlọ́gọ́rin ọdún nígbà tí ó jáde kúrò ní Harani.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.4",
            "verseOrgIds": [
              "GEN.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abramu sì mú Sarai aya rẹ̀, àti Lọti ọmọ arákùnrin rẹ̀: gbogbo ohun ìní tí wọ́n ti kójọ àti àwọn ènìyàn tí wọ́n ní ní Harani. Wọ́n sì jáde lọ sí ilẹ̀ Kenaani. Wọ́n sì gúnlẹ̀ síbẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.5",
            "verseOrgIds": [
              "GEN.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abramu sì rìn la ilẹ̀ náà já títí dé ibi igi ńlá kan tí à ń pè ni More ní Ṣekemu. Àwọn ará Kenaani sì wà ní ilẹ̀ náà.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.6",
            "verseOrgIds": [
              "GEN.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "GEN.12.7",
                "verseOrgIds": [
                  "GEN.12.7"
                ]
              }
            }
          ]
        },
        {
          "text": "sì farahan Abramu, ó sì wí fún un pé, \"Irú-ọmọ rẹ ni Èmi yóò fi ilẹ̀ yìí fún.\" Abramu tẹ́ pẹpẹ kan síbẹ̀ fún",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.7",
            "verseOrgIds": [
              "GEN.12.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "GEN.12.7",
                "verseOrgIds": [
                  "GEN.12.7"
                ]
              }
            }
          ]
        },
        {
          "text": "tí ó fi ara hàn án.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.7",
            "verseOrgIds": [
              "GEN.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì kúrò níbẹ̀ lọ sí agbègbè àwọn òkè kan ní ìhà ìlà-oòrùn Beteli, ó sì pàgọ́ rẹ̀ síbẹ̀. Beteli wà ní ìwọ̀-oòrùn, Ai wà ní ìlà-oòrùn. Ó tẹ́ pẹpẹ kan níbẹ̀ fún",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.8",
            "verseOrgIds": [
              "GEN.12.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "GEN.12.8",
                "verseOrgIds": [
                  "GEN.12.8"
                ]
              }
            }
          ]
        },
        {
          "text": ", ó sì ké pe orúkọ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.8",
            "verseOrgIds": [
              "GEN.12.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "GEN.12.8",
                "verseOrgIds": [
                  "GEN.12.8"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.8",
            "verseOrgIds": [
              "GEN.12.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni Abramu tẹ̀síwájú sí ìhà gúúsù.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.9",
            "verseOrgIds": [
              "GEN.12.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abramu ní Ejibiti",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìyàn kan sì mú ní ilẹ̀ náà, Abramu sì sọ̀kalẹ̀ lọ sí Ejibiti láti ṣe àtìpó níbẹ̀ fún ìgbà díẹ̀, nítorí ìyàn náà mú gidigidi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.10",
            "verseOrgIds": [
              "GEN.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ó ti ku díẹ̀ kí ó wọ Ejibiti, ó wí fún Sarai, aya rẹ̀ pé, \"Mo mọ̀ pé arẹwà obìnrin ni ìwọ,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.11",
            "verseOrgIds": [
              "GEN.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "nígbà tí àwọn ará Ejibiti bá rí ọ, wọn yóò wí pé, 'Aya rẹ̀ nìyí.' Wọn yóò si pa mí, ṣùgbọ́n wọn yóò dá ọ sí.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.12",
            "verseOrgIds": [
              "GEN.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà, sọ pé, arábìnrin mi ni ìwọ, wọn yóò sì ṣe mí dáradára, a ó sì dá ẹ̀mí mi sí nítorí tìrẹ.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.13",
            "verseOrgIds": [
              "GEN.12.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí Abramu dé Ejibiti, àwọn ará Ejibiti ri i pé aya rẹ̀ rẹwà gidigidi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.14",
            "verseOrgIds": [
              "GEN.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí àwọn ìjòyè Farao sì rí i, wọ́n ròyìn rẹ̀ níwájú Farao, wọ́n sì mú un lọ sí ààfin.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.15",
            "verseOrgIds": [
              "GEN.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì kẹ́ Abramu dáradára nítorí Sarai, Abramu sì ní àgùntàn àti màlúù, akọ àti abo kẹ́tẹ́kẹ́tẹ́, ìránṣẹ́kùnrin àti ìránṣẹ́bìnrin, pẹ̀lú ìbákasẹ.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.16",
            "verseOrgIds": [
              "GEN.12.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "GEN.12.17",
                "verseOrgIds": [
                  "GEN.12.17"
                ]
              }
            }
          ]
        },
        {
          "text": "sì rán àjàkálẹ̀-ààrùn búburú sí Farao àti ilé rẹ̀, nítorí Sarai aya Abramu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.17",
            "verseOrgIds": [
              "GEN.12.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 12:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà Farao ránṣẹ́ pe Abramu, ó sì wí fun pé, \"Èwo ni ìwọ ṣe sí mi yìí? Kí ló dé tí ìwọ kò sọ fún mi pé aya rẹ ní í ṣe?",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.18",
            "verseOrgIds": [
              "GEN.12.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 12:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èéṣe tí o fi wí pé, 'Arábìnrin mi ni,' tí èmi sì fi fẹ́ ẹ gẹ́gẹ́ bí aya? Nítorí náà nísinsin yìí, aya rẹ náà nìyí, mú un kí o sì máa lọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.19",
            "verseOrgIds": [
              "GEN.12.19"
            ]
          }
        },
        {
          "name": "verse",
