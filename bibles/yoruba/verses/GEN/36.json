          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baálẹ̀ Oholibama, baálẹ̀ Ela, baálẹ̀ Pinoni,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.41",
            "verseOrgIds": [
              "GEN.36.41"
            ]
          }
        }
      ]
    },
