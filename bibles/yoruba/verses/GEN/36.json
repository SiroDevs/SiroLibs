      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "GEN 36:29"
      },
      "items": [
        {
          "text": "Lotani, Ṣobali, Sibeoni, Ana,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.29",
            "verseOrgIds": [
              "GEN.36.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
