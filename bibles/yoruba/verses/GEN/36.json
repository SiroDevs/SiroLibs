      "type": "tag",
      "attrs": {
        "style": "li4",
        "vid": "GEN 36:43"
      },
      "items": [
        {
          "text": "Èyí ni Esau baba àwọn ará Edomu.",
          "type": "text"
        }
      ]
    }
