          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Magdieli, àti Iramu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.43",
            "verseOrgIds": [
              "GEN.36.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4",
        "vid": "GEN 36:43"
      },
      "items": [
        {
          "text": "Àwọn wọ̀nyí ni baálẹ̀ Edomu, gẹ́gẹ́ bí wọn ti tẹ̀dó sí ilẹ̀ tí wọ́n gbà.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
