  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "39",
        "style": "c",
        "sid": "GEN 39"
      },
      "items": [
        {
          "text": "39",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Josẹfu àti aya Potifari",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 39:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí wọ́n mú Josẹfu dé Ejibiti, Potifari, ará Ejibiti tí i ṣe ọ̀kan nínú àwọn ìjòyè Farao. Òun ni olórí àwọn ọmọ-ogun Farao. Ó ra Josẹfu lọ́wọ́ àwọn ará Iṣmaeli tí wọ́n mú un lọ síbẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.1",
            "verseOrgIds": [
              "GEN.39.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 39:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "GEN.39.2",
                "verseOrgIds": [
                  "GEN.39.2"
                ]
              }
            }
          ]
        },
        {
          "text": "sì wà pẹ̀lú Josẹfu, ó sì bùkún un, ó sì ń gbé ní ilé ọ̀gá rẹ̀ ará Ejibiti.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.2",
            "verseOrgIds": [
              "GEN.39.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 39:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí ọ̀gá rẹ̀ rí i pé",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.3",
            "verseOrgIds": [
              "GEN.39.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "GEN.39.3",
                "verseOrgIds": [
                  "GEN.39.3"
                ]
              }
            }
          ]
        },
        {
          "text": "wà pẹ̀lú rẹ̀, àti pé",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.3",
            "verseOrgIds": [
              "GEN.39.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "GEN.39.3",
                "verseOrgIds": [
                  "GEN.39.3"
                ]
              }
            }
          ]
        },
        {
          "text": "jẹ́ kí ó máa ṣe àṣeyọrí nínú ohun gbogbo tí ó dáwọ́ rẹ̀ lé.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.3",
            "verseOrgIds": [
              "GEN.39.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 39:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Josẹfu sì rí ojúrere Potifari, ó sì di aṣojú rẹ̀, Potifari fi Josẹfu ṣe olórí ilé rẹ̀ àti ohun gbogbo tí ó ní.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.4",
            "verseOrgIds": [
              "GEN.39.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 39:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Láti ìgbà tí ó ti fi Josẹfu jẹ olórí ilé rẹ̀ àti ohun ìní rẹ̀ gbogbo, ni Ọlọ́run ti bẹ̀rẹ̀ sí ní bùkún àwọn ará Ejibiti nítorí Josẹfu. Ìbùkún",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.5",
            "verseOrgIds": [
              "GEN.39.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "GEN.39.5",
                "verseOrgIds": [
                  "GEN.39.5"
                ]
              }
            }
          ]
        },
        {
          "text": "wà lórí gbogbo ohun tí Potifari ní, nílé àti lóko.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.5",
            "verseOrgIds": [
              "GEN.39.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 39:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì fi Josẹfu ṣe àkóso gbogbo ohun tí ó ní. Kò sì ṣe ìyọnu lórí ohunkóhun mọ àyàfi nípa oúnjẹ tí ó ń jẹ láti ìgbà tí ó ti fi Josẹfu ṣe àkóso ilé e rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.6",
            "verseOrgIds": [
              "GEN.39.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 39:6"
      },
      "items": [
        {
          "text": "Josẹfu sì jẹ́ arẹwà ọkùnrin ní ìdúró àti ìrísí rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.6",
            "verseOrgIds": [
              "GEN.39.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 39:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "lẹ́yìn ìgbà díẹ̀, aya rẹ̀ ṣe àkíyèsí Josẹfu, ó sì wí fún un pé, \"Wá bá mi lòpọ̀!\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.7",
            "verseOrgIds": [
              "GEN.39.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 39:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n Josẹfu kọ̀, ó sì wí fún aya ọ̀gá rẹ̀ pé, \"Kíyèsi, Olúwa mi kò fi ohunkóhun dù mi nínú ilé yìí, gbogbo ohun ìní rẹ̀ ni ó fi lé mi lọ́wọ́.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.8",
            "verseOrgIds": [
              "GEN.39.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 39:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kò sí ẹni tí ó jù mi lọ nínú ilé yìí, ọ̀gá mi kò fi ohunkóhun dù mi àyàfi ìwọ, tí í ṣe aya rẹ̀. Báwo ni mo ṣe lè ṣe ohun búburú yìí, kí ń sì ṣẹ̀ sí Ọlọ́run?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.9",
            "verseOrgIds": [
              "GEN.39.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 39:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ó tilẹ̀ jẹ́ pé gbogbo ìgbà ni ó ń tẹnumọ́ èyí fún Josẹfu, Josẹfu kọ̀ láti bá a lòpọ̀. Ó tilẹ̀ kọ̀ láti máa dúró ni ibi tí ó bá wà.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.10",
            "verseOrgIds": [
              "GEN.39.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 39:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọjọ́ kan, Josẹfu lọ sínú ilé láti ṣe iṣẹ́, kò sì sí èyíkéyìí nínú àwọn ìránṣẹ́ ní tòsí.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.11",
            "verseOrgIds": [
              "GEN.39.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 39:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì di aṣọ Josẹfu mú, ó sì wí pé, \"Wá bá mi lòpọ̀!\" Ṣùgbọ́n Josẹfu fi aṣọ rẹ̀ sílẹ̀ sí i lọ́wọ́, ó sì sá jáde.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.12",
            "verseOrgIds": [
              "GEN.39.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 39:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí ó rí i pé ó ti fi aṣọ rẹ̀ sílẹ̀ sí òun lọ́wọ́, ó sì ti sá jáde,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.13",
            "verseOrgIds": [
              "GEN.39.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 39:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "ó pe àwọn ìránṣẹ́ ilé náà, ó sì wí fún wọn pé, \"Ẹ wò ó, ọkọ ọ̀ mi mú Heberu kan wọlé tọ̀ wá wá láti fi wá ṣe ẹlẹ́yà. Ó wọlé tọ̀ mí wá, láti bá mi lòpọ̀, ṣùgbọ́n mo kígbe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.14",
            "verseOrgIds": [
              "GEN.39.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 39:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí ó gbọ́ pé mo gbé ohùn mi sókè, tí mo sì kígbe, ó jọ̀wọ́ aṣọ rẹ̀ sọ́dọ̀ mi, ó sì sá, ó bọ́ sóde.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.15",
            "verseOrgIds": [
              "GEN.39.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 39:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì fi aṣọ náà sọ́dọ̀ títí tí ọkọ rẹ̀ fi dé.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.16",
            "verseOrgIds": [
              "GEN.39.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 39:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó rò fún un pé, \"Ẹrú ará Heberu tí o rà wá ilé láti fi wá ṣẹlẹ́yà wá láti bá mi lòpọ̀.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.17",
            "verseOrgIds": [
              "GEN.39.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 39:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n bí mo ti kígbe fún ìrànlọ́wọ́, ó sì sá kúrò nínú ilé.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.18",
            "verseOrgIds": [
              "GEN.39.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 39:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí Potifari gbọ́ ọ̀rọ̀ aya rẹ̀ pé báyìí ni ẹrú rẹ̀ ṣe sí aya rẹ̀, ó bínú gidigidi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.19",
            "verseOrgIds": [
              "GEN.39.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 39:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì ju Josẹfu sí ẹ̀wọ̀n, níbi tí a ń ju àwọn ẹlẹ́wọ̀n ọba sí.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.20",
            "verseOrgIds": [
              "GEN.39.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 39:20"
      },
      "items": [
        {
          "text": "Ṣùgbọ́n, nígbà tí Josẹfu wà nínú ẹ̀wọ̀n níbẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.20",
            "verseOrgIds": [
              "GEN.39.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 39:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "GEN.39.21",
                "verseOrgIds": [
                  "GEN.39.21"
                ]
              }
            }
          ]
        },
        {
          "text": "sì wà pẹ̀lú rẹ̀, ó sì ṣàánú fún un, ó sì mú kí ó rí ojúrere àwọn alábojútó ọgbà ẹ̀wọ̀n.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.21",
            "verseOrgIds": [
              "GEN.39.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 39:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà, alábojútó ọgbà ẹlẹ́wọ̀n fi Josẹfu ṣe alákòóso ohun gbogbo tí ó wà nínú ẹ̀wọ̀n, àti ohun tí wọn ń ṣe níbẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.22",
            "verseOrgIds": [
              "GEN.39.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 39:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́dà náà kò sì mikàn nípa gbogbo ohun tí ó fi sí abẹ́ àkóso Josẹfu, nítorí pé",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.23",
            "verseOrgIds": [
              "GEN.39.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
