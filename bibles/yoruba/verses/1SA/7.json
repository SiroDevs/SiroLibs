  "verseCount": 17,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "7",
        "style": "c",
        "sid": "1SA 7"
      },
      "items": [
        {
          "text": "7",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "nb"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà àwọn ará Kiriati-Jearimu wá, wọ́n sì gbé àpótí ẹ̀rí",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.1",
            "verseOrgIds": [
              "1SA.7.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.7.1",
                "verseOrgIds": [
                  "1SA.7.1"
                ]
              }
            }
          ]
        },
        {
          "text": ". Wọ́n gbé e lọ sí ilé Abinadabu lórí òkè, wọ́n sì ya Eleasari ọmọ rẹ̀ sí mímọ́ láti ṣọ́ àpótí ẹ̀rí",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.1",
            "verseOrgIds": [
              "1SA.7.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.7.1",
                "verseOrgIds": [
                  "1SA.7.1"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.1",
            "verseOrgIds": [
              "1SA.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Samuẹli ṣẹ́gun àwọn ará Filistini ní Mispa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì jẹ́ ní ìgbà pípẹ́, ogún ọdún ni àpótí ẹ̀rí",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.2",
            "verseOrgIds": [
              "1SA.7.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.7.2",
                "verseOrgIds": [
                  "1SA.7.2"
                ]
              }
            }
          ]
        },
        {
          "text": "fi wà ní Kiriati-Jearimu. Gbogbo ilé Israẹli ṣọ̀fọ̀ wọ́n sì pohùnréré ẹkún sí",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.2",
            "verseOrgIds": [
              "1SA.7.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.7.2",
                "verseOrgIds": [
                  "1SA.7.2"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.2",
            "verseOrgIds": [
              "1SA.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samuẹli sọ fún gbogbo ilé Israẹli pé, \"Tí ẹ bá ń padà sí ọ̀dọ̀",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.3",
            "verseOrgIds": [
              "1SA.7.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.7.3",
                "verseOrgIds": [
                  "1SA.7.3"
                ]
              }
            }
          ]
        },
        {
          "text": "pẹ̀lú gbogbo ọkàn yín, ẹ yẹra kúrò lọ́dọ̀ ọlọ́run àjèjì àti Aṣtoreti kí ẹ sì fi ara yín jì fún",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.3",
            "verseOrgIds": [
              "1SA.7.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.7.3",
                "verseOrgIds": [
                  "1SA.7.3"
                ]
              }
            }
          ]
        },
        {
          "text": "kí ẹ sì sin òun nìkan ṣoṣo, òun yóò sì gbà yín kúrò lọ́wọ́ àwọn ará Filistini.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.3",
            "verseOrgIds": [
              "1SA.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni àwọn ọmọ Israẹli yẹra fún Baali àti Aṣtoreti, wọ́n sì sin",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.4",
            "verseOrgIds": [
              "1SA.7.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.7.4",
                "verseOrgIds": [
                  "1SA.7.4"
                ]
              }
            }
          ]
        },
        {
          "text": "nìkan ṣoṣo.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.4",
            "verseOrgIds": [
              "1SA.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni, Samuẹli wí pé, \"Ẹ kó gbogbo àwọn ọmọ Israẹli jọ sí Mispa, èmi yóò bẹ̀bẹ̀ fún un yín lọ́dọ̀",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.5",
            "verseOrgIds": [
              "1SA.7.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.7.5",
                "verseOrgIds": [
                  "1SA.7.5"
                ]
              }
            }
          ]
        },
        {
          "text": ".\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.5",
            "verseOrgIds": [
              "1SA.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí wọ́n sì ti péjọpọ̀ ní Mispa, wọ́n pọn omi, wọ́n sì dà á sílẹ̀ níwájú",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.6",
            "verseOrgIds": [
              "1SA.7.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.7.6",
                "verseOrgIds": [
                  "1SA.7.6"
                ]
              }
            }
          ]
        },
        {
          "text": ". Ní ọjọ́ náà, wọ́n gbààwẹ̀, wọ́n sì jẹ́wọ́ pé, \"Àwa ti ṣẹ̀ sí",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.6",
            "verseOrgIds": [
              "1SA.7.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.7.6",
                "verseOrgIds": [
                  "1SA.7.6"
                ]
              }
            }
          ]
        },
        {
          "text": ".\" Samuẹli sì jẹ́ olórí àwọn ọmọ Israẹli ní Mispa.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.6",
            "verseOrgIds": [
              "1SA.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí àwọn Filistini gbọ́ pé àwọn Israẹli ti péjọ ní Mispa, àwọn aláṣẹ Filistini gòkè wá láti kọlù wọ́n. Nígbà tí àwọn ọmọ Israẹli gbọ́ èyí, ẹ̀rù bà wọ́n nítorí àwọn Filistini.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.7",
            "verseOrgIds": [
              "1SA.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n sọ fún Samuẹli pé, \"Má ṣe dákẹ́ kíké pe",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.8",
            "verseOrgIds": [
              "1SA.7.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.7.8",
                "verseOrgIds": [
                  "1SA.7.8"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run wa fún wa, ké pè é kí ó lè gbà wá kúrò lọ́wọ́ àwọn Filistini.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.8",
            "verseOrgIds": [
              "1SA.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni Samuẹli mú ọ̀dọ́-àgùntàn tí ó jẹ́ ọmọ ọmú, ó sì fi rú ẹbọ sísun sí",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.9",
            "verseOrgIds": [
              "1SA.7.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.7.9",
                "verseOrgIds": [
                  "1SA.7.9"
                ]
              }
            }
          ]
        },
        {
          "text": ". Ó sí ké pe",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.9",
            "verseOrgIds": [
              "1SA.7.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.7.9",
                "verseOrgIds": [
                  "1SA.7.9"
                ]
              }
            }
          ]
        },
        {
          "text": "nítorí ilé Israẹli,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.9",
            "verseOrgIds": [
              "1SA.7.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.7.9",
                "verseOrgIds": [
                  "1SA.7.9"
                ]
              }
            }
          ]
        },
        {
          "text": "sì dá a lóhùn.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.9",
            "verseOrgIds": [
              "1SA.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí Samuẹli ń ṣe ìrúbọ ẹbọ sísun, àwọn Filistini súnmọ́ tòsí láti bá Israẹli ja ogun. Ṣùgbọ́n ní ọjọ́ náà,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.10",
            "verseOrgIds": [
              "1SA.7.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.7.10",
                "verseOrgIds": [
                  "1SA.7.10"
                ]
              }
            }
          ]
        },
        {
          "text": "sán àrá ńlá lu àwọn Filistini, ó sì mú jìnnìjìnnì bá wọn, a sì lé wọn níwájú àwọn ọmọ Israẹli.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.10",
            "verseOrgIds": [
              "1SA.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ọkùnrin Israẹli tú jáde láti Mispa. Wọ́n sì ń lépa àwọn Filistini, wọ́n sì pa wọ́n ní àpá rìn títí dé abẹ́ Beti-Kari.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.11",
            "verseOrgIds": [
              "1SA.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samuẹli mú òkúta kan ó sì fi lélẹ̀ láàrín Mispa àti Ṣeni, ó sì pe orúkọ rẹ̀ ní Ebeneseri, wí pé, \"Ibí ni",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.12",
            "verseOrgIds": [
              "1SA.7.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.7.12",
                "verseOrgIds": [
                  "1SA.7.12"
                ]
              }
            }
          ]
        },
        {
          "text": "ràn wá lọ́wọ́ dé.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.12",
            "verseOrgIds": [
              "1SA.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ ni wọ́n ṣẹ́gun Filistini, wọn kò sì wá sí agbègbè àwọn ọmọ Israẹli mọ́.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.13",
            "verseOrgIds": [
              "1SA.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 7:13"
      },
      "items": [
        {
          "text": "Ní gbogbo ìgbésí ayé Samuẹli, ọwọ́",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.13",
            "verseOrgIds": [
              "1SA.7.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.7.13",
                "verseOrgIds": [
                  "1SA.7.13"
                ]
              }
            }
          ]
        },
        {
          "text": "lòdì sí àwọn Filistini.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.13",
            "verseOrgIds": [
              "1SA.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ìlú láti Ekroni dé Gati tí àwọn Filistini ti gbà lọ́wọ́ Israẹli ni ó ti gbà padà fún Israẹli, ó sì gba gbogbo ilẹ̀ agbègbè rẹ̀ kúrò lọ́wọ́ ìṣàkóso àwọn Filistini. Ìrẹ́pọ̀ sì wà láàrín Israẹli àti àwọn Amori.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.14",
            "verseOrgIds": [
              "1SA.7.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samuẹli tẹ̀síwájú gẹ́gẹ́ bí adájọ́ lórí Israẹli. Ní ọjọ́ ayé e rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.15",
            "verseOrgIds": [
              "1SA.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Láti ọdún dé ọdún, ó lọ yíká láti Beteli dé Gilgali dé Mispa, ó sì ń ṣe ìdájọ́ Israẹli ní gbogbo ibi wọ̀nyí.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.16",
            "verseOrgIds": [
              "1SA.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n ó máa ń padà sí ilé rẹ̀ ní Rama, níbí tí ilé rẹ̀ wà, ó sì túnṣe ìdájọ́ Israẹli níbẹ̀, ó sì kọ́ pẹpẹ kan síbẹ̀ fún",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.17",
            "verseOrgIds": [
              "1SA.7.17"
            ]
          }
        },
