  "verseCount": 11,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "29",
        "style": "c",
        "sid": "1SA 29"
      },
      "items": [
        {
          "text": "29",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Akiṣi rán Dafidi sí Siklagi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 29:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn Filistini sì kó gbogbo ogun wọn jọ sí Afeki: Israẹli sì dó ni ibi ìsun omi tí ó wà ní Jesreeli.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.1",
            "verseOrgIds": [
              "1SA.29.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 29:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ìjòyè Filistini sì kọjá ní ọ̀rọ̀ọ̀rún àti lẹgbẹẹgbẹ̀rún; Dafidi àti àwọn ọmọkùnrin rẹ̀ pẹ̀lú Akiṣi sì kẹ́yìn.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.2",
            "verseOrgIds": [
              "1SA.29.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 29:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ìjòyè Filistini sì béèrè wí pé, \"Kín ni àwọn Heberu ń ṣe níhìn-ín yìí?\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.3",
            "verseOrgIds": [
              "1SA.29.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 29:3"
      },
      "items": [
        {
          "text": "Akiṣi sì wí fún àwọn ìjòyè Filistini pé \"Dafidi kọ yìí, ìránṣẹ́ Saulu ọba Israẹli, tí ó wà lọ́dọ̀ mi láti ọjọ́ wọ̀nyí tàbí láti ọdún wọ̀nyí, èmi kò ì tì í rí àṣìṣe kan ni ọwọ́ rẹ̀ láti ọjọ́ tí ó ti dé ọ̀dọ̀ mi títí di òní yìí.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.3",
            "verseOrgIds": [
              "1SA.29.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 29:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ìjòyè Filistini sì bínú sí i; àwọn ìjòyè Filistini sì wí fún un pé, \"Jẹ́ kí ọkùnrin yìí padà kí ó sì lọ sí ipò rẹ̀ tí ó fi fún un, kí ó má sì jẹ́ kí ó bá wa sọ̀kalẹ̀ lọ sí ogun, kí ó má ba à jásí ọ̀tá fún wa ni ogun, kín ni òun ó fi ba olúwa rẹ̀ làjà, orí àwọn ènìyàn wọ̀nyí kọ́?",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.4",
            "verseOrgIds": [
              "1SA.29.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 29:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣé èyí ni Dafidi tiwọn torí rẹ̀ gberin ara wọn nínú ijó wí pé,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.5",
            "verseOrgIds": [
              "1SA.29.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "1SA 29:5"
      },
      "items": [
        {
          "text": "\" 'Saulu pa ẹgbẹ̀rún rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.5",
            "verseOrgIds": [
              "1SA.29.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1SA 29:5"
      },
      "items": [
        {
          "text": "Dafidi si pa ẹgbẹgbàarùn-ún tirẹ̀.' \"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.5",
            "verseOrgIds": [
              "1SA.29.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 29:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akiṣi sì pe Dafidi, ó sì wí fún un pé, \"Bí",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.6",
            "verseOrgIds": [
              "1SA.29.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.29.6",
                "verseOrgIds": [
                  "1SA.29.6"
                ]
              }
            }
          ]
        },
        {
          "text": "ti ń bẹ láààyè, ìwọ jẹ́ olóòótọ́ àti ẹni ìwà rere lójú mi, ní àlọ rẹ àti ààbọ̀ rẹ pẹ̀lú mi ní ogun: nítorí pé èmi ko tí ì ri búburú kan lọ́wọ́ rẹ́ láti ọjọ́ ti ìwọ ti tọ̀ mí wá, títí o fi dì òní yìí ṣùgbọ́n lójú àwọn ìjòyè, ìwọ kò ṣe ẹni tí ó tọ́.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.6",
            "verseOrgIds": [
              "1SA.29.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 29:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ǹjẹ́ yípadà kí o sì máa lọ ní àlàáfíà, kí ìwọ má ṣe bà àwọn Filistini nínú jẹ́.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.7",
            "verseOrgIds": [
              "1SA.29.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 29:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dafidi sì wí fún Akiṣi pé, \"Kín ni èmi ṣe? Kín ni ìwọ sì rí lọ́wọ́ ìránṣẹ́ rẹ láti ọjọ́ ti èmi ti ń gbé níwájú rẹ títí di òní yìí, tí èmi kì yóò fi lọ bá àwọn ọ̀tá ọba jà.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.8",
            "verseOrgIds": [
              "1SA.29.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 29:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akiṣi sì dáhùn, ó sì wí fún Dafidi pé, \"Èmi mọ̀ pé ìwọ ṣe ẹni rere lójú mi, bi angẹli Ọlọ́run; ṣùgbọ́n àwọn ìjòyè Filistini wí pé, 'Òun kì yóò bá wa lọ sí ogun.'",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.9",
            "verseOrgIds": [
              "1SA.29.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 29:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ǹjẹ́, nísinsin yìí dìde ní òwúrọ̀ pẹ̀lú àwọn ìránṣẹ́ olúwa rẹ tí ó bá ọ wá, ki ẹ si dìde ní òwúrọ̀ nígbà tí ilẹ̀ bá mọ́ kí ẹ sì máa lọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.10",
            "verseOrgIds": [
              "1SA.29.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 29:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dafidi àti àwọn ọmọkùnrin rẹ̀ sì dìde ní òwúrọ̀ láti padà lọ sí ilẹ̀ àwọn Filistini. Àwọn Filistini sì gòkè lọ sí Jesreeli.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.11",
            "verseOrgIds": [
              "1SA.29.11"
            ]
          }
        }
      ]
    }
  ],
