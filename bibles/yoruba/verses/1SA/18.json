  "verseCount": 30,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "18",
        "style": "c",
        "sid": "1SA 18"
      },
      "items": [
        {
          "text": "18",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Saulu ń jowú Dafidi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 18:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lẹ́yìn ìgbà tí Dafidi ti parí ọ̀rọ̀ tí ó ń bá Saulu sọ, ọkàn Jonatani di ọ̀kan pẹ̀lú ti Dafidi, ó sì fẹ́ràn rẹ̀ gẹ́gẹ́ bí ara rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.1",
            "verseOrgIds": [
              "1SA.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Láti ọjọ́ náà Saulu pa Dafidi mọ́ sí ọ̀dọ̀ rẹ̀ kò sì jẹ́ kí ó padà sí ilé baba rẹ̀ mọ́.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.2",
            "verseOrgIds": [
              "1SA.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jonatani bá Dafidi dá májẹ̀mú nítorí tí ó fẹ́ràn rẹ̀ gẹ́gẹ́ bí ara rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.3",
            "verseOrgIds": [
              "1SA.18.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jonatani sì bọ́ aṣọ ìgúnwà, ó sì fi fun Dafidi pẹ̀lú aṣọ àwọ̀tẹ́lẹ̀ rẹ̀ àti pẹ̀lú idà rẹ̀, ọrun rẹ̀ àti àmùrè rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.4",
            "verseOrgIds": [
              "1SA.18.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ohunkóhun tí Saulu bá rán an láti ṣe, Dafidi máa ṣe ní àṣeyọrí, Saulu náà sì fun un ní ipò tí ó ga jù láàrín àwọn ológun. Eléyìí sì tẹ́ gbogbo ènìyàn lọ́rùn, àti pẹ̀lú ó sì tẹ́ àwọn ìjòyè Saulu lọ́rùn pẹ̀lú.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.5",
            "verseOrgIds": [
              "1SA.18.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí àwọn ènìyàn padà sí ilé lẹ́yìn ìgbà tí Dafidi ti pa Filistini, gbogbo àwọn obìnrin tú jáde láti inú ìlú Israẹli wá láti pàdé ọba Saulu pẹ̀lú orin àti ijó, pẹ̀lú orin ayọ̀ àti tambori àti ohun èlò orin olókùn.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.6",
            "verseOrgIds": [
              "1SA.18.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí wọ́n ṣe ń jó, bẹ́ẹ̀ ni wọ́n ń kọrin pé,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.7",
            "verseOrgIds": [
              "1SA.18.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "1SA 18:7"
      },
      "items": [
        {
          "text": "\"Saulu pa ẹgbẹ̀rún tirẹ̀",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.7",
            "verseOrgIds": [
              "1SA.18.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1SA 18:7"
      },
      "items": [
        {
          "text": "Dafidi sì pa ẹgbẹẹgbàárún ní tirẹ̀.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.7",
            "verseOrgIds": [
              "1SA.18.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saulu sì bínú gidigidi, ọ̀rọ̀ náà sì korò létí rẹ̀ pé, \"Wọ́n ti gbé ògo fún Dafidi pẹ̀lú ẹgbẹẹgbàárún,\" ó sì wí pé, \"ṣùgbọ́n èmi pẹ̀lú ẹgbẹ̀rún kan. Kí ni ó kù kí ó gbà bí kò ṣe ìjọba?\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.8",
            "verseOrgIds": [
              "1SA.18.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Láti ìgbà náà lọ ni Saulu ti bẹ̀rẹ̀ sí ní fi ojú ìlara wo Dafidi.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.9",
            "verseOrgIds": [
              "1SA.18.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọjọ́ kejì ẹ̀mí búburú láti ọ̀dọ̀ Ọlọ́run wá pẹ̀lú agbára sórí Saulu, ó sì sọ àsọtẹ́lẹ̀ ní ilé rẹ̀ nígbà tí Dafidi sì ń fọn ohun èlò orin olókùn, gẹ́gẹ́ bí ó ti máa ń ṣe láti ẹ̀yìn wá, Saulu sì ní ọ̀kọ̀ kan ní ọwọ́ rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.10",
            "verseOrgIds": [
              "1SA.18.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì gbé e sókè, ó sì wí fún ara rẹ̀ pé, \"Èmi yóò gún Dafidi pọ̀ mọ́ ògiri.\" Ṣùgbọ́n, Dafidi yẹ̀ fún un lẹ́ẹ̀méjì.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.11",
            "verseOrgIds": [
              "1SA.18.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saulu sì ń bẹ̀rù Dafidi nítorí pé",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.12",
            "verseOrgIds": [
              "1SA.18.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.18.12",
                "verseOrgIds": [
                  "1SA.18.12"
                ]
              }
            }
          ]
        },
        {
          "text": "wà pẹ̀lú Dafidi, ṣùgbọ́n ó ti fi Saulu sílẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.12",
            "verseOrgIds": [
              "1SA.18.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì lé Dafidi jáde ní ọ̀dọ̀ rẹ̀, ó sì fi jẹ olórí ogun ẹgbẹ̀rún kan (1,000), Dafidi ń kó wọn lọ, ó ń kó wọn bọ̀ nínú ìgbòkègbodò ogun.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.13",
            "verseOrgIds": [
              "1SA.18.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dafidi sì ṣe ọlọ́gbọ́n ní gbogbo ìṣe rẹ̀, nítorí tí",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.14",
            "verseOrgIds": [
              "1SA.18.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.18.14",
                "verseOrgIds": [
                  "1SA.18.14"
                ]
              }
            }
          ]
        },
        {
          "text": "wà pẹ̀lú rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.14",
            "verseOrgIds": [
              "1SA.18.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí Saulu rí bi àṣeyọrí rẹ̀ ti tó, ó sì bẹ̀rù rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.15",
            "verseOrgIds": [
              "1SA.18.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n gbogbo Israẹli àti Juda ni wọ́n fẹ́ràn Dafidi, nítorí ó darí wọn lọ ní ìgbòkègbodò ogun wọn.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.16",
            "verseOrgIds": [
              "1SA.18.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saulu wí fún Dafidi pé, \"Èyí ni àgbà nínú àwọn ọmọbìnrin mi Merabu. Èmi yóò fi òun fún ọ ní aya. Kí ìwọ sìn mí bí akọni, kí o sì máa ja ogun",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.17",
            "verseOrgIds": [
              "1SA.18.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.18.17",
                "verseOrgIds": [
                  "1SA.18.17"
                ]
              }
            }
          ]
        },
        {
          "text": ".\" Nítorí tí Saulu wí fún ara rẹ̀ pé, \"Èmi kì yóò gbé ọwọ́ mi sókè sí i. Jẹ́ kí àwọn Filistini ṣe èyí.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.17",
            "verseOrgIds": [
              "1SA.18.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n Dafidi wí fún Saulu pé, \"Ta ni mí, kí sì ni ìdílé mi tàbí ìdílé baba mi ní Israẹli, tí èmi yóò di àna ọba?\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.18",
            "verseOrgIds": [
              "1SA.18.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 18:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí àkókò tó fún Merabu, ọmọbìnrin Saulu, láti fi fún Dafidi, ni a sì fi fún Adrieli ará Mehola ní aya.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.19",
            "verseOrgIds": [
              "1SA.18.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 18:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nísinsin yìí ọmọbìnrin Saulu Mikali sì fẹ́ràn Dafidi, nígbà tí wọ́n sọ fún Saulu nípa rẹ̀, ó sì dùn mọ́ ọn.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.20",
            "verseOrgIds": [
              "1SA.18.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 18:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sọ nínú ara rẹ̀ pé, \"Èmi yóò fi fún un kí òun ba à le jẹ́ ìkẹ́kùn fún un, kí ọwọ́ àwọn ará Filistini lè wà lára rẹ̀.\" Nígbà náà ni Saulu wí fún Dafidi pé, \"Nísinsin yìí ìwọ ní àǹfààní eléyìí láti jẹ́ àna án mi.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.21",
            "verseOrgIds": [
              "1SA.18.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 18:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saulu pàṣẹ fún àwọn ìránṣẹ́ rẹ̀ pé, \"Ẹ sọ fún Dafidi ní ìkọ̀kọ̀, kí ẹ sì wí pé, 'Wò ó, inú ọba dùn sí ọ, gbogbo àwọn ìránṣẹ́ rẹ̀ ni ó fẹ́ràn rẹ, nísinsin yìí jẹ́ àna ọba.' \"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.22",
            "verseOrgIds": [
              "1SA.18.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1SA 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n tún ọ̀rọ̀ náà sọ fún Dafidi. Ṣùgbọ́n Dafidi wí pé, \"Ṣé ẹ rò pé ohun kékeré ni láti jẹ́ àna ọba? Mo jẹ́ tálákà ènìyàn àti onímọ̀ kékeré.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.23",
            "verseOrgIds": [
              "1SA.18.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1SA 18:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí àwọn ìránṣẹ́ Saulu sọ fún un ohun tí Dafidi sọ,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.24",
            "verseOrgIds": [
              "1SA.18.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1SA 18:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saulu dáhùn pé, \"Sọ fún Dafidi pé, 'Ọba kò fẹ́ owó orí láti ọ̀dọ̀ àna rẹ̀ ju awọ iwájú orí ọgọ́rùn-ún Filistini lọ láti fi gba ẹ̀san lórí àwọn ọ̀tá rẹ̀.' \" Èrò Saulu ni wí pé kí Dafidi ṣubú sí ọwọ́ àwọn ará Filistini.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.25",
            "verseOrgIds": [
              "1SA.18.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1SA 18:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí àwọn ìránṣẹ́ sọ àwọn nǹkan yìí fún Dafidi, inú rẹ̀ dùn láti di àna ọba kí àkókò tí ó dá tó kọjá,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.26",
            "verseOrgIds": [
              "1SA.18.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1SA 18:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dafidi àti àwọn arákùnrin rẹ̀ jáde lọ wọ́n sì pa igba lára àwọn Filistini. Ó kó awọ iwájú orí wọn wá, ó sì pé iye tí ọba fẹ́ kí ó ba à lè jẹ́ àna ọba. Saulu sì fi ọmọ obìnrin Mikali fún un ní aya.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.27",
            "verseOrgIds": [
              "1SA.18.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1SA 18:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí Saulu sì wá mọ̀ pé",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.28",
            "verseOrgIds": [
              "1SA.18.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.18.28",
                "verseOrgIds": [
                  "1SA.18.28"
                ]
              }
            }
          ]
        },
        {
          "text": "wà pẹ̀lú Dafidi tí ọmọbìnrin rẹ̀ Mikali sì fẹ́ràn Dafidi,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.28",
            "verseOrgIds": [
              "1SA.18.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1SA 18:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saulu sì tún wá bẹ̀rù Dafidi síwájú àti síwájú, Saulu sì wá di ọ̀tá Dafidi fún gbogbo ọjọ́ rẹ̀ tókù.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.29",
            "verseOrgIds": [
              "1SA.18.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1SA 18:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ọmọ-aládé Filistini tún tẹ̀síwájú láti lọ sí ogun, ó sì ṣe lẹ́yìn ìgbà tí wọ́n lọ, Dafidi ṣe àṣeyọrí ju gbogbo àwọn ìránṣẹ́ Saulu lọ, orúkọ rẹ̀ sì gbilẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.30",
            "verseOrgIds": [
              "1SA.18.30"
            ]
          }
        }
      ]
    }
  ],
