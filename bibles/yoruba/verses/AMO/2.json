            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "AMO.2.4",
                "verseOrgIds": [
                  "AMO.2.4"
                ]
              }
            }
          ]
        },
        {
          "text": "wí,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.4",
            "verseOrgIds": [
              "AMO.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 2:4"
      },
      "items": [
        {
          "text": "\"Nítorí ẹ̀ṣẹ̀ mẹ́ta ti Juda,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.4",
            "verseOrgIds": [
              "AMO.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 2:4"
      },
      "items": [
        {
          "text": "àní fún mẹ́rin, Èmi kò ní yí ìpinnu ìjìyà mi padà.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.4",
            "verseOrgIds": [
              "AMO.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 2:4"
      },
      "items": [
        {
          "text": "Nítorí wọn ti kọ òfin",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.4",
            "verseOrgIds": [
              "AMO.2.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "AMO.2.4",
                "verseOrgIds": [
                  "AMO.2.4"
                ]
              }
            }
          ]
        },
        {
          "text": "sílẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.4",
            "verseOrgIds": [
              "AMO.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 2:4"
      },
      "items": [
        {
          "text": "wọn kò sì pa àwọn ìlànà rẹ̀ mọ́.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.4",
            "verseOrgIds": [
              "AMO.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 2:4"
      },
      "items": [
        {
          "text": "Nítorí àwọn òrìṣà ti sì wọ́n lọ́nà,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.4",
            "verseOrgIds": [
              "AMO.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 2:4"
      },
      "items": [
        {
          "text": "òrìṣà tí àwọn Baba ńlá wọn ń tẹ̀lé,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.4",
            "verseOrgIds": [
              "AMO.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "AMO 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò rán iná sí orí Juda",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.5",
            "verseOrgIds": [
              "AMO.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 2:5"
      },
      "items": [
        {
          "text": "èyí tí yóò jó àwọn ààfin Jerusalẹmu run.\"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.5",
            "verseOrgIds": [
              "AMO.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìdájọ́ tí yóò wá sórí Israẹli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "AMO 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èyí ni ohun tí",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.6",
            "verseOrgIds": [
              "AMO.2.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "AMO.2.6",
                "verseOrgIds": [
                  "AMO.2.6"
                ]
              }
            }
          ]
        },
        {
          "text": "wí:",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.6",
            "verseOrgIds": [
              "AMO.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 2:6"
      },
      "items": [
        {
          "text": "\"Nítorí ẹ̀ṣẹ̀ mẹ́ta Israẹli",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.6",
            "verseOrgIds": [
              "AMO.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 2:6"
      },
      "items": [
        {
          "text": "àní fún mẹ́rin, Èmi kò ní yí ìpinnu ìjìyà mi padà.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.6",
            "verseOrgIds": [
              "AMO.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 2:6"
      },
      "items": [
        {
          "text": "Wọ́n ta olódodo fún fàdákà",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.6",
            "verseOrgIds": [
              "AMO.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 2:6"
      },
      "items": [
        {
          "text": "àti aláìní fún bàtà ẹsẹ̀ méjèèjì.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.6",
            "verseOrgIds": [
              "AMO.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "AMO 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n fi ẹsẹ̀ tẹ orí àwọn tálákà mọ́lẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.7",
            "verseOrgIds": [
              "AMO.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 2:7"
      },
      "items": [
        {
          "text": "bí wọ́n ti ń tẹ erùpẹ̀ ilẹ̀",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.7",
            "verseOrgIds": [
              "AMO.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 2:7"
      },
      "items": [
        {
          "text": "tí wọ́n ko sì ṣe òtítọ́ si àwọn tí a ni lára.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.7",
            "verseOrgIds": [
              "AMO.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 2:7"
      },
      "items": [
        {
          "text": "Baba àti ọmọ ń wọlé tọ wúńdíá kan náà,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.7",
            "verseOrgIds": [
              "AMO.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 2:7"
      },
      "items": [
        {
          "text": "láti ba orúkọ mímọ́ mi jẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.7",
            "verseOrgIds": [
              "AMO.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "AMO 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n dùbúlẹ̀ lẹ́bàá a pẹpẹ,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.8",
            "verseOrgIds": [
              "AMO.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 2:8"
      },
      "items": [
        {
          "text": "lórí aṣọ tí wọ́n fi jẹ́ ẹ̀jẹ́",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.8",
            "verseOrgIds": [
              "AMO.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 2:8"
      },
      "items": [
        {
          "text": "ní ilé òrìṣà wọn",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.8",
            "verseOrgIds": [
              "AMO.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 2:8"
      },
      "items": [
        {
          "text": "wọ́n sì mu ọtí tí wọ́n san fún ìtánràn.",
          "type": "text",
