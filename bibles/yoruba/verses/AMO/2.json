          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èyí ni ohun tí",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.1",
            "verseOrgIds": [
              "AMO.2.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "AMO.2.1",
                "verseOrgIds": [
                  "AMO.2.1"
                ]
              }
            }
          ]
        },
        {
          "text": "wí,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.1",
            "verseOrgIds": [
              "AMO.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 2:1"
      },
      "items": [
        {
          "text": "\"Nítorí ẹ̀ṣẹ̀ mẹ́ta ti Moabu,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.1",
            "verseOrgIds": [
              "AMO.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 2:1"
      },
      "items": [
        {
          "text": "àní fún mẹ́rin, Èmi kò ní yí ìpinnu ìjìyà mi padà,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.1",
            "verseOrgIds": [
              "AMO.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 2:1"
      },
      "items": [
        {
          "text": "nítorí ó ti sun ún, di eérú,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.1",
            "verseOrgIds": [
              "AMO.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 2:1"
      },
      "items": [
        {
          "text": "egungun ọba Edomu,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.1",
            "verseOrgIds": [
              "AMO.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "AMO 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò rán iná sí orí Moabu",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.2",
            "verseOrgIds": [
              "AMO.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 2:2"
      },
      "items": [
        {
          "text": "èyí tí yóò jó àwọn ààfin Kerioti run.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.2",
            "verseOrgIds": [
              "AMO.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 2:2"
      },
      "items": [
        {
          "text": "Moabu yóò sì kú pẹ̀lú ariwo",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.2",
            "verseOrgIds": [
              "AMO.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 2:2"
      },
      "items": [
        {
          "text": "pẹ̀lú igbe àti pẹ̀lú ìró ìpè.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.2",
            "verseOrgIds": [
              "AMO.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "AMO 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò ké onídàájọ́ rẹ̀ kúrò,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.3",
            "verseOrgIds": [
              "AMO.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 2:3"
      },
      "items": [
        {
          "text": "Èmi yóò sì pa gbogbo àwọn ọmọ-aládé rẹ́ nínú rẹ̀,\"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.3",
            "verseOrgIds": [
              "AMO.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 2:3"
      },
      "items": [
        {
          "text": "ni",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.3",
            "verseOrgIds": [
              "AMO.2.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "AMO.2.3",
                "verseOrgIds": [
                  "AMO.2.3"
                ]
              }
            }
          ]
        },
        {
          "text": "wí.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.3",
            "verseOrgIds": [
              "AMO.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
