  "verseCount": 14,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "21",
        "style": "c",
        "sid": "JER 21"
      },
      "items": [
        {
          "text": "21",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ọlọ́run kọ ìbéèrè Sedekiah sílẹ̀",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 21:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ̀rọ̀",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.1",
            "verseOrgIds": [
              "JER.21.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.21.1",
                "verseOrgIds": [
                  "JER.21.1"
                ]
              }
            }
          ]
        },
        {
          "text": "sì tọ Jeremiah wá nígbà tí ọba Sedekiah rán Paṣuri ọmọ Malkiah àti àlùfáà Sefaniah ọmọ Maaseiah sí i; wọ́n wí pé:",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.1",
            "verseOrgIds": [
              "JER.21.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Wádìí lọ́wọ́",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.2",
            "verseOrgIds": [
              "JER.21.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.21.2",
                "verseOrgIds": [
                  "JER.21.2"
                ]
              }
            }
          ]
        },
        {
          "text": "fún wa nítorí Nebukadnessari ọba Babeli ń kọlù wá. Bóyá",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.2",
            "verseOrgIds": [
              "JER.21.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.21.2",
                "verseOrgIds": [
                  "JER.21.2"
                ]
              }
            }
          ]
        },
        {
          "text": "yóò ṣe ìyanu fún wa gẹ́gẹ́ bí ti àtẹ̀yìnwá, kí ó sì yípadà kúrò lọ́dọ̀ wa.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.2",
            "verseOrgIds": [
              "JER.21.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n Jeremiah dáhùn wí pé, \"Sọ fún Sedekiah,",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.3",
            "verseOrgIds": [
              "JER.21.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "'Èyí ni",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.4",
            "verseOrgIds": [
              "JER.21.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.21.4",
                "verseOrgIds": [
                  "JER.21.4"
                ]
              }
            }
          ]
        },
        {
          "text": ", Ọlọ́run Israẹli wí, Èmi fẹ́ kọjú idà tí ó wà lọ́wọ́ yín sí yín, èyí tí ẹ̀ ń lò láti bá ọba àti àwọn ará Babeli tí wọ́n wà lẹ́yìn odi jà, Èmi yóò sì kó wọn jọ sínú ìlú yìí.",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.4",
            "verseOrgIds": [
              "JER.21.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi gan an yóò sì bá yín jà pẹ̀lú ohun ìjà olóró nínú ìbínú àti ìrunú líle.",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.5",
            "verseOrgIds": [
              "JER.21.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò sì lu gbogbo ìlú yìí, ènìyàn àti ẹranko, gbogbo wọn ni àjàkálẹ̀-ààrùn yóò kọlù tí wọn yóò sì kú.",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.6",
            "verseOrgIds": [
              "JER.21.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.21.7",
                "verseOrgIds": [
                  "JER.21.7"
                ]
              }
            }
          ]
        },
        {
          "text": "sọ pé lẹ́yìn èyí, èmi yóò fi Sedekiah ọba Juda, àti àwọn ìránṣẹ́ rẹ̀, àti àwọn ènìyàn, àti àwọn tí ó kù ní ìlú yìí lọ́wọ́ àjàkálẹ̀-ààrùn àti lọ́wọ́ idà, àti lọ́wọ́ ìyàn; èmi yóò fi wọ́n lé Nebukadnessari ọba Babeli lọ́wọ́, àti lé ọwọ́ àwọn ọ̀tá wọn, àti lé ọwọ́ àwọn tí ń lépa ẹ̀mí wọn, òun yóò sì fi ojú idà pa wọ́n, kì yóò sì dá wọn sí, bẹ́ẹ̀ ni kì yóò ní ìyọ́nú tàbí ṣàánú wọn.'",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.7",
            "verseOrgIds": [
              "JER.21.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Síwájú sí i, sọ fún àwọn ènìyàn, 'Èyí ni ọ̀rọ̀",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.8",
            "verseOrgIds": [
              "JER.21.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.21.8",
                "verseOrgIds": [
                  "JER.21.8"
                ]
              }
            }
          ]
        },
        {
          "text": "tí ó sọ: Wò ó, Èmi ń fi ọ̀nà ìyè àti ikú hàn yín.",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.8",
            "verseOrgIds": [
              "JER.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹnikẹ́ni tí ó bá dúró sí ìlú yìí yóò ti ipa idà, ìyàn tàbí àjàkálẹ̀-ààrùn kú. Ṣùgbọ́n ẹni tí ó bá jáde tí ó sì jọ̀wọ́ ara rẹ̀ fún àwọn Babeli tí ó ń lépa yín yóò sì yè. Òun yóò sá àsálà fún ẹ̀mí rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.9",
            "verseOrgIds": [
              "JER.21.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mo ti pinnu láti jẹ ìlú yìí ní yà, ni",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.10",
            "verseOrgIds": [
              "JER.21.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.21.10",
                "verseOrgIds": [
                  "JER.21.10"
                ]
              }
            }
          ]
        },
        {
          "text": "wí. A ó sì gbé e fún ọba Babeli, yóò sì run ún pẹ̀lú iná.'",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.10",
            "verseOrgIds": [
              "JER.21.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ẹ̀wẹ̀, wí fún ìdílé ọba Juda pé, 'Gbọ́ ọ̀rọ̀",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.11",
            "verseOrgIds": [
              "JER.21.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.21.11",
                "verseOrgIds": [
                  "JER.21.11"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.11",
            "verseOrgIds": [
              "JER.21.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilé Dafidi èyí ni ọ̀rọ̀ tí",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.12",
            "verseOrgIds": [
              "JER.21.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.21.12",
                "verseOrgIds": [
                  "JER.21.12"
                ]
              }
            }
          ]
        },
        {
          "text": "sọ:",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.12",
            "verseOrgIds": [
              "JER.21.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 21:12"
      },
      "items": [
        {
          "text": "\" 'Ṣe ìdájọ́ tí ó tọ́ ní àràárọ̀;",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.12",
            "verseOrgIds": [
              "JER.21.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 21:12"
      },
      "items": [
        {
          "text": "yọ ọ́ kúrò lọ́wọ́ ẹni tí ó ń ni í lára",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.12",
            "verseOrgIds": [
              "JER.21.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 21:12"
      },
      "items": [
        {
          "text": "ẹni tí a ti jà lólè",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.12",
            "verseOrgIds": [
              "JER.21.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 21:12"
      },
      "items": [
        {
          "text": "bí bẹ́ẹ̀ kọ́ ìbínú mi yóò jáde síta, yóò sì jó bí iná.",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.12",
            "verseOrgIds": [
              "JER.21.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 21:12"
      },
      "items": [
        {
          "text": "Nítorí ibi tí a ti ṣe yóò sì jó",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.12",
            "verseOrgIds": [
              "JER.21.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 21:12"
      },
      "items": [
        {
          "text": "láìsí ẹni tí yóò pa á.",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.12",
            "verseOrgIds": [
              "JER.21.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mo kẹ̀yìn sí ọ, Jerusalẹmu,",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.13",
            "verseOrgIds": [
              "JER.21.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 21:13"
      },
      "items": [
        {
          "text": "ìwọ tí o gbé lórí àfonífojì",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.13",
            "verseOrgIds": [
              "JER.21.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 21:13"
      },
      "items": [
        {
          "text": "lórí òkúta tí ó tẹ́jú, ni",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.13",
            "verseOrgIds": [
              "JER.21.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.21.13",
                "verseOrgIds": [
                  "JER.21.13"
                ]
              }
            }
          ]
        },
        {
          "text": "wí.",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.13",
            "verseOrgIds": [
              "JER.21.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 21:13"
      },
      "items": [
        {
          "text": "Ìwọ tí o ti wí pé, \"Ta ni ó le dojúkọ wá?",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.13",
            "verseOrgIds": [
              "JER.21.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 21:13"
      },
      "items": [
        {
          "text": "Ta ni yóò wọ inú ibùgbé wa?\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.13",
            "verseOrgIds": [
              "JER.21.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 21:14"
          },
          "items": [
            {
              "text": "14",
