      "attrs": {
        "style": "q1",
        "vid": "JER 3:13"
      },
      "items": [
        {
          "text": "ìwọ ti wá ojúrere rẹ lọ́dọ̀ ọlọ́run àjèjì",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.13",
