      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 3:13"
      },
      "items": [
        {
          "text": "lábẹ́ gbogbo igikígi tí ó gbilẹ̀,",
          "type": "text",
          "attrs": {
