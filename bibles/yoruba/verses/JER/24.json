          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Agbọ̀n èso ọ̀pọ̀tọ́ méjì",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 24:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lẹ́yìn tí Nebukadnessari ọba Babeli ti kó Jekoniah ọmọ Jehoiakimu ọba Juda àti àwọn ìjòyè wọn, àwọn oníṣọ̀nà àti oníṣẹ́ ọwọ́ ti Juda lọ sí ìgbèkùn láti Jerusalẹmu lọ sí ilẹ̀ àjèjì Babeli tán.",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.1",
            "verseOrgIds": [
              "JER.24.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.24.1",
                "verseOrgIds": [
                  "JER.24.1"
                ]
              }
            }
          ]
        },
        {
          "text": "fi agbọ̀n èso ọ̀pọ̀tọ́ méjì hàn mí tí a gbé sí iwájú pẹpẹ",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.1",
            "verseOrgIds": [
              "JER.24.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.24.1",
                "verseOrgIds": [
                  "JER.24.1"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.1",
            "verseOrgIds": [
              "JER.24.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agbọ̀n kan ni èso ọ̀pọ̀tọ́ tí ó dára bí èyí tí ó tètè pọ́n; èkejì sì ní èso ọ̀pọ̀tọ́ tí ó burú rékọjá tí kò sì le è ṣe é jẹ.",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.2",
            "verseOrgIds": [
              "JER.24.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.3",
            "verseOrgIds": [
              "JER.24.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.24.3",
                "verseOrgIds": [
                  "JER.24.3"
                ]
              }
            }
          ]
        },
        {
          "text": "bi mí pé, \"Kí ni ìwọ rí Jeremiah?\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.3",
            "verseOrgIds": [
              "JER.24.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JER 24:3"
      },
      "items": [
        {
          "text": "Mo dáhùn pe, \"Èso ọ̀pọ̀tọ́.\" Mo dáhùn. \"Èyí tí ó dáradára púpọ̀, ṣùgbọ́n èyí tí ó burú burú rékọjá tí kò sì ṣe é jẹ.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.3",
            "verseOrgIds": [
              "JER.24.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni ọ̀rọ̀",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.4",
            "verseOrgIds": [
              "JER.24.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.24.4",
                "verseOrgIds": [
                  "JER.24.4"
                ]
              }
            }
          ]
        },
        {
          "text": "tọ̀ mí wá:",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.4",
            "verseOrgIds": [
              "JER.24.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Èyí ni ohun tí",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.5",
            "verseOrgIds": [
              "JER.24.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.24.5",
                "verseOrgIds": [
                  "JER.24.5"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run Israẹli wí: 'Gẹ́gẹ́ bí àwọn èso ọ̀pọ̀tọ́ dáradára yìí ni Èmi yóò ka àwọn tí wọ́n lọ sí ilẹ̀ àjèjì láti Juda sí tí èmi rán jáde kúrò ní ibí yìí lọ sí ilẹ̀ àwọn ará Kaldea.",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.5",
            "verseOrgIds": [
              "JER.24.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 24:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ojú mi yóò máa ṣọ́ wọn lọ fún rere, Èmi yóò gbé wọn ró, n kò ní já wọn lulẹ̀. Èmi yóò gbìn wọ́n, n kò sì ní fà wọ́n tu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.6",
            "verseOrgIds": [
              "JER.24.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò fún wọn ní ọkàn láti mọ̀ mí pé, \"Èmi ni",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.7",
            "verseOrgIds": [
              "JER.24.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.24.7",
                "verseOrgIds": [
                  "JER.24.7"
                ]
              }
            }
          ]
        },
        {
          "text": ".\" Wọn yóò jẹ́ ènìyàn mi; Èmi ni yóò sì jẹ́ Ọlọ́run wọn; nítorí pé wọn yóò padà sọ́dọ̀ mi pẹ̀lú gbogbo ọkàn wọn.",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.7",
            "verseOrgIds": [
              "JER.24.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 24:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ṣùgbọ́n gẹ́gẹ́ bí èso ọ̀pọ̀tọ́ tí kò dára, tí ó burú tí kò ṣe é jẹ,' ni",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.8",
            "verseOrgIds": [
              "JER.24.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.24.8",
                "verseOrgIds": [
                  "JER.24.8"
                ]
              }
            }
          ]
        },
        {
          "text": "wí, 'bẹ́ẹ̀ ni Èmi yóò ṣe pẹ̀lú Sedekiah ọba Juda, àwọn ìjòyè rẹ̀ àti àwọn tí ó yẹ ní Jerusalẹmu, yálà wọ́n wà lórí ilẹ̀ yìí tàbí wọ́n ń gbé Ejibiti.",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.8",
            "verseOrgIds": [
              "JER.24.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò sọ wọ́n di ìwọ̀sí àti ẹni ibi nínú gbogbo ìjọba ayé, láti di ẹni ìfibú àti ẹni òwe, ẹni ẹ̀sín, àti ẹni ẹ̀gàn ní ibi gbogbo tí Èmi ó lé wọn sí.",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.9",
            "verseOrgIds": [
              "JER.24.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 24:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò rán idà, ìyàn àti àjàkálẹ̀-ààrùn sí wọn, títí tí gbogbo wọn yóò parun lórí ilẹ̀ tí a fún wọn àti fún àwọn baba wọn.' \"",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.10",
            "verseOrgIds": [
              "JER.24.10"
            ]
          }
        }
      ]
    }
  ],
