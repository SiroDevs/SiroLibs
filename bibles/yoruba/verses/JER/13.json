      },
      "items": [
        {
          "text": "13",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "O wé aṣọ funfun",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èyí ni ohun tí",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.1",
            "verseOrgIds": [
              "JER.13.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.13.1",
                "verseOrgIds": [
                  "JER.13.1"
                ]
              }
            }
          ]
        },
        {
          "text": "wí fún mi: \"Lọ kí o sì ra àmùrè aṣọ ọ̀gbọ̀, kí o sì dì í mọ́ ẹ̀gbẹ́ rẹ, kí o má sì ṣe jẹ́ kí omi kí ó kàn án.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.1",
            "verseOrgIds": [
              "JER.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ ni mo ra àmùrè gẹ́gẹ́ bí",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.2",
            "verseOrgIds": [
              "JER.13.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.13.2",
                "verseOrgIds": [
                  "JER.13.2"
                ]
              }
            }
          ]
        },
        {
          "text": "ti wí, mo sì dì í mọ́ ẹ̀gbẹ́ mi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.2",
            "verseOrgIds": [
              "JER.13.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni ọ̀rọ̀",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.3",
            "verseOrgIds": [
              "JER.13.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.13.3",
                "verseOrgIds": [
                  "JER.13.3"
                ]
              }
            }
          ]
        },
        {
          "text": "tọ̀ mí wá nígbà kejì,",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.3",
            "verseOrgIds": [
              "JER.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mú àmùrè tí o rà, kí o sì fiwé ẹ̀gbẹ́ rẹ, kí o sì lọ sí Perati, kí o lọ pa á mọ́ sí pàlàpálá òkúta.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.4",
            "verseOrgIds": [
              "JER.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni mo lọ pa á mọ́ ní Perati gẹ́gẹ́ bí",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.5",
            "verseOrgIds": [
              "JER.13.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.13.5",
                "verseOrgIds": [
                  "JER.13.5"
                ]
              }
            }
          ]
        },
        {
          "text": "ti wí fún mi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.5",
            "verseOrgIds": [
              "JER.13.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lẹ́yìn ọjọ́ díẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.6",
            "verseOrgIds": [
              "JER.13.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.13.6",
                "verseOrgIds": [
                  "JER.13.6"
                ]
              }
            }
          ]
        },
        {
          "text": "sọ fún mi, \"Lọ sí Perati kí o lọ mú àmùrè tí mo ní kí o pamọ́ síbẹ̀.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.6",
            "verseOrgIds": [
              "JER.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni mo lọ sí Perati mo lọ wá àmùrè mi níbi tí mo pa á mọ́ sí, ṣùgbọ́n nísinsin yìí àmùrè náà ti bàjẹ́, kò sì wúlò fún ohunkóhun mọ́.",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.7",
            "verseOrgIds": [
              "JER.13.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni ọ̀rọ̀",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.8",
            "verseOrgIds": [
              "JER.13.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.13.8",
                "verseOrgIds": [
                  "JER.13.8"
                ]
              }
            }
          ]
        },
        {
          "text": "tọ̀ mí wá pé:",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.8",
            "verseOrgIds": [
              "JER.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Èyí ni ohun tí",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.9",
            "verseOrgIds": [
              "JER.13.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.13.9",
                "verseOrgIds": [
                  "JER.13.9"
                ]
              }
            }
          ]
        },
        {
          "text": "sọ: 'Bákan náà ni èmi yóò run ìgbéraga Juda àti ìgbéraga ńlá ti Jerusalẹmu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.9",
            "verseOrgIds": [
              "JER.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ènìyàn búburú tí ó kùnà láti gbọ́ ọ̀rọ̀ mi, tí wọ́n ń lo agídí ọkàn wọn, tí ó sì ń rìn tọ àwọn òrìṣà láti sìn wọ́n, àti láti foríbalẹ̀ fún wọn, yóò sì dàbí àmùrè yìí tí kò wúlò fún ohunkóhun.",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.10",
            "verseOrgIds": [
              "JER.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí bí a ti lẹ àmùrè mọ́ ẹ̀gbẹ́ ènìyàn, bẹ́ẹ̀ ni a lẹ agbo ilé Israẹli àti gbogbo ilé Juda mọ́ mi,' ni",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.11",
            "verseOrgIds": [
              "JER.13.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.13.11",
                "verseOrgIds": [
                  "JER.13.11"
                ]
              }
            }
          ]
        },
        {
          "text": "wí, 'kí wọn kí ó lè jẹ́ ènìyàn ògo àti ìyìn fún mi, ṣùgbọ́n wọn kò fẹ́ gbọ́.'",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.11",
            "verseOrgIds": [
              "JER.13.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ọtí Wáìnì",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Sọ fún wọn, 'Èyí ni",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.12",
            "verseOrgIds": [
              "JER.13.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.13.12",
                "verseOrgIds": [
                  "JER.13.12"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run àwọn ọmọ Israẹli wí, gbogbo ìgò ni à ó fi ọtí wáìnì kún.' Bí wọ́n bá sì sọ fún ọ pé, 'Ṣé a kò mọ̀ pé gbogbo ìgò ni ó yẹ láti bu ọtí wáìnì kún?'",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.12",
            "verseOrgIds": [
              "JER.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà sọ fún wọn pé, 'Èyí ni ohun tí",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.13",
            "verseOrgIds": [
              "JER.13.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.13.13",
                "verseOrgIds": [
                  "JER.13.13"
                ]
              }
            }
          ]
        },
        {
          "text": "wí: Èmi yóò fi ìmutípara kún gbogbo olùgbé ilẹ̀ yìí pẹ̀lú ọba tí ó jókòó lórí ìtẹ́ Dafidi, àwọn àlùfáà, àwọn wòlíì gbogbo àwọn tó ń gbé ní Jerusalẹmu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.13",
            "verseOrgIds": [
              "JER.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò ti èkínní lu èkejì, àwọn baba àti ọmọkùnrin pọ̀ ni",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.14",
            "verseOrgIds": [
              "JER.13.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.13.14",
                "verseOrgIds": [
                  "JER.13.14"
                ]
              }
            }
          ]
        },
        {
          "text": "wí. Èmi kì yóò dáríjì, bẹ́ẹ̀ ni èmi kì yóò ṣàánú, èmi kì yóò ṣe ìyọ́nú láti máa pa wọ́n run.' \"",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.14",
            "verseOrgIds": [
              "JER.13.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìkìlọ̀ oko ẹrú",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbọ́ kí o sì fetísílẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.15",
            "verseOrgIds": [
              "JER.13.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 13:15"
      },
      "items": [
        {
          "text": "ẹ má ṣe gbéraga,",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.15",
            "verseOrgIds": [
              "JER.13.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 13:15"
      },
      "items": [
        {
          "text": "nítorí",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.15",
            "verseOrgIds": [
              "JER.13.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.13.15",
                "verseOrgIds": [
                  "JER.13.15"
                ]
              }
            }
          ]
        },
        {
          "text": "ti sọ̀rọ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.15",
            "verseOrgIds": [
              "JER.13.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ fi ògo fún",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.16",
            "verseOrgIds": [
              "JER.13.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.13.16",
                "verseOrgIds": [
                  "JER.13.16"
                ]
              }
