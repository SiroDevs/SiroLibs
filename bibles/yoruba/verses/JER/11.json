                "verseId": "JER.11.17",
                "verseOrgIds": [
                  "JER.11.17"
                ]
              }
            }
          ]
        },
        {
          "text": "àwọn ọmọ-ogun tí ó dá ọ ti kéde ibi sí ọ, nítorí ilé Israẹli àti Juda ti ṣe ohun ibi, wọ́n sì ti mú inú bí mi, wọ́n ti ru ìbínú mi sókè nípa sísun tùràrí si Baali.",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.17",
            "verseOrgIds": [
              "JER.11.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ọ̀tẹ̀ sí Jerusalẹmu",
          "type": "text"
        }
