          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.18",
            "verseOrgIds": [
              "JER.11.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.11.18",
                "verseOrgIds": [
                  "JER.11.18"
                ]
              }
            }
          ]
        },
        {
          "text": "fi ọ̀tẹ̀ wọn hàn mí mo mọ̀ ọ́n; nítorí ní àsìkò náà ó fi ohun tí wọ́n ń ṣe hàn mí.",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.18",
            "verseOrgIds": [
              "JER.11.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mo ti dàbí ọ̀dọ́-àgùntàn jẹ́ẹ́jẹ́ tí a mú lọ fún pípa; n kò mọ̀ pé wọ́n ti gbìmọ̀ búburú sí mi wí pé:",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.19",
            "verseOrgIds": [
              "JER.11.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 11:19"
      },
      "items": [
        {
          "text": "\"Jẹ́ kí a run igi àti èso rẹ̀;",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.19",
            "verseOrgIds": [
              "JER.11.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 11:19"
      },
      "items": [
        {
          "text": "jẹ́ kí a gé e kúrò ní orí ilẹ̀ alààyè,",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.19",
            "verseOrgIds": [
              "JER.11.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 11:19"
      },
      "items": [
        {
          "text": "kí a má lè rántí orúkọ rẹ̀ mọ́.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.19",
            "verseOrgIds": [
              "JER.11.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
