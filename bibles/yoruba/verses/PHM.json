    "verseCount": 25,
    "content": [
      {
        "name": "chapter",
        "type": "tag",
        "attrs": {
          "number": "1",
          "style": "c",
          "sid": "PHM 1"
        },
        "items": [
          {
            "text": "1",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "s1"
        },
        "items": [
          {
            "text": "Ìkíni",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "1",
              "style": "v",
              "sid": "PHM 1:1"
            },
            "items": [
              {
                "text": "1",
                "type": "text"
              }
            ]
          },
          {
            "text": "Èmi Paulu, ẹni tí a fi sẹ́wọ̀n nítorí pé ó ń wàásù ìyìnrere Jesu Kristi àti Timotiu arákùnrin wa,",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.1",
              "verseOrgIds": [
                "PHM.1.1"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "b",
          "vid": "PHM 1:1"
        },
        "items": []
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p",
          "vid": "PHM 1:1"
        },
        "items": [
          {
            "text": "Sí Filemoni ọ̀rẹ́ wa ọ̀wọ́n àti alábáṣiṣẹ́ wa,",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.1",
              "verseOrgIds": [
                "PHM.1.1"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "2",
              "style": "v",
              "sid": "PHM 1:2"
            },
            "items": [
              {
                "text": "2",
                "type": "text"
              }
            ]
          },
          {
            "text": "sí Affia arábìnrin wa, sí Arkippu ẹni tó jẹ́ jagunjagun fún àgbélébùú náà àti sí ìjọ àwọn Kristiani tí ó ń pàdé nínú ilé rẹ:",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.2",
              "verseOrgIds": [
                "PHM.1.2"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "b"
        },
        "items": []
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "3",
              "style": "v",
              "sid": "PHM 1:3"
            },
            "items": [
              {
                "text": "3",
                "type": "text"
              }
            ]
          },
          {
            "text": "Oore-ọ̀fẹ́ fún un yín àti àlàáfíà láti ọ̀dọ̀ Ọlọ́run Baba wa àti Jesu Kristi.",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.3",
              "verseOrgIds": [
                "PHM.1.3"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "b"
        },
        "items": []
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "s1"
        },
        "items": [
          {
            "text": "Ìdúpẹ́ àti àdúrà",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "4",
              "style": "v",
              "sid": "PHM 1:4"
            },
            "items": [
              {
                "text": "4",
                "type": "text"
              }
            ]
          },
          {
            "text": "Èmi máa ń dúpẹ́ lọ́wọ́ Ọlọ́run nígbà tí mo bá rántí rẹ nínú àdúrà mi,",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.4",
              "verseOrgIds": [
                "PHM.1.4"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "5",
              "style": "v",
              "sid": "PHM 1:5"
            },
            "items": [
              {
                "text": "5",
                "type": "text"
              }
            ]
          },
          {
            "text": "nítorí mo ń gbọ́ nípa ìgbàgbọ́ rẹ nínú Jesu Olúwa àti nípa ìfẹ́ rẹ sí àwọn ènìyàn mímọ́.",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.5",
              "verseOrgIds": [
                "PHM.1.5"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "6",
              "style": "v",
              "sid": "PHM 1:6"
            },
            "items": [
              {
                "text": "6",
                "type": "text"
              }
            ]
          },
          {
            "text": "Èmi ń gbàdúrà pé, bí ìwọ ti ń ṣe alábápín nínú ìgbàgbọ́ rẹ pẹ̀lú àwọn ẹlòmíràn, pé kí ìgbàgbọ́ náà lè mú ọkàn wọn dúró gbọingbọin, gẹ́gẹ́ bí wọn ti rí àwọn ọ̀rọ̀ ohun rere tí ó ń bẹ nínú ayé rẹ, èyí tí ó ti ọ̀dọ̀ Kristi wá.",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.6",
              "verseOrgIds": [
                "PHM.1.6"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "7",
              "style": "v",
              "sid": "PHM 1:7"
            },
            "items": [
              {
                "text": "7",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ìfẹ́ rẹ ti fún mi ní ayọ̀ púpọ̀ àti ìgboyà, nítorí ìwọ, arákùnrin ti tu ọkàn àwọn ènìyàn mímọ́ lára.",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.7",
              "verseOrgIds": [
                "PHM.1.7"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "s1"
        },
        "items": [
          {
            "text": "Paulu bẹ̀bẹ̀ fún Onesimu",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "8",
              "style": "v",
              "sid": "PHM 1:8"
            },
            "items": [
              {
                "text": "8",
                "type": "text"
              }
            ]
          },
          {
            "text": "Nítorí náà, bí ó tilẹ̀ jẹ́ pé nínú Kristi mo ní ìgboyà púpọ̀ láti pàṣẹ ohun ti ó yẹ kí ó ṣe fún ọ,",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.8",
              "verseOrgIds": [
                "PHM.1.8"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "9",
              "style": "v",
              "sid": "PHM 1:9"
            },
            "items": [
              {
                "text": "9",
                "type": "text"
              }
            ]
          },
          {
            "text": "síbẹ̀ nítorí ìfẹ́ èmí kúkú bẹ̀ ọ́. Èmi gẹ́gẹ́ bí Paulu, arúgbó, àti nísinsin yìí òǹdè Jesu Kristi.",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.9",
              "verseOrgIds": [
                "PHM.1.9"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "10",
              "style": "v",
              "sid": "PHM 1:10"
            },
            "items": [
              {
                "text": "10",
                "type": "text"
              }
            ]
          },
          {
            "text": "Èmí bẹ̀ ọ́ nítorí ọmọ mi Onesimu, ẹni tí ó di ọmọ nígbà tí mo wà nínú ìdè.",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.10",
              "verseOrgIds": [
                "PHM.1.10"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "11",
              "style": "v",
              "sid": "PHM 1:11"
            },
            "items": [
              {
                "text": "11",
                "type": "text"
              }
            ]
          },
          {
            "text": "Nígbà kan rí, kò wúlò fún ọ, ṣùgbọ́n ní báyìí, ó ti wúlò fún ọ àti fún èmi pàápàá.",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.11",
              "verseOrgIds": [
                "PHM.1.11"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "12",
              "style": "v",
              "sid": "PHM 1:12"
            },
            "items": [
              {
                "text": "12",
                "type": "text"
              }
            ]
          },
          {
            "text": "Èmi rán an nísinsin yìí, àní ẹni ọkàn mi padà sí ọ̀dọ̀ rẹ.",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.12",
              "verseOrgIds": [
                "PHM.1.12"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "13",
              "style": "v",
              "sid": "PHM 1:13"
            },
            "items": [
              {
                "text": "13",
                "type": "text"
              }
            ]
          },
          {
            "text": "Èmi ìbá fẹ́ láti dá a dúró sọ́dọ̀ mi níhìn-ín, kí ó ba à dípò rẹ láti máa ràn mí lọ́wọ́ nígbà tí mo wà nínú ìdè nítorí ìyìnrere",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.13",
              "verseOrgIds": [
                "PHM.1.13"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "14",
              "style": "v",
              "sid": "PHM 1:14"
            },
            "items": [
              {
                "text": "14",
                "type": "text"
              }
            ]
          },
          {
            "text": "ṣùgbọ́n èmi kò fẹ́ ṣe bẹ́ẹ̀ rárá láìgba ìyọ̀ǹda ní ọwọ́ rẹ, kí oore tí ìwọ bá ṣe má ba à jẹ́ ìfipámúniṣe bí kò ṣe ìfìfẹ́ṣe.",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.14",
              "verseOrgIds": [
                "PHM.1.14"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "15",
              "style": "v",
              "sid": "PHM 1:15"
            },
            "items": [
              {
                "text": "15",
                "type": "text"
              }
            ]
          },
          {
            "text": "Bóyá ìdí rẹ̀ tí òun fi yẹra kúrò lọ́dọ̀ rẹ fún ìgbà díẹ̀ ni pé kí ìwọ kí ó lè gbà á padà sọ́dọ̀ títí láé.",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.15",
              "verseOrgIds": [
                "PHM.1.15"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "16",
              "style": "v",
              "sid": "PHM 1:16"
            },
            "items": [
              {
                "text": "16",
                "type": "text"
              }
            ]
          },
          {
            "text": "Kì í wá ṣe bí ẹrú mọ́, ṣùgbọ́n bí ẹni ti ó sàn ju ẹrú lọ, gẹ́gẹ́ bí arákùnrin. Ó ṣọ̀wọ́n fún mi jọjọ, ṣùgbọ́n ó ṣọ̀wọ́n fún ọ jù nípa ti ara àti gẹ́gẹ́ bí arákùnrin nínú Olúwa.",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.16",
              "verseOrgIds": [
                "PHM.1.16"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "17",
              "style": "v",
              "sid": "PHM 1:17"
            },
            "items": [
              {
                "text": "17",
                "type": "text"
              }
            ]
          },
          {
            "text": "Nítorí náà bí ìwọ bá kà mí sí ẹlẹgbẹ́ rẹ̀, tẹ́wọ́ gbà á bí ìwọ yóò ti tẹ́wọ́ gbà mí.",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.17",
              "verseOrgIds": [
                "PHM.1.17"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "18",
              "style": "v",
              "sid": "PHM 1:18"
            },
            "items": [
              {
                "text": "18",
                "type": "text"
              }
            ]
          },
          {
            "text": "Bí ó bá ti ṣe ọ́ ní ibi kan tàbí jẹ ọ́ ní gbèsè ohun kan, kà á sí mi lọ́rùn.",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.18",
              "verseOrgIds": [
                "PHM.1.18"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "19",
              "style": "v",
              "sid": "PHM 1:19"
            },
            "items": [
              {
                "text": "19",
                "type": "text"
              }
            ]
          },
          {
            "text": "Èmi Paulu, ni mo fi ọwọ́ ara mi kọ ìwé yìí; èmi yóò san án padà láì tilẹ̀ ní í sọ nípa pé ìwọ pàápàá jẹ mi ní gbèsè ara rẹ.",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.19",
              "verseOrgIds": [
                "PHM.1.19"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "20",
              "style": "v",
              "sid": "PHM 1:20"
            },
            "items": [
              {
                "text": "20",
                "type": "text"
              }
            ]
          },
          {
            "text": "Èmi ń fẹ́ arákùnrin, pé kí èmi kí ó lè ni àǹfààní kan láti ọ̀dọ̀ rẹ nínú Olúwa; fi ayọ̀ rẹ kún ọkàn mi nínú Kristi.",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.20",
              "verseOrgIds": [
                "PHM.1.20"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "21",
              "style": "v",
              "sid": "PHM 1:21"
            },
            "items": [
              {
                "text": "21",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ìgbẹ́kẹ̀lé ti mo ní pé ìwọ yóò gbọ́rọ̀, ni mo fi kọ ìwé yìí ránṣẹ́ sí ọ. Mo mọ̀ dájú pé ìwọ yóò ṣe ju bí mo ti béèrè lọ.",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.21",
              "verseOrgIds": [
                "PHM.1.21"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "22",
              "style": "v",
              "sid": "PHM 1:22"
            },
            "items": [
              {
                "text": "22",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ó ku ohun kan, ṣe ìtọ́jú iyàrá àlejò rẹ sílẹ̀ fún mi, nítorí mo ní ìgbàgbọ́ pé a óò tú mi sílẹ̀ fún yín ní ìdáhùn sí àdúrà yín.",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.22",
              "verseOrgIds": [
                "PHM.1.22"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "b"
        },
        "items": []
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "b"
        },
        "items": []
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "23",
              "style": "v",
              "sid": "PHM 1:23"
            },
            "items": [
              {
                "text": "23",
                "type": "text"
              }
            ]
          },
          {
            "text": "Epafira, òǹdè ẹlẹgbẹ́ mi nínú Kristi Jesu kí ọ.",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.23",
              "verseOrgIds": [
                "PHM.1.23"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "24",
              "style": "v",
              "sid": "PHM 1:24"
            },
            "items": [
              {
                "text": "24",
                "type": "text"
              }
            ]
          },
          {
            "text": "Marku kí ọ pẹ̀lú Aristarku, Dema àti Luku, àwọn alábáṣiṣẹ́ mi.",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.24",
              "verseOrgIds": [
                "PHM.1.24"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "b"
        },
        "items": []
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "25",
              "style": "v",
              "sid": "PHM 1:25"
            },
            "items": [
              {
                "text": "25",
                "type": "text"
              }
            ]
          },
          {
            "text": "Kí oore-ọ̀fẹ́ Jesu Kristi Olúwa wa wà pẹ̀lú ẹ̀mí yín.",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.25",
              "verseOrgIds": [
                "PHM.1.25"
              ]
            }
          }
        ]
