      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MRK 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kò sí ẹni tí ń fi ìrépé aṣọ tuntun lẹ ògbólógbòó ẹ̀wù, bí ó ba ṣe bẹ́ẹ̀, èyí tuntun tí a fi lẹ̀ ẹ́ yóò fàya kúrò lára ògbólógbòó, yíya rẹ̀ yóò sí burú púpọ̀ jù.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.2.21",
                "verseOrgIds": [
                  "MRK.2.21"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.21",
            "verseOrgIds": [
              "MRK.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MRK 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kò sì sí ẹni tí ń fi ọtí wáìnì tuntun sínú ìgò wáìnì ògbólógbòó. Bí a bá ṣe bẹ́ẹ̀, ọtí wáìnì náà yóò fa ìgò náà ya, ọtí wáìnì a sì dàànù, bákan náà ni ìgò náà, ṣùgbọ́n ọtí wáìnì tuntun ni a n fi sínú ìgò wáìnì tuntun.\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.2.22",
                "verseOrgIds": [
                  "MRK.2.22"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Olúwa ọjọ́ ìsinmi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MRK 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì ṣe ni ọjọ́ ìsinmi, bí Jesu àti àwọn ọmọ-ẹ̀yìn rẹ̀ ti ń kọjá lọ láàrín oko ọkà, àwọn ọmọ-ẹ̀yìn rẹ̀ bẹ̀rẹ̀ sí í ya ìpẹ́ ọkà.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.23",
            "verseOrgIds": [
              "MRK.2.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MRK 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Díẹ̀ nínú àwọn Farisi wí fún Jesu pé, \"Wò ó, èéṣe tiwọn fi ń ṣe èyí ti kò yẹ ni ọjọ́ ìsinmi.\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.24",
            "verseOrgIds": [
              "MRK.2.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MRK 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó dá wọn lóhùn pé,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.25",
            "verseOrgIds": [
              "MRK.2.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ẹ̀yin kò ti ka ohun tí Dafidi ṣe, nígbà tí ó ṣe aláìní, tí ebi sì ń pa á, òun àti àwọn tí ó wà lọ́dọ̀ rẹ̀?",
              "type": "text",
              "attrs": {
                "verseId": "MRK.2.25",
                "verseOrgIds": [
                  "MRK.2.25"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.25",
            "verseOrgIds": [
              "MRK.2.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MRK 2:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Bí ó tí wọ ilé Ọlọ́run lọ ni ọjọ́ Abiatari olórí àlùfáà, tí ó sì jẹ àkàrà ìfihàn ti kò tọ́ fún un láti jẹ bí kò ṣe fún àwọn àlùfáà, ó sì tún fi fún àwọn tí ń bẹ lọ́dọ̀ rẹ̀.\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.2.26",
                "verseOrgIds": [
                  "MRK.2.26"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MRK 2:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì wí fún wọ́n pé, a dá ọjọ́ ìsinmi fún ènìyàn,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.27",
            "verseOrgIds": [
              "MRK.2.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ṣùgbọ́n a kò dá ènìyàn fún ọjọ́ ìsinmi.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.2.27",
                "verseOrgIds": [
                  "MRK.2.27"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.27",
            "verseOrgIds": [
              "MRK.2.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MRK 2:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nítorí náà Ọmọ Ènìyàn ni Olúwa ọjọ́ ìsinmi pẹ̀lú.\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.2.28",
                "verseOrgIds": [
                  "MRK.2.28"
                ]
              }
            }
          ]
        }
      ]
    }
