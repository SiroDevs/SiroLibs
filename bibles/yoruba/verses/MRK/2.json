  "verseCount": 28,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
        "style": "c",
        "sid": "MRK 2"
      },
      "items": [
        {
          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jesu wo aláàrùn ẹ̀gbà sàn",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MRK 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lẹ́yìn ọjọ́ mélòó kan, nígbà tí Jesu tún padà wọ Kapernaumu, òkìkí kàn pé ó ti wà nínú ilé.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.1",
            "verseOrgIds": [
              "MRK.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MRK 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Láìpẹ́, ogunlọ́gọ̀ ènìyàn ti kún ilé tí ó dé sí tó bẹ́ẹ̀ tí inú ilé àti ẹ̀yìn ìlẹ̀kùn ní ìta kò gba ẹyọ ẹnìkan mọ́, ó sì wàásù ọ̀rọ̀ náà sí wọn.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.2",
            "verseOrgIds": [
              "MRK.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MRK 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ọkùnrin kan wá, wọ́n gbé arọ tọ̀ ọ́ wá, ẹni tí ọkùnrin mẹ́rin gbé.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.3",
            "verseOrgIds": [
              "MRK.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MRK 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí wọn kò sì le dé ọ̀dọ̀ Jesu, nítorí ọ̀pọ̀ ènìyàn, wọ́n dá òrùlé ilé lu ní ọ̀gangan ibi tí Jesu wà. Wọ́n sì sọ ọkùnrin arọ náà kalẹ̀ ti òun ti àkéte rẹ̀ níwájú Jesu.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.4",
            "verseOrgIds": [
              "MRK.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MRK 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí Jesu sì rí ìgbàgbọ́ wọn, ó sọ fún arọ náà pé,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.5",
            "verseOrgIds": [
              "MRK.2.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ọmọ, a dárí gbogbo ẹ̀ṣẹ̀ rẹ jì ọ́.\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.2.5",
                "verseOrgIds": [
                  "MRK.2.5"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MRK 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n díẹ̀ nínú àwọn olùkọ́ òfin tó jókòó níbẹ̀ sọ fún ara wọn pé,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.6",
            "verseOrgIds": [
              "MRK.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MRK 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Èéṣe ti ọkùnrin yìí fi sọ̀rọ̀ báyìí? Ó ń sọ̀rọ̀-òdì. Ta ni ó lè darí ẹ̀ṣẹ̀ ji ni bí ko ṣe Ọlọ́run nìkan?\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.7",
            "verseOrgIds": [
              "MRK.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MRK 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lójúkan náà bí Jesu tí wòye nínú ọkàn rẹ̀ pé wọn ń gbèrò bẹ́ẹ̀ ní àárín ara wọn, ó wí fún wọn pé,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.8",
            "verseOrgIds": [
              "MRK.2.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Èéṣe tí ẹ̀yìn fi ń ro nǹkan wọ̀nyí nínú ọkàn yín?",
              "type": "text",
              "attrs": {
                "verseId": "MRK.2.8",
                "verseOrgIds": [
                  "MRK.2.8"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.8",
            "verseOrgIds": [
              "MRK.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MRK 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Èwo ni ó rọrùn jù láti wí fún arọ náà pé, 'A dárí ẹ̀ṣẹ̀ rẹ̀ jì ọ,' tàbí wí pé, 'Dìde sì gbé àkéte rẹ, kí o sì máa rìn?'",
              "type": "text",
              "attrs": {
                "verseId": "MRK.2.9",
                "verseOrgIds": [
                  "MRK.2.9"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.9",
            "verseOrgIds": [
              "MRK.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MRK 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ṣùgbọ́n kí ẹ lè mọ̀ pé Ọmọ Ènìyàn ní agbára ní ayé láti dárí ẹ̀ṣẹ̀ rẹ̀ ji ni.\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.2.10",
                "verseOrgIds": [
                  "MRK.2.10"
                ]
              }
            }
          ]
        },
        {
          "text": "Ó wí fún ọkùnrin arọ náà pé,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.10",
            "verseOrgIds": [
              "MRK.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MRK 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mo wí fún ọ, dìde, gbé àkéte rẹ kí ó sì máa lọ ilé rẹ.\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.2.11",
                "verseOrgIds": [
                  "MRK.2.11"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.11",
            "verseOrgIds": [
              "MRK.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MRK 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lójúkan náà, ọkùnrin náà fò sókè fún ayọ̀. Ó gbé àkéte rẹ̀. Ó sì jáde lọ lójú gbogbo wọn. Èyí sì ya gbogbo wọn lẹ́nu tó bẹ́ẹ̀ tí wọ́n sì yin Ọlọ́run lógo wí pé, \"Àwa kò rí irú èyí rí!\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.12",
            "verseOrgIds": [
              "MRK.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìpè Lefi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MRK 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà, Jesu tún jáde lọ sí etí Òkun. Ọ̀pọ̀ ènìyàn sì tọ̀ ọ́ wá, ó sì bẹ̀rẹ̀ sí ní kọ́ wọn.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.13",
            "verseOrgIds": [
              "MRK.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MRK 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ó ti ń rin etí Òkun lọ sókè, ó rí Lefi ọmọ Alfeu tí ó jókòó nínú àgọ́ níbi tí ó ti ń gba owó orí, Jesu sì wí fún un pé,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.14",
            "verseOrgIds": [
              "MRK.2.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Tẹ̀lé mi,\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.2.14",
                "verseOrgIds": [
                  "MRK.2.14"
                ]
              }
            }
          ]
        },
        {
          "text": "Lefi dìde, ó sì ń tẹ̀lé e.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.14",
            "verseOrgIds": [
              "MRK.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MRK 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì ṣe, bí ó sì ti jókòó ti oúnjẹ ni ilé Lefi, ọ̀pọ̀ àwọn agbowó òde àti ẹlẹ́ṣẹ̀ wá bá Jesu jókòó pẹ̀lú àwọn ọmọ-ẹ̀yìn rẹ̀, nítorí tiwọn pọ̀ tiwọn tẹ̀lé e.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.15",
            "verseOrgIds": [
              "MRK.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MRK 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí àwọn olùkọ́ òfin àti àwọn Farisi rí ì tí ó ń bá àwọn agbowó òde àti àwọn ẹlẹ́ṣẹ̀ jẹun, wọn wí fún àwọn ọmọ-ẹ̀yìn rẹ̀ pé, \"Èétirí tí ó fi ń bá àwọn agbowó òde àti ẹlẹ́ṣẹ̀ jẹun?\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.16",
            "verseOrgIds": [
              "MRK.2.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MRK 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí Jesu gbọ́, ó sọ fún wọn wí pé,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.17",
            "verseOrgIds": [
              "MRK.2.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Àwọn tí ara wọ́n dá kò wa oníṣègùn, bí ko ṣe àwọn tí ara wọn kò dá. Èmi kò wá láti sọ fún àwọn ènìyàn rere láti ronúpìwàdà, bí kò ṣe àwọn ènìyàn ẹlẹ́ṣẹ̀.\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.2.17",
                "verseOrgIds": [
                  "MRK.2.17"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìbéèrè nípa àwẹ̀ lọ́wọ́ Jesu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MRK 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ọmọ-ẹ̀yìn Johanu àti àwọn Farisi a máa gbààwẹ̀. Àwọn ènìyàn kan sì wá, wọ́n sì bi í pé, \"Èéṣe tí àwọn ọmọ-ẹ̀yìn Johanu àti àwọn ọmọ-ẹ̀yìn Farisi fi ń gbààwẹ̀, ṣùgbọ́n àwọn ọmọ-ẹ̀yìn rẹ kò gbààwẹ̀?\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.18",
            "verseOrgIds": [
              "MRK.2.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MRK 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu dáhùn wí pé,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.19",
            "verseOrgIds": [
              "MRK.2.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Báwo ni àwọn àlejò ọkọ ìyàwó yóò ṣe máa gbààwẹ̀ nígbà tí ọkọ ìyàwó ṣì wà lọ́dọ̀ wọn?",
              "type": "text",
              "attrs": {
                "verseId": "MRK.2.19",
                "verseOrgIds": [
                  "MRK.2.19"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.19",
            "verseOrgIds": [
              "MRK.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MRK 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ṣùgbọ́n láìpẹ́ ọjọ́, a ó gba ọkọ ìyàwó kúrò lọ́dọ̀ wọn. Nígbà náà wọn yóò gbààwẹ̀ ni ọjọ́ wọ̀nyí.\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.2.20",
                "verseOrgIds": [
