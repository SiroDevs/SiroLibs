                "verseId": "NAM.1.12",
                "verseOrgIds": [
                  "NAM.1.12"
                ]
              }
            }
          ]
        },
        {
          "text": "wí:",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.12",
            "verseOrgIds": [
              "NAM.1.12"
            ]
          }
        }
      ]
