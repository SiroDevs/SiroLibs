      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 1:14"
      },
      "items": [
        {
          "text": "nítorí ẹ̀gbin ni ìwọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.14",
            "verseOrgIds": [
              "NAM.1.14"
            ]
          }
        }
      ]
