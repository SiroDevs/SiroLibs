                "verseOrgIds": [
                  "NAM.1.14"
                ]
              }
            }
          ]
        },
        {
          "text": "ti fi àṣẹ kan lélẹ̀ nítorí tìrẹ Ninefe:",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.14",
            "verseOrgIds": [
              "NAM.1.14"
            ]
          }
        }
      ]
