  "verseCount": 15,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "NAM 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NAM 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ̀rọ̀-ìmọ̀ nípa Ninefe. Ìwé ìran Nahumu ará Elkoṣi.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.1",
            "verseOrgIds": [
              "NAM.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìbínú",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text"
            }
          ]
        },
        {
          "text": "sí Ninefe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NAM 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọlọ́run ń jẹ owú, ó sì ń gbẹ̀san,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.2",
            "verseOrgIds": [
              "NAM.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 1:2"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "NAM.1.2",
                "verseOrgIds": [
                  "NAM.1.2"
                ]
              }
            }
          ]
        },
        {
          "text": "ń gbẹ̀san, ó sì kún fún ìbínú.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.2",
            "verseOrgIds": [
              "NAM.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NAM 1:2"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "NAM.1.2",
                "verseOrgIds": [
                  "NAM.1.2"
                ]
              }
            }
          ]
        },
        {
          "text": "ń gbẹ̀san lára àwọn ọ̀tá rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.2",
            "verseOrgIds": [
              "NAM.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 1:2"
      },
      "items": [
        {
          "text": "Ìbínú rẹ̀ kò sì yí padà lórí àwọn ọ̀tá rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.2",
            "verseOrgIds": [
              "NAM.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NAM 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "NAM.1.3",
                "verseOrgIds": [
                  "NAM.1.3"
                ]
              }
            }
          ]
        },
        {
          "text": "lọ́ra láti bínú, ó sì tóbi ní agbára;",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.3",
            "verseOrgIds": [
              "NAM.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 1:3"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "NAM.1.3",
                "verseOrgIds": [
                  "NAM.1.3"
                ]
              }
            }
          ]
        },
        {
          "text": "kì yóò fi àwọn ẹlẹ́ṣẹ̀ sílẹ̀ láìjìyà.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.3",
            "verseOrgIds": [
              "NAM.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NAM 1:3"
      },
      "items": [
        {
          "text": "Ọ̀nà rẹ̀ wà nínú afẹ́fẹ́ àti nínú ìjì,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.3",
            "verseOrgIds": [
              "NAM.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 1:3"
      },
      "items": [
        {
          "text": "ìkùùkuu sánmọ̀ sì ni eruku ẹsẹ̀ rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.3",
            "verseOrgIds": [
              "NAM.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NAM 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó bá òkun wí, ó sì mú kí ó gbẹ;",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.4",
            "verseOrgIds": [
              "NAM.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 1:4"
      },
      "items": [
        {
          "text": "Ó sìsọ gbogbo odò di gbígbẹ.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.4",
            "verseOrgIds": [
              "NAM.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NAM 1:4"
      },
      "items": [
        {
          "text": "Baṣani àti Karmeli sì rọ.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.4",
            "verseOrgIds": [
              "NAM.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 1:4"
      },
      "items": [
        {
          "text": "Ìtànná Lebanoni sì rẹ̀ sílẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.4",
            "verseOrgIds": [
              "NAM.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NAM 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn òkè ńlá wárìrì níwájú rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.5",
            "verseOrgIds": [
              "NAM.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 1:5"
      },
      "items": [
        {
          "text": "àwọn òkè kéékèèké sì di yíyọ́,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.5",
            "verseOrgIds": [
              "NAM.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NAM 1:5"
      },
      "items": [
        {
          "text": "ilẹ̀ ayé sì jóná níwájú rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.5",
            "verseOrgIds": [
              "NAM.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 1:5"
      },
      "items": [
        {
          "text": "àní ayé àti gbogbo àwọn tí ń gbé inú rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.5",
            "verseOrgIds": [
              "NAM.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NAM 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ta ni ó lé dúró níwájú ìbínú rẹ̀?",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.6",
            "verseOrgIds": [
              "NAM.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 1:6"
      },
      "items": [
        {
          "text": "Ta ni ó lé faradà gbígbóná ìbínú rẹ̀?",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.6",
            "verseOrgIds": [
              "NAM.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NAM 1:6"
      },
      "items": [
        {
          "text": "Ìbínú rẹ̀ tú jáde bí iná;",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.6",
            "verseOrgIds": [
              "NAM.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 1:6"
      },
      "items": [
        {
          "text": "àwọn àpáta sì fọ́ túútúú níwájú rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.6",
            "verseOrgIds": [
              "NAM.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NAM 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rere ni",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.7",
            "verseOrgIds": [
              "NAM.1.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "NAM.1.7",
                "verseOrgIds": [
                  "NAM.1.7"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.7",
            "verseOrgIds": [
              "NAM.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 1:7"
      },
      "items": [
        {
          "text": "òun ni ààbò ní ọjọ́ ìpọ́njú.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.7",
            "verseOrgIds": [
              "NAM.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NAM 1:7"
      },
      "items": [
        {
          "text": "Òun sì tọ́jú àwọn tí ó gbẹ́kẹ̀lé e,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.7",
            "verseOrgIds": [
              "NAM.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NAM 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "ṣùgbọ́n pẹ̀lú ìkún omi ńlá",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.8",
            "verseOrgIds": [
              "NAM.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NAM 1:8"
      },
      "items": [
        {
          "text": "ní òun yóò fi ṣe ìparun láti ibẹ̀ dé òpin;",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.8",
            "verseOrgIds": [
              "NAM.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 1:8"
      },
      "items": [
        {
          "text": "òkùnkùn yóò sì máa lépa àwọn ọ̀tá rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.8",
            "verseOrgIds": [
              "NAM.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NAM 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kí ni ẹ̀yìn ń gbìmọ̀ lòdì sí",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.9",
            "verseOrgIds": [
              "NAM.1.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "NAM.1.9",
                "verseOrgIds": [
                  "NAM.1.9"
                ]
              }
            }
          ]
        },
        {
          "text": "?",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.9",
            "verseOrgIds": [
              "NAM.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 1:9"
      },
      "items": [
        {
          "text": "Òun yóò fi òpin sí i,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.9",
            "verseOrgIds": [
              "NAM.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 1:9"
      },
      "items": [
        {
          "text": "ìpọ́njú kì yóò wáyé ní ìgbà kejì.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.9",
            "verseOrgIds": [
              "NAM.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NAM 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọn yóò sì lọ́lù papọ̀ bí ẹ̀gún òṣùṣú",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.10",
            "verseOrgIds": [
              "NAM.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 1:10"
      },
      "items": [
        {
          "text": "wọn yóò sì mu àmupara nínú ọtí wáìnì wọn",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.10",
            "verseOrgIds": [
              "NAM.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 1:10"
      },
      "items": [
        {
          "text": "a ó sì run wọn gẹ́gẹ́ bi àgékù koríko gbígbẹ.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.10",
