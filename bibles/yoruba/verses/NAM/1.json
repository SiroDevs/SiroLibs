          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nísinsin yìí ni èmi yóò já àjàgà wọn kúrò ní ọrùn rẹ",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.13",
            "verseOrgIds": [
              "NAM.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 1:13"
      },
      "items": [
        {
          "text": "èmi yóò já ṣẹ́kẹ́ṣẹkẹ̀ rẹ dànù.\"",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.13",
            "verseOrgIds": [
              "NAM.1.13"
            ]
          }
        }
      ]
    },
