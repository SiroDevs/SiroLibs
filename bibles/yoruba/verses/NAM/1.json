      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 1:11"
      },
      "items": [
        {
          "text": "tí ó ń gbèrò ibi sí",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.11",
            "verseOrgIds": [
              "NAM.1.11"
            ]
