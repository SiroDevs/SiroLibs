              "type": "text"
            }
          ]
        },
        {
          "text": "Láti ọ̀dọ̀ rẹ, ìwọ Ninefe, ni ẹnìkan ti jáde wá",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.11",
            "verseOrgIds": [
              "NAM.1.11"
            ]
          }
        }
      ]
