      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NAM 1:12"
      },
      "items": [
        {
          "text": "\"Bí wọ́n tilẹ̀ ni ìfọwọ́sowọ́pọ̀, tí wọ́n sì pọ̀ níye,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.12",
            "verseOrgIds": [
              "NAM.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 1:12"
      },
      "items": [
        {
          "text": "ṣùgbọ́n, báyìí ní a ó ké wọn lulẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.12",
            "verseOrgIds": [
              "NAM.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NAM 1:12"
      },
      "items": [
        {
          "text": "nígbà tí òun ó bá kọjá.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.12",
            "verseOrgIds": [
              "NAM.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 1:12"
      },
      "items": [
        {
          "text": "Bí mo tilẹ̀ ti pọ́n ọ lójú ìwọ Juda, èmi kì yóò pọ́n ọ lójúmọ́.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.12",
            "verseOrgIds": [
              "NAM.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
