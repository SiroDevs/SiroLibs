      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 1:14"
      },
      "items": [
        {
          "text": "\"Ìwọ kì yóò ni irú-ọmọ láti máa jẹ́ orúkọ rẹ mọ́,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.14",
            "verseOrgIds": [
              "NAM.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NAM 1:14"
      },
      "items": [
        {
          "text": "Èmi yóò pa ère fínfín àti ère dídà run",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.14",
            "verseOrgIds": [
              "NAM.1.14"
            ]
          }
        }
      ]
    },
