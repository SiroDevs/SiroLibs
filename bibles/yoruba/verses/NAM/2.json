  "verseCount": 13,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
        "style": "c",
        "sid": "NAM 2"
      },
      "items": [
        {
          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìṣubú Ninefe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NAM 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn apanirun ti dìde sí ọ, ìwọ Ninefe.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.1",
            "verseOrgIds": [
              "NAM.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:1"
      },
      "items": [
        {
          "text": "Pa ilé ìṣọ́ mọ́,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.1",
            "verseOrgIds": [
              "NAM.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:1"
      },
      "items": [
        {
          "text": "ṣọ́ ọ̀nà náà,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.1",
            "verseOrgIds": [
              "NAM.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:1"
      },
      "items": [
        {
          "text": "di àmùrè,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.1",
            "verseOrgIds": [
              "NAM.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:1"
      },
      "items": [
        {
          "text": "ẹ̀gbẹ́ rẹ kí ó le múra gírí.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.1",
            "verseOrgIds": [
              "NAM.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NAM 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "NAM.2.2",
                "verseOrgIds": [
                  "NAM.2.3"
                ]
              }
            }
          ]
        },
        {
          "text": "yóò mú ọláńlá Jakọbu padà sípò",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.2",
            "verseOrgIds": [
              "NAM.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:2"
      },
      "items": [
        {
          "text": "gẹ́gẹ́ bí ọláńlá Israẹli",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.2",
            "verseOrgIds": [
              "NAM.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NAM 2:2"
      },
      "items": [
        {
          "text": "bí ó tilẹ̀ jẹ́ pé àwọn apanirun ti pa ibẹ̀ run,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.2",
            "verseOrgIds": [
              "NAM.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:2"
      },
      "items": [
        {
          "text": "tí wọ́n sì ba ẹ̀ka àjàrà wọn jẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.2",
            "verseOrgIds": [
              "NAM.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NAM 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asà àwọn ọmọ-ogun rẹ̀ sì di pupa;",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.3",
            "verseOrgIds": [
              "NAM.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:3"
      },
      "items": [
        {
          "text": "àwọn ológun wọn sì wọ aṣọ òdòdó.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.3",
            "verseOrgIds": [
              "NAM.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NAM 2:3"
      },
      "items": [
        {
          "text": "Idẹ tí ó wà lórí kẹ̀kẹ́ ogun ń kọ mọ̀nàmọ́ná",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.3",
            "verseOrgIds": [
              "NAM.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:3"
      },
      "items": [
        {
          "text": "ní ọjọ́ tí a bá pèsè wọn sílẹ̀ tán;",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.3",
            "verseOrgIds": [
              "NAM.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:3"
      },
      "items": [
        {
          "text": "igi firi ni a ó sì mì tìtì.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.3",
            "verseOrgIds": [
              "NAM.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NAM 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn kẹ̀kẹ́ ogun yóò ya bo àwọn pópónà,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.4",
            "verseOrgIds": [
              "NAM.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:4"
      },
      "items": [
        {
          "text": "wọn yóò sì máa sáré síwá àti sẹ́yìn ní àárín ìgboro.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.4",
            "verseOrgIds": [
              "NAM.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NAM 2:4"
      },
      "items": [
        {
          "text": "Wọn sì dàbí ètùfù iná;",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.4",
            "verseOrgIds": [
              "NAM.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:4"
      },
      "items": [
        {
          "text": "tí ó sì kọ bí i mọ̀nàmọ́ná.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.4",
            "verseOrgIds": [
              "NAM.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NAM 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninefe yóò ṣe àṣàrò àwọn ọlọ́lá rẹ̀;",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.5",
            "verseOrgIds": [
              "NAM.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:5"
      },
      "items": [
        {
          "text": "síbẹ̀ wọ́n ń kọsẹ̀ ní ojú ọ̀nà wọn;",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.5",
            "verseOrgIds": [
              "NAM.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NAM 2:5"
      },
      "items": [
        {
          "text": "wọn sáré lọ sí ibi odi rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.5",
            "verseOrgIds": [
              "NAM.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:5"
      },
      "items": [
        {
          "text": "a ó sì pèsè ààbò rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.5",
            "verseOrgIds": [
              "NAM.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NAM 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "A ó ṣí ìlẹ̀kùn àwọn odò wọ̀n-ọn-nì sílẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.6",
            "verseOrgIds": [
              "NAM.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:6"
      },
      "items": [
        {
          "text": "a ó sì mú ààfin náà di wíwó palẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.6",
            "verseOrgIds": [
              "NAM.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NAM 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "A pa á láṣẹ pé ìlú náà, èyí tí a ti fi ìdí rẹ̀ múlẹ̀",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.7",
            "verseOrgIds": [
              "NAM.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:7"
      },
      "items": [
        {
          "text": "ni a ó sì kó ní ìgbèkùn lọ.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.7",
            "verseOrgIds": [
              "NAM.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NAM 2:7"
      },
      "items": [
        {
          "text": "A ó sì mú un gòkè wá",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.7",
            "verseOrgIds": [
              "NAM.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:7"
      },
      "items": [
        {
          "text": "àti àwọn ìránṣẹ́bìnrin rẹ̀ yóò kérora bí ti ẹyẹ àdàbà,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.7",
            "verseOrgIds": [
              "NAM.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:7"
      },
      "items": [
        {
          "text": "wọn a sì máa lu àyà wọn.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.7",
            "verseOrgIds": [
              "NAM.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NAM 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninefe dàbí adágún omi,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.8",
            "verseOrgIds": [
              "NAM.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:8"
      },
      "items": [
        {
          "text": "tí omi rẹ̀ sì ń gbẹ́ ẹ lọ.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.8",
            "verseOrgIds": [
              "NAM.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NAM 2:8"
      },
      "items": [
        {
          "text": "\"Dúró! Dúró!\" ni wọ́n ó máa kígbe,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.8",
            "verseOrgIds": [
              "NAM.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:8"
      },
      "items": [
        {
          "text": "ṣùgbọ́n ẹnìkankan kì yóò wo ẹ̀yìn.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.8",
            "verseOrgIds": [
              "NAM.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NAM 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ẹ kó ìkógun fàdákà!",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.9",
            "verseOrgIds": [
              "NAM.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:9"
      },
      "items": [
        {
          "text": "Ẹ kó ìkógun wúrà!",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.9",
            "verseOrgIds": [
              "NAM.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NAM 2:9"
      },
      "items": [
        {
          "text": "Ìṣúra wọn ti kò lópin náà,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.9",
            "verseOrgIds": [
              "NAM.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:9"
      },
      "items": [
        {
          "text": "àti ọrọ̀ kúrò nínú gbogbo ohun èlò ti a fẹ́!\"",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.9",
            "verseOrgIds": [
              "NAM.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NAM 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Òun ti ṣòfò, ó si di asán, ó sì di ahoro:",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.10",
            "verseOrgIds": [
              "NAM.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:10"
      },
      "items": [
        {
