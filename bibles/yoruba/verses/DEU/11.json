  "verseCount": 32,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "11",
        "style": "c",
        "sid": "DEU 11"
      },
      "items": [
        {
          "text": "11",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Fẹ́ràn",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text"
            }
          ]
        },
        {
          "text": "kí o sì gbọ́ tirẹ̀",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ fẹ́ràn",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.1",
            "verseOrgIds": [
              "DEU.11.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.11.1",
                "verseOrgIds": [
                  "DEU.11.1"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run yín, kí ẹ sì pa ìfẹ́ rẹ̀, ìlànà rẹ̀, òfin rẹ̀ àti àṣẹ rẹ̀ mọ́ ní ìgbà gbogbo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.1",
            "verseOrgIds": [
              "DEU.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ rántí lónìí pé, kì í ṣe àwọn ọmọ yín, ni ó rí ìbáwí",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.2",
            "verseOrgIds": [
              "DEU.11.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.11.2",
                "verseOrgIds": [
                  "DEU.11.2"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run yín; títóbi rẹ̀, ọwọ́ agbára rẹ̀, nína ọwọ́ rẹ̀;",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.2",
            "verseOrgIds": [
              "DEU.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "iṣẹ́ àmì rẹ̀ àti ohun tí ó ṣe ní àárín àwọn ará Ejibiti, sí Farao ọba Ejibiti àti gbogbo orílẹ̀-èdè rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.3",
            "verseOrgIds": [
              "DEU.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ohun tí ó ṣe sí àwọn jagunjagun Ejibiti, sí kẹ̀kẹ́ ogun àti ẹlẹ́ṣin rẹ̀: bí ó ṣe rì wọ́n sínú Òkun Pupa, bí wọ́n ṣe ń lé e yín tí",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.4",
            "verseOrgIds": [
              "DEU.11.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.11.4",
                "verseOrgIds": [
                  "DEU.11.4"
                ]
              }
            }
          ]
        },
        {
          "text": "fi pa wọ́n run pátápátá títí di òní olónìí yìí.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.4",
            "verseOrgIds": [
              "DEU.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kì í ṣe àwọn ọmọ yín ni ó rí ohun tí ó ṣe fún un yín ní aginjù, títí ẹ fi dé ìhín yìí,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.5",
            "verseOrgIds": [
              "DEU.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "ohun tí ó ṣe sí Datani àti Abiramu, àwọn ọmọ Eliabu, ẹ̀yà Reubeni, bí ilẹ̀ ti lanu ní ojú gbogbo ará Israẹli tí ó sì gbé wọn mì pẹ̀lú gbogbo ìdílé wọn, gbogbo àgọ́ ọ wọn àti gbogbo ohun alààyè tí ó jẹ́ tiwọn.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.6",
            "verseOrgIds": [
              "DEU.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n ojú u yín gan an ni ó rí gbogbo nǹkan ńlá wọ̀nyí tí",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.7",
            "verseOrgIds": [
              "DEU.11.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.11.7",
                "verseOrgIds": [
                  "DEU.11.7"
                ]
              }
            }
          ]
        },
        {
          "text": "ti ṣe.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.7",
            "verseOrgIds": [
              "DEU.11.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà, ẹ kíyèsi gbogbo àṣẹ tí mo ń fún yín lónìí, kí ẹ ba à lè lágbára àti lọ, kí ẹ sì gba ilẹ̀ náà tí ẹ ó la Jordani kọjá lọ.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.8",
            "verseOrgIds": [
              "DEU.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kí ẹ ba à lè pẹ́ ní orí ilẹ̀ tí",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.9",
            "verseOrgIds": [
              "DEU.11.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.11.9",
                "verseOrgIds": [
                  "DEU.11.9"
                ]
              }
            }
          ]
        },
        {
          "text": "ti búra fún àwọn baba ńlá a yín, láti fún àwọn àti àwọn ọmọ wọn: ilẹ̀ tí ó ń sàn fún wàrà àti oyin.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.9",
            "verseOrgIds": [
              "DEU.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilẹ̀ tí ẹ̀ ń wọ̀ lọ láti gbà kò rí bí ilẹ̀ Ejibiti, níbi tí ẹ ti wá, níbi tó jẹ́ wí pé ẹsẹ̀ yín ni ẹ fi ń rìn lọ bomirin irúgbìn tí ẹ gbìn bí oko ẹ̀fọ́.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.10",
            "verseOrgIds": [
              "DEU.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n ilẹ̀ tí ẹ ó la Jordani kọjá láti gbà, jẹ́ ilẹ̀ olókè àti pẹ̀tẹ́lẹ̀ tí òjò ń rọ̀ sí latọ̀run.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.11",
            "verseOrgIds": [
              "DEU.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilẹ̀ tí",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.12",
            "verseOrgIds": [
              "DEU.11.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.11.12",
                "verseOrgIds": [
                  "DEU.11.12"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run yín ń mójútó ni, ojú",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.12",
            "verseOrgIds": [
              "DEU.11.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.11.12",
                "verseOrgIds": [
                  "DEU.11.12"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run yín sì ń fi ìgbà gbogbo wà lórí rẹ̀, láti ìbẹ̀rẹ̀ ọdún dé òpin ọdún.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.12",
            "verseOrgIds": [
              "DEU.11.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà, bí ẹ bá gbọ́rọ̀ sí àṣẹ tí mo fún un yín lónìí tọkàntọkàn: tí ẹ fẹ́ràn",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.13",
            "verseOrgIds": [
              "DEU.11.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.11.13",
                "verseOrgIds": [
                  "DEU.11.13"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run yín, tí ẹ sì sìn ín, pẹ̀lú gbogbo àyà yín àti gbogbo ọkàn yín:",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.13",
            "verseOrgIds": [
              "DEU.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "nígbà náà, èmi yóò rọ òjò sórí ilẹ̀ ẹ yín lákòókò rẹ̀, àti òjò àkọ́rọ̀ àti ti àrọ̀kẹ́yìn, kí ẹ ba à lè kórè oúnjẹ yín wọlé àní wáìnì tuntun àti òróró.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.14",
            "verseOrgIds": [
              "DEU.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò mú kí koríko hù lórí ilẹ̀ yín fún àwọn ohun ọ̀sìn in yín, ẹ ó sì jẹ, ẹ ó sì yó.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.15",
            "verseOrgIds": [
              "DEU.11.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ ṣọ́ra, kí a má ba à tàn yín jẹ láti yípadà kí ẹ sì sin ọlọ́run mìíràn àti láti máa foríbalẹ̀ fún wọn.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.16",
            "verseOrgIds": [
              "DEU.11.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni ìbínú",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.17",
            "verseOrgIds": [
              "DEU.11.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.11.17",
                "verseOrgIds": [
                  "DEU.11.17"
                ]
              }
            }
          ]
        },
        {
          "text": "yóò sì ru sí i yín, Òun yóò ti ìlẹ̀kùn ọ̀run kí òjò má ba à rọ̀, ilẹ̀ kì yóò sì so èso kankan, ẹ ó sì ṣègbé ní ilẹ̀ rere tí",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.17",
            "verseOrgIds": [
              "DEU.11.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.11.17",
                "verseOrgIds": [
                  "DEU.11.17"
                ]
              }
            }
          ]
        },
        {
          "text": "fi fún un yín.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.17",
            "verseOrgIds": [
              "DEU.11.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ fi gbogbo ọ̀rọ̀ mi wọ̀nyí sí àyà a yín, àti ọkàn an yín, ẹ so wọ́n bí àmì sórí ọwọ́ yín, kí ẹ sì so wọ́n mọ́ iwájú orí yín.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.18",
            "verseOrgIds": [
              "DEU.11.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ máa fi wọ́n kọ́ àwọn ọmọ yín, ẹ máa sọ̀rọ̀ nípa wọn bí ẹ bá jókòó nínú ilé, àti ní ojú ọ̀nà bí ẹ bá ń rìn lọ, bí ẹ bá sùn àti bí ẹ bá jí.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.19",
            "verseOrgIds": [
              "DEU.11.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kí ìwọ kí ó kọ wọ́n sára òpó ilé rẹ̀, àti sí ara ìlẹ̀kùn ọ̀nà òde rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.20",
            "verseOrgIds": [
              "DEU.11.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kí ọjọ́ ọ yín àti ti àwọn ọmọ yín lè pọ̀ ní ilẹ̀ tí",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.21",
            "verseOrgIds": [
              "DEU.11.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.11.21",
                "verseOrgIds": [
                  "DEU.11.21"
                ]
              }
            }
          ]
        },
        {
          "text": "ti búra láti fi fún àwọn baba ńlá a yín, ní ìwọ̀n ìgbà tí ọ̀run wà lókè tí ayé sì ń bẹ ní ìsàlẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.21",
            "verseOrgIds": [
              "DEU.11.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ẹ bá fi ara balẹ̀ kíyèsi àwọn òfin tí mo ń fún un yín, láti tẹ̀lé, láti fẹ́",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.22",
            "verseOrgIds": [
              "DEU.11.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.11.22",
                "verseOrgIds": [
                  "DEU.11.22"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run yín, láti máa rìn ní gbogbo ọ̀nà rẹ̀ àti láti dìímú ṣinṣin:",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.22",
            "verseOrgIds": [
              "DEU.11.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DEU 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.11.23",
                "verseOrgIds": [
                  "DEU.11.23"
                ]
              }
            }
          ]
        },
        {
          "text": "yóò sì lé gbogbo orílẹ̀-èdè wọ̀nyí kúrò níwájú u yín. Ẹ ó sì gba orílẹ̀-èdè tí ó lágbára tí ó sì tóbi jù yín lọ.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.23",
            "verseOrgIds": [
              "DEU.11.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 11:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo ibi tí ẹ bá fi ẹsẹ̀ ẹ yín tẹ̀ ni yóò jẹ́ tiyín, ilẹ̀ ẹ yín yóò gbilẹ̀ láti aginjù dé Lebanoni, àti láti odò Eufurate dé Òkun Ńlá.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.24",
            "verseOrgIds": [
              "DEU.11.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DEU 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kò sí ẹni náà tí yóò lè kò yín lójú ìjà,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.25",
            "verseOrgIds": [
              "DEU.11.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.11.25",
                "verseOrgIds": [
                  "DEU.11.25"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run yín yóò fi ẹ̀rù àti ìwárìrì i yín sórí gbogbo ilẹ̀ náà bí ó ti ṣèlérí fún un yín ní gbogbo ibi tí ẹ bá lọ.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.25",
            "verseOrgIds": [
              "DEU.11.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DEU 11:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ kíyèsi i, mo fi ìbùkún àti ègún lélẹ̀ níwájú u yín lónìí:",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.26",
            "verseOrgIds": [
              "DEU.11.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DEU 11:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "ìbùkún ni, bí ẹ bá pa òfin",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.27",
            "verseOrgIds": [
              "DEU.11.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.11.27",
                "verseOrgIds": [
                  "DEU.11.27"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run yín, tí mo ń fún un yín lónìí mọ́.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.27",
            "verseOrgIds": [
              "DEU.11.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DEU 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ègún ni, bí ẹ bá ṣàìgbọ́ràn, sí òfin",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.28",
            "verseOrgIds": [
              "DEU.11.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.11.28",
                "verseOrgIds": [
                  "DEU.11.28"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run yín, tí ẹ sì yapa kúrò ní ọ̀nà tí mo ti là sílẹ̀ fún yín lónìí, nípa títẹ̀lé ọlọ́run mìíràn, tí ẹ kò tí ì mọ̀.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.28",
            "verseOrgIds": [
              "DEU.11.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DEU 11:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.29",
            "verseOrgIds": [
              "DEU.11.29"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.11.29",
                "verseOrgIds": [
                  "DEU.11.29"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run yín bá ti mú un yín dé ilẹ̀ náà tí ẹ ń wọ̀ láti gbà, kí ẹ kéde àwọn ìbùkún náà ní orí òkè Gerisimu, kí ẹ sì kéde àwọn ègún ní orí òkè Ebali.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.29",
            "verseOrgIds": [
              "DEU.11.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "DEU 11:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ẹ ti mọ̀ pé àwọn òkè wọ̀nyí wà ní ìkọjá a Jordani ní apá ìwọ̀-oòrùn lójú ọ̀nà lọ sí ìhà ìlà-oòrùn, ní ẹ̀gbẹ́ igi ńlá igbó More, ní ilẹ̀ àwọn ará a Kenaani, tí wọ́n ń gbé ní aginjù, ni agbègbè Gilgali.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.30",
            "verseOrgIds": [
              "DEU.11.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "DEU 11:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ ti ṣetán láti la Jordani kọjá láti lè gba ilẹ̀ náà tí",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.31",
            "verseOrgIds": [
              "DEU.11.31"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.11.31",
                "verseOrgIds": [
                  "DEU.11.31"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run yín ń fún un yín. Nígbà tí ẹ bá gbà á, tí ẹ bá sì ń gbé ibẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.31",
            "verseOrgIds": [
              "DEU.11.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "DEU 11:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "ẹ rí i dájú pé ẹ̀ ń gbọ́rọ̀ sí gbogbo ìlànà àti òfin tí mo ń gbé kalẹ̀ fún un yín lónìí.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.32",
            "verseOrgIds": [
              "DEU.11.32"
            ]
          }
        }
      ]
    }
  ],
