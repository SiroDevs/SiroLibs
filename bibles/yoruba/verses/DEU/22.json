  "verseCount": 30,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "22",
        "style": "c",
        "sid": "DEU 22"
      },
      "items": [
        {
          "text": "22",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 22:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí o bá rí màlúù tàbí àgùntàn arákùnrin rẹ tí ó ń sọnù, má ṣe ṣé àìkíyèsí i rẹ̀ ṣùgbọ́n rí i dájú pé o mú padà wá fún un.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.1",
            "verseOrgIds": [
              "DEU.22.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ọkùnrin náà kì í bá gbé ní tòsí rẹ tàbí bí o kò bá mọ ẹni náà, mú un lọ ilé pẹ̀lú rẹ kí o sì fi pamọ́ títí yóò fi wá a wá. Nígbà náà ni kí o fi fún un.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.2",
            "verseOrgIds": [
              "DEU.22.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣe bákan náà tí o bá rí kẹ́tẹ́kẹ́tẹ́ arákùnrin rẹ tàbí aṣọ ìlekè tàbí ohunkóhun rẹ̀ tí ó sọnù. Má ṣe ṣe àìkíyèsí i rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.3",
            "verseOrgIds": [
              "DEU.22.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí o bá rí kẹ́tẹ́kẹ́tẹ́ tàbí màlúù arákùnrin rẹ tí o dùbúlẹ̀ sójú ọ̀nà, má ṣe ṣàìfiyèsí i rẹ̀, ràn án lọ́wọ́ láti dìde dúró lórí ẹsẹ̀ rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.4",
            "verseOrgIds": [
              "DEU.22.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obìnrin kò gbọdọ̀ wọ aṣọ ọkùnrin, tàbí kí ọkùnrin wọ aṣọ obìnrin, nítorí",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.5",
            "verseOrgIds": [
              "DEU.22.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.22.5",
                "verseOrgIds": [
                  "DEU.22.5"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run rẹ kórìíra ẹnikẹ́ni tí ó ṣe èyí.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.5",
            "verseOrgIds": [
              "DEU.22.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ìwọ bá ṣe alábòápàdé ìtẹ́ ẹyẹ lẹ́gbẹ̀ẹ́ ọ̀nà, bóyá lára igi tàbí lórí ilẹ̀, tí ìyá wọn sì jókòó lórí àwọn ọmọ, tàbí lórí àwọn ẹyin, má ṣe gbé ìyá pẹ̀lú àwọn ọmọ.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.6",
            "verseOrgIds": [
              "DEU.22.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ lè gbé ọmọ, ṣùgbọ́n rí i dájú pé o jọ̀wọ́ ìyá lọ́wọ́ lọ, kí ó ba à lè dára fún ọ àti kí o lè ní ẹ̀mí gígùn.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.7",
            "verseOrgIds": [
              "DEU.22.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí o bá kọ́ ilé tuntun, mọ odi yí òrùlé rẹ̀ ká nítorí kí o má ba à mú ẹ̀bi ìtàjẹ̀ sílẹ̀ wá sórí ilẹ̀ rẹ bí ẹnikẹ́ni bá ṣubú láti òrùlé.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.8",
            "verseOrgIds": [
              "DEU.22.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Má ṣe gbin oríṣìí èso méjì sínú ọgbà àjàrà rẹ; bí o bá ṣe bẹ́ẹ̀, kì í ṣe èso oko tí o gbìn nìkan ṣùgbọ́n èso ọgbà àjàrà pẹ̀lú yóò bàjẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.9",
            "verseOrgIds": [
              "DEU.22.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ kò gbọdọ̀ fi akọ màlúù àti akọ kẹ́tẹ́kẹ́tẹ́ tulẹ̀ pọ̀.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.10",
            "verseOrgIds": [
              "DEU.22.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ kò gbọdọ̀ wọ aṣọ onírun àgùntàn àti aṣọ funfun papọ̀.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.11",
            "verseOrgIds": [
              "DEU.22.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kí o ṣe wajawaja sí etí igun mẹ́rẹ̀ẹ̀rin aṣọ ìlekè rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.12",
            "verseOrgIds": [
              "DEU.22.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìrúfin ìgbéyàwó",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ọkùnrin kan bá mú ìyàwó àti, lẹ́yìn ìgbà tí ó ti dùbúlẹ̀ pẹ̀lú rẹ̀, kórìíra rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.13",
            "verseOrgIds": [
              "DEU.22.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "tí ó ṣì sọ̀rọ̀ ìbàjẹ́ sì i, tí o sì fún un ní orúkọ búburú, wí pé, \"Mo fẹ́ obìnrin yìí, ṣùgbọ́n nígbà tí mo súnmọ́ ọn. Èmi kò rí àmì ìbálé rẹ̀.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.14",
            "verseOrgIds": [
              "DEU.22.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni baba ọmọbìnrin náà àti ìyá rẹ̀ yóò mú ẹ̀rí pé, ó ti wà ní ìbálé tẹ́lẹ̀ wá sí ọ̀dọ̀ àwọn àgbàgbà ìlú ní ẹnu-bodè.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.15",
            "verseOrgIds": [
              "DEU.22.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baba obìnrin náà yóò wí fún àwọn àgbàgbà pé, \"Mo fi ọmọbìnrin mi fún ọkùnrin yìí láti fẹ́ níyàwó, ṣùgbọ́n ó kórìíra rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.16",
            "verseOrgIds": [
              "DEU.22.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 22:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ìsinsin yìí ó ti sọ̀rọ̀ ìbàjẹ́ sí i ó sì wí pé, 'Èmi kò rí ọmọbìnrin rẹ kí ó wà ní wúńdíá.' Ṣùgbọ́n níhìn-ín yìí ni ẹ̀rí ìbálé ọmọbìnrin mi.\" Nígbà náà ni àwọn òbí rẹ̀ yóò fi aṣọ hàn níwájú àwọn àgbàgbà ìlú,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.17",
            "verseOrgIds": [
              "DEU.22.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 22:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "àwọn àgbàgbà yóò sì mú ọkùnrin náà, wọn yóò sì jẹ ní yà.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.18",
            "verseOrgIds": [
              "DEU.22.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 22:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọn yóò sì gba ìtánràn ọgọ́rùn-ún ṣékélì owó fàdákà fún baba ọmọbìnrin náà, nítorí ọkùnrin yìí ti fi orúkọ búburú fún wúńdíá Israẹli. Yóò sì máa ṣe ìyàwó rẹ̀; kò gbọdọ̀ kọ̀ ọ́ sílẹ̀ ní gbogbo ayé e rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.19",
            "verseOrgIds": [
              "DEU.22.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 22:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n bí ẹ̀sùn náà bá jẹ́ òtítọ́ tí a kò sí rí ẹ̀rí ìbálé obìnrin náà,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.20",
            "verseOrgIds": [
              "DEU.22.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 22:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "wọn yóò mú wá sí ẹnu-ọ̀nà ilé baba rẹ̀ níbẹ̀ sì ni àwọn ọkùnrin ìlú rẹ̀ yóò ti sọ ọ́ ní òkúta pa. Ó ti ṣe ohun ìtìjú ní Israẹli nípa ṣíṣe àgbèrè nígbà tí ó wà nílé baba rẹ̀. Ẹ ní láti pa ohun búburú kúrò láàrín yín.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.21",
            "verseOrgIds": [
              "DEU.22.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 22:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí o bá rí ọkùnrin kan tí ó bá ìyàwó ọkùnrin mìíràn lòpọ̀, àwọn méjèèjì ní láti kú. Ẹ ní láti pa ohun búburú kúrò láàrín Israẹli.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.22",
            "verseOrgIds": [
              "DEU.22.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DEU 22:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ó bá ṣẹlẹ̀ wí pé ọkùnrin kan pàdé wúńdíá tí a ti fi fún ni láti fẹ́ láàrín ìlú tí ó sì lòpọ̀ pẹ̀lú u rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.23",
            "verseOrgIds": [
              "DEU.22.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 22:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "ìwọ yóò mú àwọn méjèèjì lọ sí ẹnu ibodè ìlú náà kí o sì sọ wọ́n ní òkúta pa nítorí ọmọbìnrin náà wà ní ìlú kò sì kígbe fún ìrànlọ́wọ́, àti ọkùnrin náà nítorí ó ba ìyàwó ọkùnrin mìíràn jẹ́. O ní láti wẹ búburú kúrò láàrín rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.24",
            "verseOrgIds": [
              "DEU.22.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DEU 22:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n bí ó bá ṣe ìgbẹ́ ní ó ti ṣẹlẹ̀ pé ọkùnrin kan ti pàdé ọmọbìnrin tí a ti fẹ́ ṣọ́nà tí o sì fi tagbára tagbára bá a ṣe, ọkùnrin náà nìkan tí ó ṣe èyí ni yóò kú.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.25",
            "verseOrgIds": [
              "DEU.22.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DEU 22:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Má ṣe fi ohunkóhun ṣe ọmọbìnrin náà; kò ṣẹ ẹ̀ṣẹ̀ tí ó tọ́ sí ikú. Ẹjọ́ yìí rí bí i ti ẹnìkan tí a gbámú tí ó pa aládùúgbò rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.26",
            "verseOrgIds": [
              "DEU.22.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DEU 22:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí ọkùnrin náà rí ọmọbìnrin náà ní ìta ibodè, bí ó tilẹ̀ jẹ́ pé ọmọbìnrin àfẹ́sọ́nà kígbe, kò sí ẹnìkankan níbẹ̀ láti gbà á kalẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.27",
            "verseOrgIds": [
              "DEU.22.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
