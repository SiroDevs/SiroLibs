              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ó bá ṣẹlẹ̀ pé ọkùnrin pàdé wúńdíá tí kò ì tí ì ní àfẹ́sọ́nà tí ó sì fi tipátipá bá a ṣe tí a gbá wọn mú.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.28",
            "verseOrgIds": [
              "DEU.22.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DEU 22:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó ní láti san àádọ́ta fàdákà fún baba obìnrin náà, nítorí tí ó ti bà á jẹ́. Kò lè kọ̀ ọ́ sílẹ̀ níwọ̀n ìgbà tí ó sì wà láààyè.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.29",
            "verseOrgIds": [
              "DEU.22.29"
            ]
          }
        }
      ]
    },
