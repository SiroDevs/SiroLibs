  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "19",
        "style": "c",
        "sid": "DEU 19"
      },
      "items": [
        {
          "text": "19",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìlú ààbò",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 19:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.1",
            "verseOrgIds": [
              "DEU.19.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.19.1",
                "verseOrgIds": [
                  "DEU.19.1"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run rẹ bá ti pa àwọn orílẹ̀-èdè tí yóò fi ilẹ̀ wọn fún ọ run, àti nígbà tí ìwọ bá ti lé wọn jáde tí o sì dó sí àwọn ilẹ̀ àti ilé wọn gbogbo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.1",
            "verseOrgIds": [
              "DEU.19.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ yóò ya ìlú mẹ́ta sọ́tọ̀ fún ara à rẹ láàrín ilẹ̀ rẹ tí",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.2",
            "verseOrgIds": [
              "DEU.19.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.19.2",
                "verseOrgIds": [
                  "DEU.19.2"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run fún ọ láti ni.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.2",
            "verseOrgIds": [
              "DEU.19.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣe àwọn ọ̀nà sí wọn àti kí o pín ilẹ̀ tí",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.3",
            "verseOrgIds": [
              "DEU.19.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.19.3",
                "verseOrgIds": [
                  "DEU.19.3"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run fún ọ gẹ́gẹ́ bí ogún sí ọ̀nà mẹ́ta nítorí kí apànìyàn lè sá níbẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.3",
            "verseOrgIds": [
              "DEU.19.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èyí ni òfin nípa apànìyàn, tí ó sì sá síbẹ̀ láti pa ẹ̀mí rẹ̀ mọ́. Ẹni tí ó pa aládùúgbò láìmọ̀ọ́mọ̀ṣeé láìjẹ́ pé ó ti ní àrankàn pẹ̀lú u rẹ̀ láti ọjọ́ pípẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.4",
            "verseOrgIds": [
              "DEU.19.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí àpẹẹrẹ, ọkùnrin kan lè lọ sínú igbó pẹ̀lú aládùúgbò rẹ̀ láti gé igi, bí ó sì ti gbé àáké e rẹ̀ láti gé igi náà lulẹ̀, bí àáké náà bá yọ tí ó sì bà aládùúgbò rẹ̀, tí òun sì kú. Ọkùnrin yìí lè sálọ sí ọ̀kan nínú àwọn ìlú yìí láti gba ẹ̀mí rẹ̀ là.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.5",
            "verseOrgIds": [
              "DEU.19.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí kò ṣe bẹ́ẹ̀, agbẹ̀san ẹ̀jẹ̀ lè máa lépa rẹ̀ nínú ìbínú, kí ó sì lé e bá nítorí pé ọ̀nà jì, kí ó sì pa á bí ó tilẹ̀ jẹ́ pé kò yẹ sí ikú, nígbà tí ó ṣe é sí aládùúgbò rẹ̀ láìjẹ́ pé ó ti ní àrankàn pẹ̀lú u rẹ̀ láti ọjọ́ pípẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.6",
            "verseOrgIds": [
              "DEU.19.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìdí nìyìí tí mo fi pa á láṣẹ fún ọ láti ya ìlú mẹ́ta sọ́tọ̀ fún ara rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.7",
            "verseOrgIds": [
              "DEU.19.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tí",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.8",
            "verseOrgIds": [
              "DEU.19.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.19.8",
                "verseOrgIds": [
                  "DEU.19.8"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run rẹ bá sì fẹ́ agbègbè rẹ, gẹ́gẹ́ bí ó ti ṣe ìbúra fún àwọn baba ńlá a yín, tí ó sì fún ọ ní gbogbo ilẹ̀ tí ó ti ṣe ìlérí fún wọn,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.8",
            "verseOrgIds": [
              "DEU.19.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "nítorí tí ìwọ fi pẹ̀lẹ́pẹ̀lẹ́ tẹ̀lé gbogbo òfin yìí tí mo pàṣẹ fún ọ lónìí yìí, kí o fẹ́",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.9",
            "verseOrgIds": [
              "DEU.19.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.19.9",
                "verseOrgIds": [
                  "DEU.19.9"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run rẹ, kí o sì rìn ní ọ̀nà an rẹ̀ ní gbogbo ìgbà náà, kí o ya ìlú mẹ́ta sọ́tọ̀.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.9",
            "verseOrgIds": [
              "DEU.19.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣe èyí kí a má ṣe ta ẹ̀jẹ̀ aláìṣẹ̀ sílẹ̀ ni ilẹ̀ rẹ, èyí tí",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.10",
            "verseOrgIds": [
              "DEU.19.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.19.10",
                "verseOrgIds": [
                  "DEU.19.10"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run rẹ yóò fún ọ gẹ́gẹ́ bí ogún, kí ìwọ kí ó má bá a jẹ̀bi ẹ̀jẹ̀ títa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.10",
            "verseOrgIds": [
              "DEU.19.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n tí ọkùnrin kan bá kórìíra arákùnrin rẹ̀, tí ó sì lúgọ dè é, tí ó mú u tí o lù ú pa, tí ọkùnrin náà sì sálọ sí ọ̀kan nínú àwọn ìlú wọ̀nyí,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.11",
            "verseOrgIds": [
              "DEU.19.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "àwọn àgbàgbà ìlú rẹ yóò sì ránṣẹ́ pè é ìwọ, yóò sì mú un padà láti ìlú náà, wọn yóò sì fi í lé àwọn agbẹ̀san ẹ̀jẹ̀ lọ́wọ́ kí ó lè kú.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.12",
            "verseOrgIds": [
              "DEU.19.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Má ṣe ṣàánú fún un. O ní láti fọ ẹ̀bi ẹ̀jẹ̀ aláìṣẹ̀ kúrò ni Israẹli, kí ó bá à lè dára fún ọ.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.13",
            "verseOrgIds": [
              "DEU.19.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Má ṣe pa òkúta ààlà aládùúgbò rẹ dà tí aṣíwájú rẹ fi lélẹ̀ nínú ogún tí ó gbà nínú ilẹ̀ tí",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.14",
            "verseOrgIds": [
              "DEU.19.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.19.14",
                "verseOrgIds": [
                  "DEU.19.14"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run rẹ fi fún ọ láti ni ní ìní.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.14",
            "verseOrgIds": [
              "DEU.19.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ẹlẹ́rìí",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹlẹ́rìí kan ṣoṣo kò tó láti dájọ́ ọkùnrin kan tí o fi ẹ̀bi ẹ̀ṣẹ̀ yóò wù kí ó lè ṣẹ̀ lẹ́bi. A ó fi ìdí ọ̀rọ̀ múlẹ̀ láti orí ẹ̀rí ẹni méjì tàbí mẹ́ta.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.15",
            "verseOrgIds": [
              "DEU.19.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tí alárankàn ẹlẹ́rìí èké bá dúró láti fi ẹ̀sùn ẹ̀ṣẹ̀ kan ọkùnrin kan,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.16",
            "verseOrgIds": [
              "DEU.19.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "àwọn méjèèjì tí àríyànjiyàn wà láàrín wọn gbọdọ̀ dúró níwájú",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.17",
            "verseOrgIds": [
              "DEU.19.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.19.17",
                "verseOrgIds": [
                  "DEU.19.17"
                ]
              }
            }
          ]
        },
        {
          "text": "níwájú àwọn àlùfáà àti àwọn adájọ́ tí ó wà ní ibi iṣẹ́ ní ìgbà náà.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.17",
            "verseOrgIds": [
              "DEU.19.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn adájọ́ gbọdọ̀ ṣe ìwádìí fínní fínní bí ẹ̀rí bá sì jẹ́ irọ́, tí ó fi ẹ̀rí èké sun arákùnrin rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.18",
            "verseOrgIds": [
              "DEU.19.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 19:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "nígbà náà ni kí ó ṣe sí i gẹ́gẹ́ bí ó ṣe fẹ́ ṣe sí arákùnrin rẹ̀. O ní láti wẹ búburú kúrò láàrín rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.19",
            "verseOrgIds": [
              "DEU.19.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
