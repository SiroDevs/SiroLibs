          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ kò gbọdọ̀ pànìyàn.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.17",
            "verseOrgIds": [
              "DEU.5.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
