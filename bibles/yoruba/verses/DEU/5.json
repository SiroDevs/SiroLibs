          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ kò gbọdọ̀ ṣe panṣágà.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.18",
            "verseOrgIds": [
              "DEU.5.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ kò gbọdọ̀ jalè.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.19",
            "verseOrgIds": [
              "DEU.5.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ kò gbọdọ̀ jẹ́rìí èké sí ẹnìkejì rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.20",
            "verseOrgIds": [
              "DEU.5.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ kò gbọdọ̀ ṣe ojúkòkòrò sí aya ẹnìkéjì rẹ, bẹ́ẹ̀ ni ìwọ kò gbọdọ̀ ṣe ojúkòkòrò sí ilé ẹnìkéji rẹ, oko rẹ̀, àti ọmọ ọ̀dọ̀ rẹ̀ ọkùnrin, àti ọmọ ọ̀dọ̀ rẹ̀ obìnrin, akọ màlúù rẹ̀ àti kẹ́tẹ́kẹ́tẹ́ rẹ̀, àti ohun gbogbo tí í ṣe ti ẹnìkéji rẹ.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.21",
            "verseOrgIds": [
              "DEU.5.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 5:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ̀nyí ni àwọn àṣẹ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.22",
            "verseOrgIds": [
              "DEU.5.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.5.22",
                "verseOrgIds": [
                  "DEU.5.22"
                ]
              }
            }
          ]
        },
        {
          "text": "tí a kéde rẹ̀ sí gbogbo ìpéjọpọ̀ ọ yín, níbẹ̀ ní orí òkè, láàrín iná, ìkùùkuu àti òkùnkùn biribiri, kò sì fi ohunkóhun kún un mọ́. Ó sì kọ wọ́n sínú wàláà méjì, Ó sì fi wọ́n lé mi lọ́wọ́.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.22",
            "verseOrgIds": [
              "DEU.5.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DEU 5:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí ẹ gbóhùn láti inú òkùnkùn wá, nígbà tí iná náà ń yọ iná lala, àwọn aṣáájú ẹ̀yà a yín àti àwọn àgbàgbà yín tọ̀ mí wá.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.23",
            "verseOrgIds": [
              "DEU.5.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 5:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ sì sọ pé, \"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.24",
            "verseOrgIds": [
              "DEU.5.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.5.24",
                "verseOrgIds": [
                  "DEU.5.24"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run wa ti fi ògo rẹ̀ hàn wá, àti títóbi rẹ̀ a sì ti gbóhùn rẹ̀ láti àárín iná wá. A ti rí i lónìí pé, ènìyàn sì lè wà láààyè lẹ́yìn tí Ọlọ́run bá bá a sọ̀rọ̀.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.24",
            "verseOrgIds": [
              "DEU.5.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DEU 5:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n èéṣe tí àwa yóò fi kú? Iná ńlá yìí yóò jó wa run, bí àwa bá sì tún gbọ́ ohun",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.25",
            "verseOrgIds": [
              "DEU.5.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.5.25",
                "verseOrgIds": [
                  "DEU.5.25"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run wa, àwa ó kú.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.25",
            "verseOrgIds": [
              "DEU.5.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DEU 5:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ta ni nínú ẹlẹ́ran ara tí ó ti gbọ́ ohun Ọlọ́run alààyè láti inú iná rí, bí àwa ti gbọ́ ọ, tí a sì wà láyé?",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.26",
            "verseOrgIds": [
              "DEU.5.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DEU 5:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Súnmọ́ tòsí ibẹ̀ kí o sì gbọ́ gbogbo ohun tí",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.27",
            "verseOrgIds": [
              "DEU.5.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.5.27",
                "verseOrgIds": [
                  "DEU.5.27"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run wa yóò sọ, nígbà náà sọ ohunkóhun tí",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.27",
            "verseOrgIds": [
              "DEU.5.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.5.27",
                "verseOrgIds": [
                  "DEU.5.27"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run wa sọ fún ọ fún wa. A ó sì fetísílẹ̀, a ó sì gbọ́rọ̀.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.27",
            "verseOrgIds": [
              "DEU.5.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DEU 5:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.5.28",
                "verseOrgIds": [
                  "DEU.5.28"
                ]
              }
            }
          ]
        },
        {
          "text": "ń gbọ́ nígbà tí ẹ̀yin ń bá mi sọ̀rọ̀,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.28",
            "verseOrgIds": [
              "DEU.5.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.5.28",
                "verseOrgIds": [
                  "DEU.5.28"
                ]
              }
            }
          ]
        },
        {
          "text": "sì sọ fún mi pé, \"Mo ti gbọ́ ohun tí àwọn ènìyàn yí sọ fún ọ. Gbogbo ohun tí wọ́n sọ dára,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.28",
            "verseOrgIds": [
              "DEU.5.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DEU 5:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "ìbá ti dára tó, bí ọkàn wọn bá lè bẹ̀rù mi, tí ó sì ń pa gbogbo òfin mi mọ́ nígbà gbogbo, kí ó bá à lè dára fún wọn, àti àwọn ọmọ wọn láéláé.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.29",
            "verseOrgIds": [
              "DEU.5.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "DEU 5:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Lọ sọ fún wọn kí wọn padà sínú àgọ́ wọn.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.30",
            "verseOrgIds": [
              "DEU.5.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "DEU 5:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n ìwọ túbọ̀ dúró síbí pẹ̀lú mi, kí n bá à lè fún ọ ní àwọn àṣẹ tí o gbọdọ̀ fi kọ́ wọn láti máa tẹ̀lé ní ilẹ̀ náà tí èmi ó fi fún wọn láti ní.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.31",
            "verseOrgIds": [
              "DEU.5.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "DEU 5:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Torí èyí, ẹ ṣọ́ra láti máa ṣe ohun tí",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.32",
            "verseOrgIds": [
              "DEU.5.32"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.5.32",
                "verseOrgIds": [
                  "DEU.5.32"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run yín tí pa ní àṣẹ fún un yín; ẹ má ṣe yà sọ́tùn ún tàbí sósì.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.32",
            "verseOrgIds": [
              "DEU.5.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "DEU 5:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ rìn ní gbogbo ọ̀nà tí",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.33",
            "verseOrgIds": [
              "DEU.5.33"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.5.33",
                "verseOrgIds": [
                  "DEU.5.33"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run yín ti pàṣẹ fún un yín, kí ẹ bá à le yè, kí ó sì dára fún un yín, kí ọjọ́ ọ yín bá à lè pẹ́ ní ilẹ̀ tí ẹ̀yin yóò gbà.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.33",
            "verseOrgIds": [
              "DEU.5.33"
            ]
          }
        }
      ]
    }
  ],
