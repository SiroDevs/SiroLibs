  "verseCount": 11,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "JON 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jona bínú sí àánú tí",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text"
            }
          ]
        },
        {
          "text": "fihàn",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JON 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n ó ba Jona nínú jẹ́ gidigidi, ó sì bínú púpọ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.1",
            "verseOrgIds": [
              "JON.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JON 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì gbàdúrà sí",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.2",
            "verseOrgIds": [
              "JON.4.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JON.4.2",
                "verseOrgIds": [
                  "JON.4.2"
                ]
              }
            }
          ]
        },
        {
          "text": ", ó sì wí pé, \"Èmí bẹ̀ ọ́,",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.2",
            "verseOrgIds": [
              "JON.4.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JON.4.2",
                "verseOrgIds": [
                  "JON.4.2"
                ]
              }
            }
          ]
        },
        {
          "text": ", ǹjẹ́ ọ̀rọ̀ ti mo sọ kọ́ ni èyí nígbà tí mo wà ní ilẹ̀ mi? Nítorí èyí ni mo ṣé sálọ sí Tarṣiṣi ní ìṣáájú: nítorí èmi mọ̀ pé, Ọlọ́run olóore-ọ̀fẹ́ ní ìwọ, àti aláàánú, O lọ́ra láti bínú, O sì ṣeun púpọ̀, O sì ronúpìwàdà ibi náà.",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.2",
            "verseOrgIds": [
              "JON.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JON 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ǹjẹ́ báyìí,",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.3",
            "verseOrgIds": [
              "JON.4.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JON.4.3",
                "verseOrgIds": [
                  "JON.4.3"
                ]
              }
            }
          ]
        },
        {
          "text": ", èmi bẹ̀ ọ, gba ẹ̀mí mi kúrò lọ́wọ́ mi nítorí ó sàn fún mi láti kú ju àti wà láààyè lọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.3",
            "verseOrgIds": [
              "JON.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JON 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.4",
            "verseOrgIds": [
              "JON.4.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JON.4.4",
                "verseOrgIds": [
                  "JON.4.4"
                ]
              }
            }
          ]
        },
        {
          "text": "wí pé, \"Ìwọ́ ha ni ẹ̀tọ́ láti bínú bí?\"",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.4",
            "verseOrgIds": [
              "JON.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JON 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jona sì jáde kúrò ní ìlú náà, ó sì jókòó níhà ìlà-oòrùn ìlú náà. Ó sì pa àgọ́ kan níbẹ̀ fún ara rẹ̀, ó sì jókòó ni òjìji ní abẹ́ rẹ̀ títí yóò fi rí ohun tí yóò ṣẹlẹ̀ sí ìlú náà.",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.5",
            "verseOrgIds": [
              "JON.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JON 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JON.4.6",
                "verseOrgIds": [
                  "JON.4.6"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run sì pèsè ìtàkùn kan, ó ṣe é kí ó gòkè wá sórí Jona; kí ó lè ṣe ìji bò ó lórí; láti gbà á kúrò nínú ìbànújẹ́ rẹ̀. Jona sì yọ ayọ̀ ńlá nítorí ìtàkùn náà.",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.6",
            "verseOrgIds": [
              "JON.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JON 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n Ọlọ́run pèsè kòkòrò kan nígbà tí ilẹ̀ mọ́ ní ọjọ́ kejì, ó sì jẹ ìtàkùn náà ó sì rọ.",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.7",
            "verseOrgIds": [
              "JON.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JON 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì ṣe, nígbà tí oòrùn yọ, Ọlọ́run pèsè ẹ̀fúùfù gbígbóná tí ìlà-oòrùn; oòrùn sì pa Jona lórí tó bẹ́ẹ̀ tí ó fi rẹ̀ ẹ́. Ó sì fẹ́ nínú ara rẹ̀ láti kú, ó sì wí pé, \"Ó sàn fún mi láti kú ju àti wà láààyè lọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.8",
            "verseOrgIds": [
              "JON.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JON 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọlọ́run sì wí fún Jona pé, \"O ha tọ́ fún ọ láti bínú nítorí ìtàkùn náà?\"",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.9",
            "verseOrgIds": [
              "JON.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JON 4:9"
      },
      "items": [
        {
          "text": "Òun sì wí pé, \"Mo ni ẹ̀tọ́, o tọ́ fún mi láti bínú títí dé ikú.\"",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.9",
            "verseOrgIds": [
              "JON.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JON 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.10",
            "verseOrgIds": [
              "JON.4.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JON.4.10",
                "verseOrgIds": [
                  "JON.4.10"
                ]
              }
            }
          ]
        },
        {
          "text": "wí pé, \"Ìwọ kẹ́dùn ìtàkùn náà, nítorí èyí tí ìwọ kò ṣiṣẹ́ fun, tí ìwọ kò mu dàgbà; tí ó hù jáde ní òru kan tí ó sì kú ni òru kan.",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.10",
            "verseOrgIds": [
              "JON.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JON 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n Ninefe ní jù ọ̀kẹ́ mẹ́fà (120,000) ènìyàn nínú rẹ̀, tí wọn kò mọ ọwọ́ ọ̀tún wọn yàtọ̀ sí ti òsì, àti ọ̀pọ̀lọpọ̀ ohun ọ̀sìn pẹ̀lú. Ṣé èmí kò ha ní kẹ́dùn nípa ìlú ńlá náà?\"",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.11",
            "verseOrgIds": [
              "JON.4.11"
            ]
          }
        }
      ]
    }
  ],
