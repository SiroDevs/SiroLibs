  "verseCount": 36,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "21",
        "style": "c",
        "sid": "EXO 21"
      },
      "items": [
        {
          "text": "21",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 21:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Wọ̀nyí ni àwọn òfin tí ìwọ yóò gbé sí iwájú wọn.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.1",
            "verseOrgIds": [
              "EXO.21.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Òfin nípa Ìwọ̀fà",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Bí ìwọ bá yá ọkùnrin Heberu ní ìwẹ̀fà, òun yóò sìn ọ́ fún ọdún mẹ́fà. Ṣùgbọ́n ní ọdún keje, òun yóò lọ ni òmìnira láìsan ohunkóhun padà.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.2",
            "verseOrgIds": [
              "EXO.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ó bá wá ní òun nìkan, òun nìkan náà ni yóò padà lọ ní òmìnira; ṣùgbọ́n tí ó bá mú ìyàwó wá, ó ní láti mú ìyàwó rẹ̀ padà lọ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.3",
            "verseOrgIds": [
              "EXO.21.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí olówó rẹ̀ bá fún un ní aya, tí aya náà sì bímọ ọkùnrin àti obìnrin, aya àti àwọn ọmọ rẹ̀ yóò jẹ́ ti olówó rẹ̀, yóò sì lọ ní òmìnira ní òun nìkan.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.4",
            "verseOrgIds": [
              "EXO.21.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Bí ẹrú náà bá sì wí ní gbangba pé, mo fẹ́ràn olúwa mi, ìyàwó mi àti àwọn ọmọ, èmi kò sì fẹ́ ẹ́ gba òmìnira mọ́,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.5",
            "verseOrgIds": [
              "EXO.21.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "nígbà náà ni olúwa rẹ̀ yóò mu wá sí iwájú ìdájọ́. Òun yóò sì mú un lọ sí ẹnu-ọ̀nà tàbí lọ sí ibi ọ̀wọ̀n, yóò sì fi ìlu lu etí rẹ̀, òun yóò sì máa sin olówó rẹ̀ títí ayé.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.6",
            "verseOrgIds": [
              "EXO.21.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Bí ọkùnrin kan bá ta ọmọbìnrin rẹ̀ bí ìwẹ̀fà, ọmọbìnrin yìí kò ní gba òmìnira bí i ti ọmọkùnrin.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.7",
            "verseOrgIds": [
              "EXO.21.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí òun kò bá sì tẹ́ olówó rẹ̀ lọ́rùn, ẹni tí ó fẹ́ ẹ fún ara rẹ̀, yóò jẹ́ kí wọn ó rà á padà, òun kò ní ẹ̀tọ́ láti tà á bí ẹrú fún àjèjì, nítorí pé òun ni kò ṣe ojúṣe rẹ̀ pẹ̀lú ìwẹ̀fà náà.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.8",
            "verseOrgIds": [
              "EXO.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ó bá fẹ́ ẹ fún ọmọkùnrin rẹ̀, kò ní máa lò ó bí ìwẹ̀fà mọ́, ṣùgbọ́n yóò máa ṣe sí i gẹ́gẹ́ bí ọmọ rẹ̀ obìnrin.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.9",
            "verseOrgIds": [
              "EXO.21.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ó bá fẹ́ obìnrin mìíràn, kò gbọdọ̀ kùnà ojúṣe rẹ̀ nípa fífún un ní oúnjẹ àti aṣọ, bẹ́ẹ̀ ni kò gbọdọ̀ kùnà ojúṣe rẹ̀ gẹ́gẹ́ bí ọkọ sí aya.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.10",
            "verseOrgIds": [
              "EXO.21.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ó bá kùnà láti ṣe àwọn nǹkan mẹ́ta wọ̀nyí fún un, òun yóò lọ ní òmìnira láìsan owó kankan padà.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.11",
            "verseOrgIds": [
              "EXO.21.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ẹnikẹ́ni tí ó bá lu arákùnrin rẹ̀ pa, pípa ni a ó pa á.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.12",
            "verseOrgIds": [
              "EXO.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n bí kò bá mọ̀ ọ́n mọ̀ pa á, tí ó bá jẹ́ àmúwá Ọlọ́run ni, òun yóò lọ sí ibi tí èmi yóò yàn fún un.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.13",
            "verseOrgIds": [
              "EXO.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n tí ó bá mú arákùnrin rẹ̀, tí ó sì fi ẹ̀tàn pa á. Ẹ mú un kúrò ní iwájú pẹpẹ mi kí ẹ sì pa á.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.14",
            "verseOrgIds": [
              "EXO.21.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ẹnikẹ́ni tí ó bá pa baba tàbí ìyá rẹ̀, pípa ni a ó pa á.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.15",
            "verseOrgIds": [
              "EXO.21.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ẹnikẹ́ni ti ó bá jí ènìyàn gbé, tí ó sì tà á tàbí tí ó fi pamọ́, pípa ni a ó pa á.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.16",
            "verseOrgIds": [
              "EXO.21.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ẹnikẹ́ni tí ó bá ṣépè fún baba tàbí ìyá rẹ̀, pípa ni a ó pa á.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.17",
            "verseOrgIds": [
              "EXO.21.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 21:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Bí àwọn ọkùnrin méjì bá ń jà, ti ọ̀kan sọ òkúta tàbí fi ìkùùkuu lu ẹnìkejì rẹ̀, tí ó sì pa á lára, ti irú ìpalára bẹ́ẹ̀ mu kí ó wà lórí ìdùbúlẹ̀ àìsàn.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.18",
            "verseOrgIds": [
              "EXO.21.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹni tó lu ẹnìkejì rẹ̀ kò ní ní ẹ̀bi, níwọ̀n ìgbà ti ẹni tí a lù bá ti lè dìde, tí ó sì lé è fi ọ̀pá ìtìlẹ̀ ní ọwọ́ rẹ̀ rìn káàkiri. Ẹni náà ni láti san owó ti ó fi tọ́jú ara rẹ̀ padà fún un, lẹ́yìn ìgbà tí ara rẹ̀ bá ti yá tan pátápátá.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.19",
            "verseOrgIds": [
              "EXO.21.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 21:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Bí ọkùnrin kan bá fi ọ̀pá lu ẹrúkùnrin tàbí ẹrúbìnrin rẹ̀, ti ẹrú náà sì kú lójú ẹsẹ̀, a ó fi ìyà jẹ ẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.20",
            "verseOrgIds": [
              "EXO.21.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n a kò ní fi ìyà jẹ ẹ́, ti ẹrú náà bá yè, tí ó dìde lẹ́yìn ọjọ́ kan tàbí méjì, nítorí ẹrú náà jẹ́ dúkìá rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.21",
            "verseOrgIds": [
              "EXO.21.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 21:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Bí àwọn ènìyàn ti ń jà bá pa aboyún lára, tí aboyún náà bá bímọ láìpé ọjọ́, ṣùgbọ́n tí kò sí aburú mìíràn mọ́ lẹ́yìn rẹ̀, ẹni tí ó fa ìpalára yìí yóò san iyekíye tí ọkọ aboyún náà bá béèrè fún, bí ilé ẹjọ́ bá ṣe gbà láààyè gẹ́gẹ́ bí owó ìtánràn.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.22",
            "verseOrgIds": [
              "EXO.21.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 21:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n bí ìpalára náà bá yọrí sí ikú aboyún náà, pípa ni a ó pa ẹni ti ó fa ikú aboyún náà.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.23",
            "verseOrgIds": [
              "EXO.21.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 21:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ojú fún ojú, eyín fún eyín, ọwọ́ fún ọwọ́, ẹsẹ̀ fún ẹsẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.24",
            "verseOrgIds": [
              "EXO.21.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 21:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "ìjóná fún ìjóná, ọgbẹ́ fún ọgbẹ́, ìnà fún ìnà.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.25",
            "verseOrgIds": [
              "EXO.21.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 21:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Bí ọkùnrin kan bá lu ẹrúkùnrin tàbí ẹrúbìnrin rẹ̀ ní ojú, ti ojú náà sì fọ́, ó ni láti jẹ́ kí ẹrú náà lọ ní òmìnira fún ìtánràn ojú rẹ̀ ti ó fọ́.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.26",
            "verseOrgIds": [
              "EXO.21.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 21:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ó bá sì lu ẹrúkùnrin tàbí ẹrúbìnrin rẹ̀ ti eyín rẹ̀ fi ká, ó ni láti jẹ́ kí ó lọ ní òmìnira ni ìtánràn fún eyín rẹ̀ tí ó ká.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.27",
            "verseOrgIds": [
              "EXO.21.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 21:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Bí akọ màlúù bá kan ọkùnrin tàbí obìnrin kan pa, a ó sọ akọ màlúù náà ní òkúta pa, a kò sì gbọdọ̀ jẹ ẹran rẹ̀. Ṣùgbọ́n a kò ní dá ẹni tí ó ni akọ màlúù náà lẹ́bi, ọrùn oní akọ màlúù náà yóò sì mọ́.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.28",
            "verseOrgIds": [
              "EXO.21.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 21:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n tí ó bá ti di ìgbà gbogbo ti akọ màlúù náà ti máa ń kan ènìyàn, tí a sì ti ń kìlọ̀ fún olówó rẹ̀, ti olówó rẹ̀ kò sì mú un so, tí ó bá kan ọkùnrin tàbí obìnrin pa, a ó sọ akọ màlúù náà ní òkúta pa, a ó sì pa olówó rẹ̀ pẹ̀lú.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.29",
            "verseOrgIds": [
              "EXO.21.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 21:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí àwọn ará ilé ẹni tí ó kú bá béèrè fún owó ìtánràn, yóò san iye owó tí wọ́n bá ní kí ó san fún owó ìtánràn láti fi ra ẹ̀mí ara rẹ̀ padà.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.30",
            "verseOrgIds": [
              "EXO.21.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 21:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí akọ màlúù bá kan ọmọkùnrin tàbí ọmọbìnrin pa, a ó ṣe gẹ́gẹ́ bí òfin yìí ti là á kalẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.31",
            "verseOrgIds": [
              "EXO.21.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 21:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí akọ màlúù bá kan ẹrúkùnrin tàbí ẹrúbìnrin pa, olówó rẹ̀ yóò san ọgbọ̀n ṣékélì fàdákà fún ẹni tó ni ẹrú, a ó sì sọ akọ màlúù náà ni òkúta pa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.32",
            "verseOrgIds": [
              "EXO.21.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 21:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Bí ọkùnrin kan bá ṣí kòtò sílẹ̀ láìbò tàbí kí ó gbẹ́ kòtò sílẹ̀ láìbò, tí màlúù tàbí kẹ́tẹ́kẹ́tẹ́ bá ṣe bẹ́ẹ̀ bọ́ sínú kòtò náà.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.33",
            "verseOrgIds": [
              "EXO.21.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 21:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹni tí ó ni kòtò yóò san owó àdánù yìí fún ẹni tí ó ni ẹran. Òkú ẹran náà yóò sì di tirẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.34",
            "verseOrgIds": [
              "EXO.21.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 21:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Bí akọ màlúù ọkùnrin kan bá pa akọ màlúù ẹlòmíràn lára tí ó sì kú, wọn yóò ta akọ màlúù tó wà láààyè, wọn yóò sì pín owó èyí tiwọn tà àti ẹran èyí tí ó kú dọ́gbadọ́gba.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.35",
            "verseOrgIds": [
              "EXO.21.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "EXO 21:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n tí ó bá ti di ìgbà gbogbo tí akọ màlúù náà máa ń kan òmíràn, tí olówó rẹ̀ kò sì mú un so, olówó rẹ̀ yóò san ẹran dípò ẹran. Ẹran tí ó kú yóò sì jẹ́ tirẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.36",
            "verseOrgIds": [
              "EXO.21.36"
            ]
          }
        }
      ]
