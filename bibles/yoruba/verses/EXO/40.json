          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n máa ń wẹ̀ nígbàkígbà tí wọ́n bá wọ àgọ́ àjọ tàbí tí wọ́n bá súnmọ́ pẹpẹ, gẹ́gẹ́ bí",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.32",
            "verseOrgIds": [
              "EXO.40.32"
            ]
          }
        },
