          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà àwọsánmọ̀",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.38",
            "verseOrgIds": [
              "EXO.40.38"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
