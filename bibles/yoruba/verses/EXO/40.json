          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose, Aaroni àti àwọn ọmọ rẹ̀ lò ó láti fi wẹ ọwọ́ àti ẹsẹ̀ wọn.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.31",
            "verseOrgIds": [
