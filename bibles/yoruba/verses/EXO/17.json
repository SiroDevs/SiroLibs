  "verseCount": 16,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "17",
        "style": "c",
        "sid": "EXO 17"
      },
      "items": [
        {
          "text": "17",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Omi láti inú àpáta",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo ìjọ ènìyàn Israẹli si gbéra láti jáde kúrò láti aginjù Sini wọ́n ń lọ láti ibi kan de ibi kan gẹ́gẹ́ bí",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.1",
            "verseOrgIds": [
              "EXO.17.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.17.1",
                "verseOrgIds": [
                  "EXO.17.1"
                ]
              }
            }
          ]
        },
        {
          "text": "ti pàṣẹ. Wọ́n pàgọ́ sí Refidimu, ṣùgbọ́n kò sí omi fún àwọn ènìyàn láti mú.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.1",
            "verseOrgIds": [
              "EXO.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ènìyàn sì sọ̀ fún Mose, wọ́n wí pé, \"Fún wa ni omi mu.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.2",
            "verseOrgIds": [
              "EXO.17.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EXO 17:2"
      },
      "items": [
        {
          "text": "Mose dá wọn lóhùn wí pé, \"Èéṣe ti ẹ̀yin fi ń bá mi jà? Èéṣe ti ẹ̀yin fi ń dán",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.2",
            "verseOrgIds": [
              "EXO.17.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.17.2",
                "verseOrgIds": [
                  "EXO.17.2"
                ]
              }
            }
          ]
        },
        {
          "text": "wò?\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.2",
            "verseOrgIds": [
              "EXO.17.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n òǹgbẹ ń gbẹ àwọn ènìyàn, wọ́n sì ń kùn sí Mose, wọ́n wí pé, \"Èéṣe tí ìwọ fi mú wa jáde kúrò ní Ejibiti láti mú kí òǹgbẹ pa àwa, àwọn ọmọ wa àti ohun ọ̀sìn wa ku fún òǹgbẹ.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.3",
            "verseOrgIds": [
              "EXO.17.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni Mose gbé ohùn rẹ̀ sókè sí",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.4",
            "verseOrgIds": [
              "EXO.17.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.17.4",
                "verseOrgIds": [
                  "EXO.17.4"
                ]
              }
            }
          ]
        },
        {
          "text": "pé, \"Kí ni kí èmi kí ó ṣe fún àwọn ènìyàn yìí? Wọ́n múra tan láti sọ mi ni òkúta.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.4",
            "verseOrgIds": [
              "EXO.17.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.17.5",
                "verseOrgIds": [
                  "EXO.17.5"
                ]
              }
            }
          ]
        },
        {
          "text": "sì dá Mose lóhùn pé, \"Máa lọ síwájú àwọn ènìyàn, mú nínú àwọn àgbàgbà Israẹli pẹ̀lú rẹ, mú ọ̀pá tí ìwọ fi lu odò Naili lọ́wọ́ kí ó sì máa lọ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.5",
            "verseOrgIds": [
              "EXO.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò dúró ni ibẹ̀ dè ọ ni orí àpáta ni Horebu. Ìwọ ó sì lu àpáta, omi yóò sì jáde nínú rẹ̀ fún àwọn ènìyàn láti mu.\" Mose sì ṣe bẹ́ẹ̀ ni iwájú àwọn àgbàgbà Israẹli.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.6",
            "verseOrgIds": [
              "EXO.17.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì sọ orúkọ ibẹ̀ ni Massa",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.7",
            "verseOrgIds": [
              "EXO.17.7"
            ]
          }
        },
        {
          "text": "àti Meriba",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.7",
            "verseOrgIds": [
              "EXO.17.7"
            ]
          }
        },
        {
          "text": ", nítorí àwọn ọmọ Israẹli sọ̀, wọ́n sì dán",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.7",
            "verseOrgIds": [
              "EXO.17.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.17.7",
                "verseOrgIds": [
                  "EXO.17.7"
                ]
              }
            }
          ]
        },
        {
          "text": "wò, wọ́n wí pé, \"Ǹjẹ́",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.7",
            "verseOrgIds": [
              "EXO.17.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.17.7",
                "verseOrgIds": [
                  "EXO.17.7"
                ]
              }
            }
          ]
        },
        {
          "text": "ń bẹ láàrín wa tàbí kò sí?\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.7",
            "verseOrgIds": [
              "EXO.17.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "A ṣẹ́gun àwọn ará Amaleki",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ara Amaleki jáde, wọ́n sì dìde ogun sí àwọn ọmọ Israẹli ni Refidimu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.8",
            "verseOrgIds": [
              "EXO.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose sì sọ fún Joṣua pé, \"Yàn lára àwọn ọkùnrin fún wa, kí wọn ó sì jáde lọ bá àwọn ará Amaleki jà. Ní ọ̀la, èmi yóò dúró ni orí òkè pẹ̀lú ọ̀pá Ọlọ́run ní ọwọ́ mi.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.9",
            "verseOrgIds": [
              "EXO.17.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joṣua ṣe bí Mose ti wí fún un, ó sì bá àwọn ará Amaleki jagun; nígbà tí Mose, Aaroni àti Huri lọ sí orí òkè náà.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.10",
            "verseOrgIds": [
              "EXO.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Níwọ́n ìgbà tí Mose bá gbé apá rẹ̀ sókè, Israẹli n borí ṣùgbọ́n nígbà tí ó bá sì rẹ apá rẹ̀ sílẹ̀, Amaleki a sì borí.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.11",
            "verseOrgIds": [
              "EXO.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n apá ń ro Mose, wọ́n mú òkúta, wọ́n sì fi sí abẹ́ rẹ̀, ó sì jókòó lé òkúta náà; Aaroni àti Huri sì mu ní apá rẹ̀, ọ̀kan ní apá ọ̀tún àti èkejì ni apá òsì; apá rẹ̀ méjèèjì sì dúró gangan títí di ìgbà ti oòrùn wọ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.12",
            "verseOrgIds": [
              "EXO.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joṣua sì fi ojú idà ṣẹ́gun àwọn ará Amaleki.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.13",
            "verseOrgIds": [
              "EXO.17.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.17.14",
                "verseOrgIds": [
                  "EXO.17.14"
                ]
              }
            }
          ]
        },
        {
          "text": "sì sọ fun Mose pé. \"Kọ èyí sì inú ìwé fún ìrántí, kí o sì sọ fún Joṣua pẹ̀lú; nítorí èmi yóò pa ìrántí Amaleki run pátápátá kúrò lábẹ́ ọ̀run.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.14",
            "verseOrgIds": [
              "EXO.17.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose sì tẹ́ pẹpẹ kan, ó sì sọ orúkọ pẹpẹ náà ní",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.15",
            "verseOrgIds": [
              "EXO.17.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.17.15",
                "verseOrgIds": [
                  "EXO.17.15"
                ]
              }
            }
          ]
        },
        {
          "text": "ni Àsíá mi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.15",
            "verseOrgIds": [
              "EXO.17.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó wí pé, \"A gbé ọwọ́ sókè sí ìtẹ́",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.16",
            "verseOrgIds": [
              "EXO.17.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.17.16",
                "verseOrgIds": [
                  "EXO.17.16"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.16",
            "verseOrgIds": [
              "EXO.17.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.17.16",
                "verseOrgIds": [
                  "EXO.17.16"
                ]
              }
            }
          ]
        },
        {
          "text": "yóò bá Amaleki jagun láti ìran dé ìran.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.16",
            "verseOrgIds": [
              "EXO.17.16"
            ]
          }
        }
      ]
    }
  ],
