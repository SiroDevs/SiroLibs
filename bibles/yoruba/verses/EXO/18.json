          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 18:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jẹ́ kí wọn ó máa ṣe ìdájọ́ àwọn ènìyàn ni gbogbo ìgbà, ṣùgbọ́n jẹ́ kí wọn mú ẹjọ́ tí ó bá nira fún wọn láti dá tọ̀ ọ́ wá; kí wọn kí ó máa dá ẹjọ́ kéékèèké. Èyí ni yóò mú iṣẹ́ rẹ rọrùn, wọn yóò sì máa ràn ọ́ lọ́wọ́ lórí ìdájọ́ ṣíṣe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.22",
            "verseOrgIds": [
              "EXO.18.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ìwọ bá ṣe èyí, bí Ọlọ́run bá sì fi àṣẹ sí i fún ọ bẹ́ẹ̀, àárẹ̀ kò sì ní tètè mu ọ, àwọn ènìyàn wọ̀nyí yóò sì padà lọ ilé wọn ni àlàáfíà.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.23",
            "verseOrgIds": [
              "EXO.18.23"
            ]
          }
        }
      ]
