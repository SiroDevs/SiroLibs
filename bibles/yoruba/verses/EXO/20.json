    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 20:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ènìyàn sì dúró ní òkèèrè nígbà tí Mose súnmọ́ ibi òkùnkùn biribiri níbi tí Ọlọ́run wà.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.21",
            "verseOrgIds": [
              "EXO.20.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 20:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.20.22",
                "verseOrgIds": [
                  "EXO.20.22"
                ]
              }
            }
          ]
        },
        {
          "text": "sì sọ fún Mose pé, \"Sọ àwọn nǹkan wọ̀nyí fún àwọn ará Israẹli, 'Ẹ̀yin ti rí i fúnra yín bí èmi ti bá a yín sọ̀rọ̀ láti ọ̀run wá.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.22",
            "verseOrgIds": [
              "EXO.20.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 20:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ̀yin kò gbọdọ̀ sin ọlọ́run mìíràn pẹ̀lú mi: ẹ̀yin kò gbọdọ̀ rọ ọlọ́run fàdákà tàbí ọlọ́run wúrà fún ara yín.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.23",
            "verseOrgIds": [
              "EXO.20.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 20:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Pẹpẹ erùpẹ̀ ni kí ìwọ mọ fún mi. Ní orí pẹpẹ yìí ni kí ìwọ ti máa rú ẹbọ sísun rẹ sí mi àti ẹbọ àlàáfíà rẹ, àgùntàn rẹ, ewúrẹ́ àti akọ màlúù rẹ. Ní ibi gbogbo tí mo gbé fi ìrántí orúkọ mi sí, èmi yóò sì máa tọ̀ ọ́ wá, èmi yóò sì máa bùkún ọ níbẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.24",
            "verseOrgIds": [
              "EXO.20.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 20:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ìwọ bá ṣe pẹpẹ òkúta fún mi, má ṣe fi òkúta tí a ṣe lọ́ṣọ̀ọ́ kọ́ ọ, nítorí bí ìwọ bá lo ohun ọnà rẹ lórí rẹ̀, ìwọ sọ ọ di àìmọ́.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.25",
            "verseOrgIds": [
              "EXO.20.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 20:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ kò gbọdọ̀ gun àkàsọ̀ lọ sí ibi pẹpẹ mi, kí àwọn ènìyàn má ba à máa wo ìhòhò rẹ láti abẹ́ aṣọ tí ìwọ wọ̀ nígbà tí ìwọ bá ń gòkè lọ sí ibi pẹpẹ.'",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.26",
            "verseOrgIds": [
              "EXO.20.26"
            ]
          }
        }
      ]
    }
