  "verseCount": 16,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
        "style": "c",
        "sid": "SNG 5"
      },
      "items": [
        {
          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp"
      },
      "items": [
        {
          "text": "Olùfẹ́",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "SNG 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mo ti dé inú ọgbà mi, arábìnrin mi, ìyàwó mi;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.1",
            "verseOrgIds": [
              "SNG.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:1"
      },
      "items": [
        {
          "text": "mo ti kó òjìá pẹ̀lú òórùn dídùn mi jọ.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.1",
            "verseOrgIds": [
              "SNG.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 5:1"
      },
      "items": [
        {
          "text": "Mo ti jẹ afárá mi pẹ̀lú oyin mi;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.1",
            "verseOrgIds": [
              "SNG.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:1"
      },
      "items": [
        {
          "text": "mo ti mu ọtí wáìnì mi pẹ̀lú wàrà mi.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.1",
            "verseOrgIds": [
              "SNG.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp",
        "vid": "SNG 5:1"
      },
      "items": [
        {
          "text": "Ọ̀rẹ́",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 5:1"
      },
      "items": [
        {
          "text": "Ẹ jẹ, ẹ̀yin ọ̀rẹ́, ẹ mu,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.1",
            "verseOrgIds": [
              "SNG.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:1"
      },
      "items": [
        {
          "text": "àní ẹ mu àmuyó, ẹ̀yin olùfẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.1",
            "verseOrgIds": [
              "SNG.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp"
      },
      "items": [
        {
          "text": "Olólùfẹ́",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "SNG 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mo ti sùn ṣùgbọ́n ọkàn mi jí.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.2",
            "verseOrgIds": [
              "SNG.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:2"
      },
      "items": [
        {
          "text": "Gbọ́! Olólùfẹ́ mi ń kan ìlẹ̀kùn.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.2",
            "verseOrgIds": [
              "SNG.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 5:2"
      },
      "items": [
        {
          "text": "\"Ṣí i fún mi, arábìnrin mi, olùfẹ́ mi,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.2",
            "verseOrgIds": [
              "SNG.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:2"
      },
      "items": [
        {
          "text": "àdàbà mi, aláìlábàwọ́n mi,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.2",
            "verseOrgIds": [
              "SNG.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 5:2"
      },
      "items": [
        {
          "text": "orí mi kún fún omi ìrì,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.2",
            "verseOrgIds": [
              "SNG.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:2"
      },
      "items": [
        {
          "text": "irun mi kún fún òtútù òru.\"",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.2",
            "verseOrgIds": [
              "SNG.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "SNG 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mo ti bọ́ aṣọ ìgúnwà mi",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.3",
            "verseOrgIds": [
              "SNG.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:3"
      },
      "items": [
        {
          "text": "ṣé èmi gbọdọ̀ tún gbé e wọ̀?",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.3",
            "verseOrgIds": [
              "SNG.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 5:3"
      },
      "items": [
        {
          "text": "Mo ti wẹ ẹsẹ̀ mi",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.3",
            "verseOrgIds": [
              "SNG.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:3"
      },
      "items": [
        {
          "text": "ṣé èmi gbọdọ̀ tún tì í bọ eruku?",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.3",
            "verseOrgIds": [
              "SNG.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "SNG 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olùfẹ́ mi na ọwọ́ rẹ̀ láti inú ihò ìlẹ̀kùn",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.4",
            "verseOrgIds": [
              "SNG.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:4"
      },
      "items": [
        {
          "text": "inú mi sì yọ́ sí i.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.4",
            "verseOrgIds": [
              "SNG.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "SNG 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi dìde láti ṣílẹ̀kùn fún olùfẹ́ mi,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.5",
            "verseOrgIds": [
              "SNG.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:5"
      },
      "items": [
        {
          "text": "òjìá bẹ̀rẹ̀ sí í kán ní ọwọ́ mi,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.5",
            "verseOrgIds": [
              "SNG.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 5:5"
      },
      "items": [
        {
          "text": "òjìá olóòórùn ń ti ara ìka mi ń sàn",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.5",
            "verseOrgIds": [
              "SNG.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:5"
      },
      "items": [
        {
          "text": "sí orí ìdìmú ìlẹ̀kùn.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.5",
            "verseOrgIds": [
              "SNG.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "SNG 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi ṣí ìlẹ̀kùn fún olùfẹ́ mi,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.6",
            "verseOrgIds": [
              "SNG.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:6"
      },
      "items": [
        {
          "text": "ṣùgbọ́n olùfẹ́ mi ti kúrò, ó ti lọ",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.6",
            "verseOrgIds": [
              "SNG.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:6"
      },
      "items": [
        {
          "text": "ọkàn mi gbọgbẹ́ fún lílọ rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.6",
            "verseOrgIds": [
              "SNG.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 5:6"
      },
      "items": [
        {
          "text": "Mo wá a kiri ṣùgbọ́n, n kò rí i.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.6",
            "verseOrgIds": [
              "SNG.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:6"
      },
      "items": [
        {
          "text": "Mo pè é ṣùgbọ́n, kò dáhùn.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.6",
            "verseOrgIds": [
              "SNG.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "SNG 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn olùṣọ́ tí ń ṣọ́ ìlú rí mi",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.7",
            "verseOrgIds": [
              "SNG.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:7"
      },
      "items": [
        {
          "text": "bí wọ́n ti ṣe ń rìn yí ìlú ká.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.7",
            "verseOrgIds": [
              "SNG.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 5:7"
      },
      "items": [
        {
          "text": "Wọ́n nà mí, wọ́n sá mi lọ́gbẹ́;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.7",
            "verseOrgIds": [
              "SNG.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:7"
      },
      "items": [
        {
          "text": "wọ́n gba ìborùn mi lọ́wọ́ mi.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.7",
            "verseOrgIds": [
              "SNG.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:7"
      },
      "items": [
        {
          "text": "Àwọn olùṣọ́ tí ń ṣọ́ odi!",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.7",
            "verseOrgIds": [
              "SNG.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "SNG 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ̀yin ọmọbìnrin Jerusalẹmu, mo bẹ̀ yín",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.8",
            "verseOrgIds": [
              "SNG.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:8"
      },
      "items": [
        {
          "text": "bí ẹ̀yin bá rí olùfẹ́ mi,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.8",
            "verseOrgIds": [
              "SNG.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 5:8"
      },
      "items": [
        {
          "text": "kí ni ẹ̀yin yóò wí fún un?",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.8",
            "verseOrgIds": [
              "SNG.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:8"
      },
      "items": [
        {
          "text": "Ẹ wí fún un pé àìsàn ìfẹ́ ń ṣe mi.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.8",
            "verseOrgIds": [
              "SNG.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp"
      },
      "items": [
        {
          "text": "Ọ̀rẹ́",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "SNG 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kí ni olùfẹ́ rẹ fi dára ju àwọn tókù lọ,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.9",
            "verseOrgIds": [
              "SNG.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:9"
      },
      "items": [
        {
          "text": "ìwọ arẹwà jùlọ láàrín àwọn obìnrin?",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.9",
            "verseOrgIds": [
              "SNG.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 5:9"
      },
      "items": [
        {
