  "2TH.2": {
    "id": "2TH.2",
    "number": "2",
    "bookId": "2TH",
    "reference": "2 Tẹsalonika 2",
    "copyright": "Biblica® ní oore ọ̀fẹ́ láti lo Bíbélì Mímọ́ ní Èdè Yorùbá Òde-Òní™ Ẹ̀tọ́ àdàkọ © 2009, 2017 Biblica, Inc. Biblica® Open Yoruba Contemporary Bible™ Copyright © 2009, 2017 by Biblica, Inc. ‪\"Biblica\" ni àmì ìdámọ̀ tí Biblica, Inc. fi sílẹ̀ ní United States Patent àti ní ilé iṣẹ́ tí wọ́n ti ń fúnni ní àmì ìdámọ̀. Gba àṣẹ kí o tó lòó. \"Biblica\" is a trademark registered in the United States Patent and Trademark Office by Biblica, Inc. Used with permission.",
    "verseCount": 17,
    "content": [
      {
        "name": "chapter",
        "type": "tag",
        "attrs": {
          "number": "2",
          "style": "c",
          "sid": "2TH 2"
        },
        "items": [
          {
            "text": "2",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "s1"
        },
        "items": [
          {
            "text": "Ọkùnrin aláìlófin náà",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "1",
              "style": "v",
              "sid": "2TH 2:1"
            },
            "items": [
              {
                "text": "1",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ní ti bíbọ̀ Jesu Kristi Olúwa wa, àti ti ìpéjọ wa sọ́dọ̀ rẹ̀, àwa wí fún yín ará,",
            "type": "text",
            "attrs": {
              "verseId": "2TH.2.1",
              "verseOrgIds": [
                "2TH.2.1"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "2",
              "style": "v",
              "sid": "2TH 2:2"
            },
            "items": [
              {
                "text": "2",
                "type": "text"
              }
            ]
          },
          {
            "text": "kí ọkàn yín má ṣe àìbalẹ̀, tàbí kí ẹ má ṣe jáyà nípa àsọtẹ́lẹ̀, ìròyìn tàbí lẹ́tà tí ó lè fi ara jọ èyí tí ó le wá láti ọ̀dọ̀ wa, tí yóò máa wí pé ọjọ́ Olúwa ti dé ná.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.2.2",
              "verseOrgIds": [
                "2TH.2.2"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "3",
              "style": "v",
              "sid": "2TH 2:3"
            },
            "items": [
              {
                "text": "3",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ẹ má ṣe jẹ́ kí ẹnikẹ́ni kí ó tàn yín jẹ ní ọ̀nàkọnà, nítorí pé ọjọ́ náà kì yóò dé, bí kò ṣe pé ìṣọ̀tẹ̀ bá kọ́ ṣẹlẹ̀, tí a sì fi ẹni ẹ̀ṣẹ̀ hàn, tí í ṣe ọmọ ègbé.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.2.3",
              "verseOrgIds": [
                "2TH.2.3"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "4",
              "style": "v",
              "sid": "2TH 2:4"
            },
            "items": [
              {
                "text": "4",
                "type": "text"
              }
            ]
          },
          {
            "text": "Òun yóò lòdì sí, yóò sì gbé ara rẹ̀ ga sí gbogbo ohun tí a ń pè ní Ọlọ́run tàbí tí a ń sìn, dé ibi pé yóò gbé ara rẹ̀ jókòó nínú tẹmpili Ọlọ́run, tí yóò sì pe ara rẹ̀ ní Ọlọ́run.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.2.4",
              "verseOrgIds": [
                "2TH.2.4"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "5",
              "style": "v",
              "sid": "2TH 2:5"
            },
            "items": [
              {
                "text": "5",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ṣé ẹ̀yin kò rántí pé nígbà tí mo wà pẹ̀lú yín, mo ń sọ àwọn nǹkan wọ̀nyí fún un yín.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.2.5",
              "verseOrgIds": [
                "2TH.2.5"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "6",
              "style": "v",
              "sid": "2TH 2:6"
            },
            "items": [
              {
                "text": "6",
                "type": "text"
              }
            ]
          },
          {
            "text": "Àti pé nísinsin yìí, ẹ̀yin mọ ohun tí ń dá a dúró, kí a bá a lè fi í hàn ní àkókò rẹ̀ gan an.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.2.6",
              "verseOrgIds": [
                "2TH.2.6"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "7",
              "style": "v",
              "sid": "2TH 2:7"
            },
            "items": [
              {
                "text": "7",
                "type": "text"
              }
            ]
          },
          {
            "text": "Nítorí agbára ìkọ̀kọ̀ ẹni ẹ̀ṣẹ̀ ti ń ṣiṣẹ́; ṣùgbọ́n ẹni tí ń dènà yóò máa ṣe bẹ́ẹ̀ títí a ó fi mú un kúrò ní ọ̀nà.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.2.7",
              "verseOrgIds": [
                "2TH.2.7"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "8",
              "style": "v",
              "sid": "2TH 2:8"
            },
            "items": [
              {
                "text": "8",
                "type": "text"
              }
            ]
          },
          {
            "text": "Nígbà náà ni a ó fi ẹni ẹ̀ṣẹ̀ hàn, ẹni tí Jesu Olúwa yóò fi èémí ẹnu rẹ̀ pa, tí yóò sì fi ọlá ìpadàbọ̀ rẹ̀ parun.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.2.8",
              "verseOrgIds": [
                "2TH.2.8"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "9",
              "style": "v",
              "sid": "2TH 2:9"
            },
            "items": [
              {
                "text": "9",
                "type": "text"
              }
            ]
          },
          {
            "text": "Wíwá ẹni ẹ̀ṣẹ̀ yóò rí bí iṣẹ́ Satani, gbogbo èyí tí a fihàn gẹ́gẹ́ bí àdàmọ̀dì iṣẹ́ ìyanu, àdàmọ̀dì àmì àti àdàmọ̀dì idán,",
            "type": "text",
            "attrs": {
              "verseId": "2TH.2.9",
              "verseOrgIds": [
                "2TH.2.9"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "10",
              "style": "v",
              "sid": "2TH 2:10"
            },
            "items": [
              {
                "text": "10",
                "type": "text"
              }
            ]
          },
          {
            "text": "ní gbogbo ọ̀nà búburú tí a fi ń tan àwọn tí ń ṣègbé jẹ. Wọ́n ṣègbé nítorí wọ́n kọ̀ láti fẹ́ràn òtítọ́ kí wọn sì di ẹni ìgbàlà.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.2.10",
              "verseOrgIds": [
                "2TH.2.10"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "11",
              "style": "v",
              "sid": "2TH 2:11"
            },
            "items": [
              {
                "text": "11",
                "type": "text"
              }
            ]
          },
          {
            "text": "Nítorí ìdí èyí, Ọlọ́run rán ohun tó ń ṣiṣẹ́ ìṣìnà sí wọn kí wọn lè gba èké gbọ́,",
            "type": "text",
            "attrs": {
              "verseId": "2TH.2.11",
              "verseOrgIds": [
                "2TH.2.11"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "12",
              "style": "v",
              "sid": "2TH 2:12"
            },
            "items": [
              {
                "text": "12",
                "type": "text"
              }
            ]
          },
          {
            "text": "kí wọn kí ó lè gba ìdálẹ́bi, àní àwọn tí kò gba òtítọ́ gbọ́, ṣùgbọ́n tí wọ́n ní inú dídùn nínú ìwà búburú.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.2.12",
              "verseOrgIds": [
                "2TH.2.12"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "s1"
        },
        "items": [
          {
            "text": "Ẹ dúró ṣinṣin",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "13",
              "style": "v",
              "sid": "2TH 2:13"
            },
            "items": [
              {
                "text": "13",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ṣùgbọ́n, ohun tí ó tọ́ fún wa ni láti máa dúpẹ́ lọ́wọ́ Ọlọ́run nígbà gbogbo nítorí yín, ará olùfẹ́ ní ti Olúwa, nítorí láti ìbẹ̀rẹ̀ ni Ọlọ́run ti yàn yín sí ìgbàlà nípa ìsọdimímọ́ ti Ẹ̀mí àti nípa gbígba òtítọ́ gbọ́.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.2.13",
              "verseOrgIds": [
                "2TH.2.13"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "14",
              "style": "v",
              "sid": "2TH 2:14"
            },
            "items": [
              {
                "text": "14",
                "type": "text"
              }
            ]
          },
          {
            "text": "Òun ti pè yín sí èyí nípa ìyìnrere wa, kí ẹ̀yin kí ó lè pín nínú ògo Jesu Kristi Olúwa wa.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.2.14",
              "verseOrgIds": [
                "2TH.2.14"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "15",
              "style": "v",
              "sid": "2TH 2:15"
            },
            "items": [
              {
                "text": "15",
                "type": "text"
              }
            ]
          },
          {
            "text": "Nítorí náà ará, ẹ dúró ṣinṣin, kí ẹ sì di àwọn ẹ̀kọ́ wọ̀n-ọn-nì tí a kọ́ yín mú, yálà nípa ọ̀rọ̀ ẹnu tàbí lẹ́tà.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.2.15",
              "verseOrgIds": [
                "2TH.2.15"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "16",
              "style": "v",
              "sid": "2TH 2:16"
            },
            "items": [
              {
                "text": "16",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ǹjẹ́ kí Jesu Kristi Olúwa wa tìkálára rẹ̀, àti Ọlọ́run Baba wa, ẹni to ti fẹ́ wa, tí ó sì ti fi ìtùnú àìnípẹ̀kun àti ìrètí rere nípa oore-ọ̀fẹ́ fún wa.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.2.16",
              "verseOrgIds": [
                "2TH.2.16"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "17",
              "style": "v",
              "sid": "2TH 2:17"
            },
            "items": [
              {
                "text": "17",
                "type": "text"
              }
            ]
          },
          {
            "text": "Kí ó mú ọkàn yín le, kí ó sì kún yín pẹ̀lú agbára nínú iṣẹ́ gbogbo àti ọ̀rọ̀ rere gbogbo.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.2.17",
              "verseOrgIds": [
                "2TH.2.17"
              ]
            }
          }
        ]
      }
    ],
