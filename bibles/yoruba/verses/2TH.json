    "verseCount": 12,
    "content": [
      {
        "name": "chapter",
        "type": "tag",
        "attrs": {
          "number": "1",
          "style": "c",
          "sid": "2TH 1"
        },
        "items": [
          {
            "text": "1",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "1",
              "style": "v",
              "sid": "2TH 1:1"
            },
            "items": [
              {
                "text": "1",
                "type": "text"
              }
            ]
          },
          {
            "text": "Paulu, Sila àti Timotiu,",
            "type": "text",
            "attrs": {
              "verseId": "2TH.1.1",
              "verseOrgIds": [
                "2TH.1.1"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "b",
          "vid": "2TH 1:1"
        },
        "items": []
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p",
          "vid": "2TH 1:1"
        },
        "items": [
          {
            "text": "Sí ìjọ Tẹsalonika, nínú Ọlọ́run Baba wa àti Jesu Kristi Olúwa:",
            "type": "text",
            "attrs": {
              "verseId": "2TH.1.1",
              "verseOrgIds": [
                "2TH.1.1"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "b"
        },
        "items": []
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "2",
              "style": "v",
              "sid": "2TH 1:2"
            },
            "items": [
              {
                "text": "2",
                "type": "text"
              }
            ]
          },
          {
            "text": "Oore-ọ̀fẹ́ àti àlàáfíà fún yín láti ọ̀dọ̀ Ọlọ́run Baba àti Jesu Kristi Olúwa.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.1.2",
              "verseOrgIds": [
                "2TH.1.2"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "b"
        },
        "items": []
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "s1"
        },
        "items": [
          {
            "text": "Ìdúpẹ́ àti àdúrà",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "3",
              "style": "v",
              "sid": "2TH 1:3"
            },
            "items": [
              {
                "text": "3",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ó yẹ kí a máa dúpẹ́ lọ́wọ́ Ọlọ́run nígbà gbogbo nítorí yín, ará, àní gẹ́gẹ́ bí ó ti yẹ, nítorí pé ìgbàgbọ́ yín ń dàgbà gidigidi, àti ìfẹ́ olúkúlùkù yín sí ara yín ń di púpọ̀.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.1.3",
              "verseOrgIds": [
                "2TH.1.3"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "4",
              "style": "v",
              "sid": "2TH 1:4"
            },
            "items": [
              {
                "text": "4",
                "type": "text"
              }
            ]
          },
          {
            "text": "Nítorí náà, àwa tìkára wa ń fi yín ṣògo nínú ìjọ Ọlọ́run, nítorí sùúrù àti ìgbàgbọ́ yín nínú gbogbo inúnibíni àti wàhálà yín tí ẹ̀yin náà ń fi ara dà.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.1.4",
              "verseOrgIds": [
                "2TH.1.4"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "5",
              "style": "v",
              "sid": "2TH 1:5"
            },
            "items": [
              {
                "text": "5",
                "type": "text"
              }
            ]
          },
          {
            "text": "Àwọn nǹkan wọ̀nyí jẹ́ ẹ̀rí pé òdodo ni ìdájọ́ Ọlọ́run àti pé nítorí èyí ni a ó kà yín yẹ fún ìjọba Ọlọ́run, nítorí èyí tí ẹ̀yin pẹ̀lú ṣe ń jìyà.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.1.5",
              "verseOrgIds": [
                "2TH.1.5"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "6",
              "style": "v",
              "sid": "2TH 1:6"
            },
            "items": [
              {
                "text": "6",
                "type": "text"
              }
            ]
          },
          {
            "text": "Olódodo ni Ọlọ́run: Òun yóò pọ́n àwọn tí ń pọ́n yín lójú, lójú,",
            "type": "text",
            "attrs": {
              "verseId": "2TH.1.6",
              "verseOrgIds": [
                "2TH.1.6"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "7",
              "style": "v",
              "sid": "2TH 1:7"
            },
            "items": [
              {
                "text": "7",
                "type": "text"
              }
            ]
          },
          {
            "text": "Òun yóò sì fi ìtura fún ẹ̀yin tí a ti pọ́n lójú àti fún àwa náà pẹ̀lú. Èyí yóò sì ṣe nígbà ìfarahàn Jesu Olúwa láti ọ̀run wá fún wá nínú ọwọ́ iná pẹ̀lú àwọn angẹli alágbára.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.1.7",
              "verseOrgIds": [
                "2TH.1.7"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "8",
              "style": "v",
              "sid": "2TH 1:8"
            },
            "items": [
              {
                "text": "8",
                "type": "text"
              }
            ]
          },
          {
            "text": "Òun yóò fi ìyà jẹ àwọn tí kò mọ Ọlọ́run àti àwọn tí ń ṣe àìgbọ́ràn sí ìyìnrere Jesu Olúwa wa.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.1.8",
              "verseOrgIds": [
                "2TH.1.8"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "9",
              "style": "v",
              "sid": "2TH 1:9"
            },
            "items": [
              {
                "text": "9",
                "type": "text"
              }
            ]
          },
          {
            "text": "A ó fi ìparun àìnípẹ̀kun jẹ wọ́n ní yà, a ó sì ṣe wọn mọ̀ kúrò níwájú Olúwa àti inú ògo agbára rẹ̀,",
            "type": "text",
            "attrs": {
              "verseId": "2TH.1.9",
              "verseOrgIds": [
                "2TH.1.9"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "10",
              "style": "v",
              "sid": "2TH 1:10"
            },
            "items": [
              {
                "text": "10",
                "type": "text"
              }
            ]
          },
          {
            "text": "ní ọjọ́ tí yóò jẹ́ ẹni tí a ó yìn lógo nínú àwọn ènìyàn mímọ́ rẹ̀ àti ẹni àwòyanu ní àárín gbogbo àwọn tí ó ti gbàgbọ́. Èyí kò yọ yín sílẹ̀, nítorí ẹ ti gba ẹ̀rí tí a jẹ́ sí yín gbọ́.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.1.10",
              "verseOrgIds": [
                "2TH.1.10"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "11",
              "style": "v",
              "sid": "2TH 1:11"
            },
            "items": [
              {
                "text": "11",
                "type": "text"
              }
            ]
          },
          {
            "text": "Nítorí èyí, àwa pẹ̀lú ń gbàdúrà fún un yín nígbà gbogbo, pé kí Ọlọ́run wa kí ó lè kà yín yẹ fún ìpè rẹ̀, àti pé nípa agbára rẹ̀, òun yóò mú gbogbo èrò rere yín ṣẹ àti gbogbo ohun tí ìgbàgbọ́ bá rú jáde.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.1.11",
              "verseOrgIds": [
                "2TH.1.11"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "12",
              "style": "v",
              "sid": "2TH 1:12"
            },
            "items": [
              {
                "text": "12",
                "type": "text"
              }
            ]
          },
          {
            "text": "Wọ̀nyí ni àdúrà wa, kí orúkọ Jesu Olúwa wa lè di yíyìn lógo nínú yín àti ẹ̀yin nínú rẹ̀, gẹ́gẹ́ bí oore-ọ̀fẹ́ Ọlọ́run àti ti Jesu Kristi Olúwa.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.1.12",
              "verseOrgIds": [
                "2TH.1.12"
              ]
            }
          }
        ]
      }
    ],
