  "verseCount": 33,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "10",
        "style": "c",
        "sid": "1CO 10"
      },
      "items": [
        {
          "text": "10",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìkìlọ̀ láti inú ìtàn àwọn ọmọ Israẹli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CO 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí èmi kò fẹ́ kí ẹ̀yin jẹ́ òpè si òtítọ́, ẹ̀yin arákùnrin ọ̀wọ́n, a kó gbọdọ̀ gbàgbé ohun tí ó ṣẹlẹ̀ sí àwọn ènìyàn wa nínú aginjù. Ọlọ́run ṣamọ̀nà wọn nípa rírán ìkùùkuu síwájú wọn, ó sì sìn wọ́n la omi Òkun pupa já.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.1",
            "verseOrgIds": [
              "1CO.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CO 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "A lè pe eléyìí ní ìtẹ̀bọmi ti Mose nínú ìkùùkuu àti nínú omi Òkun.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.2",
            "verseOrgIds": [
              "1CO.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CO 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nípa iṣẹ́ ìyanu, gbogbo wọn jẹ oúnjẹ ẹ̀mí kan náà.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.3",
            "verseOrgIds": [
              "1CO.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CO 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n mu nínú omi tí Kristi fi fún wọn. Wọ́n mu omi ẹ̀mí láti inú àpáta tí ó ń tẹ̀lé wọn, àpáta náà ni Kristi. Ó wà pẹ̀lú wọn nínú aginjù náà, òun ni àpáta tí ń fi omi ẹ̀mí tu ọkàn lára.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.4",
            "verseOrgIds": [
              "1CO.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CO 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n ọ̀pọ̀lọpọ̀ wọn ni inú Ọlọ́run kò dún sí; nítorí a pa wọ́n run nínú aginjù.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.5",
            "verseOrgIds": [
              "1CO.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CO 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn nǹkan wọ̀nyí sì jásí àpẹẹrẹ fún àwa, kí a má ṣe ní ìfẹ́ sí àwọn ohun búburú gẹ́gẹ́ bí àwọn ènìyàn yìí ṣe ní ìfẹ́ si.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.6",
            "verseOrgIds": [
              "1CO.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CO 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kí ẹ̀yin kí ó má ṣe jẹ́ abọ̀rìṣà gẹ́gẹ́ bí wọ́n ti ṣe; gẹ́gẹ́ bí a ti kọ ọ́ pé, \"Àwọn ènìyàn náà jókòó láti jẹ àti láti mu, wọ́n sì dìde dúró láti ṣe ìfẹ́kúfẹ̀ẹ́.\"",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.7",
            "verseOrgIds": [
              "1CO.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CO 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ ni kí àwa kí ó má ṣe ṣe àgbèrè gẹ́gẹ́ bí àwọn mìíràn nínú wọn ti ṣe, tí ẹgbẹ̀rún méjìlélógún ó lé lẹgbẹ̀rún (23,000) ènìyàn sì kú ní ọjọ́ kan.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.8",
            "verseOrgIds": [
              "1CO.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CO 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ ni kí ẹ̀yin má ṣe dán Olúwa wò, gẹ́gẹ́ bí àwọn mìíràn nínú wọn ti dán an wò, tí a sì fi ejò run wọ́n.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.9",
            "verseOrgIds": [
              "1CO.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CO 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ ni kí ẹ̀yin kí ó má ṣe kùn, gẹ́gẹ́ bí àwọn mìíràn nínú wọ́n ṣe kùn, tí a sì ti ọwọ́ olùparun run wọ́n.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.10",
            "verseOrgIds": [
              "1CO.10.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CO 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo àwọn nǹkan wọ̀nyí ṣẹlẹ̀ sí wọn bí àpẹẹrẹ fún wa, a sì kọ̀wé wọn fún ìkìlọ̀ fún wa, àwa ẹni tí ìgbẹ̀yìn ayé dé bá.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.11",
            "verseOrgIds": [
              "1CO.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CO 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà, ẹni tí ó bá rò pé òun dúró, kí ó kíyèsára kí ó ma ba à ṣubú.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.12",
            "verseOrgIds": [
              "1CO.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CO 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kò sí ìdánwò kan tí ó ti bá yín, bí kò ṣe irú èyí tí ó mọ níwọ̀n fún ènìyàn, ṣùgbọ́n olódodo ni Ọlọ́run, ẹni ti kì yóò jẹ́ kí á dán an yín wò ju bí ẹ̀yin ti le gbà, ṣùgbọ́n tí yóò sì ṣe ọ̀nà àbáyọ pẹ̀lú nínú ìdánwò náà, kí ẹ̀yin ba à lè faradà á.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.13",
            "verseOrgIds": [
              "1CO.10.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Oúnjẹ òrìṣà àti oúnjẹ alẹ́ Olúwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CO 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà, ẹ̀yin olùfẹ́ ọ̀wọ́n, ẹ sá fún ìbọ̀rìṣà.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.14",
            "verseOrgIds": [
              "1CO.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CO 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi ń sọ̀rọ̀ bí ọlọ́gbọ́n ènìyàn, ṣe ìdájọ́ fúnra rẹ̀ ohun tí mo sọ.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.15",
            "verseOrgIds": [
              "1CO.10.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CO 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ǹjẹ́ ago ìdúpẹ́ nípasẹ̀ èyí tí a ń dúpẹ́ fún, kì í ha ṣe jíjẹ́ alábápín ìdàpọ̀ nínú ẹ̀jẹ̀ Kristi bí? Àkàrà tí a bù, kì í ha ṣe jíjẹ́ alábápín nínú ara Kristi bi?",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.16",
            "verseOrgIds": [
              "1CO.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CO 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí àkàrà kan ni ó ń bẹ, àwa tí a pọ̀ níye, tí a sì jẹ ara kan ń pín nínú àkàrà kan ṣoṣo.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.17",
            "verseOrgIds": [
              "1CO.10.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CO 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ wo Israẹli nípa ti ara, àwọn tí ń jẹ ohun ẹbọ kò ha ṣe alábápín pẹpẹ bí?",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.18",
            "verseOrgIds": [
              "1CO.10.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CO 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ǹjẹ́ kí ni mo ń wí? Ṣé pé ohun tí a fi rú ẹbọ sí òrìṣà jẹ́ nǹkan kan tàbí pé òrìṣà jẹ́ nǹkan kan?",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.19",
            "verseOrgIds": [
              "1CO.10.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CO 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rárá, ṣùgbọ́n ohun tí mo ń wí ni pé, ohun tí àwọn aláìkọlà fi ń rú ẹbọ wọn fi fun àwọn ẹ̀mí èṣù. Dájúdájú kì í ṣe ìrúbọ sí Ọlọ́run. Èmi kò sì fẹ́ kí ẹnikẹ́ni nínú yín so ara rẹ̀ pọ̀ mọ́ ẹ̀mí èṣù.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.20",
            "verseOrgIds": [
              "1CO.10.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CO 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ̀yin kò lè mu nínú ago tí Olúwa àti ago ti èṣù lẹ́ẹ̀kan náà; ẹ̀yin kò le ṣe àjọpín ní tábìlì Olúwa, àti ni tábìlì ẹ̀mí èṣù lẹ́ẹ̀kan náà.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.21",
            "verseOrgIds": [
              "1CO.10.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CO 10:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kí ni ẹ̀ ń gbìyànjú láti ṣe? Àwa ha ń mú Olúwa jowú bí? Àwa ha ní agbára jù ú lọ bi?",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.22",
            "verseOrgIds": [
              "1CO.10.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Òmìnira àwọn onígbàgbọ́",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CO 10:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ohun gbogbo ni o yẹ fún mi,\" ṣùgbọ́n kì í ṣe ohun gbogbo ni ó ní èrè. \"Ohun gbogbo ni ó yẹ fún mi,\" ṣùgbọ́n kì í ṣe ohun gbogbo ni ń gbe ni rò.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.23",
            "verseOrgIds": [
              "1CO.10.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CO 10:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Má ṣe ronú nípa ara rẹ̀ nìkan; ṣùgbọ́n kí olúkúlùkù máa wá rere ọmọnìkejì rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.24",
            "verseOrgIds": [
              "1CO.10.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CO 10:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jẹ ẹrankẹ́ran tí wọ́n bá ń tà lọ́jà. Má ṣe gbìyànjú láti wádìí lọ́wọ́ ẹni tí ń tà á nítorí ẹ̀rí ọkàn.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.25",
            "verseOrgIds": [
              "1CO.10.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CO 10:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí \"Ayé àti gbogbo nǹkan rere tí ń bẹ nínú rẹ̀, tí Olúwa ni wọ́n jẹ́.\"",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.26",
            "verseOrgIds": [
              "1CO.10.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CO 10:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ẹnikẹ́ni tí kì í bá ṣe onígbàgbọ́ ba pè yín sí ibi àsè láti jẹun, bá a lọ. Gba ìpè rẹ̀ tí ó bá tẹ́ ọ lọ́rùn. Jẹ ohunkóhun tí ó bá pèsè sílẹ̀ fún àsè náà, má ṣe béèrè ohunkóhun nípa rẹ̀ nítorí ẹ̀rí ọkàn.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.27",
            "verseOrgIds": [
              "1CO.10.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CO 10:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ẹnikẹ́ni bá sì kìlọ̀ fún un yín pé, \"A ti fi ẹran yìí rú ẹbọ,\" ẹ má ṣe jẹ́ ẹ nítorí ẹni ti o sọ fun ọ àti nítorí ẹ̀rí ọkàn.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.28",
            "verseOrgIds": [
              "1CO.10.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CO 10:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi ń sọ̀rọ̀ nípa ẹ̀rí ọkàn ẹni tí ó sọ fún ọ kì í ṣe tirẹ̀. Nítorí kín ni a ó fi dá mi lẹ́jọ́ nítorí ẹ̀rí ọkàn ẹlòmíràn.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.29",
            "verseOrgIds": [
              "1CO.10.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CO 10:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí èmi ba fi ọpẹ́ jẹ ẹ́, èéṣe tí a fì ń sọ̀rọ̀ mi ní búburú nítorí ohun tí èmi dúpẹ́ fún.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.30",
            "verseOrgIds": [
              "1CO.10.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CO 10:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà tí ẹ̀yin bá jẹ tàbí tí ẹ bá mu tàbí ohunkóhun tí ẹ̀yin bá sè, e máa ṣe gbogbo rẹ̀ fún ògo Ọlọ́run.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.31",
            "verseOrgIds": [
              "1CO.10.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1CO 10:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà, má ṣe jẹ́ òkúta ìkọ̀sẹ̀ tí ó lè gbé ẹlòmíràn ṣubú ìbá à ṣe Júù tàbí Giriki tàbí ìjọ Ọlọ́run.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.32",
            "verseOrgIds": [
              "1CO.10.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1CO 10:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí mo ṣè n gbìyànjú láti tẹ́ ẹnìkọ̀ọ̀kan lọ́rùn nínú gbogbo nǹkan tí mo bá ń ṣe láì wa ohun rere fún ara mi bí kò ṣe ti ènìyàn púpọ̀ kí ó lè ṣe é ṣe fún wọn láti le ní ìgbàlà.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.33",
            "verseOrgIds": [
              "1CO.10.33"
            ]
          }
        }
      ]
    }
