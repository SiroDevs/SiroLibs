  "verseCount": 14,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
        "style": "c",
        "sid": "HEB 5"
      },
      "items": [
        {
          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HEB 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí olórí àlùfáà kọ̀ọ̀kan tí a yàn nínú àwọn ènìyàn, ní a fi jẹ nítorí iṣẹ́ ìsìn àwọn ènìyàn sí Ọlọ́run láti máa mú ẹ̀bùn àti ẹbọ wá nítorí ẹ̀ṣẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.1",
            "verseOrgIds": [
              "HEB.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HEB 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹni tí ó lè ṣe jẹ́ẹ́jẹ́ pẹ̀lú àwọn aláìmòye, tí ó sì lé bá àwọn tí ó ti yapa kẹ́dùn, nítorí a fi àìlera yí òun náà ká pẹ̀lú.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.2",
            "verseOrgIds": [
              "HEB.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HEB 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí ìdí èyí ni ó ṣe yẹ, bí ó ti ń rú ẹbọ nítorí ẹ̀ṣẹ̀ fún àwọn ènìyàn rẹ̀, bẹ́ẹ̀ pẹ̀lú ní ń ṣe fún ara rẹ̀ náà.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.3",
            "verseOrgIds": [
              "HEB.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HEB 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kọ sí ẹni tí o gba ọlá yìí fún ara rẹ̀, bí kò ṣe ẹni tí a pè láti ọ̀dọ̀ Ọlọ́run wá gẹ́gẹ́ bí a ti pe Aaroni.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.4",
            "verseOrgIds": [
              "HEB.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HEB 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ ni Kristi pẹ̀lú kò sì ṣe ara rẹ̀ lógo láti jẹ́ olórí àlùfáà; bí kò ṣe ẹni tí o wí fún ún pé,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.5",
            "verseOrgIds": [
              "HEB.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HEB 5:5"
      },
      "items": [
        {
          "text": "\"Ìwọ ni ọmọ mi,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.5",
            "verseOrgIds": [
              "HEB.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HEB 5:5"
      },
      "items": [
        {
          "text": "lónìí ni mo bí ọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.5",
            "verseOrgIds": [
              "HEB.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HEB 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ó ti wí pẹ̀lú ní ibòmíràn pé,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.6",
            "verseOrgIds": [
              "HEB.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HEB 5:6"
      },
      "items": [
        {
          "text": "\"Ìwọ ni àlùfáà títí láé",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.6",
            "verseOrgIds": [
              "HEB.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HEB 5:6"
      },
      "items": [
        {
          "text": "ní ipasẹ̀ Melkisedeki.\"",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.6",
            "verseOrgIds": [
              "HEB.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HEB 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ìgbà ọjọ́ Jesu nínú ayé, ó fi ìkérora rara àti omijé gbàdúrà, tí ó sì bẹ̀bẹ̀ lọ́dọ̀ ẹni tí ó lè gbà á sílẹ̀ lọ́wọ́ ikú, a sì gbóhùn rẹ̀ nítorí ó ní ẹ̀mí ìbẹ̀rù Ọlọ́run rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.7",
            "verseOrgIds": [
              "HEB.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HEB 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí òun tilẹ̀ ń ṣe Ọmọ Ọlọ́run, síbẹ̀ ó kọ́ ìgbọ́ran nípa ohun tí ó jìyà rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.8",
            "verseOrgIds": [
              "HEB.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HEB 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí a sì ti sọ ọ di pípé, o wa di orísun ìgbàlà àìnípẹ̀kun fún gbogbo àwọn tí ó ń gbọ́ tirẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.9",
            "verseOrgIds": [
              "HEB.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HEB 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "tí a yàn ní olórí àlùfáà láti ọ̀dọ̀ Ọlọ́run wá ní ipasẹ̀ Melkisedeki.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.10",
            "verseOrgIds": [
              "HEB.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìkìlọ̀ lórí ṣíṣubú kúrò nínú ìgbàgbọ́",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HEB 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nípa èyí àwa ní ohun púpọ̀ láti sọ, tí ó sì ṣòro láti túmọ̀, nítorí pé ẹ yigbì ní gbígbọ́.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.11",
            "verseOrgIds": [
              "HEB.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HEB 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí pé báyìí ó ti yẹ kí ẹ jẹ́ olùkọ́ni, ẹ tún wà ní ẹni tí ẹnìkan yóò máa kọ́ ni ìbẹ̀rẹ̀ ìpìlẹ̀ ẹ̀kọ́ àwọn ọ̀rọ̀ Ọlọ́run, ẹ sì tún di irú àwọn tí ó mu wàrà, tí wọn kò sì fẹ́ oúnjẹ líle.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.12",
            "verseOrgIds": [
              "HEB.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HEB 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí olúkúlùkù ẹni tí ń mu wàrà jẹ́ aláìlóye ọ̀rọ̀ òdodo, nítorí ọmọ ọwọ́ ni.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.13",
            "verseOrgIds": [
              "HEB.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HEB 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n oúnjẹ líle wà fún àwọn tí ó dàgbà, àwọn ẹni nípa ìrírí, tí wọn ń lo ọgbọ́n wọn láti fi ìyàtọ̀ sáàrín rere àti búburú.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.14",
            "verseOrgIds": [
              "HEB.5.14"
            ]
          }
        }
      ]
    }
  ],
