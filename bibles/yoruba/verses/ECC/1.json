      "attrs": {
        "style": "q2",
        "vid": "ECC 1:18"
      },
      "items": [
        {
          "text": "bí ìmọ̀ bá sì ṣe pọ̀ tó náà ni ìbànújẹ́ ń pọ̀ tó.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.18",
