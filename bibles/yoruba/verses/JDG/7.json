  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "7",
        "style": "c",
        "sid": "JDG 7"
      },
      "items": [
        {
          "text": "7",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Gideoni ṣẹ́gun àwọn ará Midiani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JDG 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní òwúrọ̀ kùtùkùtù Jerubbaali (èyí ni Gideoni) pẹ̀lú gbogbo àwọn ọmọ-ogun tí ó wà pẹ̀lú rẹ̀ kó ogun jọ lẹ́bàá a orísun Harodi. Àwọn ogun Midiani sì wà ní apá àríwá tí wọ́n ní àfonífojì tí ó wà ní ẹ̀bá òkè More.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.1",
            "verseOrgIds": [
              "JDG.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JDG 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.7.2",
                "verseOrgIds": [
                  "JDG.7.2"
                ]
              }
            }
          ]
        },
        {
          "text": "wí fún Gideoni pé, \"Àwọn ọmọ-ogun tí o kójọ sọ́dọ̀ ti pọ̀jù fún mi láti fi àwọn ogun Midiani lé wọn lọ́wọ́, kí Israẹli má ba à gbé ara rẹ̀ ga sí mi wí pé agbára òun ni ó gbà á là,",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.2",
            "verseOrgIds": [
              "JDG.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JDG 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "sì kéde sí àwọn ènìyàn nísinsin yìí pé, 'Ẹnikẹ́ni tí ó bá ń gbọ̀n, tí ó sì ń bẹ̀rù lè padà sẹ́yìn, kí ó sì kúrò lórí òkè Gileadi.' \" Báyìí ni Gideoni ṣe ya àwọn ènìyàn náà. Ẹgbẹ̀rún méjìlélógún (22,000) ọkùnrin sì padà sẹ́yìn àwọn ẹgbẹ̀rún mẹ́wàá (10,000) sì dúró.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.3",
            "verseOrgIds": [
              "JDG.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JDG 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.7.4",
                "verseOrgIds": [
                  "JDG.7.4"
                ]
              }
            }
          ]
        },
        {
          "text": "sì tún sọ fún Gideoni pé, \"Àwọn ènìyàn yìí sì tún pọ̀jù. Kó wọn lọ sí ibi tí omi wà, èmi yóò sì yọ̀rọ̀ wọn níbẹ̀ fún ọ. Bí mo bá wí pé eléyìí yóò bá ọ lọ yóò lọ, ṣùgbọ́n tí mo bá sọ pé, 'Eléyìí kò ní bá ọ lọ,' òun kò gbọdọ̀ lọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.4",
            "verseOrgIds": [
              "JDG.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JDG 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gideoni sì kó àwọn ọkùnrin náà lọ sí ibi ìsun omi. Níbẹ̀ ni",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.5",
            "verseOrgIds": [
              "JDG.7.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.7.5",
                "verseOrgIds": [
                  "JDG.7.5"
                ]
              }
            }
          ]
        },
        {
          "text": "ti wí fún un pé, \"Kí ó pín àwọn ènìyàn náà sí ọ̀nà méjì. Ya àwọn tí ó fi ahọ́n wọn lá omi bí ajá kúrò lára àwọn tí ó kúnlẹ̀ láti mu omi pẹ̀lú ọwọ́ wọn.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.5",
            "verseOrgIds": [
              "JDG.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JDG 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ̀ọ́dúnrún (300) ọkùnrin ni ó lá omi pẹ̀lú ahọ́n wọn. Gbogbo àwọn ìyókù ni ó kúnlẹ̀ láti mu mi.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.6",
            "verseOrgIds": [
              "JDG.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.7.7",
                "verseOrgIds": [
                  "JDG.7.7"
                ]
              }
            }
          ]
        },
        {
          "text": "wí fún Gideoni pé, \"Àwọn ọ̀ọ́dúnrún (300) ọkùnrin tí ó lá omi ni èmi yóò lò láti gbà yín là àti láti fi ogun Midiani lé yín lọ́wọ́. Jẹ́ kí àwọn tókù padà sí ilé wọn.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.7",
            "verseOrgIds": [
              "JDG.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JDG 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Báyìí ni Gideoni ṣe dá àwọn Israẹli tí ó kù padà sí àgọ́ wọn, ṣùgbọ́n ó dá àwọn ọ̀ọ́dúnrún (300) ọkùnrin náà dúró. Àwọn wọ̀nyí sì gba gbogbo ohun èlò àti fèrè àwọn tí ó ti padà.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.8",
            "verseOrgIds": [
              "JDG.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JDG 7:8"
      },
      "items": [
        {
          "text": "Ibùdó ogun àwọn Midiani wà ní àfonífojì ní ìsàlẹ̀. Ibi tí ó wà.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.8",
            "verseOrgIds": [
              "JDG.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JDG 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní òru ọjọ́ náà",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.9",
            "verseOrgIds": [
              "JDG.7.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.7.9",
                "verseOrgIds": [
                  "JDG.7.9"
                ]
              }
            }
          ]
        },
        {
          "text": "sọ fún Gideoni pé, \"Dìde, dojú ogun kọ ibùdó ogun àwọn ará Midiani nítorí èmi yóò fi lé ọ lọ́wọ́.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.9",
            "verseOrgIds": [
              "JDG.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JDG 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n bí ẹ̀rù àti kọlù wọ́n bá ń bà ọ́, yọ́ wọ ibùdó wọn lọ kí o mú Pura ìránṣẹ́ rẹ lọ́wọ́",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.10",
            "verseOrgIds": [
              "JDG.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JDG 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "kí o sì fi ara balẹ̀ gbọ́ ohun tí wọ́n ń sọ nínú ibùdó náà. Lẹ́yìn èyí ọkàn rẹ̀ yóò le láti kọlù ibùdó náà.\" Báyìí ni òun àti Pura ìránṣẹ́ rẹ̀ wọ ẹnu-ọ̀nà ibùdó yìí.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.11",
            "verseOrgIds": [
              "JDG.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JDG 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ará Midiani, àwọn ará Amaleki àti gbogbo ènìyàn ìlà-oòrùn tó lọ ní àfonífojì bí eṣú ni wọ́n rí nítorí púpọ̀ wọn. Àwọn ìbákasẹ wọn kò sì lóǹkà, wọ́n sì pọ̀ bí yanrìn inú Òkun.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.12",
            "verseOrgIds": [
              "JDG.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JDG 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gideoni dé sí àsìkò tí ọkùnrin kan bẹ̀rẹ̀ sí í rọ́ àlá tí ó lá sí ọ̀kan nínú àwọn ọ̀rẹ́ rẹ̀. Ó ní, \"Mo lá àlá kan, nínú àlá náà mo rí àkàrà kan tó ṣe róbótó tí a fi barle ṣe ń yí wọ inú ibùdó àwọn ará Midiani, ó sì kọlu àgọ́ pẹ̀lú agbára ńlá dé bi wí pé àgọ́ náà dojúdé, ó sì ṣubú.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.13",
            "verseOrgIds": [
              "JDG.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JDG 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ̀rẹ́ rẹ̀ dá a lóhùn pé, \"Èyí kò le túmọ̀ sí ohun mìíràn ju idà Gideoni ọmọ Joaṣi ará Israẹli lọ: Ọlọ́run ti fi àwọn ará Midiani àti gbogbo ogun ibùdó lé e lọ́wọ́.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.14",
            "verseOrgIds": [
              "JDG.7.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JDG 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí Gideoni gbọ́ àlá náà àti ìtumọ̀ rẹ̀, ó wólẹ̀ sin Ọlọ́run: lẹ́yìn náà ni ó padà sí ibùdó àwọn ọmọ Israẹli ó sì pè wọ́n pé, \"Ẹ dìde! Nítorí pé",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.15",
            "verseOrgIds": [
              "JDG.7.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.7.15",
                "verseOrgIds": [
                  "JDG.7.15"
                ]
              }
            }
          ]
        },
        {
          "text": "yóò lò yín láti ṣẹ́gun gbogbo ogun Midiani.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.15",
            "verseOrgIds": [
              "JDG.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JDG 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí ó ti pín àwọn ọ̀ọ́dúnrún (300) ọkùnrin wọ̀n-ọn-nì sí ọ̀nà mẹ́ta, ó fi fèrè, pẹ̀lú àwọn òfìfo ìkòkò lé ẹnìkọ̀ọ̀kan wọn lọ́wọ́, iná sì wà nínú àwọn ìkòkò náà.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.16",
            "verseOrgIds": [
              "JDG.7.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JDG 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sọ fún wọn pé, \"Ẹ máa wò mí, kí ẹ sì máa ṣe ohun tí mo bá ṣe. Nígbà tí mo bá dé igun ibùdó wọn ẹ ṣe ohun tí mo bá ṣe.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.17",
            "verseOrgIds": [
              "JDG.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JDG 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí èmi àti àwọn ọkùnrin tí ó wà pẹ̀lú mi bá fun fèrè wa, bẹ́ẹ̀ ni kí ẹ̀yin náà ni gbogbo igun ibùdó tí ẹ̀ bá wà kí ẹ fun àwọn fèrè yín kí ẹ sì hó pé, 'Fún",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.18",
            "verseOrgIds": [
              "JDG.7.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.7.18",
                "verseOrgIds": [
                  "JDG.7.18"
                ]
              }
            }
          ]
        },
        {
          "text": "àti fún Gideoni.' \"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.18",
            "verseOrgIds": [
              "JDG.7.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JDG 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gideoni àti àwọn ọgọ́rùn-ún ọkùnrin tí ó wà pẹ̀lú rẹ̀ dé òpin ibùdó àwọn ará Midiani ní nǹkan bí agogo méjìlá padà. Wọ́n fun fèrè wọn, wọ́n sì tún fọ́ àwọn ìkòkò tí ó wà ní ọwọ́ mọ́lẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.19",
            "verseOrgIds": [
              "JDG.7.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JDG 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ẹgbẹ́ mẹ́tẹ̀ẹ̀ta fun fèrè wọn, wọ́n tún fọ́ àwọn ìkòkò wọn mọ́lẹ̀. Wọ́n mú àwọn fìtílà iná wọn ní ọwọ́ òsì wọn àti fèrè tí wọ́n ń fun ní ọwọ́ ọ̀tún wọn. Wọ́n pariwo hé è pé, \"Idà kan fún",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.20",
            "verseOrgIds": [
              "JDG.7.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.7.20",
                "verseOrgIds": [
                  "JDG.7.20"
                ]
              }
            }
          ]
        },
        {
          "text": "àti fún Gideoni!\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.20",
            "verseOrgIds": [
              "JDG.7.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JDG 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí ọkùnrin kọ̀ọ̀kan dúró ní ipò rẹ̀ yí ibùdó àwọn Midiani ká, gbogbo àwọn ọmọ-ogun Midiani ń sá káàkiri, wọ́n ń pariwo bí wọ́n ṣe ń sálọ.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.21",
            "verseOrgIds": [
              "JDG.7.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JDG 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí àwọn ọ̀ọ́dúnrún (300) ọkùnrin wọ̀n-ọn-nì fun fèrè wọn,",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.22",
            "verseOrgIds": [
              "JDG.7.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.7.22",
                "verseOrgIds": [
                  "JDG.7.22"
                ]
              }
            }
          ]
        },
        {
          "text": "sì yí ojú idà ọkùnrin kọ̀ọ̀kan padà sí ẹnìkejì rẹ̀ àti sí gbogbo ogun wọn. Àwọn ọmọ-ogun sì sá títí dé Beti-Sitta ní ọ̀nà Serera títí lọ dé ìpínlẹ̀ Abeli-Mehola ní ẹ̀bá Tabbati.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.22",
            "verseOrgIds": [
              "JDG.7.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JDG 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo àwọn ọmọ-ogun Israẹli láti ẹ̀yà Naftali, Aṣeri àti gbogbo Manase ni Gideoni ránṣẹ́ si, wọ́n wá wọ́n sì lé àwọn ará Midiani.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.23",
            "verseOrgIds": [
              "JDG.7.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JDG 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gideoni tún ránṣẹ́ sí gbogbo àwọn ìlú tí ó wà ní orí òkè Efraimu wí pé, \"Ẹ jáde wá bá àwọn ará Midiani jà, kí ẹ tètè gba àwọn omi Jordani títí dé Beti-Bara kí wọ́n tó dé bẹ̀.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.24",
            "verseOrgIds": [
              "JDG.7.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JDG 7:24"
      },
      "items": [
        {
          "text": "Báyìí ni a ṣe pe gbogbo ọkùnrin ológun Efraimu jáde tí wọ́n sì gba gbogbo àwọn à bá wọ odò Jordani títí dé Beti-Bara.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.24",
            "verseOrgIds": [
              "JDG.7.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JDG 7:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n mú méjì nínú àwọn olórí àwọn ará Midiani, àwọn náà ni Orebu àti Seebu. Wọ́n pa Horebu nínú àpáta Orebu, wọ́n sì pa Seebu níbi tí àwọn ènìyàn ti mọ̀ fún wáìnì tí a ń pè ní ìfúntí Seebu. Wọ́n lé àwọn ará Midiani, nígbà tí wọ́n gbé orí Orebu àti Seebu tọ Gideoni wá ẹni tí ó wà ní apá kejì Jordani.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.25",
            "verseOrgIds": [
              "JDG.7.25"
            ]
          }
        }
      ]
    }
  ],
