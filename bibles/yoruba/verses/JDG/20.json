  "verseCount": 48,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "20",
        "style": "c",
        "sid": "JDG 20"
      },
      "items": [
        {
          "text": "20",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Àwọn ọmọ Israẹli bá ará Benjamini jà",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JDG 20:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo àwọn ọmọ Israẹli láti Dani dé Beerṣeba, àti láti ilẹ̀ Gileadi jáde bí ẹnìkan ṣoṣo wọ́n sì péjọ síwájú",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.1",
            "verseOrgIds": [
              "JDG.20.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.20.1",
                "verseOrgIds": [
                  "JDG.20.1"
                ]
              }
            }
          ]
        },
        {
          "text": "ni Mispa.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.1",
            "verseOrgIds": [
              "JDG.20.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JDG 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn olórí gbogbo àwọn ènìyàn láti gbogbo ẹ̀yà Israẹli dúró ní ipò wọn ní àpéjọ àwọn ènìyàn Ọlọ́run, ogún ọ̀kẹ́ (400,000) ọkùnrin ológun ti àwọn àti idà wọn.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.2",
            "verseOrgIds": [
              "JDG.20.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JDG 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Àwọn ẹ̀yà Benjamini gbọ́ wí pé àwọn ọmọ Israẹli yòókù ti gòkè lọ sí Mispa.) Nígbà náà ni àwọn ọmọ Israẹli wí pé, \"Ẹ sọ fún wa báwo ni iṣẹ́ búburú ṣe ṣẹlẹ̀.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.3",
            "verseOrgIds": [
              "JDG.20.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JDG 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ará Lefi náà, ọkọ obìnrin tí wọ́n pa fèsì pé, \"Èmi àti àlè mi wá sí Gibeah ti àwọn ará Benjamini láti sùn di ilẹ̀ mọ́ níbẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.4",
            "verseOrgIds": [
              "JDG.20.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JDG 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n ní òru àwọn ọkùnrin Gibeah lépa mi wọ́n sì yí ilé náà po pẹ̀lú èrò láti pa mí. Wọ́n fi ipá bá àlè mi lòpọ̀, òun sì kú.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.5",
            "verseOrgIds": [
              "JDG.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JDG 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mo mú àlè mi náà, mo sì gé e sí ekìrí ekìrí, mo sì fi ekìrí kọ̀ọ̀kan ránṣẹ́ sí agbègbè ìní Israẹli kọ̀ọ̀kan, nítorí pé wọ́n ti ṣe ohun tí ó jẹ́ èèwọ̀ àti ohun ìtìjú yìí ní ilẹ̀ Israẹli.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.6",
            "verseOrgIds": [
              "JDG.20.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nísinsin yìí, gbogbo ẹ̀yin ọmọ Israẹli, ẹ sọ ìmọ̀ràn yín, kí ẹ sì ṣe ìdájọ́ yín.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.7",
            "verseOrgIds": [
              "JDG.20.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JDG 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo àwọn ènìyàn náà sì dìde bí ẹnìkan pẹ̀lú gbólóhùn kan wí pé, \"Kò sí ẹnikẹ́ni nínú wa tí yóò lọ sí àgọ́ rẹ̀. Rárá o, kò sí ẹyọ ẹnìkan tí yóò padà lọ sí ilé rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.8",
            "verseOrgIds": [
              "JDG.20.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JDG 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n nísinsin yìí, ohun tí àwa yóò ṣe sí Gibeah ní yìí. Àwa yóò lọ kọlù ú bí ìbò bá ṣe darí wa.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.9",
            "verseOrgIds": [
              "JDG.20.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JDG 20:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "A yóò mú ọkùnrin mẹ́wàá nínú ọgọ́rùn-ún nínú gbogbo ẹ̀yà Israẹli àti ọgọ́rùn-ún láti inú ẹgbẹ̀rún (1,000) kan àti ẹgbẹ̀rún kan láti inú ẹgbẹ̀rún mẹ́wàá (10,000) láti máa pèsè oúnjẹ fún àwọn ọmọ-ogun. Yóò sì ṣe nígbà tí àwọn jagunjagun bá dé Gibeah ti àwọn ará Benjamini, wọn yóò fún wọn ní ohun tí ó bá tọ́ sí wọn fún gbogbo ìwà búburú àti ìwà ìtìjú tí wọ́n ṣe yìí ní ilẹ̀ Israẹli.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.10",
            "verseOrgIds": [
              "JDG.20.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JDG 20:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Báyìí ni gbogbo àwọn ọkùnrin Israẹli parapọ̀ ṣọ̀kan bí ọkùnrin kan ṣoṣo wọ́n sì dìde sí ìlú náà.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.11",
            "verseOrgIds": [
              "JDG.20.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JDG 20:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ẹ̀yà Israẹli rán àwọn ọkùnrin sí gbogbo ẹ̀yà Benjamini wí pé, \"Kí ni ẹ̀rí sí ìwà búburú yìí tí ó ṣẹlẹ̀ ní àárín yín?",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.12",
            "verseOrgIds": [
              "JDG.20.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JDG 20:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà ẹ mú àwọn ẹni ibi ti Gibeah yìí wá fún wa, kí àwa lé pa, kí a sì fọ ìṣe búburú yìí mọ́ kúrò ní Israẹli.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.13",
            "verseOrgIds": [
              "JDG.20.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JDG 20:13"
      },
      "items": [
        {
          "text": "Ṣùgbọ́n àwọn ẹ̀yà Benjamini kò fetí sí ti àwọn arákùnrin wọn ọmọ Israẹli.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.13",
            "verseOrgIds": [
              "JDG.20.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JDG 20:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ẹ̀yà Benjamini sì kó ara wọn jọ láti àwọn ìlú wọn sí Gibeah láti bá àwọn ọmọ Israẹli jà.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.14",
            "verseOrgIds": [
              "JDG.20.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JDG 20:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ẹsẹ̀kẹsẹ̀ àwọn ará Benjamini kó ẹgbàá mẹ́tàlá (26,000) àwọn ọmọ-ogun tí ń lọ dájọ́ láti àwọn ìlú wọn, yàtọ̀ sí àwọn ẹ̀ẹ́dẹ́gbẹ̀rin (700) àṣàyàn ọkùnrin nínú àwọn tí ń gbé Gibeah.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.15",
            "verseOrgIds": [
              "JDG.20.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JDG 20:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní àárín àwọn ọmọ-ogun wọ̀nyí ni ó ti ní àwọn ẹ̀ẹ́dẹ́gbẹ̀rin (700) àṣàyàn ọkùnrin tí wọ́n ń lo ọwọ́ òsì, tí ọ̀kọ̀ọ̀kan wọn dára dé bi pé wọ́n lè fi kànnàkànnà ba fọ́nrán òwú ní àìtàsé (wọ́n jẹ́ atamọ́tàsé).",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.16",
            "verseOrgIds": [
              "JDG.20.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JDG 20:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ọkùnrin Israẹli, yàtọ̀ sí àwọn ará Benjamini, ka ogún ọ̀kẹ́ (400,000) àwọn tí ń fi idà jagun, gbogbo wọn jẹ́ akọni ní ogun jíjà.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.17",
            "verseOrgIds": [
              "JDG.20.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JDG 20:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ọmọ Israẹli lọ sí Beteli, wọ́n sì béèrè lọ́wọ́ Ọlọ́run. Wọ́n wí pé, \"Ta ni nínú wa tí yóò kọ́ kojú àwọn ará Benjamini láti bá wọn jà?\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.18",
            "verseOrgIds": [
              "JDG.20.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JDG 20:18"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.20.18",
                "verseOrgIds": [
                  "JDG.20.18"
                ]
              }
            }
          ]
        },
        {
          "text": "dáhùn pé, \"Juda ni yóò kọ́ lọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.18",
            "verseOrgIds": [
              "JDG.20.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JDG 20:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ọmọ Israẹli dìde ní òwúrọ̀ ọjọ́ kejì, wọ́n sì dó ti Gibeah (wọ́n tẹ̀gùn sí ẹ̀bá Gibeah).",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.19",
            "verseOrgIds": [
              "JDG.20.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JDG 20:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ọkùnrin Israẹli jáde lọ láti bá àwọn ará Benjamini jà wọ́n sì dúró ní ipò ogun sí wọn ní Gibeah.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.20",
            "verseOrgIds": [
              "JDG.20.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JDG 20:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ọmọ Benjamini sì jáde láti Gibeah wá wọ́n sì pa àwọn ọmọ ẹgbẹ̀rún méjìlélógún (22,000) ọkùnrin nínú àwọn ọmọ Israẹli ní ojú ogun ní ọjọ́ náà.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.21",
            "verseOrgIds": [
              "JDG.20.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JDG 20:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n àwọn ọkùnrin Israẹli mú ara wọn lọ́kàn le, wọ́n sì tún dúró sí ipò wọn ní ibi tí wọ́n dúró sí ní ọjọ́ àkọ́kọ́.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.22",
            "verseOrgIds": [
              "JDG.20.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JDG 20:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ọmọ Israẹli sì lọ wọ́n sọkún ní iwájú",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.23",
            "verseOrgIds": [
              "JDG.20.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.20.23",
                "verseOrgIds": [
                  "JDG.20.23"
                ]
              }
            }
          ]
        },
        {
          "text": "títí oòrùn fi wọ̀, wọ́n sì béèrè lọ́wọ́",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.23",
            "verseOrgIds": [
              "JDG.20.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.20.23",
                "verseOrgIds": [
                  "JDG.20.23"
                ]
              }
            }
          ]
        },
        {
          "text": ". Wọ́n ni, \"Ṣé kí àwa tún gòkè lọ kí a sì bá àwọn ará Benjamini arákùnrin wa jà?\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.23",
            "verseOrgIds": [
              "JDG.20.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JDG 20:23"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.20.23",
                "verseOrgIds": [
                  "JDG.20.23"
                ]
              }
            }
          ]
        },
        {
          "text": "dáhùn pé, \"Lọ bá wọn jà.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.23",
            "verseOrgIds": [
              "JDG.20.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JDG 20:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ọmọ Israẹli sì tún súnmọ́ tòsí àwọn ará Benjamini ní ọjọ́ kejì.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.24",
            "verseOrgIds": [
              "JDG.20.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JDG 20:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọjọ́ yìí nígbà tí ará Benjamini jáde sí wọn láti Gibeah, láti dojúkọ wọn, wọ́n pa ẹgbàá mẹ́sàn (18,000) ọkùnrin Israẹli, gbogbo wọn jẹ́ jagunjagun tí ń lo idà.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.25",
            "verseOrgIds": [
              "JDG.20.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JDG 20:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni gbogbo àwọn ọmọ Israẹli àní gbogbo àwọn ènìyàn, gòkè lọ sí Beteli, níbẹ̀ ni wọ́n jókòó tí wọ́n sì ń sọkún níwájú",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.26",
            "verseOrgIds": [
              "JDG.20.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.20.26",
                "verseOrgIds": [
                  "JDG.20.26"
                ]
              }
            }
          ]
        },
        {
          "text": ". Wọ́n gbààwẹ̀ ní ọjọ́ náà títí di àṣálẹ́, wọ́n sì rú ọrẹ ẹbọ sísun àti ọrẹ àlàáfíà sí",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.26",
            "verseOrgIds": [
              "JDG.20.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.20.26",
                "verseOrgIds": [
                  "JDG.20.26"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.26",
            "verseOrgIds": [
              "JDG.20.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JDG 20:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ọmọ Israẹli sì béèrè lọ́wọ́",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.27",
            "verseOrgIds": [
              "JDG.20.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.20.27",
                "verseOrgIds": [
                  "JDG.20.27"
                ]
              }
            }
          ]
        },
        {
          "text": ". (Ní ọjọ́ wọ̀n-ọn-nì àpótí ẹ̀rí Ọlọ́run wà níbẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.27",
            "verseOrgIds": [
              "JDG.20.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JDG 20:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Finehasi ọmọ Eleasari ọmọ Aaroni, ní ń ṣe iṣẹ́ ìránṣẹ́ ní iwájú rẹ̀.) wọ́n béèrè pé, \"Ṣe àwa tún le lọ sí ogun pẹ̀lú Benjamini arákùnrin wa tàbí kí a má lọ?\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.28",
            "verseOrgIds": [
              "JDG.20.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JDG 20:28"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.20.28",
                "verseOrgIds": [
                  "JDG.20.28"
                ]
              }
            }
          ]
        },
        {
          "text": "dáhùn pé, \"Ẹ lọ nítorí ní ọ̀la ni èmi yóò fi wọ́n lé e yín lọ́wọ́.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.28",
            "verseOrgIds": [
              "JDG.20.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JDG 20:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ọmọ Israẹli sì yàn àwọn ènìyàn tí ó sá pamọ́ yí Gibeah ká.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.29",
            "verseOrgIds": [
              "JDG.20.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JDG 20:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n jáde tọ àwọn ọmọ Benjamini lọ ní ọjọ́ kẹta wọ́n sì dúró ní ipò wọn, wọ́n sì dìde ogun sí Gibeah bí wọ́n ti ṣe tẹ́lẹ̀ rí.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.30",
            "verseOrgIds": [
              "JDG.20.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JDG 20:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ọmọ Benjamini sì jáde láti pàdé wọn, àwọn ọmọ Israẹli sì tàn wọ́n jáde kúrò ní ìlú náà. Wọ́n bẹ̀rẹ̀ sí ní ṣẹ́gun àwọn ọmọ Israẹli bí i ti àtijọ́ dé bi pé wọ́n pa bí ọgbọ̀n ọkùnrin ní pápá àti ní àwọn òpópó náà—àwọn ọ̀nà tí ó lọ sí Beteli àti èkejì sí Gibeah.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.31",
            "verseOrgIds": [
              "JDG.20.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JDG 20:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí àwọn Benjamini ń wí pé, \"Àwa ti ń ṣẹ́gun wọn bí i ti ìṣáájú,\" àwọn ọmọ Israẹli ń wí pé, \"Ẹ jẹ́ kí a sá kí a lè fà wọ́n kúrò ní ìlú sí ojú òpópó náà.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.32",
            "verseOrgIds": [
              "JDG.20.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JDG 20:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo àwọn ọkùnrin Israẹli dìde kúrò ní ipò wọn, wọ́n sì tẹ̀dó ogun ní Baali-Tamari, àwọn ọmọ-ogun Israẹli tí wọ́n sá pamọ́ sínú igbó jáde kúrò níbi tí wọ́n wà ní ìwọ̀-oòrùn Gibeah.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.33",
            "verseOrgIds": [
              "JDG.20.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JDG 20:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni ẹgbẹ̀rún mẹ́wàá (10,000) àwọn àṣàyàn ológun àwọn ọmọ Israẹli gbógun ti Gibeah láti iwájú ogun náà le gidigidi dé bí i pé àwọn ẹ̀yà Benjamini kò funra pé ìparun wà nítòsí.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.34",
            "verseOrgIds": [
              "JDG.20.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JDG 20:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.20.35",
                "verseOrgIds": [
                  "JDG.20.35"
                ]
              }
            }
          ]
        },
        {
          "text": "ṣẹ́gun Benjamini níwájú àwọn ọmọ Israẹli, ní ọjọ́ náà àwọn ọmọ Israẹli pa ẹgbàá méjìlá ó lé lẹ̀ẹ́dẹ́gbẹ̀fà (25,100) ọkùnrin Benjamini, gbogbo wọn fi idà dìhámọ́ra ogun.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.35",
            "verseOrgIds": [
              "JDG.20.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JDG 20:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ẹ̀yà Benjamini sì rí pé wọ́n ti ṣẹ́gun àwọn.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.36",
            "verseOrgIds": [
              "JDG.20.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JDG 20:36"
      },
      "items": [
        {
          "text": "Àwọn ọkùnrin Israẹli fàsẹ́yìn níwájú àwọn ẹ̀yà Benjamini nítorí pé wọ́n fọkàn tán àwọn tí ó wà ní ibùba ní ẹ̀bá Gibeah.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.36",
            "verseOrgIds": [
              "JDG.20.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JDG 20:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ọkùnrin tí wọ́n lúgọ yára jáde wọ́n sì tètè wọ Gibeah, wọ́n fọ́nká wọ́n sì fi idà pa gbogbo àwọn tí ó wà nínú ìlú náà.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.37",
            "verseOrgIds": [
              "JDG.20.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JDG 20:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ọkùnrin Israẹli àti àwọn tí o ba ní ibùba sínú igbó ti fún ara wọn ní àmì pé, kí àwọn tí ó ba ní ibùba fi èéfín ṣe ìkùùkuu ńlá láti inú ìlú náà,",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.38",
            "verseOrgIds": [
              "JDG.20.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JDG 20:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "nígbà náà ni àwọn ọkùnrin Israẹli yípadà, wọ́n sá gun.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.39",
            "verseOrgIds": [
              "JDG.20.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JDG 20:39"
      },
      "items": [
        {
          "text": "Àwọn ọmọ Benjamini sì ti bẹ̀rẹ̀ sí ṣẹ́gun àti ní pípa àwọn ọkùnrin Israẹli tí ó to ọgbọ̀n, wọ́n sì wí pé, \"Àwa ń ṣẹ́gun wọn bí ìgbà ìjà àkọ́kọ́.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.39",
            "verseOrgIds": [
              "JDG.20.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JDG 20:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n nígbà tí ìkùùkuu èéfín bẹ̀rẹ̀ sí ní rú sókè láti inú ìlú náà wá, àwọn ẹ̀yà Benjamini yípadà wọ́n sì rí èéfín gbogbo ìlú náà ń gòkè sí ojú ọ̀run.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.40",
            "verseOrgIds": [
              "JDG.20.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JDG 20:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ọkùnrin Israẹli sì yípadà sí wọn, ẹ̀rù gidigidi sì ba àwọn ará Benjamini nítorí pé wọ́n mọ̀ pé àwọn wà nínú ewu.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.41",
            "verseOrgIds": [
              "JDG.20.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JDG 20:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n sì sá níwájú àwọn ọmọ Israẹli sí apá àṣálẹ́, ṣùgbọ́n wọn kò le sálà kúrò lọ́wọ́ ogun náà. Àwọn ọkùnrin Israẹli tí ó jáde láti inú àwọn ìlú wọn wá pa wọ́n run níbẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.42",
            "verseOrgIds": [
              "JDG.20.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "JDG 20:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n yí àwọn ẹ̀yà Benjamini ká, wọ́n lépa wọn, wọ́n sì pa wọ́n run pẹ̀lú ìrọ̀rùn ní ibi ìsinmi wọn ní agbègbè ìlà-oòrùn Gibeah.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.43",
            "verseOrgIds": [
              "JDG.20.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "JDG 20:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹgbàá mẹ́sàn (18,000) àwọn ẹ̀yà Benjamini ṣubú, gbogbo wọn jẹ́ akọni jagunjagun.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.44",
            "verseOrgIds": [
              "JDG.20.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "JDG 20:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí wọ́n ṣe síjú padà tí wọ́n sì ń sálọ sí apá ijù lọ sí ọ̀nà àpáta Rimoni ni àwọn ọmọ Israẹli pa ẹgbẹ̀rún márùn-ún (5,000) ọkùnrin ní àwọn òpópónà. Wọ́n lépa àwọn ẹ̀yà Benjamini títí dé Gidomu, wọ́n sì tún bi ẹgbẹ̀rún méjì (2,000) ọkùnrin ṣubú.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.45",
            "verseOrgIds": [
              "JDG.20.45"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "JDG 20:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọjọ́ náà ẹgbàá méjìlá ó lé ẹgbẹ̀rún (25,000) jagunjagun Benjamini tí ń fi idà jagun ní ó ṣubú, gbogbo wọn jẹ́ akọni ológun.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.46",
            "verseOrgIds": [
              "JDG.20.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "JDG 20:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n ẹgbẹ̀ta (600) ọkùnrin yípadà wọ́n sì sá nínú ààlà lọ sí àpáta Rimoni, níbi tí wọ́n wà fún oṣù mẹ́rin.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.47",
            "verseOrgIds": [
              "JDG.20.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "JDG 20:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ọkùnrin Israẹli sì padà sí àwọn ìlú Benjamini wọn sì fi idà pa gbogbo ohun tí ó wà nínú àwọn ìlú wọn àti àwọn ẹran àti gbogbo ohun tí wọn ba níbẹ̀. Gbogbo ìlú tí wọ́n bá ní ojú ọ̀nà ni wọ́n fi iná sun.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.48",
            "verseOrgIds": [
              "JDG.20.48"
            ]
          }
        }
      ]
    }
  ],
