                "verseOrgIds": [
                  "ZEC.14.20"
                ]
              }
            }
          ]
        },
        {
          "text": "\" yóò wà lára ṣaworo ẹṣin: àti àwọn ìkòkò ni ilé",
          "type": "text",
          "attrs": {
