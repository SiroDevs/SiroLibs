          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ZEC 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èyí ni yóò sì jẹ́ ìyà Ejibiti, àti ìyà gbogbo orílẹ̀-èdè tí kò gòkè wá láti pa àsè àgọ́ mọ́.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.19",
            "verseOrgIds": [
              "ZEC.14.19"
            ]
          }
        }
      ]
