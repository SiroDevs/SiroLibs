  "verseCount": 12,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "10",
        "style": "c",
        "sid": "ZEC 10"
      },
      "items": [
        {
          "text": "10",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text"
            }
          ]
        },
        {
          "text": "yóò gba Juda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ZEC 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ béèrè òjò nígbà àrọ̀kúrò ni ọwọ́",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.1",
            "verseOrgIds": [
              "ZEC.10.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.10.1",
                "verseOrgIds": [
                  "ZEC.10.1"
                ]
              }
            }
          ]
        },
        {
          "text": ";",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.1",
            "verseOrgIds": [
              "ZEC.10.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 10:1"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.10.1",
                "verseOrgIds": [
                  "ZEC.10.1"
                ]
              }
            }
          ]
        },
        {
          "text": "tí o dá mọ̀nàmọ́ná,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.1",
            "verseOrgIds": [
              "ZEC.10.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEC 10:1"
      },
      "items": [
        {
          "text": "tí ó sì fi ọ̀pọ̀ òjò fún ènìyàn,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.1",
            "verseOrgIds": [
              "ZEC.10.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 10:1"
      },
      "items": [
        {
          "text": "fún olúkúlùkù koríko ní pápá.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.1",
            "verseOrgIds": [
              "ZEC.10.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ZEC 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí àwọn òrìṣà tí sọ̀rọ̀ asán,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.2",
            "verseOrgIds": [
              "ZEC.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 10:2"
      },
      "items": [
        {
          "text": "àwọn aláfọ̀ṣẹ sì tí rí èké,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.2",
            "verseOrgIds": [
              "ZEC.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEC 10:2"
      },
      "items": [
        {
          "text": "wọn sì tí rọ àlá èké;",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.2",
            "verseOrgIds": [
              "ZEC.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 10:2"
      },
      "items": [
        {
          "text": "wọ́n ń tu ni nínú lásán,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.2",
            "verseOrgIds": [
              "ZEC.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEC 10:2"
      },
      "items": [
        {
          "text": "nítorí náà àwọn ènìyàn náà ṣáko lọ bí àgùntàn,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.2",
            "verseOrgIds": [
              "ZEC.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 10:2"
      },
      "items": [
        {
          "text": "a ṣẹ wọn níṣẹ̀ẹ́, nítorí Olùṣọ́-àgùntàn kò sí.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.2",
            "verseOrgIds": [
              "ZEC.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ZEC 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ìbínú mi ru sí àwọn darandaran,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.3",
            "verseOrgIds": [
              "ZEC.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 10:3"
      },
      "items": [
        {
          "text": "èmi o sì jẹ àwọn olórí ní yà",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.3",
            "verseOrgIds": [
              "ZEC.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEC 10:3"
      },
      "items": [
        {
          "text": "nítorí",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.3",
            "verseOrgIds": [
              "ZEC.10.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.10.3",
                "verseOrgIds": [
                  "ZEC.10.3"
                ]
              }
            }
          ]
        },
        {
          "text": "àwọn ọmọ-ogun ti bẹ agbo rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.3",
            "verseOrgIds": [
              "ZEC.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 10:3"
      },
      "items": [
        {
          "text": "ilé Juda wò,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.3",
            "verseOrgIds": [
              "ZEC.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 10:3"
      },
      "items": [
        {
          "text": "yóò sì fi wọn ṣe ẹṣin rẹ̀ dáradára ní ogun.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.3",
            "verseOrgIds": [
              "ZEC.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ZEC 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Láti ọ̀dọ̀ rẹ̀ ni òkúta igun ilé ti jáde wá,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.4",
            "verseOrgIds": [
              "ZEC.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 10:4"
      },
      "items": [
        {
          "text": "láti ọ̀dọ̀ rẹ ni èèkàn àgọ́ tí wá,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.4",
            "verseOrgIds": [
              "ZEC.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 10:4"
      },
      "items": [
        {
          "text": "láti ọ̀dọ̀ rẹ ni ọrún ogun tí wá,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.4",
            "verseOrgIds": [
              "ZEC.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 10:4"
      },
      "items": [
        {
          "text": "láti ọ̀dọ̀ rẹ ni àwọn akóniṣiṣẹ́ gbogbo tí wá.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.4",
            "verseOrgIds": [
              "ZEC.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ZEC 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo wọn yóò sì dàbí ọkùnrin",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.5",
            "verseOrgIds": [
              "ZEC.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 10:5"
      },
      "items": [
        {
          "text": "alágbára ni ogun tí ń tẹ àwọn ọ̀tá wọn mọ́lẹ̀ ní ìgboro, wọn ó sì jagun,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.5",
            "verseOrgIds": [
              "ZEC.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEC 10:5"
      },
      "items": [
        {
          "text": "nítorí",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.5",
            "verseOrgIds": [
              "ZEC.10.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.10.5",
                "verseOrgIds": [
                  "ZEC.10.5"
                ]
              }
            }
          ]
        },
        {
          "text": "wà pẹ̀lú wọn,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.5",
            "verseOrgIds": [
              "ZEC.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 10:5"
      },
      "items": [
        {
          "text": "wọn ó sì dààmú àwọn tí ń gun ẹṣin.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.5",
            "verseOrgIds": [
              "ZEC.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ZEC 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Èmi o sì mú ilé Juda ní agbára,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.6",
            "verseOrgIds": [
              "ZEC.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 10:6"
      },
      "items": [
        {
          "text": "èmi o sì gba ilé Josẹfu là,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.6",
            "verseOrgIds": [
              "ZEC.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEC 10:6"
      },
      "items": [
        {
          "text": "èmi ó sì tún mú wọn padà",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.6",
            "verseOrgIds": [
              "ZEC.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 10:6"
      },
      "items": [
        {
          "text": "nítorí mo tí ṣàánú fún wọn,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.6",
            "verseOrgIds": [
              "ZEC.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEC 10:6"
      },
      "items": [
        {
          "text": "ó sì dàbí ẹni pé èmi kò ì tì í ta wọ́n nù;",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.6",
            "verseOrgIds": [
              "ZEC.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 10:6"
      },
      "items": [
        {
          "text": "nítorí èmi ni",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.6",
            "verseOrgIds": [
              "ZEC.10.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.10.6",
                "verseOrgIds": [
                  "ZEC.10.6"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run wọn,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.6",
            "verseOrgIds": [
              "ZEC.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEC 10:6"
      },
      "items": [
        {
          "text": "èmi o sì gbọ́ tiwọn",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.6",
            "verseOrgIds": [
              "ZEC.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ZEC 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Efraimu yóò sì ṣe bí alágbára,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.7",
            "verseOrgIds": [
              "ZEC.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEC 10:7"
      },
      "items": [
        {
          "text": "ọkàn wọn yóò sì yọ̀ bi ẹni pé nípa ọtí wáìnì:",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.7",
            "verseOrgIds": [
              "ZEC.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEC 10:7"
      },
      "items": [
        {
          "text": "àní àwọn ọmọ wọn yóò rí í,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.7",
            "verseOrgIds": [
              "ZEC.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 10:7"
      },
      "items": [
        {
          "text": "wọn o sì yọ̀, inú wọn ó sì dùn nínú",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.7",
            "verseOrgIds": [
              "ZEC.10.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
