      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:37"
      },
      "items": [
        {
          "text": "ó pàtẹ́wọ́ ní àárín wa,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.37",
            "verseOrgIds": [
              "JOB.34.37"
            ]
          }
        }
