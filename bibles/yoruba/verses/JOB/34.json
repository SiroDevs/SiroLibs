            "sid": "JOB 34:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí pe ó fi ìṣọ̀tẹ̀ kún ẹ̀ṣẹ̀ rẹ̀;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.37",
            "verseOrgIds": [
              "JOB.34.37"
            ]
          }
        }
      ]
    },
