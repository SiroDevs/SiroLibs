  "verseCount": 37,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "34",
        "style": "c",
        "sid": "JOB 34"
      },
      "items": [
        {
          "text": "34",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Elihu pe Jobu níjà",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 34:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni Elihu dáhùn, ó sì wí pé,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.1",
            "verseOrgIds": [
              "JOB.34.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 34:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ẹ̀yin ọlọ́gbọ́n ẹ gbọ́ ọ̀rọ̀ mi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.2",
            "verseOrgIds": [
              "JOB.34.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:2"
      },
      "items": [
        {
          "text": "kí ẹ sì fi etí sílẹ̀ sí mi ẹ̀yin tí ẹ ní ìmòye.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.2",
            "verseOrgIds": [
              "JOB.34.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 34:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí pé etí a máa dán ọ̀rọ̀ wò,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.3",
            "verseOrgIds": [
              "JOB.34.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:3"
      },
      "items": [
        {
          "text": "bí adùn ẹnu ti ń tọ́ oúnjẹ wò.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.3",
            "verseOrgIds": [
              "JOB.34.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 34:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ jẹ́ kí a mọ òye ohun tí o tọ́ fún ara wa;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.4",
            "verseOrgIds": [
              "JOB.34.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:4"
      },
      "items": [
        {
          "text": "ẹ jẹ́ kí a mọ ohun tí ó dára láàrín wa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.4",
            "verseOrgIds": [
              "JOB.34.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 34:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nítorí pé Jobu wí pé, 'Aláìlẹ́ṣẹ̀ ni èmi;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.5",
            "verseOrgIds": [
              "JOB.34.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:5"
      },
      "items": [
        {
          "text": "Ọlọ́run sì ti gba ìdájọ́ mi lọ.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.5",
            "verseOrgIds": [
              "JOB.34.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 34:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi ha purọ́ sí ẹ̀tọ́ mi bí,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.6",
            "verseOrgIds": [
              "JOB.34.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:6"
      },
      "items": [
        {
          "text": "bí mo tilẹ̀ jẹ́ aláìjẹ̀bi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.6",
            "verseOrgIds": [
              "JOB.34.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:6"
      },
      "items": [
        {
          "text": "ọfà rẹ̀ kò ní àwòtán ọgbẹ́.'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.6",
            "verseOrgIds": [
              "JOB.34.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 34:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọkùnrin wo ni ó dàbí Jobu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.7",
            "verseOrgIds": [
              "JOB.34.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:7"
      },
      "items": [
        {
          "text": "tí ń mu ẹ̀gàn bí ẹní mú omi?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.7",
            "verseOrgIds": [
              "JOB.34.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 34:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tí ń bá àwọn oníṣẹ́ ẹ̀ṣẹ̀ kẹ́gbẹ́ tí ó",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.8",
            "verseOrgIds": [
              "JOB.34.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:8"
      },
      "items": [
        {
          "text": "sì ń bá àwọn ènìyàn búburú rìn.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.8",
            "verseOrgIds": [
              "JOB.34.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 34:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí ó sá ti wí pé, 'Èrè kan kò sí fún ènìyàn,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.9",
            "verseOrgIds": [
              "JOB.34.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:9"
      },
      "items": [
        {
          "text": "tí yóò fi máa ṣe inú dídùn sí Ọlọ́run.'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.9",
            "verseOrgIds": [
              "JOB.34.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 34:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ǹjẹ́ nítorí náà, ẹ fetísílẹ̀ sí mi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.10",
            "verseOrgIds": [
              "JOB.34.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:10"
      },
      "items": [
        {
          "text": "ẹ fi etí sí mi ẹ̀yin ènìyàn amòye:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.10",
            "verseOrgIds": [
              "JOB.34.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOB 34:10"
      },
      "items": [
        {
          "text": "Ó di èèwọ̀ fún Ọlọ́run ti ìbá fi hùwà búburú,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.10",
            "verseOrgIds": [
              "JOB.34.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:10"
      },
      "items": [
        {
          "text": "àti fún Olódùmarè, tí yóò fi ṣe àìṣedéédéé!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.10",
            "verseOrgIds": [
              "JOB.34.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 34:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí pé ó ń sán fún ènìyàn fún gẹ́gẹ́ bi ohun tí a bá ṣe,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.11",
            "verseOrgIds": [
              "JOB.34.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:11"
      },
      "items": [
        {
          "text": "yóò sì mú olúkúlùkù kí ó rí gẹ́gẹ́ bí ipa ọ̀nà rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.11",
            "verseOrgIds": [
              "JOB.34.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 34:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítòótọ́ Ọlọ́run kì yóò hùwàkiwà;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.12",
            "verseOrgIds": [
              "JOB.34.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:12"
      },
      "items": [
        {
          "text": "bẹ́ẹ̀ ni Olódùmarè kì yóò yí ìdájọ́ po.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.12",
            "verseOrgIds": [
              "JOB.34.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 34:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ta ni ó fi ìtọ́jú ayé lé e lọ́wọ́,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.13",
            "verseOrgIds": [
              "JOB.34.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:13"
      },
      "items": [
        {
          "text": "tàbí ta ni ó fi gbogbo ayé lé e lọ́wọ́?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.13",
            "verseOrgIds": [
              "JOB.34.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 34:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ó bá gbé ayé rẹ̀ lé kìkì ara rẹ̀",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.14",
            "verseOrgIds": [
              "JOB.34.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:14"
      },
      "items": [
        {
          "text": "tí ó sì gba ọkàn rẹ̀ àti ẹ̀mí rẹ̀ sọ́dọ̀ ara rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.14",
            "verseOrgIds": [
              "JOB.34.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 34:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "gbogbo ènìyàn ni yóò parun pọ̀,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.15",
            "verseOrgIds": [
              "JOB.34.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:15"
      },
      "items": [
        {
          "text": "ènìyàn a sì tún padà di erùpẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.15",
            "verseOrgIds": [
              "JOB.34.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 34:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ǹjẹ́ nísinsin yìí, bí ìwọ bá ní òye,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.16",
            "verseOrgIds": [
              "JOB.34.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:16"
      },
      "items": [
        {
          "text": "gbọ́ èyí; fetísí ohùn ẹnu mi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.16",
            "verseOrgIds": [
              "JOB.34.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 34:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹni tí ó kórìíra òtítọ́ ha le ṣe olórí bí?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.17",
            "verseOrgIds": [
              "JOB.34.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:17"
      },
      "items": [
        {
          "text": "Ìwọ ó ha sì dá olóòótọ́ àti ẹni ńlá lẹ́bi?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.17",
            "verseOrgIds": [
              "JOB.34.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 34:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "O ha tọ́ láti wí fún ọba pé, 'Ènìyàn búburú ní ìwọ,'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.18",
            "verseOrgIds": [
              "JOB.34.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:18"
      },
      "items": [
        {
          "text": "tàbí fún àwọn ọmọ-aládé pé, 'Ìkà ni ẹ̀yin,'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.18",
            "verseOrgIds": [
              "JOB.34.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOB 34:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "mélòó mélòó fún ẹni tí kì í ṣe ojúsàájú àwọn ọmọ-aládé",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.19",
            "verseOrgIds": [
              "JOB.34.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:19"
      },
      "items": [
        {
          "text": "tàbí tí kò kà ọlọ́rọ̀ sí ju tálákà lọ,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.19",
            "verseOrgIds": [
              "JOB.34.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:19"
      },
      "items": [
        {
          "text": "nítorí pé iṣẹ́ ọwọ́ rẹ̀ ni gbogbo wọn í ṣe?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.19",
            "verseOrgIds": [
              "JOB.34.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOB 34:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ìṣẹ́jú kan ni wọn ó kú,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.20",
            "verseOrgIds": [
              "JOB.34.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:20"
      },
      "items": [
        {
          "text": "àwọn ènìyàn á sì di yíyọ́ lẹ́nu láàrín ọ̀gànjọ́, wọn a sì kọjá lọ;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.20",
            "verseOrgIds": [
              "JOB.34.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:20"
      },
      "items": [
        {
          "text": "a sì mú àwọn alágbára kúrò láìsí ọwọ́ ènìyàn níbẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.20",
            "verseOrgIds": [
              "JOB.34.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOB 34:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nítorí pé ojú rẹ̀ ń bẹ ní ipa ọ̀nà ènìyàn,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.21",
            "verseOrgIds": [
              "JOB.34.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:21"
      },
      "items": [
        {
          "text": "òun sì rí ìrìn rẹ̀ gbogbo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.21",
            "verseOrgIds": [
              "JOB.34.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOB 34:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kò sí ibi òkùnkùn, tàbí òjìji ikú,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.22",
            "verseOrgIds": [
              "JOB.34.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:22"
      },
      "items": [
        {
          "text": "níbi tí àwọn oníṣẹ́ ẹ̀ṣẹ̀ yóò gbé sá pamọ́ sí.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.22",
            "verseOrgIds": [
              "JOB.34.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOB 34:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí pé òun kò pẹ́ àti kíyèsi ẹnìkan,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.23",
            "verseOrgIds": [
              "JOB.34.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:23"
      },
      "items": [
        {
          "text": "kí òun kí ó sì mú lọ sínú ìdájọ́ níwájú Ọlọ́run.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.23",
            "verseOrgIds": [
              "JOB.34.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOB 34:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Òun ó sì fọ́ àwọn alágbára túútúú láìní ìwádìí,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.24",
            "verseOrgIds": [
              "JOB.34.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:24"
      },
      "items": [
        {
          "text": "a sì fi ẹlòmíràn dípò wọn,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.24",
            "verseOrgIds": [
              "JOB.34.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOB 34:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "nítorí pé ó mọ iṣẹ́ wọn,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.25",
            "verseOrgIds": [
              "JOB.34.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:25"
      },
      "items": [
        {
          "text": "ó sì yí wọn po ní òru, bẹ́ẹ̀ ni wọ́n di ìtẹ̀mọ́lẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.25",
            "verseOrgIds": [
              "JOB.34.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOB 34:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó kọlù wọ́n nítorí ìwà búburú wọn",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.26",
            "verseOrgIds": [
              "JOB.34.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:26"
      },
      "items": [
        {
          "text": "níbi tí àwọn ẹlòmíràn ti lè rí i,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.26",
            "verseOrgIds": [
              "JOB.34.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JOB 34:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "nítorí pé wọ́n padà pẹ̀yìndà sí i,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.27",
            "verseOrgIds": [
              "JOB.34.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:27"
      },
      "items": [
        {
          "text": "wọn kò sì fiyèsí ipa ọ̀nà rẹ̀ gbogbo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.27",
            "verseOrgIds": [
              "JOB.34.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JOB 34:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "kí wọn kí ó sì mú igbe ẹkún àwọn tálákà lọ dé ọ̀dọ̀ rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.28",
            "verseOrgIds": [
              "JOB.34.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:28"
      },
      "items": [
        {
          "text": "òun sì gbọ́ igbe ẹkún aláìní.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.28",
            "verseOrgIds": [
              "JOB.34.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JOB 34:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n nígbà tí ó bá dákẹ́ síbẹ̀, ta ni yóò dá lẹ́bi?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.29",
            "verseOrgIds": [
              "JOB.34.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:29"
      },
      "items": [
        {
          "text": "Nígbà tí ó bá pa ojú rẹ̀ mọ́, ta ni yóò lè rí i?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.29",
            "verseOrgIds": [
              "JOB.34.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOB 34:29"
      },
      "items": [
        {
          "text": "Bẹ́ẹ̀ ni ó ṣe si orílẹ̀-èdè tàbí sí ènìyàn kan ṣoṣo;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.29",
            "verseOrgIds": [
              "JOB.34.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JOB 34:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "kí aláìwà bi Ọlọ́run kí ó má bá à jẹ ọba",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.30",
            "verseOrgIds": [
              "JOB.34.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:30"
      },
      "items": [
        {
          "text": "kí wọn kí ó má di ìdẹwò fún ènìyàn.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.30",
            "verseOrgIds": [
              "JOB.34.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JOB 34:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nítorí pé ẹnìkan ha lè wí fún Ọlọ́run pé,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.31",
            "verseOrgIds": [
              "JOB.34.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:31"
      },
      "items": [
        {
          "text": "èmi jẹ̀bi, èmi kò sì ní ṣẹ̀ mọ́?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.31",
            "verseOrgIds": [
              "JOB.34.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JOB 34:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èyí tí èmi kò rí ìwọ fi kọ́ mi",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.32",
            "verseOrgIds": [
              "JOB.34.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:32"
      },
      "items": [
        {
          "text": "bi mo bá sì dẹ́ṣẹ̀ èmi kì yóò ṣe bẹ́ẹ̀ mọ́.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.32",
            "verseOrgIds": [
              "JOB.34.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JOB 34:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ǹjẹ́ bí ti inú rẹ̀ ni ki òun ó san ẹ̀ṣẹ̀ padà?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.33",
            "verseOrgIds": [
              "JOB.34.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:33"
      },
      "items": [
        {
          "text": "Ǹjẹ́ òun yóò san án padà bí ìwọ bá kọ̀ ọ́ láti jẹ́wọ́,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.33",
            "verseOrgIds": [
              "JOB.34.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOB 34:33"
      },
      "items": [
        {
          "text": "ìwọ gbọdọ̀ yan, kì í ṣe èmi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.33",
            "verseOrgIds": [
              "JOB.34.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:33"
      },
      "items": [
        {
          "text": "Nítorí náà sọ ohun tí o mọ̀,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.33",
            "verseOrgIds": [
              "JOB.34.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:33"
      },
      "items": [
        {
          "text": "pẹ̀lúpẹ̀lú ohun tí ìwọ mọ̀, sọ ọ́!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.33",
            "verseOrgIds": [
              "JOB.34.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
