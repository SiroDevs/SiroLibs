          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìfẹ́ mi ni kí a dán Jobu wò dé òpin,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.36",
            "verseOrgIds": [
              "JOB.34.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:36"
      },
      "items": [
        {
          "text": "nítorí ìdáhùn rẹ̀ dàbí i ti ènìyàn búburú.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.36",
            "verseOrgIds": [
              "JOB.34.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
