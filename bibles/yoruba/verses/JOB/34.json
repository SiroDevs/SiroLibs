          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JOB 34:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "'Jobu ti fi àìmọ̀ sọ̀rọ̀,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.35",
            "verseOrgIds": [
              "JOB.34.35"
            ]
          }
        }
      ]
    },
