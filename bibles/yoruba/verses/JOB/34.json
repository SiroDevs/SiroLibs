      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:35"
      },
      "items": [
        {
          "text": "ọ̀rọ̀ rẹ̀ sì ṣe aláìgbọ́n.'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.35",
            "verseOrgIds": [
              "JOB.34.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
