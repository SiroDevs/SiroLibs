          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Àwọn ènìyàn amòye yóò wí fún mi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.34",
            "verseOrgIds": [
              "JOB.34.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:34"
      },
      "items": [
        {
          "text": "àti pẹ̀lúpẹ̀lú ẹnikẹ́ni tí í ṣe ọlọ́gbọ́n tí ó sì gbọ́ mi pé,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.34",
            "verseOrgIds": [
              "JOB.34.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
