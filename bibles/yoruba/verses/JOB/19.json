  "verseCount": 29,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "19",
        "style": "c",
        "sid": "JOB 19"
      },
      "items": [
        {
          "text": "19",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìdáhùn Jobu fún Bilidadi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 19:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìgbà náà ni Jobu dáhùn, ó sì wí pé:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.1",
            "verseOrgIds": [
              "JOB.19.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Yóò ti pẹ́ tó tí ẹ̀yin ó fi máa fi ìyà jẹ mí,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.2",
            "verseOrgIds": [
              "JOB.19.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:2"
      },
      "items": [
        {
          "text": "tí ẹ̀yin ó fi máa fi ọ̀rọ̀ yìí?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.2",
            "verseOrgIds": [
              "JOB.19.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìgbà mẹ́wàá ní yin yọ mi lénu ẹ̀yin ti ń gàn mí;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.3",
            "verseOrgIds": [
              "JOB.19.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:3"
      },
      "items": [
        {
          "text": "ojú kò tì yín tí ẹ fi jẹ mí ní yà.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.3",
            "verseOrgIds": [
              "JOB.19.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kí a sì wí bẹ́ẹ̀ pé, mo ṣìnà nítòótọ́,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.4",
            "verseOrgIds": [
              "JOB.19.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:4"
      },
      "items": [
        {
          "text": "ìṣìnà mi wà lára èmi tìkára mi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.4",
            "verseOrgIds": [
              "JOB.19.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ó tilẹ̀ ṣe pé ẹ̀yin ó ṣògo si mi lórí nítòótọ́,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.5",
            "verseOrgIds": [
              "JOB.19.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:5"
      },
      "items": [
        {
          "text": "tí ẹ ó sì máa fi ẹ̀gàn mi gún mí lójú,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.5",
            "verseOrgIds": [
              "JOB.19.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "kí ẹ mọ̀ nísinsin yìí pé, Ọlọ́run ni ó bì mí ṣubú,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.6",
            "verseOrgIds": [
              "JOB.19.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:6"
      },
      "items": [
        {
          "text": "ó sì nà àwọ̀n rẹ̀ yí mi ká.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.6",
            "verseOrgIds": [
              "JOB.19.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kíyèsi, èmi ń kígbe pe, 'Ọwọ́ alágbára!' Ṣùgbọ́n a kò gbọ́ ti èmi;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.7",
            "verseOrgIds": [
              "JOB.19.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:7"
      },
      "items": [
        {
          "text": "mo kígbe fún ìrànlọ́wọ́, bẹ́ẹ̀ ni kò sí ìdájọ́.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.7",
            "verseOrgIds": [
              "JOB.19.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó ṣọgbà dí ọ̀nà mi tí èmi kò le è kọjá,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.8",
            "verseOrgIds": [
              "JOB.19.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:8"
      },
      "items": [
        {
          "text": "Ó sì mú òkùnkùn ṣú sí ipa ọ̀nà mi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.8",
            "verseOrgIds": [
              "JOB.19.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó ti bọ́ ògo mi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.9",
            "verseOrgIds": [
              "JOB.19.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:9"
      },
      "items": [
        {
          "text": "ó sì ṣí adé kúrò ní orí mi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.9",
            "verseOrgIds": [
              "JOB.19.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó ti bà mí jẹ́ ní ìhà gbogbo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.10",
            "verseOrgIds": [
              "JOB.19.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:10"
      },
      "items": [
        {
          "text": "ẹ̀mí sì pin; ìrètí mi ni a ó sì fàtu bí igi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.10",
            "verseOrgIds": [
              "JOB.19.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì tiná bọ ìbínú rẹ̀ sí mi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.11",
            "verseOrgIds": [
              "JOB.19.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:11"
      },
      "items": [
        {
          "text": "ó sì kà mí sí bí ọ̀kan nínú àwọn ọ̀tá rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.11",
            "verseOrgIds": [
              "JOB.19.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹgbẹ́ ogun rẹ̀ sì dàpọ̀ sí mi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.12",
            "verseOrgIds": [
              "JOB.19.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:12"
      },
      "items": [
        {
          "text": "wọ́n sì mọ odi yí mi ká,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.12",
            "verseOrgIds": [
              "JOB.19.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:12"
      },
      "items": [
        {
          "text": "wọ́n sì yí àgọ́ mi ká.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.12",
            "verseOrgIds": [
              "JOB.19.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ó mú àwọn arákùnrin mi jìnà sí mi réré,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.13",
            "verseOrgIds": [
              "JOB.19.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:13"
      },
      "items": [
        {
          "text": "àti àwọn ojúlùmọ̀ mi di àjèjì sí mi pátápátá.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.13",
            "verseOrgIds": [
              "JOB.19.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn alájọbí mi fàsẹ́yìn,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.14",
            "verseOrgIds": [
              "JOB.19.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:14"
      },
      "items": [
        {
          "text": "àwọn ọ̀rẹ́ tímọ́tímọ́ mi sì di onígbàgbé mi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.14",
            "verseOrgIds": [
              "JOB.19.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ará inú ilé mi àti àwọn ìránṣẹ́bìnrin mi kà mí sí àjèjì;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.15",
            "verseOrgIds": [
              "JOB.19.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:15"
      },
      "items": [
        {
          "text": "èmi jásí àjèjì ènìyàn ní ojú wọn.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.15",
            "verseOrgIds": [
              "JOB.19.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mo pe ìránṣẹ́ mi, òun kò sì dá mi lóhùn;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.16",
            "verseOrgIds": [
              "JOB.19.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:16"
      },
      "items": [
        {
          "text": "mo fi ẹnu mi bẹ̀ ẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.16",
            "verseOrgIds": [
              "JOB.19.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ̀mí mi ṣú àyà mi, àti òórùn mi",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.17",
            "verseOrgIds": [
              "JOB.19.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:17"
      },
      "items": [
        {
          "text": "ṣú àwọn ọmọ inú ìyá mi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.17",
            "verseOrgIds": [
              "JOB.19.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àní àwọn ọmọdékùnrin fi mí ṣẹ̀sín,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.18",
            "verseOrgIds": [
              "JOB.19.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:18"
      },
      "items": [
        {
          "text": "mo dìde, wọ́n sì sọ̀rọ̀ ẹ̀gàn sí mi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.18",
            "verseOrgIds": [
              "JOB.19.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOB 19:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo àwọn ọ̀rẹ́ kòríkòsùn mi kórìíra mi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.19",
            "verseOrgIds": [
              "JOB.19.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:19"
      },
      "items": [
        {
          "text": "àwọn olùfẹ́ mi sì kẹ̀yìndà mí.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.19",
            "verseOrgIds": [
              "JOB.19.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOB 19:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Egungun mi lẹ̀ mọ́ ara mi àti mọ́ ẹran-ara mi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.20",
            "verseOrgIds": [
              "JOB.19.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:20"
      },
      "items": [
        {
          "text": "mo sì yọ́ pẹ̀lú awọ eyín mi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.20",
            "verseOrgIds": [
              "JOB.19.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOB 19:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ẹ ṣàánú fún mi, ẹ ṣàánú fún mi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.21",
            "verseOrgIds": [
              "JOB.19.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:21"
      },
      "items": [
        {
          "text": "ẹ̀yin ọ̀rẹ́ mi, nítorí ọwọ́ Ọlọ́run ti bà mí.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.21",
            "verseOrgIds": [
              "JOB.19.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOB 19:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí kí ni ẹ̀yin ṣe lépa mi bí",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.22",
            "verseOrgIds": [
              "JOB.19.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:22"
      },
      "items": [
        {
          "text": "Ọlọ́run, tí ẹran-ara mi kò tẹ́ yín lọ́rùn?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.22",
            "verseOrgIds": [
              "JOB.19.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOB 19:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Háà! Ìbá ṣe pé a le kọ̀wé ọ̀rọ̀ mi nísinsin yìí,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.23",
            "verseOrgIds": [
              "JOB.19.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:23"
      },
      "items": [
        {
          "text": "ìbá ṣe pé a le kọ ọ sínú ìwé!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.23",
            "verseOrgIds": [
              "JOB.19.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOB 19:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kí a fi kálámù irin àti ti òjé kọ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.24",
            "verseOrgIds": [
              "JOB.19.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:24"
      },
      "items": [
        {
          "text": "wọ́n sínú àpáta fún láéláé.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.24",
            "verseOrgIds": [
              "JOB.19.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOB 19:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí èmi mọ̀ pé olùdáǹdè mi ń bẹ láààyè",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.25",
            "verseOrgIds": [
              "JOB.19.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:25"
      },
      "items": [
        {
          "text": "àti pe òun ni yóò dìde dúró lórí ilẹ̀ ní ìkẹyìn;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.25",
            "verseOrgIds": [
              "JOB.19.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOB 19:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "àti lẹ́yìn ìgbà tí a pa àwọ̀ ara mi run,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.26",
            "verseOrgIds": [
              "JOB.19.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:26"
      },
      "items": [
        {
          "text": "síbẹ̀ láìsí ẹran-ara mi ni èmi ó rí Ọlọ́run,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.26",
            "verseOrgIds": [
              "JOB.19.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JOB 19:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "ẹni tí èmi ó rí fún ara mi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.27",
            "verseOrgIds": [
              "JOB.19.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:27"
      },
      "items": [
        {
          "text": "tí ojú mi ó sì wo, kì sì í ṣe ti ẹlòmíràn;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.27",
            "verseOrgIds": [
              "JOB.19.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:27"
      },
      "items": [
        {
          "text": "ọkàn mi sì dákú ní inú mi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.27",
            "verseOrgIds": [
              "JOB.19.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JOB 19:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Bí ẹ̀yin bá wí pé, 'Àwa ó ti lépa rẹ̀ tó!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.28",
            "verseOrgIds": [
              "JOB.19.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:28"
      },
      "items": [
        {
          "text": "Àti pé, gbogbo ọ̀rọ̀ náà ni a sá à rí ní ọwọ́ rẹ̀,'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.28",
            "verseOrgIds": [
              "JOB.19.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JOB 19:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "kí ẹ̀yin kí ó bẹ̀rù,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.29",
            "verseOrgIds": [
              "JOB.19.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:29"
      },
      "items": [
        {
          "text": "nítorí ìbínú ní í mú ìjìyà wá nípa idà,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.29",
            "verseOrgIds": [
              "JOB.19.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:29"
      },
      "items": [
        {
          "text": "kí ẹ̀yin kí ó lè mọ̀ pé ìdájọ́ kan ń bẹ.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.29",
            "verseOrgIds": [
              "JOB.19.29"
            ]
          }
        }
      ]
    }
