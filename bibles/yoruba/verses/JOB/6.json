          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi ó ha wí pé, 'Ẹ mú ohun fún mi wá,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.22",
            "verseOrgIds": [
              "JOB.6.22"
