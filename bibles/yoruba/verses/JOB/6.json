          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àìṣedéédéé ha wà ní ahọ́n mi?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.30",
            "verseOrgIds": [
              "JOB.6.30"
            ]
          }
        }
      ]
    },
