      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 6:26"
      },
      "items": [
        {
          "text": "àti ohùn ẹnu tí ó dàbí afẹ́fẹ́ ṣe àárẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.26",
            "verseOrgIds": [
