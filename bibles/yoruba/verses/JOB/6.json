      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 6:18"
      },
      "items": [
        {
          "text": "wọ́n gòkè sí ibi asán, wọ́n sì run.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.18",
            "verseOrgIds": [
              "JOB.6.18"
            ]
          }
        }
