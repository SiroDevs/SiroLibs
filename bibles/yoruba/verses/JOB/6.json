      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 6:27"
      },
      "items": [
        {
          "text": "ẹ̀yin sì da iye lé ọ̀rẹ́ yín.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.27",
            "verseOrgIds": [
              "JOB.6.27"
            ]
          }
        }
      ]
    },
