      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 6:19"
      },
      "items": [
        {
          "text": "àwọn oníṣòwò Ṣeba ń dúró dè wọ́n ní ìrètí.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.19",
            "verseOrgIds": [
              "JOB.6.19"
            ]
          }
        }
