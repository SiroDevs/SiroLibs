        "style": "q2",
        "vid": "JOB 6:17"
      },
      "items": [
        {
          "text": "nígbà tí oòrùn bá mú, wọn a sì gbẹ kúrò ni ipò wọn.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.17",
            "verseOrgIds": [
