          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n káàárẹ̀, nítorí tí wọ́n gbẹ́kẹ̀ wọn lé e;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.20",
            "verseOrgIds": [
              "JOB.6.20"
            ]
          }
        }
      ]
    },
