      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 6:23"
      },
      "items": [
        {
          "text": "tàbí, ẹ rà mí padà kúrò lọ́wọ́ alágbára nì'?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.23",
            "verseOrgIds": [
              "JOB.6.23"
            ]
          }
        }
      ]
    },
