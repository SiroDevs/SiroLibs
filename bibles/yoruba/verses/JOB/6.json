          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nítorí náà, kí èyí kí ó tó fún yín.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.28",
            "verseOrgIds": [
              "JOB.6.28"
            ]
          }
        }
      ]
    },
