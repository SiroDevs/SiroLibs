      "attrs": {
        "style": "q2",
        "vid": "JOB 6:22"
      },
      "items": [
        {
          "text": "tàbí pé ẹ fún mi ní ẹ̀bùn nínú ohun ìní yín?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.22",
            "verseOrgIds": [
              "JOB.6.22"
            ]
          }
        }
      ]
    },
    {
