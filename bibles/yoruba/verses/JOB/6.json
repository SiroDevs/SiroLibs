          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àní ẹ̀yin ṣe gẹ́gẹ́ bí aláìní baba,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.27",
            "verseOrgIds": [
              "JOB.6.27"
            ]
          }
        }
      ]
