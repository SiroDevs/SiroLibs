      "attrs": {
        "style": "q2",
        "vid": "JOB 6:25"
      },
      "items": [
        {
          "text": "ṣùgbọ́n kí ni àròyé ìbáwí yín jásí?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.25",
            "verseOrgIds": [
              "JOB.6.25"
            ]
          }
        }
