          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn oníṣòwò yà kúrò ní ọ̀nà wọn,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.18",
            "verseOrgIds": [
