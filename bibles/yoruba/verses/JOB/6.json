      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 6:20"
      },
      "items": [
        {
          "text": "wọ́n dé bẹ̀, wọ́n sì dààmú.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.20",
            "verseOrgIds": [
              "JOB.6.20"
            ]
          }
        }
      ]
    },
