          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹgbẹ́ oníṣòwò Tema ń wá omi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.19",
            "verseOrgIds": [
              "JOB.6.19"
            ]
          }
        }
