      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 6:24"
      },
      "items": [
        {
          "text": "kí ẹ sì mú mi wòye níbi tí mo gbé ti ṣìnà.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.24",
            "verseOrgIds": [
              "JOB.6.24"
            ]
          }
        }
