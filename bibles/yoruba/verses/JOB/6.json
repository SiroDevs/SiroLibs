      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 6:30"
      },
      "items": [
        {
          "text": "Ǹjẹ́ ìtọ́wò ẹnu mi kò kúkú le mọ ohun ti ó burú jù?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.30",
            "verseOrgIds": [
              "JOB.6.30"
            ]
          }
