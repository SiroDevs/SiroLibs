      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 6:28"
      },
      "items": [
        {
          "text": "ní ojú yín ni èmi kì yóò ṣèké.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.28",
            "verseOrgIds": [
              "JOB.6.28"
            ]
          }
        }
      ]
    },
    {
