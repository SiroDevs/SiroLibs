      "attrs": {
        "style": "q2",
        "vid": "JOB 6:21"
      },
      "items": [
        {
          "text": "ẹ̀yin rí ìrẹ̀sílẹ̀ mi àyà sì fò mí.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.21",
            "verseOrgIds": [
              "JOB.6.21"
            ]
