  "verseCount": 30,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "22",
        "style": "c",
        "sid": "JOB 22"
      },
      "items": [
        {
          "text": "22",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Èsì Elifasi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 22:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìgbà náà ni Elifasi, ará Temani, dáhùn wí pé,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.1",
            "verseOrgIds": [
              "JOB.22.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ènìyàn lè è ṣe rere fún Ọlọ́run?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.2",
            "verseOrgIds": [
              "JOB.22.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 22:2"
      },
      "items": [
        {
          "text": "Bí ọlọ́gbọ́n ti í ṣe rere fún ara rẹ̀?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.2",
            "verseOrgIds": [
              "JOB.22.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ohun ayọ̀ ha ni fún Olódùmarè pé olódodo ni ìwọ?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.3",
            "verseOrgIds": [
              "JOB.22.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 22:3"
      },
      "items": [
        {
          "text": "Tàbí èrè kí ni fún un ti ìwọ mú ọ̀nà rẹ̀ pé?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.3",
            "verseOrgIds": [
              "JOB.22.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Yóò ha bá ọ wí bí, nítorí ìbẹ̀rù",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.4",
            "verseOrgIds": [
              "JOB.22.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 22:4"
      },
      "items": [
        {
          "text": "Ọlọ́run rẹ? Yóò ha bá ọ lọ sínú ìdájọ́ bí?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.4",
            "verseOrgIds": [
              "JOB.22.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwà búburú rẹ kò ha tóbi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.5",
            "verseOrgIds": [
              "JOB.22.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 22:5"
      },
      "items": [
        {
          "text": "àti ẹ̀ṣẹ̀ rẹ láìníye?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.5",
            "verseOrgIds": [
              "JOB.22.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítòótọ́ ìwọ béèrè fún ààbò ni ọwọ́ arákùnrin rẹ láìnídìí,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.6",
            "verseOrgIds": [
              "JOB.22.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 22:6"
      },
      "items": [
        {
          "text": "ìwọ sì tú oníhòhò ní aṣọ wọn.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.6",
            "verseOrgIds": [
              "JOB.22.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ kò fi omi fún aláàárẹ̀ mu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.7",
            "verseOrgIds": [
              "JOB.22.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 22:7"
      },
      "items": [
        {
          "text": "ìwọ sì háwọ́ oúnjẹ fún ẹni tí ebi ń pa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.7",
            "verseOrgIds": [
              "JOB.22.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ó ṣe ti alágbára nì, òun ni ó ní ilẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.8",
            "verseOrgIds": [
              "JOB.22.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 22:8"
      },
      "items": [
        {
          "text": "ọlọ́lá sì tẹ̀dó sínú rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.8",
            "verseOrgIds": [
              "JOB.22.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ ti rán àwọn opó padà lọ ní ọwọ́ òfo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.9",
            "verseOrgIds": [
              "JOB.22.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 22:9"
      },
      "items": [
        {
          "text": "apá àwọn ọmọ aláìní baba ti di ṣiṣẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.9",
            "verseOrgIds": [
              "JOB.22.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà ni ìdẹ̀kùn ṣe yí ọ káàkiri,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.10",
            "verseOrgIds": [
              "JOB.22.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 22:10"
      },
      "items": [
        {
          "text": "àti ìbẹ̀rù òjijì ń yọ ọ́ lẹ́nu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.10",
            "verseOrgIds": [
              "JOB.22.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èéṣe tí òkùnkùn fi pọ̀ tó bẹ́ẹ̀ tí ìwọ kò fi lè ríran.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.11",
            "verseOrgIds": [
              "JOB.22.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 22:11"
      },
      "items": [
        {
          "text": "Èéṣe tí ọ̀pọ̀lọpọ̀ omi sì bò ọ́ mọ́lẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.11",
            "verseOrgIds": [
              "JOB.22.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ọlọ́run kò ha jẹ́ ẹni gíga ọ̀run?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.12",
            "verseOrgIds": [
              "JOB.22.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 22:12"
      },
      "items": [
        {
          "text": "Sá wo orí àwọn ìràwọ̀ bí wọ́n ti ga tó!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.12",
            "verseOrgIds": [
              "JOB.22.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ sì wí pé, Ọlọ́run ti ṣe mọ̀?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.13",
            "verseOrgIds": [
              "JOB.22.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 22:13"
      },
      "items": [
        {
          "text": "Òun ha lè ṣe ìdájọ́ láti inú òkùnkùn wá bí?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.13",
            "verseOrgIds": [
              "JOB.22.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ǹjẹ́ àwọsánmọ̀ tí ó nípọn jẹ ìbora fún un,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.14",
            "verseOrgIds": [
              "JOB.22.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 22:14"
      },
      "items": [
        {
          "text": "tí kò fi lè ríran; ó sì ń rìn nínú àyíká ọ̀run.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.14",
            "verseOrgIds": [
              "JOB.22.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ǹjẹ́ ìwọ fẹ́ rin ipa ọ̀nà ìgbàanì tí àwọn",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.15",
            "verseOrgIds": [
              "JOB.22.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 22:15"
      },
      "items": [
        {
          "text": "ènìyàn búburú tí rìn?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.15",
            "verseOrgIds": [
              "JOB.22.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "A ké wọn lulẹ̀ kúrò nínú ayé láìpé ọjọ́ wọn,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.16",
            "verseOrgIds": [
              "JOB.22.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 22:16"
      },
      "items": [
        {
          "text": "ìpìlẹ̀ wọn ti da bí odò ṣíṣàn.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.16",
            "verseOrgIds": [
              "JOB.22.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 22:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ẹni tí ó wí fún Ọlọ́run pé, 'Lọ kúrò lọ́dọ̀ wa!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.17",
            "verseOrgIds": [
              "JOB.22.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 22:17"
      },
      "items": [
        {
          "text": "Kí ni Olódùmarè yóò ṣe fún wọn?'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.17",
            "verseOrgIds": [
              "JOB.22.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 22:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Síbẹ̀ ó fi ohun rere kún ilé wọn!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.18",
            "verseOrgIds": [
              "JOB.22.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 22:18"
      },
      "items": [
        {
          "text": "Ṣùgbọ́n ìmọ̀ ènìyàn búburú jìnnà sí mi!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.18",
            "verseOrgIds": [
              "JOB.22.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOB 22:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn olódodo rí ìparun wọn, wọ́n sì yọ̀,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.19",
            "verseOrgIds": [
              "JOB.22.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 22:19"
      },
      "items": [
        {
          "text": "àwọn aláìlẹ́ṣẹ̀ sì fi wọ́n rẹ́rìn-ín ẹlẹ́yà pé,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.19",
            "verseOrgIds": [
              "JOB.22.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOB 22:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "'Lóòtítọ́ àwọn ọ̀tá wa ni a ké kúrò,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.20",
            "verseOrgIds": [
              "JOB.22.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 22:20"
      },
      "items": [
        {
          "text": "iná yóò sì jó oró wọn run.'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.20",
            "verseOrgIds": [
              "JOB.22.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOB 22:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Fa ara rẹ súnmọ́ Ọlọ́run, ìwọ ó sì rí àlàáfíà;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.21",
            "verseOrgIds": [
              "JOB.22.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 22:21"
      },
      "items": [
        {
          "text": "nípa èyí ni rere yóò wá bá ọ.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.21",
            "verseOrgIds": [
              "JOB.22.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOB 22:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi bẹ̀ ọ́, gba òfin láti ẹnu rẹ̀ wá,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.22",
            "verseOrgIds": [
              "JOB.22.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 22:22"
      },
      "items": [
        {
          "text": "kí o sì to ọ̀rọ̀ rẹ̀ sí àyà rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.22",
            "verseOrgIds": [
              "JOB.22.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOB 22:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ìwọ bá yípadà sọ́dọ̀ Olódùmarè, a sì gbé ọ ró.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.23",
            "verseOrgIds": [
              "JOB.22.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 22:23"
      },
      "items": [
        {
          "text": "Bí ìwọ bá sì mú ẹ̀ṣẹ̀ jìnnà réré kúrò nínú àgọ́ rẹ,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.23",
            "verseOrgIds": [
              "JOB.22.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOB 22:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "tí ìwọ bá tẹ́ wúrà dáradára sílẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.24",
            "verseOrgIds": [
              "JOB.22.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 22:24"
      },
      "items": [
        {
          "text": "lórí erùpẹ̀ àti wúrà Ofiri lábẹ́ òkúta odò,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.24",
            "verseOrgIds": [
              "JOB.22.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOB 22:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "nígbà náà ní Olódùmarè yóò jẹ́ wúrà rẹ,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.25",
            "verseOrgIds": [
              "JOB.22.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 22:25"
      },
      "items": [
        {
          "text": "àní yóò sì jẹ́ fàdákà fún ọ ní ọ̀pọ̀lọpọ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.25",
            "verseOrgIds": [
              "JOB.22.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOB 22:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lóòtítọ́ nígbà náà ní ìwọ ó ní inú dídùn nínú Olódùmarè,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.26",
            "verseOrgIds": [
              "JOB.22.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 22:26"
      },
      "items": [
        {
          "text": "ìwọ ó sì gbé ojú rẹ sókè sọ́dọ̀ Ọlọ́run.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.26",
            "verseOrgIds": [
              "JOB.22.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JOB 22:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ìwọ bá gbàdúrà rẹ sọ́dọ̀ rẹ̀, yóò sì gbọ́ tìrẹ,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.27",
            "verseOrgIds": [
              "JOB.22.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 22:27"
      },
      "items": [
        {
          "text": "ìwọ ó sì san ẹ̀jẹ́ rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.27",
            "verseOrgIds": [
              "JOB.22.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JOB 22:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ ó sì gbìmọ̀ ohun kan pẹ̀lú, yóò sì fi ìdí múlẹ̀ fún ọ;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.28",
            "verseOrgIds": [
              "JOB.22.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 22:28"
      },
      "items": [
        {
          "text": "ìmọ́lẹ̀ yóò sì mọ́ sípa ọ̀nà rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.28",
            "verseOrgIds": [
              "JOB.22.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JOB 22:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí ipa ọ̀nà rẹ bá lọ sísàlẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.29",
            "verseOrgIds": [
              "JOB.22.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 22:29"
      },
      "items": [
        {
          "text": "nígbà náà ni ìwọ o wí pé, 'Ìgbésókè ń bẹ!'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.29",
            "verseOrgIds": [
              "JOB.22.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 22:29"
      },
      "items": [
        {
          "text": "Ọlọ́run yóò sì gba onírẹ̀lẹ̀ là!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.29",
            "verseOrgIds": [
              "JOB.22.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JOB 22:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yóò gba ẹni tí kì í ṣe aláìjẹ̀bi là,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.30",
            "verseOrgIds": [
              "JOB.22.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 22:30"
      },
      "items": [
        {
          "text": "a ó sì gbà á nípa mímọ́ ọwọ́ rẹ̀.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.30",
            "verseOrgIds": [
              "JOB.22.30"
            ]
          }
        }
      ]
    }
