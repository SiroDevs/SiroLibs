          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.27",
            "verseOrgIds": [
              "1CH.21.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1CH.21.27",
                "verseOrgIds": [
                  "1CH.21.27"
                ]
              }
            }
          ]
        },
        {
          "text": "sọ̀rọ̀ sí angẹli, ó sì gbé idà padà bọ̀ sínú àkọ̀ rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.27",
            "verseOrgIds": [
              "1CH.21.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 21:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní àkókò náà nígbà tí Dafidi sì rí wí pé",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.28",
            "verseOrgIds": [
              "1CH.21.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1CH.21.28",
                "verseOrgIds": [
                  "1CH.21.28"
                ]
              }
            }
          ]
        },
        {
          "text": "ti dá a lóhùn lórí ilẹ̀ ìpakà ti Arauna ará Jebusi, ó sì rú ẹbọ sísun níbẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.28",
            "verseOrgIds": [
              "1CH.21.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CH 21:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àgọ́",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.29",
            "verseOrgIds": [
              "1CH.21.29"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1CH.21.29",
                "verseOrgIds": [
                  "1CH.21.29"
                ]
              }
            }
          ]
        },
        {
          "text": "tí Mose ti ṣe ní aginjù, àti pẹpẹ ẹbọ sísun wà lórí ibi gíga ní Gibeoni ní àkókò náà.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.29",
            "verseOrgIds": [
              "1CH.21.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CH 21:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n Dafidi kò lè lọ síwájú rẹ̀ láti béèrè lọ́wọ́ Ọlọ́run, nítorí tí ó bẹ̀rù nípa idà ọwọ́ angẹli",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.30",
            "verseOrgIds": [
              "1CH.21.30"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1CH.21.30",
                "verseOrgIds": [
                  "1CH.21.30"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.30",
            "verseOrgIds": [
              "1CH.21.30"
            ]
          }
        }
      ]
