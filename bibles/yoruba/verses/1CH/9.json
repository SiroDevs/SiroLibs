  "verseCount": 44,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "9",
        "style": "c",
        "sid": "1CH 9"
      },
      "items": [
        {
          "text": "9",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo Israẹli ni a kọ lẹ́sẹẹsẹ nínú ìtàn ìdílé láti ọ̀dọ̀ àwọn baba ńlá nínú ìwé àwọn ọba Israẹli. Àwọn ènìyàn Juda ni a kó ní ìgbèkùn lọ sí Babeli nítorí àìṣòótọ́ wọn.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.1",
            "verseOrgIds": [
              "1CH.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Àwọn ènìyàn tí ó wà ní Jerusalẹmu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nísinsin yìí, àwọn tí ó kọ́kọ́ tún tẹ̀dó lórí ohun ìní wọn ní ìlú wọn ni díẹ̀ nínú àwọn ọmọ Israẹli, àwọn àlùfáà, àwọn ará Lefi àti àwọn ìránṣẹ́ ilé",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text"
            }
          ]
        },
        {
          "text": ".",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn tí ó wá láti Juda láti Benjamini àti láti Efraimu àti Manase tí ó ń gbé ní Jerusalẹmu jẹ́:",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uttai ọmọ Ammihudu, ọmọ Omri, ọmọ Imri, ọmọ Bani, ìran ọmọ Peresi ọmọ Juda.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.4",
            "verseOrgIds": [
              "1CH.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àti nínú ará Ṣilo:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.5",
            "verseOrgIds": [
              "1CH.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 9:5"
      },
      "items": [
        {
          "text": "Asaiah àkọ́bí àti àwọn ọmọ rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.5",
            "verseOrgIds": [
              "1CH.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ti ará Sera:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.6",
            "verseOrgIds": [
              "1CH.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 9:6"
      },
      "items": [
        {
          "text": "Jeueli.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.6",
            "verseOrgIds": [
              "1CH.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4",
        "vid": "1CH 9:6"
      },
      "items": [
        {
          "text": "Àwọn ènìyàn láti Juda sì jẹ́ ẹ̀ẹ́dẹ́gbẹ̀rin ó dín mẹ́wàá (690).",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àti nínú àwọn ọmọ Benjamini ni:",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1CH 9:7"
      },
      "items": [
        {
          "text": "Sallu ọmọ Meṣullamu, ọmọ Hodafiah; ọmọ Hasenuah;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.7",
            "verseOrgIds": [
              "1CH.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibinaiah ọmọ Jerohamu;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.8",
            "verseOrgIds": [
              "1CH.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1CH 9:8"
      },
      "items": [
        {
          "text": "Ela ọmọ Ussi, ọmọ Mikri;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.8",
            "verseOrgIds": [
              "1CH.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1CH 9:8"
      },
      "items": [
        {
          "text": "àti Meṣullamu ọmọ Ṣefatia; ọmọ Reueli, ọmọ Ibinijah.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.8",
            "verseOrgIds": [
              "1CH.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ènìyàn láti Benjamini gẹ́gẹ́ bí a ti ṣe kọ ọ́ nínú ìran wọn nínú ìtàn ìdílé láti ọ̀dọ̀ baba ńlá wọn, tí ó jẹ́ ẹgbẹ̀rún ó dín mẹ́rìnlélógójì (956). Gbogbo àwọn ọkùnrin yí jẹ́ àwọn olórí àwọn ìdílé.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ti àwọn àlùfáà:",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1CH 9:10"
      },
      "items": [
        {
          "text": "Jedaiah; Jehoiaribi; Jakini;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.10",
            "verseOrgIds": [
              "1CH.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asariah ọmọ Hilkiah, ọmọ Meṣullamu, ọmọ Sadoku, ọmọ Meraioti, ọmọ Ahitubu, olórí tí ó ń bojútó ilé Ọlọ́run;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.11",
            "verseOrgIds": [
              "1CH.9.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adaiah ọmọ Jerohamu, ọmọ Paṣuri, ọmọ Malkiah;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.12",
            "verseOrgIds": [
              "1CH.9.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1CH 9:12"
      },
      "items": [
        {
          "text": "àti Masai ọmọ Adieli, ọmọ Jahisera, ọmọ Meṣullamu ọmọ Meṣilemiti, ọmọ Immeri.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.12",
            "verseOrgIds": [
              "1CH.9.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn àlùfáà, tí wọ́n jẹ́ àwọn olórí àwọn ìdílé, tí ó jẹ́ ẹgbẹ̀sán ó dín méjì (1,760). Wọ́n jẹ́ alágbára ọkùnrin, tí wọ́n lè dúró fún iṣẹ́ ìránṣẹ́ nínú ilé Ọlọ́run.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ti àwọn ará Lefi:",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1CH 9:14"
      },
      "items": [
        {
          "text": "Ṣemaiah ọmọ Haṣubu, ọmọ Asrikamu, ọmọ Haṣabiah ará Merari;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.14",
            "verseOrgIds": [
              "1CH.9.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakibakari, Hereṣi, Galali àti Mattaniah, ọmọ Mika, ọmọ Sikri, ọmọ Asafu;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.15",
            "verseOrgIds": [
              "1CH.9.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obadiah ọmọ Ṣemaiah, ọmọ Galali, ọmọ Jedutuni;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.16",
            "verseOrgIds": [
              "1CH.9.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1CH 9:16"
      },
      "items": [
        {
          "text": "àti Berekiah ọmọ Asa, ọmọ Elkana, tí ó ń gbé nínú àwọn ìlú àwọn ará Netofa.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.16",
            "verseOrgIds": [
              "1CH.9.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn olùtọ́jú ẹnu-ọ̀nà:",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1CH 9:17"
      },
      "items": [
        {
          "text": "Ṣallumu, Akkubu, Talmoni, Ahimani àti arákùnrin wọn, Ṣalumu olóyè wọn,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.17",
            "verseOrgIds": [
              "1CH.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "ti wà ní ipò ìdúró ní ẹnu-ọ̀nà ọba ní apá ìhà ìlà-oòrùn títí di àkókò yí. Wọ̀nyí ni àwọn olùtọ́jú ẹnu-ọ̀nà tí ó jẹ́ ti ìpàgọ́ àwọn ará Lefi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.18",
            "verseOrgIds": [
              "1CH.9.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣallumu ọmọ Kore ọmọ Ebiasafi, ọmọ Kora, àti àwọn olùtọ́jú ẹnu-ọ̀nà ẹlẹgbẹ́ rẹ̀. Láti ìdílé rẹ̀ (àwọn ará Korati) ni ó dúró fún ṣíṣọ́ ìloro ẹnu-ọ̀nà àgọ́ gẹ́gẹ́ bí baba wọn ti ń dúró fún ṣíṣọ́ àbáwọlé ibùgbé",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.19",
            "verseOrgIds": [
              "1CH.9.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1CH.9.19",
                "verseOrgIds": [
                  "1CH.9.19"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.19",
            "verseOrgIds": [
              "1CH.9.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ìgbà àkọ́kọ́ Finehasi ọmọ Eleasari jẹ́ olórí fún àwọn olùtọ́jú ẹnu-ọ̀nà,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.20",
            "verseOrgIds": [
              "1CH.9.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1CH.9.20",
                "verseOrgIds": [
                  "1CH.9.20"
                ]
              }
            }
          ]
        },
        {
          "text": "sì wà pẹ̀lú rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.20",
            "verseOrgIds": [
              "1CH.9.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sekariah, ọmọ Meṣelemiah jẹ́ olùtọ́jú ẹnu-ọ̀nà ní àbáwọlé sí àgọ́ ibi ìpàdé.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.21",
            "verseOrgIds": [
              "1CH.9.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo rẹ̀ lápapọ̀, àwọn tí a yàn láti jẹ́ olùtọ́jú ẹnu-ọ̀nà ní àwọn ìloro jẹ́ igba ó lé méjìlá (212). A ka àwọn wọ̀nyí nípa ìdílé ní ìletò wọn.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "1CH 9:22"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1CH 9:22"
      },
      "items": [
        {
          "text": "Àwọn olùtọ́jú ẹnu-ọ̀nà ni a ti yàn sí ipò láti ọ̀dọ̀ Dafidi àti Samuẹli, aríran, nítorí òtítọ́ wọn.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.22",
            "verseOrgIds": [
              "1CH.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn àti àwọn ọmọ wọn ni ó wà fún ṣíṣọ́ ẹnu-ọ̀nà ilé",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.23",
            "verseOrgIds": [
              "1CH.9.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1CH.9.23",
                "verseOrgIds": [
                  "1CH.9.23"
                ]
              }
            }
          ]
        },
        {
          "text": "ilé tí a pè ní àgọ́.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.23",
            "verseOrgIds": [
              "1CH.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn olùtọ́jú ẹnu-ọ̀nà wà ní igun mẹ́rẹ̀ẹ̀rin: ìlà-oòrùn, ìwọ̀-oòrùn àríwá àti gúúsù.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.24",
            "verseOrgIds": [
              "1CH.9.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn arákùnrin wọn ní àwọn ìletò wọn ní láti wá ní àkókò dé àkókò láti pín iṣẹ́ ìsìn wọn fún àkókò ọjọ́ méje.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.25",
            "verseOrgIds": [
              "1CH.9.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CH 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n àwọn olórí alábojútó ẹnu-ọ̀nà mẹ́rẹ̀ẹ̀rin tí wọ́n jẹ́ ará Lefi ni a yàn fún àwọn iyàrá àti àwọn àpótí ìṣúra ní ilé Ọlọ́run.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.26",
            "verseOrgIds": [
              "1CH.9.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n á lo gbogbo òru ní dídúró yí ilé Ọlọ́run ká, nítorí wọ́n ní láti ṣọ́ ọ, wọ́n sì ní àṣẹ sí kọ́kọ́rọ́ fún ṣíṣí i ní àràárọ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.27",
            "verseOrgIds": [
              "1CH.9.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 9:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Díẹ̀ wà ní ìdí ohun èlò tí à ń lò fún ìsìn ilé Ọlọ́run; wọn a máa kà á nígbà tí wọ́n gbé e wọlé àti nígbà tí a kó wọn jáde.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.28",
            "verseOrgIds": [
              "1CH.9.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CH 9:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn mìíràn ni a yàn láti bojútó ohun èlò àti gbogbo ohun èlò ilé tí a yà sọ́tọ̀ fún Ọlọ́run, àti ìyẹ̀fun àti ọtí èso àjàrà àti òróró náà, tùràrí àti tùràrí olóòórùn dídùn.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.29",
            "verseOrgIds": [
              "1CH.9.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CH 9:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n díẹ̀ nínú àwọn àlùfáà ni ó ń bojútó pípò tùràrí olóòórùn dídùn papọ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.30",
            "verseOrgIds": [
              "1CH.9.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CH 9:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ará Lefi tí a sọ ní Mattitiah àkọ́bí ọmọkùnrin Ṣallumu ará Kora ni a yàn, tí ń ṣe alábojútó ohun tí a dín.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.31",
            "verseOrgIds": [
              "1CH.9.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1CH 9:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àti nínú àwọn arákùnrin wọn, nínú àwọn ọmọ Kohati tó ń ṣe ìtọ́jú àkàrà ìfihàn, láti máa pèsè rẹ̀ ní ọjọọjọ́ ìsinmi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.32",
            "verseOrgIds": [
              "1CH.9.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1CH 9:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn tí wọ́n jẹ́ ọkùnrin, olórí àwọn ìdílé Lefi dúró nínú àgọ́ ilé",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.33",
            "verseOrgIds": [
              "1CH.9.33"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1CH.9.33",
                "verseOrgIds": [
                  "1CH.9.33"
                ]
              }
            }
          ]
        },
        {
          "text": ", wọn kò sì ṣe lára iṣẹ́ ìsìn yòókù nítorí wọ́n ń ṣe iṣẹ́ náà lọ́sàn, lóru.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.33",
            "verseOrgIds": [
              "1CH.9.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1CH 9:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo wọ̀nyí jẹ́ olórí àwọn Lefi, olóyè gẹ́gẹ́ bí a ti ṣe kọ lẹ́sẹẹsẹ sínú ìtàn ìdílé láti ọ̀dọ̀ baba ńlá wọn, wọ́n sì ń gbé ní Jerusalẹmu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.34",
            "verseOrgIds": [
              "1CH.9.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìdílé àti Ìrandíran Saulu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1CH 9:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jeieli baba Gibeoni ń gbé ní Gibeoni.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.35",
            "verseOrgIds": [
              "1CH.9.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 9:35"
      },
      "items": [
        {
          "text": "Orúkọ ìyàwó rẹ̀ a máa jẹ́ Maaka,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.35",
            "verseOrgIds": [
              "1CH.9.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1CH 9:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "pẹ̀lú àkọ́bí ọmọkùnrin rẹ̀ jẹ́ Abdoni, tí wọ̀nyí sì ń tẹ̀lé Suri, Kiṣi, Baali, Neri, Nadabu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.36",
            "verseOrgIds": [
              "1CH.9.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1CH 9:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gedori, Ahio, Sekariah àti Mikiloti.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.37",
            "verseOrgIds": [
              "1CH.9.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1CH 9:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mikiloti jẹ́ baba Ṣimeamu, àwọn náà ń gbé ní ẹ̀bá ìbátan wọn ní Jerusalẹmu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.38",
            "verseOrgIds": [
              "1CH.9.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1CH 9:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neri jẹ́ baba Kiṣi, Kiṣi baba a Saulu, àti Saulu baba a Jonatani, àti Malikiṣua, Abinadabu àti Eṣi-Baali.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.39",
            "verseOrgIds": [
              "1CH.9.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1CH 9:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọmọ Jonatani:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.40",
            "verseOrgIds": [
              "1CH.9.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 9:40"
      },
      "items": [
        {
          "text": "Meribu-Baali, tí ó jẹ́ baba Mika.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.40",
            "verseOrgIds": [
              "1CH.9.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1CH 9:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ọmọ Mika:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.41",
            "verseOrgIds": [
              "1CH.9.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 9:41"
      },
      "items": [
        {
          "text": "Pitoni. Meleki, Tarea àti Ahasi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.41",
            "verseOrgIds": [
              "1CH.9.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1CH 9:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahasi jẹ́ baba Jada, Jada jẹ́ baba Alemeti, Asmafeti, Simri, sì Simri jẹ́ baba Mosa.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.42",
            "verseOrgIds": [
              "1CH.9.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
