    "verseCount": 25,
    "content": [
      {
        "name": "chapter",
        "type": "tag",
        "attrs": {
          "number": "1",
          "style": "c",
          "sid": "JUD 1"
        },
        "items": [
          {
            "text": "1",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "1",
              "style": "v",
              "sid": "JUD 1:1"
            },
            "items": [
              {
                "text": "1",
                "type": "text"
              }
            ]
          },
          {
            "text": "Juda, ìránṣẹ́ Jesu Kristi àti arákùnrin Jakọbu,",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.1",
              "verseOrgIds": [
                "JUD.1.1"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "b",
          "vid": "JUD 1:1"
        },
        "items": []
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p",
          "vid": "JUD 1:1"
        },
        "items": [
          {
            "text": "Sí àwọn tí a pè, olùfẹ́ nínú Ọlọ́run Baba, tí a pamọ́ fún Jesu Kristi:",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.1",
              "verseOrgIds": [
                "JUD.1.1"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "b"
        },
        "items": []
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "2",
              "style": "v",
              "sid": "JUD 1:2"
            },
            "items": [
              {
                "text": "2",
                "type": "text"
              }
            ]
          },
          {
            "text": "Kí àánú, àlàáfíà àti ìfẹ́ kí ó máa jẹ́ tiyín ní ọ̀pọ̀lọpọ̀.",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.2",
              "verseOrgIds": [
                "JUD.1.2"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "b"
        },
        "items": []
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "s1"
        },
        "items": [
          {
            "text": "Ẹ̀ṣẹ̀ àti ìparun àwọn aláìwà-bí-Ọlọ́run",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "3",
              "style": "v",
              "sid": "JUD 1:3"
            },
            "items": [
              {
                "text": "3",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ẹ̀yin ọ̀rẹ́ mi tòótọ́, bí ó tilẹ̀ jẹ́ pé èmí ní ìtara láti kọ̀wé sí i yín nípa ìgbàlà tí í ṣe ti gbogbo ènìyàn, n kò gbọdọ̀ má kọ̀wé sí yín, kí ń sì gbà yín ní ìyànjú láti máa jà fitafita fún ìgbàgbọ́, tí a ti fi lé àwọn ènìyàn mímọ́ lọ́wọ́ ní ẹ̀ẹ̀kan ṣoṣo.",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.3",
              "verseOrgIds": [
                "JUD.1.3"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "4",
              "style": "v",
              "sid": "JUD 1:4"
            },
            "items": [
              {
                "text": "4",
                "type": "text"
              }
            ]
          },
          {
            "text": "Nítorí àwọn ènìyàn kan ń bẹ tí wọ́n ń yọ́ wọlé, àwọn ẹni tí a ti yàn láti ìgbà àtijọ́ sí ẹ̀bi yìí, àwọn aláìwà-bí-Ọlọ́run, tí ń yí oore-ọ̀fẹ́ Ọlọ́run wa padà sí wọ̀bìà, tí wọn sì ń sẹ́ Olúwa wa kan ṣoṣo náà, àní, Jesu Kristi Olúwa.",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.4",
              "verseOrgIds": [
                "JUD.1.4"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "5",
              "style": "v",
              "sid": "JUD 1:5"
            },
            "items": [
              {
                "text": "5",
                "type": "text"
              }
            ]
          },
          {
            "text": "Nítòótọ́, ẹ ti mọ nǹkan wọ̀nyí ní ẹ̀ẹ̀kan rí, mo fẹ́ rán an yín létí pé, lẹ́yìn tí Olúwa ti gba àwọn kan là láti ilẹ̀ Ejibiti wá, lẹ́yìn náà ni ó run àwọn tí kò gbàgbọ́.",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.5",
              "verseOrgIds": [
                "JUD.1.5"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "6",
              "style": "v",
              "sid": "JUD 1:6"
            },
            "items": [
              {
                "text": "6",
                "type": "text"
              }
            ]
          },
          {
            "text": "Àti àwọn angẹli tí kò tọ́jú ipò ọlá wọn, ṣùgbọ́n tí wọn fi ipò wọn sílẹ̀, àwọn tí ó pamọ́ sínú ẹ̀wọ̀n àìnípẹ̀kun ní ìsàlẹ̀ òkùnkùn de ìdájọ́ ọjọ́ ńlá nì.",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.6",
              "verseOrgIds": [
                "JUD.1.6"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "7",
              "style": "v",
              "sid": "JUD 1:7"
            },
            "items": [
              {
                "text": "7",
                "type": "text"
              }
            ]
          },
          {
            "text": "Àní bí Sodomu àti Gomorra, àti àwọn ìlú agbègbè wọn, ti fi ara wọn fún àgbèrè ṣíṣe, tí wọ́n sì ń tẹ̀lé ará àjèjì lẹ́yìn, àwọn ni ó fi lélẹ̀ bí àpẹẹrẹ, àwọn tí ó ń jìyà iná àìnípẹ̀kun.",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.7",
              "verseOrgIds": [
                "JUD.1.7"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "8",
              "style": "v",
              "sid": "JUD 1:8"
            },
            "items": [
              {
                "text": "8",
                "type": "text"
              }
            ]
          },
          {
            "text": "Bákan náà ni àwọn wọ̀nyí ń sọ ara wọn di èérí nínú àlá wọn, wọ́n ń gan ìjòyè, wọn sì ń sọ̀rọ̀ búburú sí àwọn ọlọ́lá.",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.8",
              "verseOrgIds": [
                "JUD.1.8"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "9",
              "style": "v",
              "sid": "JUD 1:9"
            },
            "items": [
              {
                "text": "9",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ṣùgbọ́n Mikaeli, olórí àwọn angẹli, nígbà tí ó ń bá Èṣù jiyàn nítorí òkú Mose, kò sọ ọ̀rọ̀-òdì sí i; ṣùgbọ́n ó wí pé, \"Olúwa bá ọ wí.\"",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.9",
              "verseOrgIds": [
                "JUD.1.9"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "10",
              "style": "v",
              "sid": "JUD 1:10"
            },
            "items": [
              {
                "text": "10",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ṣùgbọ́n àwọn wọ̀nyí n sọ̀rọ̀-òdì sí ohun gbogbo ti kò yé wọn: ṣùgbọ́n ohun gbogbo tí wọn mọ̀ nípa èrò ara ni, bí ẹranko tí kò ní ìyè, nípasẹ̀ nǹkan wọ̀nyí ni wọ́n di ẹni ìparun.",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.10",
              "verseOrgIds": [
                "JUD.1.10"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "11",
              "style": "v",
              "sid": "JUD 1:11"
            },
            "items": [
              {
                "text": "11",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ègbé ni fún wọn! Nítorí tí wọ́n ti rìn ní ọ̀nà Kaini, wọ́n sì fi ìwọra súré sínú ìṣìnà Balaamu nítorí ère, wọn ṣègbé nínú ìṣọ̀tẹ̀ Kora.",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.11",
              "verseOrgIds": [
                "JUD.1.11"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "12",
              "style": "v",
              "sid": "JUD 1:12"
            },
            "items": [
              {
                "text": "12",
                "type": "text"
              }
            ]
          },
          {
            "text": "Àwọn wọ̀nyí ní ó jẹ́ àbàwọ́n nínú àsè ìfẹ́ yín, nígbà tí wọ́n ń bá yín jẹ àsè, àwọn olùṣọ́-àgùntàn ti ń bọ́ ara wọn láìbẹ̀rù. Wọ́n jẹ́ ìkùùkuu láìrọ òjò, tí a ń ti ọwọ́ afẹ́fẹ́ gbá kiri; àwọn igi aláìléso ní àkókò èso, wọ́n kú lẹ́ẹ̀méjì, a sì fà wọ́n tú tigbòǹgbò tigbòǹgbò.",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.12",
              "verseOrgIds": [
                "JUD.1.12"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "13",
              "style": "v",
              "sid": "JUD 1:13"
            },
            "items": [
              {
                "text": "13",
                "type": "text"
              }
            ]
          },
          {
            "text": "Wọ́n jẹ́ ìjì líle ti ń ru ní ojú omi Òkun, ti ń hó ìfófó ìtìjú wọn jáde; alárìnkiri ìràwọ̀, àwọn tí a pa òkùnkùn biribiri mọ́ dè láéláé.",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.13",
              "verseOrgIds": [
                "JUD.1.13"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "14",
              "style": "v",
              "sid": "JUD 1:14"
            },
            "items": [
              {
                "text": "14",
                "type": "text"
              }
            ]
          },
          {
            "text": "Àwọn wọ̀nyí pẹ̀lú ni Enoku, ẹni keje láti ọ̀dọ̀ Adamu, sọtẹ́lẹ̀ nípa wọn pé, \"Kíyèsi i, Olúwa ń bọ̀ pẹ̀lú ẹgbẹẹgbẹ̀rún ní ọ̀nà ẹgbẹ̀rún àwọn ènìyàn rẹ̀ mímọ́,",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.14",
              "verseOrgIds": [
                "JUD.1.14"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "15",
              "style": "v",
              "sid": "JUD 1:15"
            },
            "items": [
              {
                "text": "15",
                "type": "text"
              }
            ]
          },
          {
            "text": "láti ṣe ìdájọ́ gbogbo ènìyàn, láti dá gbogbo àwọn aláìwà-bí-Ọlọ́run lẹ́bi ní ti gbogbo iṣẹ́ àìwà-bí-Ọlọ́run wọn, ti wọ́n ti fi àìwà-bí-Ọlọ́run ṣe, àti ní ti gbogbo ọ̀rọ̀ líle tí àwọn ẹlẹ́ṣẹ̀ aláìwà-bí-Ọlọ́run ti sọ sí i.\"",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.15",
              "verseOrgIds": [
                "JUD.1.15"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "16",
              "style": "v",
              "sid": "JUD 1:16"
            },
            "items": [
              {
                "text": "16",
                "type": "text"
              }
            ]
          },
          {
            "text": "Àwọn ènìyàn wọ̀nyí ní àwọn ti ń kùn, àwọn aláròyé, ti ń rìn nípa ìfẹ́kúfẹ̀ẹ́ ara wọn; wọn ń gbéraga nípa ara wọn, wọ́n sì ń ṣátá àwọn ènìyàn mìíràn fún èrè ara wọn.",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.16",
              "verseOrgIds": [
                "JUD.1.16"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "s1"
        },
        "items": [
          {
            "text": "Ìpè fún ìdúró ṣinṣin",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "17",
              "style": "v",
              "sid": "JUD 1:17"
            },
            "items": [
              {
                "text": "17",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ṣùgbọ́n ẹ̀yin olùfẹ́, ẹ rántí àwọn ọ̀rọ̀ tí a ti sọ ṣáájú láti ọwọ́ àwọn aposteli Olúwa wa Jesu Kristi.",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.17",
              "verseOrgIds": [
                "JUD.1.17"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "18",
              "style": "v",
              "sid": "JUD 1:18"
            },
            "items": [
              {
                "text": "18",
                "type": "text"
              }
            ]
          },
          {
            "text": "Bí wọn ti wí fún yín pé, \"Nígbà ìkẹyìn àwọn ẹlẹ́gàn yóò wà, tí wọn yóò máa rìn gẹ́gẹ́ bí ìfẹ́kúfẹ̀ẹ́ àìwà-bí-Ọlọ́run ti ara wọn.\"",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.18",
              "verseOrgIds": [
                "JUD.1.18"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "19",
              "style": "v",
              "sid": "JUD 1:19"
            },
            "items": [
              {
                "text": "19",
                "type": "text"
              }
            ]
          },
          {
            "text": "Àwọn ènìyàn wọ̀nyí ni àwọn ẹni tí ń ya ara wọn sí ọ̀tọ̀, àwọn ẹni ti ara, tí wọn kò ni Ẹ̀mí.",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.19",
              "verseOrgIds": [
                "JUD.1.19"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "20",
              "style": "v",
              "sid": "JUD 1:20"
            },
            "items": [
              {
                "text": "20",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ṣùgbọ́n ẹ̀yin, olùfẹ́, ti ẹ ń gbé ara yín ró lórí ìgbàgbọ́ yín tí ó mọ́ jùlọ, ti ẹ ń gbàdúrà nínú Ẹ̀mí Mímọ́.",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.20",
              "verseOrgIds": [
                "JUD.1.20"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "21",
              "style": "v",
              "sid": "JUD 1:21"
            },
            "items": [
              {
                "text": "21",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ẹ máa pa ara yín mọ́ nínú ìfẹ́ Ọlọ́run, bí ẹ̀yin ti ń retí àánú Olúwa wa Jesu Kristi tí yóò mú yín dé ìyè àìnípẹ̀kun.",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.21",
              "verseOrgIds": [
                "JUD.1.21"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "22",
              "style": "v",
              "sid": "JUD 1:22"
            },
            "items": [
              {
                "text": "22",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ẹ máa ṣàánú fún àwọn tí ń ṣe iyèméjì.",
            "type": "text",
            "attrs": {
