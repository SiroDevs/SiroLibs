  "verseCount": 33,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "16",
        "style": "c",
        "sid": "JHN 16"
      },
      "items": [
        {
          "text": "16",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JHN 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Nǹkan wọ̀nyí ni mo ti sọ fún yín, kí a má ba à mú yín yapa kúrò.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.1",
                "verseOrgIds": [
                  "JHN.16.1"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.1",
            "verseOrgIds": [
              "JHN.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JHN 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Wọ́n ó yọ yín kúrò nínú Sinagọgu: àní, àkókò ń bọ̀, tí ẹnikẹ́ni tí ó bá pa yín, yóò rò pé òun ń ṣe ìsìn fún Ọlọ́run.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.2",
                "verseOrgIds": [
                  "JHN.16.2"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.2",
            "verseOrgIds": [
              "JHN.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JHN 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nǹkan wọ̀nyí ni wọ́n ó sì ṣe, nítorí tí wọn kò mọ Baba, wọn kò sì mọ̀ mí.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.3",
                "verseOrgIds": [
                  "JHN.16.3"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.3",
            "verseOrgIds": [
              "JHN.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JHN 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ṣùgbọ́n nǹkan wọ̀nyí ni mo ti sọ fún yín, pé nígbà tí wákàtí wọn bá dé, kí ẹ lè rántí wọn pé mo ti wí fún yín. Ṣùgbọ́n èmi kò sọ nǹkan wọ̀nyí fún yín láti ìpilẹ̀ṣẹ̀ wá, nítorí tí mo wà pẹ̀lú yín.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.4",
                "verseOrgIds": [
                  "JHN.16.4"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Iṣẹ́ Ẹ̀mí Mímọ́",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JHN 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ṣùgbọ́n nísinsin yìí èmi ń lọ sọ́dọ̀ ẹni tí ó rán mi; kò sì sí ẹnìkan nínú yín tí ó bi mí lérè pé, 'Níbo ni ìwọ ń lọ?'",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.5",
                "verseOrgIds": [
                  "JHN.16.5"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.5",
            "verseOrgIds": [
              "JHN.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JHN 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ṣùgbọ́n nítorí mo sọ nǹkan wọ̀nyí fún yín, ìbìnújẹ́ kún ọkàn yín.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.6",
                "verseOrgIds": [
                  "JHN.16.6"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.6",
            "verseOrgIds": [
              "JHN.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JHN 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ṣùgbọ́n òtítọ́ ni èmi ń sọ fún yín; àǹfààní ni yóò jẹ́ fún yín bí èmi bá lọ, nítorí bí èmi kò bá lọ, Olùtùnú kì yóò tọ̀ yín wá; ṣùgbọ́n bí mo bá lọ, èmi ó rán an sí yín.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.7",
                "verseOrgIds": [
                  "JHN.16.7"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.7",
            "verseOrgIds": [
              "JHN.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JHN 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nígbà tí òun bá sì dé, yóò fi òye yé aráyé ní ti ẹ̀ṣẹ̀, àti ní ti òdodo, àti ní ti ìdájọ́,",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.8",
                "verseOrgIds": [
                  "JHN.16.8"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.8",
            "verseOrgIds": [
              "JHN.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JHN 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "ní ti ẹ̀ṣẹ̀, nítorí tí wọn kò gbà mí gbọ́;",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.9",
                "verseOrgIds": [
                  "JHN.16.9"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.9",
            "verseOrgIds": [
              "JHN.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JHN 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "ní ti òdodo, nítorí tí èmi ń lọ sọ́dọ̀ Baba, ẹ̀yin kò sì mọ̀ mí.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.10",
                "verseOrgIds": [
                  "JHN.16.10"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.10",
            "verseOrgIds": [
              "JHN.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ní ti ìdájọ́, nítorí tí a ti ṣe ìdájọ́ ọmọ-aládé ayé yìí.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.11",
                "verseOrgIds": [
                  "JHN.16.11"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JHN 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mo ní ohun púpọ̀ láti sọ fún yín pẹ̀lú, ṣùgbọ́n ẹ kò lè gbà wọ́n nísinsin yìí.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.12",
                "verseOrgIds": [
                  "JHN.16.12"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.12",
            "verseOrgIds": [
              "JHN.16.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JHN 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ṣùgbọ́n nígbà tí òun, àní Ẹ̀mí òtítọ́ náà bá dé, yóò tọ́ yín sí ọ̀nà òtítọ́ gbogbo, nítorí kì yóò sọ ti ara rẹ̀; ṣùgbọ́n ohunkóhun tí ó bá gbọ́, òun ni yóò máa sọ, yóò sì sọ ohun tí ń bọ̀ fún yín.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.13",
                "verseOrgIds": [
                  "JHN.16.13"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.13",
            "verseOrgIds": [
              "JHN.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JHN 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Òun ó máa yìn mí lógo, nítorí tí yóò gbà nínú ti èmi, yóò sì máa sọ ọ́ fún yín.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.14",
                "verseOrgIds": [
                  "JHN.16.14"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.14",
            "verseOrgIds": [
              "JHN.16.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JHN 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ohun gbogbo tí Baba ní tèmi ni, nítorí èyí ni mo ṣe wí pé, òun ó gba nínú tèmi, yóò sì sọ ọ́ fún yín.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.15",
                "verseOrgIds": [
                  "JHN.16.15"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JHN 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Nígbà díẹ̀, ẹ̀yin kì ó sì rí mi, àti nígbà díẹ̀ si, ẹ ó sì rí mi, nítorí tí èmi ń lọ sọ́dọ̀ Baba.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.16",
                "verseOrgIds": [
                  "JHN.16.16"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìbànújẹ́ àwọn ọmọ-ẹ̀yìn yóò di ayọ̀",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JHN 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà díẹ̀ nínú àwọn ọmọ-ẹ̀yìn rẹ̀ ń bá ara wọn sọ pé, \"Kín ni èyí tí o wí fún wa yìí,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.17",
            "verseOrgIds": [
              "JHN.16.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "'Nígbà díẹ̀, ẹ̀yin ó sì rí mi, àti nígbà díẹ̀ ẹ̀wẹ̀, ẹ̀yin kì yóò rí mi, àti, nítorí tí èmi ń lọ sọ́dọ̀ Baba'",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.17",
                "verseOrgIds": [
                  "JHN.16.17"
                ]
              }
            }
          ]
        },
        {
          "text": "?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.17",
            "verseOrgIds": [
              "JHN.16.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JHN 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà wọ́n wí pé, kín ni,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.18",
            "verseOrgIds": [
              "JHN.16.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "nígbà díẹ̀",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.18",
                "verseOrgIds": [
                  "JHN.16.18"
                ]
              }
            }
          ]
        },
        {
          "text": "? Àwa kò mọ̀ ohun tí ó wí.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.18",
            "verseOrgIds": [
              "JHN.16.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JHN 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu sá à ti mọ̀ pé, wọ́n ń fẹ́ láti bi òun léèrè, ó sì wí fún wọn pé, \"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.19",
            "verseOrgIds": [
              "JHN.16.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ẹ̀yin ń bi ara yín léèrè ní ti èyí tí mo wí pé, nígbà díẹ̀, ẹ̀yin kì yóò sì rí mi, àti nígbà díẹ̀ si, ẹ̀yin ó sì rí mi?",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.19",
                "verseOrgIds": [
                  "JHN.16.19"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.19",
            "verseOrgIds": [
              "JHN.16.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JHN 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Lóòótọ́, lóòótọ́ ni mo wí fún yín pé, ẹ̀yin yóò máa sọkún ẹ ó sì máa pohùnréré ẹkún, ṣùgbọ́n àwọn aráyé yóò máa yọ̀: ṣùgbọ́n, ìbànújẹ́ yín yóò di ayọ̀.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.20",
                "verseOrgIds": [
                  "JHN.16.20"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.20",
            "verseOrgIds": [
              "JHN.16.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JHN 16:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nígbà tí obìnrin bá ń rọbí, a ní ìbìnújẹ́, nítorí tí wákàtí rẹ̀ dé: ṣùgbọ́n nígbà tí ó bá ti bí ọmọ náà tán, òun kì í sì í rántí ìrora náà mọ́, fún ayọ̀ nítorí a bí ènìyàn sí ayé.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.21",
                "verseOrgIds": [
                  "JHN.16.21"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.21",
            "verseOrgIds": [
              "JHN.16.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JHN 16:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nítorí náà ẹ̀yin ní ìbànújẹ́ nísinsin yìí, ṣùgbọ́n èmi ó tún rí yín, ọkàn yín yóò sì yọ̀, kò sì sí ẹni tí yóò gba ayọ̀ yín lọ́wọ́ yín.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.22",
                "verseOrgIds": [
                  "JHN.16.22"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.22",
            "verseOrgIds": [
              "JHN.16.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JHN 16:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Àti ní ọjọ́ náà ẹ̀yin kì ó bi mí lérè ohunkóhun. Lóòótọ́, lóòótọ́ ni mo wí fún yín, ohunkóhun tí ẹ̀yin bá béèrè lọ́wọ́ Baba ní orúkọ mi, òhun ó fi fún yín.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.23",
                "verseOrgIds": [
                  "JHN.16.23"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.23",
            "verseOrgIds": [
              "JHN.16.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JHN 16:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Títí di ìsinsin yìí ẹ kò tí ì béèrè ohunkóhun ní orúkọ mi, ẹ béèrè, ẹ ó sì rí gbà, kí ayọ̀ yín kí ó lè kún.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.24",
                "verseOrgIds": [
                  "JHN.16.24"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JHN 16:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Nǹkan wọ̀nyí ni mo fi òwe sọ fún yín: ṣùgbọ́n àkókò dé, nígbà tí èmi kì yóò fi òwe bá yín sọ̀rọ̀ mọ́, ṣùgbọ́n èmi ó sọ nípa ti Baba fún yín gbangba.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.25",
                "verseOrgIds": [
                  "JHN.16.25"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.25",
            "verseOrgIds": [
              "JHN.16.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JHN 16:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ní ọjọ́ náà, ẹ̀yin ó béèrè ní orúkọ mi, èmi kò sì wí fún yín pé, èmi ó béèrè lọ́wọ́ Baba fún yín.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.26",
                "verseOrgIds": [
                  "JHN.16.26"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.26",
            "verseOrgIds": [
              "JHN.16.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JHN 16:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nítorí tí Baba tìkára rẹ̀ fẹ́ràn yín, nítorí tí ẹ̀yin ti fẹ́ràn mi, ẹ sì ti gbàgbọ́ pé, lọ́dọ̀ Ọlọ́run ni èmi ti jáde wá.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.27",
                "verseOrgIds": [
                  "JHN.16.27"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.27",
            "verseOrgIds": [
              "JHN.16.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JHN 16:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mo ti ọ̀dọ̀ Baba jáde wá, mo sì wá sí ayé, àti nísinsin yìí mo fi ayé sílẹ̀, mo sì lọ sọ́dọ̀ Baba.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.28",
                "verseOrgIds": [
                  "JHN.16.28"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JHN 16:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ọmọ-ẹ̀yìn rẹ̀ wí fún un pé, \"Wò ó, nígbà yìí ni ìwọ ń sọ̀rọ̀ gbangba, ìwọ kò sì sọ ohunkóhun ní òwe.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.29",
            "verseOrgIds": [
              "JHN.16.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JHN 16:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà yìí ni àwa mọ̀ pé, ìwọ mọ̀ ohun gbogbo, ìwọ kò ní kí a bi ọ́ léèrè: nípa èyí ni àwa gbàgbọ́ pé, lọ́dọ̀ Ọlọ́run ni ìwọ ti jáde wá.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.30",
            "verseOrgIds": [
              "JHN.16.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JHN 16:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu dá wọn lóhùn pé,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.31",
            "verseOrgIds": [
              "JHN.16.31"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ẹ̀yin gbàgbọ́ wàyí?",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.31",
                "verseOrgIds": [
                  "JHN.16.31"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.31",
            "verseOrgIds": [
              "JHN.16.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JHN 16:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kíyèsi i, wákàtí ń bọ̀, àní ó dé tan nísinsin yìí, tí a ó fọ́n yín ká kiri, olúkúlùkù sí ilé rẹ̀; ẹ ó sì fi èmi nìkan sílẹ̀, ṣùgbọ́n kì yóò sì ṣe èmi nìkan, nítorí tí Baba ń bẹ pẹ̀lú mi.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.32",
                "verseOrgIds": [
                  "JHN.16.32"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JHN 16:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Nǹkan wọ̀nyí ni mo ti sọ fún yín tẹ́lẹ̀, kí ẹ̀yin kí ó lè ní àlàáfíà nínú mi. Nínú ayé, ẹ̀yin ó ní ìpọ́njú; ṣùgbọ́n ẹ tújúká; mo ti ṣẹ́gun ayé.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.33",
                "verseOrgIds": [
                  "JHN.16.33"
                ]
              }
            }
          ]
        }
      ]
    }
