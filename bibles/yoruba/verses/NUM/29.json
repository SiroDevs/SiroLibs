                "verseId": "NUM.29.36",
                "verseOrgIds": [
                  "NUM.29.36"
                ]
              }
            }
          ]
        },
        {
          "text": ", ẹbọ sísun ti akọ màlúù kan, àgbò ọlọ́dún kan àti ọ̀dọ́-àgùntàn ọlọ́dún kan méje, gbogbo rẹ̀ tí kò ní àbùkù.",
          "type": "text",
