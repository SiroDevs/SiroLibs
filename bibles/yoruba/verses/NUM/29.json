              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kí ẹ̀yin ṣe ìgbékalẹ̀ ẹbọ tí a fi iná ṣe tí ó ní òórùn dídùn sí",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.36",
