  "verseCount": 40,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "29",
        "style": "c",
        "sid": "NUM 29"
      },
      "items": [
        {
          "text": "29",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Àsè ìpè",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 29:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ní ọjọ́ kìn-ín-ní, oṣù keje, kí ẹ ní àpéjọ mímọ́, ẹ kò gbọdọ̀ ṣe iṣẹ́ kankan. Ọjọ́ ìfùnpè ni ó jẹ́ fún yín.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.1",
            "verseOrgIds": [
              "NUM.29.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 29:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gẹ́gẹ́ bí òórùn dídùn sí",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.2",
            "verseOrgIds": [
              "NUM.29.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "NUM.29.2",
                "verseOrgIds": [
                  "NUM.29.2"
                ]
              }
            }
          ]
        },
        {
          "text": ", ẹ pèsè ẹgbọrọ akọ màlúù kan, àgbò kan àti akọ ọ̀dọ́-àgùntàn ọlọ́dún kan aláìlábùkù, kí ẹ fi ẹbọ sísun.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.2",
            "verseOrgIds": [
              "NUM.29.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 29:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pẹ̀lú ẹbọ ohun jíjẹ wọn, ìyẹ̀fun kíkúnná tí a fi òróró pò, ìdámẹ́ta nínú mẹ́wàá òsùwọ̀n fún akọ màlúù kan, àti ìdá méjì nínú mẹ́wàá, òsùwọ̀n fún àgbò kan,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.3",
            "verseOrgIds": [
              "NUM.29.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 29:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "àti ìdámẹ́wàá òsùwọ̀n fún ọ̀dọ́-àgùntàn kan, àti fún ọ̀dọ́-àgùntàn méje.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.4",
            "verseOrgIds": [
              "NUM.29.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 29:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àti òbúkọ kan fún ẹbọ ẹ̀ṣẹ̀ láti ṣètùtù fún yín.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.5",
            "verseOrgIds": [
              "NUM.29.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 29:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pẹ̀lú ẹbọ sísun oṣù àti ẹbọ ohun jíjẹ rẹ̀ àti ẹbọ sísun ìgbà gbogbo àti ẹbọ mímu wọn gẹ́gẹ́ bí ìlànà wọn. Fún òórùn dídùn, ẹbọ tí a fi iná ṣe sí",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.6",
            "verseOrgIds": [
              "NUM.29.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "NUM.29.6",
                "verseOrgIds": [
                  "NUM.29.6"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.6",
            "verseOrgIds": [
              "NUM.29.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ọjọ́ ẹbọ ètùtù",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 29:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ní ọjọ́ kẹwàá nínú oṣù keje, kí ẹ ṣe àpéjọ mímọ́. Kí ẹ̀yin kí ó sẹ́ ara yín, ẹ kò sì gbọdọ̀ ṣe iṣẹ́ kankan.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.7",
            "verseOrgIds": [
              "NUM.29.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 29:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kí ẹ̀yin kí ó rú ẹbọ sísun olóòórùn dídùn sí",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.8",
            "verseOrgIds": [
              "NUM.29.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "NUM.29.8",
                "verseOrgIds": [
                  "NUM.29.8"
                ]
              }
            }
          ]
        },
        {
          "text": ", ẹgbọrọ akọ màlúù kan, àgbò kan, àti akọ ọ̀dọ́-àgùntàn méje ọlọ́dún kan, kí wọn kí ó sì jẹ́ aláìlábùkù fún yín.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.8",
            "verseOrgIds": [
              "NUM.29.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 29:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pẹ̀lú akọ màlúù, pèsè ọrẹ ìdámẹ́wàá mẹ́ta, òsùwọ̀n ìyẹ̀fun tí a fi òróró pò àti ìdámẹ́wàá méjì òsùwọ̀n fún àgbò kan,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.9",
            "verseOrgIds": [
              "NUM.29.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 29:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "àti fún ọ̀dọ́-àgùntàn kọ̀ọ̀kan, ìdámẹ́wàá òsùwọ̀n.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.10",
            "verseOrgIds": [
              "NUM.29.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 29:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pẹ̀lú akọ ewúrẹ́ kan fún ẹbọ ẹ̀ṣẹ̀, pẹ̀lú ẹbọ ẹ̀ṣẹ̀ fún ètùtù àti ẹbọ sísun gbogbo ìgbà àti ẹbọ jíjẹ rẹ̀ àti ẹbọ mímu wọn.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.11",
            "verseOrgIds": [
              "NUM.29.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Àpèjẹ Àgọ́",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 29:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ní ọjọ́ kẹ́ẹ̀dógún oṣù keje, kí ẹ̀yin kí ó ní àpéjọ mímọ́, ẹ̀yin kò sì gbọdọ̀ ṣe iṣẹ́ kankan. Kí ẹ̀yin kí ó sì ṣe àjọyọ̀ fún",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.12",
            "verseOrgIds": [
              "NUM.29.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "NUM.29.12",
                "verseOrgIds": [
                  "NUM.29.12"
                ]
              }
            }
          ]
        },
        {
          "text": "fún ọjọ́ méje.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.12",
            "verseOrgIds": [
              "NUM.29.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 29:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kí ẹ sì rú ẹbọ sísun kan, ẹbọ tí a fi iná ṣe, tí ó ní òórùn dídùn sí",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.13",
            "verseOrgIds": [
              "NUM.29.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "NUM.29.13",
                "verseOrgIds": [
                  "NUM.29.13"
                ]
              }
            }
          ]
        },
        {
          "text": ", ẹbọ tí ẹgbọrọ akọ màlúù mẹ́tàlá, àgbò méjì àti akọ ọ̀dọ́-àgùntàn mẹ́rìnlá tí ó jẹ́ ọdún kan, tí gbogbo rẹ̀ sì jẹ́ aláìlábùkù.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.13",
            "verseOrgIds": [
              "NUM.29.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 29:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àti ẹbọ ohun jíjẹ wọn, ìyẹ̀fun tí a fi òróró pò, ìdámẹ́wàá mẹ́ta òsùwọ̀n fún akọ màlúù kan, bẹ́ẹ̀ ni fún akọ màlúù mẹ́tẹ̀ẹ̀tàlá, ìdámẹ́wàá méjì òsùwọ̀n fún àgbò kan, bẹ́ẹ̀ ni fún àgbò méjèèjì,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.14",
            "verseOrgIds": [
              "NUM.29.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 29:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "àti fún ọ̀kọ̀ọ̀kan ọ̀dọ́-àgùntàn kan. Bẹ́ẹ̀ ni fún ọ̀dọ́-àgùntàn mẹ́rẹ̀ẹ̀rìnlá.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.15",
            "verseOrgIds": [
              "NUM.29.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 29:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àti akọ ewúrẹ́ kan gẹ́gẹ́ bí ẹbọ ẹ̀ṣẹ̀, pẹ̀lú ẹbọ sísun gbogbo ìgbà ẹbọ ohun jíjẹ àti ẹbọ ohun mímu rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.16",
            "verseOrgIds": [
              "NUM.29.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 29:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Àti ní ọjọ́ kejì ni kí ẹ̀yin kí ó fi ẹgbọrọ akọ màlúù méjìlá, àgbò méjì àti ọ̀dọ́-àgùntàn mẹ́rìnlá ọlọ́dún kan aláìlábùkù rú ẹbọ.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.17",
            "verseOrgIds": [
              "NUM.29.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 29:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pẹ̀lú fún akọ màlúù, fún àgbò, àti fún ọ̀dọ́-àgùntàn kí ẹ pe ẹbọ ohun jíjẹ, àti ẹbọ ohun mímu, kí ó jẹ́ bí iye wọn, gẹ́gẹ́ bí ìlànà.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.18",
            "verseOrgIds": [
              "NUM.29.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 29:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àti òbúkọ fún ẹbọ ẹ̀ṣẹ̀ pẹ̀lú ẹbọ sísun gbogbo ìgbà pẹ̀lú ẹbọ jíjẹ àti ẹbọ ohun mímu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.19",
            "verseOrgIds": [
              "NUM.29.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 29:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ní ọjọ́ kẹta, pèsè akọ màlúù mọ́kànlá, àgbò méjì, akọ àgùntàn mẹ́rìnlá ti ọdún kan tí kò ní àbùkù.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.20",
            "verseOrgIds": [
              "NUM.29.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 29:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pẹ̀lú akọ màlúù, àgbò, àti akọ àgùntàn, pèsè ọrẹ ohun jíjẹ àti ohun mímu gẹ́gẹ́ bí iye wọn.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.21",
            "verseOrgIds": [
              "NUM.29.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 29:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pẹ̀lú akọ ewúrẹ́ kan fún ẹbọ ẹ̀ṣẹ̀, àti ẹbọ sísun ìgbà gbogbo pẹ̀lú ẹbọ jíjẹ àti ẹbọ mímu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.22",
            "verseOrgIds": [
              "NUM.29.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
