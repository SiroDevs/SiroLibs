        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Wíwà ní mímọ́ ibùdó",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "NUM.5.1",
                "verseOrgIds": [
                  "NUM.5.1"
                ]
              }
            }
          ]
        },
        {
          "text": "sọ fún Mose pé,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.1",
            "verseOrgIds": [
              "NUM.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Pàṣẹ fún àwọn ọmọ Israẹli pé kí wọn ó lé ẹnikẹ́ni tó bá ní ẹ̀tẹ̀, ìtújáde ara ní oríṣìíríṣìí tàbí ẹni tó jẹ́ aláìmọ́ nípa fífọwọ́ kan òkú.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.2",
            "verseOrgIds": [
              "NUM.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Irú ẹni bẹ́ẹ̀ yálà ọkùnrin tàbí obìnrin, ẹ lé wọn jáde kúrò nínú ibùdó kí wọn má ba à ba ibùdó wọn jẹ́ níbi tí èmi ń gbé láàrín wọn.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.3",
            "verseOrgIds": [
              "NUM.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ọmọ Israẹli sì ṣe bẹ́ẹ̀; wọ́n lé wọn jáde kúrò nínú ibùdó. Wọn ṣe gẹ́gẹ́ bí",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.4",
            "verseOrgIds": [
              "NUM.5.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "NUM.5.4",
                "verseOrgIds": [
                  "NUM.5.4"
                ]
              }
            }
          ]
        },
        {
          "text": "ti sọ fún Mose.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.4",
            "verseOrgIds": [
              "NUM.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìjẹ́wọ́ àti àtúnṣe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "NUM.5.5",
                "verseOrgIds": [
                  "NUM.5.5"
                ]
              }
            }
          ]
        },
        {
          "text": "sọ fún Mose pé,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.5",
            "verseOrgIds": [
              "NUM.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Sọ fún àwọn ọmọ Israẹli: 'Nígbà tí ọkùnrin kan tàbí obìnrin kan bá ṣẹ̀ ara wọn lọ́nà kan tàbí òmíràn, tí wọ́n sì ṣe àìṣòótọ́ sí",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.6",
            "verseOrgIds": [
              "NUM.5.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "NUM.5.6",
                "verseOrgIds": [
                  "NUM.5.6"
                ]
              }
            }
          ]
        },
        {
          "text": ", ẹni náà jẹ̀bi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.6",
            "verseOrgIds": [
              "NUM.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó gbọdọ̀ jẹ́wọ́ ẹ̀ṣẹ̀ tí ó sẹ̀. Ó gbọdọ̀ san ẹ̀san rẹ̀ ní ojú owó, kí ó sì fi ìdámárùn-ún rẹ̀ lé e, kí ó sì fi fún ẹni tí òun jẹ̀bi rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.7",
            "verseOrgIds": [
              "NUM.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n bí irú ẹni bẹ́ẹ̀ kò bá ní ìbátan tí ó súnmọ́ ọn tí ó lè ṣe àtúnṣe àṣìṣe rẹ̀ náà fún, àtúnṣe náà jẹ́ ti",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.8",
            "verseOrgIds": [
              "NUM.5.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "NUM.5.8",
                "verseOrgIds": [
                  "NUM.5.8"
                ]
              }
            }
          ]
        },
        {
          "text": ", ẹ sì gbọdọ̀ ko fún àlùfáà pẹ̀lú àgbò tí a fi ṣe ètùtù fún ẹni náà.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.8",
            "verseOrgIds": [
              "NUM.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo ọrẹ ohun mímọ́ tí àwọn ọmọ Israẹli bá mú wá fún àlùfáà jẹ́ tirẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.9",
            "verseOrgIds": [
              "NUM.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọrẹ ohun mímọ́ ẹnìkọ̀ọ̀kan jẹ́ ti òun nìkan, ṣùgbọ́n ohunkóhun tó bá fún àlùfáà yóò jẹ́ ti àlùfáà.' \"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.10",
            "verseOrgIds": [
              "NUM.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Àyẹ̀wò fún aláìṣòótọ́ ìyàwó",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "NUM.5.11",
                "verseOrgIds": [
                  "NUM.5.11"
                ]
              }
            }
          ]
        },
        {
          "text": "sọ fún Mose wí pé,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.11",
            "verseOrgIds": [
              "NUM.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Bá àwọn ọmọ Israẹli sọ̀rọ̀ kí o sọ fún wọn pé, 'Bí ìyàwó ọkùnrin kan bá yapa tó sì ṣe àìṣòótọ́ sí i,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.12",
            "verseOrgIds": [
              "NUM.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "nípa mímú kí ọkùnrin mìíràn bá a lòpọ̀ tí ó sì fi èyí pamọ́ fún ọkọ rẹ̀, tí a kò si gbá a mú nínú ìwà àìmọ́ rẹ̀ (nítorí pé kò sí ẹlẹ́rìí àti pé wọn kò ká a mọ́ nígbà tí ó ń dẹ́ṣẹ̀ náà).",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.13",
            "verseOrgIds": [
              "NUM.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n tí ẹ̀mí owú jíjẹ bá bà lé ọkọ rẹ̀ dé bi pé ó ń funra sí ìyàwó rẹ̀ yìí tí ìyàwó rẹ̀ sì wà ní àìmọ́ nítòótọ́, tàbí tí ẹ̀mí owú bá bà lé ọkùnrin kan tó sì ń jowú ìyàwó rẹ̀ bí ó tilẹ̀ jẹ́ pé ó wà ní mímọ́,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.14",
            "verseOrgIds": [
              "NUM.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "nígbà náà ni ọkùnrin yìí yóò mú ìyàwó rẹ̀ lọ sọ́dọ̀ àlùfáà. Ọkùnrin náà yóò sì mú ọrẹ tí a yàn fún obìnrin náà, ìdámẹ́wàá òsùwọ̀n efa ìyẹ̀fun barle. Kò gbọdọ̀ da òróró sí i, bẹ́ẹ̀ ni kò gbọdọ̀ fi tùràrí dídùn sí i nítorí pé ẹbọ ohun jíjẹ fún owú ni, èyí ti n mú ẹ̀ṣẹ̀ wá sí ìrántí.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.15",
            "verseOrgIds": [
              "NUM.5.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Àlùfáà yóò sì mú un wá síwájú",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.16",
            "verseOrgIds": [
              "NUM.5.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "NUM.5.16",
                "verseOrgIds": [
                  "NUM.5.16"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.16",
            "verseOrgIds": [
              "NUM.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àlùfáà yóò sì bu erùpẹ̀ ilẹ̀ àgọ́ sínú omi mímọ́ tó bù láti ìkòkò amọ̀.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.17",
            "verseOrgIds": [
              "NUM.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lẹ́yìn èyí, àlùfáà yóò mú obìnrin náà dúró níwájú",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.18",
            "verseOrgIds": [
              "NUM.5.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "NUM.5.18",
                "verseOrgIds": [
                  "NUM.5.18"
                ]
              }
            }
          ]
        },
        {
          "text": "yóò sì tú irun orí obìnrin náà lé e lọ́wọ́, èyí ni ẹbọ ohun jíjẹ ti owú, àlùfáà fúnra rẹ̀ yóò sì gbé omi kíkorò tí ń mú ègún lọ́wọ́.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.18",
            "verseOrgIds": [
              "NUM.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àlùfáà yóò sì mú obìnrin náà búra, yóò wí pé, \"Bí ọkùnrin mìíràn kò bá bá ọ lòpọ̀, tí ó kò sì yapa, tí o kò sì di aláìmọ́ níwọ̀n ìgbà tí ó wà lábẹ́ àṣẹ ọkọ rẹ̀, a jẹ́ pé omi kíkorò tí ń mú ègún wá yìí kò ní ṣe ọ́ níbi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.19",
            "verseOrgIds": [
              "NUM.5.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n tí ìwọ bá ti yapa kúrò lọ́dọ̀ ọkọ rẹ, tí o bá ti ba ara rẹ jẹ́ nípa jíjẹ́ kí ọkùnrin tí kì í ṣe ọkọ rẹ bá ọ lòpọ̀,\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.20",
            "verseOrgIds": [
              "NUM.5.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "nígbà náà ni àlùfáà yóò mú obìnrin náà búra, yóò sọ fún obìnrin náà pé, \"Kí",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.21",
            "verseOrgIds": [
              "NUM.5.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "NUM.5.21",
                "verseOrgIds": [
                  "NUM.5.21"
                ]
              }
            }
          ]
        },
        {
          "text": "sọ ọ́ di ẹni ègún àti ẹni ìbáwí láàrín àwọn ènìyàn rẹ nípa mímú kí itan rẹ jẹrà, kí ikùn rẹ̀ sì wú.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.21",
            "verseOrgIds": [
              "NUM.5.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 5:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ǹjẹ́ kí omi yìí tí ń mú ègún wá wọ inú ara rẹ, kí ó mú ikùn rẹ̀ wú, kí ó sì mú itan rẹ̀ jẹrà dànù.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.22",
            "verseOrgIds": [
              "NUM.5.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "NUM 5:22"
      },
      "items": [
        {
          "text": "\" 'Obìnrin náà yóò sì wí pé, \"Àmín. Bẹ́ẹ̀ ni kó rí.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.22",
            "verseOrgIds": [
              "NUM.5.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 5:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Nígbà náà ni àlùfáà yóò kọ ègún yìí sínú ìwé kíká, yóò sì sìn ín sínú omi kíkorò náà.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.23",
            "verseOrgIds": [
              "NUM.5.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 5:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àlùfáà yóò sì mú kí obìnrin náà mu omi kíkorò tí ń mú ègún wá yìí, omi náà yóò wọ inú rẹ̀ yóò sì fa ìrora kíkorò fún obìnrin náà bí ó bá jẹ̀bi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.24",
            "verseOrgIds": [
              "NUM.5.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 5:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àlùfáà yóò gba ọrẹ ohun jíjẹ owú náà lọ́wọ́ rẹ̀, yóò fì í síwájú",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.25",
            "verseOrgIds": [
              "NUM.5.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "NUM.5.25",
                "verseOrgIds": [
                  "NUM.5.25"
                ]
              }
            }
          ]
        },
        {
          "text": ", yóò sì mú iná sórí pẹpẹ.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.25",
            "verseOrgIds": [
              "NUM.5.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 5:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àlùfáà yóò bu ẹ̀kúnwọ́ kan nínú ọrẹ ohun jíjẹ náà, yóò sun ún lórí pẹpẹ gẹ́gẹ́ bí ẹbọ ìrántí lẹ́yìn tí ó ti mú kí obìnrin náà mu omi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.26",
            "verseOrgIds": [
              "NUM.5.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 5:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ó bá ti mú obìnrin yìí mu omi náà, bí ó bá sì jẹ́ pé obìnrin náà ti ba ara rẹ̀ jẹ́, tí ó sì ṣe àìṣòótọ́ sí ọkọ rẹ̀, omi tí ń mú ègún wá, yóò wọ ara rẹ̀, yóò fa ìrora kíkorò fún un, ikùn rẹ̀ yóò wú, itan rẹ̀ yóò sì jẹrà dànù, yóò sì di ẹni ègún láàrín àwọn ènìyàn rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.27",
            "verseOrgIds": [
              "NUM.5.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 5:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n tó bá jẹ́ pé obìnrin náà kò ba ara rẹ̀ jẹ́, tó sì jẹ́ mímọ́, yóò bọ́ nínú ẹ̀bi, yóò sì le bímọ.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.28",
            "verseOrgIds": [
              "NUM.5.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 5:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Èyí ni òfin owú jíjẹ nígbà tí obìnrin tó wà lábẹ́ ọkọ bá ṣe a ṣe má ṣe, tí ó bá ba ara rẹ̀ jẹ́,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.29",
            "verseOrgIds": [
              "NUM.5.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 5:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "tàbí nígbà tí ẹ̀mí owú jíjẹ bá bà lé ọkùnrin kan nítorí pé ó funra sí ìyàwó rẹ̀. Àlùfáà yóò mú obìnrin náà dúró níwájú",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.30",
            "verseOrgIds": [
              "NUM.5.30"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "NUM.5.30",
                "verseOrgIds": [
                  "NUM.5.30"
                ]
              }
            }
          ]
        },
        {
          "text": "yóò sì ṣe gẹ́gẹ́ bí òfin ti wí fún un.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.30",
            "verseOrgIds": [
              "NUM.5.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NUM 5:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ara ọkọ rẹ̀ mọ́ nínú ẹ̀ṣẹ̀ yìí ṣùgbọ́n obìnrin náà yóò ru ẹ̀bi ẹ̀ṣẹ̀ rẹ̀.' \"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.31",
            "verseOrgIds": [
              "NUM.5.31"
            ]
          }
        }
      ]
    }
  ],
