      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 60:17"
      },
      "items": [
        {
          "text": "àti òdodo gẹ́gẹ́ bí alákòóso rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.17",
            "verseOrgIds": [
              "ISA.60.17"
            ]
          }
        }
      ]
