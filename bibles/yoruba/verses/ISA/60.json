      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 60:11"
      },
      "items": [
        {
          "text": "tí àwọn ọba wọn yóò ṣáájú ní ọ̀wọ̀ọ̀wọ́ ìṣẹ́gun.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.11",
            "verseOrgIds": [
              "ISA.60.11"
            ]
          }
        }
      ]
    },
    {
