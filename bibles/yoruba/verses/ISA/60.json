          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dípò idẹ, èmi ó mú wúrà wá fún ọ,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.17",
            "verseOrgIds": [
              "ISA.60.17"
            ]
          }
        }
      ]
    },
