              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "A kì yóò gbọ́ nípa rògbòdìyàn ní ilẹ̀ rẹ mọ́,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.18",
            "verseOrgIds": [
              "ISA.60.18"
