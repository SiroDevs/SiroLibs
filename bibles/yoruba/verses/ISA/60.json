  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "60",
        "style": "c",
        "sid": "ISA 60"
      },
      "items": [
        {
          "text": "60",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ògo Sioni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 60:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Dìde, tànmọ́lẹ̀, nítorí ìmọ́lẹ̀ rẹ ti dé,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.1",
            "verseOrgIds": [
              "ISA.60.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 60:1"
      },
      "items": [
        {
          "text": "ògo",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.1",
            "verseOrgIds": [
              "ISA.60.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "ISA.60.1",
                "verseOrgIds": [
                  "ISA.60.1"
                ]
              }
            }
          ]
        },
        {
          "text": "sì ràdàbò ọ́.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.1",
            "verseOrgIds": [
              "ISA.60.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 60:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kíyèsi i, òkùnkùn bo ilẹ̀ ayé",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.2",
            "verseOrgIds": [
              "ISA.60.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 60:2"
      },
      "items": [
        {
          "text": "òkùnkùn biribiri sì wà lórí àwọn ènìyàn,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.2",
            "verseOrgIds": [
              "ISA.60.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 60:2"
      },
      "items": [
        {
          "text": "ṣùgbọ́n",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.2",
            "verseOrgIds": [
              "ISA.60.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "ISA.60.2",
                "verseOrgIds": [
                  "ISA.60.2"
                ]
              }
            }
          ]
        },
        {
          "text": "ràn bò ọ́",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.2",
            "verseOrgIds": [
              "ISA.60.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 60:2"
      },
      "items": [
        {
          "text": "ògo rẹ̀ sì farahàn lórí i rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.2",
            "verseOrgIds": [
              "ISA.60.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 60:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn orílẹ̀-èdè yóò wá sí ìmọ́lẹ̀ rẹ,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.3",
            "verseOrgIds": [
              "ISA.60.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 60:3"
      },
      "items": [
        {
          "text": "àti àwọn ọba sí ìmọ́lẹ̀ òwúrọ̀ rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.3",
            "verseOrgIds": [
              "ISA.60.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 60:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Gbé ojú rẹ sókè, kí o sì wò.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.4",
            "verseOrgIds": [
              "ISA.60.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 60:4"
      },
      "items": [
        {
          "text": "Gbogbo wọn ṣa ara jọ pọ̀, wọ́n sì wá sọ́dọ̀ rẹ;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.4",
            "verseOrgIds": [
              "ISA.60.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 60:4"
      },
      "items": [
        {
          "text": "àwọn ọmọ rẹ ọkùnrin yóò wá láti ọ̀nà jíjìn,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.4",
            "verseOrgIds": [
              "ISA.60.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 60:4"
      },
      "items": [
        {
          "text": "àwọn ọmọ rẹ obìnrin ni a ó tọ́jú ní ẹ̀gbẹ́ rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.4",
            "verseOrgIds": [
              "ISA.60.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 60:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni ìwọ yóò wò tí ojú rẹ yóò máa dán,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.5",
            "verseOrgIds": [
              "ISA.60.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 60:5"
      },
      "items": [
        {
          "text": "ọkàn rẹ yó fò, yó sì kún fún ayọ̀;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.5",
            "verseOrgIds": [
              "ISA.60.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 60:5"
      },
      "items": [
        {
          "text": "ọrọ̀ inú Òkun ni a ó kò wá sọ́dọ̀ rẹ,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.5",
            "verseOrgIds": [
              "ISA.60.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 60:5"
      },
      "items": [
        {
          "text": "sí ọ̀dọ̀ rẹ ni ọrọ̀ àwọn orílẹ̀-èdè yóò wá.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.5",
            "verseOrgIds": [
              "ISA.60.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 60:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ̀wọ́ ìbákasẹ yóò bo gbogbo ilẹ̀ rẹ,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.6",
            "verseOrgIds": [
              "ISA.60.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 60:6"
      },
      "items": [
        {
          "text": "àwọn ọ̀dọ́ ìbákasẹ Midiani àti Efani.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.6",
            "verseOrgIds": [
              "ISA.60.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 60:6"
      },
      "items": [
        {
          "text": "Àti gbogbo wọn láti Ṣeba yóò wá,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.6",
            "verseOrgIds": [
              "ISA.60.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 60:6"
      },
      "items": [
        {
          "text": "wọn yóò mú wúrà àti tùràrí lọ́wọ́",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.6",
            "verseOrgIds": [
              "ISA.60.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 60:6"
      },
      "items": [
        {
          "text": "tí wọn yóò sì máa kéde ìyìn",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.6",
            "verseOrgIds": [
              "ISA.60.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "ISA.60.6",
                "verseOrgIds": [
                  "ISA.60.6"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.6",
            "verseOrgIds": [
              "ISA.60.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 60:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo agbo ẹran ìlú Kedari ni a ó kójọ sọ́dọ̀ rẹ,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.7",
            "verseOrgIds": [
              "ISA.60.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 60:7"
      },
      "items": [
        {
          "text": "àwọn àgbò ti Nebaioti yóò sìn ọ́;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.7",
            "verseOrgIds": [
              "ISA.60.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 60:7"
      },
      "items": [
        {
          "text": "wọn yóò jẹ́ ọrẹ ìtẹ́wọ́gbà lórí i pẹpẹ mi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.7",
            "verseOrgIds": [
              "ISA.60.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 60:7"
      },
      "items": [
        {
          "text": "bẹ́ẹ̀ ni n ó sì ṣe tẹmpili ògo mi lọ́ṣọ̀ọ́.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.7",
            "verseOrgIds": [
              "ISA.60.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 60:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ta ni àwọn wọ̀nyí tí ń fò lọ bí i kurukuru,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.8",
            "verseOrgIds": [
              "ISA.60.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 60:8"
      },
      "items": [
        {
          "text": "gẹ́gẹ́ bí àwọn àdàbà sí ìtẹ́ wọn?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.8",
            "verseOrgIds": [
              "ISA.60.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 60:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lóòtítọ́ àwọn erékùṣù bojú wò mí;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.9",
            "verseOrgIds": [
              "ISA.60.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 60:9"
      },
      "items": [
        {
          "text": "ní ìṣíwájú ni àwọn ọkọ̀ ojú omi Tarṣiṣi;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.9",
            "verseOrgIds": [
              "ISA.60.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 60:9"
      },
      "items": [
        {
          "text": "mú àwọn ọmọkùnrin rẹ̀ wá láti ọ̀nà jíjìn,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.9",
            "verseOrgIds": [
              "ISA.60.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 60:9"
      },
      "items": [
        {
          "text": "pẹ̀lú fàdákà àti wúrà wọn,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.9",
            "verseOrgIds": [
              "ISA.60.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 60:9"
      },
      "items": [
        {
          "text": "fún ti ọlá",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.9",
            "verseOrgIds": [
              "ISA.60.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "ISA.60.9",
                "verseOrgIds": [
                  "ISA.60.9"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run rẹ,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.9",
            "verseOrgIds": [
              "ISA.60.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 60:9"
      },
      "items": [
        {
          "text": "Ẹni Mímọ́ Israẹli,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.9",
            "verseOrgIds": [
              "ISA.60.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 60:9"
      },
      "items": [
        {
          "text": "nítorí òun ti fi ohun dídára ṣe ó lọ́ṣọ̀ọ́.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.9",
            "verseOrgIds": [
              "ISA.60.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
