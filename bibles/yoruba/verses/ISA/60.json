          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí pé orílẹ̀-èdè tàbí ilẹ̀ ọba tí kì yóò sìn ọ́ ni yóò parun;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.12",
            "verseOrgIds": [
