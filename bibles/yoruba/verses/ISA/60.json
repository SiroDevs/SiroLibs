      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 60:11"
      },
      "items": [
        {
          "text": "a kì yóò tì wọ́n ní ọ̀sán àti ní òru,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.11",
            "verseOrgIds": [
              "ISA.60.11"
            ]
          }
        }
      ]
