      "attrs": {
        "style": "q2",
        "vid": "ISA 60:11"
      },
      "items": [
        {
          "text": "ọrọ̀ àwọn orílẹ̀-èdè wá",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.11",
            "verseOrgIds": [
              "ISA.60.11"
            ]
          }
        }
      ]
    },
    {
