      "attrs": {
        "style": "q2",
        "vid": "ISA 60:12"
      },
      "items": [
        {
          "text": "pátápátá ni yóò sì dahoro.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.12",
            "verseOrgIds": [
              "ISA.60.12"
            ]
