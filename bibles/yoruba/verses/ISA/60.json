      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 60:17"
      },
      "items": [
        {
          "text": "dípò fàdákà èmi ó mú irin wá. Dípò igi yóò mú idẹ wá fún ọ,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.17",
            "verseOrgIds": [
              "ISA.60.17"
            ]
          }
        }
      ]
    },
