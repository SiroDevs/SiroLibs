      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 60:18"
      },
      "items": [
        {
          "text": "tàbí ìdahoro àti ìparun nínú agbègbè rẹ,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.18",
            "verseOrgIds": [
              "ISA.60.18"
            ]
          }
