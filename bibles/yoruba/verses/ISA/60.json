      "attrs": {
        "style": "q2",
        "vid": "ISA 60:15"
      },
      "items": [
        {
          "text": "láìsí ẹnìkan tí ó ń gba ọ̀dọ̀ rẹ kọjá,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.15",
            "verseOrgIds": [
