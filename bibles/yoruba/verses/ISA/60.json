            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo ẹnu-bodè rẹ ni yóò wà ní ṣíṣí sílẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.11",
            "verseOrgIds": [
              "ISA.60.11"
            ]
          }
