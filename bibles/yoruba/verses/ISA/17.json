  "verseCount": 14,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "17",
        "style": "c",
        "sid": "ISA 17"
      },
      "items": [
        {
          "text": "17",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ọ̀rọ̀-ìmọ̀ ní ti Damasku",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ̀rọ̀-ìmọ̀ tí ó kan Damasku:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.1",
            "verseOrgIds": [
              "ISA.17.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 17:1"
      },
      "items": [
        {
          "text": "\"Kíyèsi i, Damasku kò ní jẹ́ ìlú mọ́",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.1",
            "verseOrgIds": [
              "ISA.17.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 17:1"
      },
      "items": [
        {
          "text": "ṣùgbọ́n yóò padà di ààtàn.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.1",
            "verseOrgIds": [
              "ISA.17.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ìlú Aroeri ni a ó kọ̀sílẹ̀",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.2",
            "verseOrgIds": [
              "ISA.17.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 17:2"
      },
      "items": [
        {
          "text": "fún àwọn agbo ẹran tí yóò máa sùn síbẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.2",
            "verseOrgIds": [
              "ISA.17.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 17:2"
      },
      "items": [
        {
          "text": "láìsí ẹni tí yóò dẹ́rùbà wọ́n.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.2",
            "verseOrgIds": [
              "ISA.17.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìlú olódi ni yóò pòórá kúrò ní Efraimu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.3",
            "verseOrgIds": [
              "ISA.17.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 17:3"
      },
      "items": [
        {
          "text": "àti agbára ọba kúrò ní Damasku;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.3",
            "verseOrgIds": [
              "ISA.17.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 17:3"
      },
      "items": [
        {
          "text": "àwọn àṣẹ́kù Aramu yóò dá",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.3",
            "verseOrgIds": [
              "ISA.17.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 17:3"
      },
      "items": [
        {
          "text": "gẹ́gẹ́ bí ògo ti àwọn Israẹli,\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.3",
            "verseOrgIds": [
              "ISA.17.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 17:3"
      },
      "items": [
        {
          "text": "ni",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.3",
            "verseOrgIds": [
              "ISA.17.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "ISA.17.3",
                "verseOrgIds": [
                  "ISA.17.3"
                ]
              }
            }
          ]
        },
        {
          "text": "àwọn ọmọ-ogun wí.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.3",
            "verseOrgIds": [
              "ISA.17.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ní ọjọ́ náà ni ògo Jakọbu yóò sá;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.4",
            "verseOrgIds": [
              "ISA.17.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 17:4"
      },
      "items": [
        {
          "text": "ọ̀rá ara rẹ̀ yóò ṣòfò dànù.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.4",
            "verseOrgIds": [
              "ISA.17.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yóò sì dàbí ìgbà tí olùkórè kó àwọn",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.5",
            "verseOrgIds": [
              "ISA.17.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 17:5"
      },
      "items": [
        {
          "text": "irúgbìn tí ó dúró jọ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.5",
            "verseOrgIds": [
              "ISA.17.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 17:5"
      },
      "items": [
        {
          "text": "tí ó sì ń kórè irúgbìn pẹ̀lú apá rẹ̀—",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.5",
            "verseOrgIds": [
              "ISA.17.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 17:5"
      },
      "items": [
        {
          "text": "àti gẹ́gẹ́ bí ìgbà tí ènìyàn pa ọkà ní àfonífojì ti Refaimu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.5",
            "verseOrgIds": [
              "ISA.17.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Síbẹ̀síbẹ̀ irúgbìn díẹ̀ yóò ṣẹ́kù,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.6",
            "verseOrgIds": [
              "ISA.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 17:6"
      },
      "items": [
        {
          "text": "gẹ́gẹ́ bí ìgbà tí a gbọn igi olifi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.6",
            "verseOrgIds": [
              "ISA.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 17:6"
      },
      "items": [
        {
          "text": "tí èso olifi méjì tàbí mẹ́ta ṣẹ́kù",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.6",
            "verseOrgIds": [
              "ISA.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 17:6"
      },
      "items": [
        {
          "text": "sórí ẹ̀ka tí ó ga jùlọ,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.6",
            "verseOrgIds": [
              "ISA.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 17:6"
      },
      "items": [
        {
          "text": "mẹ́rin tàbí márùn-ún lórí ẹ̀ka tí ó so jù,\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.6",
            "verseOrgIds": [
              "ISA.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 17:6"
      },
      "items": [
        {
          "text": "ni",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.6",
            "verseOrgIds": [
              "ISA.17.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "ISA.17.6",
                "verseOrgIds": [
                  "ISA.17.6"
                ]
              }
            }
          ]
        },
        {
          "text": "wí, àní Ọlọ́run Israẹli.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.6",
            "verseOrgIds": [
              "ISA.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọjọ́ náà, àwọn ènìyàn yóò gbójú sókè sí Ẹlẹ́dàá wọn,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.7",
            "verseOrgIds": [
              "ISA.17.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 17:7"
      },
      "items": [
        {
          "text": "wọn yóò sì síjú wo Ẹni Mímọ́ Israẹli.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.7",
            "verseOrgIds": [
              "ISA.17.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọn kò ní wo àwọn pẹpẹ mọ́,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.8",
            "verseOrgIds": [
              "ISA.17.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 17:8"
      },
      "items": [
        {
          "text": "èyí tí í ṣe iṣẹ́ ọwọ́ wọn,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.8",
            "verseOrgIds": [
              "ISA.17.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 17:8"
      },
      "items": [
        {
          "text": "wọn kò sì ní kọbi ara sí ère Aṣerah mọ́",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.8",
            "verseOrgIds": [
              "ISA.17.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 17:8"
      },
      "items": [
        {
          "text": "tàbí pẹpẹ tùràrí tí ìka ọwọ́ wọn ti ṣe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.8",
            "verseOrgIds": [
              "ISA.17.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọjọ́ náà àwọn ìlú alágbára rẹ̀, yóò dàbí ẹ̀ka ìkọ̀sílẹ̀, àti ẹ̀ka téńté òkè tí wọ́n fi sílẹ̀ nítorí àwọn ọmọ Israẹli. Gbogbo wọn yóò sì di ahoro.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.9",
            "verseOrgIds": [
              "ISA.17.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí ìwọ ti gbàgbé Ọlọ́run ìgbàlà rẹ;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.10",
            "verseOrgIds": [
              "ISA.17.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 17:10"
      },
      "items": [
        {
          "text": "tí ìwọ kò sì náání àpáta ìgbàlà rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.10",
            "verseOrgIds": [
              "ISA.17.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 17:10"
      },
      "items": [
        {
          "text": "nítorí náà ni ìwọ ti gbin ọ̀gbìn dáradára",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.10",
            "verseOrgIds": [
              "ISA.17.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 17:10"
      },
      "items": [
        {
          "text": "ìwọ sì tọ́ àjèjì ẹ̀ka sínú rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.10",
            "verseOrgIds": [
              "ISA.17.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà, bí ẹ tilẹ̀ mú àṣàyàn igi tí ẹ sì gbin àjàrà tí ó ti òkèrè wá,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.11",
            "verseOrgIds": [
              "ISA.17.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
