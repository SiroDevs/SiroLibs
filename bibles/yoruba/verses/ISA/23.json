      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:12"
      },
      "items": [
        {
          "text": "ìwọ wúńdíá ti Sidoni, tí a ti tẹ̀ mọ́lẹ̀ báyìí!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.12",
            "verseOrgIds": [
              "ISA.23.12"
            ]
