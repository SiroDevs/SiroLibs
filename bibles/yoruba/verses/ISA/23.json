          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní àkókò náà a ó gbàgbé Tire fún àádọ́rin ọdún, ọjọ́ ayé ọba kan. Ṣùgbọ́n ní òpin àádọ́rin ọdún wọ̀nyí, yóò ṣẹlẹ̀ sí Tire gẹ́gẹ́ bí orin àgbèrè:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.15",
            "verseOrgIds": [
              "ISA.23.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
