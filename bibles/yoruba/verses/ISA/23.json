              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó wí pé, \"Kò sí àríyá fún ọ mọ́,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.12",
            "verseOrgIds": [
              "ISA.23.12"
            ]
          }
