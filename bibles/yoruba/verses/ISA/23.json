      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 23:11"
      },
      "items": [
        {
          "text": "Ó ti pa àṣẹ kan tí ó kan Kenaani",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.11",
            "verseOrgIds": [
              "ISA.23.11"
