              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi dún gẹ́gẹ́ bí àkọ̀ tàbí alápáǹdẹ̀dẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.14",
            "verseOrgIds": [
              "ISA.38.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 38:14"
      },
      "items": [
        {
          "text": "èmi káàánú gẹ́gẹ́ bí aṣọ̀fọ̀ àdàbà.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.14",
            "verseOrgIds": [
              "ISA.38.14"
            ]
          }
        }
      ]
    },
    {
