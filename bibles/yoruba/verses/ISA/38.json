      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 38:15"
      },
      "items": [
        {
          "text": "Èmi yóò máa rìn ní ìrẹ̀lẹ̀ ní gbogbo ọjọ́ mi",
