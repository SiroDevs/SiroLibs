      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 38:14"
      },
      "items": [
        {
          "text": "Ojú mi rẹ̀wẹ̀sì gẹ́gẹ́ bí mo ti ń wo àwọn ọ̀run.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.14",
            "verseOrgIds": [
