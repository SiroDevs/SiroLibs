          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hesekiah sì béèrè pé, \"Kí ni yóò jẹ́ àmì pé èmi yóò gòkè lọ sí tẹmpili",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.22",
            "verseOrgIds": [
              "ISA.38.22"
            ]
          }
        },
