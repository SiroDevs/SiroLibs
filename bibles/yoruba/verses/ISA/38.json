        {
          "text": "Isaiah ti sọ pé, \"Pèsè ìṣù ọ̀pọ̀tọ́ (ohun gbígbóná tí a dì mọ́ ojú egbò) kí o sì fi sí ojú oówo náà, òun yóò sì gbádùn.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.21",
            "verseOrgIds": [
              "ISA.38.21"
            ]
          }
        }
      ]
    },
