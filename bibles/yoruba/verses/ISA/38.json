                "verseId": "ISA.38.22",
                "verseOrgIds": [
                  "ISA.38.22"
                ]
              }
            }
          ]
        },
        {
          "text": "?\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.22",
            "verseOrgIds": [
