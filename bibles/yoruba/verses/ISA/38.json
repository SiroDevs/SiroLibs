  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "38",
        "style": "c",
        "sid": "ISA 38"
      },
      "items": [
        {
          "text": "38",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Àìsàn Hesekiah",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 38:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọjọ́ náà ni Hesekiah ṣe àìsàn dé ojú ikú. Wòlíì Isaiah ọmọ Amosi sì lọ sí ọ̀dọ̀ rẹ̀, ó sì wí pé, \"Ohun tí",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.1",
            "verseOrgIds": [
              "ISA.38.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "ISA.38.1",
                "verseOrgIds": [
                  "ISA.38.1"
                ]
              }
            }
          ]
        },
        {
          "text": "wí nìyìí: Palẹ̀ ilé è rẹ mọ́, bí ó ti yẹ nítorí pé ìwọ yóò kú; ìwọ kì yóò dìde àìsàn yìí.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.1",
            "verseOrgIds": [
              "ISA.38.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 38:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hesekiah yí ojú u rẹ̀ sí ara ògiri, ó sì gba àdúrà sí",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.2",
            "verseOrgIds": [
              "ISA.38.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "ISA.38.2",
                "verseOrgIds": [
                  "ISA.38.2"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.2",
            "verseOrgIds": [
              "ISA.38.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 38:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Rántí, Ìwọ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.3",
            "verseOrgIds": [
              "ISA.38.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "ISA.38.3",
                "verseOrgIds": [
                  "ISA.38.3"
                ]
              }
            }
          ]
        },
        {
          "text": ", bí mo ti rìn pẹ̀lú òtítọ́ níwájú rẹ, àti bí mo ti fi ọkàn dídúró ṣinṣin ṣe ohun tí ó dára ní ojú ù rẹ.\" Bẹ́ẹ̀ ni Hesekiah sì sọkún kíkorò.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.3",
            "verseOrgIds": [
              "ISA.38.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 38:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lẹ́yìn náà ni ọ̀rọ̀",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.4",
            "verseOrgIds": [
              "ISA.38.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "ISA.38.4",
                "verseOrgIds": [
                  "ISA.38.4"
                ]
              }
            }
          ]
        },
        {
          "text": "tọ Isaiah wá pé,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.4",
            "verseOrgIds": [
              "ISA.38.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 38:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Lọ kí o sì sọ fún Hesekiah pé, 'Ohun tí",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.5",
            "verseOrgIds": [
              "ISA.38.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "ISA.38.5",
                "verseOrgIds": [
                  "ISA.38.5"
                ]
              }
            }
          ]
        },
        {
          "text": "wí nìyìí, Ọlọ́run Dafidi baba rẹ sọ pé, Èmi ti gbọ́ àdúrà rẹ mo sì ti rí omijé rẹ, Èmi yóò fi ọdún mẹ́ẹ̀ẹ́dógún kún ọjọ́ ayé rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.5",
            "verseOrgIds": [
              "ISA.38.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 38:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò sì gba ìwọ àti ìlú yìí sílẹ̀ kúrò lọ́wọ́ ọba Asiria. Èmi yóò sì dáàbò bo ìlú yìí.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.6",
            "verseOrgIds": [
              "ISA.38.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 38:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Èyí yìí ni àmì tí",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.7",
            "verseOrgIds": [
              "ISA.38.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "ISA.38.7",
                "verseOrgIds": [
                  "ISA.38.7"
                ]
              }
            }
          ]
        },
        {
          "text": "fún ọ láti fihàn wí pé",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.7",
            "verseOrgIds": [
              "ISA.38.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "ISA.38.7",
                "verseOrgIds": [
                  "ISA.38.7"
                ]
              }
            }
          ]
        },
        {
          "text": "yóò mú ìpinnu rẹ̀ ṣẹ.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.7",
            "verseOrgIds": [
              "ISA.38.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 38:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò mú òjìji oòrùn kí ó padà sẹ́yìn ní ìṣísẹ̀ mẹ́wàá nínú èyí tí ó fi sọ̀kalẹ̀ ní ibi àtẹ̀gùn ti Ahasi.' \" Bẹ́ẹ̀ ni oòrùn padà sẹ́yìn ní ìṣísẹ̀ mẹ́wàá sí ibi tí ó ti dé tẹ́lẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.8",
            "verseOrgIds": [
              "ISA.38.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 38:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwé tí Hesekiah ọba Juda kọ lẹ́yìn àìsàn rẹ̀ nígbà tí ó ti gbádùn tán.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.9",
            "verseOrgIds": [
              "ISA.38.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 38:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi wí pé, \"Ní àárín gbùngbùn ọjọ́ ayé mi",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.10",
            "verseOrgIds": [
              "ISA.38.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 38:10"
      },
      "items": [
        {
          "text": "èmi ó ha kọjá lọ ní ibodè ikú",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.10",
            "verseOrgIds": [
              "ISA.38.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 38:10"
      },
      "items": [
        {
          "text": "kí a sì dùn mí ní àwọn ọdún mi tí ó ṣẹ́kù?\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.10",
            "verseOrgIds": [
              "ISA.38.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 38:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi wí pé, \"Èmi kì yóò lè tún rí",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.11",
            "verseOrgIds": [
              "ISA.38.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "ISA.38.11",
                "verseOrgIds": [
                  "ISA.38.11"
                ]
              }
            }
          ]
        },
        {
          "text": "mọ́,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.11",
            "verseOrgIds": [
              "ISA.38.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 38:11"
      },
      "items": [
        {
          "text": "àní",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.11",
            "verseOrgIds": [
              "ISA.38.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "ISA.38.11",
                "verseOrgIds": [
                  "ISA.38.11"
                ]
              }
            }
          ]
        },
        {
          "text": ", ní ilẹ̀ àwọn alààyè;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.11",
            "verseOrgIds": [
              "ISA.38.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 38:11"
      },
      "items": [
        {
          "text": "èmi kì yóò lè síjú wo ọmọ ènìyàn mọ́,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.11",
            "verseOrgIds": [
              "ISA.38.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 38:11"
      },
      "items": [
        {
          "text": "tàbí kí n wà pẹ̀lú àwọn tí ó sì ń",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.11",
            "verseOrgIds": [
              "ISA.38.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 38:11"
      },
      "items": [
        {
          "text": "gbe orílẹ̀ ayé báyìí.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.11",
            "verseOrgIds": [
              "ISA.38.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 38:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gẹ́gẹ́ bí àgọ́ olùṣọ́-àgùntàn,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.12",
            "verseOrgIds": [
              "ISA.38.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 38:12"
      },
      "items": [
        {
          "text": "ilé mi ni a ti wó lulẹ̀ tí a sì gbà kúrò lọ́wọ́ mi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.12",
            "verseOrgIds": [
              "ISA.38.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 38:12"
      },
      "items": [
        {
          "text": "Gẹ́gẹ́ bí ahunṣọ mo ti ká ayé mi nílẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.12",
            "verseOrgIds": [
              "ISA.38.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 38:12"
      },
      "items": [
        {
          "text": "bẹ́ẹ̀ ni òun sì ti ké mi kúrò lára àṣà;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.12",
            "verseOrgIds": [
              "ISA.38.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 38:12"
      },
      "items": [
        {
          "text": "ọ̀sán àti òru ni ìwọ ṣe òpin mi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.12",
            "verseOrgIds": [
              "ISA.38.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 38:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi fi sùúrù dúró títí di àfẹ̀mọ́júmọ́,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.13",
            "verseOrgIds": [
              "ISA.38.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 38:13"
      },
      "items": [
        {
          "text": "ṣùgbọ́n gẹ́gẹ́ bí kìnnìún ó ti fọ́ gbogbo egungun mi;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.13",
            "verseOrgIds": [
              "ISA.38.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 38:13"
      },
      "items": [
        {
          "text": "ọ̀sán àti òru ni ìwọ fi ṣe òpin mi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.13",
            "verseOrgIds": [
              "ISA.38.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
