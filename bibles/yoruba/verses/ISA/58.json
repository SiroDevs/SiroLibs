  "verseCount": 14,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "58",
        "style": "c",
        "sid": "ISA 58"
      },
      "items": [
        {
          "text": "58",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Àwẹ̀ tòótọ́",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 58:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kígbe rẹ̀ sókè, má ṣe fàsẹ́yìn.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.1",
            "verseOrgIds": [
              "ISA.58.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 58:1"
      },
      "items": [
        {
          "text": "Gbé ohùn rẹ sókè bí i ti fèrè.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.1",
            "verseOrgIds": [
              "ISA.58.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 58:1"
      },
      "items": [
        {
          "text": "Jẹ́ kí ó di mí mọ̀ fún àwọn ènìyàn mi, ọ̀tẹ̀ wọn,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.1",
            "verseOrgIds": [
              "ISA.58.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 58:1"
      },
      "items": [
        {
          "text": "àti fún ilé Jakọbu ẹ̀ṣẹ̀ wọn.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.1",
            "verseOrgIds": [
              "ISA.58.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 58:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí ọjọ́ dé ọjọ́ ni wọ́n ń wá mi kiri;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.2",
            "verseOrgIds": [
              "ISA.58.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 58:2"
      },
      "items": [
        {
          "text": "wọ́n ṣe bí ẹni ní ìtara láti mọ ọ̀nà mi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.2",
            "verseOrgIds": [
              "ISA.58.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 58:2"
      },
      "items": [
        {
          "text": "àfi bí ẹni pé wọ́n jẹ́ orílẹ̀-èdè kan tí ń ṣe ohun tí ó tọ̀nà",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.2",
            "verseOrgIds": [
              "ISA.58.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 58:2"
      },
      "items": [
        {
          "text": "tí òun kò sì tí ì kọ àṣẹ Ọlọ́run rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.2",
            "verseOrgIds": [
              "ISA.58.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 58:2"
      },
      "items": [
        {
          "text": "Wọ́n ń béèrè lọ́wọ́ mi fún ìpinnu nìkan",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.2",
            "verseOrgIds": [
              "ISA.58.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 58:2"
      },
      "items": [
        {
          "text": "wọ́n sì ṣe bí ẹni ń tara fún Ọlọ́run láti súnmọ́ ọ̀dọ̀ wọn.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.2",
            "verseOrgIds": [
              "ISA.58.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 58:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n wí pé, 'Èéṣe tí àwa fi ń gbààwẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.3",
            "verseOrgIds": [
              "ISA.58.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 58:3"
      },
      "items": [
        {
          "text": "tí ìwọ kò sì tí ì rí?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.3",
            "verseOrgIds": [
              "ISA.58.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 58:3"
      },
      "items": [
        {
          "text": "Èéṣe tí àwa fi rẹra wa sílẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.3",
            "verseOrgIds": [
              "ISA.58.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 58:3"
      },
      "items": [
        {
          "text": "tí ìwọ kò sì tí ì ṣe àkíyèsí?'",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.3",
            "verseOrgIds": [
              "ISA.58.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "ISA 58:3"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 58:3"
      },
      "items": [
        {
          "text": "\"Síbẹ̀síbẹ̀ ní ọjọ́ àwẹ̀ yín, ẹ̀yin ń ṣe bí ó ti wù yín",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.3",
            "verseOrgIds": [
              "ISA.58.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 58:3"
      },
      "items": [
        {
          "text": "ẹ sì ń pọ́n àwọn òṣìṣẹ́ yín gbogbo lójú.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.3",
            "verseOrgIds": [
              "ISA.58.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 58:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwẹ̀ yín sì parí nínú ìjà àti asọ̀,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.4",
            "verseOrgIds": [
              "ISA.58.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 58:4"
      },
      "items": [
        {
          "text": "àti lílu ọmọnìkejì ẹni pa pẹ̀lú ìkùùkuu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.4",
            "verseOrgIds": [
              "ISA.58.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 58:4"
      },
      "items": [
        {
          "text": "Ẹ̀yin kò le è gbààwẹ̀ bí ẹ ti ń ṣe lónìí",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.4",
            "verseOrgIds": [
              "ISA.58.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 58:4"
      },
      "items": [
        {
          "text": "kí ẹ sì retí kí a gbọ́ ohùn un yín ní ibi gíga.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.4",
            "verseOrgIds": [
              "ISA.58.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 58:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ǹjẹ́ èyí ha ni irú àwẹ̀ tí mo yàn bí,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.5",
            "verseOrgIds": [
              "ISA.58.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 58:5"
      },
      "items": [
        {
          "text": "ọjọ́ kan ṣoṣo fún ènìyàn láti rẹ ara rẹ̀ sílẹ̀?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.5",
            "verseOrgIds": [
              "ISA.58.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 58:5"
      },
      "items": [
        {
          "text": "Ó ha jẹ pe kí ènìyàn tẹ orí rẹ̀ ba bí i koríko lásán ni bí",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.5",
            "verseOrgIds": [
              "ISA.58.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 58:5"
      },
      "items": [
        {
          "text": "àti sísùn nínú aṣọ ọ̀fọ̀ àti eérú?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.5",
            "verseOrgIds": [
              "ISA.58.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 58:5"
      },
      "items": [
        {
          "text": "Ṣé ohun tí ẹ̀ ń pè ní àwẹ̀ nìyí,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.5",
            "verseOrgIds": [
              "ISA.58.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 58:5"
      },
      "items": [
        {
          "text": "ọjọ́ ìtẹ́wọ́gbà fún",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.5",
            "verseOrgIds": [
              "ISA.58.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "ISA.58.5",
                "verseOrgIds": [
                  "ISA.58.5"
                ]
              }
            }
          ]
        },
        {
          "text": "?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.5",
            "verseOrgIds": [
              "ISA.58.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 58:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ǹjẹ́ irú àwẹ̀ tí mo ti yàn kọ́ ni èyí:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.6",
            "verseOrgIds": [
              "ISA.58.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 58:6"
      },
      "items": [
        {
          "text": "láti já gbogbo ẹ̀wọ̀n àìṣòdodo",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.6",
            "verseOrgIds": [
              "ISA.58.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 58:6"
      },
      "items": [
        {
          "text": "àti láti tú gbogbo okùn àjàgà,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.6",
            "verseOrgIds": [
              "ISA.58.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 58:6"
      },
      "items": [
        {
          "text": "láti tú gbogbo àwọn ti à ń ni lára sílẹ̀",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.6",
            "verseOrgIds": [
              "ISA.58.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 58:6"
      },
      "items": [
        {
          "text": "àti láti fọ́ gbogbo àjàgà?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.6",
            "verseOrgIds": [
              "ISA.58.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 58:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kì í ha á ṣe láti pín oúnjẹ yín fún àwọn tí ebi ń pa",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.7",
            "verseOrgIds": [
              "ISA.58.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 58:7"
      },
      "items": [
        {
          "text": "àti láti pèsè ibùgbé fún àwọn òtòṣì tí ń rìn káàkiri.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.7",
            "verseOrgIds": [
              "ISA.58.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 58:7"
      },
      "items": [
        {
          "text": "Nígbà tí ẹ bá rí ẹni tí ó wà níhòhò, láti daṣọ bò ó,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.7",
            "verseOrgIds": [
              "ISA.58.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 58:7"
      },
      "items": [
        {
          "text": "àti láti má ṣe lé àwọn ìbátan yín sẹ́yìn?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.7",
            "verseOrgIds": [
              "ISA.58.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 58:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni ìmọ́lẹ̀ rẹ yóò tàn jáde bí òwúrọ̀",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.8",
            "verseOrgIds": [
              "ISA.58.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 58:8"
      },
      "items": [
        {
          "text": "àti ìmúláradá rẹ yóò farahàn kíákíá;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.8",
            "verseOrgIds": [
              "ISA.58.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 58:8"
      },
      "items": [
        {
          "text": "nígbà náà ni òdodo rẹ yóò sì lọ níwájú rẹ,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.8",
