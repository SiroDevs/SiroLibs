    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Àsọtẹ́lẹ̀ tó lòdì sí Ejibiti àti Kuṣi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 20:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọdún tí olórí ogun, tí Sagoni ọba Asiria rán an, wá sí Aṣdodu, ó kọlù ú ó sì kó o—",
          "type": "text",
          "attrs": {
            "verseId": "ISA.20.1",
            "verseOrgIds": [
              "ISA.20.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ní àkókò náà ni ọ̀rọ̀",
          "type": "text",
          "attrs": {
            "verseId": "ISA.20.2",
            "verseOrgIds": [
              "ISA.20.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "ISA.20.2",
                "verseOrgIds": [
                  "ISA.20.2"
                ]
              }
            }
          ]
        },
        {
          "text": "ti ẹnu Isaiah ọmọ Amosi jáde. Ó sọ fún un pé, \"Mú aṣọ ọ̀fọ̀ kúrò ní ara rẹ kí o sì bọ́ sálúbàtà kúrò ní ẹsẹ̀ rẹ.\" Ó sì ṣe bẹ́ẹ̀, ó ń lọ káàkiri ní ìhòhò àti láì wọ bàtà.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.20.2",
            "verseOrgIds": [
              "ISA.20.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lẹ́yìn náà ni",
          "type": "text",
          "attrs": {
            "verseId": "ISA.20.3",
            "verseOrgIds": [
              "ISA.20.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "ISA.20.3",
                "verseOrgIds": [
                  "ISA.20.3"
                ]
              }
            }
          ]
        },
        {
          "text": "wí pé, \"Gẹ́gẹ́ bí ìránṣẹ́ mi Isaiah ti lọ káàkiri ní ìhòhò àti láì wọ bàtà fún ọdún mẹ́ta, gẹ́gẹ́ bí àmì àti àpẹẹrẹ sí Ejibiti àti Kuṣi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.20.3",
            "verseOrgIds": [
              "ISA.20.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "bẹ́ẹ̀ gẹ́gẹ́ ni ọba Asiria yóò kó àwọn ìgbèkùn Ejibiti lọ ní ìhòhò àti láì wọ bàtà pẹ̀lú àwọn àtìpó Kuṣi, ọ̀dọ́ àti àgbà, pẹ̀lú ìbàdí ìhòhò—bí àbùkù Ejibiti.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.20.4",
            "verseOrgIds": [
              "ISA.20.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo àwọn tí ó gbẹ́kẹ̀lé Kuṣi tí wọ́n sì ń fi Ejibiti yangàn ni ẹ̀rù yóò dé bá tí a ó sì dójútì wọ́n.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.20.5",
            "verseOrgIds": [
              "ISA.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọjọ́ náà àwọn ènìyàn tí ó ń gbé ní etí Òkun yóò wí pé, 'Wo ohun tí ó ti ṣẹlẹ̀ sí àwọn tí a ti gbẹ́kẹ̀lé, àwọn tí a sá tọ̀ lọ fún ìrànlọ́wọ́ àti ìtúsílẹ̀ láti ọwọ́ ọba Asiria! Báwo ni a ó ṣe sálà?' \"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.20.6",
            "verseOrgIds": [
              "ISA.20.6"
            ]
          }
        }
      ]
    }
  ],
