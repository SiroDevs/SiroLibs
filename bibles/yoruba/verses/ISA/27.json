  "verseCount": 13,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "27",
        "style": "c",
        "sid": "ISA 27"
      },
      "items": [
        {
          "text": "27",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìdáǹdè Israẹli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 27:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọjọ́ náà,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.1",
            "verseOrgIds": [
              "ISA.27.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 27:1"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "ISA.27.1",
                "verseOrgIds": [
                  "ISA.27.1"
                ]
              }
            }
          ]
        },
        {
          "text": "yóò fi idà rẹ̀ jẹ ni ní yà",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.1",
            "verseOrgIds": [
              "ISA.27.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 27:1"
      },
      "items": [
        {
          "text": "idà rẹ̀ a mú bí iná tí ó tóbi tí ó sì lágbára",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.1",
            "verseOrgIds": [
              "ISA.27.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 27:1"
      },
      "items": [
        {
          "text": "Lefitani ejò tí ń yọ̀ tẹ̀ẹ̀rẹ̀ n nì,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.1",
            "verseOrgIds": [
              "ISA.27.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 27:1"
      },
      "items": [
        {
          "text": "Lefitani ejò tí ń lọ́ bìrìkìtì;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.1",
            "verseOrgIds": [
              "ISA.27.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 27:1"
      },
      "items": [
        {
          "text": "Òun yóò sì pa ẹ̀mí búburú inú Òkun náà.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.1",
            "verseOrgIds": [
              "ISA.27.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 27:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọjọ́ náà,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.2",
            "verseOrgIds": [
              "ISA.27.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 27:2"
      },
      "items": [
        {
          "text": "\"Kọrin nípa ọgbà àjàrà eléso kan.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.2",
            "verseOrgIds": [
              "ISA.27.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 27:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.3",
            "verseOrgIds": [
              "ISA.27.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "ISA.27.3",
                "verseOrgIds": [
                  "ISA.27.3"
                ]
              }
            }
          ]
        },
        {
          "text": "ń bojútó o,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.3",
            "verseOrgIds": [
              "ISA.27.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 27:3"
      },
      "items": [
        {
          "text": "Èmi ó bomirin ín láti ìgbàdégbà.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.3",
            "verseOrgIds": [
              "ISA.27.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 27:3"
      },
      "items": [
        {
          "text": "Èmi ó ṣọ́ ọ tọ̀sán tòru",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.3",
            "verseOrgIds": [
              "ISA.27.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 27:3"
      },
      "items": [
        {
          "text": "kí ẹnikẹ́ni má ba à pa á lára.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.3",
            "verseOrgIds": [
              "ISA.27.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 27:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inú kò bí mi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.4",
            "verseOrgIds": [
              "ISA.27.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 27:4"
      },
      "items": [
        {
          "text": "Bí ẹ̀gún àti ẹ̀wọ̀n bá dojú ìjà kọ mí!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.4",
            "verseOrgIds": [
              "ISA.27.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 27:4"
      },
      "items": [
        {
          "text": "Èmi yóò dìde sí wọn ní ogun,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.4",
            "verseOrgIds": [
              "ISA.27.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 27:4"
      },
      "items": [
        {
          "text": "Èmi yóò sì dáná sun gbogbo wọn.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.4",
            "verseOrgIds": [
              "ISA.27.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 27:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí bẹ́ẹ̀ kọ́, jẹ́ kí wọn wá sọ́dọ̀ mi fún ààbò;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.5",
            "verseOrgIds": [
              "ISA.27.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 27:5"
      },
      "items": [
        {
          "text": "jẹ́ kí wọ́n wá àlàáfíà pẹ̀lú mi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.5",
            "verseOrgIds": [
              "ISA.27.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 27:5"
      },
      "items": [
        {
          "text": "bẹ́ẹ̀ ni, jẹ́ kí wọn wá àlàáfíà pẹ̀lú mi.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.5",
            "verseOrgIds": [
              "ISA.27.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 27:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọjọ́ iwájú Jakọbu yóò ta gbòǹgbò,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.6",
            "verseOrgIds": [
              "ISA.27.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 27:6"
      },
      "items": [
        {
          "text": "Israẹli yóò tanná yóò sì rudi",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.6",
            "verseOrgIds": [
              "ISA.27.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 27:6"
      },
      "items": [
        {
          "text": "èso rẹ̀ yóò sì kún gbogbo ayé.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.6",
            "verseOrgIds": [
              "ISA.27.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 27:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ǹjẹ́",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.7",
            "verseOrgIds": [
              "ISA.27.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "ISA.27.7",
                "verseOrgIds": [
                  "ISA.27.7"
                ]
              }
            }
          ]
        },
        {
          "text": "ti lù ú",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.7",
            "verseOrgIds": [
              "ISA.27.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 27:7"
      },
      "items": [
        {
          "text": "gẹ́gẹ́ bí ó ti lu àwọn tí ó lù ú bolẹ̀?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.7",
            "verseOrgIds": [
              "ISA.27.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 27:7"
      },
      "items": [
        {
          "text": "Ǹjẹ́ a ti pa á",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.7",
            "verseOrgIds": [
              "ISA.27.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 27:7"
      },
      "items": [
        {
          "text": "gẹ́gẹ́ bí a ti pa àwọn tí ó pa á?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.7",
            "verseOrgIds": [
              "ISA.27.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 27:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nípa ogun jíjà àti ìjìyà ti o le ni ó",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.8",
            "verseOrgIds": [
              "ISA.27.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 27:8"
      },
      "items": [
        {
          "text": "fi dojúkọ ọ́",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.8",
            "verseOrgIds": [
              "ISA.27.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 27:8"
      },
      "items": [
        {
          "text": "pẹ̀lú ìjì gbígbóná ni ó lé e jáde,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.8",
            "verseOrgIds": [
              "ISA.27.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 27:8"
      },
      "items": [
        {
          "text": "gẹ́gẹ́ bí ọjọ́ tí afẹ́fẹ́ ìlà-oòrùn fẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.8",
            "verseOrgIds": [
              "ISA.27.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 27:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí èyí báyìí ni ètùtù yóò ṣe wà",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.9",
            "verseOrgIds": [
              "ISA.27.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 27:9"
      },
      "items": [
        {
          "text": "fún ẹ̀ṣẹ̀ Jakọbu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.9",
            "verseOrgIds": [
              "ISA.27.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 27:9"
      },
      "items": [
        {
          "text": "èyí ni yóò sì jẹ́ èso kíkún ti",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.9",
            "verseOrgIds": [
              "ISA.27.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 27:9"
      },
      "items": [
        {
          "text": "ìmúkúrò ẹ̀ṣẹ̀ rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.9",
            "verseOrgIds": [
              "ISA.27.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 27:9"
      },
      "items": [
        {
          "text": "Nígbà tí ó bá mú kí àwọn òkúta pẹpẹ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.9",
            "verseOrgIds": [
              "ISA.27.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 27:9"
      },
      "items": [
        {
          "text": "dàbí òkúta ẹfun tí a fọ́ sí wẹ́wẹ́,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.9",
            "verseOrgIds": [
              "ISA.27.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 27:9"
      },
      "items": [
        {
          "text": "kì yóò sí ère Aṣerah tàbí pẹpẹ tùràrí",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.9",
            "verseOrgIds": [
              "ISA.27.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
