  "TIT.2": {
    "id": "TIT.2",
    "number": "2",
    "bookId": "TIT",
    "reference": "Titu 2",
    "copyright": "Biblica® ní oore ọ̀fẹ́ láti lo Bíbélì Mímọ́ ní Èdè Yorùbá Òde-Òní™ Ẹ̀tọ́ àdàkọ © 2009, 2017 Biblica, Inc. Biblica® Open Yoruba Contemporary Bible™ Copyright © 2009, 2017 by Biblica, Inc. ‪\"Biblica\" ni àmì ìdámọ̀ tí Biblica, Inc. fi sílẹ̀ ní United States Patent àti ní ilé iṣẹ́ tí wọ́n ti ń fúnni ní àmì ìdámọ̀. Gba àṣẹ kí o tó lòó. \"Biblica\" is a trademark registered in the United States Patent and Trademark Office by Biblica, Inc. Used with permission.",
    "verseCount": 15,
    "content": [
      {
        "name": "chapter",
        "type": "tag",
        "attrs": {
          "number": "2",
          "style": "c",
          "sid": "TIT 2"
        },
        "items": [
          {
            "text": "2",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "s1"
        },
        "items": [
          {
            "text": "Àwọn ẹ̀kọ́ tí a gbọdọ̀ kọ́ ní onírúurú àkójọpọ̀",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "1",
              "style": "v",
              "sid": "TIT 2:1"
            },
            "items": [
              {
                "text": "1",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ṣùgbọ́n ìwọ gbọdọ̀ máa kọ́ni ní ẹ̀kọ́ tí ó yè kooro lórí ìgbé ayé onígbàgbọ́ tòótọ́.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.2.1",
              "verseOrgIds": [
                "TIT.2.1"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "2",
              "style": "v",
              "sid": "TIT 2:2"
            },
            "items": [
              {
                "text": "2",
                "type": "text"
              }
            ]
          },
          {
            "text": "Kọ́ àwọn àgbà ọkùnrin lẹ́kọ̀ọ́ láti ní ìrònú àti láti jẹ́ ẹni àpọ́nlé àti ẹni ìwọ̀ntúnwọ̀nsì. Wọn gbọdọ̀ jẹ́ ẹni tí ó jinlẹ̀ nínú ìgbàgbọ́, nínú ìfẹ́ àti nínú ìpamọ́ra.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.2.2",
              "verseOrgIds": [
                "TIT.2.2"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "3",
              "style": "v",
              "sid": "TIT 2:3"
            },
            "items": [
              {
                "text": "3",
                "type": "text"
              }
            ]
          },
          {
            "text": "Bákan náà, ni kí ó kọ́ àwọn àgbà obìnrin lẹ́kọ̀ọ́ láti kọ́ bí à a tí gbé ìgbé ayé ẹni ọ̀wọ̀, wọn kò gbọdọ̀ jẹ́ afọ̀rọ̀kẹ́lẹ́ batẹnijẹ́ tàbí olùfẹ́ ọtí mímu, ṣùgbọ́n wọ́n gbọdọ̀ jẹ́ olùkọ́ni ní ohun rere.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.2.3",
              "verseOrgIds": [
                "TIT.2.3"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "4",
              "style": "v",
              "sid": "TIT 2:4"
            },
            "items": [
              {
                "text": "4",
                "type": "text"
              }
            ]
          },
          {
            "text": "Nípa èyí, wọ́n yóò lè máa kọ́ àwọn ọ̀dọ́bìnrin láti nífẹ̀ẹ́ àwọn ọkọ wọn àti àwọn ọmọ wọn,",
            "type": "text",
            "attrs": {
              "verseId": "TIT.2.4",
              "verseOrgIds": [
                "TIT.2.4"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "5",
              "style": "v",
              "sid": "TIT 2:5"
            },
            "items": [
              {
                "text": "5",
                "type": "text"
              }
            ]
          },
          {
            "text": "láti jẹ́ ẹni ìwọ̀ntúnwọ̀nsì àti ọlọ́kàn mímọ́, kí wọ́n máa ṣe ojúṣe wọn nínú ilé, wọ́n gbọdọ̀ jẹ́ onínúrere, kí wọ́n sì máa tẹríba fún àwọn ọkọ wọ́n, kí ẹnikẹ́ni máa ba à sọ̀rọ̀-òdì sí ọ̀rọ̀ Ọlọ́run.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.2.5",
              "verseOrgIds": [
                "TIT.2.5"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "6",
              "style": "v",
              "sid": "TIT 2:6"
            },
            "items": [
              {
                "text": "6",
                "type": "text"
              }
            ]
          },
          {
            "text": "Bákan náà, rọ àwọn ọ̀dọ́ ọkùnrin láti kó ara wọn ni ìjánu.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.2.6",
              "verseOrgIds": [
                "TIT.2.6"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "7",
              "style": "v",
              "sid": "TIT 2:7"
            },
            "items": [
              {
                "text": "7",
                "type": "text"
              }
            ]
          },
          {
            "text": "Nínú ohun gbogbo fi ara rẹ̀ hàn gẹ́gẹ́ bí alápẹẹrẹ ohun rere. Nínú ẹ̀kọ́ rẹ fi àpẹẹrẹ ìwà pípé hàn, ẹni tó kún ojú òsùwọ̀n",
            "type": "text",
            "attrs": {
              "verseId": "TIT.2.7",
              "verseOrgIds": [
                "TIT.2.7"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "8",
              "style": "v",
              "sid": "TIT 2:8"
            },
            "items": [
              {
                "text": "8",
                "type": "text"
              }
            ]
          },
          {
            "text": "ọ̀rọ̀ tí ó yè kooro, tí a kò lè dá lẹ́bi, kí ojú kí ó ti ẹni tí ó ń sòdì, ní àìní ohun búburú kan láti wí sí wa.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.2.8",
              "verseOrgIds": [
                "TIT.2.8"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "9",
              "style": "v",
              "sid": "TIT 2:9"
            },
            "items": [
              {
                "text": "9",
                "type": "text"
              }
            ]
          },
          {
            "text": "Kọ́ àwọn ẹrú láti ṣe ìgbọ́ràn sí àwọn olówó wọn nínú ohun gbogbo, láti máa gbìyànjú láti tẹ́ wọn lọ́rùn, wọn kò gbọdọ̀ gbó olówó wọn lẹ́nu,",
            "type": "text",
            "attrs": {
              "verseId": "TIT.2.9",
              "verseOrgIds": [
                "TIT.2.9"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "10",
              "style": "v",
              "sid": "TIT 2:10"
            },
            "items": [
              {
                "text": "10",
                "type": "text"
              }
            ]
          },
          {
            "text": "wọn kò gbọdọ̀ jà wọ́n lólè ohunkóhun, ṣùgbọ́n kí wọ́n jẹ́ ẹni tó ṣe é gbẹ́kẹ̀lé, kí wọn ó làkàkà ní gbogbo ọ̀nà láti jẹ́ kí ìkọ́ni nípa Ọlọ́run àti Olùgbàlà ní ìtumọ̀ rere.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.2.10",
              "verseOrgIds": [
                "TIT.2.10"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "11",
              "style": "v",
              "sid": "TIT 2:11"
            },
            "items": [
              {
                "text": "11",
                "type": "text"
              }
            ]
          },
          {
            "text": "Nítorí oore-ọ̀fẹ́ Ọlọ́run tó mú ìgbàlà wà ti fi ara hàn fún gbogbo ènìyàn.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.2.11",
              "verseOrgIds": [
                "TIT.2.11"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "12",
              "style": "v",
              "sid": "TIT 2:12"
            },
            "items": [
              {
                "text": "12",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ó ń kọ́ wa láti sẹ́ àìwà-bí-Ọlọ́run àti ìfẹ́kúfẹ̀ẹ́ ayé, kí a sì máa wà ní àìrékọjá, ní òdodo àti ní ìwà-bí-Ọlọ́run ní ayé ìsinsin yìí,",
            "type": "text",
            "attrs": {
              "verseId": "TIT.2.12",
              "verseOrgIds": [
                "TIT.2.12"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "13",
              "style": "v",
              "sid": "TIT 2:13"
            },
            "items": [
              {
                "text": "13",
                "type": "text"
              }
            ]
          },
          {
            "text": "bí a ti ń wọ́nà fún ìrètí tó ní bùkún, èyí ń ní ìfarahàn ògo Ọlọ́run wa tí ó tóbi àti Olùgbàlà wa Jesu Kristi.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.2.13",
              "verseOrgIds": [
                "TIT.2.13"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "14",
              "style": "v",
              "sid": "TIT 2:14"
            },
            "items": [
              {
                "text": "14",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ẹni tí ó fi ara rẹ̀ fún wa láti rà fún ìràpadà kúrò nínú ìwà búburú gbogbo àti kí ó sì le wẹ̀ àwọn ènìyàn kan mọ́ fún ara rẹ̀ fún ìní ohun tìkára rẹ̀, àwọn tó ń ní ìtara fún iṣẹ́ rere.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.2.14",
              "verseOrgIds": [
                "TIT.2.14"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "15",
              "style": "v",
              "sid": "TIT 2:15"
            },
            "items": [
              {
                "text": "15",
                "type": "text"
              }
            ]
          },
          {
            "text": "Àwọn nǹkan wọ̀nyí ni kí ìwọ kí ó máa kọ wọn. Gbani níyànjú kí ó sì máa fi gbogbo àṣẹ bá ni wí. Máa jẹ́ kí ẹnikẹ́ni kí ó gàn ọ́.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.2.15",
              "verseOrgIds": [
                "TIT.2.15"
              ]
            }
          }
        ]
      }
    ],
