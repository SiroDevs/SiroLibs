          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìfarapa àti ìtìjú ni tirẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.33",
            "verseOrgIds": [
              "PRO.6.33"
            ]
          }
        }
      ]
    },
