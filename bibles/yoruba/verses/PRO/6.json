      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 6:31"
      },
      "items": [
        {
          "text": "bí ó tilẹ̀ kó gbogbo ohun tó ní nílé tà.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.31",
            "verseOrgIds": [
              "PRO.6.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
