      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 6:30"
      },
      "items": [
        {
          "text": "nítorí àti jẹun nígbà tí ebi bá ń pa á.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.30",
            "verseOrgIds": [
              "PRO.6.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
