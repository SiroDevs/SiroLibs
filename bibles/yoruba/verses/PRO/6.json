      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 6:29"
      },
      "items": [
        {
          "text": "kò sí ẹni tí ó fọwọ́ kàn án tí yóò lọ láìjìyà.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.29",
            "verseOrgIds": [
              "PRO.6.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
