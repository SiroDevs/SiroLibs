          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n ẹni tí ń ṣe àgbèrè kò nírònú;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.32",
            "verseOrgIds": [
              "PRO.6.32"
            ]
          }
        }
      ]
    },
