      "attrs": {
        "style": "q2",
        "vid": "PRO 6:20"
      },
      "items": [
        {
          "text": "má sì ṣe kọ ẹ̀kọ́ ìyá rẹ sílẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.20",
            "verseOrgIds": [
              "PRO.6.20"
            ]
          }
        }
      ]
    },
    {
