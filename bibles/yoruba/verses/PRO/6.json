      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 6:23"
      },
      "items": [
        {
          "text": "ẹ̀kọ́ yìí jẹ́ ìmọ́lẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.23",
            "verseOrgIds": [
              "PRO.6.23"
            ]
          }
        }
      ]
