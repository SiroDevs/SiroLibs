      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 6:32"
      },
      "items": [
        {
          "text": "ẹnikẹ́ni tí ó bá ń ṣe bẹ́ẹ̀ ó ń pa ara rẹ̀ run ni.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.32",
            "verseOrgIds": [
              "PRO.6.32"
            ]
          }
        }
      ]
    },
