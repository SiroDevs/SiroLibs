      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 6:28"
      },
      "items": [
        {
          "text": "Kí ẹsẹ̀ rẹ̀ sì má jóná?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.28",
            "verseOrgIds": [
              "PRO.6.28"
            ]
          }
        }
      ]
    },
    {
