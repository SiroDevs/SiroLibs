  "verseCount": 35,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
        "style": "c",
        "sid": "PRO 6"
      },
      "items": [
        {
          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s2"
      },
      "items": [
        {
          "text": "Ìkìlọ̀ láti ṣọ́ra fún ìwà òmùgọ̀",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọmọ mi, bí ìwọ bá ṣe onídùúró fún aládùúgbò rẹ,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.1",
            "verseOrgIds": [
              "PRO.6.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 6:1"
      },
      "items": [
        {
          "text": "bí ìwọ bá jẹ́ ẹ̀jẹ́ fún àjèjì ènìyàn,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.1",
            "verseOrgIds": [
              "PRO.6.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "bí a bá ti fi ọ̀rọ̀ tí ó sọ dẹkùn mú ọ,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.2",
            "verseOrgIds": [
              "PRO.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 6:2"
      },
      "items": [
        {
          "text": "tí ọ̀rọ̀ ẹnu rẹ ti kó ọ sí pàkúté.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.2",
            "verseOrgIds": [
              "PRO.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà, ṣe èyí, ìwọ ọmọ mi, láti gba ara rẹ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.3",
            "verseOrgIds": [
              "PRO.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 6:3"
      },
      "items": [
        {
          "text": "níwọ̀n bí o ti kó ṣọ́wọ́ aládùúgbò rẹ:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.3",
            "verseOrgIds": [
              "PRO.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PRO 6:3"
      },
      "items": [
        {
          "text": "lọ kí o sì rẹ ara rẹ sílẹ̀;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.3",
            "verseOrgIds": [
              "PRO.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 6:3"
      },
      "items": [
        {
          "text": "bẹ aládùúgbò rẹ dáradára.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.3",
            "verseOrgIds": [
              "PRO.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Má ṣe jẹ́ kí oorun kí ó kùn ọ́,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.4",
            "verseOrgIds": [
              "PRO.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 6:4"
      },
      "items": [
        {
          "text": "tàbí kí o tilẹ̀ tòògbé rárá.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.4",
            "verseOrgIds": [
              "PRO.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gba ara rẹ sílẹ̀, bí abo èsúró kúrò lọ́wọ́ ọdẹ,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.5",
            "verseOrgIds": [
              "PRO.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 6:5"
      },
      "items": [
        {
          "text": "bí ẹyẹ kúrò nínú okùn àwọn pẹyẹpẹyẹ.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.5",
            "verseOrgIds": [
              "PRO.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tọ èèrà lọ, ìwọ ọ̀lẹ;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.6",
            "verseOrgIds": [
              "PRO.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 6:6"
      },
      "items": [
        {
          "text": "kíyèsi ìṣe rẹ̀, kí o sì gbọ́n!",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.6",
            "verseOrgIds": [
              "PRO.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kò ní olùdarí,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.7",
            "verseOrgIds": [
              "PRO.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 6:7"
      },
      "items": [
        {
          "text": "kò sí alábojútó tàbí ọba,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.7",
            "verseOrgIds": [
              "PRO.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "síbẹ̀, a kó ìpèsè rẹ̀ jọ ní àsìkò òjò",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.8",
            "verseOrgIds": [
              "PRO.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 6:8"
      },
      "items": [
        {
          "text": "yóò sì kó oúnjẹ rẹ̀ jọ ní àsìkò ìkórè.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.8",
            "verseOrgIds": [
              "PRO.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yóò ti pẹ́ tó tí ìwọ yóò dùbúlẹ̀, ìwọ ọ̀lẹ?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.9",
            "verseOrgIds": [
              "PRO.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 6:9"
      },
      "items": [
        {
          "text": "Nígbà wo ni ìwọ yóò jí kúrò lójú oorun rẹ?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.9",
            "verseOrgIds": [
              "PRO.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oorun díẹ̀, òògbé díẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.10",
            "verseOrgIds": [
              "PRO.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 6:10"
      },
      "items": [
        {
          "text": "ìkáwọ́gbera láti sinmi díẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.10",
            "verseOrgIds": [
              "PRO.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Òsì yóò sì wá sórí rẹ bí ìgárá ọlọ́ṣà",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.11",
            "verseOrgIds": [
              "PRO.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 6:11"
      },
      "items": [
        {
          "text": "àti àìní bí adigunjalè.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.11",
            "verseOrgIds": [
              "PRO.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ènìyànkénìyàn àti ènìyàn búburú,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.12",
            "verseOrgIds": [
              "PRO.6.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 6:12"
      },
      "items": [
        {
          "text": "tí ń ru ẹnu àrékérekè káàkiri,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.12",
            "verseOrgIds": [
              "PRO.6.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "tí ó ń ṣẹ́jú pàkòpàkò,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.13",
            "verseOrgIds": [
              "PRO.6.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 6:13"
      },
      "items": [
        {
          "text": "ó ń fi ẹsẹ̀ rẹ̀ sọ̀rọ̀",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.13",
            "verseOrgIds": [
              "PRO.6.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 6:13"
      },
      "items": [
        {
          "text": "ó sì ń fi ìka ọwọ́ rẹ̀ júwe,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.13",
            "verseOrgIds": [
              "PRO.6.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "tí ó ń pète búburú pẹ̀lú ẹ̀tàn nínú ọkàn rẹ̀",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.14",
            "verseOrgIds": [
              "PRO.6.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 6:14"
      },
      "items": [
        {
          "text": "ìgbà gbogbo ni ó máa ń dá ìjà sílẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.14",
            "verseOrgIds": [
              "PRO.6.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà ìdààmú yóò dé bá a ní ìṣẹ́jú akàn;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.15",
            "verseOrgIds": [
              "PRO.6.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 6:15"
      },
      "items": [
        {
          "text": "yóò parun lójijì láìsí àtúnṣe.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.15",
            "verseOrgIds": [
              "PRO.6.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ohun mẹ́fà wà tí",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.16",
            "verseOrgIds": [
              "PRO.6.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PRO.6.16",
                "verseOrgIds": [
                  "PRO.6.16"
                ]
              }
            }
          ]
        },
        {
          "text": "kórìíra,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.16",
            "verseOrgIds": [
