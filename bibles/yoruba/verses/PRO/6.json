      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 6:25"
      },
      "items": [
        {
          "text": "tàbí kí o jẹ́ kí ó fi ojú rẹ̀ fà ọ́ mọ́ra.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.25",
            "verseOrgIds": [
              "PRO.6.25"
            ]
          }
