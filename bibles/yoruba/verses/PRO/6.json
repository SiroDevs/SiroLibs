          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ènìyàn kì í kẹ́gàn olè tí ó bá jalè",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.30",
            "verseOrgIds": [
              "PRO.6.30"
            ]
          }
        }
      ]
    },
