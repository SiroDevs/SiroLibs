          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ǹjẹ́ ọkùnrin ha le è gbé iná lé orí itan",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.27",
            "verseOrgIds": [
              "PRO.6.27"
            ]
          }
        }
      ]
