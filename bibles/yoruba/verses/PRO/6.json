      "type": "tag",
      "attrs": {
        "style": "li3",
        "vid": "PRO 6:19"
      },
      "items": [
        {
          "text": "àti ènìyàn tí ń dá ìjà sílẹ̀ láàrín àwọn ọmọ ìyá kan.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìkìlọ̀ nítorí àgbèrè",
