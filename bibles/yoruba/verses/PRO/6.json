          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ǹjẹ́ ènìyàn le è máa rìn lórí iná?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.28",
            "verseOrgIds": [
              "PRO.6.28"
            ]
          }
        }
      ]
    },
