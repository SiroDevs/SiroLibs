      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 6:24"
      },
      "items": [
        {
          "text": "kúrò lọ́wọ́ ẹnu dídùn obìnrin àjèjì.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.24",
            "verseOrgIds": [
              "PRO.6.24"
            ]
          }
        }
      ]
    },
