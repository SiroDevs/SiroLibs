      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 6:27"
      },
      "items": [
        {
          "text": "kí aṣọ rẹ̀ má sì jóná?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.27",
            "verseOrgIds": [
              "PRO.6.27"
            ]
          }
        }
      ]
    },
    {
