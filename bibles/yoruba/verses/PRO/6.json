      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 6:26"
      },
      "items": [
        {
          "text": "ṣùgbọ́n àyà ènìyàn a máa wá ìyè rẹ̀ dáradára.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.26",
            "verseOrgIds": [
              "PRO.6.26"
            ]
          }
        }
      ]
    },
    {
