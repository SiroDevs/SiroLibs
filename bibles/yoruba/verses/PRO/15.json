      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 15:12"
      },
      "items": [
        {
          "text": "kò ní gbàmọ̀ràn lọ́dọ̀ ọlọ́gbọ́n.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.12",
            "verseOrgIds": [
              "PRO.15.12"
            ]
