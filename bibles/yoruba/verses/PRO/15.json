        "style": "q2",
        "vid": "PRO 15:13"
      },
      "items": [
        {
          "text": "ṣùgbọ́n ìbànújẹ́ ọkàn máa ń pa ẹ̀mí run.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.13",
            "verseOrgIds": [
              "PRO.15.13"
            ]
          }
        }
      ]
