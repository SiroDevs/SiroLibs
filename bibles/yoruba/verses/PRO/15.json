      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 15:9"
      },
      "items": [
        {
          "text": "ṣùgbọ́n ó fẹ́ràn àwọn tí ń lépa òdodo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.9",
            "verseOrgIds": [
              "PRO.15.9"
            ]
          }
        }
      ]
