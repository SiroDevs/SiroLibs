      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 15:11"
      },
      "items": [
        {
          "text": "mélòó mélòó ní nínú ọkàn àwọn ènìyàn.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.11",
            "verseOrgIds": [
              "PRO.15.11"
            ]
          }
        }
