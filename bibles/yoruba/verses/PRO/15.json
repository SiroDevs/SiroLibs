      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 15:7"
      },
      "items": [
        {
          "text": "ṣùgbọ́n kò rí bẹ́ẹ̀ fún ọkàn aláìgbọ́n.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.7",
            "verseOrgIds": [
              "PRO.15.7"
            ]
          }
        }
      ]
    },
