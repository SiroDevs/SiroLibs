      "attrs": {
        "style": "q2",
        "vid": "PRO 15:8"
      },
      "items": [
        {
          "text": "ṣùgbọ́n àdúrà olódodo tẹ́ ẹ lọ́rùn.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.8",
            "verseOrgIds": [
              "PRO.15.8"
            ]
