    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jotamu ọba Juda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 27:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jotamu sì jẹ́ ẹni ọdún mẹ́ẹ̀ẹ́dọ́gbọ̀n nígbà tí ó jẹ ọba, ó sì di ọba ní Jerusalẹmu fún ọdún mẹ́rìndínlógún. Orúkọ ìyá rẹ̀ sì ni Jeruṣa ọmọbìnrin Sadoku.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.27.1",
            "verseOrgIds": [
              "2CH.27.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 27:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì ṣe ohun tí ó tọ́ ní ojú",
          "type": "text",
          "attrs": {
            "verseId": "2CH.27.2",
            "verseOrgIds": [
              "2CH.27.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.27.2",
                "verseOrgIds": [
                  "2CH.27.2"
                ]
              }
            }
          ]
        },
        {
          "text": ", gẹ́gẹ́ bí baba rẹ̀ Ussiah ti ṣe, ṣùgbọ́n kìkì wí pé kò wọ ilé",
          "type": "text",
          "attrs": {
            "verseId": "2CH.27.2",
            "verseOrgIds": [
              "2CH.27.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.27.2",
                "verseOrgIds": [
                  "2CH.27.2"
                ]
              }
            }
          ]
        },
        {
          "text": ". Àwọn ènìyàn síbẹ̀síbẹ̀ wọ́n ń ṣe iṣẹ́ ibi wọn.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.27.2",
            "verseOrgIds": [
              "2CH.27.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 27:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jotamu sì kọ́ ẹnu-ọ̀nà gíga ilé",
          "type": "text",
          "attrs": {
            "verseId": "2CH.27.3",
            "verseOrgIds": [
              "2CH.27.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.27.3",
                "verseOrgIds": [
                  "2CH.27.3"
                ]
              }
            }
          ]
        },
        {
          "text": "ó sì ṣe iṣẹ́ lórí odi ni pẹ̀tẹ́lẹ̀ Ofeli.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.27.3",
            "verseOrgIds": [
              "2CH.27.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 27:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì kọ́ àwọn ìlú ní Juda òkè àti nínú igbó àti ilé ìṣọ́, ó mọ ilé odi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.27.4",
            "verseOrgIds": [
              "2CH.27.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 27:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jotamu sì ṣẹ́ ogun lórí ọba àwọn ará Ammoni ó sì borí wọn. Ní ọdún náà àwọn ará Ammoni wọ́n sì san fún ọgọ́rùn-ún tálẹ́ǹtì fàdákà àti ẹgbẹ̀rún mẹ́wàá (10,000) òsùwọ̀n alikama àti ẹgbẹ̀rún mẹ́wàá (10,000) barle. Àwọn ará Ammoni gbé e wá ní iye kan náà àti pẹ̀lú ní ọdún kejì àti ní ọdún kẹta.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.27.5",
            "verseOrgIds": [
              "2CH.27.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 27:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jotamu sì di alágbára nítorí ó rìn ní ọ̀nà tó tọ́ níwájú",
          "type": "text",
          "attrs": {
            "verseId": "2CH.27.6",
            "verseOrgIds": [
              "2CH.27.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.27.6",
                "verseOrgIds": [
                  "2CH.27.6"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.27.6",
            "verseOrgIds": [
              "2CH.27.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 27:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìyókù iṣẹ́ ìjọba Jotamu, pẹ̀lú gbogbo àwọn ogun rẹ̀ pẹ̀lú ohun mìíràn tí ó ṣe, ni a kọ sínú ìwé àwọn ọba Israẹli àti ti Juda.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.27.7",
            "verseOrgIds": [
              "2CH.27.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 27:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì jẹ́ ẹni ọdún mẹ́ẹ̀ẹ́dọ́gbọ̀n nígbà tí ó jẹ ọba, ó sì jẹ ọba ní Jerusalẹmu fún ọdún mẹ́rìndínlógún.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.27.8",
            "verseOrgIds": [
              "2CH.27.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 27:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jotamu sì sùn pẹ̀lú àwọn baba a rẹ̀ a sì sin ín ní ìlú Dafidi, Ahasi ọmọ rẹ̀ sì jẹ ọba ní ipò rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.27.9",
            "verseOrgIds": [
              "2CH.27.9"
            ]
          }
        }
      ]
    }
  ],
