  "verseCount": 20,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "21",
        "style": "c",
        "sid": "2CH 21"
      },
      "items": [
        {
          "text": "21",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 21:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà Jehoṣafati sùn pẹ̀lú àwọn baba a rẹ̀, a sì sin ín pẹ̀lú wọn ní ìlú ńlá Dafidi. Jehoramu ọmọ rẹ̀ sì rọ́pò rẹ̀ gẹ́gẹ́ bí ọba.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.1",
            "verseOrgIds": [
              "2CH.21.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn arákùnrin Jehoramu ọmọ Jehoṣafati jẹ́ Asariah, Jehieli, Sekariah. Asariahu, Mikaeli àti Ṣefatia. Gbogbo àwọn wọ̀nyí ni àwọn ọmọ Jehoṣafati ọba Israẹli.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.2",
            "verseOrgIds": [
              "2CH.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baba wọn ti fún wọn ní ẹ̀bùn púpọ̀ ti fàdákà àti wúrà àti àwọn ohun èlò iyebíye pẹ̀lú àwọn ìlú ààbò ní Juda, ṣùgbọ́n, ó ti gbé ìjọba fún Jehoramu nítorí òun ni àkọ́bí ọmọkùnrin.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.3",
            "verseOrgIds": [
              "2CH.21.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jehoramu ọba Juda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí Jehoramu fi ẹsẹ̀ rẹ̀ múlẹ̀ gidigidi lórí ìjọba baba a rẹ̀, ó sì fi idà pa gbogbo àwọn arákùnrin rẹ̀ pẹ̀lú àwọn ọmọbìnrin ọba Israẹli.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.4",
            "verseOrgIds": [
              "2CH.21.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehoramu jẹ́ ẹni ọdún méjìlélọ́gbọ̀n nígbà tí ó di ọba, ó sì jẹ ọba ní Jerusalẹmu fún ọdún mẹ́jọ.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.5",
            "verseOrgIds": [
              "2CH.21.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó rìn ní ọ̀nà àwọn ọba Israẹli gẹ́gẹ́ bí ìdílé Ahabu ti ṣe, nítorí ó fẹ́ ọmọbìnrin Ahabu. Ó ṣe búburú lójú",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.6",
            "verseOrgIds": [
              "2CH.21.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.21.6",
                "verseOrgIds": [
                  "2CH.21.6"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.6",
            "verseOrgIds": [
              "2CH.21.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ó tilẹ̀ rí bẹ́ẹ̀, nítorí tí májẹ̀mú tí",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.7",
            "verseOrgIds": [
              "2CH.21.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.21.7",
                "verseOrgIds": [
                  "2CH.21.7"
                ]
              }
            }
          ]
        },
        {
          "text": "ti dá fún Dafidi kì í ṣe ìfẹ́",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.7",
            "verseOrgIds": [
              "2CH.21.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.21.7",
                "verseOrgIds": [
                  "2CH.21.7"
                ]
              }
            }
          ]
        },
        {
          "text": "láti pa ìdílé Dafidi run ó ti ṣe ìlérí láti tọ́jú fìtílà kan fún un àti àwọn àtẹ̀lé rẹ̀ títí láé.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.7",
            "verseOrgIds": [
              "2CH.21.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní àkókò Jehoramu, Edomu ṣọ̀tẹ̀ sí Juda, wọ́n sì gbé ọba tiwọn kalẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.8",
            "verseOrgIds": [
              "2CH.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ ni, Jehoramu lọ síbẹ̀ pẹ̀lú àwọn ìjòyè rẹ̀ àti gbogbo àwọn kẹ̀kẹ́. Àwọn ará Edomu yí i ká àti àwọn alákòóso àwọn kẹ̀kẹ́ rẹ̀. Ṣùgbọ́n ó dìde ní òru ó sì ṣẹ́gun wọn ní òru.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.9",
            "verseOrgIds": [
              "2CH.21.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Títí di ọjọ́ òní ni Edomu ti wà ní ìṣọ̀tẹ̀ sí Juda.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.10",
            "verseOrgIds": [
              "2CH.21.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2CH 21:10"
      },
      "items": [
        {
          "text": "Libina ṣọ̀tẹ̀ ní àkọ́kọ́ náà, nítorí tí Jehoramu ti kọ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.10",
            "verseOrgIds": [
              "2CH.21.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.21.10",
                "verseOrgIds": [
                  "2CH.21.10"
                ]
              }
            }
          ]
        },
        {
          "text": "sílẹ̀, Ọlọ́run àwọn baba a rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.10",
            "verseOrgIds": [
              "2CH.21.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Òun pẹ̀lú ti kọ́ àwọn ibi gíga lórí àwọn òkè Juda. Ó sì ti fà á kí àwọn ènìyàn Jerusalẹmu ó ṣe àgbèrè pẹ̀lú ara wọn. Ó sì ti jẹ́ kí wọn ó ṣáko lọ.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.11",
            "verseOrgIds": [
              "2CH.21.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehoramu gba ìwé láti ọwọ́ Elijah wòlíì, tí ó wí pé,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.12",
            "verseOrgIds": [
              "2CH.21.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "2CH 21:12"
      },
      "items": [
        {
          "text": "\"Èyí ní ohun tí",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.12",
            "verseOrgIds": [
              "2CH.21.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.21.12",
                "verseOrgIds": [
                  "2CH.21.12"
                ]
              }
            }
          ]
        },
        {
          "text": ", Ọlọ́run baba à rẹ Dafidi wí: 'Ìwọ kò tí ì rìn ní ọ̀nà àwọn baba à rẹ Jehoṣafati tàbí Asa ọba Juda.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.12",
            "verseOrgIds": [
              "2CH.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n ìwọ ti rìn ní ọ̀nà àwọn ọba Israẹli, ìwọ sì ti tọ́ Juda àti àwọn ènìyàn Jerusalẹmu láti ṣe àgbèrè sí ara wọn, gẹ́gẹ́ bí ilé Ahabu ti ṣe. Ìwọ sì ti pa àwọn arákùnrin rẹ, ẹ̀yà ara ilé baba à rẹ, àwọn ọkùnrin tí ó dára jù ọ́ lọ.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.13",
            "verseOrgIds": [
              "2CH.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ ni nísinsin yìí,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.14",
            "verseOrgIds": [
              "2CH.21.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.21.14",
                "verseOrgIds": [
                  "2CH.21.14"
                ]
              }
            }
          ]
        },
        {
          "text": "ti fẹ́rẹ lu àwọn ènìyàn rẹ, àwọn ọmọ rẹ, àwọn ìyàwó rẹ àti gbogbo ohun tí ó jẹ́ tìrẹ, pẹ̀lú àjàkálẹ̀-ààrùn ńlá.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.14",
            "verseOrgIds": [
              "2CH.21.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ tìkára yóò ṣe àárẹ̀ pẹ̀lú àìsàn lílọ́ra ti ìfun, títí tí àìsàn náà yóò fi jẹ́ kí àwọn ìfun rẹ jáde sí ìta.' \"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.15",
            "verseOrgIds": [
              "2CH.21.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.21.16",
                "verseOrgIds": [
                  "2CH.21.16"
                ]
              }
            }
          ]
        },
        {
          "text": "ru ìbínú àwọn ará Filistini àti àwọn Arabia tí wọ́n ń gbé ní ẹ̀bá àwọn ará Kuṣi sí Jehoramu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.16",
            "verseOrgIds": [
              "2CH.21.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n dojú ìjà kọ Juda, wọ́n gbà á, wọ́n sì kó gbogbo ọrọ̀ tí a rí ní ilé ọba pẹ̀lú, àwọn ọmọkùnrin rẹ̀ àti àwọn ọmọkùnrin kankan kò kù sílẹ̀ fún un bí kò ṣe Ahasiah, àbíkẹ́yìn nínú àwọn ọmọ rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.17",
            "verseOrgIds": [
              "2CH.21.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 21:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lẹ́yìn gbogbo èyí,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.18",
            "verseOrgIds": [
              "2CH.21.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.21.18",
                "verseOrgIds": [
                  "2CH.21.18"
                ]
              }
            }
          ]
        },
        {
          "text": "jẹ Jehoramu ní yà pẹ̀lú ààrùn tí kò ṣe é wòsàn nínú ìfun.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.18",
            "verseOrgIds": [
              "2CH.21.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní àkókò kan ní ìparí ọdún kejì, àwọn ìfun rẹ̀ jáde nítorí ààrùn náà ó sì kú nínú ìrora ńlá. Àwọn ènìyàn rẹ̀ kò dá iná láti fi bu ọlá fún un, gẹ́gẹ́ bí wọ́n ti ṣe fún àwọn baba a rẹ̀.",
