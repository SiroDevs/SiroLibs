  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "13",
        "style": "c",
        "sid": "2CH 13"
      },
      "items": [
        {
          "text": "13",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abijah ọba Juda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọdún kejìdínlógún ìjọba Jeroboamu, Abijah di ọba Juda.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.1",
            "verseOrgIds": [
              "2CH.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì jẹ ọba ní Jerusalẹmu fún ọdún mẹ́ta. Orúkọ ìyá rẹ̀ a máa jẹ́ Mikaiah, ọmọbìnrin Urieli ti Gibeah.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.2",
            "verseOrgIds": [
              "2CH.13.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2CH 13:2"
      },
      "items": [
        {
          "text": "Ogun wà láàrín Abijah àti Jeroboamu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.2",
            "verseOrgIds": [
              "2CH.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abijah lọ sí ojú ogun pẹ̀lú àwọn ọmọ-ogun ogún ọ̀kẹ́ (400,000) ọkùnrin alágbára, Jeroboamu kó ogun jọ pẹ̀lú ogójì ọ̀kẹ́ (800,000) ọ̀wọ́ ogun tí ó lágbára.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.3",
            "verseOrgIds": [
              "2CH.13.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abijah dúró lórí òkè Semaraimu ní òkè orílẹ̀-èdè Efraimu, ó sì wí pé, Jeroboamu àti gbogbo Israẹli, ẹ gbọ́ mi!",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.4",
            "verseOrgIds": [
              "2CH.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣé ẹ̀yin kò mọ̀ pé",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.5",
            "verseOrgIds": [
              "2CH.13.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.13.5",
                "verseOrgIds": [
                  "2CH.13.5"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run Israẹli ti fún Dafidi àti àwọn àtẹ̀lé rẹ̀ ni oyè ọba títí láé nípasẹ̀ májẹ̀mú iyọ̀?",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.5",
            "verseOrgIds": [
              "2CH.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Síbẹ̀ Jeroboamu ọmọ Nebati, oníṣẹ́ Solomoni ọmọ Dafidi, ṣọ̀tẹ̀ sí ọ̀gá rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.6",
            "verseOrgIds": [
              "2CH.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ènìyàn lásán sì kó ara wọn jọ sí ọ̀dọ̀ rẹ̀, àwọn ọmọ ẹni búburú, wọ́n sì kẹ̀yìn sí Rehoboamu ọmọ Solomoni ní ìgbà tí ó sì kéré tí kò lè pinnu fúnra rẹ̀, tí kò lágbára tó láti takò wọ́n.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.7",
            "verseOrgIds": [
              "2CH.13.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nísinsin yìí, ìwọ ṣètò láti kọ́ ìjọba",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.8",
            "verseOrgIds": [
              "2CH.13.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.13.8",
                "verseOrgIds": [
                  "2CH.13.8"
                ]
              }
            }
          ]
        },
        {
          "text": ", tí ó wà lọ́wọ́ àwọn àtẹ̀lé Dafidi. Ìwọ jẹ́ ọmọ-ogun tí ó gbilẹ̀, ìwọ sì ní pẹ̀lú rẹ ẹgbọrọ màlúù wúrà ti Jeroboamu dà láti fi ṣe Ọlọ́run yín.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.8",
            "verseOrgIds": [
              "2CH.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n ṣé ìwọ kò lé àwọn àlùfáà",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.9",
            "verseOrgIds": [
              "2CH.13.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.13.9",
                "verseOrgIds": [
                  "2CH.13.9"
                ]
              }
            }
          ]
        },
        {
          "text": "jáde, àwọn ọmọ Aaroni àti àwọn ará Lefi. Tí ó sì ṣe àwọn àlùfáà ti ara rẹ̀ gẹ́gẹ́ bí àwọn ènìyàn ilẹ̀ mìíràn ti ṣe? Ẹnikẹ́ni tí ó bá wá láti ya ara rẹ̀ sọ́tọ̀ pẹ̀lú ọ̀dọ́ akọ màlúù àti àgbò méjì lè jẹ́ àlùfáà ohun tí kì í ṣe Ọlọ́run.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.9",
            "verseOrgIds": [
              "2CH.13.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ní ti àwa,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.10",
            "verseOrgIds": [
              "2CH.13.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.13.10",
                "verseOrgIds": [
                  "2CH.13.10"
                ]
              }
            }
          ]
        },
        {
          "text": "ni Ọlọ́run wa, àwa kò sì ti ì kọ̀ ọ́ sílẹ̀. Àwọn àlùfáà tí ó ń sin",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.10",
            "verseOrgIds": [
              "2CH.13.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.13.10",
                "verseOrgIds": [
                  "2CH.13.10"
                ]
              }
            }
          ]
        },
        {
          "text": "jẹ́ àwọn ọmọ Aaroni àwọn ará Lefi sì ń ràn wọ́n lọ́wọ́.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.10",
            "verseOrgIds": [
              "2CH.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní àràárọ̀ àti ìrọ̀lẹ́, wọ́n gbé ẹbọ sísun àti tùràrí olóòórùn dídùn síwájú",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.11",
            "verseOrgIds": [
              "2CH.13.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.13.11",
                "verseOrgIds": [
                  "2CH.13.11"
                ]
              }
            }
          ]
        },
        {
          "text": ". Wọ́n gbé àkàrà jáde sórí tábìlì àsè mímọ́, wọ́n sì tan iná sí àwọn fìtílà lórí ìdúró ọ̀pá fìtílà wúrà ní gbogbo ìrọ̀lẹ́. A ń pa àṣẹ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.11",
            "verseOrgIds": [
              "2CH.13.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.13.11",
                "verseOrgIds": [
                  "2CH.13.11"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run wa mọ́. Ṣùgbọ́n ìwọ ti kọ̀ ọ́ sílẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.11",
            "verseOrgIds": [
              "2CH.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọlọ́run wà pẹ̀lú wa; òun ni olórí wa. Àwọn àlùfáà rẹ̀ pẹ̀lú fèrè wọn yóò fọn ìpè ogun sí i yín. Ẹyin ọkùnrin Israẹli, ẹ má ṣe dojú ìjà kọ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.12",
            "verseOrgIds": [
              "2CH.13.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.13.12",
                "verseOrgIds": [
                  "2CH.13.12"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run baba yín nítorí ẹ̀yin kì yóò yege.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.12",
            "verseOrgIds": [
              "2CH.13.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nísinsin yìí, Jeroboamu ti rán àwọn ọ̀wọ́ ogun lọ yíká láti jagun ẹ̀yìn. Kí ó lè jẹ́ pé, tí òun bá wà níwájú Juda, bíba ní bùba á wà ní ẹ̀yìn wọn.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.13",
            "verseOrgIds": [
              "2CH.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí Juda sì bojú wo ẹ̀yìn, sì kíyèsi i, ogun ń bẹ níwájú àti lẹ́yìn, wọn sì ké pe",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.14",
            "verseOrgIds": [
              "2CH.13.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.13.14",
                "verseOrgIds": [
                  "2CH.13.14"
                ]
              }
            }
          ]
        },
        {
          "text": ", àwọn àlùfáà sì fun ìpè.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.14",
            "verseOrgIds": [
              "2CH.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olúkúlùkù, ọkùnrin Juda sì fún ìpè ogun, ó sì ṣe, bí àwọn ọkùnrin Juda sì ti fun ìpè ogun, ni Ọlọ́run kọlu Jeroboamu àti gbogbo Israẹli níwájú Abijah àti Juda.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.15",
            "verseOrgIds": [
              "2CH.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ọmọ Israẹli sálọ kúrò níwájú Juda, Ọlọ́run sì fi wọ́n lé wọn lọ́wọ́.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.16",
            "verseOrgIds": [
              "2CH.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abijah àti àwọn arákùnrin rẹ̀ fi ìdààmú ńlá jẹ wọ́n ní ìyà, bẹ́ẹ̀ ni ọ̀kẹ́ mẹ́ẹ̀ẹ́dọ́gbọ̀n (500,000) ọkùnrin tí a yàn ṣubú ní pípa nínú Israẹli.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.17",
            "verseOrgIds": [
              "2CH.13.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Báyìí ni a rẹ àwọn ọmọ Israẹli sílẹ̀ ní àkókò náà, àwọn ọmọ Juda sì borí nítorí tí wọ́n gbẹ́kẹ̀lé",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.18",
            "verseOrgIds": [
              "2CH.13.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.13.18",
