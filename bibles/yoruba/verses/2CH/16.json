  "verseCount": 14,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "16",
        "style": "c",
        "sid": "2CH 16"
      },
      "items": [
        {
          "text": "16",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìgbẹ̀yìn ọdún asà",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọdún kẹrìndínlógójì ìjọba Asa, Baaṣa ọba Israẹli gòkè wá sí Juda ó sì kọlu Rama, láti ma bá a jẹ́ kí ẹnikẹ́ni lè jáde tàbí wọlé tọ Asa ọba Juda lọ.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.1",
            "verseOrgIds": [
              "2CH.16.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni Asa mú wúrà àti fàdákà jáde nínú ilé ìṣúra ilé",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.2",
            "verseOrgIds": [
              "2CH.16.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.16.2",
                "verseOrgIds": [
                  "2CH.16.2"
                ]
              }
            }
          ]
        },
        {
          "text": "àti ààfin ọba ó sì ránṣẹ́ sí Beni-Hadadi ọba Siria, ẹni tí ń gbé ní Damasku, ó wí pé,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.2",
            "verseOrgIds": [
              "2CH.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Májẹ̀mú kan wà láàrín èmi àti ìrẹ, bí ó ti wà láàrín baba mi àti baba rẹ. Ẹ wò ó, mo fi wúrà àti fàdákà ránṣẹ́ sí ọ; lọ, ba májẹ̀mú tí o bá Baaṣa ọba Israẹli dá jẹ́, kí ó lè lọ kúrò ní ọ̀dọ̀ mi.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.3",
            "verseOrgIds": [
              "2CH.16.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Beni-Hadadi sì gbọ́ ti Asa ọba, ó sì rán àwọn olórí ogun rẹ̀ lọ sí àwọn ìlú Israẹli, wọ́n sì kọlu Ijoni, Dani, Abeli-Maimu, àti gbogbo ìlú ìṣúra Naftali.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.4",
            "verseOrgIds": [
              "2CH.16.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí Baaṣa gbọ́ èyí, ó sì dá kíkọ́ Rama dúró, ó sì dá iṣẹ́ rẹ̀ dúró.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.5",
            "verseOrgIds": [
              "2CH.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ní ọba Asa kó gbogbo àwọn ènìyàn Juda jọ, wọ́n sì kó òkúta àti igi Rama lọ èyí ti Baaṣa ń fi kọ́lé; ó sì fi kọ́ Geba àti Mispa.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.6",
            "verseOrgIds": [
              "2CH.16.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní àkókò náà wòlíì Hanani wá sí ọ̀dọ̀ Asa ọba Juda, ó sì wí fún un pé, \"Nítorí tí ìwọ gbẹ́kẹ̀lé ọba Siria, ìwọ kò sì gbẹ́kẹ̀lé",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.7",
            "verseOrgIds": [
              "2CH.16.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.16.7",
                "verseOrgIds": [
                  "2CH.16.7"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run rẹ, nítorí náà ni ogún ọba Siria ṣe bọ́ kúrò lọ́wọ́ rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.7",
            "verseOrgIds": [
              "2CH.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwa kì í ṣe ará Etiopia àti àwọn ará Libia àwọn alágbára ogun pẹ̀lú ọ̀pọ̀lọpọ̀ kẹ̀kẹ́ àti àwọn ẹlẹ́ṣin? Síbẹ̀ nígbà tí ìwọ bá gbẹ́kẹ̀lé",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.8",
            "verseOrgIds": [
              "2CH.16.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.16.8",
                "verseOrgIds": [
                  "2CH.16.8"
                ]
              }
            }
          ]
        },
        {
          "text": "yóò sì fi wọ́n lé ọwọ́ rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.8",
            "verseOrgIds": [
              "2CH.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí ojú",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.9",
            "verseOrgIds": [
              "2CH.16.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.16.9",
                "verseOrgIds": [
                  "2CH.16.9"
                ]
              }
            }
          ]
        },
        {
          "text": "yí gbogbo ayé ká láti fi agbára fún àwọn ẹni tí ó ní ọkàn pípé sí i. Ìwọ ti ṣe ohun aṣiwèrè, láti ìsinsin yìí lọ, ìwọ yóò wà lójú ogun.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.9",
            "verseOrgIds": [
              "2CH.16.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asa sì bínú pẹ̀lú sí wòlíì nítorí èyí, ó sì mú un bínú gidigidi tí ó sì fi mú un sínú túbú. Ní àkókò náà Asa sì ni díẹ̀ nínú àwọn ènìyàn náà lára.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.10",
            "verseOrgIds": [
              "2CH.16.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn iṣẹ́ ìjọba Asa, láti ìbẹ̀rẹ̀ títí dé òpin, ni akọ sínú ìwé ọba Juda àti Israẹli.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.11",
            "verseOrgIds": [
              "2CH.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọdún kọkàndínlógójì ìjọba rẹ̀, Asa sì ṣe àìsàn pẹ̀lú ààrùn nínú ẹsẹ̀ rẹ̀. Bi ó tilẹ̀ jẹ pé ààrùn rẹ̀ lágbára, síbẹ̀ kódà nínú àìsàn rẹ̀ kò wá ìrànlọ́wọ́ láti ọ̀dọ̀",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.12",
            "verseOrgIds": [
              "2CH.16.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.16.12",
                "verseOrgIds": [
                  "2CH.16.12"
                ]
              }
            }
          ]
        },
        {
          "text": ", ṣùgbọ́n lọ́dọ̀ àwọn oníṣègùn nìkan.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.12",
            "verseOrgIds": [
              "2CH.16.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà tí ó pé ọdún kọ́kànlélógójì rẹ̀, Asa kú, ó sì sùn pẹ̀lú àwọn ìjọba baba rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.13",
            "verseOrgIds": [
              "2CH.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "wọ́n sì sin ín sínú isà òkú tí ó ti gbẹ́ jáde fún ara rẹ̀ ní ìlú Dafidi. Wọ́n sì tẹ sí orí àkéte tí ó fi òórùn dídùn kún, àti onírúurú tùràrí tí a fi ọgbọ́n pèsè, wọ́n sì da iná ńlá nítorí rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.14",
            "verseOrgIds": [
              "2CH.16.14"
            ]
          }
        }
      ]
    }
  ],
