  "verseCount": 27,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "24",
        "style": "c",
        "sid": "2CH 24"
      },
      "items": [
        {
          "text": "24",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Joaṣi tún ilé",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text"
            }
          ]
        },
        {
          "text": "ṣe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 24:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joaṣi jẹ́ ọmọ ọdún méje nígbà tí ó jẹ ọba, ó sì jẹ ọba ní Jerusalẹmu fún ogójì ọdún. Orúkọ ìyá rẹ̀ ni Sibia ti Beerṣeba.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.1",
            "verseOrgIds": [
              "2CH.24.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joaṣi ṣe ohun tí ó dára ní ojú",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.2",
            "verseOrgIds": [
              "2CH.24.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.24.2",
                "verseOrgIds": [
                  "2CH.24.2"
                ]
              }
            }
          ]
        },
        {
          "text": "ní gbogbo àkókò Jehoiada àlùfáà.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.2",
            "verseOrgIds": [
              "2CH.24.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehoiada yan ìyàwó méjì fún un, ó sì ní àwọn ọmọkùnrin àti àwọn ọmọbìnrin.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.3",
            "verseOrgIds": [
              "2CH.24.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní àkókò kan, Joaṣi pinnu láti tún ilé",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.4",
            "verseOrgIds": [
              "2CH.24.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.24.4",
                "verseOrgIds": [
                  "2CH.24.4"
                ]
              }
            }
          ]
        },
        {
          "text": "ṣe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.4",
            "verseOrgIds": [
              "2CH.24.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó pe àwọn àlùfáà àti àwọn ará Lefi jọ, ó wí fún wọn pé, \"Ẹ lọ sí àwọn ìlú Juda, kí ẹ sì gba owó ìtọ́sí láti ọwọ́ gbogbo Israẹli láti fi tún ilé Ọlọ́run yín ṣe.\" Ṣùgbọ́n àwọn ará Lefi kò ṣe é lẹ́ẹ̀kan náà.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.5",
            "verseOrgIds": [
              "2CH.24.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 24:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà ọba pa á láṣẹ fún Jehoiada olórí àlùfáà ó sì wí fún un pé, \"Kí ni ó dé tí o kò béèrè lọ́wọ́ àwọn ará Lefi láti mú wá láti Juda àti Jerusalẹmu, owó orí tí Mose ìránṣẹ́",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.6",
            "verseOrgIds": [
              "2CH.24.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.24.6",
                "verseOrgIds": [
                  "2CH.24.6"
                ]
              }
            }
          ]
        },
        {
          "text": "ti fi lélẹ̀ àti nípasẹ̀ àpéjọ gbogbo Israẹli fún àgọ́ ẹ̀rí?\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.6",
            "verseOrgIds": [
              "2CH.24.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nísinsin yìí, àwọn ọmọkùnrin obìnrin búburú ni Ataliah ti fọ́ ilé Ọlọ́run, ó sì ti lo àwọn nǹkan ìyàsọ́tọ̀ fún àwọn Baali.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.7",
            "verseOrgIds": [
              "2CH.24.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 24:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nípasẹ̀ ọba, wọn ṣe àpótí wọ́n sì gbé e sí ìta, ní ẹnu-ọ̀nà ilé",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.8",
            "verseOrgIds": [
              "2CH.24.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.24.8",
                "verseOrgIds": [
                  "2CH.24.8"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.8",
            "verseOrgIds": [
              "2CH.24.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "A ṣe ìkéde ní Juda àti Jerusalẹmu wí pé wọ́n gbọdọ̀ mú wá fún",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.9",
            "verseOrgIds": [
              "2CH.24.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.24.9",
                "verseOrgIds": [
                  "2CH.24.9"
                ]
              }
            }
          ]
        },
        {
          "text": ", owó orí tí Mose ìránṣẹ́",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.9",
            "verseOrgIds": [
              "2CH.24.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.24.9",
                "verseOrgIds": [
                  "2CH.24.9"
                ]
              }
            }
          ]
        },
        {
          "text": "ti béèrè lọ́wọ́ Israẹli ní aginjù.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.9",
            "verseOrgIds": [
              "2CH.24.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 24:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo àwọn ìjòyè àti gbogbo àwọn ènìyàn sì yọ̀, wọ́n sì mú un wá, wọ́n ń jù ú sínú àpótí títí tí ó fi kún.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.10",
            "verseOrgIds": [
              "2CH.24.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 24:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbàkígbà tí a bá gbé àpótí wọlé láti ọwọ́ àwọn ará Lefi sí ọwọ́ àwọn ìjòyè ọba, tí wọ́n bá sì rí wí pe owó ńlá wà níbẹ̀ àwọn akọ̀wé ọba àti ìjòyè olórí àlùfáà yóò wá láti kó owó rẹ̀ kúrò, wọn yóò sì dá a padà sí ààyè rẹ̀. Wọ́n ṣe èyí déédé, wọ́n sì kó iye owó ńlá.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.11",
            "verseOrgIds": [
              "2CH.24.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 24:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọba àti Jehoiada fi fún àwọn ọkùnrin náà tí ó sì ń ṣiṣẹ́ nínú ilé",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.12",
            "verseOrgIds": [
              "2CH.24.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.24.12",
                "verseOrgIds": [
                  "2CH.24.12"
                ]
              }
            }
          ]
        },
        {
          "text": ". Wọ́n fi owó gba ẹni tí ń fi òkúta mọ ilé àti àwọn gbẹ́nàgbẹ́nà láti kọ́ ilé",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.12",
            "verseOrgIds": [
              "2CH.24.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.24.12",
                "verseOrgIds": [
                  "2CH.24.12"
                ]
              }
            }
          ]
        },
        {
          "text": "padà, àti àwọn òṣìṣẹ́ pẹ̀lú irin àti idẹ láti tún ilé",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.12",
            "verseOrgIds": [
              "2CH.24.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.24.12",
                "verseOrgIds": [
                  "2CH.24.12"
                ]
              }
            }
          ]
        },
        {
          "text": "ṣe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.12",
            "verseOrgIds": [
              "2CH.24.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 24:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ ni àwọn tí ó ń ṣiṣẹ́ náà, sì lọ síwájú àti síwájú ní ọwọ́ wọn, wọ́n sì tún mú ilé Ọlọ́run dúró sí ipò rẹ̀, wọ́n mú un le.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.13",
            "verseOrgIds": [
              "2CH.24.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 24:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí wọ́n sì parí rẹ̀ tán, wọ́n mú owó ìyókù wá sí iwájú ọba àti Jehoiada, a sì fi ohun èlò fún ilé",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.14",
            "verseOrgIds": [
              "2CH.24.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.24.14",
                "verseOrgIds": [
                  "2CH.24.14"
                ]
              }
            }
          ]
        },
        {
          "text": ", àní ohun èlò fún ìsìn àti fún ẹbọ pẹ̀lú ọpọ́n, àní ohun èlò wúrà àti fàdákà. Wọ́n sì ń rú ẹbọ sísun ní ilé",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.14",
            "verseOrgIds": [
              "2CH.24.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.24.14",
                "verseOrgIds": [
                  "2CH.24.14"
                ]
              }
            }
          ]
        },
        {
          "text": "nígbà gbogbo ní gbogbo ọjọ́ Jehoiada.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.14",
            "verseOrgIds": [
              "2CH.24.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ikú Jehoiada",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 24:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n Jehoiada di arúgbó, ó sì kún fún ọjọ́, ó sì kú, ẹni àádóje ọdún ni nígbà tí ó kú.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.15",
            "verseOrgIds": [
              "2CH.24.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 24:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n sì sin ín ní ìlú Dafidi pẹ̀lú àwọn ọba, nítorí tí ó ṣe rere ní Israẹli, àti sí Ọlọ́run àti sí ilé rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.16",
            "verseOrgIds": [
              "2CH.24.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìwà búburú Joaṣi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 24:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lẹ́yìn ikú Jehoiada, àwọn oníṣẹ́ Juda wá láti fi ìforíbalẹ̀ wọn hàn sí ọba. Ó sì fèsì sí wọn.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.17",
            "verseOrgIds": [
              "2CH.24.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 24:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n pa ilé",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.18",
            "verseOrgIds": [
              "2CH.24.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.24.18",
                "verseOrgIds": [
                  "2CH.24.18"
                ]
              }
            }
          ]
        },
        {
          "text": "tì, Ọlọ́run baba a wọn. Wọ́n sì ń sin àwọn ère Aṣerah àti àwọn òrìṣà. Nítorí ẹ̀ṣẹ̀ wọn yìí, ìbínú Ọlọ́run dé sórí Juda àti Jerusalẹmu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.18",
            "verseOrgIds": [
              "2CH.24.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 24:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ó ti wù kí ó rí,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.19",
            "verseOrgIds": [
              "2CH.24.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.24.19",
                "verseOrgIds": [
                  "2CH.24.19"
                ]
              }
            }
          ]
        },
        {
          "text": "rán àwọn wòlíì sí àwọn ènìyàn láti mú wọn padà sí ọ̀dọ̀ rẹ̀. Bí ó tilẹ̀ jẹ́ wí pé, wọ́n jẹ́rìí nípa wọn, wọn kì yóò gbọ́.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.19",
            "verseOrgIds": [
              "2CH.24.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 24:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà, Ẹ̀mí Ọlọ́run wá sórí Sekariah ọmọ Jehoiada wòlíì, ó dúró níwájú àwọn ènìyàn ó sì wí pé, \"Èyí ni ohun tí",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.20",
            "verseOrgIds": [
              "2CH.24.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.24.20",
                "verseOrgIds": [
                  "2CH.24.20"
                ]
              }
            }
          ]
        },
        {
          "text": "wí: 'Kí ni ó dé tí ẹ̀yin kò fi tẹ̀lé àṣẹ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.20",
            "verseOrgIds": [
              "2CH.24.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.24.20",
                "verseOrgIds": [
                  "2CH.24.20"
                ]
              }
            }
          ]
        },
        {
          "text": "? Ìwọ kì yóò ṣe rere. Nítorí tí ìwọ ti kọ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.20",
            "verseOrgIds": [
              "2CH.24.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.24.20",
                "verseOrgIds": [
                  "2CH.24.20"
                ]
              }
            }
          ]
        },
        {
          "text": "sílẹ̀, òun pẹ̀lú ti kọ̀ yín sílẹ̀.' \"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.20",
            "verseOrgIds": [
              "2CH.24.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 24:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n wọ́n dìtẹ̀ sí i, àti nípa àṣẹ ọba, wọ́n sọ ọ́ lókùúta pa nínú àgbàlá ààfin ilé",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.21",
            "verseOrgIds": [
              "2CH.24.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.24.21",
                "verseOrgIds": [
                  "2CH.24.21"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.21",
            "verseOrgIds": [
              "2CH.24.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 24:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọba Joaṣi kò rántí inú rere tí Jehoiada baba Sakariah ti fihàn án ṣùgbọ́n, ó pa ọmọ rẹ̀, tí ó wí bí ó ti ń kú lọ pé, \"Kí",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.22",
            "verseOrgIds": [
              "2CH.24.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.24.22",
                "verseOrgIds": [
                  "2CH.24.22"
                ]
              }
            }
          ]
        },
        {
          "text": "kí ó rí èyí kí ó sì pè ọ́ sí ìṣirò.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.22",
            "verseOrgIds": [
              "2CH.24.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 24:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní òpin ọdún, àwọn ọmọ-ogun Aramu yàn láti dojúkọ Joaṣi; wọ́n gbógun ti Juda àti Jerusalẹmu, wọ́n sì pa gbogbo àwọn aṣáájú àwọn ènìyàn. Wọ́n rán gbogbo àwọn ìkógun sí ọba wọn ní Damasku.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.23",
            "verseOrgIds": [
              "2CH.24.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 24:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ó ti wù kí ó rí, àwọn ọmọ-ogun Aramu ti wá pẹ̀lú àwọn ọkùnrin díẹ̀",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.24",
            "verseOrgIds": [
              "2CH.24.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.24.24",
                "verseOrgIds": [
                  "2CH.24.24"
                ]
              }
            }
          ]
        },
        {
          "text": "sì fi ọ̀pọ̀ àwọn ọmọ-ogun lé wọn lọ́wọ́, nítorí tí Juda ti kọ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.24",
            "verseOrgIds": [
              "2CH.24.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.24.24",
                "verseOrgIds": [
                  "2CH.24.24"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run àwọn baba wọn sílẹ̀. Bẹ́ẹ̀ ni wọ́n sì ṣe ìdájọ́ Joaṣi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.24",
            "verseOrgIds": [
              "2CH.24.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 24:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí àwọn ará Aramu kúrò, wọ́n fi Joaṣi sílẹ̀ pẹ̀lú ọ̀pọ̀ ọgbẹ́. Àwọn oníṣẹ́ rẹ̀ dìtẹ̀ si fún pípa ọmọ Jehoiada àlùfáà, wọ́n sì pa á ní orí ibùsùn rẹ̀. Bẹ́ẹ̀ ó sì kú, a sì sin ín sínú ìlú ńlá ti Dafidi, ṣùgbọ́n kì í ṣe nínú àwọn ibojì àwọn ọba.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.25",
            "verseOrgIds": [
              "2CH.24.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CH 24:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn tí ó dìtẹ̀ sì jẹ́ Sabadi, ọmọ Ṣimeati arábìnrin Ammoni àti Jehosabadi ọmọ Ṣimiriti arábìnrin Moabu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.26",
            "verseOrgIds": [
              "2CH.24.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 24:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àkọsílẹ̀ àwọn ọmọ rẹ̀, àwọn ọ̀pọ̀lọpọ̀ àsọtẹ́lẹ̀ nípa rẹ̀, àti àkọsílẹ̀ ti ìmúpadà sípò ilé Ọlọ́run ní a kọ sínú ìwé ìtumọ̀ ti àwọn ọba. Amasiah ọmọ rẹ̀ sì rọ́pò rẹ̀ gẹ́gẹ́ bí ọba.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.27",
            "verseOrgIds": [
              "2CH.24.27"
            ]
          }
        }
      ]
    }
