      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 5:14"
      },
      "items": [
        {
          "text": "Èmi ó fà wọ́n ya pẹ́rẹpẹ̀rẹ èmi ó sì lọ;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.14",
            "verseOrgIds": [
              "HOS.5.14"
            ]
          }
        }
