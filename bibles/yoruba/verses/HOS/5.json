      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 5:14"
      },
      "items": [
        {
          "text": "Èmi ó gbé wọn lọ, láìsí ẹni tí yóò gbà wọ́n sílẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.14",
            "verseOrgIds": [
              "HOS.5.14"
            ]
          }
