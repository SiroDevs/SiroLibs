      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 5:15"
      },
      "items": [
        {
          "text": "títí di ìgbà tí wọn ó fi gbà pé àwọn jẹ̀bi",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.15",
            "verseOrgIds": [
              "HOS.5.15"
            ]
