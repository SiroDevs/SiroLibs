    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HOS 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ̀rọ̀",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.1",
            "verseOrgIds": [
              "HOS.1.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "HOS.1.1",
                "verseOrgIds": [
                  "HOS.1.1"
                ]
              }
            }
          ]
        },
        {
          "text": "tí ó tọ Hosea ọmọ Beeri wá ní àkókò ìjọba Ussiah, Jotamu, Ahasi àti Hesekiah; àwọn ọba Juda àti ní àkókò ọba Jeroboamu ọmọ Jehoaṣi ní Israẹli.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.1",
            "verseOrgIds": [
              "HOS.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìdílé Hosea",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HOS 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.2",
            "verseOrgIds": [
              "HOS.1.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "HOS.1.2",
                "verseOrgIds": [
                  "HOS.1.2"
                ]
              }
            }
          ]
        },
        {
          "text": "bẹ̀rẹ̀ sí ní sọ̀rọ̀ láti ẹnu Hosea,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.2",
            "verseOrgIds": [
              "HOS.1.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "HOS.1.2",
                "verseOrgIds": [
                  "HOS.1.2"
                ]
              }
            }
          ]
        },
        {
          "text": "wí fún un pé, \"Lọ, fẹ́ àgbèrè obìnrin kan fún ara rẹ, kí ó sì bí ọmọ àgbèrè fún ọ nípasẹ̀ àwọn ọkùnrin mìíràn, nítorí ilẹ̀ ti ṣẹ ẹ̀ṣẹ̀ àgbèrè púpọ̀ nípa yíyapa kúrò lọ́dọ̀",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.2",
            "verseOrgIds": [
              "HOS.1.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "HOS.1.2",
                "verseOrgIds": [
                  "HOS.1.2"
                ]
              }
            }
          ]
        },
        {
          "text": ".\"",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.2",
            "verseOrgIds": [
              "HOS.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HOS 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni ó sì lọ, ó sì fẹ́ Gomeri ọmọbìnrin Diblaimu, ọmọbìnrin náà sì lóyún, ó sì bí ọmọkùnrin kan fún un.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.3",
            "verseOrgIds": [
              "HOS.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HOS 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.4",
            "verseOrgIds": [
              "HOS.1.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "HOS.1.4",
                "verseOrgIds": [
                  "HOS.1.4"
                ]
              }
            }
          ]
        },
        {
          "text": "sọ fún Hosea pé, \"Pe orúkọ ọmọ náà ní Jesreeli, nítorí pé láìpẹ́ ni èmi yóò jẹ ìdílé Jehu ní ìyà fún ẹ̀jẹ̀ àwọn ènìyàn tó pa ní ìpakúpa ní Jesreeli, Èmi yóò sì mú ìjọba Israẹli wá sí òpin.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.4",
            "verseOrgIds": [
              "HOS.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HOS 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọjọ́ náà ni Èmi yóò ṣẹ́ ọrun Israẹli ní àfonífojì Jesreeli.\"",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.5",
            "verseOrgIds": [
              "HOS.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HOS 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gomeri sì tún lóyún, ó sì bí ọmọbìnrin kan.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.6",
            "verseOrgIds": [
              "HOS.1.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "HOS.1.6",
                "verseOrgIds": [
                  "HOS.1.6"
                ]
              }
            }
          ]
        },
        {
          "text": "sọ fún un pé, \"Pe orúkọ rẹ̀ ní Lo-ruhama, nítorí pé, Èmi kò ní ṣàánú fún ilé Israẹli mọ́, Èmi kò sì ní dáríjì wọ́n.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.6",
            "verseOrgIds": [
              "HOS.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HOS 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Síbẹ̀, èmi yóò ṣàánú fún ilé Juda, èmi ó gbà wọ́n—kì í ṣe nípa ọfà, idà tàbí ogun, ẹṣin tàbí kẹ̀kẹ́ ẹlẹ́ṣin bí kò ṣe nípa",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.7",
            "verseOrgIds": [
              "HOS.1.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "HOS.1.7",
                "verseOrgIds": [
                  "HOS.1.7"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run wọn.\"",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.7",
            "verseOrgIds": [
              "HOS.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HOS 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lẹ́yìn ìgbà tí ó gba ọmú lẹ́nu Lo-ruhama, ó sì lóyún ó sì bí ọmọkùnrin mìíràn. Nígbà náà ni",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.8",
            "verseOrgIds": [
              "HOS.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HOS 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "HOS.1.9",
                "verseOrgIds": [
                  "HOS.1.9"
                ]
              }
            }
          ]
        },
        {
          "text": "sì sọ fún un pé, \"Pe orúkọ rẹ̀ ní Lo-Ammi, nítorí pé ẹ kì í ṣe ènìyàn mi, èmi náà kì í sì í ṣe Ọlọ́run yín.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.9",
            "verseOrgIds": [
              "HOS.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HOS 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ṣùgbọ́n àwọn ọmọ Israẹli yóò pọ̀ bí i iyanrìn etí Òkun tí a kò le wọ́n, tí a kò sì le è kà, yóò sì ṣe. Ní ibi tí wọ́n ti sọ fún wọn pé. 'Ẹ̀yin kì í ṣe ènìyàn mi,' níbẹ̀ ni a ó ti máa pè wọ́n ní 'Ọmọ Ọlọ́run alààyè.'",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.10",
            "verseOrgIds": [
              "HOS.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HOS 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ènìyàn Juda àti àwọn ènìyàn Israẹli yóò parapọ̀, wọn yóò sì yan olórí kan tí yóò jáde láti ilẹ̀ náà, nítorí pé ọjọ́ ńlá ni ọjọ́ Jesreeli yóò jẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.11",
            "verseOrgIds": [
              "HOS.2.2"
            ]
          }
        }
      ]
    }
  ],
