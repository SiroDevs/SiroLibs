  "verseCount": 11,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
        "style": "c",
        "sid": "HOS 6"
      },
      "items": [
        {
          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Àìronúpìwàdà Israẹli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HOS 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ẹ wá, ẹ jẹ́ kí a padà sọ́dọ̀",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.1",
            "verseOrgIds": [
              "HOS.6.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "HOS.6.1",
                "verseOrgIds": [
                  "HOS.6.1"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 6:1"
      },
      "items": [
        {
          "text": "ó ti fà wá ya pẹ́rẹpẹ̀rẹ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.1",
            "verseOrgIds": [
              "HOS.6.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 6:1"
      },
      "items": [
        {
          "text": "ṣùgbọ́n yóò mú wa láradá",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.1",
            "verseOrgIds": [
              "HOS.6.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 6:1"
      },
      "items": [
        {
          "text": "Ó ti pa wá lára",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.1",
            "verseOrgIds": [
              "HOS.6.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 6:1"
      },
      "items": [
        {
          "text": "ṣùgbọ́n yóò dí ojú ọgbẹ́ wa.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.1",
            "verseOrgIds": [
              "HOS.6.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HOS 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lẹ́yìn ọjọ́ méjì, yóò sọ wá jí",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.2",
            "verseOrgIds": [
              "HOS.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 6:2"
      },
      "items": [
        {
          "text": "ní ọjọ́ kẹta yóò mú wa padà bọ̀ sípò",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.2",
            "verseOrgIds": [
              "HOS.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 6:2"
      },
      "items": [
        {
          "text": "kí a ba à le wá gbé níwájú rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.2",
            "verseOrgIds": [
              "HOS.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HOS 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ jẹ́ kí a mọ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.3",
            "verseOrgIds": [
              "HOS.6.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "HOS.6.3",
                "verseOrgIds": [
                  "HOS.6.3"
                ]
              }
            }
          ]
        },
        {
          "text": ";",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.3",
            "verseOrgIds": [
              "HOS.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 6:3"
      },
      "items": [
        {
          "text": "ẹ jẹ́ kí a tẹ̀síwájú láti mọ̀ ọ́n.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.3",
            "verseOrgIds": [
              "HOS.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 6:3"
      },
      "items": [
        {
          "text": "Gẹ́gẹ́ bí oòrùn ṣe ń yọ,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.3",
            "verseOrgIds": [
              "HOS.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 6:3"
      },
      "items": [
        {
          "text": "yóò jáde;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.3",
            "verseOrgIds": [
              "HOS.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 6:3"
      },
      "items": [
        {
          "text": "yóò tọ̀ wá wá bí òjò,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.3",
            "verseOrgIds": [
              "HOS.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 6:3"
      },
      "items": [
        {
          "text": "bí òjò àkọ́rọ̀ ti ń bomirin ilẹ̀.\"",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.3",
            "verseOrgIds": [
              "HOS.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HOS 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kí ni èmi ó ṣe pẹ̀lú rẹ, Efraimu?",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.4",
            "verseOrgIds": [
              "HOS.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 6:4"
      },
      "items": [
        {
          "text": "Kí ni èmi ó ṣe pẹ̀lú rẹ, Juda?",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.4",
            "verseOrgIds": [
              "HOS.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 6:4"
      },
      "items": [
        {
          "text": "Ìfẹ́ rẹ dàbí ìkùùkuu òwúrọ̀",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.4",
            "verseOrgIds": [
              "HOS.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 6:4"
      },
      "items": [
        {
          "text": "bí ìrì ìdájí tí ó kọjá lọ kíákíá.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.4",
            "verseOrgIds": [
              "HOS.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HOS 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà ni mo ṣe gé e yín sí wẹ́wẹ́ láti ọwọ́ àwọn wòlíì,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.5",
            "verseOrgIds": [
              "HOS.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 6:5"
      },
      "items": [
        {
          "text": "Mo pa yín pẹ̀lú ọ̀rọ̀ ẹnu mi,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.5",
            "verseOrgIds": [
              "HOS.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 6:5"
      },
      "items": [
        {
          "text": "ìdájọ́ mi tàn bí i mọ̀nàmọ́ná lórí yín.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.5",
            "verseOrgIds": [
              "HOS.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HOS 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí àánú ni mo fẹ́, kì í ṣe ẹbọ;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.6",
            "verseOrgIds": [
              "HOS.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 6:6"
      },
      "items": [
        {
          "text": "àti ìmọ̀ Ọlọ́run ju ọrẹ ẹbọ sísun lọ.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.6",
            "verseOrgIds": [
              "HOS.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HOS 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí i Adamu, wọ́n da májẹ̀mú",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.7",
            "verseOrgIds": [
              "HOS.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 6:7"
      },
      "items": [
        {
          "text": "wọ́n jẹ́ aláìṣòótọ́ sí mi níbẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.7",
            "verseOrgIds": [
              "HOS.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HOS 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gileadi jẹ́ ìlú àwọn ènìyàn búburú",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.8",
            "verseOrgIds": [
              "HOS.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 6:8"
      },
      "items": [
        {
          "text": "tí ń ṣiṣẹ́ ẹ̀ṣẹ̀, a sí ti fi ẹ̀ṣẹ̀ bà á jẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.8",
            "verseOrgIds": [
              "HOS.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HOS 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí adigunjalè ṣe ń ba ní bùba de àwọn ènìyàn",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.9",
            "verseOrgIds": [
              "HOS.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 6:9"
      },
      "items": [
        {
          "text": "bẹ́ẹ̀ ni àwọn àlùfáà, ń parapọ̀;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.9",
            "verseOrgIds": [
              "HOS.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 6:9"
      },
      "items": [
        {
          "text": "tí wọ́n sì ń pànìyàn lójú ọ̀nà tó lọ sí Ṣekemu,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.9",
            "verseOrgIds": [
              "HOS.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 6:9"
      },
      "items": [
        {
          "text": "tí wọ́n sì ń dá ẹ̀ṣẹ̀ tí ó ti ni lójú.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.9",
            "verseOrgIds": [
              "HOS.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HOS 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mo ti rí ohun tó ba ni lẹ́rù",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.10",
            "verseOrgIds": [
              "HOS.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 6:10"
      },
      "items": [
        {
          "text": "ní ilé Israẹli.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.10",
            "verseOrgIds": [
              "HOS.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 6:10"
      },
      "items": [
        {
          "text": "Níbẹ̀ Efraimu, fi ara rẹ̀ fún àgbèrè",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.10",
            "verseOrgIds": [
              "HOS.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 6:10"
      },
      "items": [
        {
          "text": "Israẹli sì di aláìmọ́.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.10",
            "verseOrgIds": [
              "HOS.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HOS 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Àti fún ìwọ, Juda,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.11",
            "verseOrgIds": [
              "HOS.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
