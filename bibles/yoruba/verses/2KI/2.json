  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
        "style": "c",
        "sid": "2KI 2"
      },
      "items": [
        {
          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Elijah gun kẹ̀kẹ́ iná lọ sí ọ̀run",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.1",
            "verseOrgIds": [
              "2KI.2.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2KI.2.1",
                "verseOrgIds": [
                  "2KI.2.1"
                ]
              }
            }
          ]
        },
        {
          "text": "ń fẹ́ gbé Elijah lọ sí òkè ọ̀run nínú àjà, Elijah àti Eliṣa wà ní ọ̀nà láti Gilgali.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.1",
            "verseOrgIds": [
              "2KI.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elijah wí fún Eliṣa pé, \"Dúró níbí;",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.2",
            "verseOrgIds": [
              "2KI.2.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2KI.2.2",
                "verseOrgIds": [
                  "2KI.2.2"
                ]
              }
            }
          ]
        },
        {
          "text": "rán mi lọ sí Beteli.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.2",
            "verseOrgIds": [
              "2KI.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 2:2"
      },
      "items": [
        {
          "text": "Ṣùgbọ́n Eliṣa wí pé, \"Gẹ́gẹ́ bí ó ti dájú pé",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.2",
            "verseOrgIds": [
              "2KI.2.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2KI.2.2",
                "verseOrgIds": [
                  "2KI.2.2"
                ]
              }
            }
          ]
        },
        {
          "text": "wà láyé àti gẹ́gẹ́ bí ó ti yẹ, èmi kò ní fi ọ́ sílẹ̀.\" Bẹ́ẹ̀ ni wọ́n sọ̀kalẹ̀ lọ sí Beteli.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.2",
            "verseOrgIds": [
              "2KI.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ọmọ wòlíì ní Beteli jáde wá sí ọ̀dọ̀ Eliṣa wọ́n sì béèrè pé, \"Ṣé ìwọ mọ̀ pé",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.3",
            "verseOrgIds": [
              "2KI.2.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2KI.2.3",
                "verseOrgIds": [
                  "2KI.2.3"
                ]
              }
            }
          ]
        },
        {
          "text": "yóò gba ọ̀gá rẹ kúrò lọ́dọ̀ rẹ lónìí?\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.3",
            "verseOrgIds": [
              "2KI.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 2:3"
      },
      "items": [
        {
          "text": "\"Bẹ́ẹ̀ ni, èmi mọ̀,\" Eliṣa dáhùn, \"Ṣùgbọ́n ẹ má ṣe sọ̀rọ̀ nípa rẹ̀.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.3",
            "verseOrgIds": [
              "2KI.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà Elijah sì wí fún un pé, \"Dúró níbí, Eliṣa:",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.4",
            "verseOrgIds": [
              "2KI.2.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2KI.2.4",
                "verseOrgIds": [
                  "2KI.2.4"
                ]
              }
            }
          ]
        },
        {
          "text": "ti rán mi lọ sí Jeriko.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.4",
            "verseOrgIds": [
              "2KI.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 2:4"
      },
      "items": [
        {
          "text": "Ó sì dá a lóhùn pé, \"Bí ó ti dájú pé",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.4",
            "verseOrgIds": [
              "2KI.2.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2KI.2.4",
                "verseOrgIds": [
                  "2KI.2.4"
                ]
              }
            }
          ]
        },
        {
          "text": "yè àti tí ìwọ náà yè, èmi kò ní fi ọ́ sílẹ̀.\" Wọ́n sì jọ lọ sí Jeriko.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.4",
            "verseOrgIds": [
              "2KI.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ọmọ wòlíì tí ó wà ní Jeriko sì gòkè tọ Eliṣa wá wọ́n sì béèrè lọ́wọ́ rẹ̀ pé, \"Ṣé ìwọ mọ̀ wí pé",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.5",
            "verseOrgIds": [
              "2KI.2.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2KI.2.5",
                "verseOrgIds": [
                  "2KI.2.5"
                ]
              }
            }
          ]
        },
        {
          "text": "yóò gba ọ̀gá rẹ kúrò lọ́dọ̀ rẹ lónìí?\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.5",
            "verseOrgIds": [
              "2KI.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 2:5"
      },
      "items": [
        {
          "text": "\"Bẹ́ẹ̀ ni, èmi mọ̀,\" Ó dá wọn lóhùn, \"Ṣùgbọ́n ẹ má ṣe sọ nípa rẹ̀.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.5",
            "verseOrgIds": [
              "2KI.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà Elijah wí fún un pé, \"Dúró níbí;",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.6",
            "verseOrgIds": [
              "2KI.2.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2KI.2.6",
                "verseOrgIds": [
                  "2KI.2.6"
                ]
              }
            }
          ]
        },
        {
          "text": "rán mi lọ sí Jordani.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.6",
            "verseOrgIds": [
              "2KI.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 2:6"
      },
      "items": [
        {
          "text": "Ó sì dá a lóhùn pé, \"Gẹ́gẹ́ bí ó ti jẹ́ wí pé,",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.6",
            "verseOrgIds": [
              "2KI.2.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2KI.2.6",
                "verseOrgIds": [
                  "2KI.2.6"
                ]
              }
            }
          ]
        },
        {
          "text": "yè àti gẹ́gẹ́ bí o ti yè, èmi kò ní fi ọ́ sílẹ̀.\" Bẹ́ẹ̀ ni àwọn méjèèjì sì jọ ń lọ.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.6",
            "verseOrgIds": [
              "2KI.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àádọ́ta àwọn ọkùnrin ọmọ wòlíì sì lọ láti lọ dúró ní ọ̀nà jíjìn, wọ́n sì kọ ojú da ibi tí Elijah àti Eliṣa ti dúró ní Jordani.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.7",
            "verseOrgIds": [
              "2KI.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elijah sì mú agbádá ó sì ká a sókè ó sì lu omi náà pẹ̀lú rẹ̀. Omi náà sì pín sí ọ̀tún àti sí òsì, àwọn méjèèjì sì rékọjá lórí ilẹ̀ gbígbẹ.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.8",
            "verseOrgIds": [
              "2KI.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí wọ́n rékọjá, Elijah sì wí fún Eliṣa pé, \"Sọ fún mi, kí ni èmi lè ṣe fún ọ kí ó tó di wí pé wọ́n gbà mí kúrò lọ́dọ̀ rẹ?\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.9",
            "verseOrgIds": [
              "2KI.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 2:9"
      },
      "items": [
        {
          "text": "\"Jẹ́ kí èmi kí ó jogún ìlọ́po méjì ẹ̀mí rẹ.\" Ó dá a lóhùn.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.9",
            "verseOrgIds": [
              "2KI.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ìwọ ti béèrè ohun tí ó ṣòro,\" Elijah wí pé, \"Síbẹ̀ tí ìwọ bá rí mi nígbà tí a bá gbà mí kúrò lọ́wọ́ rẹ, yóò jẹ́ tìrẹ bí bẹ́ẹ̀ kọ́ kò ní rí bẹ́ẹ̀.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.10",
            "verseOrgIds": [
              "2KI.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gẹ́gẹ́ bí wọ́n ti ń rìn lọ tí wọ́n sì ń sọ̀rọ̀ pọ̀, lọ́gán kẹ̀kẹ́ iná àti ẹṣin iná yọ sí wọn ó sì ya àwọn méjèèjì nípa, Elijah sì gòkè lọ sí ọ̀run pẹ̀lú àjà.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.11",
            "verseOrgIds": [
              "2KI.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eliṣa rí èyí ó sì kígbe sókè, \"Baba mi! Baba mi! Kẹ̀kẹ́ àti ẹlẹ́ṣin Israẹli!\" Eliṣa kò sì rí i mọ́. Ó sì mú aṣọ ara rẹ̀ ó sì fà wọ́n ya sọ́tọ̀.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.12",
            "verseOrgIds": [
              "2KI.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì mú agbádá tí ó ti jábọ́ láti ọ̀dọ̀ Elijah ó sì padà lọ, ó sì dúró lórí bèbè Jordani.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.13",
            "verseOrgIds": [
              "2KI.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì mú agbádá náà tí ó jábọ́ láti ọwọ́ rẹ̀, ó sì lu omi pẹ̀lú rẹ̀. \"Níbo ni",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.14",
            "verseOrgIds": [
              "2KI.2.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2KI.2.14",
                "verseOrgIds": [
                  "2KI.2.14"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run Elijah wà?\" Ó béèrè. Nígbà tí ó lu omi náà, ó sì pín sí apá ọ̀tún àti sí òsì, Eliṣa sì rékọjá.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.14",
            "verseOrgIds": [
              "2KI.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ọmọ wòlíì láti Jeriko, tí wọ́n ń wò, wí pé, \"Ẹ̀mí Elijah sinmi lé Eliṣa.\" Wọ́n sì lọ láti lọ bá a, wọ́n sì dojúbolẹ̀ níwájú rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.15",
            "verseOrgIds": [
              "2KI.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Wò ó,\" wọ́n wí pé, \"Àwa ìránṣẹ́ ni àádọ́ta ọkùnrin alágbára. Jẹ́ kí wọ́n lọ láti lọ wá ọ̀gá rẹ wá. Bóyá ẹ̀mí",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.16",
            "verseOrgIds": [
              "2KI.2.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2KI.2.16",
                "verseOrgIds": [
                  "2KI.2.16"
                ]
              }
            }
          ]
        },
        {
          "text": "ti gbé e sókè, ó sì gbé e kalẹ̀ lórí òkè ńlá tàbí lórí ilẹ̀.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.16",
            "verseOrgIds": [
              "2KI.2.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 2:16"
      },
      "items": [
        {
          "text": "\"Rárá,\" Eliṣa dá a lóhùn pé, \"Má ṣe rán wọn.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.16",
            "verseOrgIds": [
              "2KI.2.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n wọ́n rọ̀ ọ́ títí ojú fi tì í láti gbà. Ó wí pé, \"Rán wọn.\" Wọ́n sì rán àádọ́ta ènìyàn tí ó wá a fún ọjọ́ mẹ́ta ṣùgbọ́n wọn kò rí i.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.17",
            "verseOrgIds": [
              "2KI.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí wọ́n padà dé ọ̀dọ̀ Eliṣa, tí ó dúró ní Jeriko, ó wí fún wọn pé, \"Ṣé èmi kò sọ fún un yín kí ẹ má lọ?\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.18",
            "verseOrgIds": [
              "2KI.2.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìwòsàn omi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ọkùnrin ìlú wí fún Eliṣa, pé, \"Wò ó, olúwa wa, ìtẹ̀dó ìlú yìí dára, gẹ́gẹ́ bí ẹ ti rí i, ṣùgbọ́n omi náà burú, ilẹ̀ náà sì sá.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.19",
            "verseOrgIds": [
              "2KI.2.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì wí pé, \"Mú àwokòtò tuntun fún mi wá, kí o sì mú iyọ̀ sí inú rẹ̀.\" Wọ́n sì gbé e wá fún un.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.20",
            "verseOrgIds": [
              "2KI.2.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ó sì jáde lọ sí ibi orísun omi, ó sì da iyọ̀ sí inú rẹ̀, ó wí pé, \"Èyí ni ohun tí",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.21",
            "verseOrgIds": [
              "2KI.2.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2KI.2.21",
                "verseOrgIds": [
                  "2KI.2.21"
                ]
              }
            }
          ]
        },
        {
          "text": "wí: 'Èmi ti wo omi yìí sàn. Kò ní mú ikú wá mọ́ tàbí mú ilẹ̀ náà sá.' \"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.21",
            "verseOrgIds": [
              "2KI.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omi náà sì ti dára ni mímu títí di òní, gẹ́gẹ́ bí ọ̀rọ̀ tí Eliṣa ti sọ.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.22",
            "verseOrgIds": [
              "2KI.2.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Wọ́n fi Eliṣa ṣe yẹ̀yẹ́",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Láti ibẹ̀ Eliṣa lọ sókè ní Beteli gẹ́gẹ́ bí ó ti ń rìn lọ lójú ọ̀nà, àwọn ọ̀dọ́ kan jáde wá láti ìlú náà wọ́n sì fi ṣe ẹlẹ́yà. \"Máa lọ sókè ìwọ apárí!\" Wọ́n wí pé. \"Máa lọ sókè ìwọ apárí!\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.23",
            "verseOrgIds": [
              "2KI.2.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2KI 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì yípadà, ó sì wò wọ́n ó sì fi wọ́n bú ní orúkọ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.24",
            "verseOrgIds": [
              "2KI.2.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2KI.2.24",
                "verseOrgIds": [
                  "2KI.2.24"
                ]
              }
            }
          ]
        },
        {
          "text": ". Nígbà náà beari méjì sì jáde wá láti inú igbó ó sì lu méjìlélógójì lára àwọn ọ̀dọ́ náà.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.24",
            "verseOrgIds": [
              "2KI.2.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì lọ sí orí òkè Karmeli láti ibẹ̀ ó sì padà sí Samaria.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.25",
            "verseOrgIds": [
              "2KI.2.25"
            ]
          }
        }
      ]
    }
  ],
