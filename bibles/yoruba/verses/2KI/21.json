                "verseOrgIds": [
                  "2KI.21.22"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run baba rẹ̀ sílẹ̀ kò sì rìn ní ọ̀nà ti",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.22",
            "verseOrgIds": [
              "2KI.21.22"
            ]
