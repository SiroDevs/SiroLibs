          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì ṣe búburú ní ojú",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.20",
            "verseOrgIds": [
              "2KI.21.20"
            ]
          }
