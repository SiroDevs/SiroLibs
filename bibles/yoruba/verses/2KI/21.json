          ]
        },
        {
          "text": "Àwọn ìránṣẹ́ Amoni dìtẹ̀ lórí rẹ̀ wọ́n sì lu ọba pa ní àárín ilé rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.23",
            "verseOrgIds": [
              "2KI.21.23"
            ]
          }
        },
        {
          "name": "verse",
