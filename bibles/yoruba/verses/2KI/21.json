                "verseId": "2KI.21.20",
                "verseOrgIds": [
                  "2KI.21.20"
                ]
              }
            }
          ]
        },
        {
          "text": "àti gẹ́gẹ́ bí baba rẹ̀ Manase ti ṣe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.20",
            "verseOrgIds": [
              "2KI.21.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó rìn ní gbogbo ọ̀nà baba rẹ̀: Ó sì ń sin àwọn ère tí baba rẹ̀ ń sìn, ó sì ń tẹrí rẹ̀ ba fún wọn.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.21",
            "verseOrgIds": [
