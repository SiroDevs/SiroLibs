  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "20",
        "style": "c",
        "sid": "2KI 20"
      },
      "items": [
        {
          "text": "20",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Àìsàn Hesekiah",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 20:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ayé ìgbà wọ̀n-ọn-nì Hesekiah ṣe àìsàn ó sì wà ní ojú ikú. Wòlíì Isaiah ọmọ Amosi lọ sọ́dọ̀ rẹ̀ ó sì wí pé, \"Èyí ni ohun tí",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.1",
            "verseOrgIds": [
              "2KI.20.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2KI.20.1",
                "verseOrgIds": [
                  "2KI.20.1"
                ]
              }
            }
          ]
        },
        {
          "text": "sọ: tún ilé rẹ ṣe, ṣùgbọ́n ìwọ yóò kú; o kò ní í gbádùn.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.1",
            "verseOrgIds": [
              "2KI.20.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hesekiah yí ojú rẹ̀ padà sí ògiri ó sì gbàdúrà sí",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.2",
            "verseOrgIds": [
              "2KI.20.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2KI.20.2",
                "verseOrgIds": [
                  "2KI.20.2"
                ]
              }
            }
          ]
        },
        {
          "text": "pé,",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.2",
            "verseOrgIds": [
              "2KI.20.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Rántí,",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.3",
            "verseOrgIds": [
              "2KI.20.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2KI.20.3",
                "verseOrgIds": [
                  "2KI.20.3"
                ]
              }
            }
          ]
        },
        {
          "text": "mi, bí èmi ṣe rìn níwájú rẹ àti pẹ̀lú bí èmi ṣe jẹ́ olóòtítọ́ àti pẹ̀lú gbogbo ọkàn ìfọkànsìn mi tí èmi sì ti ṣe ohun tí ó dára níwájú rẹ.\" Hesekiah sọkún kíkorò.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.3",
            "verseOrgIds": [
              "2KI.20.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kí ó tó di wí pé Isaiah jáde kúrò ní àárín àgbàlá ààfin, ọ̀rọ̀",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.4",
            "verseOrgIds": [
              "2KI.20.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2KI.20.4",
                "verseOrgIds": [
                  "2KI.20.4"
                ]
              }
            }
          ]
        },
        {
          "text": "wá sí ọ̀dọ̀ rẹ̀ pé:",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.4",
            "verseOrgIds": [
              "2KI.20.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Lọ padà kí o sì sọ fún Hesekiah, olórí àwọn ènìyàn mi pé, 'Èyí ni ohun tí",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.5",
            "verseOrgIds": [
              "2KI.20.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2KI.20.5",
                "verseOrgIds": [
                  "2KI.20.5"
                ]
              }
            }
          ]
        },
        {
          "text": ", Ọlọ́run baba rẹ Dafidi sọ: Mo ti gbọ́ àdúrà rẹ mo sì ti rí omijé rẹ, Èmi yóò wò ọ́ sàn. Ní ọjọ́ kẹta láti ìsinsin yìí, ìwọ yóò lọ sókè ilé tí a kọ́ fún",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.5",
            "verseOrgIds": [
              "2KI.20.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2KI.20.5",
                "verseOrgIds": [
                  "2KI.20.5"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.5",
            "verseOrgIds": [
              "2KI.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò fi ọdún mẹ́ẹ̀ẹ́dógún kún ọjọ́ ayé rẹ. Èmi yóò sì gbà ọ́ àti ìlú ńlá yìí láti ọwọ́ ọba Asiria. Èmi yóò sì dáàbò bo ìlú yìí nítorí ti èmi tìkára mi àti nítorí ti Dafidi ìránṣẹ́ mi.' \"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.6",
            "verseOrgIds": [
              "2KI.20.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni Isaiah wí pé, \"Mú odidi ọ̀pọ̀tọ́.\" Wọ́n sì mú un, wọ́n sì fi lé oówo náà, ara rẹ̀ sì yá.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.7",
            "verseOrgIds": [
              "2KI.20.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hesekiah sì béèrè lọ́wọ́ Isaiah pé, \"Kí ni yóò jẹ́ àmì pé",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.8",
            "verseOrgIds": [
              "2KI.20.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2KI.20.8",
                "verseOrgIds": [
                  "2KI.20.8"
                ]
              }
            }
          ]
        },
        {
          "text": "yóò wò mí sàn àti wí pé èmi yóò lọ sókè sí ilé tí a kọ́ fún",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.8",
            "verseOrgIds": [
              "2KI.20.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2KI.20.8",
                "verseOrgIds": [
                  "2KI.20.8"
                ]
              }
            }
          ]
        },
        {
          "text": "láti ọjọ́ kẹta títí di òní?\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.8",
            "verseOrgIds": [
              "2KI.20.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaiah dáhùn pé, \"Èyí ni àmì tí",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.9",
            "verseOrgIds": [
              "2KI.20.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2KI.20.9",
                "verseOrgIds": [
                  "2KI.20.9"
                ]
              }
            }
          ]
        },
        {
          "text": "fún ọ wí pé",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.9",
            "verseOrgIds": [
              "2KI.20.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2KI.20.9",
                "verseOrgIds": [
                  "2KI.20.9"
                ]
              }
            }
          ]
        },
        {
          "text": "yóò ṣe ohun tí ó ti ṣe ìlérí: kí òjìji lọ síwájú ìgbésẹ̀ mẹ́wàá, tàbí kí ó padà lọ ní ìgbésẹ̀ mẹ́wàá?\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.9",
            "verseOrgIds": [
              "2KI.20.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 20:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ó jẹ́ ohun ìrọ̀rùn fún òjìji láti lọ síwájú ìgbésẹ̀ mẹ́wàá,\" Hesekiah wí pé, \"Bẹ́ẹ̀ kọ́, jẹ́ kí ó lọ padà ní ìgbésẹ̀ mẹ́wàá.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.10",
            "verseOrgIds": [
              "2KI.20.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 20:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà wòlíì Isaiah ké pe",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.11",
            "verseOrgIds": [
              "2KI.20.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2KI.20.11",
                "verseOrgIds": [
                  "2KI.20.11"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.11",
            "verseOrgIds": [
              "2KI.20.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2KI.20.11",
                "verseOrgIds": [
                  "2KI.20.11"
                ]
              }
            }
          ]
        },
        {
          "text": "sì ṣe òjìji padà sí ìgbésẹ̀ mẹ́wàá ó ti sọ̀kalẹ̀ ní òpópó ọ̀nà Ahasi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.11",
            "verseOrgIds": [
              "2KI.20.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Oníṣẹ́ ọba láti Babeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 20:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní àkókò náà ni Merodaki-Baladani ọmọ Baladani ọba Babeli ránṣẹ́ ìwé àti ẹ̀bùn sí Hesekiah nítorí tí ó ti gbọ́ nípa àìsàn Hesekiah.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.12",
            "verseOrgIds": [
              "2KI.20.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 20:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hesekiah gba ìránṣẹ́ náà ó sì fihàn wọ́n, gbogbo ohun tí ó wà nínú ilé ìṣúra—sílífà, àti wúrà, àti tùràrí, àti òróró dáradára àti ìhámọ́ra àti gbogbo èyí tí a rí lára ìṣúra rẹ̀. Kò sí nǹkan nínú ààfin rẹ̀ tàbí nínú gbogbo ìjọba rẹ̀ tí Hesekiah kò sì fihàn wọ́n.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.13",
            "verseOrgIds": [
              "2KI.20.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 20:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà Isaiah wòlíì lọ sí ọ̀dọ̀ ọba Hesekiah ó sì béèrè pé, \"Kí ni àwọn ọkùnrin náà sọ, àti níbo ni wọ́n ti ń bọ̀ wá?\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.14",
            "verseOrgIds": [
              "2KI.20.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 20:14"
      },
      "items": [
        {
          "text": "\"Láti ìlú jíjìn réré,\" Hesekiah dáhùn. \"Wọ́n wá láti Babeli.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.14",
            "verseOrgIds": [
              "2KI.20.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 20:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wòlíì náà béèrè pé, \"Kí ni wọ́n rí ní ààfin rẹ?\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.15",
            "verseOrgIds": [
              "2KI.20.15"
            ]
          }
        }
      ]
