  "verseCount": 29,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "14",
        "style": "c",
        "sid": "2KI 14"
      },
      "items": [
        {
          "text": "14",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Amasiah ọba Juda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọdún kejì tí Jehoaṣi ọmọ Joahasi ọba Israẹli, Amasiah ọmọ Joaṣi ọba Juda bẹ̀rẹ̀ sí ní jẹ ọba.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.1",
            "verseOrgIds": [
              "2KI.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó jẹ́ ọmọ ọdún mẹ́ẹ̀ẹ́dọ́gbọ̀n nígbà tí ó di ọba, ó sì jẹ ọba ní Jerusalẹmu fún ọdún mọ́kàndínlọ́gbọ̀n. Orúkọ ìyá rẹ̀ a máa jẹ́ Jehoadani; ó wá láti Jerusalẹmu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.2",
            "verseOrgIds": [
              "2KI.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó ṣe ohun tí ó tọ́ ní ojú",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.3",
            "verseOrgIds": [
              "2KI.14.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2KI.14.3",
                "verseOrgIds": [
                  "2KI.14.3"
                ]
              }
            }
          ]
        },
        {
          "text": ", ṣùgbọ́n kì í ṣe bí i Dafidi baba a rẹ̀ tí ṣe. Nínú ohun gbogbo, ó tẹ̀lé àpẹẹrẹ baba a rẹ̀ Joaṣi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.3",
            "verseOrgIds": [
              "2KI.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ibi gíga bí ó ti wù kí ó rí, a kò sí i kúrò, àwọn ènìyàn sì tẹ̀síwájú láti rú ẹbọ àti sun tùràrí níbẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.4",
            "verseOrgIds": [
              "2KI.14.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lẹ́yìn tí ó ti fi ọwọ́ gbá ìjọba rẹ̀ mú gbọingbọin, ó pa àwọn oníṣẹ́ tí wọ́n ti pa baba a rẹ̀ ọba.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.5",
            "verseOrgIds": [
              "2KI.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Síbẹ̀ kò pa ọmọ àwọn apànìyàn náà. Ní ìbámu pẹ̀lú ohun tí a kọ sínú ìwé òfin Mose níbi tí",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.6",
            "verseOrgIds": [
              "2KI.14.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2KI.14.6",
                "verseOrgIds": [
                  "2KI.14.6"
                ]
              }
            }
          ]
        },
        {
          "text": "ti paláṣẹ pé, \"A kì yóò pa baba nítorí àwọn ọmọ, tàbí àwọn ọmọ nítorí àwọn baba; olúkúlùkù ni kí ó kú fún ẹ̀ṣẹ̀ rẹ̀.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.6",
            "verseOrgIds": [
              "2KI.14.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Òun ni ẹni tí ó ṣẹ́gun ẹgbẹ̀rún mẹ́wàá (10,000) ará Edomu ní àfonífojì iyọ̀, ó sì fi agbára mú Sela nínú ogun, tí ó ń pè é ní Jokteeli, orúkọ tí ó ní títí di òní.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.7",
            "verseOrgIds": [
              "2KI.14.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà, Amasiah rán àwọn ìránṣẹ́ sí Jehoaṣi ọmọ Jehoahasi ọmọ Jehu ọba Israẹli pẹ̀lú ìpèníjà: \"Wá, jẹ́ kí á wo ara wa ní ojú.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.8",
            "verseOrgIds": [
              "2KI.14.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n Jehoaṣi ọba Israẹli fèsì sí Amasiah ọba Juda: \"Òṣùṣú kan ní Lebanoni rán iṣẹ́ sí kedari ní Lebanoni, 'Fi ọmọbìnrin rẹ fún ọmọkùnrin mi ní ìgbéyàwó.' Nígbà náà ẹranko ẹlẹ́sẹ̀ mẹ́rin tinú igbó ní Lebanoni wá pẹ̀lú ó sì fi ẹsẹ̀ tẹ òṣùṣú náà mọ́lẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.9",
            "verseOrgIds": [
              "2KI.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ ti ṣẹ́gun Edomu pẹ̀lú, ṣùgbọ́n, nísinsin yìí ìwọ ṣe ìgbéraga. Ògo nínú ìṣẹ́gun rẹ, ṣùgbọ́n dúró nílé! Kí ni ó dé tí o fi ń wá wàhálà tí o sì fa ìṣubú rẹ àti ti Juda pẹ̀lú?\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.10",
            "verseOrgIds": [
              "2KI.14.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ó ti wù kí ó rí Amasiah kò ní tẹ́tí, bẹ́ẹ̀ ni Jehoaṣi ọba Israẹli sì dojúkọ ọ́. Òun àti Amasiah ọba Juda kọjú sí ara wọn ní Beti-Ṣemeṣi ní Juda.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.11",
            "verseOrgIds": [
              "2KI.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "A kó ipa ọ̀nà Juda nípasẹ̀ Israẹli, gbogbo àwọn ọkùnrin sì sálọ sí ilé e rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.12",
            "verseOrgIds": [
              "2KI.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehoaṣi ọba Israẹli fi agbára mú Amasiah ọba Juda, ọmọ Jehoaṣi, ọmọ Ahasiah ní Beti-Ṣemeṣi. Nígbà náà, Jehoaṣi lọ sí Jerusalẹmu, ó sì lọ wó odi Jerusalẹmu lulẹ̀ láti ìlẹ̀kùn Efraimu sí ibi igun ìlẹ̀kùn. Ìpín kan tí ó fẹ́rẹ̀ jẹ́ irinwó (400) ìgbọ̀nwọ́.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.13",
            "verseOrgIds": [
              "2KI.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó mú gbogbo wúrà àti fàdákà àti gbogbo ohun tí ó rí nínú ilé tí a kọ́ fún",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.14",
            "verseOrgIds": [
              "2KI.14.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2KI.14.14",
                "verseOrgIds": [
                  "2KI.14.14"
                ]
              }
            }
          ]
        },
        {
          "text": "àti níbi ìfowópamọ́ sí nínú ààfin ọba. Ó mú àwọn ògo, ó sì dá wọn padà sí Samaria.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.14",
            "verseOrgIds": [
              "2KI.14.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fún ti ìyókù iṣẹ́ nígbà ìjọba Jehoaṣi, gbogbo ohun tí ó ṣe pẹ̀lú àṣeyọrí rẹ̀, pẹ̀lú ogun rẹ̀ sí Amasiah ọba Juda, ṣé a kò kọ wọ́n sí inú ìwé ìtàn ayé àwọn ọba Israẹli?",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.15",
            "verseOrgIds": [
              "2KI.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehoaṣi sì sinmi pẹ̀lú àwọn baba rẹ̀, a sì sin ín sí Samaria pẹ̀lú àwọn ọba Israẹli. Jeroboamu ọmọ rẹ̀ sì rọ́pò rẹ̀ gẹ́gẹ́ bí ọba.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.16",
            "verseOrgIds": [
              "2KI.14.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amasiah ọmọ Joaṣi ọba Juda gbé fún ọdún mẹ́ẹ̀ẹ́dógún lẹ́yìn ikú Jehoaṣi ọmọ Jehoahasi ọba Israẹli.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.17",
            "verseOrgIds": [
              "2KI.14.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fún ti ìyókù iṣẹ́ rẹ̀ nígbà ìjọba Amasiah, ṣé a kò kọ wọ́n sínú ìwé ìtàn ayé àwọn ọba Juda?",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.18",
            "verseOrgIds": [
              "2KI.14.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n dìtẹ̀ sí i ní Jerusalẹmu, ó sì sálọ sí Lakiṣi, ṣùgbọ́n wọ́n rán àwọn ọkùnrin tẹ̀lé e sí Lakiṣi, wọ́n sì pa á síbẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.19",
            "verseOrgIds": [
              "2KI.14.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n gbé e padà pẹ̀lú ẹṣin, a sì sin ín sí Jerusalẹmu pẹ̀lú àwọn baba rẹ̀, ní ìlú ńlá ti Dafidi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.20",
            "verseOrgIds": [
              "2KI.14.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà, gbogbo àwọn ènìyàn Juda mú Asariah tí ó jẹ́ ọmọ ọdún mẹ́rìndínlógún. Wọ́n sì ṣe é ní ọba ní ìrọ́pò baba rẹ̀ Amasiah.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.21",
            "verseOrgIds": [
              "2KI.14.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 14:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Òun ni ẹni tí ó tún Elati kọ́, ó sì dá a padà sí Juda lẹ́yìn tí Amasiah ti sinmi pẹ̀lú àwọn baba rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.22",
            "verseOrgIds": [
              "2KI.14.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jeroboamu kejì ọba Israẹli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọdún kẹ́ẹ̀dógún tí Amasiah ọmọ Joaṣi ọba Juda, Jeroboamu ọmọ Jehoaṣi ọba Israẹli di ọba ní Samaria, ó sì jẹ ọba fún ọ̀kànlélógójì ọdún.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.23",
            "verseOrgIds": [
              "2KI.14.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2KI 14:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó ṣe búburú ní ojú",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.24",
            "verseOrgIds": [
              "2KI.14.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2KI.14.24",
                "verseOrgIds": [
                  "2KI.14.24"
                ]
              }
            }
          ]
        },
        {
          "text": "kò sì yípadà kúrò nínú ọ̀kankan nínú ẹ̀ṣẹ̀ Jeroboamu ọmọ Nebati. Èyí tí ó ti fa Israẹli láti dá.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.24",
            "verseOrgIds": [
              "2KI.14.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 14:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Òun ni ẹni tí ó ti dá àwọn ààlà Israẹli padà láti Lebo-Hamati sí òkú aginjù. Ní ìbámu pẹ̀lú ọ̀rọ̀",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.25",
            "verseOrgIds": [
              "2KI.14.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2KI.14.25",
                "verseOrgIds": [
                  "2KI.14.25"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run Israẹli, tí ó sọ nípasẹ̀ ìránṣẹ́ Jona ọmọ Amittai, wòlíì láti Gati-Heferi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.25",
            "verseOrgIds": [
              "2KI.14.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 14:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2KI.14.26",
                "verseOrgIds": [
                  "2KI.14.26"
                ]
              }
            }
          ]
        },
        {
          "text": "ti rí ìpọ́njú Israẹli pé, ó korò gidigidi, nítorí kò sí ẹrú tàbí òmìnira tàbí olùrànlọ́wọ́ kan fún Israẹli.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.26",
            "verseOrgIds": [
              "2KI.14.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 14:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Láti ìgbà tí",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.27",
            "verseOrgIds": [
              "2KI.14.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2KI.14.27",
                "verseOrgIds": [
                  "2KI.14.27"
                ]
              }
            }
          ]
        },
        {
          "text": "kò ti wí pé òhun yóò bu àbùkù lu orúkọ Israẹli láti abẹ́ ọ̀run. Ó gbà wọ́n là, lọ́wọ́ Jeroboamu ọmọ Jehoaṣi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.27",
            "verseOrgIds": [
              "2KI.14.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2KI 14:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fún ti ìyókù iṣẹ́ ìjọba Jeroboamu, gbogbo ohun tí ó ṣe àti gbogbo àwọn agbára rẹ, bí ó ti jagun sí, àti bí ó ti gba Damasku àti Hamati, tí í ṣe ti Juda, padà fún Israẹli, a kò ha kọ wọ́n sínú ìwé ìtàn ayé àwọn ọba Israẹli?",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.28",
            "verseOrgIds": [
              "2KI.14.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2KI 14:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jeroboamu sinmi pẹ̀lú àwọn baba rẹ̀, àwọn ọba Israẹli Sekariah ọmọ rẹ̀ sì rọ́pò rẹ̀ gẹ́gẹ́ bí ọba.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.29",
            "verseOrgIds": [
              "2KI.14.29"
            ]
          }
        }
      ]
    }
