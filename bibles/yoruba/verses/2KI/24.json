  "verseCount": 20,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "24",
        "style": "c",
        "sid": "2KI 24"
      },
      "items": [
        {
          "text": "24",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 24:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà ìjọba Jehoiakimu, Nebukadnessari ọba Babeli gbógun sí ilẹ̀ náà, Jehoiakimu sì di ẹrú rẹ̀ fún ọdún mẹ́ta. Ṣùgbọ́n nígbà náà ó yí ọkàn rẹ̀ padà ó sì ṣọ̀tẹ̀ sí Nebukadnessari.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.1",
            "verseOrgIds": [
              "2KI.24.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2KI.24.2",
                "verseOrgIds": [
                  "2KI.24.2"
                ]
              }
            }
          ]
        },
        {
          "text": "sì rán àwọn ará Babeli, àwọn ará Aramu, àwọn ará Moabu àti àwọn ọmọ Ammoni. Ó rán wọn láti pa Juda run, ní ìbámu pẹ̀lú ọ̀rọ̀",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.2",
            "verseOrgIds": [
              "2KI.24.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2KI.24.2",
                "verseOrgIds": [
                  "2KI.24.2"
                ]
              }
            }
          ]
        },
        {
          "text": "tí ó ti sọ nípasẹ̀ àwọn ìránṣẹ́ rẹ̀ wòlíì.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.2",
            "verseOrgIds": [
              "2KI.24.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítòótọ́ eléyìí ṣẹlẹ̀ sí Juda gẹ́gẹ́ bí àṣẹ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.3",
            "verseOrgIds": [
              "2KI.24.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2KI.24.3",
                "verseOrgIds": [
                  "2KI.24.3"
                ]
              }
            }
          ]
        },
        {
          "text": ", láti mú wọn kúrò níwájú rẹ̀ nítorí ẹ̀ṣẹ̀ Manase àti gbogbo nǹkan tí ó ṣe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.3",
            "verseOrgIds": [
              "2KI.24.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àti pẹ̀lú ẹ̀jẹ̀ aláìṣẹ̀ tí a ta sílẹ̀ nítorí ó ti kún Jerusalẹmu pẹ̀lú ẹ̀jẹ̀ aláìṣẹ̀ tí",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.4",
            "verseOrgIds": [
              "2KI.24.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2KI.24.4",
                "verseOrgIds": [
                  "2KI.24.4"
                ]
              }
            }
          ]
        },
        {
          "text": "kò sì fẹ́ láti dáríjì.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.4",
            "verseOrgIds": [
              "2KI.24.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ti ìyókù iṣẹ́ ìjọba Jehoiakimu, àti gbogbo nǹkan tí ó ṣe, ṣé wọn kò kọ wọ́n sínú ìwé ìtàn ọba Juda?",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.5",
            "verseOrgIds": [
              "2KI.24.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 24:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehoiakimu sùn pẹ̀lú baba rẹ̀, Jehoiakini ọmọ rẹ̀ sì jẹ ọba ní ipò rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.6",
            "verseOrgIds": [
              "2KI.24.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọba Ejibiti kò sì tún jáde ní ìlú rẹ̀ mọ́, nítorí ọba Babeli ti gba gbogbo agbègbè rẹ̀ láti odò Ejibiti lọ sí odò Eufurate.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.7",
            "verseOrgIds": [
              "2KI.24.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jehoiakini ọba Juda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 24:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehoiakini jẹ́ ẹni ọdún méjìdínlógún nígbà tí ó di ọba, ó sì jẹ ọba ní Jerusalẹmu fún oṣù mẹ́ta. Orúkọ ìyá rẹ̀ a sì máa jẹ́ Nehuṣita ọmọbìnrin Elnatani; ó wá láti Jerusalẹmu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.8",
            "verseOrgIds": [
              "2KI.24.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì ṣe búburú ní ojú",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.9",
            "verseOrgIds": [
              "2KI.24.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2KI.24.9",
                "verseOrgIds": [
                  "2KI.24.9"
                ]
              }
            }
          ]
        },
        {
          "text": ", gẹ́gẹ́ bí baba rẹ̀ ti ṣe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.9",
            "verseOrgIds": [
              "2KI.24.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 24:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní àkókò náà àwọn ìránṣẹ́ Nebukadnessari ọba Babeli gbé ogun wá Jerusalẹmu, wọ́n sì gbé dó ti ìlú náà,",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.10",
            "verseOrgIds": [
              "2KI.24.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 24:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebukadnessari ọba Babeli fúnra rẹ̀ wá sókè sí ìlú nígbà tí àwọn ìránṣẹ́ fi ogun dó tì í.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.11",
            "verseOrgIds": [
              "2KI.24.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 24:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehoiakini ọba Juda àti ìyá rẹ̀ àti àwọn ìránṣẹ́ rẹ̀, àti àwọn ìwẹ̀fà àti àwọn ìjòyè gbogbo wọn sì jọ̀wọ́ ara wọn fún un.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.12",
            "verseOrgIds": [
              "2KI.24.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 24:12"
      },
      "items": [
        {
          "text": "Ní ọdún kẹjọ ìjọba rẹ̀ ti ọba Babeli ó mú Jehoiakini ẹlẹ́wọ̀n.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.12",
            "verseOrgIds": [
              "2KI.24.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 24:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gẹ́gẹ́ bí",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.13",
            "verseOrgIds": [
              "2KI.24.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2KI.24.13",
                "verseOrgIds": [
                  "2KI.24.13"
                ]
              }
            }
          ]
        },
        {
          "text": "ti sọ Nebukadnessari kó gbogbo ìṣúra láti inú ilé",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.13",
            "verseOrgIds": [
              "2KI.24.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2KI.24.13",
                "verseOrgIds": [
                  "2KI.24.13"
                ]
              }
            }
          ]
        },
        {
          "text": "àti láti ilé ọba, ó sì mú u lọ gbogbo ohun èlò wúrà ti Solomoni ọba Israẹli ti kọ́ fún",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.13",
            "verseOrgIds": [
              "2KI.24.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2KI.24.13",
                "verseOrgIds": [
                  "2KI.24.13"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.13",
            "verseOrgIds": [
              "2KI.24.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 24:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó kó wọn lọ sí ìgbèkùn gbogbo Jerusalẹmu: gbogbo ìjòyè àti àwọn akọni alágbára ọkùnrin, àti gbogbo oníṣọ̀nà àti ọlọ́nà tí àpapọ̀ rẹ̀ jẹ́ ẹgbẹ̀rún mẹ́wàá (10,000), àwọn tálákà ènìyàn ilẹ̀ náà nìkan ni ó kù.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.14",
            "verseOrgIds": [
              "2KI.24.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 24:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebukadnessari mú Jehoiakini ní ìgbèkùn lọ sí Babeli. Ó sì tún mú ìyá ọba láti Jerusalẹmu lọ sí Babeli, ìyàwó rẹ̀ àwọn ìjòyè rẹ̀ àti àwọn olórí ilé náà.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.15",
            "verseOrgIds": [
              "2KI.24.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 24:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àti gbogbo àwọn ọkùnrin ọlọ́lá tí ó jẹ́ ẹ̀ẹ́dẹ́gbàárin (7,000) alágbára ọkùnrin, àti àwọn oníṣọ̀nà àti alágbẹ̀dẹ, ẹgbẹ̀rún (1,000), gbogbo àwọn alágbára tí ó yẹ fún ogun ni ọba Babeli kó ní ìgbèkùn lọ sí Babeli.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.16",
            "verseOrgIds": [
              "2KI.24.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 24:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọba Babeli sì mú Mattaniah arákùnrin baba Jehoiakini, jẹ ọba ní ìlú rẹ̀ ó sì yí orúkọ rẹ̀ padà sí Sedekiah.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.17",
            "verseOrgIds": [
              "2KI.24.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Sedekiah ọba Juda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 24:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sedekiah jẹ́ ẹni ọdún mọ́kànlélógún nígbà tí ó bẹ̀rẹ̀ sí ṣe ìjọba, ó sì jẹ ọba ní Jerusalẹmu fún ọdún mọ́kànlá. Orúkọ ìyá rẹ̀ ni Hamutali ọmọbìnrin Jeremiah; ó sì wá láti Libina.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.18",
            "verseOrgIds": [
              "2KI.24.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 24:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì ṣe búburú ní ojú",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.19",
            "verseOrgIds": [
              "2KI.24.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2KI.24.19",
                "verseOrgIds": [
                  "2KI.24.19"
                ]
              }
            }
          ]
        },
        {
          "text": ", gẹ́gẹ́ bí Jehoiakimu ti ṣe.",
          "type": "text",
          "attrs": {
