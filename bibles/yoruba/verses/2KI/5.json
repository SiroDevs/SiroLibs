  "verseCount": 27,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
        "style": "c",
        "sid": "2KI 5"
      },
      "items": [
        {
          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìwòsàn Naamani adẹ́tẹ̀",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naamani jẹ́ olórí ogun ọba Aramu. Ó jẹ́ ènìyàn ńlá níwájú ọ̀gá rẹ̀, wọ́n sì bu ọlá fún un, nítorí nípasẹ̀ rẹ̀ ni",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.1",
            "verseOrgIds": [
              "2KI.5.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2KI.5.1",
                "verseOrgIds": [
                  "2KI.5.1"
                ]
              }
            }
          ]
        },
        {
          "text": "ti fi ìṣẹ́gun fún Aramu. Òun jẹ́ alágbára, akọni ọkùnrin ṣùgbọ́n, ó dẹ́tẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.1",
            "verseOrgIds": [
              "2KI.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nísinsin yìí ẹgbẹgbẹ́ láti Aramu ti jáde lọ láti mú ọmọ obìnrin kékeré kan ní ìgbèkùn láti Israẹli, ó sì sin ìyàwó Naamani.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.2",
            "verseOrgIds": [
              "2KI.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sọ fún ọ̀gá rẹ̀ obìnrin pé, \"Tí ó bá jẹ́ wí pé ọ̀gá mi lè rí wòlíì tí ó wà ní Samaria! Yóò wò ó sàn kúrò nínú ẹ̀tẹ̀ rẹ̀.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.3",
            "verseOrgIds": [
              "2KI.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naamani lọ sí ọ̀dọ̀ ọ̀gá rẹ̀ ó sì wí fún un ohun tí ọmọbìnrin Israẹli ti sọ.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.4",
            "verseOrgIds": [
              "2KI.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ní gbogbo ọ̀nà, lọ,\" ọba Aramu dá a lóhùn pé, \"Èmi yóò fi ìwé ránṣẹ́ sí ọba Israẹli.\" Bẹ́ẹ̀ ni Naamani lọ, ó sì mú pẹ̀lú rẹ̀ tálẹ́ǹtì fàdákà mẹ́wàá, ẹgbẹ̀rún mẹ́fà (6,000) ìwọ̀n wúrà àti ìpààrọ̀ aṣọ mẹ́wàá.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.5",
            "verseOrgIds": [
              "2KI.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwé tí ó mú lọ sọ́dọ̀ ọba Israẹli kà pé, \"Pẹ̀lú ìwé yìí èmi ń rán ìránṣẹ́ mi Naamani sí ọ pé o lè wò ó sàn kúrò nínú ẹ̀tẹ̀ rẹ̀.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.6",
            "verseOrgIds": [
              "2KI.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ọba Israẹli ti ka ìwé náà ó fa aṣọ rẹ̀ ya, ó sì wí pé, \"Èmi ha jẹ́ Ọlọ́run? Ǹjẹ́ èmi le pa kí n sì mú wá sí ààyè padà? Kí ni ó dé tí eléyìí rán ènìyàn sí mi láti wo ààrùn ẹ̀tẹ̀ rẹ sàn, kí ẹ wo bí ó ti ń wá ọ̀nà láti wá ìjà pẹ̀lú mi!\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.7",
            "verseOrgIds": [
              "2KI.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí Eliṣa ènìyàn Ọlọ́run gbọ́ pé ọba Israẹli ti ya aṣọ rẹ̀, ó sì rán iṣẹ́ yìí sí i pé, \"Kí ni ó dé tí o fi fa aṣọ rẹ ya? Jẹ́ kí ọkùnrin náà wá sí ọ̀dọ̀ mi. Òun yóò sì mọ̀ pé wòlíì wà ní Israẹli.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.8",
            "verseOrgIds": [
              "2KI.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ ni Naamani sì lọ pẹ̀lú ẹṣin rẹ̀ àti kẹ̀kẹ́ rẹ̀ ó sì dúró ní ẹnu-ọ̀nà ilé Eliṣa.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.9",
            "verseOrgIds": [
              "2KI.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eliṣa rán ìránṣẹ́ láti lọ sọ fún un pé, \"Lọ, wẹ̀ ara rẹ ní ìgbà méje ní odò Jordani, ẹran-ara rẹ yóò sì tún padà bọ̀ sípò, ìwọ yóò sì mọ́.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.10",
            "verseOrgIds": [
              "2KI.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n Naamani lọ pẹ̀lú ìbínú ó sì wí pé, \"Mo lérò pé yóò sì dìde jáde wá nítòótọ́ sí mi, yóò sì pe orúkọ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.11",
            "verseOrgIds": [
              "2KI.5.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2KI.5.11",
                "verseOrgIds": [
                  "2KI.5.11"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run, fi ọwọ́ rẹ̀ lórí ibẹ̀ kí ó sì wo ẹ̀tẹ̀ mi sàn.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.11",
            "verseOrgIds": [
              "2KI.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abana àti Fapari, odò Damasku kò ha dára ju gbogbo omi Israẹli lọ? Ṣé èmi kò le wẹ̀ nínú wọn kí n sì mọ́?\" Bẹ́ẹ̀ ni ó yípadà, ó sì lọ pẹ̀lú ìrunú.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.12",
            "verseOrgIds": [
              "2KI.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìránṣẹ́ Naamani lọ sọ́dọ̀ rẹ̀ ó sì wí pé, \"Baba mi, tí wòlíì bá ti sọ fún ọ láti ṣe ohun ńlá kan, ṣé ìwọ kì bá ti ṣe, mélòó mélòó nígbà náà, nígbà tí ó sọ fún ọ pé, 'Wẹ̀ kí o sì mọ́'!\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.13",
            "verseOrgIds": [
              "2KI.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ ni ó sì sọ̀kalẹ̀ lọ ó sì tẹ ara rẹ̀ bọ inú odò Jordani ní ìgbà méje, gẹ́gẹ́ bí ènìyàn Ọlọ́run ti sọ fún un, ẹran-ara rẹ̀ sì tún padà sí mímọ́ gẹ́gẹ́ bí ọmọkùnrin kékeré.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.14",
            "verseOrgIds": [
              "2KI.5.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà Naamani àti gbogbo àwọn ìránṣẹ́ padà lọ sí ọ̀dọ̀ ènìyàn Ọlọ́run. Ó sì dúró níwájú rẹ̀ ó sì wí pé, \"Nísinsin yìí èmi mọ̀ pé kò sí Ọlọ́run ní gbogbo àgbáyé àyàfi ní Israẹli nìkan. Jọ̀wọ́ gba ẹ̀bùn láti ọwọ́ ìránṣẹ́ rẹ.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.15",
            "verseOrgIds": [
              "2KI.5.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wòlíì náà dáhùn pé, \"Gẹ́gẹ́ bí",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.16",
            "verseOrgIds": [
              "2KI.5.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2KI.5.16",
                "verseOrgIds": [
                  "2KI.5.16"
                ]
              }
            }
          ]
        },
        {
          "text": "ti ń bẹ láààyè, ẹni tí mo ń sìn, èmi kò nígbà ohun kan,\" bí ó tilẹ̀ jẹ́ pé Naamani rọ̀ ọ́ láti gbà á, ó kọ̀.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.16",
            "verseOrgIds": [
              "2KI.5.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naamani wí pé, \"Tí o kò bá nígbà, jọ̀wọ́ jẹ́ kí a fi fún èmi ìránṣẹ́ rẹ gẹ́gẹ́ bí ọ̀pọ̀ ẹrù erùpẹ̀ tí ìbáaka méjì le rù, nítorí láti òní lọ ìránṣẹ́ rẹ kì yóò rú ẹbọ sísun àti rú ẹbọ sí ọ̀kan lára àwọn ọlọ́run mìíràn mọ́ bí kò ṣe sí",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.17",
            "verseOrgIds": [
              "2KI.5.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2KI.5.17",
                "verseOrgIds": [
                  "2KI.5.17"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.17",
            "verseOrgIds": [
              "2KI.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n kí",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.18",
            "verseOrgIds": [
              "2KI.5.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2KI.5.18",
                "verseOrgIds": [
                  "2KI.5.18"
                ]
              }
            }
          ]
        },
        {
          "text": "kí ó dáríjì ìránṣẹ́ rẹ fún nǹkan yìí. Nígbà tí ọ̀gá mi wọ inú ilé Rimoni láti fi orí balẹ̀ tí ó sì fi ara ti ọwọ́ mi tí mo sì tẹ ara mi ba pẹ̀lú níbẹ̀. Nígbà tí èmi tẹ ara mi ba ní ilé Rimoni, kí",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.18",
            "verseOrgIds": [
              "2KI.5.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2KI.5.18",
                "verseOrgIds": [
                  "2KI.5.18"
                ]
              }
            }
          ]
        },
        {
          "text": "dáríjì ìránṣẹ́ rẹ fún èyí.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.18",
            "verseOrgIds": [
              "2KI.5.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eliṣa wí pé, \"Máa lọ ní àlàáfíà.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.19",
            "verseOrgIds": [
              "2KI.5.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 5:19"
      },
      "items": [
        {
          "text": "Lẹ́yìn ìgbà tí Naamani tí rin ìrìnàjò tí ó jìnnà,",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.19",
            "verseOrgIds": [
              "2KI.5.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gehasi, ìránṣẹ́ Eliṣa ènìyàn Ọlọ́run, ó wí fún ara rẹ̀ pé, \"Ọ̀gá mi jẹ́ ẹni tí ó rọ́nú lórí Naamani, ará Aramu, nípa pé kò gba ohunkóhun ní ọwọ́ rẹ̀ ohun tí ó mú wá, gẹ́gẹ́ bí",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.20",
            "verseOrgIds": [
              "2KI.5.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2KI.5.20",
                "verseOrgIds": [
                  "2KI.5.20"
                ]
              }
            }
          ]
        },
        {
          "text": "ti ń bẹ láààyè, èmi yóò sá tẹ̀lé e èmi yóò sì gba ohun kan ní ọwọ́ rẹ̀.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.20",
            "verseOrgIds": [
              "2KI.5.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ ni Gehasi sáré tẹ̀lé Naamani. Nígbà tí Naamani rí i tí ó ń sáré tẹ̀lé e, ó sì sọ̀kalẹ̀ lórí kẹ̀kẹ́ láti pàdé rẹ̀. \"Ṣé gbogbo nǹkan wà dáradára?\" ó béèrè.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.21",
            "verseOrgIds": [
              "2KI.5.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 5:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Gbogbo nǹkan wà dáradára,\" Gehasi dá a lóhùn. \"Ọ̀gá mi rán mi láti sọ wí pé, 'Àwọn ọ̀dọ́ ọmọkùnrin méjì láti ọ̀dọ̀ ọmọ wòlíì wọ́n ṣẹ̀ṣẹ̀ wá sí ọ̀dọ̀ mi láti orí òkè ìlú ti Efraimu. Jọ̀wọ́ fún wọn ní ẹ̀bùn fàdákà àti ìpààrọ̀ aṣọ méjì.' \"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.22",
            "verseOrgIds": [
              "2KI.5.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 5:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naamani wí pé, \"Ní gbogbo ọ̀nà, mú ẹ̀bùn méjì.\" Ó sì rọ Gehasi láti gbà wọ́n, ó sì di ẹ̀bùn méjì náà ti fàdákà ní inú àpò méjì, pẹ̀lú ìpààrọ̀ aṣọ méjì, ó sì fún àwọn ìránṣẹ́ rẹ̀ méjì, wọ́n sì kó wọn lọ sọ́dọ̀ Gehasi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.23",
            "verseOrgIds": [
              "2KI.5.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2KI 5:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí Gehasi sì dé ibi ilé ìṣọ́, ó gbà wọ́n lọ́wọ́ wọn, ó sì tó wọ́n sínú ilé, ó sì jọ̀wọ́ àwọn ọkùnrin náà lọ́wọ́ lọ, wọ́n sì jáde lọ.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.24",
            "verseOrgIds": [
              "2KI.5.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 5:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ó sì wọlé wá ó sì dúró níwájú ọ̀gá rẹ̀ Eliṣa.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.25",
            "verseOrgIds": [
              "2KI.5.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 5:25"
      },
      "items": [
        {
          "text": "\"Níbo ni o ti wà Gehasi?\" Eliṣa béèrè.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.25",
            "verseOrgIds": [
              "2KI.5.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 5:25"
      },
      "items": [
        {
          "text": "\"Ìránṣẹ́ rẹ kò lọ sí ibìkan kan.\" Gehasi dá a lóhùn.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.25",
            "verseOrgIds": [
              "2KI.5.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 5:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n Eliṣa wí fún un pé, \"Ẹ̀mí mi kò ha wà pẹ̀lú rẹ nígbà tí ọkùnrin náà sọ̀kalẹ̀ lórí kẹ̀kẹ́ láti pàdé rẹ? Ṣé àsìkò tí ó yẹ láti gba owó nìyìí, tàbí láti gba aṣọ, ọgbà olifi, ọgbà àjàrà, àgùntàn, màlúù tàbí ìránṣẹ́kùnrin àti ìránṣẹ́bìnrin?",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.26",
            "verseOrgIds": [
              "2KI.5.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 5:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ̀tẹ̀ Naamani yóò lẹ̀ mọ́ ọ àti sí irú-ọmọ rẹ títí láé.\" Nígbà náà Gehasi kúrò níwájú Eliṣa, ó sì di adẹ́tẹ̀, ó sì funfun gẹ́gẹ́ bí ẹ̀gbọ̀n òwú.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.27",
            "verseOrgIds": [
              "2KI.5.27"
            ]
          }
        }
      ]
    }
  ],
