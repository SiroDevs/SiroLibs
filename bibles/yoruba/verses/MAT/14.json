  "verseCount": 36,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "14",
        "style": "c",
        "sid": "MAT 14"
      },
      "items": [
        {
          "text": "14",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "A bẹ́ Johanu Onítẹ̀bọmi lórí",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní àkókò náà ni Herodu ọba tetrarki gbọ́ nípa òkìkí Jesu,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.1",
            "verseOrgIds": [
              "MAT.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ó wí fún àwọn ọmọ ọ̀dọ̀ rẹ̀ pé, \"Dájúdájú Johanu onítẹ̀bọmi ni èyí, ó jíǹde kúrò nínú òkú. Ìdí nìyí tí ó fi ní agbára láti ṣiṣẹ́ ìyanu wọ̀nyí.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.2",
            "verseOrgIds": [
              "MAT.14.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nísinsin yìí Herodu ti mú Johanu, ó fi ẹ̀wọ̀n dè é, ó sì fi sínú túbú, nítorí Herodia aya Filipi arákùnrin rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.3",
            "verseOrgIds": [
              "MAT.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "nítorí Johanu onítẹ̀bọmi ti sọ fún Herodu pé, \"Kò yẹ fún ọ láti fẹ́ obìnrin náà.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.4",
            "verseOrgIds": [
              "MAT.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Herodu fẹ́ pa Johanu, ṣùgbọ́n ó bẹ̀rù àwọn ènìyàn nítorí gbogbo ènìyàn gbàgbọ́ pé wòlíì ni.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.5",
            "verseOrgIds": [
              "MAT.14.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọjọ́ àsè ìrántí ọjọ́ ìbí Herodu, ọmọ Herodia obìnrin jó dáradára, ó sì tẹ́ Herodu lọ́run gidigidi.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.6",
            "verseOrgIds": [
              "MAT.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà ni ó ṣe fi ìbúra ṣe ìlérí láti fún un ní ohunkóhun ti ó bá béèrè fún.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.7",
            "verseOrgIds": [
              "MAT.14.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pẹ̀lú ìmọ̀ràn láti ọ̀dọ̀ ìyá rẹ̀, ó béèrè pé, \"Fún mi ni orí Johanu onítẹ̀bọmi nínú àwopọ̀kọ́\".",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.8",
            "verseOrgIds": [
              "MAT.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inú ọba bàjẹ́ gidigidi, ṣùgbọ́n nítorí ìbúra rẹ̀ àti kí ojú má ba à tì í níwájú àwọn àlejò tó wà ba jẹ àsè, ó pàṣẹ pé kí wọ́n fún un gẹ́gẹ́ bí o ti fẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.9",
            "verseOrgIds": [
              "MAT.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà, a bẹ́ orí Johanu onítẹ̀bọmi nínú ilé túbú.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.10",
            "verseOrgIds": [
              "MAT.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "A sì gbé orí rẹ̀ jáde láti fi fún ọmọbìnrin náà nínú àwopọ̀kọ́, òun sì gbà á, ó gbé e tọ ìyá rẹ̀ lọ.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.11",
            "verseOrgIds": [
              "MAT.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lẹ́yìn náà, àwọn ọmọ-ẹ̀yìn Johanu wá gba òkú rẹ̀, wọ́n sì sin ín. Wọ́n sì wá sọ ohun tí ó ṣẹlẹ̀ fún Jesu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.12",
            "verseOrgIds": [
              "MAT.14.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jesu bọ́ ẹgbẹ̀rún márùn-ún (5,000) ènìyàn",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí Jesu gbọ́ ìròyìn ìṣẹ̀lẹ̀ náà, ó kúrò níbẹ̀, ó bá ọkọ̀ ojú omi lọ sí ibi kọ́lọ́fín kan ní èbúté láti dá wà níbẹ̀. Nígbà tí wọ́n gbọ́ èyí, ọ̀pọ̀ ènìyàn sì fi ẹsẹ̀ rìn tẹ̀lé e láti ọ̀pọ̀ ìlú wọn.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.13",
            "verseOrgIds": [
              "MAT.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà ti Jesu gúnlẹ̀, tí ó sì rí ọ̀pọ̀lọpọ̀ ènìyàn, inú rẹ̀ yọ́ sí wọn, ó sì mú àwọn aláìsàn láradá.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.14",
            "verseOrgIds": [
              "MAT.14.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà ti ilẹ̀ ń ṣú lọ, àwọn ọmọ-ẹ̀yìn rẹ̀ tọ̀ ọ́ wá, wọ́n sì wí pé, \"Ibi yìí jìnnà sí ìlú ilẹ̀ sì ń ṣú lọ. Rán àwọn ènìyàn lọ sí àwọn ìletò kí wọ́n lè ra oúnjẹ jẹ.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.15",
            "verseOrgIds": [
              "MAT.14.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n Jesu fèsì pé,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.16",
            "verseOrgIds": [
              "MAT.14.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kò nílò kí wọ́n lọ kúrò. Ẹ fún wọn ní oúnjẹ.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.14.16",
                "verseOrgIds": [
                  "MAT.14.16"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n sì dalóhùn pé, \"Àwa kò ní ju ìṣù àkàrà márùn-ún àti ẹja méjì lọ níhìn-ín.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.17",
            "verseOrgIds": [
              "MAT.14.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó wí pé,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.18",
            "verseOrgIds": [
              "MAT.14.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ẹ mú wọn wá fún mi níhìn-ín yìí.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.14.18",
                "verseOrgIds": [
                  "MAT.14.18"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.18",
            "verseOrgIds": [
              "MAT.14.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lẹ́yìn náà, ó wí fún àwọn ènìyàn kí wọ́n jókòó lórí koríko. Lẹ́yìn náà, ó mú ìṣù àkàrà márùn-ún àti ẹja méjì. Ó gbé ojú rẹ̀ sí ọ̀run. Ó béèrè ìbùkún Ọlọ́run lórí oúnjẹ náà, Ó sì bù ú, ó sì fi àkàrà náà fún àwọn ọmọ-ẹ̀yìn láti pín in fún àwọn ènìyàn.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.19",
            "verseOrgIds": [
              "MAT.14.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo wọn sì jẹ àjẹyó. Lẹ́yìn náà àwọn ọmọ-ẹ̀yìn kó àjẹkù jọ, ó kún agbọ̀n méjìlá.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.20",
            "verseOrgIds": [
              "MAT.14.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye àwọn ènìyàn ni ọjọ́ náà jẹ́ ẹgbẹ̀rún márùn-ún (5,000) ọkùnrin, láìka àwọn obìnrin àti àwọn ọmọdé.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.21",
            "verseOrgIds": [
              "MAT.14.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jesu rìn lójú omi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 14:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lẹ́sẹ̀kẹsẹ̀ lẹ́yìn èyí, Jesu wí fún àwọn ọmọ-ẹ̀yìn rẹ̀ kí wọ́n bọ sínú ọkọ̀ wọn, àti kí wọ́n máa kọjá lọ ṣáájú rẹ̀ sí òdìkejì. Òun náà dúró lẹ́yìn láti tú àwọn ènìyàn ká lọ sí ilé wọn.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.22",
            "verseOrgIds": [
              "MAT.14.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lẹ́yìn tí ó tú ìjọ ènìyàn ká tán, ó gun orí òkè lọ fúnra rẹ̀ láti lọ gba àdúrà. Nígbà tí ilẹ̀ ṣú, òun wà nìkan níbẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.23",
            "verseOrgIds": [
              "MAT.14.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 14:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "ní àkókò yìí ọkọ̀ ojú omi náà ti rin jìnnà sí etí bèbè Òkun, tí ìjì omi ń tì í síwá sẹ́yìn, nítorí ìjì ṣe ọwọ́ òdì sí wọn.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.24",
            "verseOrgIds": [
              "MAT.14.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 14:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní déédé ago mẹ́rin òwúrọ̀, Jesu tọ̀ wọ́n wá, ó ń rìn lórí omi.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.25",
            "verseOrgIds": [
              "MAT.14.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 14:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí àwọn ọmọ-ẹ̀yìn rí i tí ó ń rìn lójú omi, ẹ̀rù ba wọn gidigidi, wọ́n rò pé \"iwin ni,\" wọ́n kígbe tìbẹ̀rù tìbẹ̀rù.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.26",
            "verseOrgIds": [
              "MAT.14.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 14:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lójúkan náà, Jesu wí fún wọn pé,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.27",
            "verseOrgIds": [
              "MAT.14.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ẹ mú ọkàn le! Èmi ni ẹ má ṣe bẹ̀rù.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.14.27",
                "verseOrgIds": [
                  "MAT.14.27"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 14:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Peteru sì ké sí i pé, \"Olúwa, bí ó bá jẹ́ pé ìwọ ni nítòótọ́, sọ pé kí n tọ̀ ọ́ wà lórí omi.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.28",
            "verseOrgIds": [
              "MAT.14.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 14:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu dá a lóhùn pé,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.29",
            "verseOrgIds": [
              "MAT.14.29"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ó dára, máa bọ̀ wá.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.14.29",
                "verseOrgIds": [
                  "MAT.14.29"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "MAT 14:29"
      },
      "items": [
        {
          "text": "Nígbà náà ni Peteru sọ̀kalẹ̀ láti inú ọkọ̀. Ó ń rìn lórí omi lọ sí ìhà ọ̀dọ̀ Jesu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.29",
            "verseOrgIds": [
              "MAT.14.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 14:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí ó rí afẹ́fẹ́ líle, ẹ̀rù bà á, ó sì bẹ̀rẹ̀ sí í rì. Ó kígbe lóhùn rara pé, \"Gbà mí, Olúwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.30",
            "verseOrgIds": [
              "MAT.14.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 14:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lójúkan náà, Jesu na ọwọ́ rẹ̀, ó dìímú, ó sì gbà á. Ó sì wí fún un pé,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.31",
            "verseOrgIds": [
              "MAT.14.31"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Èéṣe tí ìwọ fi ṣiyèméjì ìwọ onígbàgbọ́ kékeré?\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.14.31",
                "verseOrgIds": [
                  "MAT.14.31"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 14:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àti pé, nígbà ti wọ́n sì gòkè sínú ọkọ̀, ìjì náà sì dúró jẹ́ẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.32",
            "verseOrgIds": [
              "MAT.14.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 14:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni àwọn to wà nínú ọkọ̀ náà foríbalẹ̀ fún un wọ́n wí pé, \"Nítòótọ́ Ọmọ Ọlọ́run ni ìwọ í ṣe.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.33",
            "verseOrgIds": [
              "MAT.14.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MAT 14:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí wọn rékọjá sí apá kejì wọ́n gúnlẹ̀ sí Genesareti.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.34",
            "verseOrgIds": [
              "MAT.14.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MAT 14:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tiwọn mọ̀ pé Jesu ni, wọn sì ránṣẹ́ sí gbogbo ìlú náà yíká. Wọ́n sì gbé gbogbo àwọn aláìsàn tọ̀ ọ́ wá.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.35",
            "verseOrgIds": [
              "MAT.14.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MAT 14:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn aláìsàn bẹ̀ ẹ́ pé kí ó gba àwọn láyè láti fi ọwọ́ kan ìṣẹ́tí aṣọ rẹ̀, gbogbo àwọn tí ó ṣe bẹ́ẹ̀ sì rí ìwòsàn.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.36",
            "verseOrgIds": [
              "MAT.14.36"
            ]
          }
        }
      ]
    }
  ],
