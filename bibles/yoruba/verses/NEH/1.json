    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Àdúrà Nehemiah",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NEH 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ̀rọ̀ Nehemiah ọmọ Hakaliah.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.1.1",
            "verseOrgIds": [
              "NEH.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "NEH 1:1"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "NEH 1:1"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "NEH 1:1"
      },
      "items": [
        {
          "text": "Ní oṣù Kisleu ní ogún ọdún (ìjọba Ahaswerusi ọba Persia) nígbà tí mo wà ní ààfin Susa,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.1.1",
            "verseOrgIds": [
              "NEH.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NEH 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanani, ọ̀kan nínú àwọn arákùnrin mi wá láti Juda pẹ̀lú àwọn ọkùnrin kan, mo sì béèrè lọ́wọ́ wọn nípa àwọn Júù tí ó ṣẹ́kù tí wọn kò kó ní ìgbèkùn, àti nípa Jerusalẹmu.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.1.2",
            "verseOrgIds": [
              "NEH.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NEH 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n sọ fún mi pé, \"Àwọn tí ó kù tí a kó ní ìgbèkùn tí wọ́n sì padà sí agbègbè ìjọba wà nínú wàhálà púpọ̀ àti ẹ̀gàn. Odi Jerusalẹmu ti wó lulẹ̀ a sì ti fi iná sun ẹnu ibodè rẹ̀.\"",
          "type": "text",
          "attrs": {
            "verseId": "NEH.1.3",
            "verseOrgIds": [
              "NEH.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NEH 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí mo gbọ́ àwọn nǹkan wọ̀nyí, mo jókòó mo sì sọkún. Mo ṣọ̀fọ̀, mo gbààwẹ̀, mo sì gbàdúrà fún ọjọ́ díẹ̀ níwájú Ọlọ́run ọ̀run.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.1.4",
            "verseOrgIds": [
              "NEH.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NEH 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni mo wí pé:",
          "type": "text",
          "attrs": {
            "verseId": "NEH.1.5",
            "verseOrgIds": [
              "NEH.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "NEH 1:5"
      },
      "items": [
        {
          "text": "\"",
          "type": "text",
          "attrs": {
            "verseId": "NEH.1.5",
            "verseOrgIds": [
              "NEH.1.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "NEH.1.5",
                "verseOrgIds": [
                  "NEH.1.5"
                ]
              }
            }
          ]
        },
        {
          "text": ", Ọlọ́run ọ̀run, Ọlọ́run tí ó tóbi tí ó sì ní ẹ̀rù, tí ó ń pa májẹ̀mú ìfẹ́ rẹ̀ mọ́ pẹ̀lú wọn tí ó fẹ́ ẹ tí wọ́n sì ń pa àṣẹ mọ́.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.1.5",
            "verseOrgIds": [
              "NEH.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NEH 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jẹ́ kí etí rẹ kí ó ṣí sílẹ̀, kí ojú ù rẹ kí ó sì ṣí sílẹ̀ láti gbọ́ àdúrà tí ìránṣẹ́ rẹ ń gbà ní iwájú rẹ ní ọ̀sán àti ní òru fún àwọn ìránṣẹ́ rẹ, àwọn ènìyàn Israẹli. Mo jẹ́wọ́ ẹ̀ṣẹ̀ àwa ọmọ Israẹli àti tèmi àti ti ilé baba mi, tí a ti ṣẹ̀ sí ọ.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.1.6",
            "verseOrgIds": [
              "NEH.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NEH 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwa ti ṣe búburú sí ọ. A kò sì pa àṣẹ ìlànà àti òfin tí ìwọ fún Mose ìránṣẹ́ rẹ mọ́.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.1.7",
            "verseOrgIds": [
              "NEH.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NEH 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Rántí ìlànà tí o fún Mose ìránṣẹ́ rẹ, wí pé, 'Bí ìwọ bá jẹ́ aláìṣòótọ́, èmi yóò fọ́n yín ká sí àárín àwọn orílẹ̀-èdè.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.1.8",
            "verseOrgIds": [
              "NEH.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NEH 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n tí ẹ̀yin bá yípadà sí mi, tí ẹ bá sì pa àṣẹ mi mọ́, nígbà náà bí àwọn ènìyàn yín tí a kó ní ìgbèkùn tilẹ̀ wà ní jìnnà réré ìpẹ̀kun ọ̀run, èmi yóò kó wọn jọ láti ibẹ̀, èmi yóò sì mú wọn wá, sí ibi tí èmi ti yàn bí i ibùgbé fún orúkọ mi.'",
          "type": "text",
          "attrs": {
            "verseId": "NEH.1.9",
            "verseOrgIds": [
              "NEH.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NEH 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Àwọn ni ìránṣẹ́ rẹ àti ènìyàn rẹ àwọn tí ìwọ rà padà pẹ̀lú agbára ńlá rẹ àti ọwọ́ agbára ńlá rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.1.10",
            "verseOrgIds": [
              "NEH.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NEH 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "NEH.1.11",
                "verseOrgIds": [
                  "NEH.1.11"
                ]
              }
            }
          ]
        },
        {
          "text": ", jẹ́ kí etí rẹ ṣí sílẹ̀ sí àdúrà ìránṣẹ́ rẹ yìí, àti sí àdúrà àwọn ìránṣẹ́ rẹ tí wọ́n ní inú dídùn láti bọ̀wọ̀ fún orúkọ rẹ. Fún ìránṣẹ́ rẹ ní àṣeyọrí lónìí kí o sì síjú àánú wò ó níwájú ọkùnrin yìí.\"",
          "type": "text",
          "attrs": {
            "verseId": "NEH.1.11",
            "verseOrgIds": [
              "NEH.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "NEH 1:11"
      },
      "items": [
        {
          "text": "Nítorí tí mo jẹ́ agbọ́tí ọba nígbà náà.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.1.11",
            "verseOrgIds": [
              "NEH.1.11"
            ]
          }
        }
      ]
    }
  ],
