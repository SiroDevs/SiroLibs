    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Àwọn àlùfáà àti àwọn ọmọ Lefi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NEH 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn wọ̀nyí ni àwọn àlùfáà àti àwọn ọmọ Lefi tí ó bá Serubbabeli ọmọ Ṣealitieli àti Jeṣua padà:",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "NEH 12:1"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "NEH 12:1"
      },
      "items": [
        {
          "text": "Seraiah, Jeremiah, Esra,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.1",
            "verseOrgIds": [
              "NEH.12.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NEH 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amariah, Malluki, Hattusi,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.2",
            "verseOrgIds": [
              "NEH.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NEH 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣekaniah, Rehumu, Meremoti,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.3",
            "verseOrgIds": [
              "NEH.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NEH 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iddo, Ginetoni, Abijah,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.4",
            "verseOrgIds": [
              "NEH.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NEH 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mijamini, Moadiah, Bilgah,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.5",
            "verseOrgIds": [
              "NEH.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NEH 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣemaiah, Joiaribu, Jedaiah,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.6",
            "verseOrgIds": [
              "NEH.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NEH 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sallu, Amoki, Hilkiah, àti Jedaiah.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.7",
            "verseOrgIds": [
              "NEH.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "NEH 12:7"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4",
        "vid": "NEH 12:7"
      },
      "items": [
        {
          "text": "Wọ̀nyí ni olórí àwọn àlùfáà àti àwọn ẹlẹgbẹ́ ẹ wọn ní ìgbà ayé e Jeṣua.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NEH 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ọmọ Lefi ni Jeṣua, Binnui, Kadmieli, Ṣerebiah, Juda àti Mattaniah ẹni tí òun pẹ̀lú àwọn ẹlẹgbẹ́ rẹ̀, ni wọn ṣe àkóso orin ìdúpẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.8",
            "verseOrgIds": [
              "NEH.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NEH 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakbukiah àti Unni, àwọn ẹlẹgbẹ́ wọn dúró sí òdìkejì wọn nínú ìsìn.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.9",
            "verseOrgIds": [
              "NEH.12.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NEH 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jeṣua ni baba Joiakimu,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.10",
            "verseOrgIds": [
              "NEH.12.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "NEH 12:10"
      },
      "items": [
        {
          "text": "Joiakimu ni baba Eliaṣibu,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.10",
            "verseOrgIds": [
              "NEH.12.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "NEH 12:10"
      },
      "items": [
        {
          "text": "Eliaṣibu ni baba Joiada,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.10",
            "verseOrgIds": [
              "NEH.12.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NEH 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joiada ni baba Jonatani,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.11",
            "verseOrgIds": [
              "NEH.12.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "NEH 12:11"
      },
      "items": [
        {
          "text": "Jonatani sì ni baba Jaddua.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.11",
            "verseOrgIds": [
              "NEH.12.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NEH 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ìgbé ayé Joiakimu, wọ̀nyí ni àwọn olórí àwọn ìdílé àwọn àlùfáà:",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "NEH 12:12"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "NEH 12:12"
      },
      "items": [
        {
          "text": "ti ìdílé Seraiah, Meraiah;",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.12",
            "verseOrgIds": [
              "NEH.12.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "NEH 12:12"
      },
      "items": [
        {
          "text": "ti ìdílé Jeremiah, Hananiah;",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.12",
            "verseOrgIds": [
              "NEH.12.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
