  "verseCount": 29,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
        "style": "c",
        "sid": "1JN 2"
      },
      "items": [
        {
          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1JN 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ̀yin ọmọ mi ọ̀wọ́n, mo kọ ìwé nǹkan wọ̀nyí sí yín, kí ẹ̀yin má bà á dẹ́ṣẹ̀. Ṣùgbọ́n bí ẹnikẹ́ni bá sì dẹ́ṣẹ̀, àwa ni alágbàwí lọ́dọ̀ Baba: Jesu Kristi, olódodo nìkan.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.1",
            "verseOrgIds": [
              "1JN.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1JN 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Òun sì ní ètùtù fún ẹ̀ṣẹ̀ wa, kì í tilẹ̀ ṣe fún tiwa nìkan ṣùgbọ́n fún ẹ̀ṣẹ̀ gbogbo aráyé.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.2",
            "verseOrgIds": [
              "1JN.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1JN 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwa mọ̀ pé àwa ti wá mọ̀ ọ́n, bí àwa bá ń pa òfin rẹ̀ mọ́.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.3",
            "verseOrgIds": [
              "1JN.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1JN 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹni tí ó bá wí pé, \"Èmi mọ̀ ọ́n,\" tí kò sì pa òfin rẹ̀ mọ́, èké ni, òtítọ́ kò sì ṣí nínú rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.4",
            "verseOrgIds": [
              "1JN.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1JN 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n ẹnikẹ́ni tí ó bá ń pa òfin rẹ̀ mọ́, lára rẹ̀ ni a gbé mú ìfẹ́ Ọlọ́run pé nítòótọ́. Nípa èyí ni àwa mọ̀ pé àwa ń wà nínú rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.5",
            "verseOrgIds": [
              "1JN.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1JN 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹnikẹ́ni tí ó bá wí pé òun ń gbé inú rẹ̀, òun náà pẹ̀lú sì yẹ láti máa rìn gẹ́gẹ́ bí Jesu ti rìn.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.6",
            "verseOrgIds": [
              "1JN.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1JN 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ̀yin olùfẹ́ ọ̀wọ́n, kì í ṣe òfin tuntun ni mo ń kọ̀wé rẹ̀ sí yín ṣùgbọ́n òfin àtijọ́, èyí tí ẹ̀yin tí gbọ́ ní àtètèkọ́ṣe. Òfin àtijọ́ ni ọ̀rọ̀ náà tí ẹ̀yin tí gbọ́.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.7",
            "verseOrgIds": [
              "1JN.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1JN 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pẹ̀lúpẹ̀lú, òfin tuntun ni mo ń kọ̀wé rẹ̀ sí yín; èyí tí í ṣe òtítọ́ nínú rẹ̀ àti nínú yin, nítorí òkùnkùn ń kọjá lọ, ìmọ́lẹ̀ òtítọ́ sì tí ń tàn.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.8",
            "verseOrgIds": [
              "1JN.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1JN 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹni tí ó bá sì wí pé òun ń wà nínú ìmọ́lẹ̀, tí ó sì kórìíra arákùnrin rẹ̀ sì ń bẹ nínú òkùnkùn.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.9",
            "verseOrgIds": [
              "1JN.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1JN 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹni tí ó ba fẹ́ràn arákùnrin rẹ̀, ó ń gbé inú ìmọ́lẹ̀, kò sì ṣí ohun ìkọ̀sẹ̀ kan nínú rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.10",
            "verseOrgIds": [
              "1JN.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1JN 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n ẹni tí o bá kórìíra arákùnrin rẹ̀ ń gbé nínú òkùnkùn, ó sì ń rìn nínú òkùnkùn; kò sì mọ ibi tí òun ń lọ, nítorí tí òkùnkùn tí fọ́ ọ lójú.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.11",
            "verseOrgIds": [
              "1JN.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1JN 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi ń kọ̀wé sí yín, ẹ̀yin ọmọ mi ọ̀wọ́n,",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.12",
            "verseOrgIds": [
              "1JN.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1JN 2:12"
      },
      "items": [
        {
          "text": "nítorí tí a darí ẹ̀ṣẹ̀ yín jì yín nítorí orúkọ rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.12",
            "verseOrgIds": [
              "1JN.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1JN 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi ń kọ̀wé sí yín, ẹ̀yin baba,",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.13",
            "verseOrgIds": [
              "1JN.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1JN 2:13"
      },
      "items": [
        {
          "text": "nítorí tí ẹ̀yin tí mọ ẹni tí ó wà ní àtètèkọ́ṣe,",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.13",
            "verseOrgIds": [
              "1JN.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "1JN 2:13"
      },
      "items": [
        {
          "text": "Èmi ń kọ̀wé sí yín, ẹ̀yin ọ̀dọ́mọkùnrin,",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.13",
            "verseOrgIds": [
              "1JN.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1JN 2:13"
      },
      "items": [
        {
          "text": "nítorí tí ẹ̀yin ti ṣẹ́gun ẹni ibi náà.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.13",
            "verseOrgIds": [
              "1JN.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1JN 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi ń kọ̀wé sí yín, ẹ̀yin ọmọdé mi ọ̀wọ́n,",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.14",
            "verseOrgIds": [
              "1JN.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1JN 2:14"
      },
      "items": [
        {
          "text": "nítorí ẹ̀yin ti mọ Baba.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.14",
            "verseOrgIds": [
              "1JN.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "1JN 2:14"
      },
      "items": [
        {
          "text": "Èmi ń kọ̀wé sí yín, ẹ̀yin baba,",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.14",
            "verseOrgIds": [
              "1JN.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1JN 2:14"
      },
      "items": [
        {
          "text": "nítorí ti ẹ̀yin tí mọ ẹni tí o wà ni àtètèkọ́ṣe.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.14",
            "verseOrgIds": [
              "1JN.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "1JN 2:14"
      },
      "items": [
        {
          "text": "Èmi ń kọ̀wé sí yín, ẹ̀yin ọ̀dọ́mọkùnrin,",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.14",
            "verseOrgIds": [
              "1JN.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1JN 2:14"
      },
      "items": [
        {
          "text": "nítorí tí ẹ̀yin ni agbára,",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.14",
            "verseOrgIds": [
              "1JN.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1JN 2:14"
      },
      "items": [
        {
          "text": "tí ọ̀rọ̀ Ọlọ́run sì ń gbé nínú yín,",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.14",
            "verseOrgIds": [
              "1JN.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1JN 2:14"
      },
      "items": [
        {
          "text": "tí ẹ sì ṣẹ́gun ẹni ibi náà.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.14",
            "verseOrgIds": [
              "1JN.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ẹ má ṣe fẹ́ràn ayé",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1JN 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ má ṣe fẹ́ràn ayé tàbí ohunkóhun tí ń bẹ nínú ayé. Bí ẹnikẹ́ni bá fẹ́ràn ayé, ìfẹ́ tí Baba kò sí nínú rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.15",
            "verseOrgIds": [
              "1JN.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1JN 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí ohun gbogbo tí ń bẹ nínú ayé: ìfẹ́kúfẹ̀ẹ́ ti ara, ìfẹ́kúfẹ̀ẹ́ ti ojú, àti ìgbéraga ti ohun ti ó ní àti ohun tí ó ṣe kò wá láti ọ̀dọ̀ Baba bí kò ṣe láti ọwọ́ ayé.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.16",
            "verseOrgIds": [
              "1JN.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1JN 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayé sì ń kọjá lọ àti ìfẹ́kúfẹ̀ẹ́ rẹ̀, ṣùgbọ́n ẹni tí ó ba ń ṣe ìfẹ́ Ọlọ́run ni yóò wà títí láéláé.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.17",
            "verseOrgIds": [
              "1JN.2.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìkìlọ̀ nípa àwọn aṣòdì sí Kristi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1JN 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ̀yin ọmọ mi ọ̀wọ́n, ìgbà ìkẹyìn ni èyí; bí ẹ̀yin sì tí gbọ́ pé aṣòdì sí Kristi ń bọ̀ wá, àní nísinsin yìí, púpọ̀ aṣòdì sí Kristi ló ń bẹ. Nípa èyí ni àwa fi mọ́ pé ìgbà ìkẹyìn ni èyí.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.18",
            "verseOrgIds": [
              "1JN.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1JN 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n ti ọ̀dọ̀ wá jáde, ṣùgbọ́n wọn kì í ṣe ara wa. Nítorí bí wọ́n bá jẹ́ ara wa, wọn ìbá bá wa dúró, ṣùgbọ́n jíjáde lọ wọn fihàn pé gbogbo wọn kì í ṣe ara wa.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.19",
            "verseOrgIds": [
              "1JN.2.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1JN 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n ẹ̀yin ní ìfòróróyàn láti ọ̀dọ̀ Ẹ̀mí Mímọ́ wá, gbogbo yín sì mọ òtítọ́.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.20",
            "verseOrgIds": [
              "1JN.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1JN 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi kò kọ̀wé sí yín nítorí pé ẹ̀yin kò mọ òtítọ́, ṣùgbọ́n nítorí tí ẹ̀yin mọ̀ ọ́n, àti pé kò sí èké nínú òtítọ́.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.21",
            "verseOrgIds": [
              "1JN.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1JN 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ta ni èké? Ẹni tí ó sẹ́ pé Jesu kì í ṣe Kristi. Eléyìí ni Aṣòdì sí Kristi, ẹni tí ó sẹ́ Baba àti Ọmọ.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.22",
            "verseOrgIds": [
              "1JN.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1JN 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹnikẹ́ni tí o ba sẹ́ Ọmọ, kò gba Baba; ṣùgbọ́n ẹni tí ó ba jẹ́wọ́ Ọmọ, ó gba Baba pẹ̀lú.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.23",
            "verseOrgIds": [
              "1JN.2.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1JN 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ jẹ́ kí èyí tí ẹ tí gbọ́ ni àtètèkọ́ṣe máa gbé inú yín. Bí èyí tí ẹ̀yin tí gbọ́ ní àtètèkọ́ṣe bá ń gbé inú yín, ẹ̀yin ó sì dúró nínú Ọmọ àti nínú Baba.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.24",
            "verseOrgIds": [
              "1JN.2.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1JN 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èyí sì ni ìlérí náà tí ó tí ṣe fún wa, àní ìyè àìnípẹ̀kun.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.25",
            "verseOrgIds": [
              "1JN.2.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1JN 2:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nǹkan wọ̀nyí ni mo kọ̀wé sí yín ní ti àwọn tí wọ́n fẹ́ ẹ mú yín ṣìnà.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.26",
            "verseOrgIds": [
              "1JN.2.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1JN 2:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n ní ti ìfòróróyàn tí ẹ̀yín gba lọ́wọ́ rẹ̀ ṣì ń gbé inú yín, ẹ̀yin kò tún nílò pé kí ẹnìkan kọ yín. Ṣùgbọ́n bí ìfòróróyàn náà ti ń kọ́ yín ní ohun gbogbo tí ó jẹ́ òtítọ́, tí kì í sì í ṣe èké, àní gẹ́gẹ́ bí ó sì ti kọ́ yín, ẹ máa gbé inú rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.27",
            "verseOrgIds": [
              "1JN.2.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Àwọn ọmọ Ọlọ́run",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1JN 2:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àti nísinsin yìí, ẹ̀yin ọmọ mi ọ̀wọ́n, ẹ máa gbé inú rẹ̀, pé nígbà tí òun ó bá farahàn, kí a lè ni ìgboyà níwájú rẹ̀, kí ojú má sì tì wá níwájú rẹ̀ ni ìgbà wíwá rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.28",
            "verseOrgIds": [
              "1JN.2.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1JN 2:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ẹ̀yin ba mọ̀ pé olódodo ni òun, ẹ mọ̀ pé a bí olúkúlùkù ẹni tí ń ṣe òdodo nípa rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.29",
            "verseOrgIds": [
              "1JN.2.29"
            ]
          }
        }
      ]
    }
