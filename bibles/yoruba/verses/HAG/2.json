  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
        "style": "c",
        "sid": "HAG 2"
      },
      "items": [
        {
          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ẹwà Tẹmpili tuntun náà",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HAG 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọjọ́ kọkànlélógún oṣù keje, ni ọ̀rọ̀",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.1",
            "verseOrgIds": [
              "HAG.2.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "HAG.2.1",
                "verseOrgIds": [
                  "HAG.2.1"
                ]
              }
            }
          ]
        },
        {
          "text": "wá nípasẹ̀ wòlíì Hagai wí pé,",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.1",
            "verseOrgIds": [
              "HAG.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HAG 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Sọ fún Serubbabeli ọmọ Ṣealitieli, baálẹ̀ Juda, àti Joṣua ọmọ Josadaki, olórí àlùfáà àti àwọn ènìyàn yòókù. Béèrè lọ́wọ́ wọn pé,",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.2",
            "verseOrgIds": [
              "HAG.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HAG 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "'Ta ni nínú yín tí ó kù tí ó sì ti rí ilé yìí ní ògo rẹ̀ àkọ́kọ́? Báwo ni ó ṣe ri sí yín nísinsin yìí? Ǹjẹ́ kò dàbí asán lójú yín?",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.3",
            "verseOrgIds": [
              "HAG.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HAG 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n nísinsin yìí, múra gírí, ìwọ Serubbabeli,' ni",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.4",
            "verseOrgIds": [
              "HAG.2.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "HAG.2.4",
                "verseOrgIds": [
                  "HAG.2.4"
                ]
              }
            }
          ]
        },
        {
          "text": "wí. 'Múra gírí, ìwọ Joṣua ọmọ Josadaki, olórí àlùfáà. Ẹ sì múra gírí gbogbo ẹ̀yin ènìyàn ilẹ̀ náà,' ni",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.4",
            "verseOrgIds": [
              "HAG.2.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "HAG.2.4",
                "verseOrgIds": [
                  "HAG.2.4"
                ]
              }
            }
          ]
        },
        {
          "text": "wí, 'kí ẹ sì ṣiṣẹ́. Nítorí èmi wà pẹ̀lú yín,' ni",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.4",
            "verseOrgIds": [
              "HAG.2.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "HAG.2.4",
                "verseOrgIds": [
                  "HAG.2.4"
                ]
              }
            }
          ]
        },
        {
          "text": "àwọn ọmọ-ogun wí.",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.4",
            "verseOrgIds": [
              "HAG.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HAG 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "'Èyí ni ohun tí Èmi fi bá a yín dá májẹ̀mú nígbà tí ẹ jáde kúrò ní Ejibiti, bẹ́ẹ̀ ni Ẹ̀mí ì mi sì wà pẹ̀lú yín. Ẹ má ṣe bẹ̀rù.'",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.5",
            "verseOrgIds": [
              "HAG.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HAG 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Báyìí ni",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.6",
            "verseOrgIds": [
              "HAG.2.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "HAG.2.6",
                "verseOrgIds": [
                  "HAG.2.6"
                ]
              }
            }
          ]
        },
        {
          "text": "àwọn ọmọ-ogun wí pé, 'Láìpẹ́ jọjọ, Èmi yóò mi àwọn ọrun àti ayé, Òkun àti ìyàngbẹ ilẹ̀ lẹ́ẹ̀kan sí i.",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.6",
            "verseOrgIds": [
              "HAG.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HAG 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò mi gbogbo orílẹ̀-èdè, ìfẹ́ gbogbo orílẹ̀-èdè yóò fà sí tẹmpili yìí, Èmi yóò sì kún ilé yìí pẹ̀lú ògo,' ni",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.7",
            "verseOrgIds": [
              "HAG.2.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "HAG.2.7",
                "verseOrgIds": [
                  "HAG.2.7"
                ]
              }
            }
          ]
        },
        {
          "text": "àwọn ọmọ-ogun wí.",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.7",
            "verseOrgIds": [
              "HAG.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HAG 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "'Tèmi ni fàdákà àti wúrà,' ni",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.8",
            "verseOrgIds": [
              "HAG.2.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "HAG.2.8",
                "verseOrgIds": [
                  "HAG.2.8"
                ]
              }
            }
          ]
        },
        {
          "text": "àwọn ọmọ-ogun wí.",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.8",
            "verseOrgIds": [
              "HAG.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HAG 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "'Ògo ìkẹyìn ilé yìí yóò pọ̀ ju ti ìṣáájú lọ,' ni",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.9",
            "verseOrgIds": [
              "HAG.2.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "HAG.2.9",
                "verseOrgIds": [
                  "HAG.2.9"
                ]
              }
            }
          ]
        },
        {
          "text": "àwọn ọmọ-ogun wí, 'Àti ní ìhín yìí ni Èmi ó sì fi àlàáfíà fún ni,' ni",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.9",
            "verseOrgIds": [
              "HAG.2.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "HAG.2.9",
                "verseOrgIds": [
                  "HAG.2.9"
                ]
              }
            }
          ]
        },
        {
          "text": "àwọn ọmọ-ogun wí.\"",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.9",
            "verseOrgIds": [
              "HAG.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìbùkún fún àwọn ènìyàn tí a sọ di àìmọ́",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HAG 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọjọ́ kẹrìnlélógún oṣù kẹsànán ní ọdún kejì Dariusi, ni ọ̀rọ̀",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.10",
            "verseOrgIds": [
              "HAG.2.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "HAG.2.10",
                "verseOrgIds": [
                  "HAG.2.10"
                ]
              }
            }
          ]
        },
        {
          "text": "tọ wòlíì Hagai wá pé,",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.10",
            "verseOrgIds": [
              "HAG.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HAG 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Báyìí ni",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.11",
            "verseOrgIds": [
              "HAG.2.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "HAG.2.11",
                "verseOrgIds": [
                  "HAG.2.11"
                ]
              }
            }
          ]
        },
        {
          "text": "àwọn ọmọ-ogun wí, 'Béèrè lọ́wọ́ àwọn àlùfáà ohun tí òfin wí pé:",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.11",
            "verseOrgIds": [
              "HAG.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HAG 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ẹnìkan bá gbé ẹran mímọ́ ní ìṣẹ́tí aṣọ rẹ̀, tí ìṣẹ́tí aṣọ rẹ̀ kan àkàrà tàbí ọbẹ̀, wáìnì, òróró tàbí oúnjẹ mìíràn, ǹjẹ́ yóò ha jẹ́ mímọ́ bí?' \"",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.12",
            "verseOrgIds": [
              "HAG.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "HAG 2:12"
      },
      "items": [
        {
          "text": "Àwọn àlùfáà sì dáhùn wí pé, \"Bẹ́ẹ̀ kọ́.\"",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.12",
            "verseOrgIds": [
              "HAG.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HAG 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni Hagai wí pé, \"Bí ẹnìkan tí ó jẹ́ aláìmọ́ nípa fífi ara kan òkú bá fi ara kan ọ̀kan lára nǹkan wọ̀nyí, ǹjẹ́ yóò ha jẹ́ aláìmọ́?\"",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.13",
            "verseOrgIds": [
              "HAG.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "HAG 2:13"
      },
      "items": [
        {
          "text": "Àwọn àlùfáà sì dáhùn wí pé, \"Bẹ́ẹ̀ ni, yóò jẹ́ aláìmọ́.\"",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.13",
            "verseOrgIds": [
              "HAG.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HAG 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni Hagai dáhùn ó sì wí pé, \" 'Bẹ́ẹ̀ ni ènìyàn wọ̀nyí rí, bẹ́ẹ̀ sì ni orílẹ̀-èdè yìí rí níwájú mi,' ni",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.14",
            "verseOrgIds": [
              "HAG.2.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "HAG.2.14",
                "verseOrgIds": [
                  "HAG.2.14"
                ]
              }
            }
          ]
        },
        {
          "text": "wí. 'Bẹ́ẹ̀ sì ni olúkúlùkù iṣẹ́ ọwọ́ wọn; èyí tí wọ́n sì fi rú ẹbọ níbẹ̀ jẹ́ aláìmọ́.",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.14",
            "verseOrgIds": [
              "HAG.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "HAG 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ǹjẹ́ nísinsin yìí, ẹ ro èyí dáradára láti òní yìí lọ, ẹ kíyèsi bí nǹkan ṣe rí tẹ́lẹ̀, a to òkúta kan lé orí èkejì ní tẹmpili",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.15",
            "verseOrgIds": [
              "HAG.2.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "HAG.2.15",
                "verseOrgIds": [
                  "HAG.2.15"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.15",
            "verseOrgIds": [
              "HAG.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "HAG 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí ẹnikẹ́ni bá dé ibi òkìtì òsùwọ̀n ogun, mẹ́wàá péré ni yóò ba níbẹ̀. Nígbà tí ẹnikẹ́ni bá dé ibi ìfúntí wáìnì láti wọn àádọ́ta ìwọ̀n, ogún péré ni yóò ba níbẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.16",
            "verseOrgIds": [
              "HAG.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "HAG 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mo fi ìrẹ̀dànù, ìmúwòdù àti yìnyín bá gbogbo iṣẹ́ ọwọ́ yín jẹ; síbẹ̀ ẹ̀yin kò yípadà sí ọ̀dọ̀ mi,' ni",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.17",
            "verseOrgIds": [
              "HAG.2.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "HAG.2.17",
                "verseOrgIds": [
                  "HAG.2.17"
                ]
              }
            }
          ]
        },
        {
          "text": "wí.",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.17",
            "verseOrgIds": [
              "HAG.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "HAG 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "'Láti òní lọ, láti ọjọ́ kẹrìnlélógún oṣù kẹsànán yìí kí ẹ kíyèsi, kí ẹ sì rò ó dáradára, ọjọ́ ti a fi ìpìlẹ̀ tẹmpili",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.18",
            "verseOrgIds": [
              "HAG.2.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "HAG.2.18",
                "verseOrgIds": [
                  "HAG.2.18"
                ]
              }
            }
          ]
        },
        {
          "text": "lélẹ̀, rò ó dáradára.",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.18",
            "verseOrgIds": [
              "HAG.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "HAG 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ǹjẹ́ èso ha wà nínú abà bí? Títí di àkókò yìí, àjàrà àti igi ọ̀pọ̀tọ́ àti pomegiranate, àti igi olifi kò ì tí ì so èso kankan.",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.19",
            "verseOrgIds": [
              "HAG.2.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "HAG 2:19"
      },
      "items": [
        {
          "text": "\" 'Láti òní lọ ni èmi yóò bùkún fún un yin.' \"",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.19",
            "verseOrgIds": [
              "HAG.2.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Serubbabeli òrùka èdìdì",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "HAG 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ̀rọ̀",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.20",
            "verseOrgIds": [
              "HAG.2.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "HAG.2.20",
                "verseOrgIds": [
                  "HAG.2.20"
                ]
              }
            }
          ]
        },
        {
          "text": "sì tún tọ Hagai wá nígbà kejì, ní ọjọ́ kẹrìnlélógún oṣù náà pé,",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.20",
            "verseOrgIds": [
              "HAG.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "HAG 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Sọ fún Serubbabeli baálẹ̀ Juda pé èmi yóò mi àwọn ọ̀run àti ayé.",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.21",
            "verseOrgIds": [
              "HAG.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "HAG 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò bi ìtẹ́ àwọn ìjọba ṣubú, Èmi yóò sì pa agbára àwọn aláìkọlà run, Èmi yóò sì dojú àwọn kẹ̀kẹ́ ogun dé, àti àwọn tí ń gùn wọ́n; ẹṣin àti àwọn ẹlẹ́ṣin yóò ṣubú; olúkúlùkù nípa idà arákùnrin rẹ̀.\"",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.22",
            "verseOrgIds": [
              "HAG.2.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "HAG 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "HAG.2.23",
                "verseOrgIds": [
                  "HAG.2.23"
                ]
              }
            }
          ]
        },
        {
          "text": "àwọn ọmọ-ogun wí pé, \"Ní ọjọ́ náà, ìwọ ìránṣẹ́ mi Serubbabeli ọmọ Ṣealitieli, Èmi yóò mú ọ, Èmi yóò sì sọ ọ di bí òrùka èdìdì mi, nítorí mo ti yan ọ, ni",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.23",
            "verseOrgIds": [
              "HAG.2.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "HAG.2.23",
                "verseOrgIds": [
                  "HAG.2.23"
                ]
              }
            }
          ]
        },
        {
          "text": "àwọn ọmọ-ogun wí.\"",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.23",
            "verseOrgIds": [
              "HAG.2.23"
            ]
          }
        }
      ]
    }
