              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ ní Joṣua sì gbà wọ́n là kúrò ní ọwọ́ àwọn ọmọ Israẹli. Wọn kò sì pa wọ́n.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.26",
            "verseOrgIds": [
              "JOS.9.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JOS 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọjọ́ náà ni ó sọ àwọn Gibeoni di aṣẹ́gi àti apọnmi fún àwọn ará ìlú àti fún pẹpẹ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.27",
            "verseOrgIds": [
              "JOS.9.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JOS.9.27",
                "verseOrgIds": [
                  "JOS.9.27"
                ]
              }
            }
          ]
        },
        {
          "text": "ní ibi tí",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.27",
            "verseOrgIds": [
              "JOS.9.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
