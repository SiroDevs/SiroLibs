  "verseCount": 15,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "14",
        "style": "c",
        "sid": "JOS 14"
      },
      "items": [
        {
          "text": "14",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Pínpín ilẹ̀ ìhà ìwọ̀-oòrùn Jordani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ̀nyí ni ilẹ̀ tí àwọn ọmọ Israẹli gbà gẹ́gẹ́ bí ogún ní ilẹ̀ Kenaani, tí Eleasari àlùfáà, Joṣua ọmọ Nuni àti olórí ẹ̀yà àwọn agbo ilé Israẹli pín fún wọn.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.1",
            "verseOrgIds": [
              "JOS.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìbò ni a fi pín ìní wọn fún àwọn ẹ̀yà mẹ́sàn-án ààbọ̀ gẹ́gẹ́ bí",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.2",
            "verseOrgIds": [
              "JOS.14.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JOS.14.2",
                "verseOrgIds": [
                  "JOS.14.2"
                ]
              }
            }
          ]
        },
        {
          "text": "ti pàṣẹ láti ọwọ́ Mose.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.2",
            "verseOrgIds": [
              "JOS.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose ti fún àwọn ẹ̀yà méjì àti ààbọ̀ ní ogún wọn ní ìlà-oòrùn Jordani, ṣùgbọ́n àwọn ọmọ Lefi ni kò fi ìní fún ní àárín àwọn tí ó kù.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.3",
            "verseOrgIds": [
              "JOS.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ọmọ Josẹfu sì di ẹ̀yà méjì, Manase àti Efraimu. Àwọn ọmọ Lefi kò gba ìpín ní ilẹ̀ náà bí kò ṣe àwọn ìlú tí wọn yóò máa gbé, pẹ̀lú pápá oko tútù fún ọ̀wọ́ ẹran àti agbo ẹran wọn.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.4",
            "verseOrgIds": [
              "JOS.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ ni àwọn ará Israẹli pín ilẹ̀ náà, gẹ́gẹ́ bí",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.5",
            "verseOrgIds": [
              "JOS.14.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JOS.14.5",
                "verseOrgIds": [
                  "JOS.14.5"
                ]
              }
            }
          ]
        },
        {
          "text": "ti pàṣẹ fún Mose.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.5",
            "verseOrgIds": [
              "JOS.14.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "A fún Kalebu ní Hebroni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ọkùnrin Juda wá sí ọ̀dọ̀ Joṣua ní Gilgali. Kalebu ọmọ Jefunne ti Kenissiti wí fún un pé, \"Ìwọ rántí ohun tí",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.6",
            "verseOrgIds": [
              "JOS.14.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JOS.14.6",
                "verseOrgIds": [
                  "JOS.14.6"
                ]
              }
            }
          ]
        },
        {
          "text": "sọ fún Mose ènìyàn Ọlọ́run ní Kadeṣi-Barnea nípa ìwọ àti èmi.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.6",
            "verseOrgIds": [
              "JOS.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mo jẹ́ ọmọ ogójì ọdún nígbà tí Mose ìránṣẹ́",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.7",
            "verseOrgIds": [
              "JOS.14.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JOS.14.7",
                "verseOrgIds": [
                  "JOS.14.7"
                ]
              }
            }
          ]
        },
        {
          "text": "rán mi láti Kadeṣi-Barnea lọ rin ilẹ̀ náà wò. Mo sì mú ìròyìn wá fún un gẹ́gẹ́ bí o ti dá mi lójú,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.7",
            "verseOrgIds": [
              "JOS.14.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "ṣùgbọ́n àwọn arákùnrin mi tí wọ́n bá mi lọ mú àyà àwọn ènìyàn já. Ṣùgbọ́n ní tèmi, èmi fi gbogbo ọkàn tẹ̀lé",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.8",
            "verseOrgIds": [
              "JOS.14.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JOS.14.8",
                "verseOrgIds": [
                  "JOS.14.8"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run mi.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.8",
            "verseOrgIds": [
              "JOS.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọjọ́ náà, Mose búra fún mi pé, 'Ilẹ̀ tí ẹsẹ̀ rẹ ti rìn ni yóò jẹ́ ìní rẹ àti ti àwọn ọmọ rẹ láéláé, nítorí pé ìwọ fi tọkàntọkàn wà pẹ̀lú",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.9",
            "verseOrgIds": [
              "JOS.14.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JOS.14.9",
                "verseOrgIds": [
                  "JOS.14.9"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run mi.'",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.9",
            "verseOrgIds": [
              "JOS.14.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ǹjẹ́ nísinsin yìí, kíyèsi i",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.10",
            "verseOrgIds": [
              "JOS.14.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JOS.14.10",
                "verseOrgIds": [
                  "JOS.14.10"
                ]
              }
            }
          ]
        },
        {
          "text": "dá mi sí gẹ́gẹ́ bí ó ti wí, láti ọdún márùndínláàádọ́ta yìí wá, láti ìgbà tí",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.10",
            "verseOrgIds": [
              "JOS.14.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JOS.14.10",
                "verseOrgIds": [
                  "JOS.14.10"
                ]
              }
            }
          ]
        },
        {
          "text": "ti sọ ọ̀rọ̀ yìí fún Mose, nígbà tí Israẹli ń rìn kiri nínú aginjù, sì kíyèsi i nísinsin yìí, èmi nìyìí lónìí, ọmọ àrùndínláàdọ́rùn-ún ọdún.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.10",
            "verseOrgIds": [
              "JOS.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Síbẹ̀ èmi ní agbára lónìí, bí ìgbà tí Mose rán mi jáde. Èmi sì ní agbára láti jáde fún ogun nísinsin yìí gẹ́gẹ́ bí mo ti wà ní ìgbà náà.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.11",
            "verseOrgIds": [
              "JOS.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nísinsin yìí fi ìlú orí òkè fún mi èyí tí",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.12",
            "verseOrgIds": [
              "JOS.14.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JOS.14.12",
                "verseOrgIds": [
                  "JOS.14.12"
                ]
              }
            }
          ]
        },
        {
          "text": "ṣe ìlérí fún mi ní ọjọ́ náà. Ìwọ gbọ́ ní ìgbà náà pé àwọn ọmọ Anaki ti wà ní ibẹ̀, àti àwọn ìlú wọn tóbi, pé ó sì ṣe olódi, ṣùgbọ́n bí",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.12",
            "verseOrgIds": [
              "JOS.14.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JOS.14.12",
                "verseOrgIds": [
                  "JOS.14.12"
                ]
              }
            }
          ]
        },
        {
          "text": "ba fẹ́, èmi yóò lé wọn jáde, gẹ́gẹ́ bí ó ti sọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.12",
            "verseOrgIds": [
              "JOS.14.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ ni Joṣua súre fun Kalebu ọmọ Jefunne ó si fun un ní Hebroni ni ilẹ̀ ìní.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.13",
            "verseOrgIds": [
              "JOS.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ ni Hebroni jẹ́ ti Kalebu ọmọ Jefunne ará Kenissiti láti ìgbà náà, nítorí tí ó tẹ̀lé",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.14",
            "verseOrgIds": [
              "JOS.14.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JOS.14.14",
                "verseOrgIds": [
                  "JOS.14.14"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run Israẹli tọkàntọkàn.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.14",
            "verseOrgIds": [
              "JOS.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Hebroni a sì máa jẹ́ Kiriati-Arba ní ẹ̀yìn Arba, èyí tí ó jẹ́ ènìyàn ńlá nínú àwọn ọmọ Anaki.)",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.15",
            "verseOrgIds": [
              "JOS.14.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JOS 14:15"
      },
      "items": [
        {
          "text": "Nígbà náà ni ilẹ̀ náà sinmi ogun.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.15",
            "verseOrgIds": [
              "JOS.14.15"
            ]
          }
        }
      ]
    }
  ],
