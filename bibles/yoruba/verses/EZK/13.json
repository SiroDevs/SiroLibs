        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Wòlíì èké gba ìdálẹ́bi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ̀rọ̀",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.1",
            "verseOrgIds": [
              "EZK.13.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EZK.13.1",
                "verseOrgIds": [
                  "EZK.13.1"
                ]
              }
            }
          ]
        },
        {
          "text": "tọ̀ mí wá wí pé:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.1",
            "verseOrgIds": [
              "EZK.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ọmọ ènìyàn sọtẹ́lẹ̀ lòdì sí àwọn wòlíì Israẹli tó ń sọtẹ́lẹ̀, kí o sì sọ fún àwọn tí ń sọtẹ́lẹ̀ láti inú èrò ọkàn wọn, 'Ẹ gbọ́ ọ̀rọ̀",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.2",
            "verseOrgIds": [
              "EZK.13.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EZK.13.2",
                "verseOrgIds": [
                  "EZK.13.2"
                ]
              }
            }
          ]
        },
        {
          "text": "!",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.2",
            "verseOrgIds": [
              "EZK.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Báyìí ni",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.3",
            "verseOrgIds": [
              "EZK.13.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EZK.13.3",
                "verseOrgIds": [
                  "EZK.13.3"
                ]
              }
            }
          ]
        },
        {
          "text": "Olódùmarè wí: Ègbé ni fún àwọn aṣiwèrè wòlíì tó ń tẹ̀lé ẹ̀mí ara wọn tí wọn kò sì rí nǹkan kan!",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.3",
            "verseOrgIds": [
              "EZK.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Israẹli àwọn wòlíì rẹ dàbí kọ̀lọ̀kọ̀lọ̀ nínú pápá.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.4",
            "verseOrgIds": [
              "EZK.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ̀yin kò gòkè láti mọ odi tí ó ya ní ilé Israẹli kí wọ́n ba lè dúró gbọin ní ojú ogun ní ọjọ́",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.5",
            "verseOrgIds": [
              "EZK.13.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EZK.13.5",
                "verseOrgIds": [
                  "EZK.13.5"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.5",
            "verseOrgIds": [
              "EZK.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìran àti àfọ̀ṣẹ wọn jẹ́ èké. Wọ́n wí pé, \"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.6",
            "verseOrgIds": [
              "EZK.13.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EZK.13.6",
                "verseOrgIds": [
                  "EZK.13.6"
                ]
              }
            }
          ]
        },
        {
          "text": "wí,\" nígbà tí",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.6",
            "verseOrgIds": [
              "EZK.13.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EZK.13.6",
                "verseOrgIds": [
                  "EZK.13.6"
                ]
              }
            }
          ]
        },
        {
          "text": "kò rán wọn, síbẹ̀ wọ́n fẹ́ kí",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.6",
            "verseOrgIds": [
              "EZK.13.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EZK.13.6",
                "verseOrgIds": [
                  "EZK.13.6"
                ]
              }
            }
          ]
        },
        {
          "text": "mú ọ̀rọ̀ wọn ṣẹ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.6",
            "verseOrgIds": [
              "EZK.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ̀yin kò ha ti rí ìran asán, ẹ̀yin kò ha ti fọ àfọ̀ṣẹ èké, nígbà tí ẹ̀yin sọ pé, \"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.7",
            "verseOrgIds": [
              "EZK.13.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EZK.13.7",
                "verseOrgIds": [
                  "EZK.13.7"
                ]
              }
            }
          ]
        },
        {
          "text": "wí,\" bẹ́ẹ̀ sì ni Èmi kò sọ̀rọ̀?",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.7",
            "verseOrgIds": [
              "EZK.13.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Nítorí náà, báyìí ni",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.8",
            "verseOrgIds": [
              "EZK.13.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EZK.13.8",
                "verseOrgIds": [
                  "EZK.13.8"
                ]
              }
            }
          ]
        },
        {
          "text": "Olódùmarè wí, Nítorí ọ̀rọ̀ asán àti ìran èké yín, mo lòdì sí yín: ni",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.8",
            "verseOrgIds": [
              "EZK.13.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EZK.13.8",
                "verseOrgIds": [
                  "EZK.13.8"
                ]
              }
            }
          ]
        },
        {
          "text": "Olódùmarè wí.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.8",
            "verseOrgIds": [
              "EZK.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọwọ́ mi yóò sì wà lórí àwọn wòlíì tó ń ríran asán, tó sì ń sọ àfọ̀ṣẹ èké. Wọn kò ní sí nínú ìjọ àwọn ènìyàn mi, a ó sì yọ orúkọ wọn kúrò nínú àkọsílẹ̀ ilé Israẹli, bẹ́ẹ̀ ni wọn kò sì ní wọ ilẹ̀ Israẹli mọ́. Nígbà náà ni ẹ̀yin yóò sì mọ̀ pé, Èmi ni",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.9",
            "verseOrgIds": [
              "EZK.13.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EZK.13.9",
                "verseOrgIds": [
                  "EZK.13.9"
                ]
              }
            }
          ]
        },
        {
          "text": "Olódùmarè.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.9",
            "verseOrgIds": [
              "EZK.13.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Wọ́n ti mú àwọn ènìyàn mi ṣìnà, wọ́n ní, \"Àlàáfíà,\" nígbà tí kò sí àlàáfíà, nítorí pé bí àwọn ènìyàn bá mọ odi fẹ́lẹ́fẹ́lẹ́, wọn a fi amọ̀ àìpò rẹ́ ẹ, wọn ó sì fi ẹfun kùn ún,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.10",
            "verseOrgIds": [
              "EZK.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "nítorí náà, sọ fún àwọn tí ń fi amọ̀ àìpò rẹ́ ẹ àti àwọn tó fi ẹfun kùn ún pé, odi náà yóò wó, ìkún omi òjò yóò dé, Èmi yóò sì rán òkúta yìnyín sọ̀kalẹ̀, ìjì líle yóò ya á lulẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.11",
            "verseOrgIds": [
              "EZK.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí odi náà bá sì wó, ǹjẹ́ àwọn ènìyàn wọn kò níbi yín pé, \"Rírẹ́ tí ẹ rẹ́ ẹ dà, ibo sì ni ẹfun tí ẹ fi kùn ún wà?\"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.12",
            "verseOrgIds": [
              "EZK.13.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Nítorí náà, báyìí ni",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.13",
            "verseOrgIds": [
              "EZK.13.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EZK.13.13",
                "verseOrgIds": [
                  "EZK.13.13"
                ]
              }
            }
          ]
        },
        {
          "text": "Olódùmarè wí, Nínú ìbínú gbígbóná mi, èmi yóò tu afẹ́fẹ́ líle lé e lórí nínú ìrunú mi, àti nínú ìbínú mi, òjò yóò sì rọ̀ púpọ̀ nínú ìbínú mi, àti yìnyín ńlá nínú ìrunú mi láti pa wọ́n run.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.13",
            "verseOrgIds": [
              "EZK.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò wó ògiri tí ẹ fi amọ̀ àìpò rẹ́, èyí tí ẹ fi ẹfun kùn lulẹ̀ dé bi pé ìpìlẹ̀ rẹ yóò hàn jáde. Nígbà ti odi náà wó palẹ̀, a ó sì run yín sínú rẹ̀, ẹ̀yin yóò sì mọ̀ pé, Èmi ni",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.14",
            "verseOrgIds": [
              "EZK.13.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EZK.13.14",
                "verseOrgIds": [
                  "EZK.13.14"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.14",
            "verseOrgIds": [
              "EZK.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Báyìí ni Èmi yóò ṣe lo ìbínú mi lórí odi yìí àti àwọn to fi amọ̀ àìpò rẹ́ ẹ, tí wọ́n sì fi ẹfun kùn ún. Èmi yóò sì sọ fún yín pé, \"Kò sí odi mọ́, bẹ́ẹ̀ ni àwọn tó rẹ́ ẹ náà kò sí mọ́.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.15",
            "verseOrgIds": [
              "EZK.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn wòlíì Israẹli tí ń sọtẹ́lẹ̀ sí Jerusalẹmu, tí wọn ríran àlàáfíà sí i nígbà ti kò sì àlàáfíà, báyìí ni",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.16",
            "verseOrgIds": [
              "EZK.13.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
