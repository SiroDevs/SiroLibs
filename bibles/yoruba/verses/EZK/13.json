    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nísinsin yìí, ọmọ ènìyàn, dojúkọ àwọn ọmọbìnrin ènìyàn rẹ tí wọ́n ń sọtẹ́lẹ̀ láti inú èrò ọkàn wọn, sọtẹ́lẹ̀ sí wọn",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.17",
            "verseOrgIds": [
              "EZK.13.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "wí pé, 'Báyìí ni",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.18",
            "verseOrgIds": [
              "EZK.13.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EZK.13.18",
                "verseOrgIds": [
                  "EZK.13.18"
                ]
              }
            }
          ]
        },
        {
          "text": "Olódùmarè wí. Ègbé ni fún ẹ̀yin obìnrin tí ẹ ń rán ìfúnpá òògùn sí ìgbọ̀nwọ́ àwọn ènìyàn, tí ẹ ń ṣe ìbòjú oríṣìíríṣìí fún orí oníkálùkù ènìyàn láti ṣọdẹ ọkàn wọn. Ẹ̀yin yóò wa dẹkùn fún ọkàn àwọn ènìyàn mi bí? Ẹ̀yin yóò sì gba ọkàn ti ó tọ̀ yín wá là bí?",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.18",
            "verseOrgIds": [
              "EZK.13.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí ẹ̀kúnwọ́ ọkà barle àti òkèlè oúnjẹ. Ẹ ti pa àwọn tí kò yẹ kí ẹ pa, ẹ sì fi àwọn tí kò yẹ kó wà láààyè sílẹ̀ nípa irọ́ tí ẹ ń pa fún àwọn ènìyàn mi, èyí tí àwọn náà ń fetí sí.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.19",
            "verseOrgIds": [
              "EZK.13.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
