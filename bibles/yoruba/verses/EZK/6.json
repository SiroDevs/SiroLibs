  "verseCount": 14,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
        "style": "c",
        "sid": "EZK 6"
      },
      "items": [
        {
          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìsọtẹ́lẹ̀ sí àwọn òkè Israẹli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ̀rọ̀",
          "type": "text",
          "attrs": {
            "verseId": "EZK.6.1",
            "verseOrgIds": [
              "EZK.6.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EZK.6.1",
                "verseOrgIds": [
                  "EZK.6.1"
                ]
              }
            }
          ]
        },
        {
          "text": "sì tọ̀ mí wá wí pé,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.6.1",
            "verseOrgIds": [
              "EZK.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ọmọ ènìyàn, dojúkọ àwọn òkè Israẹli; kí o sì sọtẹ́lẹ̀ lòdì sí wọn",
          "type": "text",
          "attrs": {
            "verseId": "EZK.6.2",
            "verseOrgIds": [
              "EZK.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "wí pé, 'Ẹ̀yin òkè Israẹli, ẹ gbọ́ ọ̀rọ̀",
          "type": "text",
          "attrs": {
            "verseId": "EZK.6.3",
            "verseOrgIds": [
              "EZK.6.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EZK.6.3",
                "verseOrgIds": [
                  "EZK.6.3"
                ]
              }
            }
          ]
        },
        {
          "text": "Olódùmarè. Báyìí ni",
          "type": "text",
          "attrs": {
            "verseId": "EZK.6.3",
            "verseOrgIds": [
              "EZK.6.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EZK.6.3",
                "verseOrgIds": [
                  "EZK.6.3"
                ]
              }
            }
          ]
        },
        {
          "text": "Olódùmarè wí sí ẹ̀yin òkè ńlá àti àwọn òkè kéékèèké, sí àwọn odò ṣíṣàn àti sí àfonífojì, èmi yóò mú idà wa sórí yín, èmí yóò sì pa ibi gíga yín run.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.6.3",
            "verseOrgIds": [
              "EZK.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò wó pẹpẹ yín lulẹ̀, èmi yóò sì fọ́ pẹpẹ tùràrí yín túútúú; èmi yóò sì pa àwọn ènìyàn yín síwájú àwọn òrìṣà wọn.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.6.4",
            "verseOrgIds": [
              "EZK.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò tẹ́ òkú àwọn ará Israẹli síwájú òrìṣà wọn, èmi yóò sì fọ́n egungun wọn yí pẹpẹ wọn ká.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.6.5",
            "verseOrgIds": [
              "EZK.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo ibi tí ẹ ń gbé àti àwọn ibi gíga yín ni yóò di píparun, gbogbo pẹpẹ yín ni yóò di ahoro, àwọn òrìṣà yín yóò di fífọ́ túútúú, àwọn pẹpẹ tùràrí yín ni a ó gé lulẹ̀, gbogbo iṣẹ́ yín yóò parẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.6.6",
            "verseOrgIds": [
              "EZK.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ènìyàn yín yóò ṣubú láàrín yín, ẹ ó sì mọ̀ pé, Èmi ni",
          "type": "text",
          "attrs": {
            "verseId": "EZK.6.7",
            "verseOrgIds": [
              "EZK.6.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EZK.6.7",
                "verseOrgIds": [
                  "EZK.6.7"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "EZK.6.7",
            "verseOrgIds": [
              "EZK.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ṣùgbọ́n èmi yóò dá àwọn kan sí nítorí pé díẹ̀ nínú yín ni yóò bọ́ lọ́wọ́ idà, nígbà tí a bá fọ́n yín ká sí gbogbo ilẹ̀ àti orílẹ̀-èdè.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.6.8",
            "verseOrgIds": [
              "EZK.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ti ó bọ́ nínú yin yóò sì rántí mi láàrín àwọn orílẹ̀-èdè níbi tí wọn yóò dìwọ́n ní ìgbèkùn lọ, nítorí wọ́n yóò máa rántí mi bí wọ́n ti bà mí lọ́kàn jẹ́ nípa àgbèrè wọn, tí ó yà wọ́n kúrò lọ́dọ̀ mi àti nípa ojú wọn tí ó ṣàfẹ́rí àwọn òrìṣà. Wọn yóò sì ṣú ara wọn nítorí ìwà ibi tí wọ́n ti hù nípa gbogbo ìríra wọn.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.6.9",
            "verseOrgIds": [
              "EZK.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọn yóò sì mọ̀ pé, Èmi ni",
          "type": "text",
          "attrs": {
            "verseId": "EZK.6.10",
            "verseOrgIds": [
              "EZK.6.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EZK.6.10",
                "verseOrgIds": [
                  "EZK.6.10"
                ]
              }
            }
          ]
        },
        {
          "text": "; àti pé kì í ṣe lásán ni mo ń lérí pé èmi yóò mú ìdààmú bá wọn.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.6.10",
            "verseOrgIds": [
              "EZK.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Èyí ni ohun tí",
          "type": "text",
          "attrs": {
            "verseId": "EZK.6.11",
            "verseOrgIds": [
              "EZK.6.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EZK.6.11",
                "verseOrgIds": [
                  "EZK.6.11"
                ]
              }
            }
          ]
        },
        {
          "text": "Olódùmarè wí, Pàtẹ́wọ́ kí o tún fẹsẹ̀ janlẹ̀, kí o wá kígbe síta pé, \"Ó ṣe!\" Ilé Israẹli yóò ṣubú nípa idà, ìyàn àti àjàkálẹ̀-ààrùn nítorí gbogbo ìwà ìríra búburú tí wọ́n hù. Wọn yóò ṣubú nípa idà àti ìyàn.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.6.11",
            "verseOrgIds": [
              "EZK.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹni tó wà lókèèrè yóò kú pẹ̀lú àjàkálẹ̀-ààrùn, àti ẹni tó wà nítòsí yóò ṣubú pẹ̀lú idà, ìyàn ni yóò pa ẹni tó bá ṣẹ́kù sílẹ̀. Báyìí ni èmi yóò ṣe mú ìbínú gbígbóná mi wá sórí wọn.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.6.12",
            "verseOrgIds": [
              "EZK.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọn yóò sì mọ̀ pé, Èmi ni",
          "type": "text",
          "attrs": {
            "verseId": "EZK.6.13",
            "verseOrgIds": [
              "EZK.6.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EZK.6.13",
                "verseOrgIds": [
                  "EZK.6.13"
                ]
              }
            }
          ]
        },
        {
          "text": ", nígbà tí òkú àwọn ènìyàn wọn bá wà níbẹ̀ láàrín òrìṣà wọn yí pẹpẹ wọn ká, lórí àwọn òkè gíga gbogbo, àti lórí góńgó òkè àti lábẹ́ igi tútù àti lábẹ́ igi óákù, níbi tí wọ́n ti ń fi tùràrí olóòórùn dídùn rú ẹbọ sí gbogbo òrìṣà wọn.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.6.13",
            "verseOrgIds": [
              "EZK.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò na ọwọ́ mi jáde sí wọn láti mú kí ilẹ̀ náà ṣòfò, kí ó sì dahoro dé aṣálẹ̀ ìhà Dibila—ní gbogbo ibùgbé wọn. Nígbà náà ni wọn yóò mọ̀ pé, Èmi ni",
          "type": "text",
          "attrs": {
            "verseId": "EZK.6.14",
            "verseOrgIds": [
              "EZK.6.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EZK.6.14",
                "verseOrgIds": [
                  "EZK.6.14"
                ]
              }
            }
          ]
        },
        {
          "text": ".' \"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.6.14",
            "verseOrgIds": [
              "EZK.6.14"
            ]
          }
        }
      ]
    }
  ],
