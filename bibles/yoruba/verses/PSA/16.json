        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Miktamu ti Dafidi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa mí mọ́, Ọlọ́run,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.1",
            "verseOrgIds": [
              "PSA.16.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 16:1"
      },
      "items": [
        {
          "text": "nítorí nínú rẹ ni ààbò mi wà.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.1",
            "verseOrgIds": [
              "PSA.16.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mo sọ fún",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.2",
            "verseOrgIds": [
              "PSA.16.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.16.2",
                "verseOrgIds": [
                  "PSA.16.2"
                ]
              }
            }
          ]
        },
        {
          "text": ", \"Ìwọ ni Olúwa mi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.2",
            "verseOrgIds": [
              "PSA.16.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 16:2"
      },
      "items": [
        {
          "text": "lẹ́yìn rẹ èmi kò ní ìre kan.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.2",
            "verseOrgIds": [
              "PSA.16.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sí àwọn ènìyàn tí ó wà ní ayé,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.3",
            "verseOrgIds": [
              "PSA.16.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 16:3"
      },
      "items": [
        {
          "text": "àwọn ni ológo nínú èyí tí ayọ̀ mí wà.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.3",
            "verseOrgIds": [
              "PSA.16.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìṣòro àwọn wọ̀n-ọn-nì yóò pọ̀ sí i, àní àwọn tí ń tọ ọlọ́run mìíràn lẹ́yìn.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.4",
            "verseOrgIds": [
              "PSA.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 16:4"
      },
      "items": [
        {
          "text": "Ẹbọ ohun mímu ẹ̀jẹ̀ wọn ni èmi kì yóò ta sílẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.4",
            "verseOrgIds": [
              "PSA.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 16:4"
      },
      "items": [
        {
          "text": "bẹ́ẹ̀ ni èmi kì yóò dá orúkọ wọn lẹ́nu mi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.4",
            "verseOrgIds": [
              "PSA.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.16.5",
                "verseOrgIds": [
                  "PSA.16.5"
                ]
              }
            }
          ]
        },
        {
          "text": ", ni ìpín ìní mi tí mo yàn àti ago mi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.5",
            "verseOrgIds": [
              "PSA.16.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 16:5"
      },
      "items": [
        {
          "text": "ó ti pa ohun tí í ṣe tèmi mọ́.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.5",
            "verseOrgIds": [
              "PSA.16.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okùn ààlà ilẹ̀ ti bọ́ sí ọ̀dọ̀ mi ní ibi dídára;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.6",
            "verseOrgIds": [
              "PSA.16.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 16:6"
      },
      "items": [
        {
          "text": "nítòótọ́ mo ti ní ogún rere.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.6",
            "verseOrgIds": [
              "PSA.16.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò yin",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.7",
            "verseOrgIds": [
              "PSA.16.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.16.7",
                "verseOrgIds": [
                  "PSA.16.7"
                ]
              }
            }
          ]
        },
        {
          "text": ", ẹni tí ó gbà mí ní ìyànjú;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.7",
            "verseOrgIds": [
              "PSA.16.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 16:7"
      },
      "items": [
        {
          "text": "ní òru, ọkàn mí ń bá mi sọ̀rọ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.7",
            "verseOrgIds": [
              "PSA.16.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mo ti gbé",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.8",
            "verseOrgIds": [
              "PSA.16.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.16.8",
                "verseOrgIds": [
                  "PSA.16.8"
                ]
              }
            }
          ]
        },
        {
          "text": "síwájú mi ní ìgbà gbogbo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.8",
            "verseOrgIds": [
              "PSA.16.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 16:8"
      },
      "items": [
        {
          "text": "Nítorí tí ó wà ní ọwọ́ ọ̀tún mi, a kì yóò mì mí.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.8",
            "verseOrgIds": [
              "PSA.16.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí èyí, ọkàn mi yọ̀, ahọ́n mi pẹ̀lú ń fò fáyọ̀;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.9",
            "verseOrgIds": [
              "PSA.16.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 16:9"
      },
      "items": [
        {
          "text": "ara mi pẹ̀lú yóò sinmi ní ààbò,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.9",
            "verseOrgIds": [
              "PSA.16.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "nítorí ìwọ kò ní fi ọ̀kan sílẹ̀ nínú isà òkú,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.10",
            "verseOrgIds": [
              "PSA.16.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 16:10"
      },
      "items": [
        {
          "text": "tàbí kí ìwọ jẹ́ kí ẹni mímọ́ rẹ kí ó rí ìdíbàjẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.10",
            "verseOrgIds": [
              "PSA.16.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ ti fi ipa ọ̀nà ìyè hàn mí;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.11",
            "verseOrgIds": [
              "PSA.16.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 16:11"
      },
      "items": [
        {
          "text": "Ìwọ yóò kún mi pẹ̀lú ayọ̀ ní iwájú rẹ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.11",
            "verseOrgIds": [
              "PSA.16.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 16:11"
      },
      "items": [
        {
          "text": "pẹ̀lú ìdùnnú ayérayé ní ọwọ́ ọ̀tún rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.11",
            "verseOrgIds": [
              "PSA.16.11"
            ]
          }
        }
      ]
    }
  ],
