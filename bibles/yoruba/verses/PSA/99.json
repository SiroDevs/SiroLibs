      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 99:3"
      },
      "items": [
        {
          "text": "tí ó ni ẹ̀rù, Mímọ́ ni Òun.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.3",
            "verseOrgIds": [
              "PSA.99.3"
            ]
          }
        }
      ]
    },
