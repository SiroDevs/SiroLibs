      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 99:4"
      },
      "items": [
        {
          "text": "ìwọ ṣe ohun tí ó tọ́ àti ohun tí ó yẹ nínú Jakọbu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.4",
            "verseOrgIds": [
              "PSA.99.4"
            ]
          }
