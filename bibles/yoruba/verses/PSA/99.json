          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọba náà ní agbára, ó sì fẹ́ òdodo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.4",
            "verseOrgIds": [
              "PSA.99.4"
            ]
          }
        }
      ]
    },
