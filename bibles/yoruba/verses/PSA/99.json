      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 99:2"
      },
      "items": [
        {
          "text": "Ó sì ga jù gbogbo orílẹ̀-èdè lọ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.2",
            "verseOrgIds": [
              "PSA.99.2"
            ]
          }
        }
