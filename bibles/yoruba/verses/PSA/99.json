      "attrs": {
        "style": "q2",
        "vid": "PSA 99:4"
      },
      "items": [
        {
          "text": "ìwọ fi ìdí àìṣègbè múlẹ̀;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.4",
            "verseOrgIds": [
              "PSA.99.4"
            ]
