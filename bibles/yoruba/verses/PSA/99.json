            "sid": "PSA 99:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kí wọ́n sì yin orúkọ rẹ̀ tí ó tóbi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.3",
            "verseOrgIds": [
              "PSA.99.3"
            ]
          }
        }
      ]
    },
    {
