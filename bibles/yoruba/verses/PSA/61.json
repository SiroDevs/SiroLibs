  "verseCount": 8,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "61",
        "style": "c",
        "sid": "PSA 61"
      },
      "items": [
        {
          "text": "61",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Saamu 61",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Fún adarí orin. Ohun èlò orin olókùn. Ti Dafidi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 61:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbọ́ ẹkún mi, Ọlọ́run;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.61.1",
            "verseOrgIds": [
              "PSA.61.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 61:1"
      },
      "items": [
        {
          "text": "tẹ́tí sí àdúrà mi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.61.1",
            "verseOrgIds": [
              "PSA.61.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 61:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Láti òpin ayé wá ni èmi yóò pè ọ́,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.61.2",
            "verseOrgIds": [
              "PSA.61.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 61:2"
      },
      "items": [
        {
          "text": "mo pè nígbà àyà mi ń ṣàárẹ̀;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.61.2",
            "verseOrgIds": [
              "PSA.61.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 61:2"
      },
      "items": [
        {
          "text": "mú mi lọ sí ibi àpáta tí ó ga jù mí lọ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.61.2",
            "verseOrgIds": [
              "PSA.61.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 61:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí ìwọ ti jẹ́ ibi ààbò mi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.61.3",
            "verseOrgIds": [
              "PSA.61.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 61:3"
      },
      "items": [
        {
          "text": "ilé ìṣọ́ agbára àwọn ọ̀tá.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.61.3",
            "verseOrgIds": [
              "PSA.61.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 61:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mo ń lépa láti máa gbé nínú àgọ́ rẹ títí láé",
          "type": "text",
          "attrs": {
            "verseId": "PSA.61.4",
            "verseOrgIds": [
              "PSA.61.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 61:4"
      },
      "items": [
        {
          "text": "kí n sì rí ààbò níbi ìyẹ́ apá rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.61.4",
            "verseOrgIds": [
              "PSA.61.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 61:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí ìwọ ti gbọ́ àwọn ẹ̀jẹ́ mi, Ọlọ́run;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.61.5",
            "verseOrgIds": [
              "PSA.61.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 61:5"
      },
      "items": [
        {
          "text": "Ìwọ ti fún mi ní ogún àwọn tí ó bẹ̀rù orúkọ rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.61.5",
            "verseOrgIds": [
              "PSA.61.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 61:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jẹ́ kí ẹ̀mí ọba kí ó gùn,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.61.6",
            "verseOrgIds": [
              "PSA.61.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 61:6"
      },
      "items": [
        {
          "text": "ọdún rẹ̀ fún ìrandíran.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.61.6",
            "verseOrgIds": [
              "PSA.61.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 61:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kí ó máa jẹ ọba níwájú Ọlọ́run títí láé;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.61.7",
            "verseOrgIds": [
              "PSA.61.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 61:7"
      },
      "items": [
        {
          "text": "pèsè àánú àti òtítọ́ rẹ tí yóò máa ṣe ìtọ́jú rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.61.7",
            "verseOrgIds": [
              "PSA.61.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 61:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni èmi ó máa kọrin ìyìn sí orúkọ rẹ títí láé",
          "type": "text",
          "attrs": {
            "verseId": "PSA.61.8",
            "verseOrgIds": [
              "PSA.61.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 61:8"
      },
      "items": [
        {
          "text": "kí n san ẹ̀jẹ́ mi ní ojoojúmọ́.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.61.8",
            "verseOrgIds": [
              "PSA.61.9"
            ]
          }
        }
      ]
    }
  ],
