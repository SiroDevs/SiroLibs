  "verseCount": 18,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "83",
        "style": "c",
        "sid": "PSA 83"
      },
      "items": [
        {
          "text": "83",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Saamu 83",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Orin. Saamu ti Asafu.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 83:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọlọ́run, má ṣe dákẹ́;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.1",
            "verseOrgIds": [
              "PSA.83.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 83:1"
      },
      "items": [
        {
          "text": "má ṣe dákẹ́, Ọlọ́run má ṣe dúró jẹ́ẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.1",
            "verseOrgIds": [
              "PSA.83.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 83:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wo bí àwọn ọ̀tá rẹ ti ń rọ́kẹ̀kẹ̀ lọ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.2",
            "verseOrgIds": [
              "PSA.83.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 83:2"
      },
      "items": [
        {
          "text": "bi àwọn ọ̀tá rẹ ti ń gbé ohùn wọn sókè.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.2",
            "verseOrgIds": [
              "PSA.83.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 83:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pẹ̀lú àrékérekè ni wọn dìtẹ̀ sí àwọn ènìyàn rẹ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.3",
            "verseOrgIds": [
              "PSA.83.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 83:3"
      },
      "items": [
        {
          "text": "wọn sí dìtẹ̀ mọ́ àwọn tí o fẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.3",
            "verseOrgIds": [
              "PSA.83.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 83:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọn wí pé, \"wá, ẹ jẹ́ kí á pa wọ́n run bí orílẹ̀-èdè,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.4",
            "verseOrgIds": [
              "PSA.83.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 83:4"
      },
      "items": [
        {
          "text": "kí orúkọ Israẹli ma bá a sí ní ìrántí mọ́.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.4",
            "verseOrgIds": [
              "PSA.83.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 83:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n gbìmọ̀ pọ̀ pẹ̀lú ọkàn kan;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.5",
            "verseOrgIds": [
              "PSA.83.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 83:5"
      },
      "items": [
        {
          "text": "wọ́n ṣe àdéhùn láti ṣọ̀tẹ̀ sí ọ",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.5",
            "verseOrgIds": [
              "PSA.83.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 83:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àgọ́ Edomu àti ti àwọn ará Iṣmaeli,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.6",
            "verseOrgIds": [
              "PSA.83.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 83:6"
      },
      "items": [
        {
          "text": "ti Moabu àti ti Hagari",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.6",
            "verseOrgIds": [
              "PSA.83.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 83:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gebali, Ammoni àti Amaleki,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.7",
            "verseOrgIds": [
              "PSA.83.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 83:7"
      },
      "items": [
        {
          "text": "Filistia, pẹ̀lú àwọn ènìyàn Tire.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.7",
            "verseOrgIds": [
              "PSA.83.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 83:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asiria pẹ̀lú ti darapọ̀ mọ́ wọn",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.8",
            "verseOrgIds": [
              "PSA.83.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 83:8"
      },
      "items": [
        {
          "text": "láti ran àwọn ọmọ Lọti lọ́wọ́.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.8",
            "verseOrgIds": [
              "PSA.83.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "qs"
          },
          "items": [
            {
              "text": "Sela.",
              "type": "text",
              "attrs": {
                "verseId": "PSA.83.8",
                "verseOrgIds": [
                  "PSA.83.9"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 83:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣe sí wọn bí ìwọ ti ṣe sí Midiani",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.9",
            "verseOrgIds": [
              "PSA.83.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 83:9"
      },
      "items": [
        {
          "text": "bí o ti ṣe sí Sisera àti Jabini ní odò Kiṣoni,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.9",
            "verseOrgIds": [
              "PSA.83.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 83:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "ẹni tí ó ṣègbé ní Endori",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.10",
            "verseOrgIds": [
              "PSA.83.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 83:10"
      },
      "items": [
        {
          "text": "tí wọn sì dàbí ààtàn ní orí ilẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.10",
            "verseOrgIds": [
              "PSA.83.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 83:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣe àwọn ọlọ́lá wọn bí Orebu àti Seebu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.11",
            "verseOrgIds": [
              "PSA.83.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 83:11"
      },
      "items": [
        {
          "text": "àwọn ọmọ-aládé wọn bí Seba àti Salmunna,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.11",
            "verseOrgIds": [
              "PSA.83.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 83:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "tí ó wí pé, \"Ẹ jẹ́ kí a gbà ní ìní",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.12",
            "verseOrgIds": [
              "PSA.83.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 83:12"
      },
      "items": [
        {
          "text": "àní pápá oko tútù Ọlọ́run.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.12",
            "verseOrgIds": [
              "PSA.83.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 83:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ Ọlọ́run, ṣe wọ́n bí ààjà,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.13",
            "verseOrgIds": [
              "PSA.83.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 83:13"
      },
      "items": [
        {
          "text": "bí ìyàngbò níwájú afẹ́fẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.13",
            "verseOrgIds": [
              "PSA.83.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 83:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí iná ti í jó igbó,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.14",
            "verseOrgIds": [
              "PSA.83.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 83:14"
      },
      "items": [
        {
          "text": "àti bí ọ̀wọ́-iná ti ń mú òkè ńlá gbiná,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.14",
            "verseOrgIds": [
              "PSA.83.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 83:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "bẹ́ẹ̀ ni kí o fi ẹ̀fúùfù líle rẹ lépa wọn",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.15",
            "verseOrgIds": [
              "PSA.83.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 83:15"
      },
      "items": [
        {
          "text": "dẹ́rùbà wọn lójú pẹ̀lú ìjì rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.15",
            "verseOrgIds": [
              "PSA.83.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 83:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fi ìtìjú kún ojú wọn,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.16",
            "verseOrgIds": [
              "PSA.83.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 83:16"
      },
      "items": [
        {
          "text": "kí àwọn ènìyàn bá à lè ṣe àfẹ́rí orúkọ rẹ àti kí o fi ìjì líle rẹ dẹ́rùbà, ìwọ",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.16",
            "verseOrgIds": [
              "PSA.83.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.83.16",
                "verseOrgIds": [
                  "PSA.83.17"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.16",
            "verseOrgIds": [
              "PSA.83.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
