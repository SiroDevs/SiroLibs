{
  "id": "PSA.60",
  "number": "60",
  "bookId": "PSA",
  "reference": "Saamu 60",
  "copyright": "Biblica® ní oore ọ̀fẹ́ láti lo Bíbélì Mímọ́ ní Èdè Yorùbá Òde-Òní™ Ẹ̀tọ́ àdàkọ © 2009, 2017 Biblica, Inc. Biblica® Open Yoruba Contemporary Bible™ Copyright © 2009, 2017 by Biblica, Inc. ‪\"Biblica\" ni àmì ìdámọ̀ tí Biblica, Inc. fi sílẹ̀ ní United States Patent àti ní ilé iṣẹ́ tí wọ́n ti ń fúnni ní àmì ìdámọ̀. Gba àṣẹ kí o tó lòó. \"Biblica\" is a trademark registered in the United States Patent and Trademark Office by Biblica, Inc. Used with permission.",
  "verseCount": 12,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "60",
        "style": "c",
        "sid": "PSA 60"
      },
      "items": [
        {
          "text": "60",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Saamu 60",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Fún adarí orin. Tí ohùn \"Lílì ti Májẹ̀mú.\" Miktamu ti Dafidi. Fún ìkọ́ni. Nígbà tí ó bá Aramu-Naharaimu àti Siria-Soba jà, àti nígbà tí Joabu yípadà tí ó sì pa ẹgbẹ̀rún méjìlá àwọn ará Edomu ní àfonífojì Iyọ̀.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 60:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ ti kọ̀ wá sílẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.1",
            "verseOrgIds": [
              "PSA.60.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 60:1"
      },
      "items": [
        {
          "text": "Ọlọ́run, ìwọ ti tú wa ká,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.1",
            "verseOrgIds": [
              "PSA.60.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 60:1"
      },
      "items": [
        {
          "text": "ìwọ ti bínú nísinsin yìí, tún ara rẹ yípadà sí wa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.1",
            "verseOrgIds": [
              "PSA.60.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 60:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ ti mú ilẹ̀ wárìrì, ìwọ ti fọ́ ọ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.2",
            "verseOrgIds": [
              "PSA.60.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 60:2"
      },
      "items": [
        {
          "text": "mú fífọ́ rẹ̀ bọ̀ sípò, nítorí tí ó mì.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.2",
            "verseOrgIds": [
              "PSA.60.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 60:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ ti fi ìgbà ewu han àwọn ènìyàn rẹ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.3",
            "verseOrgIds": [
              "PSA.60.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 60:3"
      },
      "items": [
        {
          "text": "ìwọ fún wa ní wáìnì tí ó máa ń ta wá gbọ̀nọ́ngbọ̀nọ́n.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.3",
            "verseOrgIds": [
              "PSA.60.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 60:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn tí ó bẹ̀rù rẹ̀, ní ìwọ fi ọ̀págun fún",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.4",
            "verseOrgIds": [
              "PSA.60.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 60:4"
      },
      "items": [
        {
          "text": "kí a lè fihàn nítorí òtítọ́.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.4",
            "verseOrgIds": [
              "PSA.60.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "qs"
          },
          "items": [
            {
              "text": "Sela.",
              "type": "text",
              "attrs": {
                "verseId": "PSA.60.4",
                "verseOrgIds": [
                  "PSA.60.6"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 60:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fi ọwọ́ ọ̀tún rẹ gbà wá, kí o sì ràn wá lọ́wọ́,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.5",
            "verseOrgIds": [
              "PSA.60.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 60:5"
      },
      "items": [
        {
          "text": "kí a lè gba àwọn tí o fẹ́ là.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.5",
            "verseOrgIds": [
              "PSA.60.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 60:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọlọ́run ti sọ̀rọ̀ láti ibi mímọ́ rẹ̀:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.6",
            "verseOrgIds": [
              "PSA.60.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 60:6"
      },
      "items": [
        {
          "text": "\"Ní ayọ̀, èmi ó pọ Ṣekemu jáde",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.6",
            "verseOrgIds": [
              "PSA.60.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 60:6"
      },
      "items": [
        {
          "text": "èmi ó sì wọ́n àfonífojì Sukkoti.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.6",
            "verseOrgIds": [
              "PSA.60.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 60:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tèmi ni Gileadi, tèmi sì ni Manase;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.7",
            "verseOrgIds": [
              "PSA.60.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 60:7"
      },
      "items": [
        {
          "text": "Efraimu ni àṣíborí mi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.7",
            "verseOrgIds": [
              "PSA.60.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 60:7"
      },
      "items": [
        {
          "text": "Juda sì ni ọ̀pá àṣẹ mi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.7",
            "verseOrgIds": [
              "PSA.60.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 60:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moabu ní ìkòkò ìwẹsẹ̀ mi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.8",
            "verseOrgIds": [
              "PSA.60.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 60:8"
      },
      "items": [
        {
          "text": "lórí Edomu ní mo bọ́ bàtà mi sí;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.8",
            "verseOrgIds": [
              "PSA.60.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 60:8"
      },
      "items": [
        {
          "text": "lórí Filistia ni mo kígbe ayọ̀.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.8",
            "verseOrgIds": [
              "PSA.60.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 60:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ta ni yóò mú mi wá sí ìlú olódi nì?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.9",
            "verseOrgIds": [
              "PSA.60.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 60:9"
      },
      "items": [
        {
          "text": "Ta ni yóò tọ́ mí lọ sí Edomu?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.9",
            "verseOrgIds": [
              "PSA.60.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 60:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kì í ha ń ṣe ìwọ, Ọlọ́run, tí ó ti kọ̀ wá sílẹ̀",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.10",
            "verseOrgIds": [
              "PSA.60.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 60:10"
      },
      "items": [
        {
          "text": "tí o kò sì bá ogun wa jáde mọ́?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.10",
            "verseOrgIds": [
              "PSA.60.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 60:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fún wa ní ìrànlọ́wọ́ lórí àwọn ọ̀tá,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.11",
            "verseOrgIds": [
              "PSA.60.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 60:11"
      },
      "items": [
        {
          "text": "nítorí asán ni ìrànlọ́wọ́ ènìyàn.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.11",
            "verseOrgIds": [
              "PSA.60.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 60:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nípa Ọlọ́run ni a óò ní ìṣẹ́gun,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.12",
            "verseOrgIds": [
              "PSA.60.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 60:12"
      },
      "items": [
        {
          "text": "yóò sì tẹ àwọn ọ̀tá wa mọ́lẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.12",
            "verseOrgIds": [
              "PSA.60.14"
            ]
          }
        }
      ]
    }
  ],
