  "verseCount": 13,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "21",
        "style": "c",
        "sid": "PSA 21"
      },
      "items": [
        {
          "text": "21",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Saamu 21",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Fún adarí orin. Saamu ti Dafidi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 21:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Háà!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.1",
            "verseOrgIds": [
              "PSA.21.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.21.1",
                "verseOrgIds": [
                  "PSA.21.2"
                ]
              }
            }
          ]
        },
        {
          "text": ", ọba yóò yọ̀ nínú agbára rẹ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.1",
            "verseOrgIds": [
              "PSA.21.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 21:1"
      },
      "items": [
        {
          "text": "àti ní ìgbàlà rẹ, yóò ti yọ̀ pẹ́ tó!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.1",
            "verseOrgIds": [
              "PSA.21.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí pé ìwọ ti fi ìfẹ́ ọkàn rẹ̀ fún un,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.2",
            "verseOrgIds": [
              "PSA.21.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 21:2"
      },
      "items": [
        {
          "text": "bẹ́ẹ̀ ni ìwọ kò sì dùn ún ní ìbéèrè ẹnu rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.2",
            "verseOrgIds": [
              "PSA.21.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "qs"
          },
          "items": [
            {
              "text": "Sela.",
              "type": "text",
              "attrs": {
                "verseId": "PSA.21.2",
                "verseOrgIds": [
                  "PSA.21.3"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ ti fi àwọn ìbùkún oore kò ó ni ọ̀nà",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.3",
            "verseOrgIds": [
              "PSA.21.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 21:3"
      },
      "items": [
        {
          "text": "ìwọ fi adé wúrà dé e ní orí.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.3",
            "verseOrgIds": [
              "PSA.21.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó béèrè fún ìyè, ìwọ sì fi fún un,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.4",
            "verseOrgIds": [
              "PSA.21.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 21:4"
      },
      "items": [
        {
          "text": "àní ọjọ́ gígùn títí ayérayé.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.4",
            "verseOrgIds": [
              "PSA.21.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ògo rẹ̀ pọ̀ nípasẹ̀ ìṣẹ́gun tí o fi fún un;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.5",
            "verseOrgIds": [
              "PSA.21.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 21:5"
      },
      "items": [
        {
          "text": "ìwọ sì jẹ́ kí iyì ọláńlá rẹ̀ wà lára rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.5",
            "verseOrgIds": [
              "PSA.21.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dájúdájú, ìwọ ti fi ìbùkún ayérayé fún un:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.6",
            "verseOrgIds": [
              "PSA.21.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 21:6"
      },
      "items": [
        {
          "text": "ìwọ sì mú inú rẹ̀ dùn pẹ̀lú ayọ̀ ojú u rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.6",
            "verseOrgIds": [
              "PSA.21.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọba ní ìgbẹ́kẹ̀lé nínú",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.7",
            "verseOrgIds": [
              "PSA.21.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.21.7",
                "verseOrgIds": [
                  "PSA.21.8"
                ]
              }
            }
          ]
        },
        {
          "text": ";",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.7",
            "verseOrgIds": [
              "PSA.21.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 21:7"
      },
      "items": [
        {
          "text": "nípasẹ̀ ìfẹ́ Ọ̀gá-ògo tí kì í kùnà",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.7",
            "verseOrgIds": [
              "PSA.21.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 21:7"
      },
      "items": [
        {
          "text": "kì yóò sípò padà.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.7",
            "verseOrgIds": [
              "PSA.21.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọwọ́ rẹ yóò wá gbogbo àwọn ọ̀tá a rẹ rí;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.8",
            "verseOrgIds": [
              "PSA.21.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 21:8"
      },
      "items": [
        {
          "text": "ọwọ́ ọ̀tún rẹ yóò wá àwọn tí o kórìíra rẹ rí.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.8",
            "verseOrgIds": [
              "PSA.21.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí ìwọ bá yọ",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.9",
            "verseOrgIds": [
              "PSA.21.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 21:9"
      },
      "items": [
        {
          "text": "ìwọ yóò mú wọn dàbí iná ìléru.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.9",
            "verseOrgIds": [
              "PSA.21.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 21:9"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.21.9",
                "verseOrgIds": [
                  "PSA.21.10"
                ]
              }
            }
          ]
        },
        {
          "text": "yóò gbé wọn mì nínú ìbínú rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.9",
            "verseOrgIds": [
              "PSA.21.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 21:9"
      },
      "items": [
        {
          "text": "àti pé iná rẹ̀ yóò jó wọn run.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.9",
            "verseOrgIds": [
              "PSA.21.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ yóò pa ìrandíran wọn run kúrò lórí ilẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.10",
            "verseOrgIds": [
              "PSA.21.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 21:10"
      },
      "items": [
        {
          "text": "àti irú-ọmọ wọn kúrò láàrín àwọn ọmọ ènìyàn.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.10",
            "verseOrgIds": [
              "PSA.21.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí o tilẹ̀ jẹ́ wí pé wọ́n ro èrò ibi sí ọ",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.11",
            "verseOrgIds": [
              "PSA.21.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 21:11"
      },
      "items": [
        {
          "text": "wọ́n sì ń pète ìwà ìkà, wọn kì yóò ṣe àṣeyọrí.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.11",
            "verseOrgIds": [
              "PSA.21.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí pé ìwọ yóò mú wọn yí ẹ̀yìn wọn padà",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.12",
            "verseOrgIds": [
              "PSA.21.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 21:12"
      },
      "items": [
        {
          "text": "nígbà tí o bá pinnu láti ta wọ́n ní ọfà.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.12",
            "verseOrgIds": [
              "PSA.21.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbígbéga ni ọ́",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.13",
            "verseOrgIds": [
              "PSA.21.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.21.13",
                "verseOrgIds": [
                  "PSA.21.14"
                ]
              }
            }
          ]
        },
        {
          "text": ", nínú agbára rẹ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.13",
            "verseOrgIds": [
              "PSA.21.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 21:13"
      },
      "items": [
        {
          "text": "a ó kọrin, a ó yín agbára a rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.13",
            "verseOrgIds": [
              "PSA.21.14"
            ]
          }
        }
      ]
    }
  ],
