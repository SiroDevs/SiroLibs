        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.131.1",
                "verseOrgIds": [
                  "PSA.131.1"
                ]
              }
            }
          ]
        },
        {
          "text": "àyà mi kò gbéga,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.131.1",
            "verseOrgIds": [
              "PSA.131.1"
            ]
          }
        }
      ]
    },
