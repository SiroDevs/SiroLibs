  "verseCount": 8,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "12",
        "style": "c",
        "sid": "PSA 12"
      },
      "items": [
        {
          "text": "12",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Saamu 12",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Fún adarí orin. Gẹ́gẹ́ bí ti ṣeminiti. Saamu ti Dafidi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ràn wá lọ́wọ́,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.1",
            "verseOrgIds": [
              "PSA.12.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.12.1",
                "verseOrgIds": [
                  "PSA.12.2"
                ]
              }
            }
          ]
        },
        {
          "text": ", nítorí ẹni ìwà-bí-Ọlọ́run kò sí mọ́;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.1",
            "verseOrgIds": [
              "PSA.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 12:1"
      },
      "items": [
        {
          "text": "olóòtítọ́ tí pòórá kúrò láàrín àwọn ènìyàn.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.1",
            "verseOrgIds": [
              "PSA.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olúkúlùkù ń parọ́ fún aládùúgbò rẹ̀;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.2",
            "verseOrgIds": [
              "PSA.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 12:2"
      },
      "items": [
        {
          "text": "ètè èké wọn ń sọ ẹ̀tàn.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.2",
            "verseOrgIds": [
              "PSA.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kí",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.3",
            "verseOrgIds": [
              "PSA.12.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.12.3",
                "verseOrgIds": [
                  "PSA.12.4"
                ]
              }
            }
          ]
        },
        {
          "text": "kí ó gé ètè èké wọn",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.3",
            "verseOrgIds": [
              "PSA.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 12:3"
      },
      "items": [
        {
          "text": "àti gbogbo ahọ́n ìfọ́nnu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.3",
            "verseOrgIds": [
              "PSA.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "tí ó wí pé,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.4",
            "verseOrgIds": [
              "PSA.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 12:4"
      },
      "items": [
        {
          "text": "\"Àwa ó borí pẹ̀lú ahọ́n wa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.4",
            "verseOrgIds": [
              "PSA.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 12:4"
      },
      "items": [
        {
          "text": "àwa ní ètè wa, ta ni ọ̀gá wa?\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.4",
            "verseOrgIds": [
              "PSA.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nítorí ìnilára àwọn aláìlágbára àti ìkérora àwọn aláìní,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.5",
            "verseOrgIds": [
              "PSA.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 12:5"
      },
      "items": [
        {
          "text": "Èmi yóò dìde nísinsin yìí,\" ni",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.5",
            "verseOrgIds": [
              "PSA.12.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.12.5",
                "verseOrgIds": [
                  "PSA.12.6"
                ]
              }
            }
          ]
        },
        {
          "text": "wí.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.5",
            "verseOrgIds": [
              "PSA.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 12:5"
      },
      "items": [
        {
          "text": "\"Èmi yóò dáàbò bò wọ́n lọ́wọ́ àwọn tí ń ṣe àrankàn wọn.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.5",
            "verseOrgIds": [
              "PSA.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ̀rọ̀",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.6",
            "verseOrgIds": [
              "PSA.12.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.12.6",
                "verseOrgIds": [
                  "PSA.12.7"
                ]
              }
            }
          ]
        },
        {
          "text": "sì jẹ aláìlábùkù,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.6",
            "verseOrgIds": [
              "PSA.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 12:6"
      },
      "items": [
        {
          "text": "gẹ́gẹ́ bí fàdákà tí a yọ́ nínú ìléru amọ̀,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.6",
            "verseOrgIds": [
              "PSA.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 12:6"
      },
      "items": [
        {
          "text": "tí a sọ di mímọ́ nígbà méje.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.6",
            "verseOrgIds": [
              "PSA.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.12.7",
                "verseOrgIds": [
                  "PSA.12.8"
                ]
              }
            }
          ]
        },
        {
          "text": ", ìwọ yóò pa wá mọ́",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.7",
            "verseOrgIds": [
              "PSA.12.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 12:7"
      },
      "items": [
        {
          "text": "kí o sì gbà wá lọ́wọ́ àwọn ènìyàn wọ̀nyí títí láé.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.7",
            "verseOrgIds": [
              "PSA.12.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ènìyàn búburú ń rin ìrìn fáàrí kiri",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.8",
            "verseOrgIds": [
              "PSA.12.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 12:8"
      },
      "items": [
        {
          "text": "nígbà tí wọn ń bọ̀wọ̀ fún òsì láàrín àwọn ènìyàn.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.8",
            "verseOrgIds": [
              "PSA.12.9"
            ]
          }
        }
      ]
    }
  ],
