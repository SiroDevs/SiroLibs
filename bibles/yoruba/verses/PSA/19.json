      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 19:13"
      },
      "items": [
        {
          "text": "má ṣe jẹ kí wọn kí ó jẹ ọba lórí mi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.13",
            "verseOrgIds": [
              "PSA.19.14"
            ]
          }
        }
      ]
