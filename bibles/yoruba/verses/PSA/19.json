  "verseCount": 14,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "19",
        "style": "c",
        "sid": "PSA 19"
      },
      "items": [
        {
          "text": "19",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Saamu 19",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Fún adarí orin. Saamu ti Dafidi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 19:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ọ̀run ń sọ nípa ti ògo Ọlọ́run;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.1",
            "verseOrgIds": [
              "PSA.19.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 19:1"
      },
      "items": [
        {
          "text": "àwọsánmọ̀ ń sọ nípa ti iṣẹ́ ọwọ́ rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.1",
            "verseOrgIds": [
              "PSA.19.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n ń fọhùn ní ọjọ́ dé ọjọ́;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.2",
            "verseOrgIds": [
              "PSA.19.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 19:2"
      },
      "items": [
        {
          "text": "wọ́n ń fi ìmọ̀ hàn ní alẹ́ dé alẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.2",
            "verseOrgIds": [
              "PSA.19.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kò sí ohùn tàbí èdè",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.3",
            "verseOrgIds": [
              "PSA.19.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 19:3"
      },
      "items": [
        {
          "text": "níbi tí a kò gbé gbọ́ ìró wọn.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.3",
            "verseOrgIds": [
              "PSA.19.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ohùn wọn jáde lọ sí gbogbo orílẹ̀ ayé,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.4",
            "verseOrgIds": [
              "PSA.19.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 19:4"
      },
      "items": [
        {
          "text": "ọ̀rọ̀ wọn títí dé òpin ilẹ̀ ayé.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.4",
            "verseOrgIds": [
              "PSA.19.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 19:4"
      },
      "items": [
        {
          "text": "Ó ti kọ́ àgọ́ fún oòrùn nínú àwọn ọ̀run.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.4",
            "verseOrgIds": [
              "PSA.19.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tí ó dàbí ọkọ ìyàwó tí ó ń jáde ti yàrá rẹ̀ wá,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.5",
            "verseOrgIds": [
              "PSA.19.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 19:5"
      },
      "items": [
        {
          "text": "òun yọ bí alágbára ọkùnrin tí ó ń sáré ìje.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.5",
            "verseOrgIds": [
              "PSA.19.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìjáde lọ rẹ̀ ni láti òpin ọ̀run wá",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.6",
            "verseOrgIds": [
              "PSA.19.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 19:6"
      },
      "items": [
        {
          "text": "àti àyíká rẹ̀ sì dé ìpínlẹ̀ rẹ̀;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.6",
            "verseOrgIds": [
              "PSA.19.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 19:6"
      },
      "items": [
        {
          "text": "kò sì sí ohun tí ó pamọ́ kúrò nínú oore rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.6",
            "verseOrgIds": [
              "PSA.19.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pípé ni òfin",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.7",
            "verseOrgIds": [
              "PSA.19.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.19.7",
                "verseOrgIds": [
                  "PSA.19.8"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.7",
            "verseOrgIds": [
              "PSA.19.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 19:7"
      },
      "items": [
        {
          "text": "ó ń yí ọkàn padà.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.7",
            "verseOrgIds": [
              "PSA.19.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 19:7"
      },
      "items": [
        {
          "text": "Ẹ̀rí",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.7",
            "verseOrgIds": [
              "PSA.19.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.19.7",
                "verseOrgIds": [
                  "PSA.19.8"
                ]
              }
            }
          ]
        },
        {
          "text": "dánilójú,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.7",
            "verseOrgIds": [
              "PSA.19.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 19:7"
      },
      "items": [
        {
          "text": "ó sọ òpè di ọlọ́gbọ́n.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.7",
            "verseOrgIds": [
              "PSA.19.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìlànà",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.8",
            "verseOrgIds": [
              "PSA.19.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.19.8",
                "verseOrgIds": [
                  "PSA.19.9"
                ]
              }
            }
          ]
        },
        {
          "text": "tọ̀nà,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.8",
            "verseOrgIds": [
              "PSA.19.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 19:8"
      },
      "items": [
        {
          "text": "ó ń fi ayọ̀ fún ọkàn.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.8",
            "verseOrgIds": [
              "PSA.19.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 19:8"
      },
      "items": [
        {
          "text": "Àṣẹ",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.8",
            "verseOrgIds": [
              "PSA.19.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.19.8",
                "verseOrgIds": [
                  "PSA.19.9"
                ]
              }
            }
          ]
        },
        {
          "text": "ni mímọ́,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.8",
            "verseOrgIds": [
              "PSA.19.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 19:8"
      },
      "items": [
        {
          "text": "ó ń fi ìmọ́lẹ̀ fún ojú.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.8",
            "verseOrgIds": [
              "PSA.19.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìbẹ̀rù",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.9",
            "verseOrgIds": [
              "PSA.19.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.19.9",
                "verseOrgIds": [
                  "PSA.19.10"
                ]
              }
            }
          ]
        },
        {
          "text": "mọ́,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.9",
            "verseOrgIds": [
              "PSA.19.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 19:9"
      },
      "items": [
        {
          "text": "ó ń faradà títí láéláé.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.9",
            "verseOrgIds": [
              "PSA.19.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 19:9"
      },
      "items": [
        {
          "text": "Ìdájọ́",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.9",
            "verseOrgIds": [
              "PSA.19.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.19.9",
                "verseOrgIds": [
                  "PSA.19.10"
                ]
              }
            }
          ]
        },
        {
          "text": "dájú",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.9",
            "verseOrgIds": [
              "PSA.19.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 19:9"
      },
      "items": [
        {
          "text": "òdodo ni gbogbo wọn.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.9",
            "verseOrgIds": [
              "PSA.19.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọn ṣọ̀wọ́n ju wúrà lọ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.10",
            "verseOrgIds": [
              "PSA.19.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 19:10"
      },
      "items": [
        {
          "text": "ju wúrà tí o dára jùlọ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.10",
            "verseOrgIds": [
              "PSA.19.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 19:10"
      },
      "items": [
        {
          "text": "wọ́n dùn ju oyin lọ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.10",
            "verseOrgIds": [
              "PSA.19.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 19:10"
      },
      "items": [
        {
          "text": "àti ju afárá oyin lọ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.10",
            "verseOrgIds": [
              "PSA.19.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nípa wọn ni a ti ṣí ìránṣẹ́ rẹ̀ létí;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.11",
            "verseOrgIds": [
              "PSA.19.12"
            ]
          }
        }
      ]
    },
    {
