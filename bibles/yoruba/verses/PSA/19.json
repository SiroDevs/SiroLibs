      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 19:13"
      },
      "items": [
        {
          "text": "Nígbà náà ní èmi yóò dúró ṣinṣin,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.13",
            "verseOrgIds": [
              "PSA.19.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 19:13"
      },
      "items": [
        {
          "text": "èmi yóò sì ṣe aláìlẹ́bi kúrò nínú ẹ̀ṣẹ̀ ńlá.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.13",
            "verseOrgIds": [
              "PSA.19.14"
            ]
          }
        }
