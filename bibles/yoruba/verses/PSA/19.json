            "sid": "PSA 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wẹ ìránṣẹ́ rẹ mọ́ kúrò nínú ẹ̀ṣẹ̀ àmọ̀ọ́n-mọ̀-dá;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.13",
            "verseOrgIds": [
              "PSA.19.14"
            ]
          }
        }
      ]
    },
