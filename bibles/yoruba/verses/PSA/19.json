            "sid": "PSA 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ta ni ó lè mọ àṣìṣe rẹ̀?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.12",
            "verseOrgIds": [
              "PSA.19.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 19:12"
      },
      "items": [
        {
          "text": "Dáríjì mí nínú àṣìṣe mi tí ó pamọ́.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.12",
            "verseOrgIds": [
              "PSA.19.13"
            ]
          }
        }
      ]
    },
