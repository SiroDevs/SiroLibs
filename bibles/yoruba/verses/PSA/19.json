              "type": "text"
            }
          ]
        },
        {
          "text": "Jẹ́ kí ọ̀rọ̀ ẹnu mi àti àṣàrò ọkàn mi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.14",
