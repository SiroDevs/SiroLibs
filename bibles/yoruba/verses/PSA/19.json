      "attrs": {
        "style": "q2",
        "vid": "PSA 19:11"
      },
      "items": [
        {
          "text": "nípa pípa wọ́n mọ́, èrè púpọ̀ ń bẹ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.11",
            "verseOrgIds": [
              "PSA.19.12"
