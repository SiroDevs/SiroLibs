          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.116.6",
                "verseOrgIds": [
                  "PSA.116.6"
                ]
              }
            }
          ]
        },
        {
          "text": "pa àwọn ọlọ́kàn fífúyẹ́ mọ́",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.6",
            "verseOrgIds": [
              "PSA.116.6"
            ]
          }
        }
      ]
