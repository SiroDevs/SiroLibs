        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.116.9",
                "verseOrgIds": [
                  "PSA.116.9"
                ]
              }
            }
          ]
