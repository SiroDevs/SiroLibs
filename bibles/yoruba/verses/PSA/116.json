      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 116:12"
      },
      "items": [
        {
          "text": "nítorí gbogbo rere rẹ̀ sí mi?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.12",
            "verseOrgIds": [
              "PSA.116.12"
            ]
          }
        }
