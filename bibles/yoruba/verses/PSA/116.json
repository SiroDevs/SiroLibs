            "number": "3",
            "style": "v",
            "sid": "PSA 116:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okùn ikú yí mi ká,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.3",
            "verseOrgIds": [
              "PSA.116.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 116:3"
      },
      "items": [
        {
          "text": "ìrora isà òkú wá sórí mi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.3",
            "verseOrgIds": [
              "PSA.116.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 116:3"
      },
      "items": [
        {
          "text": "ìyọnu àti ìbànújẹ́ borí mi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.3",
            "verseOrgIds": [
              "PSA.116.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
