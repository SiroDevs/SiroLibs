      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 116:5"
      },
      "items": [
        {
          "text": "Ọlọ́run wa kún fún àánú.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.5",
            "verseOrgIds": [
              "PSA.116.5"
            ]
          }
        }
      ]
    },
    {
