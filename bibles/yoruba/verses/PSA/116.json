          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni mo ké pe orúkọ",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.4",
            "verseOrgIds": [
              "PSA.116.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.116.4",
                "verseOrgIds": [
                  "PSA.116.4"
                ]
              }
            }
          ]
        },
        {
          "text": ":",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.4",
            "verseOrgIds": [
              "PSA.116.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 116:4"
      },
      "items": [
        {
          "text": "\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.4",
            "verseOrgIds": [
              "PSA.116.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
