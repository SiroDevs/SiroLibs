          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi gbàgbọ́; nítorí náà mo wí pé,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.10",
            "verseOrgIds": [
              "PSA.116.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 116:10"
      },
      "items": [
        {
          "text": "\"èmi rí ìpọ́njú púpọ̀\".",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.10",
            "verseOrgIds": [
              "PSA.116.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 116:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àti nínú ìdààmú mi mo wí pé,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.11",
            "verseOrgIds": [
              "PSA.116.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 116:11"
      },
      "items": [
        {
          "text": "\"Èké ni gbogbo ènìyàn\".",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.11",
            "verseOrgIds": [
              "PSA.116.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 116:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kí ni èmi yóò san fún",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.12",
            "verseOrgIds": [
              "PSA.116.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.116.12",
                "verseOrgIds": [
                  "PSA.116.12"
                ]
              }
            }
          ]
        }
      ]
    },
    {
