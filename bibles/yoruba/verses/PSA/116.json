                "verseId": "PSA.116.4",
                "verseOrgIds": [
                  "PSA.116.4"
                ]
              }
            }
          ]
        },
        {
          "text": ", èmi bẹ̀ ọ́, gba ọkàn mi!\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.4",
            "verseOrgIds": [
              "PSA.116.4"
            ]
          }
        }
