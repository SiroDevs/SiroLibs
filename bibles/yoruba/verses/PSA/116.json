      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 116:6"
      },
      "items": [
        {
          "text": "nígbà tí mo wà nínú àìní ńlá, ó gbà mí.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.6",
            "verseOrgIds": [
              "PSA.116.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
