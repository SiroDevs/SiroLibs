                "verseId": "PSA.116.5",
                "verseOrgIds": [
                  "PSA.116.5"
                ]
              }
            }
          ]
        },
        {
          "text": "ní oore-ọ̀fẹ́, ó sì ní òdodo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.5",
            "verseOrgIds": [
              "PSA.116.5"
            ]
          }
        }
