              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi fẹ́ràn",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.1",
            "verseOrgIds": [
              "PSA.116.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.116.1",
                "verseOrgIds": [
                  "PSA.116.1"
                ]
              }
            }
          ]
        },
        {
          "text": ", nítorí ó gbọ́ ohùn mi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.1",
            "verseOrgIds": [
              "PSA.116.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 116:1"
      },
      "items": [
        {
          "text": "ó gbọ́ ẹkún mi fún àánú.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.1",
            "verseOrgIds": [
              "PSA.116.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 116:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí ó yí etí rẹ̀ padà sí mi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.2",
            "verseOrgIds": [
              "PSA.116.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 116:2"
      },
      "items": [
        {
          "text": "èmi yóò máa pè é ni wọ́n ìgbà tí mo wà láààyè.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.2",
            "verseOrgIds": [
              "PSA.116.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
