  "verseCount": 20,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "9",
        "style": "c",
        "sid": "PSA 9"
      },
      "items": [
        {
          "text": "9",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Saamu 9",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Fún adarí orin. Ní ti ohun orin. \"Ní ti ikú ọmọ.\" Saamu ti Dafidi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi ó yìn ọ́,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.1",
            "verseOrgIds": [
              "PSA.9.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.9.1",
                "verseOrgIds": [
                  "PSA.9.2"
                ]
              }
            }
          ]
        },
        {
          "text": ", pẹ̀lú gbogbo ọkàn mi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.1",
            "verseOrgIds": [
              "PSA.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 9:1"
      },
      "items": [
        {
          "text": "èmi ó sọ ti ìyanu rẹ gbogbo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.1",
            "verseOrgIds": [
              "PSA.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inú mi yóò dùn, èmi yóò sì yọ̀ nínú rẹ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.2",
            "verseOrgIds": [
              "PSA.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 9:2"
      },
      "items": [
        {
          "text": "èmi ó kọrin ìyìn sí orúkọ rẹ, Ìwọ Ọ̀gá-Ògo jùlọ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.2",
            "verseOrgIds": [
              "PSA.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ọ̀tá mi pẹ̀yìndà;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.3",
            "verseOrgIds": [
              "PSA.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 9:3"
      },
      "items": [
        {
          "text": "wọ́n kọsẹ̀ wọn sì ṣègbé níwájú rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.3",
            "verseOrgIds": [
              "PSA.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí ìwọ ti di òtítọ́ àti ọ̀ràn mi mú;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.4",
            "verseOrgIds": [
              "PSA.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 9:4"
      },
      "items": [
        {
          "text": "ìwọ ti jókòó lórí ìtẹ́ rẹ, láti ṣe ìdájọ́ òdodo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.4",
            "verseOrgIds": [
              "PSA.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ ti bá orílẹ̀-èdè wí, Ìwọ sì ti pa ẹni búburú run;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.5",
            "verseOrgIds": [
              "PSA.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 9:5"
      },
      "items": [
        {
          "text": "Ìwọ ti yọ orúkọ wọn kúrò láé àti láéláé.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.5",
            "verseOrgIds": [
              "PSA.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìparun àìlópin ti borí àwọn ọ̀tá,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.6",
            "verseOrgIds": [
              "PSA.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 9:6"
      },
      "items": [
        {
          "text": "ìwọ ti fa àwọn ìlú wọn tu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.6",
            "verseOrgIds": [
              "PSA.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 9:6"
      },
      "items": [
        {
          "text": "àní ìrántí wọn sì ti ṣègbé.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.6",
            "verseOrgIds": [
              "PSA.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.9.7",
                "verseOrgIds": [
                  "PSA.9.8"
                ]
              }
            }
          ]
        },
        {
          "text": "jẹ ọba títí láé;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.7",
            "verseOrgIds": [
              "PSA.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 9:7"
      },
      "items": [
        {
          "text": "ó ti gbé ìtẹ́ rẹ̀ kalẹ̀ fún ìdájọ́.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.7",
            "verseOrgIds": [
              "PSA.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Òun yóò sì ṣe ìdájọ́ ayé ní òdodo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.8",
            "verseOrgIds": [
              "PSA.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 9:8"
      },
      "items": [
        {
          "text": "yóò ṣe àkóso ènìyàn pẹ̀lú òdodo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.8",
            "verseOrgIds": [
              "PSA.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.9.9",
                "verseOrgIds": [
                  "PSA.9.10"
                ]
              }
            }
          ]
        },
        {
          "text": "ni ààbò fún àwọn tí a ni lára,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.9",
            "verseOrgIds": [
              "PSA.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 9:9"
      },
      "items": [
        {
          "text": "ibi ìsádi ní àkókò ìpọ́njú.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.9",
            "verseOrgIds": [
              "PSA.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn tí ó mọ orúkọ rẹ yóò gbẹ́kẹ̀lé ọ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.10",
            "verseOrgIds": [
              "PSA.9.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 9:10"
      },
      "items": [
        {
          "text": "nítorí,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.10",
            "verseOrgIds": [
              "PSA.9.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.9.10",
                "verseOrgIds": [
                  "PSA.9.11"
                ]
              }
            }
          ]
        },
        {
          "text": ", kò kọ àwọn tó ń wá a sílẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.10",
            "verseOrgIds": [
              "PSA.9.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kọ orin ìyìn sí",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.11",
            "verseOrgIds": [
              "PSA.9.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.9.11",
                "verseOrgIds": [
                  "PSA.9.12"
                ]
              }
            }
          ]
        },
        {
          "text": ", tí o ń jẹ ọba ní Sioni;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.11",
            "verseOrgIds": [
              "PSA.9.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 9:11"
      },
      "items": [
        {
          "text": "kéde láàrín àwọn orílẹ̀-èdè, ohun tí ó ṣe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.11",
            "verseOrgIds": [
              "PSA.9.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí ẹni tí ó ń gbẹ̀san ẹ̀jẹ̀ rántí;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.12",
            "verseOrgIds": [
              "PSA.9.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 9:12"
      },
      "items": [
        {
          "text": "òun kò kọ ẹkún àwọn tí a pọ́n lójú.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.12",
            "verseOrgIds": [
              "PSA.9.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.9.13",
                "verseOrgIds": [
                  "PSA.9.14"
                ]
              }
            }
          ]
        },
        {
          "text": ", wo bí àwọn ọ̀tá ṣe ń ṣe inúnibíni sí mi!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.13",
            "verseOrgIds": [
              "PSA.9.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 9:13"
      },
      "items": [
        {
          "text": "Ṣàánú, kí o sì gbé mí sókè kúrò ní ẹnu-ọ̀nà ikú,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.13",
            "verseOrgIds": [
              "PSA.9.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "kí èmi kí ó lè sọ ti ìyìn rẹ",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.14",
            "verseOrgIds": [
              "PSA.9.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 9:14"
      },
      "items": [
        {
          "text": "ni ẹnu-ọ̀nà àwọn ọmọbìnrin Sioni",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.14",
            "verseOrgIds": [
