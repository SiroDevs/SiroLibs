  "verseCount": 9,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "47",
        "style": "c",
        "sid": "PSA 47"
      },
      "items": [
        {
          "text": "47",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Saamu 47",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Fún adarí orin. Ti àwọn ọmọ Kora. Saamu.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 47:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ pàtẹ́wọ́, gbogbo ẹ̀yin ènìyàn",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.1",
            "verseOrgIds": [
              "PSA.47.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 47:1"
      },
      "items": [
        {
          "text": "ẹ hó sí Ọlọ́run pẹ̀lú orin ayọ̀ tó rinlẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.1",
            "verseOrgIds": [
              "PSA.47.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 47:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Báwo ni",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.2",
            "verseOrgIds": [
              "PSA.47.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.47.2",
                "verseOrgIds": [
                  "PSA.47.3"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọ̀gá-ògo ti ní ẹ̀rù tó",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.2",
            "verseOrgIds": [
              "PSA.47.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 47:2"
      },
      "items": [
        {
          "text": "ọba ńlá lórí gbogbo ayé.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.2",
            "verseOrgIds": [
              "PSA.47.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 47:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣe ìkápá àwọn orílẹ̀-èdè lábẹ́ wa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.3",
            "verseOrgIds": [
              "PSA.47.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 47:3"
      },
      "items": [
        {
          "text": "àwọn ènìyàn lábẹ́ ẹsẹ̀ wa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.3",
            "verseOrgIds": [
              "PSA.47.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 47:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó mú ilẹ̀ ìní wa fún wa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.4",
            "verseOrgIds": [
              "PSA.47.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 47:4"
      },
      "items": [
        {
          "text": "ọlá Jakọbu, ẹni tí ó fẹ́ wa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.4",
            "verseOrgIds": [
              "PSA.47.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 47:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọlọ́run tó gòkè lọ tí òun tayọ̀,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.5",
            "verseOrgIds": [
              "PSA.47.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 47:5"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.47.5",
                "verseOrgIds": [
                  "PSA.47.6"
                ]
              }
            }
          ]
        },
        {
          "text": "ti òun ti ariwo ìpè.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.5",
            "verseOrgIds": [
              "PSA.47.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 47:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ kọrin ìyìn sí Ọlọ́run, ẹ kọrin ìyìn.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.6",
            "verseOrgIds": [
              "PSA.47.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 47:6"
      },
      "items": [
        {
          "text": "Ẹ kọrin ìyìn sí ọba wa, ẹ kọrin ìyìn!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.6",
            "verseOrgIds": [
              "PSA.47.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 47:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí Ọlọ́run ni ọba gbogbo ayé,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.7",
            "verseOrgIds": [
              "PSA.47.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 47:7"
      },
      "items": [
        {
          "text": "ẹ kọrin ìyìn pẹ̀lú Saamu!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.7",
            "verseOrgIds": [
              "PSA.47.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 47:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọlọ́run jẹ ọba lórí gbogbo kèfèrí;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.8",
            "verseOrgIds": [
              "PSA.47.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 47:8"
      },
      "items": [
        {
          "text": "Ọlọ́run jókòó lórí ìtẹ́ ìwà mímọ́ rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.8",
            "verseOrgIds": [
              "PSA.47.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 47:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn aládé ayé kó ara wọn jọ",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.9",
            "verseOrgIds": [
              "PSA.47.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 47:9"
      },
      "items": [
        {
          "text": "gẹ́gẹ́ bí ènìyàn Ọlọ́run Abrahamu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.9",
            "verseOrgIds": [
              "PSA.47.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 47:9"
      },
      "items": [
        {
          "text": "nítorí asà ayé ti Ọlọ́run ni,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.9",
            "verseOrgIds": [
              "PSA.47.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 47:9"
      },
      "items": [
        {
          "text": "òun ni ó ga jùlọ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.9",
            "verseOrgIds": [
              "PSA.47.10"
            ]
          }
        }
      ]
    }
  ],
