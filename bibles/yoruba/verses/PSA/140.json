    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Saamu 140",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Fún adarí orin. Saamu ti Dafidi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 140:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.140.1",
                "verseOrgIds": [
                  "PSA.140.2"
                ]
              }
            }
          ]
        },
        {
          "text": ", gbà mi lọ́wọ́ ọkùnrin búburú u nì,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.1",
            "verseOrgIds": [
              "PSA.140.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 140:1"
      },
      "items": [
        {
          "text": "yọ mí lọ́wọ́ ọkùnrin ìkà a nì,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.1",
            "verseOrgIds": [
              "PSA.140.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 140:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ẹni tí ń ro ìwà búburú ní inú wọn;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.2",
            "verseOrgIds": [
              "PSA.140.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 140:2"
      },
      "items": [
        {
          "text": "nígbà gbogbo ni wọ́n ń rú ìjà sókè sí mi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.2",
            "verseOrgIds": [
              "PSA.140.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 140:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n ti pọ́n ahọ́n wọn bí ejò,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.3",
            "verseOrgIds": [
              "PSA.140.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 140:3"
      },
      "items": [
        {
          "text": "oró paramọ́lẹ̀ ń bẹ ní abẹ́ ètè wọn.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.3",
            "verseOrgIds": [
              "PSA.140.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 140:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.140.4",
                "verseOrgIds": [
                  "PSA.140.5"
                ]
              }
            }
          ]
        },
        {
          "text": ", pa mí mọ́ kúrò lọ́wọ́ àwọn ènìyàn búburú;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.4",
            "verseOrgIds": [
              "PSA.140.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 140:4"
      },
      "items": [
        {
          "text": "yọ mí kúrò lọ́wọ́ ọkùnrin ìkà a nì",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.4",
            "verseOrgIds": [
              "PSA.140.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 140:4"
      },
      "items": [
        {
          "text": "ẹni tí ó ti pinnu rẹ̀ láti bi ìrìn mi ṣubú.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.4",
            "verseOrgIds": [
              "PSA.140.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 140:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn agbéraga ti dẹkùn sílẹ̀ fún mi àti okùn:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.5",
            "verseOrgIds": [
              "PSA.140.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 140:5"
      },
      "items": [
        {
          "text": "wọ́n ti na àwọ̀n lẹ́bàá ọ̀nà;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.5",
            "verseOrgIds": [
              "PSA.140.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 140:5"
      },
      "items": [
        {
          "text": "wọ́n ti kẹ́kùn sílẹ̀ fún mi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.5",
            "verseOrgIds": [
              "PSA.140.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 140:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi wí fún",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.6",
            "verseOrgIds": [
              "PSA.140.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.140.6",
                "verseOrgIds": [
                  "PSA.140.7"
                ]
              }
            }
          ]
        },
        {
          "text": "pé ìwọ ni Ọlọ́run mi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.6",
            "verseOrgIds": [
              "PSA.140.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 140:6"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.140.6",
                "verseOrgIds": [
                  "PSA.140.7"
                ]
              }
            }
          ]
        },
        {
          "text": ", gbọ́ ohùn ẹ̀bẹ̀ mi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.6",
            "verseOrgIds": [
              "PSA.140.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 140:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.140.7",
                "verseOrgIds": [
                  "PSA.140.8"
                ]
              }
            }
          ]
        },
        {
          "text": "Olódùmarè, agbára ìgbàlà mi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.7",
            "verseOrgIds": [
              "PSA.140.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 140:7"
      },
      "items": [
        {
          "text": "ìwọ ni ó bo orí mi mọ́lẹ̀ ní ọjọ́ ìjà.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.7",
            "verseOrgIds": [
              "PSA.140.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 140:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.140.8",
                "verseOrgIds": [
                  "PSA.140.9"
                ]
              }
            }
          ]
        },
        {
          "text": ", máa ṣe fi ìfẹ́ ènìyàn búburú fún un;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.8",
            "verseOrgIds": [
              "PSA.140.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 140:8"
      },
      "items": [
        {
          "text": "má ṣe kún ọgbọ́n búburú rẹ̀ lọ́wọ́;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.8",
            "verseOrgIds": [
              "PSA.140.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 140:8"
      },
      "items": [
        {
          "text": "kí wọn kí ó máa ba à gbé ara wọn ga.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.8",
            "verseOrgIds": [
              "PSA.140.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "qs"
          },
          "items": [
            {
              "text": "Sela.",
              "type": "text",
              "attrs": {
                "verseId": "PSA.140.8",
                "verseOrgIds": [
                  "PSA.140.9"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 140:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ó ṣe ti orí àwọn tí ó yí mi káàkiri ni,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.9",
            "verseOrgIds": [
              "PSA.140.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 140:9"
      },
      "items": [
        {
          "text": "jẹ́ kí ète ìka ara wọn kí ó bò wọ́n mọ́lẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.9",
            "verseOrgIds": [
              "PSA.140.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 140:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "A ó da ẹ̀yin iná sí wọn lára,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.10",
            "verseOrgIds": [
              "PSA.140.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 140:10"
      },
      "items": [
        {
          "text": "Òun yóò wọ́ wọn lọ sínú iná,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.10",
            "verseOrgIds": [
              "PSA.140.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 140:10"
      },
      "items": [
        {
          "text": "sínú ọ̀gbun omi jíjìn,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.10",
            "verseOrgIds": [
              "PSA.140.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 140:10"
      },
      "items": [
        {
          "text": "kí wọn kí ó má ba à le dìde mọ́.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.10",
            "verseOrgIds": [
              "PSA.140.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 140:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Má ṣe jẹ́ kí aláhọ́n búburú fi ẹsẹ̀ múlẹ̀ ní ayé;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.11",
            "verseOrgIds": [
              "PSA.140.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 140:11"
      },
      "items": [
        {
          "text": "ibi ni yóò máa dọdẹ ọkùnrin ìkà nì láti bì í ṣubú.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.11",
            "verseOrgIds": [
              "PSA.140.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 140:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi mọ̀ pé,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.12",
            "verseOrgIds": [
              "PSA.140.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.140.12",
                "verseOrgIds": [
                  "PSA.140.13"
                ]
              }
            }
          ]
        },
        {
          "text": "yóò mú ọ̀nà olùpọ́njú dúró,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.12",
            "verseOrgIds": [
              "PSA.140.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 140:12"
      },
      "items": [
        {
          "text": "yóò sì ṣe ẹ̀tọ́ fún àwọn tálákà.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.12",
            "verseOrgIds": [
              "PSA.140.13"
            ]
          }
