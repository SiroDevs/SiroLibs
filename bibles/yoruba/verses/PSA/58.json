  "verseCount": 11,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "58",
        "style": "c",
        "sid": "PSA 58"
      },
      "items": [
        {
          "text": "58",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Saamu 58",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Fún adarí orin. Tí ohùn \"Má ṣe parun.\" Ti Dafidi. Miktamu.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 58:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ̀yin ha ń sọ òdodo nítòótọ́",
          "type": "text",
          "attrs": {
            "verseId": "PSA.58.1",
            "verseOrgIds": [
              "PSA.58.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 58:1"
      },
      "items": [
        {
          "text": "ẹ̀yin ìjọ ènìyàn?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.58.1",
            "verseOrgIds": [
              "PSA.58.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 58:1"
      },
      "items": [
        {
          "text": "Ǹjẹ́ ẹ̀yin ń ṣe ìdájọ́ tí ó ṣe títọ́",
          "type": "text",
          "attrs": {
            "verseId": "PSA.58.1",
            "verseOrgIds": [
              "PSA.58.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 58:1"
      },
      "items": [
        {
          "text": "ẹ̀yìn ọmọ ènìyàn?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.58.1",
            "verseOrgIds": [
              "PSA.58.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 58:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ kọ́, nínú ọkàn yín ẹ̀yìn ń gbèrò àìṣòdodo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.58.2",
            "verseOrgIds": [
              "PSA.58.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 58:2"
      },
      "items": [
        {
          "text": "ọwọ́ yín sì tú ìwà ipá jáde ni ayé.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.58.2",
            "verseOrgIds": [
              "PSA.58.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 58:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní inú ìyá wọn wá ni ènìyàn búburú tí ṣìnà,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.58.3",
            "verseOrgIds": [
              "PSA.58.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 58:3"
      },
      "items": [
        {
          "text": "lójúkan náà tí a ti bí wọn, wọn a máa ṣèké.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.58.3",
            "verseOrgIds": [
              "PSA.58.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 58:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oró wọn dàbí oró ejò,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.58.4",
            "verseOrgIds": [
              "PSA.58.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 58:4"
      },
      "items": [
        {
          "text": "wọn dàbí adití ejò paramọ́lẹ̀ tí ó di ara rẹ̀ ni etí,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.58.4",
            "verseOrgIds": [
              "PSA.58.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 58:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "tí kò ní gbọ́ ìpè àwọn atunilójú,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.58.5",
            "verseOrgIds": [
              "PSA.58.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 58:5"
      },
      "items": [
        {
          "text": "bí ó ti wù kí ó máa fi ọgbọ́n ṣe ìtujú tó.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.58.5",
            "verseOrgIds": [
              "PSA.58.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 58:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ká eyín ẹnu wọn, Ọlọ́run;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.58.6",
            "verseOrgIds": [
              "PSA.58.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 58:6"
      },
      "items": [
        {
          "text": "ní ẹnu wọn,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.58.6",
            "verseOrgIds": [
              "PSA.58.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 58:6"
      },
      "items": [
        {
          "text": "ká ọ̀gàn àwọn ọmọ kìnnìún,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.58.6",
            "verseOrgIds": [
              "PSA.58.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.58.6",
                "verseOrgIds": [
                  "PSA.58.7"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "PSA.58.6",
            "verseOrgIds": [
              "PSA.58.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 58:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jẹ́ kí wọn parẹ́ bí omi tó ń sàn lọ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.58.7",
            "verseOrgIds": [
              "PSA.58.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 58:7"
      },
      "items": [
        {
          "text": "nígbà tí ó bá fa ọfà rẹ̀, kí ọ̀kọ̀ wọn kí ó ṣẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.58.7",
            "verseOrgIds": [
              "PSA.58.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 58:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jẹ́ kí wọn rí bí ìgbín tí rẹ̀ dànù tí ó sì ṣègbé",
          "type": "text",
          "attrs": {
            "verseId": "PSA.58.8",
            "verseOrgIds": [
              "PSA.58.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 58:8"
      },
      "items": [
        {
          "text": "bí ọmọ tí oṣù rẹ̀ kò pé, kí wọn má ṣe rí oòrùn.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.58.8",
            "verseOrgIds": [
              "PSA.58.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 58:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kí ìkòkò yín kí ó tó mọ ìgbóná ẹ̀gún;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.58.9",
            "verseOrgIds": [
              "PSA.58.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 58:9"
      },
      "items": [
        {
          "text": "bóyá ní tútù tàbí ní gbígbẹ, yóò fi ìjì gbá wọn lọ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.58.9",
            "verseOrgIds": [
              "PSA.58.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 58:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olódodo yóò yọ̀ nígbà a bá ń gbẹ̀san wọn,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.58.10",
            "verseOrgIds": [
              "PSA.58.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 58:10"
      },
      "items": [
        {
          "text": "nígbà tí wọn bá wẹ ẹsẹ̀ wọn nínú ẹ̀jẹ̀ ènìyàn búburú.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.58.10",
            "verseOrgIds": [
              "PSA.58.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 58:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ènìyàn yóò wí pé,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.58.11",
            "verseOrgIds": [
              "PSA.58.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 58:11"
      },
      "items": [
        {
          "text": "\"Lóòtítọ́ èrè àwọn ń bẹ fún olódodo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.58.11",
            "verseOrgIds": [
              "PSA.58.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 58:11"
      },
      "items": [
        {
          "text": "lóòtítọ́ òun ni Ọlọ́run tí ń ṣe ìdájọ́ ní ayé.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.58.11",
            "verseOrgIds": [
              "PSA.58.12"
            ]
          }
        }
      ]
    }
  ],
