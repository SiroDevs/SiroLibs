  "verseCount": 45,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "11",
        "style": "c",
        "sid": "DAN 11"
      },
      "items": [
        {
          "text": "11",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "nb"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DAN 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọdún kìn-ín-ní Dariusi ará Media, mo dúró láti tì í lẹ́yìn àti láti dáàbò bò ó.)",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.1",
            "verseOrgIds": [
              "DAN.11.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Àwọn ọba gúúsù àti àríwá",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DAN 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ní ìsinsin yìí, mo sọ òtítọ́ fún ọ ọba mẹ́ta yóò dìde sí i ní Persia, àti ẹ̀kẹrin tí yóò jẹ́ ọlọ́rọ̀ ju gbogbo wọn lọ. Tí ó bá ti di alágbára nípa ọrọ̀ rẹ̀, yóò sì ru gbogbo wọn sókè lòdì sí ìjọba Giriki.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.2",
            "verseOrgIds": [
              "DAN.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DAN 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni ọba alágbára kan yóò fi ara hàn, yóò ṣe àkóso pẹ̀lú agbára ńlá, yóò sì ṣe bí ó ti wù ú.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.3",
            "verseOrgIds": [
              "DAN.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DAN 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lẹ́yìn ìgbà tí ó bá fi ara hàn tán, ìjọba rẹ̀ yóò fọ́, yóò sì pín sí mẹ́rin ní orígun mẹ́rẹ̀ẹ̀rin ayé, ìjọba náà kò sì ṣọ́wọ́ àwọn ìran rẹ̀ tàbí kí ó ní agbára tí ó ń lò tẹ́lẹ̀, nítorí, a ó fa ìjọba rẹ̀ tu a ó sì fi fún àwọn mìíràn.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.4",
            "verseOrgIds": [
              "DAN.11.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DAN 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ọba ìhà gúúsù yóò di alágbára ṣùgbọ́n ọ̀kan lára àwọn aláṣẹ rẹ̀ yóò di alágbára jù ú lọ, yóò sì ṣe àkóso ìjọba rẹ̀ pẹ̀lú agbára ńlá.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.5",
            "verseOrgIds": [
              "DAN.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DAN 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lẹ́yìn ọdún púpọ̀ wọn yóò dá májẹ̀mú àlàáfíà, ọmọbìnrin ọba gúúsù yóò lọ sí ọ̀dọ̀ ọba àríwá láti bá a dá májẹ̀mú àlàáfíà, ṣùgbọ́n òun kì yóò lè di agbára apá a rẹ̀ mú, bẹ́ẹ̀ ni òun kì yóò lè dádúró, ṣùgbọ́n a ó tẹrí i rẹ̀ ba àti àwọn tí ó mú un wá, àti ọmọ tí ó bí, àti ẹni tí ó ń mu lọ́kàn le ní gbogbo àkókò wọ̀nyí.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.6",
            "verseOrgIds": [
              "DAN.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DAN 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ọ̀kan lára àwọn ìdílé e rẹ̀, ọmọbìnrin ọba gúúsù yóò dìde láti gba ipò o rẹ̀. Yóò sì kọlu ogun ọba àríwá, yóò sì wó odi alágbára; yóò bá wọn jà yóò sì borí.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.7",
            "verseOrgIds": [
              "DAN.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DAN 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yóò gba òrìṣà wọn, ère dídá àti ohun èlò oníye lórí ti fàdákà àti ti wúrà, yóò sì kó wọn lọ sí Ejibiti. Fún ọdún díẹ̀ yóò fi ọba àríwá lọ́rùn sílẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.8",
            "verseOrgIds": [
              "DAN.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DAN 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà, ni ọba àríwá yóò gbógun ti ilẹ̀ ọba, gúúsù, ṣùgbọ́n yóò padà sí Orílẹ̀-èdè, òun fúnra rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.9",
            "verseOrgIds": [
              "DAN.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DAN 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ọmọ rẹ̀ yóò múra ogun wọn yóò kó ogun ńlá jọ, èyí tí a ó gbá lọ bí àgbàrá omi ńlá, yóò sì gbá a lọ títí dé ìlú olódi rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.10",
            "verseOrgIds": [
              "DAN.11.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DAN 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nígbà náà ni ọba gúúsù yóò jáde pẹ̀lú ìbínú, yóò sì bá ọba àríwá jà, ẹni tí yóò kó ọmọ-ogun púpọ̀ jọ, ṣùgbọ́n ọba gúúsù yóò borí i wọn.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.11",
            "verseOrgIds": [
              "DAN.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DAN 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí a bá kó ogun náà lọ, ọba gúúsù yóò kún fún agbára, yóò sì pa ẹgbẹẹgbẹ̀rún ní ìpakúpa síbẹ̀ kì yóò ṣẹ́gun.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.12",
            "verseOrgIds": [
              "DAN.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DAN 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí ọba àríwá yóò lọ kó ogun mìíràn jọ, tí ó pọ̀ ju ti àkọ́kọ́ lẹ́yìn ọ̀pọ̀lọpọ̀ ọdún, yóò jáde pẹ̀lú ọ̀pọ̀lọpọ̀ ogun tí ó ti dira ogun fún dáradára.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.13",
            "verseOrgIds": [
              "DAN.11.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DAN 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ní àkókò ìgbà náà, ni ọ̀pọ̀lọpọ̀ yóò dìde sí ọba gúúsù. Àwọn ọlọ̀tẹ̀ nínú àwọn ènìyàn an rẹ̀ yóò ṣọ̀tẹ̀ ní ìmúṣẹ ìran náà, ṣùgbọ́n wọn kì yóò borí.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.14",
            "verseOrgIds": [
              "DAN.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DAN 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni ọba àríwá yóò wá yóò sì gbé ogun tì í, yóò sì kó ìlú olódi. Ogun ọba gúúsù kò ní ní agbára láti kọjú ìjà sí i; bẹ́ẹ̀ ni àwọn ọ̀wọ́ ogun tó dára jù kò ní ní agbára láti dúró.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.15",
            "verseOrgIds": [
              "DAN.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DAN 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹni tí ó gbóguntì í yóò máa ṣe bí ó ti wù ú, kò sì ṣí ẹni tí yóò le è dojúkọ ọ́. Yóò sì fún ara rẹ̀ ní ibùjókòó ní ilẹ̀ tí ó dára, yóò sì ní agbára láti bà á jẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.16",
            "verseOrgIds": [
              "DAN.11.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DAN 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yóò pinnu láti wá pẹ̀lú agbára ìjọba rẹ̀, yóò sì ní májẹ̀mú àlàáfíà pẹ̀lú ọba gúúsù yóò sì fi ọmọbìnrin rẹ̀ fún un láti fẹ́ ẹ ní ìyàwó nítorí kí ó lè gba ìjọba, ṣùgbọ́n ète rẹ̀ yìí kì yóò dúró tàbí ṣe ìrànlọ́wọ́ fún un.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.17",
            "verseOrgIds": [
              "DAN.11.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DAN 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni yóò yí ara padà sí ilẹ̀ etí Òkun, yóò mú ọ̀pọ̀lọpọ̀, ṣùgbọ́n aláṣẹ kan yóò mú òpin bá àfojúdi rẹ̀, yóò sì yí àfojúdi rẹ̀ padà sí orí rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.18",
            "verseOrgIds": [
              "DAN.11.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DAN 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lẹ́yìn èyí, yóò sì yí padà sí ìlú olódi ti orílẹ̀-èdè òun fúnra rẹ̀, ṣùgbọ́n yóò kọsẹ̀ yóò sì ṣubú, a kì yóò sì rí i mọ́.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.19",
            "verseOrgIds": [
              "DAN.11.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DAN 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Arọ́pò rẹ̀ yóò rán agbowó orí kan jáde láti fi ìdí ipò ọlá ọba múlẹ̀ ṣùgbọ́n ní ìwọ̀n ọdún díẹ̀, a ó pa á run, kì yóò jẹ́ nípa ìbínú tàbí nínú ogun.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.20",
            "verseOrgIds": [
              "DAN.11.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DAN 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ẹni tí kò níláárí kan yóò rọ́pò rẹ̀, ẹni tí a kò tí ì fi ọlá ọba fún rí. Yóò sì gbógun sí ìjọba nígbà tí ọkàn àwọn ènìyàn balẹ̀ láìbẹ̀rù, yóò sì gbà á pẹ̀lú àrékérekè.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.21",
            "verseOrgIds": [
              "DAN.11.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DAN 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà, ni a ó gbà ogunlọ́gọ̀ ogun kúrò níwájú u rẹ̀, pẹ̀lú òun àti ọmọ-aládé ti májẹ̀mú náà ni a ó parun.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.22",
            "verseOrgIds": [
              "DAN.11.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DAN 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lẹ́yìn tí ó wá ṣe ìpinnu pẹ̀lú u rẹ̀, yóò hùwà ẹ̀tàn, pẹ̀lú ìwọ̀nba ènìyàn kékeré ni yóò gba ìjọba.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.23",
            "verseOrgIds": [
              "DAN.11.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DAN 11:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí àwọn agbègbè tí ó lọ́rọ̀ gidigidi wà láìbẹ̀rù ni yóò gbóguntì wọ́n, yóò ṣe ohun tí baba rẹ̀ tàbí baba ńlá rẹ̀ kò ṣe rí, yóò pín ìkógun ẹrù àti ọrọ̀ fún àwọn ọmọ lẹ́yìn in rẹ̀. Yóò pète àti bi àwọn ìlú olódi ṣubú, ṣùgbọ́n fún ìgbà díẹ̀ ni.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.24",
            "verseOrgIds": [
              "DAN.11.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DAN 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Pẹ̀lú ogun púpọ̀, yóò sì ru agbára rẹ̀ àti ìgboyà rẹ̀ sókè sí ọba gúúsù. Ọba gúúsù yóò dìde ogun pẹ̀lú ọ̀pọ̀lọpọ̀ ọmọ-ogun tí ó lágbára gidigidi, ṣùgbọ́n kò ní le è dúró, nítorí ọ̀tẹ̀ tí ó gbèrò sí i.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.25",
            "verseOrgIds": [
              "DAN.11.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DAN 11:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn tí ó jẹ nínú oúnjẹ ọba yóò gbìyànjú láti parun, a ó gbá ogun rẹ̀ dànù, ọ̀pọ̀lọpọ̀ ni yóò ṣubú sí ogun.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.26",
            "verseOrgIds": [
              "DAN.11.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DAN 11:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ọba méjèèjì, ọkàn wọn tẹ̀ sí búburú, wọn yóò jókòó lórí tábìlì kan, wọn yóò máa parọ́ sí ara wọn, ṣùgbọ́n kò ní yọrí sí nǹkan kan nítorí òpin yóò wá ní àsìkò tí a yàn.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.27",
            "verseOrgIds": [
              "DAN.11.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DAN 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọba àríwá yóò padà sí ilẹ̀ rẹ̀ pẹ̀lú ọrọ̀ púpọ̀, ṣùgbọ́n ọkàn rẹ̀ yóò lòdì sí májẹ̀mú mímọ́, yóò sì ṣiṣẹ́ lòdì sí i, yóò sì padà sí orílẹ̀-èdè òun fúnra rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.28",
            "verseOrgIds": [
              "DAN.11.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DAN 11:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ní àsìkò tí a yàn, yóò gbógun sí gúúsù lẹ́ẹ̀kan sí i, ṣùgbọ́n ní ìgbà yí àyọríṣí yóò yàtọ̀ sí ti ìṣáájú.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.29",
            "verseOrgIds": [
              "DAN.11.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "DAN 11:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí pé, ọkọ̀ ojú omi àwọn ilẹ̀ etídò ìwọ̀-oòrùn yóò takò ó, ọkàn rẹ̀ yóò sì pami. Nígbà náà, ni yóò padà, yóò sì bínú sí májẹ̀mú mímọ́, yóò sì padà, yóò sì fi ojúrere hàn sí àwọn tí ó kọ májẹ̀mú mímọ́ náà.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.30",
            "verseOrgIds": [
              "DAN.11.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "DAN 11:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Agbára ọmọ-ogun rẹ̀ yóò dìde láti ba ohun mímọ́ ilé olódi tẹmpili jẹ́, yóò sì pa ẹbọ ojoojúmọ́ rẹ́. Nígbà náà ni wọn yóò gbé ìríra tí ó fa ìsọdahoro kalẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.31",
            "verseOrgIds": [
              "DAN.11.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "DAN 11:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pẹ̀lú irú àwọn tí ń ṣe búburú sí májẹ̀mú ní yóò fi ọ̀rọ̀ ìpọ́nni mú ṣọ̀tẹ̀, ṣùgbọ́n, àwọn tí ó mọ Ọlọ́run wọn yóò mú ọkàn le. Wọn yóò sì máa ṣe iṣẹ́ agbára.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.32",
            "verseOrgIds": [
              "DAN.11.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "DAN 11:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Àwọn tí ó mòye yóò máa kọ́ ọ̀pọ̀lọpọ̀, ṣùgbọ́n fún ìgbà díẹ̀, wọn yóò máa ṣubú nípa idà tàbí kí a jó wọn tàbí ìgbèkùn tàbí nípa ìkógun.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.33",
            "verseOrgIds": [
              "DAN.11.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "DAN 11:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí wọ́n bá ṣubú, wọn yóò rí ìrànlọ́wọ́ díẹ̀, ọ̀pọ̀ àwọn tó ṣe aláìṣòótọ́ yóò sì darapọ̀ mọ́ wọn.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.34",
            "verseOrgIds": [
              "DAN.11.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "DAN 11:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lára àwọn tí ó mòye yóò kọsẹ̀, nítorí kí a ba à tún wọn ṣe, wọ́n di mímọ́ àti aláìlábàwọ́n títí di ìgbà ìkẹyìn nítorí yóò sì wá ní àkókò tí a yàn.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.35",
            "verseOrgIds": [
              "DAN.11.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ọba tí ó gbé ara rẹ̀ ga",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "DAN 11:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ọba yóò ṣe bí ó ti wù ú yóò sì gbé ara rẹ̀ ga, ju gbogbo òrìṣà lọ, yóò máa sọ àwọn ọ̀rọ̀ tí kò-ṣe-é-gbọ́-létí sí Ọlọ́run àwọn Ọlọ́run, yóò sì máa yege títí àkókò ìbínú yóò fi parí, nítorí ohun tí a ti pinnu yóò ṣẹlẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.36",
            "verseOrgIds": [
              "DAN.11.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "DAN 11:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Òun kò ní ka òrìṣà àwọn baba rẹ̀ sí tàbí èyí tí àwọn fẹ́, òun kò ní ka nǹkan kan sí, ṣùgbọ́n yóò gbé ara rẹ̀ ga ju gbogbo wọn lọ.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.37",
            "verseOrgIds": [
              "DAN.11.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "DAN 11:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n dípò wọn, yóò bu ọlá fún òrìṣà àwọn ìlú olódi: òrìṣà tí àwọn baba rẹ̀ kò mọ̀ ni yóò bu ọlá fún pẹ̀lú wúrà àti fàdákà, pẹ̀lú òkúta iyebíye àti ẹ̀bùn tí ó lówó lórí.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.38",
            "verseOrgIds": [
              "DAN.11.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "DAN 11:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yóò kọlu àwọn ìlú olódi tí ó lágbára pẹ̀lú ìrànlọ́wọ́ òrìṣà àjèjì, yóò sì bu ọláńlá fún ẹni tí ó jẹ́wọ́ rẹ̀. Yóò mú wọn ṣe alákòóso lórí ọ̀pọ̀lọpọ̀ ènìyàn, yóò sì pín ilẹ̀ náà fún wọn gẹ́gẹ́ bí èrè.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.39",
            "verseOrgIds": [
              "DAN.11.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "DAN 11:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ní ìgbà ìkẹyìn, ọba gúúsù yóò gbé ogun de sí i, ọba àríwá yóò sì jáde bí ìjì láti kọlù ú pẹ̀lú u kẹ̀kẹ́ ogun àti ẹlẹ́ṣin àti ọ̀pọ̀lọpọ̀ ọkọ̀ ojú omi. Yóò gbógun wọ orílẹ̀-èdè púpọ̀, yóò sì bo wọn mọ́lẹ̀ bí ìkún omi.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.40",
            "verseOrgIds": [
              "DAN.11.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "DAN 11:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ ni yóò sì tún gbógun ti ilẹ̀ ológo náà pẹ̀lú, ọ̀pọ̀lọpọ̀ orílẹ̀-èdè yóò ṣubú, ṣùgbọ́n Edomu, Moabu àti àwọn olórí Ammoni yóò bọ́ lọ́wọ́ rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.41",
            "verseOrgIds": [
              "DAN.11.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "DAN 11:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yóò lo agbára rẹ̀ lórí ọ̀pọ̀lọpọ̀ orílẹ̀-èdè; Ejibiti kì yóò là.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.42",
            "verseOrgIds": [
              "DAN.11.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "DAN 11:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yóò gba àkóso ìṣúra wúrà àti fàdákà àti gbogbo ọrọ̀ Ejibiti, pẹ̀lú ti Libia àti Kuṣi nígbà tí ó mú wọn tẹríba.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.43",
            "verseOrgIds": [
              "DAN.11.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "DAN 11:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n ìròyìn láti ìlà-oòrùn àti láti ìwọ̀-oòrùn yóò mú ìdáríjì bá a, yóò sì fi ìbínú ńlá jáde lọ láti parun, àti láti pa ọ̀pọ̀lọpọ̀ run pátápátá.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.44",
            "verseOrgIds": [
              "DAN.11.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "DAN 11:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yóò sì pàgọ́ ọ rẹ̀ láàrín Òkun kọjú sí àárín òkè mímọ́ ológo. Síbẹ̀ yóò wá sí òpin rẹ̀, ẹnìkan kò ní ràn án lọ́wọ́.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.45",
            "verseOrgIds": [
              "DAN.11.45"
            ]
          }
        }
      ]
    }
  ],
