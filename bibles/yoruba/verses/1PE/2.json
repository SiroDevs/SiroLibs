      "attrs": {
        "style": "q2",
        "vid": "1PE 2:22"
      },
      "items": [
        {
          "text": "bẹ́ẹ̀ sì ni, a kò rí ẹ̀tàn kan lẹ́nu rẹ̀.\"",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.22",
            "verseOrgIds": [
