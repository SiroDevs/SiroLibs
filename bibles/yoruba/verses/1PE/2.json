              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sí èyí ni a pè yín: nítorí Kristi pẹ̀lú jìyà fún un yin, ó fi àpẹẹrẹ sílẹ̀ fún un yín, kí ẹ̀yin lè máa tọ ipasẹ̀ rẹ̀:",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.21",
            "verseOrgIds": [
              "1PE.2.21"
            ]
          }
        }
