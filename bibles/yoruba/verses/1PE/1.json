  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "1PE 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1PE 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Peteru, aposteli Jesu Kristi,",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.1",
            "verseOrgIds": [
              "1PE.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "1PE 1:1"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1PE 1:1"
      },
      "items": [
        {
          "text": "Sí àwọn àyànfẹ́ Ọlọ́run, ti wọ́n ń ṣe àtìpó ní àgbáyé, tiwọn tú káàkiri sí Pọntu, Galatia, Kappadokia, Asia, àti Bitinia,",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.1",
            "verseOrgIds": [
              "1PE.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1PE 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "àwọn ẹni tí a ti yàn gẹ́gẹ́ bí ìmọ̀tẹ́lẹ̀ Ọlọ́run Baba, nípa ìsọdimímọ́ Ẹ̀mí, sí ìgbọ́ràn àti ìbùwọ́n ẹ̀jẹ̀ Jesu Kristi:",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.2",
            "verseOrgIds": [
              "1PE.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "1PE 1:2"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1PE 1:2"
      },
      "items": [
        {
          "text": "Kí oore-ọ̀fẹ́ àti àlàáfíà máa bí sì fún yín.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.2",
            "verseOrgIds": [
              "1PE.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìyìn sí Ọlọ́run fún ìrètí tó wà láààyè",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1PE 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìyìn yẹ Ọlọ́run àti Baba Jesu Kristi Olúwa wa! Ẹni tí ó tún wa bí gẹ́gẹ́ bí àánú ńlá rẹ̀ sínú ìrètí ààyè nípa àjíǹde Jesu Kristi kúrò nínú òkú,",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.3",
            "verseOrgIds": [
              "1PE.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1PE 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "àti sínú ogún àìdíbàjẹ́, àti àìlábàwọ́n, àti èyí tí kì í ṣá, tí a ti fi pamọ́ ni ọ̀run dè yin,",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.4",
            "verseOrgIds": [
              "1PE.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1PE 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "ẹyin tí a ń pamọ́ nípa agbára Ọlọ́run nípa ìgbàgbọ́ si ìgbàlà, tí a múra láti fihàn ní ìgbà ìkẹyìn.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.5",
            "verseOrgIds": [
              "1PE.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1PE 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ yọ̀ nínú èyí púpọ̀, bí ó tilẹ̀ jẹ́ pe nísinsin yìí fún ìgbà díẹ̀, níwọ̀n bí ó ti yẹ, a ti fi ọ̀pọ̀lọpọ̀ ìdánwò bá yín nínú jẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.6",
            "verseOrgIds": [
              "1PE.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1PE 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn wọ̀nyí sì wáyé ki ìdánwò ìgbàgbọ́ yín tí ó ni iye lórí ju wúrà, ti ń ṣègbé lọ, bí ó tilẹ̀ jẹ́ pé iná ni a fi ń dán an wò, lè yọrísí ìyìn àti ògo àti ọlá ni ìgbà ìfarahàn Jesu Kristi.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.7",
            "verseOrgIds": [
              "1PE.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1PE 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹni tí ẹ̀yin fẹ́ láìrí, ẹni tí ẹ̀yin gbàgbọ́, bí ó tilẹ̀ jẹ́ pé ẹ kò rí i nísinsin yìí ẹ̀yin sì ń yọ ayọ̀ tí a kò lè fi ẹnu sọ, tí ó sì kún fún ògo;",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.8",
            "verseOrgIds": [
              "1PE.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1PE 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "ẹyin sì ń gba ìlépa ìgbàgbọ́ yín, àní ìgbàlà ọkàn yín.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.9",
            "verseOrgIds": [
              "1PE.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1PE 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ti ìgbàlà yìí, àwọn wòlíì tí wọ́n sọ àsọtẹ́lẹ̀ nípa oore-ọ̀fẹ́ tí ó mú tọ̀ yín wá, wọ́n wádìí jinlẹ̀ lẹ́sọ̀ lẹ́sọ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.10",
            "verseOrgIds": [
              "1PE.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1PE 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n ń wádìí ìgbà wo tàbí irú sá à wo ni Ẹ̀mí Kristi tí ó wà nínú wọ́n ń tọ́ka sí, nígbà tí ó jẹ́rìí ìyà Kristi àti ògo tí yóò tẹ̀lé e.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.11",
            "verseOrgIds": [
              "1PE.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1PE 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ẹni tí a fihàn fún, pé kì í ṣe fún àwọn tìkára wọn, bí kò ṣe fún àwa ni wọ́n ṣe ìránṣẹ́ ohun wọ̀n-ọn-nì, tí a ti ròyìn fún yin nísinsin yìí, láti ọ̀dọ̀ àwọn tó ti ń wàásù ìyìnrere náà fún yín nípasẹ̀ Ẹ̀mí Mímọ́ tí a rán wá láti ọ̀run; ohun tí àwọn angẹli ń fẹ́ láti wò.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.12",
            "verseOrgIds": [
              "1PE.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ẹ jẹ́ mímọ́",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1PE 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà, ẹ múra ọkàn yín sílẹ̀, ẹ kó ara yín ní ìjánu, kí ẹ sì fi ìrètí yín ní kíkún sí oore-ọ̀fẹ́, èyí tí a ń mu bọ̀ fún yin ni ìgbà ìfarahàn Jesu Kristi.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.13",
            "verseOrgIds": [
              "1PE.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1PE 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí àwọn ọmọ tí ń gbọ́rọ̀, ẹ ma ṣe da ara yín pọ̀ mọ́ ìfẹ́kúfẹ̀ẹ́ àìmọ́ yín ti àtijọ́.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.14",
            "verseOrgIds": [
              "1PE.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1PE 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n gẹ́gẹ́ bí ẹni tí o pè yin ti jẹ mímọ́; bẹ́ẹ̀ ni kí ẹ̀yin náà jẹ mímọ́.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.15",
            "verseOrgIds": [
              "1PE.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1PE 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí a ti kọ ọ pé, \"Ẹ jẹ́ mímọ́: nítorí tí Èmi jẹ mímọ́!\"",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.16",
            "verseOrgIds": [
              "1PE.1.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1PE 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Níwọ́n bí ẹ̀yin ti ń ké pe Baba, ẹni tí ń ṣe ìdájọ́ gẹ́gẹ́ bí iṣẹ́ olúkúlùkù láìṣe ojúsàájú, ẹ máa lo ìgbà àtìpó yin ni ìbẹ̀rù.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.17",
            "verseOrgIds": [
              "1PE.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1PE 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Níwọ̀n bí ẹ̀yin ti mọ̀ pé a kò fi ohun ìdíbàjẹ́ rà yín padà, bí fàdákà tàbí wúrà kúrò nínú ìwà asán yín, tí ẹ̀yin ti jogún láti ọ̀dọ̀ àwọn baba yín.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.18",
            "verseOrgIds": [
              "1PE.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1PE 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n pẹ̀lú ẹ̀jẹ̀ iyebíye, bí i ti ọ̀dọ́-àgùntàn ti kò lábùkù, tí kò sì lábàwọ́n, àní, ẹ̀jẹ̀ Kristi.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.19",
            "verseOrgIds": [
              "1PE.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1PE 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹni tí a ti mọ̀ tẹ́lẹ̀ nítòótọ́ ṣáájú ìpilẹ̀ṣẹ̀ ayé, ṣùgbọ́n tí a fihàn ní ìgbà ìkẹyìn wọ̀nyí nítorí yín.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.20",
            "verseOrgIds": [
              "1PE.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1PE 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àní ẹ̀yin tí o tipasẹ̀ rẹ̀ gba Ọlọ́run gbọ́, ẹni ti ó jí i dìde kúrò nínú òkú, tí ó sì fi ògo fún un; kí ìgbàgbọ́ àti ìrètí yín lè wà lọ́dọ̀ Ọlọ́run.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.21",
            "verseOrgIds": [
              "1PE.1.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1PE 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Níwọ́n bí ẹ̀yin ti wẹ ọkàn yin mọ́ nípa ìgbọ́ràn yín sí òtítọ́ sí ìfẹ́ ará ti kò ní ẹ̀tàn, ẹ fẹ́ ọmọnìkejì yín gidigidi láti ọkàn wá.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.22",
            "verseOrgIds": [
              "1PE.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1PE 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí a ti tún yín bí, kì í ṣe láti inú ìdíbàjẹ́ wá, bí kò ṣe èyí ti kì í díbàjẹ́ nípa ọ̀rọ̀ Ọlọ́run tí ń bẹ láààyè tí ó sì dúró.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.23",
            "verseOrgIds": [
              "1PE.1.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1PE 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí pé,",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.24",
            "verseOrgIds": [
              "1PE.1.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
