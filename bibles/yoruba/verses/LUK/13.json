  "verseCount": 35,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "13",
        "style": "c",
        "sid": "LUK 13"
      },
      "items": [
        {
          "text": "13",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ẹ ronúpìwàdà kí ẹ má bà á ṣègbé",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LUK 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn kan sì wá ní àkókò náà tí ó sọ ti àwọn ará Galili fún un, ẹ̀jẹ̀ ẹni tí Pilatu dàpọ̀ mọ́ ẹbọ wọn.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.1",
            "verseOrgIds": [
              "LUK.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu sì dáhùn ó wí fún wọn pé,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.2",
            "verseOrgIds": [
              "LUK.13.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ẹ̀yin ṣe bí àwọn ará Galili wọ̀nyí ṣe ẹlẹ́ṣẹ̀ ju gbogbo àwọn ará Galili lọ, nítorí wọ́n jẹ irú ìyà bá-wọ̀n-ọn-nì?",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.2",
                "verseOrgIds": [
                  "LUK.13.2"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.2",
            "verseOrgIds": [
              "LUK.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mo wí fún yín, bí kò ṣe pé ẹ̀yin pẹ̀lú ronúpìwàdà, gbogbo yín ni yóò ṣègbé bẹ́ẹ̀ gẹ́gẹ́.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.3",
                "verseOrgIds": [
                  "LUK.13.3"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.3",
            "verseOrgIds": [
              "LUK.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Tàbí àwọn méjìdínlógún, tí ilé ìṣọ́ ní Siloamu wó lù, tí ó sì pa wọ́n, ẹ̀yin ṣe bí wọ́n ṣe ẹlẹ́ṣẹ̀ ju gbogbo àwọn ènìyàn tí ń bẹ ní Jerusalẹmu lọ?",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.4",
                "verseOrgIds": [
                  "LUK.13.4"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.4",
            "verseOrgIds": [
              "LUK.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mo wí fún yín, bí kò ṣe pé ẹ̀yin ronúpìwàdà, gbogbo yín ni yóò ṣègbé bẹ́ẹ̀ gẹ́gẹ́.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.5",
                "verseOrgIds": [
                  "LUK.13.5"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì pa òwe yìí fún wọn pé,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.6",
            "verseOrgIds": [
              "LUK.13.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ọkùnrin kan ní igi ọ̀pọ̀tọ́ kan tí a gbìn sí ọgbà àjàrà rẹ̀; ó sì dé, ó ń wá èso lórí rẹ̀, kò sì rí nǹkan.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.6",
                "verseOrgIds": [
                  "LUK.13.6"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.6",
            "verseOrgIds": [
              "LUK.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ó sì wí fún olùṣọ́gbà rẹ̀ pé, 'Sá à wò ó, láti ọdún mẹ́ta ni èmi ti ń wá í wo èso lórí igi ọ̀pọ̀tọ́ yìí, èmi kò sì rí nǹkan: ké e lulẹ̀; èéṣe tí ó fi ń gbilẹ̀ lásán pẹ̀lú?'",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.7",
                "verseOrgIds": [
                  "LUK.13.7"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ó sì dáhùn ó wí fún un pé, 'Olúwa, jọ̀wọ́ rẹ̀ ní ọdún yìí pẹ̀lú, títí èmi ó fi tu ilẹ̀ ìdí rẹ̀ yíká, títí èmi ó sì fi bu ìlẹ̀dú sí i.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.8",
                "verseOrgIds": [
                  "LUK.13.8"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.8",
            "verseOrgIds": [
              "LUK.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Bí ó bá sì so èso, o dara bẹ́ẹ̀: bí kò bá sì so, ǹjẹ́ lẹ́yìn èyí nì kí ìwọ kí ó ké e lulẹ̀.' \"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.9",
                "verseOrgIds": [
                  "LUK.13.9"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "A mú obìnrin arọ láradá ní ọjọ́ ìsinmi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì ń kọ́ni nínú Sinagọgu kan ní ọjọ́ ìsinmi.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.10",
            "verseOrgIds": [
              "LUK.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sì kíyèsi i, obìnrin kan wà níbẹ̀ tí ó ní ẹ̀mí àìlera, láti ọdún méjìdínlógún wá, ẹni tí ó tẹ̀ tán, tí kò le gbé ara rẹ̀ sókè bí ó ti wù kí ó ṣe.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.11",
            "verseOrgIds": [
              "LUK.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí Jesu rí i, ó pè é sí ọ̀dọ̀, ó sì wí fún un pé,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.12",
            "verseOrgIds": [
              "LUK.13.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Obìnrin yìí, a tú ọ sílẹ̀ lọ́wọ́ àìlera rẹ.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.12",
                "verseOrgIds": [
                  "LUK.13.12"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.12",
            "verseOrgIds": [
              "LUK.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì fi ọwọ́ rẹ̀ lé e, Lójúkan náà a sì ti sọ ọ́ di títọ́, ó sì ń yin Ọlọ́run lógo.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.13",
            "verseOrgIds": [
              "LUK.13.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olórí Sinagọgu sì kún fún ìrunú, nítorí tí Jesu mú ni láradá ní ọjọ́ ìsinmi, ó sì wí fún ìjọ ènìyàn pé, ọjọ́ mẹ́fà ní ń bẹ tí a fi í ṣiṣẹ́, nínú wọn ni kí ẹ̀yin kí ó wá kí á ṣe dídá ara yín, kí ó má ṣe ní ọjọ́ ìsinmi.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.14",
            "verseOrgIds": [
              "LUK.13.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni Olúwa dáhùn, ó sì wí fún un pé,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.15",
            "verseOrgIds": [
              "LUK.13.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ẹ̀yin àgàbàgebè, olúkúlùkù yín kì í tú màlúù tàbí kẹ́tẹ́kẹ́tẹ́ rẹ̀ kúrò ní ibùso, kì í sì í fà á lọ mu omi ní ọjọ́ ìsinmi.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.15",
                "verseOrgIds": [
                  "LUK.13.15"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.15",
            "verseOrgIds": [
              "LUK.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kò sì yẹ kí a tú obìnrin yìí tí í ṣe ọmọbìnrin Abrahamu sílẹ̀ ní ìdè yìí ní ọjọ́ ìsinmi, ẹni tí Satani ti dè, sá à wò ó láti ọdún méjìdínlógún yìí wá?\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.16",
                "verseOrgIds": [
                  "LUK.13.16"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí ó sì wí nǹkan wọ̀nyí, ojú ti gbogbo àwọn ọ̀tá rẹ̀, gbogbo ìjọ ènìyàn sì yọ̀ fún ohun ìyanu gbogbo tí ó ṣe.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.17",
            "verseOrgIds": [
              "LUK.13.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Òwe irúgbìn tó kéré jùlọ àti ohun tí n mú ìyẹ̀fun wú",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì wí pé,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.18",
            "verseOrgIds": [
              "LUK.13.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kín ni ìjọba Ọlọ́run jọ? Kín ni èmi ó sì fiwé?",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.18",
                "verseOrgIds": [
                  "LUK.13.18"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.18",
            "verseOrgIds": [
              "LUK.13.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ó dàbí hóró musitadi, tí ọkùnrin kan mú, tí ó sì sọ sínú ọgbà rẹ̀; tí ó sì hù, ó sì di igi ńlá; àwọn ẹyẹ ojú ọ̀run sì ń gbé orí ẹ̀ka rẹ̀.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.19",
                "verseOrgIds": [
                  "LUK.13.19"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì tún wí pé,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.20",
            "verseOrgIds": [
              "LUK.13.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kín ni èmi ìbá fi ìjọba Ọlọ́run wé?",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.20",
                "verseOrgIds": [
                  "LUK.13.20"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.20",
            "verseOrgIds": [
              "LUK.13.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ó dàbí ìwúkàrà, tí obìnrin kan mú, tí ó fi sínú òsùwọ̀n ìyẹ̀fun mẹ́ta, títí gbogbo rẹ̀ ó fi di wíwú.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.21",
                "verseOrgIds": [
                  "LUK.13.21"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ọ̀nà tóóró",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 13:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì ń la àárín ìlú àti ìletò lọ, ó ń kọ́ni, ó sì ń rìn lọ sí Jerusalẹmu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.22",
            "verseOrgIds": [
              "LUK.13.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 13:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹnìkan sì bi í pé, Olúwa, díẹ̀ ha kọ ni àwọn tí a ó gbàlà?",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.23",
            "verseOrgIds": [
              "LUK.13.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "LUK 13:23"
      },
      "items": [
        {
          "text": "Ó sì wí fún wọn pé,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.23",
            "verseOrgIds": [
              "LUK.13.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 13:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ẹ làkàkà láti gba ojú ọ̀nà tóóró wọlé, nítorí mo wí fún yín, ènìyàn púpọ̀ ni yóò wá ọ̀nà láti wọ̀ ọ́, wọn kì yóò sì lè wọlé.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.24",
                "verseOrgIds": [
                  "LUK.13.24"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.24",
            "verseOrgIds": [
              "LUK.13.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 13:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nígbà tí baálé ilé bá dìde lẹ́ẹ̀kan fùú, tí ó bá sí ti ìlẹ̀kùn, ẹ̀yin ó sì bẹ̀rẹ̀ sí í dúró lóde, tí ẹ ó máa kan ìlẹ̀kùn, wí pé, 'Olúwa, Olúwa, ṣí i fún wa!'",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.25",
                "verseOrgIds": [
                  "LUK.13.25"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "LUK 13:25"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Òun ó sì dáhùn wí fún yín pé, 'Èmi kò mọ̀ ibi tí ẹ̀yin ti wá.' Bẹ́ẹ̀ ni èmi kò mọ̀ yín.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.25",
                "verseOrgIds": [
                  "LUK.13.25"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 13:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Nígbà náà ni ẹ̀yin ó bẹ̀rẹ̀ sí wí pé, 'Àwa ti jẹ, àwa sì ti mu níwájú rẹ, ìwọ sì kọ́ni ní ìgboro ìlú wa.'",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.26",
                "verseOrgIds": [
                  "LUK.13.26"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 13:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Òun ó sì wí pé, 'Èmi wí fún yín èmi kò mọ̀ ibi tí ẹ̀yin ti wá; ẹ lọ kúrò lọ́dọ̀ mi gbogbo ẹ̀yin tí ń ṣiṣẹ́ ẹ̀ṣẹ̀.'",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.27",
                "verseOrgIds": [
                  "LUK.13.27"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 13:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Níbẹ̀ ni ẹkún àti ìpayínkeke yóò wà, nígbà tí ẹ̀yin ó rí Abrahamu, àti Isaaki, àti Jakọbu, àti gbogbo àwọn wòlíì, ní ìjọba Ọlọ́run, tí a ó sì ti ẹ̀yin sóde.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.28",
                "verseOrgIds": [
                  "LUK.13.28"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.28",
            "verseOrgIds": [
              "LUK.13.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 13:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Wọn ó sì ti ilẹ̀ ìlà-oòrùn, àti ìwọ̀-oòrùn wá, àti láti àríwá, àti gúúsù wá, wọn ó sì jókòó ní ìjọba Ọlọ́run.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.29",
                "verseOrgIds": [
                  "LUK.13.29"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.29",
            "verseOrgIds": [
              "LUK.13.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 13:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Sì wò ó, àwọn ẹni ẹ̀yìn ń bẹ tí yóò di ẹni iwájú, àwọn ẹni iwájú ń bẹ tí yóò di ẹni ẹ̀yìn.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.30",
                "verseOrgIds": [
                  "LUK.13.30"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jesu káàánú fún Jerusalẹmu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 13:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní wákàtí kan náà, díẹ̀ nínú àwọn Farisi tọ̀ ọ́ wá, wọ́n sì wí fún un pé, \"Jáde, kí ìwọ sì lọ kúrò níhìn-ín yìí: nítorí Herodu ń fẹ́ pa ọ́.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.31",
            "verseOrgIds": [
              "LUK.13.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 13:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì wí fún wọn pé,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.32",
            "verseOrgIds": [
              "LUK.13.32"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ẹ lọ, kí ẹ̀yin sì sọ fún kọ̀lọ̀kọ̀lọ̀ náà pé, 'Kíyèsi i, èmi ń lé àwọn ẹ̀mí èṣù jáde, èmi ń ṣe ìmúláradá lónìí àti lọ́la, àti ní ọjọ́ mẹ́ta èmi ó ṣe àṣepé.'",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.32",
                "verseOrgIds": [
                  "LUK.13.32"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.32",
            "verseOrgIds": [
              "LUK.13.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LUK 13:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ṣùgbọ́n èmi kò jẹ́ má rìn lónìí, àti lọ́la, àti ní ọ̀túnla: dájúdájú wòlíì kan ki yóò ṣègbé lẹ́yìn odi Jerusalẹmu.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.33",
                "verseOrgIds": [
                  "LUK.13.33"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LUK 13:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Jerusalẹmu, Jerusalẹmu, ìwọ tí o pa àwọn wòlíì, tí o sì sọ òkúta lu àwọn tí a rán sí ọ pa; nígbà mélòó ni èmi ń fẹ́ ràgà bo àwọn ọmọ rẹ, bí àgbébọ̀ adìyẹ ti í ràgà bo àwọn ọmọ rẹ̀ lábẹ́ apá rẹ̀, ṣùgbọ́n ẹ̀yin kò fẹ́!",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.34",
                "verseOrgIds": [
                  "LUK.13.34"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.34",
            "verseOrgIds": [
              "LUK.13.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 13:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Sá wò ó, a fi ilé yín sílẹ̀ fún yín ní ahoro. Lóòtítọ́ ni mo sì wí fún yín, ẹ̀yin kì yóò sì rí mi títí yóò fi di àkókò tí ẹ̀yin ó wí pé, 'Olùbùkún ni ẹni tí ó ń bọ̀ wá ní orúkọ Olúwa.' \"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.35",
                "verseOrgIds": [
                  "LUK.13.35"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
