  "verseCount": 55,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "23",
        "style": "c",
        "sid": "LUK 23"
      },
      "items": [
        {
          "text": "23",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LUK 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo ìjọ ènìyàn sì dìde, wọ́n sì fà á lọ sí ọ̀dọ̀ Pilatu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.1",
            "verseOrgIds": [
              "LUK.23.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n sì bẹ̀rẹ̀ sí fi ẹ̀sùn kàn án, wí pé, \"Àwa rí ọkùnrin yìí ó ń yí orílẹ̀-èdè wa lọ́kàn padà, ó sì ń dá wọn lẹ́kun láti san owó òde fún Kesari, ó ń wí pé, òun tìkára òun ni Kristi ọba.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.2",
            "verseOrgIds": [
              "LUK.23.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pilatu sì bi í léèrè, wí pé, \"Ìwọ ha ni ọba àwọn Júù?\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.3",
            "verseOrgIds": [
              "LUK.23.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "LUK 23:3"
      },
      "items": [
        {
          "text": "Ó sì dá a lóhùn wí pé,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.3",
            "verseOrgIds": [
              "LUK.23.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ìwọ wí i.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.23.3",
                "verseOrgIds": [
                  "LUK.23.3"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pilatu sì wí fún àwọn olórí àlùfáà àti fún ìjọ ènìyàn pé, \"Èmi kò rí ẹ̀ṣẹ̀ lọ́wọ́ ọkùnrin yìí.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.4",
            "verseOrgIds": [
              "LUK.23.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n sì túbọ̀ tẹnumọ́ ọn pé, \"Ó ń ru ènìyàn sókè, ó ń kọ́ni káàkiri gbogbo Judea, ó bẹ̀rẹ̀ láti Galili títí ó fi dé ìhín yìí!\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.5",
            "verseOrgIds": [
              "LUK.23.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí Pilatu gbọ́ orúkọ Galili, ó béèrè bí ọkùnrin náà bá jẹ́ ará Galili.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.6",
            "verseOrgIds": [
              "LUK.23.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí ó sì mọ̀ pé ará ilẹ̀ abẹ́ àṣẹ Herodu ni, ó rán an sí Herodu, ẹni tí òun tìkára rẹ̀ wà ní Jerusalẹmu ní àkókò náà.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.7",
            "verseOrgIds": [
              "LUK.23.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí Herodu, sì rí Jesu, ó yọ̀ gidigidi; nítorí tí ó ti ń fẹ́ rí i pẹ́ ó sá à ti ń gbọ́ ìròyìn púpọ̀ nítorí rẹ̀; ó sì ń retí láti rí i kí iṣẹ́ àmì díẹ̀ ti ọwọ́ rẹ̀ ṣe.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.8",
            "verseOrgIds": [
              "LUK.23.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì béèrè ọ̀rọ̀ púpọ̀ lọ́wọ́ rẹ̀; ṣùgbọ́n kò da a lóhùn rárá.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.9",
            "verseOrgIds": [
              "LUK.23.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àti àwọn olórí àlùfáà àti àwọn akọ̀wé dúró, wọ́n sì ń fi ẹ̀sùn kàn án gidigidi.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.10",
            "verseOrgIds": [
              "LUK.23.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àti Herodu pẹ̀lú àwọn ọmọ-ogun rẹ̀, wọ́n kẹ́gàn rẹ̀, wọ́n sì ń fi í ṣẹ̀sín, wọ́n wọ̀ ọ́ ní aṣọ dáradára, ó sì rán an padà tọ Pilatu lọ.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.11",
            "verseOrgIds": [
              "LUK.23.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pilatu àti Herodu di ọ̀rẹ́ ara wọn ní ọjọ́ náà, nítorí látijọ́ ọ̀tá ara wọn ni wọ́n ti jẹ́ rí.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.12",
            "verseOrgIds": [
              "LUK.23.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pilatu sì pe àwọn olórí àlùfáà àti àwọn olórí àti àwọn ènìyàn jọ.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.13",
            "verseOrgIds": [
              "LUK.23.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sọ fún wọn pé, \"Ẹyin mú ọkùnrin yìí tọ̀ mí wá, bí ẹni tí ó ń yí àwọn ènìyàn ní ọkàn padà. Sì kíyèsi i, èmí wádìí ẹjọ́ rẹ̀ níwájú yín èmi kò sì rí ẹ̀bi ẹ̀ṣẹ̀ kan lọ́wọ́ ọkùnrin yìí, ní gbogbo nǹkan wọ̀nyí tí ẹ̀yin fi ẹ̀sùn rẹ̀ sùn.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.14",
            "verseOrgIds": [
              "LUK.23.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àti Herodu pẹ̀lú; ó sá rán an padà tọ̀ wá wá; sì kíyèsi i, ohun kan tí ó yẹ sí ikú ni a kò ṣe láti ọwọ́ rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.15",
            "verseOrgIds": [
              "LUK.23.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ǹjẹ́ èmi ó nà án, èmi ó sì fi í sílẹ̀ lọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.16",
            "verseOrgIds": [
              "LUK.23.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n sì kígbe sókè nígbà kan náà, pé, \"Mú ọkùnrin yìí kúrò, kí o sì dá Baraba sílẹ̀ fún wa!\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.18",
            "verseOrgIds": [
              "LUK.23.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 23:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹni tí a sọ sínú túbú nítorí ọ̀tẹ̀ kan tí a ṣe ní ìlú, àti nítorí ìpànìyàn.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.19",
            "verseOrgIds": [
              "LUK.23.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 23:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pilatu sì tún bá wọn sọ̀rọ̀, nítorí ó fẹ́ dá Jesu sílẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.20",
            "verseOrgIds": [
              "LUK.23.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 23:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n wọ́n kígbe, wí pé, \"Kàn án mọ́ àgbélébùú, kàn án mọ àgbélébùú!\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.21",
            "verseOrgIds": [
              "LUK.23.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 23:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì wí fún wọn lẹ́ẹ̀mẹ́ta pé, \"Èéṣe, búburú kín ni ọkùnrin yìí ṣe? Èmi kò rí ọ̀ràn ikú lára rẹ̀: nítorí náà èmi ó nà án, èmi ó sì fi í sílẹ̀.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.22",
            "verseOrgIds": [
              "LUK.23.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 23:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n túbọ̀ tẹramọ́ igbe ńlá, wọ́n ń fẹ́ kí a kàn án mọ́ àgbélébùú, ohùn tiwọn àti ti àwọn olórí àlùfáà borí tirẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.23",
            "verseOrgIds": [
              "LUK.23.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 23:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pilatu sí fi àṣẹ sí i pé, kí ó rí bí wọ́n ti ń fẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.24",
            "verseOrgIds": [
              "LUK.23.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 23:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì dá ẹni tí wọ́n fẹ́ sílẹ̀ fún wọn, ẹni tí a tìtorí ọ̀tẹ̀ àti ìpànìyàn sọ sínú túbú; ṣùgbọ́n ó fi Jesu lé wọn lọ́wọ́.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.25",
            "verseOrgIds": [
              "LUK.23.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Wọ́n kan Jesu mọ́ àgbélébùú",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 23:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí wọ́n sì ti ń fà á lọ, wọ́n mú ọkùnrin kan, Simoni ara Kirene, tí ó ń ti ìgbèríko bọ̀, òun ni wọ́n sì gbé àgbélébùú náà lé, kí ó máa rù ú lọ tẹ̀lé Jesu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.26",
            "verseOrgIds": [
              "LUK.23.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 23:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìjọ ènìyàn púpọ̀ ni ó ń tọ̀ ọ́ lẹ́yìn, àti àwọn obìnrin, tí ń pohùnréré ẹkún,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.27",
            "verseOrgIds": [
              "LUK.23.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 23:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "ṣùgbọ́n Jesu yíjú padà sí wọn, ó sì wí pé,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.28",
            "verseOrgIds": [
              "LUK.23.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ẹ̀yin ọmọbìnrin Jerusalẹmu, ẹ má sọkún fún mi, ṣùgbọ́n ẹ sọkún fún ara yín, àti fún àwọn ọmọ yín.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.23.28",
                "verseOrgIds": [
                  "LUK.23.28"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.28",
            "verseOrgIds": [
              "LUK.23.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 23:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nítorí kíyèsi i, ọjọ́ ń bọ̀ ní èyí tí ẹ̀yin ó wí pé, 'Ìbùkún ni fún àgàn, àti fún inú tí kò bímọ rí, àti fún ọmú tí kò fún ni mu rí!'",
              "type": "text",
              "attrs": {
                "verseId": "LUK.23.29",
                "verseOrgIds": [
                  "LUK.23.29"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.29",
            "verseOrgIds": [
              "LUK.23.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 23:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nígbà náà ni",
              "type": "text",
              "attrs": {
                "verseId": "LUK.23.30",
                "verseOrgIds": [
                  "LUK.23.30"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "LUK 23:30"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\" 'wọn ó bẹ̀rẹ̀ sí wí fún àwọn òkè kéékèèké pé, \"Yí lù wá!\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.23.30",
                "verseOrgIds": [
                  "LUK.23.30"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LUK 23:30"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Sí àwọn òkè ńlá, \"Bò wá mọ́lẹ̀!\" '",
              "type": "text",
              "attrs": {
                "verseId": "LUK.23.30",
                "verseOrgIds": [
                  "LUK.23.30"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 23:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nítorí bí wọn bá ń ṣe nǹkan wọ̀nyí sára igi tútù, kín ni a ó ṣe sára igi gbígbẹ?\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.23.31",
                "verseOrgIds": [
                  "LUK.23.31"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 23:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn méjì mìíràn bákan náà, àwọn arúfin, ni wọ́n sì fà lọ pẹ̀lú rẹ̀ láti pa.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.32",
            "verseOrgIds": [
              "LUK.23.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LUK 23:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí wọ́n sì dé ibi tí a ń pè ní Agbárí, níbẹ̀ ni wọ́n gbé kàn án mọ́ àgbélébùú, àti àwọn arúfin náà, ọ̀kan ní ọwọ́ ọ̀tún, àti ọ̀kan ní ọwọ́ òsì.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.33",
            "verseOrgIds": [
              "LUK.23.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LUK 23:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu sì wí pé,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.34",
            "verseOrgIds": [
              "LUK.23.34"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Baba, dáríjì wọ́n; nítorí tí wọn kò mọ ohun tí wọ́n ń ṣe.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.23.34",
                "verseOrgIds": [
                  "LUK.23.34"
                ]
              }
            }
          ]
        },
        {
          "text": "Wọ́n di ìbò láti pín aṣọ rẹ̀ láàrín ara wọn.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.34",
            "verseOrgIds": [
              "LUK.23.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 23:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ènìyàn sì dúró láti wòran. Àti àwọn ìjòyè pẹ̀lú wọn, wọ́n ń yọ ṣùtì sí i, wí pé, \"Ó gba àwọn ẹlòmíràn là; kí ó gbara rẹ̀ là, bí ó bá ṣe Kristi, àyànfẹ́ Ọlọ́run.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.35",
            "verseOrgIds": [
              "LUK.23.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LUK 23:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àti àwọn ọmọ-ogun pẹ̀lú ń fi í ṣe ẹlẹ́yà, wọ́n tọ̀ ọ́ wá, wọ́n ń fi ọtí kíkan fún un.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.36",
            "verseOrgIds": [
              "LUK.23.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LUK 23:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n sì ń wí pé, \"Bí ìwọ bá ṣe ọba àwọn Júù, gba ara rẹ là.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.37",
            "verseOrgIds": [
              "LUK.23.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LUK 23:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n sì kọ̀wé àkọlé sí ìgbèrí rẹ̀ ní èdè Giriki, àti ti Latin, àti tí Heberu pe:",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.38",
            "verseOrgIds": [
              "LUK.23.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pc",
        "vid": "LUK 23:38"
      },
      "items": [
        {
          "text": "Èyí ni Ọba àwọn Júù.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.38",
            "verseOrgIds": [
              "LUK.23.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LUK 23:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àti ọ̀kan nínú àwọn arúfin tí a gbé kọ́ ń fi ṣe ẹlẹ́yà wí pé, \"Bí ìwọ bá ṣe Kristi, gba ara rẹ àti àwa náà là.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.39",
            "verseOrgIds": [
              "LUK.23.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LUK 23:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n èyí èkejì dáhùn, ó ń bá a wí pé, \"Ìwọ kò bẹ̀rù Ọlọ́run, tí ìwọ wà nínú ẹ̀bi kan náà?",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.40",
            "verseOrgIds": [
              "LUK.23.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "LUK 23:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní tiwa, wọ́n jàre nítorí èrè ohun tí àwa ṣe ni à ń jẹ, ṣùgbọ́n ọkùnrin yìí kò ṣe ohun búburú kan.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.41",
            "verseOrgIds": [
              "LUK.23.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LUK 23:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì wí pé, \"Jesu, rántí mi nígbà tí ìwọ bá dé ìjọba rẹ.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.42",
            "verseOrgIds": [
              "LUK.23.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LUK 23:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu sì wí fún un pé,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.43",
            "verseOrgIds": [
              "LUK.23.43"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Lóòótọ́ ni mo wí fún ọ, lónìí ni ìwọ ó wà pẹ̀lú mi ní Paradise!\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.23.43",
                "verseOrgIds": [
                  "LUK.23.43"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ikú Jesu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "LUK 23:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì tó ìwọ̀n wákàtí kẹfà ọjọ́, òkùnkùn sì ṣú bo gbogbo ilẹ̀ títí ó fi di wákàtí kẹsànán ọjọ́.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.44",
            "verseOrgIds": [
              "LUK.23.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "LUK 23:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Òòrùn sì ṣú òòkùn, aṣọ ìkélé ti tẹmpili sì ya ní àárín méjì.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.45",
            "verseOrgIds": [
              "LUK.23.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "LUK 23:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí Jesu sì kígbe lóhùn rara, ó ní,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.46",
            "verseOrgIds": [
              "LUK.23.46"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Baba, ní ọwọ́ rẹ ni mo fi ẹ̀mí mi lé!\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.23.46",
                "verseOrgIds": [
                  "LUK.23.46"
                ]
              }
            }
          ]
        },
        {
          "text": "Nígbà tí ó sì wí èyí tan, ó jọ̀wọ́ ẹ̀mí rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.46",
            "verseOrgIds": [
              "LUK.23.46"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "LUK 23:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí balógun ọ̀rún rí ohun tí ó ṣe, ó yin Ọlọ́run lógo, wí pé, \"Dájúdájú olódodo ni ọkùnrin yìí!\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.47",
            "verseOrgIds": [
              "LUK.23.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "LUK 23:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo ìjọ ènìyàn tí ó péjọ láti rí ìran yìí, nígbà tí wọ́n rí ohun tí ó ṣẹlẹ̀ wọ́n lu ara wọn ní oókan àyà, wọ́n sì padà sí ilé.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.48",
            "verseOrgIds": [
              "LUK.23.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "LUK 23:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àti gbogbo àwọn ojúlùmọ̀ rẹ̀, àti àwọn obìnrin tí ń tọ̀ ọ́ lẹ́yìn láti Galili wá, wọ́n dúró lókèèrè, wọ́n ń wo nǹkan wọ̀nyí.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.49",
            "verseOrgIds": [
              "LUK.23.49"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìsìnkú Jesu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "LUK 23:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sì kíyèsi i, ọkùnrin kan tí a ń pè ní Josẹfu, láti ìlú àwọn Júù kan tí ń jẹ́ Arimatea. Ó jẹ́ ọ̀kan nínú àwọn ọmọ ìgbìmọ̀, ènìyàn rere, àti olóòtítọ́.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.50",
            "verseOrgIds": [
              "LUK.23.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "LUK 23:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Òun kò bá wọn fi ohùn sí ìmọ̀ àti ìṣe wọn; Ó wá láti Judea, ìlú àwọn ará Arimatea, òun pẹ̀lú ń retí ìjọba Ọlọ́run.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.51",
            "verseOrgIds": [
              "LUK.23.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "LUK 23:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọkùnrin yìí tọ Pilatu lọ, ó sì tọrọ òkú Jesu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.52",
            "verseOrgIds": [
              "LUK.23.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "LUK 23:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí ó sì sọ̀ ọ́ kalẹ̀, ó sì fi aṣọ àlà dì í, ó sì tẹ́ ẹ sínú ibojì tí a gbẹ́ nínú Òkúta, níbi tí a kò tẹ́ ẹnikẹ́ni sí rí.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.53",
            "verseOrgIds": [
              "LUK.23.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "LUK 23:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì jẹ́ ọjọ́ ìpalẹ̀mọ́, ọjọ́ ìsinmi sì kù sí dẹ̀dẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.54",
            "verseOrgIds": [
              "LUK.23.54"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "LUK 23:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àti àwọn obìnrin, tí wọ́n bá a ti Galili wá, tí wọ́n sì tẹ̀lé, wọ́n kíyèsi ibojì náà, àti bí a ti tẹ́ òkú rẹ̀ sílẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.55",
            "verseOrgIds": [
              "LUK.23.55"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "56",
            "style": "v",
            "sid": "LUK 23:56"
          },
          "items": [
            {
              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí wọ́n sì padà, wọ́n pèsè ohun olóòórùn dídùn, òróró ìkunra (àti tùràrí tútù); wọ́n sì sinmi ní ọjọ́ ìsinmi gẹ́gẹ́ bí òfin.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.56",
            "verseOrgIds": [
              "LUK.23.56"
            ]
          }
        }
      ]
    }
