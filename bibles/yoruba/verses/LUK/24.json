              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n sì foríbalẹ̀ fún un, wọ́n sì padà lọ sí Jerusalẹmu pẹ̀lú ayọ̀ púpọ̀.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.52",
