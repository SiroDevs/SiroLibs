          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Òfin kan náà ló wà fún àlejò àti fún ọmọ Israẹli. Èmi ni",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.22",
