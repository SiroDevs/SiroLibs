          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹni tí ó bá sì lu ẹran pa, kí ó sán an padà; ẹni tí ó bá sì lu ènìyàn pa, a ó pa á.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.21",
            "verseOrgIds": [
