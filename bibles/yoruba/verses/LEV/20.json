  "verseCount": 27,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "20",
        "style": "c",
        "sid": "LEV 20"
      },
      "items": [
        {
          "text": "20",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìjìyà fún ẹ̀ṣẹ̀",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 20:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.20.1",
                "verseOrgIds": [
                  "LEV.20.1"
                ]
              }
            }
          ]
        },
        {
          "text": "sọ fún Mose pé,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.1",
            "verseOrgIds": [
              "LEV.20.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Sọ fún àwọn ará Israẹli pé, 'Ẹnikẹ́ni nínú àwọn ará Israẹli tàbí àwọn àlejò tí ń gbé láàrín Israẹli, tí ó bá fi èyíkéyìí nínú àwọn ọmọ rẹ̀ fún Moleki, kí wọ́n pa á, kí àwọn olùgbé ilẹ̀ náà sọ ọ́ ní òkúta pa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.2",
            "verseOrgIds": [
              "LEV.20.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi tìkára mi yóò bínú sí irú ẹni bẹ́ẹ̀, ń ó sì gé e kúrò láàrín àwọn ènìyàn rẹ̀ fún òrìṣà Moleki ó ti ba ibi mímọ́ mi jẹ́ pẹ̀lú.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.3",
            "verseOrgIds": [
              "LEV.20.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí àwọn ènìyàn ilẹ̀ náà bá mójú kúrò lára irú ẹni bẹ́ẹ̀ tí ó fi ọ̀kan nínú àwọn ọmọ rẹ̀ fún òrìṣà Moleki tí wọn kò sì pa irú ẹni bẹ́ẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.4",
            "verseOrgIds": [
              "LEV.20.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò bínú sí irú ẹni bẹ́ẹ̀ àti gbogbo ìdílé rẹ̀, èmi yóò sì ké wọn kúrò láàrín àwọn ènìyàn wọn, òun àti gbogbo àwọn tí ó jọ ṣe àgbèrè tọ òrìṣà Moleki lẹ́yìn.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.5",
            "verseOrgIds": [
              "LEV.20.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Bí ẹnikẹ́ni bá tọ àwọn abókùúsọ̀rọ̀ àti àwọn ẹlẹ́mìí òkùnkùn lọ, tí ó sì ṣe àgbèrè tọ̀ wọ́n lẹ́yìn, Èmi yóò bínú sí irú ẹni bẹ́ẹ̀, Èmi yóò sì gé e kúrò láàrín àwọn ènìyàn rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.6",
            "verseOrgIds": [
              "LEV.20.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Torí náà ẹ ya ara yín sí mímọ́ kí ẹ sì jẹ́ mímọ́, torí pé, Èmi ni",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.7",
            "verseOrgIds": [
              "LEV.20.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.20.7",
                "verseOrgIds": [
                  "LEV.20.7"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run yín.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.7",
            "verseOrgIds": [
              "LEV.20.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ máa kíyèsi àṣẹ mi, kí ẹ sì máa pa wọ́n mọ́. Èmi ni",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.8",
            "verseOrgIds": [
              "LEV.20.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.20.8",
                "verseOrgIds": [
                  "LEV.20.8"
                ]
              }
            }
          ]
        },
        {
          "text": "tí ó sọ yín di mímọ́.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.8",
            "verseOrgIds": [
              "LEV.20.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ẹnikẹ́ni tí ó bá ṣépè lé baba tàbí ìyá rẹ̀ ni kí ẹ pa, ẹ̀jẹ̀ rẹ̀ wà lórí ara rẹ̀ torí pé ó ti ṣépè lé baba àti ìyá rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.9",
            "verseOrgIds": [
              "LEV.20.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 20:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Bí ẹnikẹ́ni bá bá aya aládùúgbò rẹ̀ lòpọ̀: ọkùnrin àti obìnrin náà ni kí ẹ sọ ní òkúta pa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.10",
            "verseOrgIds": [
              "LEV.20.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 20:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ẹnikẹ́ni tí ó bá bá aya baba rẹ̀ lòpọ̀ ti tàbùkù baba rẹ̀. Àwọn méjèèjì ni kí ẹ pa. Ẹ̀jẹ̀ wọn yóò wà lórí wọn.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.11",
            "verseOrgIds": [
              "LEV.20.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 20:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Bí ọkùnrin kan bá bá arábìnrin ìyàwó rẹ̀ lòpọ̀, àwọn méjèèjì ni kí ẹ pa, wọ́n ti ṣe ohun tí ó lòdì, ẹ̀jẹ̀ wọn yóò wà lórí wọn.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.12",
            "verseOrgIds": [
              "LEV.20.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 20:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Bí ọkùnrin kan bá bá ọkùnrin mìíràn lòpọ̀ bí wọ́n ti í bá obìnrin lòpọ̀: àwọn méjèèjì ti ṣe ohun ìríra, pípa ni kí ẹ pa wọ́n, ẹ̀jẹ̀ wọn yóò wà lórí wọn.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.13",
            "verseOrgIds": [
              "LEV.20.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 20:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Bí ọkùnrin kan bá fẹ́ tìyátọmọ papọ̀, ìwà búburú ni èyí: iná ni kí ẹ fi sun wọ́n, òun àti àwọn méjèèjì, kí ìwà búburú má ba à gbilẹ̀ láàrín yín.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.14",
            "verseOrgIds": [
              "LEV.20.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 20:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Bí ọkùnrin kan bá bá ẹranko lòpọ̀, ẹ gbọdọ̀ pa ọkùnrin náà àti ẹranko náà.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.15",
            "verseOrgIds": [
              "LEV.20.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 20:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Bí obìnrin kan bá súnmọ́ ẹranko tí ó sì bá a lòpọ̀ obìnrin náà àti ẹranko náà ni kí ẹ pa, ẹ̀jẹ̀ wọn yóò sì wà lórí ara wọn.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.16",
            "verseOrgIds": [
              "LEV.20.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 20:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Bí ọkùnrin kan bá fẹ́ arábìnrin rẹ̀ yálà ọmọbìnrin baba rẹ̀ tàbí ọmọbìnrin ìyá rẹ̀ tí ó sì bá a lòpọ̀, ohun ìtìjú ni èyí, ẹ ó gé wọn kúrò lójú àwọn ènìyàn wọn, ó ti tàbùkù arábìnrin rẹ̀. Ẹ̀bi rẹ̀ yóò wá sórí rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.17",
            "verseOrgIds": [
              "LEV.20.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 20:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Bí ọkùnrin kan bá súnmọ́ obìnrin, ní àkókò nǹkan oṣù rẹ̀ tí ó sì bá a lòpọ̀. Ó ti tú orísun ẹ̀jẹ̀ rẹ̀. Òun náà sì gbà á láààyè. Àwọn méjèèjì ni a ó gé kúrò láàrín àwọn ènìyàn wọn.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.18",
            "verseOrgIds": [
              "LEV.20.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 20:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Má ṣe bá arábìnrin baba tàbí ti ìyá rẹ lòpọ̀, nítorí o ti tú ìhòhò ìbátan rẹ, ẹ̀yin méjèèjì ni yóò ru ẹ̀bi yín.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.19",
            "verseOrgIds": [
              "LEV.20.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 20:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Bí ọkùnrin kan bá bá aya arákùnrin baba rẹ̀ lòpọ̀ ó ti tàbùkù arákùnrin baba rẹ̀. A ó jẹ wọ́n ní ìyà; wọn yóò sì kú láìlọ́mọ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.20",
            "verseOrgIds": [
              "LEV.20.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 20:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Bí ọkùnrin kan bá gba aya arákùnrin rẹ̀, ohun àìmọ́ ni èyí, ó ti tàbùkù arákùnrin rẹ̀, wọn ó wà láìlọ́mọ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.21",
            "verseOrgIds": [
              "LEV.20.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 20:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Kí ẹ pa gbogbo àṣẹ àti òfin mi mọ́, kí ẹ sì máa ṣe wọ́n. Kí ilẹ̀ náà tí èmi ó fi fún yín láti máa gbé má ba à pọ̀ yín jáde.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.22",
            "verseOrgIds": [
              "LEV.20.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 20:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ má ṣe tẹ̀lé àṣà àwọn orílẹ̀-èdè tí mo lé jáde níwájú yín torí pé gbogbo nǹkan wọ̀nyí ni wọ́n ń ṣe, tí mo kórìíra wọn.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.23",
            "verseOrgIds": [
              "LEV.20.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 20:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n mo ti sọ fún yín pé, \"Ẹ̀yin ni yóò jogún ilẹ̀ wọn, Èmi yóò sì fi fún yín láti jogún ilẹ̀ tí ó ń sàn fún wàrà àti oyin.\" Èmi ni",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.24",
            "verseOrgIds": [
              "LEV.20.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.20.24",
                "verseOrgIds": [
                  "LEV.20.24"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run yín tí ó ti yà yín sọ́tọ̀ kúrò láàrín àwọn ènìyàn yòókù.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.24",
            "verseOrgIds": [
              "LEV.20.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 20:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ẹ gbọdọ̀ pààlà sáàrín ẹran tí ó mọ́ àti àwọn tí kò mọ́. Láàrín ẹyẹ tí ó mọ́ àti àwọn tí kò mọ́. Ẹ má ṣe sọ ara yín di àìmọ́ nípasẹ̀ àwọn ẹranko tàbí ẹyẹ tàbí ohunkóhun tí ń rìn lórí ilẹ̀: èyí tí mo yà sọ́tọ̀ fún yín gẹ́gẹ́ bí ohun àìmọ́.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.25",
            "verseOrgIds": [
              "LEV.20.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 20:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ gbọdọ̀ jẹ́ mímọ́ fún mi torí pé, Èmi",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.26",
            "verseOrgIds": [
              "LEV.20.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.20.26",
                "verseOrgIds": [
                  "LEV.20.26"
                ]
              }
            }
          ]
        },
        {
          "text": "fẹ́ mímọ́. Mó sì ti yà yín kúrò nínú àwọn orílẹ̀-èdè yòókù kí ẹ le jẹ́ tèmi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.26",
            "verseOrgIds": [
              "LEV.20.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 20:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ọkùnrin tàbí obìnrin tí ó jẹ́ abókùúsọ̀rọ̀ tàbí oṣó láàrín yín ni kí ẹ pa. Ẹ sọ wọ́n ní òkúta, ẹ̀jẹ̀ wọn yóò wà lórí wọn.' \"",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.27",
            "verseOrgIds": [
              "LEV.20.27"
            ]
          }
        }
      ]
    }
