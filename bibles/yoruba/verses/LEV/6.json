    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.6.1",
                "verseOrgIds": [
                  "LEV.5.20"
                ]
              }
            }
          ]
        },
        {
          "text": "sọ fún Mose pé,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.1",
            "verseOrgIds": [
              "LEV.5.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Bí ẹnikẹ́ni bá dẹ́ṣẹ̀ tí ó sì ṣe àìṣòótọ́ sí",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.2",
            "verseOrgIds": [
              "LEV.5.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.6.2",
                "verseOrgIds": [
                  "LEV.5.21"
                ]
              }
            }
          ]
        },
        {
          "text": "nípa títan ẹnìkejì rẹ̀ lórí ohun tí wọ́n fi sí ìkáwọ́ tàbí tí wọ́n fi pamọ́ sí i lọ́wọ́, tàbí bí ó bá jalè, tàbí kí ó yan ẹnìkejì rẹ̀ jẹ,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.2",
            "verseOrgIds": [
              "LEV.5.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "tàbí kí ó rí ohun tó sọnù he tó sì parọ́ tàbí kí ó búra èké, tàbí kí ó tilẹ̀ dẹ́ṣẹ̀ kan, irú èyí tí ènìyàn lè ṣẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.3",
            "verseOrgIds": [
              "LEV.5.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ó bá dẹ́ṣẹ̀ báyìí tó sì jẹ̀bi, ó gbọdọ̀ dá ohun tó jí tàbí ohun tó fi agbára gbà, tàbí ohun tí a fi sí ìkáwọ́ rẹ̀, tàbí ohun tó sọnù tó rí he,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.4",
            "verseOrgIds": [
              "LEV.5.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "tàbí ohunkóhun tó búra èké lé lórí. Ó gbọdọ̀ dá gbogbo rẹ̀ padà ní pípé, kí ó fi ìdámárùn-ún iye rẹ̀ kún, kí ó sì dá gbogbo rẹ̀ padà fún ẹni tí ó ni í, ní ọjọ́ tó bá ń rú ẹbọ ẹ̀bi rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.5",
            "verseOrgIds": [
              "LEV.5.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fún ìtánràn rẹ̀, ó gbọdọ̀ mú àgbò kan láti inú agbo ẹran wá fún àlùfáà, àní síwájú",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.6",
            "verseOrgIds": [
              "LEV.5.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.6.6",
                "verseOrgIds": [
                  "LEV.5.25"
                ]
              }
            }
          ]
        },
        {
          "text": ", ẹbọ ẹ̀bi, àgbò aláìlábùkù, tó sì níye lórí bí iye owó ibi mímọ́.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.6",
            "verseOrgIds": [
              "LEV.5.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Báyìí ní àlùfáà yóò ṣe ètùtù fún un ètùtù ìwẹ̀nùmọ́ níwájú",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.7",
            "verseOrgIds": [
              "LEV.5.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.6.7",
                "verseOrgIds": [
                  "LEV.5.26"
                ]
              }
            }
          ]
        },
        {
          "text": ", a ó sì dáríjì í nítorí ohun tó ti ṣe tó sì mú un jẹ̀bi.\"",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.7",
            "verseOrgIds": [
              "LEV.5.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Òfin ẹbọ sísun",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.6.8",
                "verseOrgIds": [
                  "LEV.6.1"
                ]
              }
            }
          ]
        },
        {
          "text": "sọ fún Mose pé,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.8",
            "verseOrgIds": [
              "LEV.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Pàṣẹ fún Aaroni àti àwọn ọmọ rẹ̀ pé, 'Èyí ni ìlànà fún ẹbọ sísun; ẹbọ sísun gbọdọ̀ wà lórí pẹpẹ láti alẹ́ di òwúrọ̀, kí iná sì máa jó lórí pẹpẹ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.9",
            "verseOrgIds": [
              "LEV.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "kí àlùfáà sì wọ ẹ̀wù funfun rẹ̀ pẹ̀lú àwọ̀tẹ́lẹ̀ lára rẹ̀, yóò sì kó eérú tó wà níbi ẹbọ sísun tí iná ti jó lórí pẹpẹ, sí ẹ̀gbẹ́ pẹpẹ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.10",
            "verseOrgIds": [
              "LEV.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni yóò bọ́ aṣọ rẹ̀, yóò sì wọ òmíràn, yóò wá gbé eérú náà lọ sí ẹ̀yìn ibùdó níbi tí a kà sí mímọ́.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.11",
            "verseOrgIds": [
              "LEV.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iná tó wà lórí pẹpẹ gbọdọ̀ máa jó, kò gbọdọ̀ kú, ní àràárọ̀ ni kí àlùfáà máa to igi si, kí ó sì to ẹbọ sísun sórí iná, kí ó sì máa sun ọ̀rá ẹran ẹbọ àlàáfíà níbẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.12",
            "verseOrgIds": [
              "LEV.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iná gbọdọ̀ máa jó lórí pẹpẹ títí, kò gbọdọ̀ kú.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.13",
            "verseOrgIds": [
              "LEV.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Òfin ẹbọ ohun jíjẹ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ìwọ̀nyí ni ìlànà fún ẹbọ ohun jíjẹ, kí àwọn ọmọ Aaroni gbé ẹbọ sísun náà wá síwájú",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.14",
            "verseOrgIds": [
              "LEV.6.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.6.14",
                "verseOrgIds": [
                  "LEV.6.7"
                ]
              }
            }
          ]
        },
        {
          "text": "níwájú pẹpẹ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.14",
            "verseOrgIds": [
              "LEV.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kí àlùfáà bu ẹ̀kúnwọ́ ìyẹ̀fun kíkúnná dáradára àti òróró pẹ̀lú gbogbo tùràrí tó wà lórí ẹbọ ohun jíjẹ náà kí ó sì sun ẹbọ ìrántí náà lórí pẹpẹ gẹ́gẹ́ bí òórùn dídùn sí",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.15",
            "verseOrgIds": [
              "LEV.6.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.6.15",
                "verseOrgIds": [
                  "LEV.6.8"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.15",
            "verseOrgIds": [
              "LEV.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aaroni àti àwọn ọmọ rẹ̀ ni yóò jẹ ìyókù ṣùgbọ́n wọ́n gbọdọ̀ jẹ ẹ́ láìsí máa wú máa wú ohun tí ń mú àkàrà wú nínú rẹ̀ ní ibi mímọ́, ní àgbàlá àgọ́ ìpàdé ni kí wọn ó ti jẹ ẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.16",
            "verseOrgIds": [
              "LEV.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ má ṣe ṣè é pẹ̀lú ìwúkàrà. Èmi ti fún àwọn àlùfáà gẹ́gẹ́ bí ìpín wọn nínú ẹbọ tí a fi iná sun sí mi. Ó jẹ́ mímọ́ jùlọ gẹ́gẹ́ bí ẹbọ ẹ̀ṣẹ̀ àti ẹbọ ẹ̀bi náà ṣe jẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.17",
            "verseOrgIds": [
              "LEV.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èyíkéyìí nínú àwọn ọmọkùnrin ìran Aaroni ló le jẹ ẹ́. Èyí ni ìpín rẹ tí ó gbọdọ̀ máa ṣe déédé lára àwọn ẹbọ tí a fi iná sun sí",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.18",
            "verseOrgIds": [
              "LEV.6.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.6.18",
                "verseOrgIds": [
                  "LEV.6.11"
                ]
              }
            }
          ]
        },
        {
          "text": "láti ìrandíran. Ohunkóhun tí ó bá kàn án yóò di mímọ́.' \"",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.18",
            "verseOrgIds": [
              "LEV.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.6.19",
                "verseOrgIds": [
                  "LEV.6.12"
                ]
              }
            }
          ]
        },
        {
          "text": "sọ fún Mose pé,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.19",
            "verseOrgIds": [
              "LEV.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Èyí ni ọrẹ tí Aaroni àti àwọn ọmọ rẹ gbọdọ̀ mú wá fún",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.20",
            "verseOrgIds": [
              "LEV.6.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.6.20",
                "verseOrgIds": [
                  "LEV.6.13"
                ]
              }
            }
          ]
        },
        {
          "text": "ní ọjọ́ tí a bá fi òróró yan ọ̀kọ̀ọ̀kan wọn; ìdámẹ́wàá òsùwọ̀n ìyẹ̀fun kíkúnná dáradára fún ẹbọ ohun jíjẹ lójoojúmọ́, ìdajì rẹ̀ ní àárọ̀ àti ìdajì rẹ̀ ní ìrọ̀lẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.20",
            "verseOrgIds": [
              "LEV.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ pèsè rẹ̀ pẹ̀lú òróró nínú àwo fífẹ̀, ẹ pò ó pọ̀ dáradára, kí ẹ sì gbé ọrẹ ohun jíjẹ náà wá ní ègé kéékèèké bí òórùn dídùn sí",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.21",
            "verseOrgIds": [
              "LEV.6.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.6.21",
                "verseOrgIds": [
                  "LEV.6.14"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.21",
            "verseOrgIds": [
              "LEV.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọmọkùnrin Aaroni tí yóò rọ́pò rẹ̀ gẹ́gẹ́ bí àlùfáà tí a fi òróró yàn ni yóò rú ẹbọ náà. Ó jẹ́ ìpín ti",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.22",
            "verseOrgIds": [
              "LEV.6.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.6.22",
                "verseOrgIds": [
                  "LEV.6.15"
                ]
              }
            }
          ]
        },
        {
          "text": "títí láé, wọn sì gbọdọ̀ sun ún pátápátá.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.22",
            "verseOrgIds": [
              "LEV.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo ọrẹ ohun jíjẹ ti àlùfáà ni wọ́n gbọdọ̀ sun pátápátá, wọn kò gbọdọ̀ jẹ ẹ́.\"",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.23",
            "verseOrgIds": [
              "LEV.6.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Òfin ẹbọ ẹ̀ṣẹ̀",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 6:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.6.24",
                "verseOrgIds": [
                  "LEV.6.17"
                ]
              }
            }
          ]
        },
        {
          "text": "sọ fún Mose pé,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.24",
            "verseOrgIds": [
              "LEV.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 6:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Sọ fún Aaroni àti àwọn ọmọ rẹ̀ ọkùnrin, 'Wọ̀nyí ni ìlànà fún ẹbọ ẹ̀ṣẹ̀, kí ẹ sì pa ẹran ẹbọ ẹ̀ṣẹ̀ níwájú",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.25",
            "verseOrgIds": [
              "LEV.6.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.6.25",
                "verseOrgIds": [
                  "LEV.6.18"
                ]
              }
            }
          ]
        },
        {
          "text": ", níbi tí ẹ ti ń pa ẹran ẹbọ sísun, ó jẹ́ mímọ́ jùlọ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.25",
            "verseOrgIds": [
              "LEV.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 6:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àlùfáà tó rú ẹbọ náà ni kí ó jẹ ẹ́, ibi mímọ́ ni kí ó ti jẹ ẹ́, ní àgbàlá àgọ́ ìpàdé.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.26",
            "verseOrgIds": [
              "LEV.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 6:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ohunkóhun tí ó bá kàn án yóò di mímọ́, bí ẹ̀jẹ̀ rẹ̀ bá sì ta sí ara aṣọ kan, ẹ gbọdọ̀ fọ̀ ọ́ ní ibi mímọ́.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.27",
            "verseOrgIds": [
              "LEV.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 6:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ gbọdọ̀ fọ́ ìkòkò amọ̀ tí ẹ fi se ẹran náà, ṣùgbọ́n bí ó bá ṣe ìkòkò idẹ ni ẹ fi sè é, ẹ gbọdọ̀ bó o, kí ẹ sì fi omi sìn ín dáradára.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.28",
            "verseOrgIds": [
              "LEV.6.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 6:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo ọkùnrin ní ìdílé àlùfáà ló lè jẹ ẹ́, ó jẹ́ mímọ́ jùlọ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.29",
            "verseOrgIds": [
              "LEV.6.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 6:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ kò gbọdọ̀ jẹ ẹbọ ẹ̀ṣẹ̀ kankan, èyí tí wọ́n bá mú ẹ̀jẹ̀ rẹ̀ wá sínú àgọ́ ìpàdé láti fi ṣe ètùtù ní Ibi Mímọ́, sísun ni kí ẹ sun ún.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.30",
            "verseOrgIds": [
              "LEV.6.23"
            ]
          }
        }
      ]
    }
