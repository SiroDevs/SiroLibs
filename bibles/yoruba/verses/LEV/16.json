  "verseCount": 34,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "16",
        "style": "c",
        "sid": "LEV 16"
      },
      "items": [
        {
          "text": "16",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ọjọ́ ètùtù ìwẹ̀nùmọ́ ẹ̀ṣẹ̀",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.16.1",
                "verseOrgIds": [
                  "LEV.16.1"
                ]
              }
            }
          ]
        },
        {
          "text": "sọ fún Mose lẹ́yìn ikú àwọn ọmọ Aaroni méjèèjì tí wọ́n kú nígbà tí wọ́n súnmọ́",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.1",
            "verseOrgIds": [
              "LEV.16.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.16.1",
                "verseOrgIds": [
                  "LEV.16.1"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.1",
            "verseOrgIds": [
              "LEV.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.16.2",
                "verseOrgIds": [
                  "LEV.16.2"
                ]
              }
            }
          ]
        },
        {
          "text": "sì sọ fún Mose pé, \"Kìlọ̀ fún Aaroni arákùnrin rẹ pé kí ó má ṣe máa wá nígbà gbogbo sí Ibi Mímọ́ Jùlọ tí ó wà lẹ́yìn aṣọ títa ní ibi tí àpótí ẹ̀rí àti ìtẹ́ àánú wà, kí ó má ba à kú nítorí pé Èmi ó farahàn nínú ìkùùkuu lórí ìtẹ́ àánú.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.2",
            "verseOrgIds": [
              "LEV.16.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Báyìí ni Aaroni yóò ṣe máa wá sí Ibi Mímọ́ Jùlọ pẹ̀lú ọ̀dọ́ akọ màlúù fún ẹbọ ẹ̀ṣẹ̀ àti àgbò fún ẹbọ sísun.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.3",
            "verseOrgIds": [
              "LEV.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Òun yóò sì wọ aṣọ funfun mímọ́ pẹ̀lú àwọ̀tẹ́lẹ̀ funfun, yóò sì fi àmùrè funfun mímọ́ dì í, yóò sì dé fìlà funfun, àwọn aṣọ mímọ́ nìwọ̀nyí. Òun yóò sì fi omi wẹ̀, kí ó tó wọ̀ wọ́n.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.4",
            "verseOrgIds": [
              "LEV.16.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Òun yóò sì mú ọmọ ewúrẹ́ méjì láti ọ̀dọ̀ gbogbo àgbájọpọ̀ àwọn ọmọ Israẹli láti fi ṣe ẹbọ ẹ̀ṣẹ̀ wọ́n, àti àgbò kan fún ẹbọ sísun.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.5",
            "verseOrgIds": [
              "LEV.16.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Aaroni yóò sì fi akọ màlúù rú ẹbọ ẹ̀ṣẹ̀ èyí tí ṣe ti ara rẹ̀ òun yóò sì ṣe ètùtù fún ara rẹ̀ àti ìdílé rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.6",
            "verseOrgIds": [
              "LEV.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lẹ́yìn náà yóò sì mú ewúrẹ́ méjì náà wá sí iwájú",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.7",
            "verseOrgIds": [
              "LEV.16.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.16.7",
                "verseOrgIds": [
                  "LEV.16.7"
                ]
              }
            }
          ]
        },
        {
          "text": "ní ibi ìlẹ̀kùn àgọ́ ìpàdé.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.7",
            "verseOrgIds": [
              "LEV.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aaroni yóò sì dìbò ní ti àwọn ewúrẹ́ méjèèjì náà, ìbò àkọ́kọ́ fún ti",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.8",
            "verseOrgIds": [
              "LEV.16.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.16.8",
                "verseOrgIds": [
                  "LEV.16.8"
                ]
              }
            }
          ]
        },
        {
          "text": ", àti èkejì fún ewúrẹ́ ìpààrọ̀.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.8",
            "verseOrgIds": [
              "LEV.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aaroni yóò sì mú ewúrẹ́ tí ìbò",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.9",
            "verseOrgIds": [
              "LEV.16.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.16.9",
                "verseOrgIds": [
                  "LEV.16.9"
                ]
              }
            }
          ]
        },
        {
          "text": "mú, yóò sì fi rú ẹbọ ẹ̀ṣẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.9",
            "verseOrgIds": [
              "LEV.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n ewúrẹ́ tí ìbò bá mú gẹ́gẹ́ bí ewúrẹ́ ìpààrọ̀ ni a ó mú wá láààyè síwájú",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.10",
            "verseOrgIds": [
              "LEV.16.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.16.10",
                "verseOrgIds": [
                  "LEV.16.10"
                ]
              }
            }
          ]
        },
        {
          "text": "láti fi ṣe ètùtù sí i àti láti jẹ́ kí ó lọ lọ́fẹ̀ẹ́, sí aginjù.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.10",
            "verseOrgIds": [
              "LEV.16.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ètùtù fún olórí àlùfáà",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Aaroni yóò sì mú akọ màlúù fún ẹbọ ẹ̀ṣẹ̀ wá láti ṣe ètùtù fún ara rẹ̀ àti ìdílé rẹ̀. Yóò sì pa akọ màlúù náà fún ẹbọ ẹ̀ṣẹ̀ tirẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.11",
            "verseOrgIds": [
              "LEV.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yóò sì mú àwo tùràrí tí ó kún fún èédú tí a ti sun pẹ̀lú iná láti orí pẹpẹ wá síwájú",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.12",
            "verseOrgIds": [
              "LEV.16.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.16.12",
                "verseOrgIds": [
                  "LEV.16.12"
                ]
              }
            }
          ]
        },
        {
          "text": ": àti ẹ̀kúnwọ́ méjì tùràrí tí a gún kúnná yóò sì mú un wá sí ẹ̀yìn aṣọ títa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.12",
            "verseOrgIds": [
              "LEV.16.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yóò sì fi tùràrí náà lé orí iná níwájú",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.13",
            "verseOrgIds": [
              "LEV.16.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.16.13",
                "verseOrgIds": [
                  "LEV.16.13"
                ]
              }
            }
          ]
        },
        {
          "text": ": kí èéfín tùràrí náà ba à le bo ìtẹ́ àánú tí ó wà ní orí àpótí ẹ̀rí kí o má ba à kú.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.13",
            "verseOrgIds": [
              "LEV.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yóò sì mú nínú ẹ̀jẹ̀ ọmọ màlúù náà yóò sì fi ìka rẹ̀ wọ́n ọn, ní iwájú ìtẹ́ àánú, yóò sì fi ìka rẹ̀ wọ́n ọn nígbà méje níwájú ìtẹ́ àánú.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.14",
            "verseOrgIds": [
              "LEV.16.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ètùtù fún àwọn ènìyàn",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nígbà yìí ni yóò pa ewúrẹ́ ẹbọ ẹ̀ṣẹ̀ tí ó wà fún àwọn ènìyàn yóò sì mú ẹ̀jẹ̀ rẹ̀ wá sí ẹ̀yìn aṣọ títa, bí ó ti ṣe ẹ̀jẹ̀ akọ màlúù náà ni yóò ṣe ti ewúrẹ́ yìí, yóò sì wọ́n ọn sórí ìtẹ́ ètùtù àti síwájú ìtẹ́ ètùtù.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.15",
            "verseOrgIds": [
              "LEV.16.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Báyìí ni yóò ṣe ètùtù fún Ibi Mímọ́ Jùlọ nítorí àìmọ́ àwọn ará Israẹli àti nítorí gbogbo ìrékọjá wọn àti ìṣọ̀tẹ̀ wọn nípa ẹ̀ṣẹ̀ wọn gbogbo, bákan náà ni yóò sì ṣe fún àgọ́ ìpàdé, èyí tí ó wà láàrín wọn nínú àìmọ́ wọn.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.16",
            "verseOrgIds": [
              "LEV.16.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kí ó má ṣe sí ẹyọ ènìyàn kan nínú àgọ́ ìpàdé nígbà tí òun bá wọ Ibi Mímọ́ Jùlọ lọ láti ṣe ètùtù, títí di ìgbà tí yóò fi jáde lẹ́yìn tí ó ba ṣe ètùtù fúnra rẹ̀ fún ìdílé rẹ̀ àti fún gbogbo àgbájọpọ̀ Israẹli.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.17",
            "verseOrgIds": [
              "LEV.16.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Lẹ́yìn náà òun yóò lọ sí ibi pẹpẹ tí ó wà níwájú",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.18",
            "verseOrgIds": [
              "LEV.16.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.16.18",
                "verseOrgIds": [
                  "LEV.16.18"
                ]
              }
            }
          ]
        },
        {
          "text": ", yóò sì ṣe ètùtù fún pẹpẹ náà. Yóò sì mú nínú ẹ̀jẹ̀ akọ màlúù àti nínú ẹ̀jẹ̀ ewúrẹ́ náà, yóò sì fi sí orí ọ̀kọ̀ọ̀kan ìwo pẹpẹ náà yíká.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.18",
            "verseOrgIds": [
              "LEV.16.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lẹ́yìn náà, òun yóò wọ́n ẹ̀jẹ̀ náà sórí rẹ̀ pẹ̀lú ìka rẹ̀ nígbà méje láti wẹ̀ ẹ́ mọ́ àti láti sọ ọ́ dí mímọ́ kúrò nínú àìmọ́ àwọn ọmọ Israẹli.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.19",
            "verseOrgIds": [
              "LEV.16.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Lẹ́yìn ti Aaroni ti parí ṣíṣe ètùtù ti Ibi Mímọ́ Jùlọ, ti àgọ́ ìpàdé àti ti pẹpẹ, òun yóò sì mú ààyè ewúrẹ́ wá.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.20",
            "verseOrgIds": [
              "LEV.16.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 16:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aaroni yóò sì gbé ọwọ́ rẹ̀ méjèèjì lé orí ààyè ewúrẹ́ náà, yóò sì jẹ́wọ́ gbogbo ìwà búburú àti ìṣọ̀tẹ̀ àwọn ara Israẹli lé e lórí. Gbogbo ìrékọjá wọn àti ẹ̀ṣẹ̀ wọn ni yóò sì gbé ka orí ewúrẹ́ náà. Yóò sì rán an lọ sí ijù láti ọwọ́ ẹni tí a yàn fún iṣẹ́ náà.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.21",
            "verseOrgIds": [
              "LEV.16.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 16:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ewúrẹ́ náà yóò sì ru gbogbo àìṣedéédéé wọn lọ sí ilẹ̀ tí ènìyàn kò gbé. Òun yóò sì jọ̀wọ́ ewúrẹ́ náà lọ́wọ́ lọ sínú ijù.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.22",
            "verseOrgIds": [
              "LEV.16.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 16:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Aaroni yóò sì padà wá sí ibi àgọ́ ìpàdé, yóò sì bọ́ aṣọ ọ̀gbọ̀ wọ̀n-ọn-nì sílẹ̀, tí ó wọ̀ nígbà tí ó lọ sí Ibi Mímọ́ Jùlọ, yóò sì fi wọ́n sílẹ̀ níbẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.23",
            "verseOrgIds": [
              "LEV.16.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 16:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yóò sì fi omi wẹ ara rẹ̀ ní ibi mímọ́ kan, yóò sì wọ aṣọ rẹ̀ yóò sì wá ṣí iwájú, yóò sì rú ẹbọ sísun ti ara rẹ̀ àti ẹbọ sísun ti àwọn ènìyàn láti ṣe ètùtù fún ara rẹ̀ àti fún àwọn ènìyàn.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.24",
            "verseOrgIds": [
              "LEV.16.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 16:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Òun yóò sì sun ọrẹ ẹbọ ẹ̀ṣẹ̀ náà lórí pẹpẹ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.25",
            "verseOrgIds": [
              "LEV.16.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 16:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ẹni tí ó tú ewúrẹ́ ìpààrọ̀ náà sílẹ̀ yóò sì fọ aṣọ rẹ̀, yóò sì wẹ ara rẹ̀ nínú omi, lẹ́yìn èyí ó lè wá sí ibùdó.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.26",
            "verseOrgIds": [
              "LEV.16.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 16:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ̀dọ́ akọ màlúù àti ewúrẹ́ ẹbọ ẹ̀ṣẹ̀ tí a ti mú ẹ̀jẹ̀ wọn wá sí Ibi Mímọ́ Jùlọ ni kí a gbe jáde kúrò ní ibùdó. Awọ wọn ni a ó fi iná sun bákan náà.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.27",
            "verseOrgIds": [
              "LEV.16.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 16:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹni tí ó sun wọ́n yóò sì fọ aṣọ rẹ̀, yóò sì wẹ ara rẹ̀, lẹ́yìn èyí ni ó tó le wọ ibùdó.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.28",
            "verseOrgIds": [
              "LEV.16.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 16:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Èyí ni yóò jẹ́ ìlànà títí láé fún un yín, pé ní ọjọ́ kẹwàá oṣù keje ni ẹ gbọdọ̀ ṣẹ́ ara yín, kí ẹ má ṣe ṣe iṣẹ́ kankan, yálà onílé tàbí àlejò tí ó ń gbé pẹ̀lú yín.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.29",
            "verseOrgIds": [
              "LEV.16.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 16:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Torí pé ní ọjọ́ yìí ni àlùfáà yóò ṣe ètùtù fún yín láti sọ yín di mímọ́, kí ẹ̀yin bá à le mọ́ níwájú",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.30",
            "verseOrgIds": [
              "LEV.16.30"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.16.30",
                "verseOrgIds": [
                  "LEV.16.30"
                ]
              }
            }
          ]
        },
        {
          "text": "yín kúrò nínú ẹ̀ṣẹ̀ yín gbogbo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.30",
            "verseOrgIds": [
              "LEV.16.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 16:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọjọ́ yìí yóò jẹ́ ọjọ́ ìsinmi pátápátá fún un yín, ẹ̀yin yóò sì ṣẹ́ ara yín. Èyí yóò sì jẹ́ ìlànà títí láé.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.31",
            "verseOrgIds": [
              "LEV.16.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 16:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àlùfáà náà tí a ti fi òróró yàn tí a sì ti sọ di mímọ́ láti máa ṣe iṣẹ́ ìránṣẹ́ ní ilé ìsìn ní ipò baba rẹ̀, òun ni kí ó ṣe ètùtù, yóò sì wọ aṣọ funfun gbòò àní aṣọ mímọ́ náà, òun yóò sì ṣe ètùtù.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.32",
            "verseOrgIds": [
              "LEV.16.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LEV 16:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yóò sì ṣe ètùtù fún Ibi Mímọ́ Jùlọ, fún ìpàdé àti fún pẹpẹ, yóò sì ṣe ètùtù fún àlùfáà àti fún gbogbo àgbájọpọ̀ àwọn ènìyàn náà.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.33",
            "verseOrgIds": [
              "LEV.16.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LEV 16:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Èyí ni yóò jẹ́ ìlànà ayérayé fún yín: láti máa ṣe ètùtù fún àwọn ará Israẹli fún gbogbo ẹ̀ṣẹ̀ wọn lẹ́ẹ̀kan lọ́dún.\"",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.34",
            "verseOrgIds": [
              "LEV.16.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "LEV 16:34"
      },
      "items": [
        {
          "text": "Ó sì ṣe gẹ́gẹ́ bí",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.34",
            "verseOrgIds": [
              "LEV.16.34"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.16.34",
                "verseOrgIds": [
                  "LEV.16.34"
                ]
              }
            }
          ]
        },
        {
          "text": "ti pàṣẹ fún Mose.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.34",
            "verseOrgIds": [
              "LEV.16.34"
            ]
          }
        }
      ]
    }
  ],
