        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niko ngazighana, nani ngasikira indu ikikema na lwaka lubaa ngelo erekoghe ikiburuka koighu mbeonyi, “Ni bugha! Ni bugha! Ni bugha kwa awo wandu wikaiagha ndoenyi, ingelo weke malaika wamu wadadu wakakaba tarumbeta rawo!”",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.13",
            "verseOrgIds": [
              "REV.8.13"
            ]
          }
        }
