        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uo malaika wa kana ukaikaba tarumbeta yake, ifungu ja kadadu ja iruwa, na ja mori, na ja nyerinyeri jikakabwa, hata ifungu ja kadadu ja miengere yaro jikawuya kira; na ifungu ja kadadu ja dime hata ja kio ndejeredimieghe kufunya miengere yaro anduangi.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.12",
            "verseOrgIds": [
              "REV.8.12"
            ]
          }
        },
        {
