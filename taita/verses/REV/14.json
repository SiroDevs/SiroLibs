        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "REV 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na malaika umu ukafuma hekalunyi aho mlungunyi, nao moni wori orekoghe na mundu ghukalie. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.17",
            "verseOrgIds": [
              "REV.14.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "REV 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao malaika umu ukafuma madhabahunyi, uo ukaiagha na nguma aighu ya modo, ukammbanga kwa lwaka lubaa uo orekoghe na mundu ghukalie na kumzera, “Tumia mundu ghwako, kuvikwanye vanga va zabibu ra ndoenyi, angu zabibu raro rawurue.” ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.18",
            "verseOrgIds": [
              "REV.14.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "REV 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niko uja malaika ukaghukumba mundu ghwake ndoenyi, ukarikwanya zabibu ra ndoenyi na kurikumba andenyi ya chombo kibaa chekamia zabibu cha machu gha kubia kwa Mlungu; ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.19",
            "verseOrgIds": [
              "REV.14.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "REV 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "zabibu rikakamwa andenyi ya chombo chekamia shighadi ya muzi, na bagha ikafuma chombonyi, ikasalama wukula ghwa kilometa maghana adadu, na wuighu kaavui meta iwi.",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.20",
            "verseOrgIds": [
              "REV.14.20"
            ]
          }
        },
