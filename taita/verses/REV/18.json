          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niko malaika uwadie ndighi ukawada igho sa igho ibaa jesha, ukajikumba baharinyi ukighamba,",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.21",
            "verseOrgIds": [
