              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.27.36"
              },
              "items": [
                {
                  "text": "36",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.11",
            "verseOrgIds": [
              "REV.18.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "ivo vilambo dhahabu, feza, almasi, na lulu; nguwo ra kitani ndicha, ra zambarau, ra hariri na ritinikie; kula kichuku cha mudi ghwa marashi, vombo vose vibonyero kwa mbembe ra chovu, na vombo vose vibonyero kwa mbau ra zoghori mbaa; shaba, chuma, na magho ghighokie;",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.12",
            "verseOrgIds": [
              "REV.18.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.27.12+EZK.27.13"
              },
              "items": [
                {
                  "text": "Eze. 27.12-13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.27.22"
              },
              "items": [
                {
                  "text": "22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.12",
            "verseOrgIds": [
              "REV.18.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "mdalasini, vilungo, marumba, manemane, ubani, divei, mavuda, mufu ghwa ngano, na ngano; ng'ombe, ng'ondi, farasi, na magare gha chuma, na wazumba, nawo ni wandu.",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.13",
            "verseOrgIds": [
              "REV.18.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
