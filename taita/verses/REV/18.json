          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na vilongozi va meli vose, na wandu wikaiagha baharinyi, na awo wibonyagha kazi melinyi, na awo wose wishamagha baharinyi wikakaia kimusi kokula,",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.17",
            "verseOrgIds": [
              "REV.18.17"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
