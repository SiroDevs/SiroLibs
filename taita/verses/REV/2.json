              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.22.7"
              },
              "items": [
                {
                  "text": "7",
                  "type": "text"
                }
              ]
            },
