                "loc": "REV.22.2"
              },
              "items": [
                {
                  "text": "Wuf. 22.2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.28.13"
              },
              "items": [
                {
                  "text": "Eze. 28.13",
