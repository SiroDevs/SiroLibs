              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.8",
            "verseOrgIds": [
              "REV.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ini Johane mwanyinyu, mngara onyu andenyi ya Jesu, kwa agho matiriro, na ugho Wuzuri, na uko kurumaghia luma; nerekoghe andenyi ya kisiwa chiwangwagha Patimo, kwa wundu ghwa ijo ilagho ja Mlungu, na ugho wushuhuda ghwa Jesu. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.9",
            "verseOrgIds": [
              "REV.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nerekoghe andenyi ya Roho ituku ja Bwana; ngasikira lwaka lubaa sa lwa tarumbeta lukideda nyuma yapo, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.10",
            "verseOrgIds": [
              "REV.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "lukighamba, “Agho kughiwonagha kughiandike chuonyi, na kughighenjera agho makanisa mfungade; Efeso, Simurna, Pergamo, Thuatira, Saridi, Filadelfia, na Laodikea.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.11",
            "verseOrgIds": [
              "REV.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
