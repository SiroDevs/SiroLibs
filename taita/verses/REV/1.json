          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Idana kuandike iro maza kuriwonagha; iro riko, na iro richaakaia konyuma. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.19",
            "verseOrgIds": [
              "REV.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "REV 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngasu ya iro nyerinyeri mfungade kuriwonie kwa mkonu ghwapo ghwa kiwomi, na vinara va taa va dhahabu mfungade ni ihi: iro nyerinyeri mfungade ni weke malaika mfungade wa makanisa mfungade; na ivo vinara va taa mfungade, ni makanisa mfungade.",
          "type": "text",
