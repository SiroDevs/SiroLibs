          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "na kudibonya dikaie wuzuri, na wakohani wedumika kwa Mlungu wake nao ni Ndee; kwake uo, ndeghukaie wubaa, na kubonya nguma kwa kala na kala. Amen.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.6",
            "verseOrgIds": [
              "REV.1.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
