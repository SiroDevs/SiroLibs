          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.5",
            "verseOrgIds": [
              "REV.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
