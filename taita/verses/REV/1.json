          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ini ne Alfa na Omega” waghamba Bwana Mlungu uo uko, nao orekoghe, na nuo uchagha; Uo Uwadie Ndighi Rose.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.8",
            "verseOrgIds": [
              "REV.1.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
