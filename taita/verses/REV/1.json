              "type": "text"
            }
          ]
        },
        {
          "text": "uo uko moyo. Nerefueghe, nani hoku neko moyo kwa kala na kala; nani nawadie mifunguo ya kifwa na Andu kwa Wafu. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.18",
            "verseOrgIds": [
