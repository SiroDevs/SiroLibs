              "type": "tag",
              "attrs": {
                "loc": "REV.5.10"
              },
              "items": [
                {
                  "text": "Wuf. 5.10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.6",
            "verseOrgIds": [
              "REV.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olenyi uacha mawingunyi, na kula iriso jichammbona, na kula mundu oremdungieghe, na wandu wa mbari rose ra ndoenyi, wichakema mchungu kwa wundu ghwake. Niko koni. Amen.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.7",
            "verseOrgIds": [
              "REV.1.7"
            ]
          }
        },
