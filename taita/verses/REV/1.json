          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "maghu ghake gherekoghe sa shaba izughulo na ndighi, seji eeleshwa na modo, na lwaka lwake loresikirikieghe sa lwaka lwa machi mengi.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.15",
