          ]
        },
        {
          "text": "na kwa lukundo lwa Mlungu, nipate kucha konyu ngiboilwa na kuhoreshwa kwa kukaia andwamweri nenyo. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.32",
