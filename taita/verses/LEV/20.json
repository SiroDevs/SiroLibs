          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kuselale na mruna mayo angu na mruna ndeyo, huwo ni kufunukua wuduu ghwa mundu uko bagha imweri na oho; mkabonya huwo, mmbose mchaduka wuwiwi ghonyu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.19",
            "verseOrgIds": [
              "LEV.20.19"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.18.12+LEV.18.13+LEV.18.14"
              },
              "items": [
                {
                  "text": "Wal. 18.12-14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.19",
            "verseOrgIds": [
              "LEV.20.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 20:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundu ukalala na mka-awue, wafunukua wuduu ghwa awue, nawo wichaduka wuwiwi ghwawo weni; wichafwa wisene wana. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.20",
            "verseOrgIds": [
              "LEV.20.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 20:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundu ukammbusa mka-mruna, ugho ni wuchafu, waafunukua wuduu ghwa mruna; wichafwa wisene wana.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.21",
            "verseOrgIds": [
              "LEV.20.21"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.18.16"
              },
              "items": [
                {
                  "text": "Wal. 18.16",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
