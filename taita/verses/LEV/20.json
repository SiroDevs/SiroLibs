        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.10",
            "verseOrgIds": [
              "LEV.20.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 20:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundu ulalagha na mka-ndee, waafunukua wuduu ghwa ndee; wose wawi wibwagho, na bagha yawo ichakaia aighu kwawo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.11",
            "verseOrgIds": [
              "LEV.20.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
