          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundu ukalala na muka uko merinyi na kummanya kimumbi, waachuria kurucha kwake, na muka nao wafunukua kurucha kwake; wose wawi wichainjwa na kutanywa na wandu wawo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.18",
            "verseOrgIds": [
              "LEV.20.18"
