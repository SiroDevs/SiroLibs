          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mndungi ukabonya wulaki na muka wa mmbao, waja walaki wose, mndwawomi na muka wibwaghwa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.10",
            "verseOrgIds": [
              "LEV.20.10"
            ]
