          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihi niyo sharia ya kizongona chekora, kizongona cha viro, kizongona kwa wundu ghwa kaung'a, kizongona kwa wundu ghwa makosa, kizongona chewika wakfu, na kizongona cha mapatano; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.37",
            "verseOrgIds": [
              "LEV.7.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LEV 7:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "iyo BWANA oremnekieghe Musa aighu ya Mghondi ghwa Sinai, jija ituku orewilaghirieghe wandu wa Israeli wiredeghe mafunyo ghawo kwa BWANA, aho kireti cha Sinai.",
          "type": "text",
