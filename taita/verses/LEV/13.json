          },
          "items": [
            {
              "text": "58",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.58",
            "verseOrgIds": [
              "LEV.13.58"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "59",
            "style": "v",
            "sid": "LEV 13:59"
          },
          "items": [
            {
              "text": "59",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihi niyo sharia aighu ya wukongo ghwa sima ghukakadie nguwonyi, ikaiagha ya sufu angu kitani, angu kilambo icho chose chibonyero na mrongo. Na iyo sharia ichakaia ni kwa kuwonyera ngera kilambo chaelie angu ndechielie.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.59",
            "verseOrgIds": [
              "LEV.13.59"
            ]
          }
        }
      ]
