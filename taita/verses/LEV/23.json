              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "BWANA ukamzera Musa, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.1",
            "verseOrgIds": [
              "LEV.23.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Wizere wandu wa Israeli kukaia wicharitala Ndima riwikilo ra wueli ingelo wakwanyika kunitasa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.2",
            "verseOrgIds": [
              "LEV.23.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Matuku arandadu ni ghebonya kazi, ela ituku ja mfungade ni Sabato ehora; mkwanyike kwa wutasi, nenyo msakebonya kazi ingi; ni Sabato kwa BWANA andu uko kose mchaakaia.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.3",
            "verseOrgIds": [
              "LEV.23.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
