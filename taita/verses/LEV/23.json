              },
              "items": [
                {
                  "text": "Kuf. 12.1-13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.16.1+DEU.16.2"
              },
              "items": [
                {
                  "text": "Wuk. 16.1-2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.5",
            "verseOrgIds": [
              "LEV.23.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ituku ja ikumi na isanu, mchazoya Ndima ya Mikate Isewadie Chachu; mseje mkate ghuko na chachu kwa matuku mfungade.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.6",
            "verseOrgIds": [
              "LEV.23.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.12.14+EXO.12.15+EXO.12.16+EXO.12.17+EXO.12.18+EXO.12.19+EXO.12.20"
              },
              "items": [
                {
                  "text": "Kuf. 12.14-20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.23.15"
              },
              "items": [
                {
                  "text": "23.15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.34.18"
              },
              "items": [
                {
                  "text": "34.18",
