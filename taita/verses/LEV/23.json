        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.43",
            "verseOrgIds": [
              "LEV.23.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "LEV 23:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Huwo niko Musa orewighorieghe wandu wa Israeli mawiko gha Ndima ra BWANA.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.44",
            "verseOrgIds": [
              "LEV.23.44"
            ]
          }
        }
      ]
