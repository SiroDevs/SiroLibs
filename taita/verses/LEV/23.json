          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ndima ya Pasaka, iwikilo kwa wundu ghwa kumneka BWANA ishima, ichazolwa nakenyi ya ituku ja ikumi na inya ja mori ghwa imbiri.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.5",
            "verseOrgIds": [
              "LEV.23.5"
            ]
          }
        },
        {
