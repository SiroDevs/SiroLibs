          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "BWANA ukamzera Musa,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.26",
            "verseOrgIds": [
              "LEV.23.26"
            ]
          }
        },
        {
          "name": "note",
