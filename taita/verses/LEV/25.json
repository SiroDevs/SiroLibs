      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mkopo kwa wakiwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
