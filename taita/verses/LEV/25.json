              "type": "text"
            }
          ]
        },
        {
          "text": "Ukakaia usekombolo kwa iro chia, uchalekerelwa chiaimweri na wana wake Mwaka ghwa Jubili. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.54",
