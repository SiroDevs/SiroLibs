              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ifungu ja ikumi ja vindo va mbuwenyi ikaiagha ni viro angu matunda, ni va BWANA.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.30",
            "verseOrgIds": [
