              "LEV.11.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "LEV 11:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ihi niyo Sharia ewonyera aighu ya nyamandu, nyonyi, icho chose chiko moyo chighendagha machinyi, na kula shimandu iavuagha andoenyi; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.46",
            "verseOrgIds": [
              "LEV.11.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "LEV 11:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "mpate kuvisasawua aghadi ya iro rielie na iro riseelie; iro riko rejighwa, na iro riseko rejighwa.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.47",
            "verseOrgIds": [
              "LEV.11.47"
            ]
          }
        }
