          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa kukaia Mlungu wawiwona wandu na makosa iji waghamba,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.8",
            "verseOrgIds": [
              "HEB.8.8"
            ]
