            "sid": "HEB 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.13",
            "verseOrgIds": [
              "HEB.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HEB 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Welee, weke malaika wose si roho ridumikagha, ridumilo ripate kudumika kwa wundu ghwa awo wipatagha kukia anguwada?",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.14",
            "verseOrgIds": [
              "HEB.1.14"
            ]
          }
