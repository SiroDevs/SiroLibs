              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muwiroghuo vilongozi venyu, na awo waeli wose. Awanidu wifumie Italia wamroghua. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.24",
