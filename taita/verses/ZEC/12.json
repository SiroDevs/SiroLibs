              "items": [
                {
                  "text": "Wuf. 1.7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.10",
            "verseOrgIds": [
              "ZEC.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ZEC 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ituku ijo kililo cha Jerusalemu chichakaia kibaa sa kililo cha Hadadi-rimoni wurindinyi ghwa Megido. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.11",
            "verseOrgIds": [
              "ZEC.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ZEC 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wandu wichalila isangenyi kula nyumba chiaro; nyumba ya kichuku cha Daudi chiaro, na waka wawo chiaro; nyumba ya kichuku cha Nathani chiaro, na waka wawo chiaro; ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.12",
            "verseOrgIds": [
              "ZEC.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ZEC 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "nyumba ya kichuku cha Lawi chiaro, na waka wawo chiaro; nyumba ya Washimei chiaro, na waka wawo chiaro; ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.13",
            "verseOrgIds": [
              "ZEC.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ZEC 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "na nyumba rose rasigharika kula imu chiaro, na waka wawo chiaro.”",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.14",
            "verseOrgIds": [
              "ZEC.12.14"
            ]
          }
        }
      ]
    }
