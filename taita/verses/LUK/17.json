          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sa iji koni gherekoghe matuku gha Nuhu, niko koni kuchaakaia matuku gha Mwana wa Mdamu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.26",
            "verseOrgIds": [
              "LUK.17.26"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.6.5+GEN.6.6+GEN.6.7+GEN.6.8"
              },
              "items": [
                {
                  "text": "Kuz. 6.5-8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.26",
            "verseOrgIds": [
              "LUK.17.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 17:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Werejieghe, wikanywa, wikalowua, wikalowolwa, hata ituku jija Nuhu orengirieghe safinenyi, ikacha gharika na kuwitotesha wose.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.27",
            "verseOrgIds": [
              "LUK.17.27"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
