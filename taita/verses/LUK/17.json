          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ngelo iyo, uo uko nyumbenyi aighu, na vilambo vake viko nyumbenyi kondenyi, usakesea kuvishoa; na wokoni uo uko mbuwenyi, usakewuya mzinyi.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.31",
            "verseOrgIds": [
              "LUK.17.31"
            ]
          }
        },
