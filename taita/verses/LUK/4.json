                "loc": "PSA.91.12"
              },
              "items": [
                {
                  "text": "Zab. 91.12",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.11",
            "verseOrgIds": [
              "LUK.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu ukatumbulia, “Yaghorelo, ‘Kusakemtima Bwana Mlungu wako.’”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.12",
            "verseOrgIds": [
              "LUK.4.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.6.16"
              },
              "items": [
                {
                  "text": "Wuk. 6.16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.12",
            "verseOrgIds": [
              "LUK.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao iji Ibilisi waghimeria matimo ghake ghose, ukamsigha Jesu kwa ngelo.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.13",
            "verseOrgIds": [
              "LUK.4.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jesu kuzoya wudumiki ghwake Galilaya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.13",
            "verseOrgIds": [
              "LUK.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao Jesu ukawuya Galilaya uko nandighi ra Roho Mweli, na sare yake ikaera mbai-mbai kose isangenyi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.14",
            "verseOrgIds": [
              "LUK.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao ukafundisha andenyi ya sunagogi rawo ukikaswa ni wose.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.15",
            "verseOrgIds": [
              "LUK.4.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jesu kuleghwa aja Nazareti",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.15",
            "verseOrgIds": [
              "LUK.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao ukacha Nazareti andu oreleleloghe, ukangia sunagoginyi ituku ja Sabato karakara na mzango ghwake. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.16",
            "verseOrgIds": [
              "LUK.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukawuka kimusi ushome, ukanekwa chuo cha mlodi Isaya, ukachikuchua ukawona andu kuandikilo,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.17",
            "verseOrgIds": [
              "LUK.4.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.19",
            "verseOrgIds": [
              "LUK.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao ukachikucha chuo, ukammbunjira mdumiki; hata umeria kusea kidombo, wandu wose werekoghe andenyi ya sunagogi wikamkuya meso. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.20",
            "verseOrgIds": [
              "LUK.4.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukazoya kuwizera, “Idime maandiko agha ghapata kukatia madunyi konyu.” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.21",
            "verseOrgIds": [
              "LUK.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na wose wikamghora nicha, wikishinika kwa wundu ghwa agho malagho gha mvono orekoghe ukighighora; wikaghamba, “Welee, uhu suo moni mwana wa Josefu?”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.22",
            "verseOrgIds": [
              "LUK.4.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.22",
            "verseOrgIds": [
              "LUK.4.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao ukawizera, “Kwa loli mchaghutumia mfwano ughu aighu kwapo: ‘Mghanga, kukuboise kumoni, agho disikire wei kwaghibonyere Kafarnaumu, ghibonye aha isangenyi jako wori.’” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.23",
            "verseOrgIds": [
              "LUK.4.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 4:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukaghamba, “Namghoria loli, ndekuwadie mlodi ungi urumirikiagha isangenyi jake jeni.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.24",
            "verseOrgIds": [
              "LUK.4.24"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.4.44"
              },
              "items": [
                {
                  "text": "Joh. 4.44",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.24",
            "verseOrgIds": [
              "LUK.4.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 4:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ela namghoria loli, korekoghe na waka wakiwa wengi Israeli, matuku gha Elija; iji mlungunyi korefungiloghe kusenyeshe vua miaka idadu na meri irandadu, na njala mbaa ikangia isanga jose.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.25",
            "verseOrgIds": [
              "LUK.4.25"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.17.1"
              },
              "items": [
                {
                  "text": "1 Waz. 17.1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.25",
            "verseOrgIds": [
              "LUK.4.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 4:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Elija nderedumiloghe kwa ungi wawo, ela kwa muka umu mkiwa orekoghe Zarefathi isanga ja Sidoni.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.26",
            "verseOrgIds": [
              "LUK.4.26"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.17.8+1KI.17.9+1KI.17.10+1KI.17.11+1KI.17.12+1KI.17.13+1KI.17.14+1KI.17.15+1KI.17.16"
              },
              "items": [
                {
                  "text": "1 Waz. 17.8-16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.26",
            "verseOrgIds": [
              "LUK.4.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 4:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sena korekoghe na wandu wa sima wengi Israeli matuku gha mlodi Elisha, hata ndekuwadie ungi wawo oreelesheroghe, ela Naamani Msiria.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.27",
            "verseOrgIds": [
              "LUK.4.27"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.5.1+2KI.5.2+2KI.5.3+2KI.5.4+2KI.5.5+2KI.5.6+2KI.5.7+2KI.5.8+2KI.5.9+2KI.5.10+2KI.5.11+2KI.5.12+2KI.5.13+2KI.5.14"
              },
              "items": [
                {
                  "text": "2 Waz. 5.1-14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.27",
            "verseOrgIds": [
              "LUK.4.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 4:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao iji wasikira agho, wose werekoghe andenyi ya sunagogi wikajokwa ni machu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.28",
            "verseOrgIds": [
              "LUK.4.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 4:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wikawuka na kumfunya shighadi ya muzi, wikamghenja mghondinyi andu muzi ghwawo ghoreaghiloghe, na kumreda kichechemukonyi wipate kumchunua kijimijimi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.29",
            "verseOrgIds": [
              "LUK.4.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 4:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ela Jesu ukaida aghadi kwawo, ukaghenda chia yake.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.30",
            "verseOrgIds": [
              "LUK.4.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mundu uko na pepo izamie",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 4:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.30",
            "verseOrgIds": [
              "LUK.4.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 4:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao ukasea cha Kafarnaumu muzi ghwa Galilaya. Nao orekoghe ukiwifundisha ituku ja Sabato; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.31",
            "verseOrgIds": [
              "LUK.4.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 4:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "wikashinulwa ni mafundisho ghake, angu orekoghe ukideda kwa nguma.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.32",
            "verseOrgIds": [
              "LUK.4.32"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.7.28+MAT.7.29"
              },
              "items": [
                {
                  "text": "Mat. 7.28-29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.32",
            "verseOrgIds": [
              "LUK.4.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LUK 4:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao ahoeni sunagoginyi, korekoghe na mundu uko na roho ya pepo ya makakala, nao ukakema na lwaka lubaa, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.33",
            "verseOrgIds": [
              "LUK.4.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LUK 4:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Aa! Kwakunde kudibonya wada oho Jesu wa Nazareti? Kwaacha kuditotesha? Ini nakuichi oho ko uja Mweli wa Mlungu.” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.34",
            "verseOrgIds": [
              "LUK.4.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 4:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ela Jesu ukaikania ukaghamba, “Nyama kima kufume kwake!” Nao ija pepo imeria kumghusha aghadi kwawo, ikamfuma, isem'bonyere ilagho jingi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.35",
            "verseOrgIds": [
              "LUK.4.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LUK 4:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wandu wose wikashinika na kuzerana, “Ni ilaghoki iji? Angu kwa nguma nandighi wadalaghira pepo ra makakala, naro radafuma?” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.36",
            "verseOrgIds": [
              "LUK.4.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LUK 4:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao sare yake ikaera mbai-mbai kose isangenyi.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.37",
            "verseOrgIds": [
              "LUK.4.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jesu kuboisa wandu wengi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LUK 4:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.37",
            "verseOrgIds": [
              "LUK.4.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LUK 4:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu ukawuka ukafuma sunagoginyi, ukangia nyumbenyi kwa Simoni. Nao Simoni mkekwake orekoghe na homa mbaa, wikamghoria Jesu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.38",
            "verseOrgIds": [
              "LUK.4.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LUK 4:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukacha ukakaia kaavui na wuli ghwake, ukaikania ija homa, nayo ikamsigha; ukawuka shwa wori ukawidumikia.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.39",
            "verseOrgIds": [
              "LUK.4.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LUK 4:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.39",
            "verseOrgIds": [
              "LUK.4.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LUK 4:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao iji iruwa jerekoghe jikineng'ena, wose werekoghe na wakongo wengi wiko na makongo mazima mazima wikawireda kwake, nao ukawiwikiria mikonu wose ukawiboisa. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.40",
            "verseOrgIds": [
              "LUK.4.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "LUK 4:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na pepo nyingi rikawifuma wandu wengi rikikema na kughamba, “Oho ko Mwana wa Kristo!” Ela ukarikania na kurighiria kudeda, angu reremmanyireghe uo kukaia Kristo.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.41",
            "verseOrgIds": [
              "LUK.4.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jesu kuchila andenyi ya Sunagogi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "LUK 4:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.41",
            "verseOrgIds": [
              "LUK.4.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LUK 4:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao iji ndoe yaela, ukafuma ukaghenda andu kusewadie wandu. Wandu wikamlola na kumchea, wikakunda kumghiria usakefuma kwawo. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.42",
            "verseOrgIds": [
              "LUK.4.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LUK 4:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ela ukawizera, “Yanifwana kuchila iji Ilagho Jiboie ja Wuzuri ghwa Mlungu kwa mizi mizima wori, angu kwa wundu ughu niko neredumiloghe.” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.43",
            "verseOrgIds": [
              "LUK.4.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "LUK 4:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao ukakaia ukichila sunagoginyi ra Judea.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.44",
            "verseOrgIds": [
              "LUK.4.44"
            ]
          }
        }
      ]
    }
  ],
