          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Heli orekoghe mwana wa Mathati, uhu orekoghe mwana wa Lawi, mwana wa Meliki, mwana wa Janai, mwana wa Josefu; ",
          "type": "text",
          "attrs": {
