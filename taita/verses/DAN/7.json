                "loc": "REV.17.12"
              },
              "items": [
                {
                  "text": "Wuf. 17.12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.24",
            "verseOrgIds": [
              "DAN.7.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DAN 7:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uchadeda malagho ghelwa na Uo-Uko-Aighu-Nandighi, na kuwikoronga waeli wake, nao uchatima kughalua sharia rawo ra dini na ndima; nawo wichangirwa mikonunyi kwake kwa miaka idadu na nusu.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.25",
            "verseOrgIds": [
              "DAN.7.25"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
