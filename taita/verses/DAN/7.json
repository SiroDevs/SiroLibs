              "DAN.7.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DAN 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Niko ukanimanyisha: ‘Ija nyamandu ya kana ni wuzuri ghuchaawoneka ndoenyi; nagho ghuchakaia na wuchumbano na mawuzuri mazima. Wuzuri ugho ghuchasima ndoenyi kose; ghuchaichikanya na kuifasha fasha. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.23",
            "verseOrgIds": [
              "DAN.7.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DAN 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iro mbembe ikumi, ni wazuri ikumi wichaafuma kwa ugho wuzuri, na mzuri umu uchawuka nyuma yawo uchaakaia na wuchumbano na waja ikumi; nao uchawisima wazuri wadadu.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.24",
            "verseOrgIds": [
              "DAN.7.24"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
