                  "text": "Wuf. 12.14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.13.5+REV.13.6"
              },
              "items": [
                {
                  "text": "13.5-6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.25",
            "verseOrgIds": [
              "DAN.7.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DAN 7:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koti ya mlungunyi ichasea kidombo, na wuzuri ghwa uo mzuri ghuchainjwa, ghupate kumerelwa na kunonwa ghose. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.26",
            "verseOrgIds": [
              "DAN.7.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DAN 7:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niko wuzuri, na nguma rose na wubaa ghose ghwa agho mawuzuri gha ndoenyi ghichaanekwa waeli, awo wandu wa Uo Uko Aighu Na Ndighi, na wuzuri ghwawo ghuchakaia ghwa kala na kala. Wabonyi nguma wose wa ndoenyi wichawidumikia na kuwisikira.’",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.27",
            "verseOrgIds": [
              "DAN.7.27"
            ]
          }
        },
