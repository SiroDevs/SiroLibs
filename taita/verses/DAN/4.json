        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "DAN 4:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebukadnezari ukaghamba, “Kutua kwa agho matuku, ini Nebukadnezari nerewusireghe meso ghapo cha mlungunyi, nawurilwa ni akili rapo, ngamkasa Uo-Uko-Aighu-Nandighi, ngamkasa na kumneka ishima uo uduagha moyo kwa kala na kala.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.34",
            "verseOrgIds": [
              "DAN.4.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "DAN 4:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.35",
            "verseOrgIds": [
              "DAN.4.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "DAN 4:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ngelo iyo cheni, iji akili rapo raniwuria, wubaa ghwa wuzuri ghwapo, ishima japo na kuboa kwapo vikaniwuria. Wanjama wapo na wabaa wikanilola, ngawuya na kumangishwa andenyi ya wuzuri ghwapo, na hata wubaa mungi ghukachurilwa aighu yapo. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.36",
            "verseOrgIds": [
              "DAN.4.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "DAN 4:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Idana ini Nebukadnezari, nadamkasa, na kumkuma, na kumneka ishima Mzuri wa mlungunyi; angu kazi rake rose ni ra loli, na chia rake ni ra hachi. Wandu wose wighendagha kwa kukukasa, oko na ndighi ra kuwisera.”",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.37",
            "verseOrgIds": [
              "DAN.4.37"
            ]
          }
        }
      ]
