          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "EXO 40:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Matuku ghose gha kumara-mara kwawo, wandu wa Israeli werekoghe wikiwona ijo iwingu aighu ya Hema na dime, na modo ngelo ya nakio.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.38",
