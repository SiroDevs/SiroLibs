              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niko Farao ukaghamba, “Nichamsigha mghende cha kireti kum'bwaghia Mlungu onyu kizongona, ela mseghende kula. Nilombienyi.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.28",
            "verseOrgIds": [
              "EXO.8.28"
            ]
          }
        },
