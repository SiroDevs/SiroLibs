          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niko Musa ukamzera, “Ola naghenda, nani kesho nichamlomba BWANA uriinje iri izi kufuma kwa Farao, na kwa wadumiki wako, na kwa wandu wako; ela Farao usedikalie sena kwa kulegha kuwisigha awo wandu wighende kumfunyira BWANA kizongona.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.29",
            "verseOrgIds": [
              "EXO.8.29"
            ]
          }
        },
        {
          "name": "verse",
