                {
                  "text": "Lk. 11.20",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Izi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.19",
            "verseOrgIds": [
              "EXO.8.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "BWANA ukamzera Musa, “Kesho kuwuke kokio, kughende kukwane na Farao ukighenda modenyi kumzere Bwana waghamba huwu, ‘Sigha wandu wapo wighende eri wipate kunidumikia. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.20",
            "verseOrgIds": [
              "EXO.8.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Si huwo, ngera kwawighiria wandu wapo wiseghende, nichareda izi nyingi kwako, na kwa wadumiki wako, na kwa wandu wako, na andenyi ya nyumba rako; na nyumba ra Wamisri richachulwa ni izungu ja izi nyingi, hata na andu kose wawuyakaia kimusi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.21",
            "verseOrgIds": [
              "EXO.8.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 8:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ela ituku ijo, nichajilindia isanga ja Gosheni, andu wandu wapo wikaiagha, na izi ringi nderichaakaia aho anduangi; kupate kumanya angu Ini ne BWANA ndoenyi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.22",
            "verseOrgIds": [
              "EXO.8.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 8:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nichabonya mwano aghadi ya wandu wapo na wandu wako; uo mwakilimbiti uchabonywa kesho.’” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.23",
            "verseOrgIds": [
              "EXO.8.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 8:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "BWANA ukabonya wokoni; ukareda izungu ja izi nyingi nyumbenyi kwa Farao, na nyumbenyi kwa wadumiki wake, na andenyi ya isanga jose ja Misri, na ijo isanga jikanonwa ni izi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.24",
            "verseOrgIds": [
              "EXO.8.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 8:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.24",
            "verseOrgIds": [
              "EXO.8.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 8:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niko Farao ukawiwanga Musa na Haruni ukawizera, “Ghendenyi mumfunyire Mlungu onyu kizongona ahoeni isangenyi.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.25",
            "verseOrgIds": [
              "EXO.8.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 8:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ela Musa ukamtumbulia, “Ndeichaakaia hachi ingi isi dikabonya huwo; angu vizongona dichaamfunyira BWANA Mlungu odu, ni makuwisho kwa Wamisri. Welee, dikafunya vizongona vedu, navo ni makuwisho kwa Wamisri wikiwona-lee, ndewichaadilasa na magho? ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.26",
            "verseOrgIds": [
              "EXO.8.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 8:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Suti dighende charo cha matuku adadu noko cha kireti, dipate kumfunyira Mlungu odu kizongona, sa iji koni uchaadilaghira.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.27",
            "verseOrgIds": [
              "EXO.8.27"
            ]
          }
        },
        {
