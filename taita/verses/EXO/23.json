              },
              "items": [
                {
                  "text": "Kuf. 20.9-11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.31.15"
              },
              "items": [
                {
                  "text": "31.15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.34.21"
              },
              "items": [
                {
