                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mwaka ghwa mfungade na ituku ja mfungade",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.9",
            "verseOrgIds": [
              "EXO.23.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kulime mbuwa yako kwa miaka irandadu na kukuwida mavalo gharo;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.10",
            "verseOrgIds": [
              "EXO.23.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.25.1+LEV.25.2+LEV.25.3+LEV.25.4+LEV.25.5+LEV.25.6+LEV.25.7"
              },
              "items": [
                {
                  "text": "Wal. 25.1-7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.10",
            "verseOrgIds": [
              "EXO.23.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "ela mwaka ghwa mfungade kuisighe ilale. Kusekuwide kindo chingi chabuka aho; eri wakiwa wa wandu widime kuja icho chizoghuagha, na nyamandu ra isakenyi rije masighariko gharo. Kubonye woruwo kwa mbuwa yako ya mzabibu na mbuwa yako ya mzeituni.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.11",
            "verseOrgIds": [
              "EXO.23.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.11",
            "verseOrgIds": [
              "EXO.23.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kubonye kazi kwa matuku arandadu, ela ituku ja mfungade kusebonye kazi ingi, eri mzumba na mghenyi ukudumikiagha, hata na nyamandu rako wori ripate kuhora.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.12",
            "verseOrgIds": [
              "EXO.23.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
