              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.13",
            "verseOrgIds": [
              "EXO.23.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kula mwaka kubonye ndima idadu kwa ishima japo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.14",
            "verseOrgIds": [
              "EXO.23.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mori ghwa Abibu, ugho korefumieghe Misri, kunibonyere Ndima ya Mikate Isewadie Chachu, seji nerekulaghirieghe. Kuseje mkate ghungi ghuko na chachu ngelo ya ndima iyo kwa matuku mfungade. Mndungi useche kunitasa usedwae mafunyo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.15",
            "verseOrgIds": [
              "EXO.23.15"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.12.14+EXO.12.15+EXO.12.16+EXO.12.17+EXO.12.18+EXO.12.19+EXO.12.20"
              },
              "items": [
                {
                  "text": "Kuf. 12.14-20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
