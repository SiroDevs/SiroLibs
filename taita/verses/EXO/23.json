          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kuseereshe malagho gha tee, hata kusemtesie mundu mmbiwi kwa kufunya wushuhuda ghwa tee.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.1",
            "verseOrgIds": [
              "EXO.23.1"
            ]
          }
        },
        {
