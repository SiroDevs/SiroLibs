          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Mlungu ukamchura Roho wake, na kumneka akili na kumanya komdimisha kubonya kazi rose ra wufundi; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.31",
