              "items": [
                {
                  "text": "Mit. 11.7-8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.31",
            "verseOrgIds": [
              "EXO.16.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 16:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa ukaghamba, “Bwana walaghirie angu diwike pishi imweri ya mana kwa wundu ghwa vivalwa vichagha, wipate kuwona ivo vindo oremnekieghe kireti, iji oremfunyireghe isanga ja Misri.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.32",
            "verseOrgIds": [
              "EXO.16.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 16:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa ukamzera Haruni, “Wada mkebe, kukumbirie pishi imweri ya mana, iwiko imbiri ya BWANA kwa wundu ghwa vivalwa venyu vose.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.33",
            "verseOrgIds": [
              "EXO.16.33"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.9.4"
              },
              "items": [
                {
                  "text": "Waeb. 9.4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.33",
            "verseOrgIds": [
              "EXO.16.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 16:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haruni ukaviwika ivo vindo imbiri ya Isanduku ja Ilaghano vilindilo sa iji koni BWANA oremlaghirieghe Musa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.34",
            "verseOrgIds": [
              "EXO.16.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 16:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wandu wa Israeli wikaja ija mana kwa miaka mirongo ina hata wikavika wandunyi, wikaija hata wikavika mpakenyi ghwa isanga ja Kanaani.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.35",
            "verseOrgIds": [
              "EXO.16.35"
            ]
          }
        },
        {
          "name": "note",
