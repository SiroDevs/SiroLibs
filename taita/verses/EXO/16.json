          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wandu wa Israeli wereviwangieghe ivo vindo mana navo verekoghe vifwanane na ndembe ra mwemba ghwa chokwa, visingie sa maandazi ghiboisiro kwa wuki.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.31",
            "verseOrgIds": [
              "EXO.16.31"
            ]
          }
        },
        {
          "name": "note",
