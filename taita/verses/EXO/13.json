                "loc": "NUM.3.13"
              },
              "items": [
                {
                  "text": "Mit. 3.13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.2.23"
              },
              "items": [
                {
                  "text": "Lk. 2.23",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ndima ya Mikate Isewadie Chachu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.2",
            "verseOrgIds": [
              "EXO.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa ukawizera wandu, “Mjikumbuke ituku iji, ijo morefumieghe Misri, andu morekoghe wuzumbenyi. Kwa kukaia BWANA oremfunyireghe aho kwa ndighi rake mbaa. Msakeja mikate iko na chachu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.3",
            "verseOrgIds": [
              "EXO.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Idime iji muafuma Misri, ituku ja imbiri ja mori ghwa Abibu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.4",
            "verseOrgIds": [
              "EXO.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "BWANA ukameria kumreda isanga ja Wakanaani, Wahiti, Waamori, Wahivi, na Wajebusi, ijo orewighemieghe weke ndeyo kukaia uchawineka, isanga jinorie nandighi; mchakaia mkibonya wudumiki ughu andenyi ya ughu mori. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.5",
            "verseOrgIds": [
              "EXO.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mchaja mikate isewadie chachu kwa matuku mfungade. Ituku ja mfungade mchakaia na ndima ya BWANA. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.6",
            "verseOrgIds": [
              "EXO.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mseje mkate ghuko na chachu kwa matuku mfungade; mkate ghwa chachu ghusewoneke kwako, hata chachu isewoneke andenyi ya isanga jako jose. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.7",
            "verseOrgIds": [
              "EXO.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ituku jija kuchamzera mwana wako wa womi, ‘Ni kwa wundu ghwa ijo BWANA orenibonyereghe iji nerefumagha Misri.’ ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.8",
            "verseOrgIds": [
              "EXO.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mawiko agha ghichakaia lukumbuso, sa kilambo chifungilo kikoto na wushunyi kwako; kupate kuiwadia Sharia ya BWANA, angu orekufunyireghe Misri kwa ndighi mbaa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.9",
            "verseOrgIds": [
              "EXO.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa huwu kula mwaka mchaghuwadia momu ughu na kughukatisha kwa ngelo yaro iwikilo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.10",
            "verseOrgIds": [
              "EXO.13.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mvalwa wa imbiri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.10",
            "verseOrgIds": [
              "EXO.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Iji BWANA wakureda isanga ja Wakanaani, seji orekughemieghe oho na weke ndeyo; nao ukuneke, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.11",
            "verseOrgIds": [
              "EXO.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuchammbikia mbai kula mvalwa wa imbiri. Wavalwa wa imbiri wa mfugho rako ra womi wichakaia wa BWANA.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.12",
            "verseOrgIds": [
              "EXO.13.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.34.19+EXO.34.20"
              },
              "items": [
                {
                  "text": "Kuf. 34.19-20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.2.23"
              },
              "items": [
                {
                  "text": "Lk. 2.23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.12",
            "verseOrgIds": [
              "EXO.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kula mvalwa wa imbiri wa punda kuchamkombua na mwana wa ng'ondi, nako iji kusemkombuagha, kuchamchikanya singo yake. Kula mvalwa wa imbiri wa wana wako wa womi, kuchamkombua. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.13",
            "verseOrgIds": [
              "EXO.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Matuku ghichagha, mwana wako wa womi ukakukotia kutambua kwaro agho mawiko, kuchamzera, ‘Derefunyiroghe wuzumbenyi Misri ni BWANA, kwa ndighi mbaa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.14",
            "verseOrgIds": [
              "EXO.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iji Farao orekurishireghe ngolo, na kulegha kudisigha dighende, BWANA orewibwaghieghe wavalwa wa imbiri wose wa isanga ja Misri; mvalwa wa imbiri wa mdamu na mvalwa wa imbiri wa nyamandu wori. Kwa huwu dadamfunyira BWANA kizongona cha wavalwa wa imbiri wa womi wose; ela wavalwa wa imbiri wa wana wedu wa womi dadawikombua.’ ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.15",
            "verseOrgIds": [
              "EXO.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mawiko agha ghichakaia lukumbuso sa kilambo chifungilo kikoto na wushunyi kwako; kwa kukaia BWANA orekufunyireghe Misri kwa ndighi mbaa.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.16",
            "verseOrgIds": [
              "EXO.13.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nguro ya iwungu na nguro ya modo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.16",
            "verseOrgIds": [
              "EXO.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hata iji Farao wameria kuwisigha awo wandu wighende, Mlungu nderewimarishireghe chia ya isanga ja Wafilisti, hata ngera niyo erekoghe ya kaavui; angu Mlungu oreghambieghe, “Wandu awa wisecheghaluka na kuwuya Misri ngelo wakwana na wuda ghungi.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.17",
            "verseOrgIds": [
              "EXO.13.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa huwo Mlungu ukawimarisha chia ya kireti kulangaya cha Bahari ya Shamu. Wandu wa Israeli wikafuma Misri wiko tayari kwa wuda. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.18",
            "verseOrgIds": [
              "EXO.13.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa ukadwa maindi gha Josefu, kwa kukaia Josefu orewibonyereghe wandu wa Israeli ighemi ukighamba, “Mlungu uchamchea kumkira, nenyo suti mughido maindi ghapo kufuma aha.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.19",
            "verseOrgIds": [
              "EXO.13.19"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.50.25"
              },
              "items": [
                {
                  "text": "Kuz. 50.25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.24.32"
              },
              "items": [
                {
                  "text": "Jos. 24.32",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.19",
            "verseOrgIds": [
              "EXO.13.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waisraeli wikafuma Sukothi na kubonya kambi Ethamu, mwanonyi ghwa kireti. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.20",
            "verseOrgIds": [
              "EXO.13.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "BWANA ukakiria kuwiwonyera chia; na dime, andenyi ya nguro ya iwungu, na nakio andenyi ya nguro ya modo ghowineka mwengere, wipate kudamba nadime hata na nakio wori. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.21",
            "verseOrgIds": [
              "EXO.13.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 13:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyo nguro ya iwingu ndeereinjikieghe nadime hata iyo nguro ya modo ndeereinjikieghe nakio imbiri ya awo wandu anduangi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.22",
            "verseOrgIds": [
              "EXO.13.22"
            ]
          }
        }
      ]
    }
  ],
