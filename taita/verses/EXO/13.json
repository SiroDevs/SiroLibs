      },
      "items": [
        {
          "text": "Wavalwa wa imbiri kuwikwa kwa BWANA",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
