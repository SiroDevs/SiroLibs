            "sid": "EXO 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "BWANA ukamzera Musa ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.1",
            "verseOrgIds": [
              "EXO.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kuniwikie kula mvalwa wa imbiri. Mvalwa wa imbiri uo ose andenyi ja Israeli; ukaiagha ni mdamu angu nyamandu, uchawuya wapo.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.2",
            "verseOrgIds": [
              "EXO.13.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
