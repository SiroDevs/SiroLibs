          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kusakekaia na milungu mizima imbiri kwapo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.3",
            "verseOrgIds": [
              "EXO.20.3"
            ]
          }
        }
      ]
    },
