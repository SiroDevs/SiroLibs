              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao Mlungu ukaghora malagho agha ghose ukighamba, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.1",
            "verseOrgIds": [
              "EXO.20.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ini ne BWANA Mlungu wako, nerekufunyireghe isanga ja Misri, kufuma wuzumbenyi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.2",
            "verseOrgIds": [
              "EXO.20.2"
            ]
          }
        }
      ]
    },
