            "number": "11",
            "style": "v",
            "sid": "EXO 20:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Angu BWANA oreumbieghe mlungunyi na ndoenyi kwa matuku arandadu, bahari na vose viko andenyi yaro; ukahora ituku ja mfungade. Kwa huwo, BWANA ukajirasimia ituku ja mfungade, ukajielesha.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.11",
            "verseOrgIds": [
              "EXO.20.11"
            ]
