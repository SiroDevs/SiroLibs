          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.24",
            "verseOrgIds": [
              "EXO.7.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 7:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Matuku mfungade ghikaida nyuma ya BWANA kughukaba ugho moda ghwa Naili.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.25",
            "verseOrgIds": [
              "EXO.7.25"
            ]
          }
        }
      ]
    }
