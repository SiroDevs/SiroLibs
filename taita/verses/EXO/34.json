          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kurede mavalo gha imbiri gha mbuwenyi kwako nyumbenyi kwa BWANA Mlungu wako. Kusedoghosanye ndaghina na mariwa gha mae.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.26",
            "verseOrgIds": [
              "EXO.34.26"
            ]
          }
        },
