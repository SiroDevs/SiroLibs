          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kusefunye mkate ghuko na chachu, iji kwakanibwaghia kizongona; na kilambo chingi cherebwaghiloghe kwa Ndima ya Pasaka chisakesigharika hata nakesho.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.25",
            "verseOrgIds": [
              "EXO.34.25"
            ]
          }
        },
        {
