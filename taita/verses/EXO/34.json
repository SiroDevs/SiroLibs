          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Wandu wako wa womi wichacha kunitasa mando adadu kwa mwaka, Ini BWANA Mlungu, wa Israeli. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.23",
            "verseOrgIds": [
              "EXO.34.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 34:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngameria kuriwinga mbari rose imbiri konyu, na kushabua mano enyu, ndekuchaakaia na mndungi omngiria na kumsima iji muko mkinitasa na kuwika iro Ndima idadu kula mwaka.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.24",
            "verseOrgIds": [
              "EXO.34.24"
            ]
          }
        }
      ]
    },
