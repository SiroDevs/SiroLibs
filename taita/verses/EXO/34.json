          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mwana wa womi wa imbiri, na nyamandu efughwa ya womi ya imbiri, richakaia rapo;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.19",
