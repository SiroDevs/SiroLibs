            "sid": "MAL 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "BWANA Uwadie-Ndighi-Rose watumbulia, “Nichamduma mdumwa wapo, upate kuboisa chia imbiri kwapo, na uo BWANA mwawuyamsuwiria uchacha ghafla andenyi ya Hekalu yake. Uo mdumwa mwawuyamsuwiria uchacha na kueresha ilaghano japo.”",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.1",
            "verseOrgIds": [
              "MAL.3.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
