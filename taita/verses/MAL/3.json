                "loc": "MAT.11.10"
              },
              "items": [
                {
                  "text": "Mat. 11.10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.1.2"
              },
              "items": [
                {
                  "text": "Mk. 1.2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
