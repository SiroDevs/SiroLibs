                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAL 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.1",
            "verseOrgIds": [
              "MAL.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAL 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ela nani udimagha kurumaghia ituku ja kucha kwake? Nani udimagha kukaia moyo ngelo wawoneka? Kwa kukaia uchakaia sa sabuni ieleshagha, sa ghuja modo ghwa mchani vuma ghueleshagha vuma.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.2",
            "verseOrgIds": [
              "MAL.3.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOL.2.11"
              },
              "items": [
                {
                  "text": "Joe. 2.11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.6.17"
              },
              "items": [
                {
                  "text": "Wuf. 6.17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.2",
            "verseOrgIds": [
              "MAL.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAL 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uchacha kutanya sa mundu ueleshagha feza. Mdumwa wa BWANA uchawielesha wakohani sa mchani vuma ueleshagha feza na dhahabu wipate kumfunyira mafunyo ghiboie. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.3",
            "verseOrgIds": [
              "MAL.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAL 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niko mafunyo ghichaafunywa ni wandu wa Juda na Jerusalemu ghichaam'boia BWANA sa kala.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.4",
            "verseOrgIds": [
              "MAL.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAL 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.4",
            "verseOrgIds": [
              "MAL.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAL 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "BWANA Uwadie-Ndighi-Rose waghamba, “Niko aho nichamchea kaavui kumtanya, nani nichakaia wa shwa-shwa kushuhudia aighu ya walaghui, na walaki, na awo wighemagha kwa tee, na awo wikitagha wapakazi na malipo ghawo, na waka wakiwa, na wana wakiwa, na awo wilaghashagha hachi ya mghenyi, wiseniobuagha ini.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.5",
            "verseOrgIds": [
              "MAL.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Malipo gha ifungu ja ikumi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAL 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.5",
            "verseOrgIds": [
              "MAL.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAL 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ini ne BWANA sighalukagha. Na inyo ee kivalwa cha Jakobo, ndemchaamerelwa putu anduangi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.6",
            "verseOrgIds": [
              "MAL.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAL 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwaghalukie mkarisigha sharia rapo sa weke ndeyo werekoghe imbiri konyu, hata ndemoreriwadieghe anduangi. Wuyenyi kwapo nani nichammburia. Ela mwaawuyakotia, ‘Dibonya wada ima dikuwurie?’ ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.7",
            "verseOrgIds": [
              "MAL.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAL 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Welee, mdamu wadima kumuiwia Mlungu? Ela inyo mwaawuyaniiwia, na kughamba, ‘Dawuyakuiwia wada?’ Ni kwa wundu ghwa ifungu jenyu ja ikumi na mafunyo ghenyu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.8",
            "verseOrgIds": [
              "MAL.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAL 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inyo mmbose mbari yose moowadwa ni njowe, angu mwawuyaniiwia. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.9",
            "verseOrgIds": [
              "MAL.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAL 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Redenyi ifungu ja ikumi jose Hekalunyi, vindo vipate kuchua aho. Nitimenyi kwa chia iyo, mmbone ngera simrughuyagha madirisha gha mlungunyi, na kumdiria marasimio gha vindo vingi.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.10",
            "verseOrgIds": [
              "MAL.3.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.27.30"
              },
              "items": [
                {
                  "text": "Wal. 27.30",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.18.21+NUM.18.22+NUM.18.23+NUM.18.24"
              },
              "items": [
                {
                  "text": "Mit. 18.21-24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.12.6"
              },
              "items": [
                {
                  "text": "Wuk. 12.6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.14.22+DEU.14.23+DEU.14.24+DEU.14.25+DEU.14.26+DEU.14.27+DEU.14.28+DEU.14.29"
              },
              "items": [
                {
                  "text": "14.22-29",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.13.12"
              },
              "items": [
                {
                  "text": "Neh. 13.12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.10",
            "verseOrgIds": [
              "MAL.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAL 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nichakemia nyamandu na shimandu rijagha vindo venyu, eri risenone mavalo ghenyu gha mbuwenyi na mizabibu yenyu ichava zabibu kwa wungi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.11",
            "verseOrgIds": [
              "MAL.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAL 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niko aho mbari rose ra wandu wichammbanga warasimilwa kwa wundu ghokaia na isanga jiboie.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.12",
            "verseOrgIds": [
              "MAL.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mlungu kulaghira kufuya wughoma",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAL 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.12",
            "verseOrgIds": [
              "MAL.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAL 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mwadedie kiwiwi aighu yapo, Ela sena mwaawuyaghamba, ‘Dadedie kiwiwi aighu yako wada?’ ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.13",
            "verseOrgIds": [
              "MAL.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAL 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inyo mwaghambie, ‘Ni duu kumdumikia BWANA. Eko fwaidaki ewadia malaghiro ghake na kughenda dikihea imbiri kwake kwa agho dighibonyere? ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.14",
            "verseOrgIds": [
              "MAL.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAL 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Seji diwonie, wandu wikukasire niwo wawuyawona nicha. Wandu wawiwi ndewiwonagha nicha tu, ela hata iji wamtima Mlungu kwa uko kurumaghia kwake, wafufunuka wisepatiro ni ilagho jingi.’”",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.15",
            "verseOrgIds": [
              "MAL.3.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAL 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.15",
            "verseOrgIds": [
              "MAL.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAL 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niko awo wandu wimuobuagha BWANA wikadedanya, na BWANA ukawisikiria; ukasikira malagho werekoghe wikighora imbiri kwake. Chuo cha wukumbuso ghwa awo weremuobuagha BWANA na kumneka ishima chikaandikwa. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.16",
            "verseOrgIds": [
              "MAL.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAL 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "BWANA Uwadie-Ndighi-Rose waghamba, “Wichawuya wandu wapo ituku jija nichaabonya maza iro; wichakaia wapo weni. Nichawifuya wughoma seji ndee mwana umfuyagha wughoma mwana wake umdumikiagha. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.17",
            "verseOrgIds": [
              "MAL.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAL 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niko aho mchaamanya kuwitambua awo wiko na hachi na awo wawiwi; aghadi ya uo unidumikiagha, na uo usenidumikiagha.”",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.18",
            "verseOrgIds": [
              "MAL.3.18"
            ]
          }
        }
      ]
    }
  ],
