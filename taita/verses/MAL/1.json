        },
        {
          "text": "Iji ni ilagho ja BWANA oremnekieghe Malaki uwighorie wandu wa Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.1",
            "verseOrgIds": [
              "MAL.1.1"
            ]
