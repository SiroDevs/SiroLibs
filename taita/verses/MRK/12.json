              "items": [
                {
                  "text": "Kuf. 3.6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.26",
            "verseOrgIds": [
              "MRK.12.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MRK 12:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao moni ndekaiagha Mlungu wa wafu anduangi, ela wa awa wiko moyo. Mwakosa nandighi inyo.”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.27",
            "verseOrgIds": [
              "MRK.12.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Momu m'baa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MRK 12:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.27",
            "verseOrgIds": [
              "MRK.12.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MRK 12:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao umu wa walimu wa Sharia ukacha, ukasikira sa iji werekoghe wikimkotia, nao ukimanya angu wawitumbulia nicha, ukamkotia Jesu, “Welee, aghadi ya memu yose, ughu ghuchumbie ni ghuao?”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.28",
            "verseOrgIds": [
              "MRK.12.28"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.10.25+LUK.10.26+LUK.10.27+LUK.10.28"
              },
              "items": [
                {
                  "text": "Lk. 10.25-28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.28",
            "verseOrgIds": [
              "MRK.12.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MRK 12:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu ukamtumbulia, “Momu ghwa imbiri nigho ughu: ‘Sikira Israeli! Bwana Mlungu odu ni Bwana umweri.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.29",
            "verseOrgIds": [
              "MRK.12.29"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.6.4+DEU.6.5"
              },
              "items": [
                {
                  "text": "Wuk. 6.4-5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.29",
            "verseOrgIds": [
              "MRK.12.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MRK 12:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumkunde Bwana Mlungu wako kwa ngolo yako yose, kwa roho yako yose, kwa akili rako rose na kwa ndighi rako rose.’ ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.30",
            "verseOrgIds": [
              "MRK.12.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MRK 12:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ghwa kawi nigho ughu: ‘Kumkunde mmbenyu sa iji koni kukukunde kumoni.’ Ndeghuko momu ghungi mzima ghuchumbagha memu ihi anduangi.”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.31",
            "verseOrgIds": [
              "MRK.12.31"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.19.18"
              },
              "items": [
                {
                  "text": "Wal. 19.18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.31",
            "verseOrgIds": [
              "MRK.12.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MRK 12:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uja mwalimu wa Sharia ukamzera, “Ni loli mwalimu, kwaghora nicha angu Mlungu ni umweri, hata ndekuwadie mzima anduangi, ela uo moni.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.32",
            "verseOrgIds": [
              "MRK.12.32"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.4.35"
              },
              "items": [
                {
                  "text": "Wuk. 4.35",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.32",
            "verseOrgIds": [
              "MRK.12.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MRK 12:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kumkunda kwa ngolo yose, na kwa akili rose, na kwa ndighi rose, na kumkunda mmbenyu sa iji kukukunde kumoni, kwachumba putu vizongona vose.”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.33",
            "verseOrgIds": [
              "MRK.12.33"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HOS.6.6"
              },
              "items": [
                {
                  "text": "Hos. 6.6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.33",
            "verseOrgIds": [
              "MRK.12.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MRK 12:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao Jesu iji wawona seji waghora kwa akili, ukamzera, “Oho ndekuko kula na Wuzuri ghwa Mlungu anduangi.” Na kufuma aho, mndungi nderedimieghe sena kumkotia ilagho jingi anduangi.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.34",
            "verseOrgIds": [
              "MRK.12.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ikoto aighu ya Kristo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MRK 12:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.34",
            "verseOrgIds": [
              "MRK.12.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MRK 12:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao Jesu ukifundisha Hekalunyi, ukakotia, “Welee, yakaia wada kwa walimu wa Sharia kughamba wei Kristo ni mwana wa Daudi? ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.35",
            "verseOrgIds": [
              "MRK.12.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MRK 12:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi moni kwa Roho Mweli oreghorieghe:",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.36",
            "verseOrgIds": [
              "MRK.12.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jesu kuonya aighu ya walimu wa Sharia",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MRK 12:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.37",
            "verseOrgIds": [
              "MRK.12.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MRK 12:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao Jesu ukifundisha, ukaghamba, “Manyenyi walimu wa Sharia, awa wikundagha kusela na nguwo ndacha, na kurogholwa masokonyi, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.38",
            "verseOrgIds": [
              "MRK.12.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "MRK 12:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "na kuseria vifumbi va imbiri sunagoginyi, na malalo gha imbiri karamunyi. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.39",
            "verseOrgIds": [
              "MRK.12.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "MRK 12:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awa niwo wandu wiwijagha waka wakiwa, sena wikilomba malombi mengi wipate kukaswa. Awa wichapata kutanywa kubaa.”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.40",
            "verseOrgIds": [
              "MRK.12.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mafunyo gha muka mkiwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "MRK 12:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.40",
            "verseOrgIds": [
              "MRK.12.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "MRK 12:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu ukasea kidombo kaavui na isanduku jekumbiria mafunyo, ukizighana sa iji izungu jikumbagha mafunyo andenyi ya jija isanduku. Wandu wengi wiko na mali, wikakumba pesa nyingi. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.41",
            "verseOrgIds": [
              "MRK.12.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "MRK 12:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aho, ukacha muka umu mkiwa ufuilo ni mumi wake, ukakumba pesa iwi ra shaba, naro rakatana na senti ikumi. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.42",
            "verseOrgIds": [
              "MRK.12.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "MRK 12:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu ukawiwanga wanughi wake, ukawizera, “Namghoria loli, uhu muka mkiwa ufuilo ni mumi wake, wafunya nyingi kuchumba wose wakumba pesa isandukunyi. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.43",
            "verseOrgIds": [
              "MRK.12.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "MRK 12:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Angu awa wose waafunya masighariko gha wungi ghwa mali rawo, ela uo, kwa wukiwa ghwake, wafunya rose uko naro; najo ni irangi jake jose.”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.44",
            "verseOrgIds": [
              "MRK.12.44"
            ]
          }
        }
      ]
    }
