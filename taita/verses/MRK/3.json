              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.29",
            "verseOrgIds": [
              "MRK.3.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MRK 3:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Jesu oreghorieghe huwo angu weremzerieghe wei, “Wawadie pepo ya makakala.”)",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.30",
            "verseOrgIds": [
              "MRK.3.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mae Jesu na waruna",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MRK 3:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.30",
            "verseOrgIds": [
              "MRK.3.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MRK 3:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao mae Jesu na waruna, wikamchea; nawo wikakaia kimusi shighadi, wikamdumia mundu ummbange. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.31",
            "verseOrgIds": [
              "MRK.3.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MRK 3:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na izungu jiko kidombo jammaria chia rose, wikamzera, “Mayo na wanyinyu weko shighadi, wawuyakulola.” ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.32",
            "verseOrgIds": [
              "MRK.3.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MRK 3:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu ukawitumbulia, “Mao na wanidu ni weke ani?” ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.33",
            "verseOrgIds": [
              "MRK.3.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MRK 3:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aho ukawizighana awo weremmarieghe chia rose, ukaghamba, “Zighanenyi! Awa niwo mao na wanidu. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.34",
            "verseOrgIds": [
              "MRK.3.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MRK 3:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Angu uo ose ulubonyagha lukundo lwa Mlungu, nuo moni mwanidu wa womi, na mwanidu wa waka na mao.”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.35",
            "verseOrgIds": [
              "MRK.3.35"
            ]
          }
        }
      ]
    }
