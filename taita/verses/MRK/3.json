          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mndungi ndedimagha kungia nyumba ya mundu uwadie ndighi, na kuwusa mali rake, ngera usemfungie kande uo mundu, niko aho uchaamsoka mali rake.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.27",
            "verseOrgIds": [
              "MRK.3.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
