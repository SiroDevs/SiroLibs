            "number": "27",
            "style": "v",
            "sid": "MRK 3:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.27",
            "verseOrgIds": [
              "MRK.3.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MRK 3:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Namghoria loli, wadamu wichalekwa kaung'a rawo rose, na masholio ghawo ghose; ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.28",
            "verseOrgIds": [
              "MRK.3.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MRK 3:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "ela uo uchaamsholia Roho Mweli, na jingi ndechaalekelwa anduangi; angu wabonya kaung'a iduagha kwa kala na kala.”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.29",
            "verseOrgIds": [
              "MRK.3.29"
            ]
          }
        },
