            "number": "22",
            "style": "v",
            "sid": "EZK 44:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakohani wiselowuo muka ufuilo angu uleghelo; ela wichalowua wai wa wandu wa Israeli, angu muka ufuilo ni mumi uko mkohani.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.22",
            "verseOrgIds": [
              "EZK.44.22"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.21.7"
              },
              "items": [
                {
                  "text": "Wal. 21.7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.21.13+LEV.21.14"
              },
              "items": [
                {
                  "text": "13-14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.22",
            "verseOrgIds": [
              "EZK.44.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
