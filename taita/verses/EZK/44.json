              "type": "tag",
              "attrs": {
                "loc": "NUM.18.20"
              },
              "items": [
                {
                  "text": "Mit. 18.20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.28",
            "verseOrgIds": [
              "EZK.44.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EZK 44:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wichaja vizongona va viro, na vizongona vifunyiro kwa wundu ghwa kaung'a, na mafunyo kwa wundu ghwa makosa, na kula kilambo cha Waisraeli chifunyiro kwa Mlungu chichakaia chawo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.29",
            "verseOrgIds": [
              "EZK.44.29"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
