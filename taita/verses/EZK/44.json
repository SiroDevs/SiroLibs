          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Wakohani ndewichaakaia na ifwa jingi; ini nimoni nichakaia ifwa jawo, nenyo ndemchaawiwaghia ifwa jingi andenyi ya Israeli; kwa kukaia, ini nichakaia ifwa jawo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.28",
            "verseOrgIds": [
              "EZK.44.28"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
