              },
              "items": [
                {
                  "text": "Mit. 18.8-19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.29",
            "verseOrgIds": [
              "EZK.44.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EZK 44:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mavalo gha imbiri gha makuwido ghose gha mbari rose, na mafunyo gha mbari rose gha mafunyo ghako ghichawuya gha wakohani; na vindo vako va imbiri kwavideka, kuchamneka mkohani; eri marasimio ghiduo nyumbenyi kwako. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.30",
            "verseOrgIds": [
              "EZK.44.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EZK 44:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakohani ndewichaaja kindo chingi chifue cheni ikaiagha ni nyonyi angu nyamandu, hata ngera eebwaghwa ni mmbao.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.31",
            "verseOrgIds": [
              "EZK.44.31"
            ]
          }
        },
