              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niko ukanidwa cha mbengenyi ya kaskazinyi; ukaipima, nayo erekoghe na vipimo vija veni va wambao. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.35",
