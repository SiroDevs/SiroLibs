              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niko ukanidwa cha waza ya ndenyi, chia ya mashariki; ukaipima iyo mbenge; nayo erekoghe na vipimo vija veni va wambao. ",
          "type": "text",
          "attrs": {
