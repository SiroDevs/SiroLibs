            }
          ]
        },
        {
          "text": "Niko ukanireda kufuma shighadi, na kuningira andenyi ya waza ya nandenyi. Ngawona vumba viwi andenyi ya iyo waza, chimu cherekoghe chia ya mbenge ya kaskazinyi ilangayagha cha kusinyi, na chimu cherekoghe chia ya kusinyi ilangayagha cha kaskazinyi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.44",
            "verseOrgIds": [
              "EZK.40.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "EZK 40:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao ukanizera, Ichi chumba chilangayagha cha kusinyi ni cha wakohani awo widumikagha Hekalunyi; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.45",
