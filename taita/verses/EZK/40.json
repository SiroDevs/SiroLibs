          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niko ukanidwa cha waza ya ndenyi chia ya kusinyi, ukaipima iyo mbenge ya kusinyi, nayo ikawoneka ikatane na wambao. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.28",
            "verseOrgIds": [
