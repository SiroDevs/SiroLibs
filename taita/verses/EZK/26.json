              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ituku ja imbiri ja mori, mwaka ghwa ikumi na imweri ghwa kubarishwa kodu, BWANA oreghorieghe nani ukighamba,",
          "type": "text",
          "attrs": {
