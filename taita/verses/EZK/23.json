          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwana MLUNGU waghamba huwu: “Kuchanywa kikombe cha mwanyinyu kibaa chiko ndenyi,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.32",
            "verseOrgIds": [
              "EZK.23.32"
            ]
          }
        }
