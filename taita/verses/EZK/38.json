      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Gogu kukaia sa chombo cha Mlungu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
