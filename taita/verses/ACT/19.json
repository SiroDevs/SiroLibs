                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.3.16"
              },
              "items": [
                {
                  "text": "16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.1.26+JHN.1.27"
              },
              "items": [
                {
                  "text": "Joh. 1.26-27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.4",
            "verseOrgIds": [
              "ACT.19.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wiendasikira huwo, wikabaputizwa kwa irina ja Bwana Jesu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.5",
            "verseOrgIds": [
              "ACT.19.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hata iji Paulo wawiwikiria mikonu, Roho Mweli ukawichea; nawo wikadeda na viteto vizima na kughora ilagho ja Mlungu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.6",
            "verseOrgIds": [
              "ACT.19.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Werekoghe sa wandu ikumi na wawi.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.7",
            "verseOrgIds": [
              "ACT.19.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.7",
            "verseOrgIds": [
              "ACT.19.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao Paulo ukakaia ukingia andenyi ya sunagogi na kwa meri idadu, orekoghe ukighora na wandu kwa wuwana, ukivoya na kukotiana malagho nawo aighu ya Wuzuri ghwa Mlungu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.8",
            "verseOrgIds": [
              "ACT.19.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ela iji wamenya na kulegha kurumiria, wikiidedia kiwiwi Chia ya Bwana imbiri ya wandu, Paulo ukawisigha; ukadwa awo wanughi, na kula ituku ukakotiana nawo malagho andenyi ya nyumba ekwania ya Turano. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.9",
            "verseOrgIds": [
              "ACT.19.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukadua ukibonya huwo miaka iwi, na wandu wose wa Asia wikajisikira ilagho ja Bwana, Wayahudi na Wagriki wori.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.10",
            "verseOrgIds": [
              "ACT.19.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Wana wa Skeva",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.10",
            "verseOrgIds": [
              "ACT.19.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mlungu orekoghe ukibonya weke mwakilimbiti wabaa kwa kumtumia Paulo; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.11",
            "verseOrgIds": [
              "ACT.19.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "hata vitambaa na nguwo rake orekoghe ukirwa verekoghe vikidwailwa wakongo nawo wikaboa, na awo werekoghe na pepo rizamie rikawifuma. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.12",
            "verseOrgIds": [
              "ACT.19.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niko Wayahudi wamu werekoghe wikimara-mara na kuwinga pepo rizamie kwa maghanga, wikazoya kujitumia irina ja Bwana Jesu kwa awo werekoghe na pepo rizamie wikighamba, “Nakulaghira kwa irina ja Jesu uo uchilwagha ni Paulo.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.13",
            "verseOrgIds": [
              "ACT.19.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na wana wa womi mfungade wa Mkohani M'baa wa Kiyahudi uwangwagha Skeva werekoghe wikibonya huwo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.14",
            "verseOrgIds": [
              "ACT.19.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ela ija pepo izamie ikawitumbulia, “Jesu namwichi, na Paulo namwichi, ela inyo mo weke ani?” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.15",
            "verseOrgIds": [
              "ACT.19.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao uja mundu orekoghe na pepo ukawiramia, ukawiwada wose na kuwichumba ndighi, wikafuma nyumba ija na iseghe wisene nguwo, wameria kushoghonolwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.16",
            "verseOrgIds": [
              "ACT.19.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilagho iji jikamanyika kwa wandu wose werekoghe Efeso, Wayahudi na Wagriki, nawo wose wikangilwa ni wowa; na irina ja Bwana Jesu jikakaswa. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.17",
            "verseOrgIds": [
              "ACT.19.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na wengi wa awo wererumirieghe wikacha wikirumiria na kughora mabonyo ghawo worinyi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.18",
            "verseOrgIds": [
              "ACT.19.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 19:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na wengi wa awo werekoghe wikibonya maza ra wusawi, wikareda vuo vawo chia imweri, wikavikora imbiri ya wandu wose; wikatala zoghori yaro ikavika vibelele va feza elfu mirongo misanu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.19",
            "verseOrgIds": [
              "ACT.19.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 19:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niko huwu ilagho ja Bwana jikazoghua na kupata ndighi.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.20",
            "verseOrgIds": [
              "ACT.19.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nganyi andenyi ya muzi ghwa Efeso",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 19:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.20",
            "verseOrgIds": [
              "ACT.19.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 19:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyuma ya maza iro, Paulo ukawona ughende Jerusalemu ukiidia Makedonia, na Akaya. Ukaghamba, “Ngameria kuvika aho, suti niwone Roma wori.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.21",
            "verseOrgIds": [
              "ACT.19.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 19:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukawiduma wawi wa watesia wake Timotheo na Erasto, wighende Makedonia; na uo moni ukasigharika ahoeni Asia kwa ngelo ndini.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.22",
            "verseOrgIds": [
              "ACT.19.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 19:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.22",
            "verseOrgIds": [
              "ACT.19.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 19:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sa ngelo iyo cheni, korewukieghe wasi m'baa Efeso kwa wundu ghwa Chia ya Bwana. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.23",
            "verseOrgIds": [
              "ACT.19.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 19:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Angu mndumu uwangwagha Demetrio mchani feza, orekoghe ukibonya vihekalu va mlungu ghwa waka ghuwangwagha Aritemi, ukawiredia mafundi fwaida mbaa. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.24",
            "verseOrgIds": [
              "ACT.19.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 19:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao ukawiwanga mafundi ghose, andwamweri na wandu wazima wiko na kazi sa yawo, ukaghamba, “Ewomi, mwamanya angu kushama kodu kwaawuyafumanya na kazi ihi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.25",
            "verseOrgIds": [
              "ACT.19.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 19:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nenyo mwawona na kusikira si aha Efeso kuekeri, ela na Asia yose; seji uhu Paulo wakumba wandu wurumu na kuwighalusa wandu wengi, ukighamba wei milungu ibonywagha ni mikonu ya wandu si milungu ingi anduangi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.26",
            "verseOrgIds": [
              "ACT.19.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ACT 19:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ndengwa yakaia, si kwa wundu ghwa kazi yedu kumenywa, ela hata na hekalu ya ghuja mlungu ghwa waka Aritemi ichawuya kilambo cha kisha; nao moni wori uchaserwa kwa wubaa ghwake; uo utaswagha ni wandu wose wa Asia na wurumwengu mlazi.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.27",
            "verseOrgIds": [
              "ACT.19.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ACT 19:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.27",
            "verseOrgIds": [
              "ACT.19.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 19:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao iji wasikira malagho agho, wikajokwa ni machu loli-loli, wikakema, “Aritemi wa Waefeso ni m'baa!” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.28",
            "verseOrgIds": [
              "ACT.19.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ACT 19:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muzi ghose ghukangia nganyi. Wandu wikawiwada Gayo na Aristariko, wandu wa Makedonia werekoghe wikidambanya na Paulo; wikaghenda nawo na iseghe cha nyumba ya misarigho. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.29",
            "verseOrgIds": [
              "ACT.19.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ACT 19:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paulo moni orekundeghe ungie izungunyi, ela wanughi wikamghiria. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.30",
            "verseOrgIds": [
              "ACT.19.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ACT 19:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na wabaa wamu wa Asia waghenyi wake, wikamvoya usetime kungia andenyi ya nyumba ya misarigho. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.31",
            "verseOrgIds": [
              "ACT.19.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ACT 19:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wandu wamu werekoghe wikikema huwu na wamu wuzima angu izungu ndejeredimieghe kusikirana anduangi; na wandu wengi ndeweremanyireghe niki chawikwanya andwamweri. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.32",
            "verseOrgIds": [
              "ACT.19.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ACT 19:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wamu wikawona wei Alekizanda nuo uko na ilagho angu Wayahudi weremmbikieghe na imbiri. Nao Alekizanda ukawikunyiria mkonu ukikunda kukudederia. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.33",
            "verseOrgIds": [
              "ACT.19.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "ACT 19:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ela wiendamanya uo ni Myahudi, wose kwa lwaka lumweri wikakema kwa masaa awi “Aritemi wa Waefeso ni m'baa!”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.34",
            "verseOrgIds": [
              "ACT.19.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "ACT 19:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.34",
            "verseOrgIds": [
              "ACT.19.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "ACT 19:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao iji muandiki wa muzi wawinyamira wandu, ukaghamba, “Wele wandu wa Efeso, nani useichi kukaia muzi ghwa Efeso nugho mlindiri wa hekalu ya Aritemi m'baa na jija igho jetaswa jerepotokieghe kufuma mlungunyi? ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.35",
            "verseOrgIds": [
              "ACT.19.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "ACT 19:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Idana angu malagho agha ghisedimagha kukanwa, yamfwana kunyama kima hata msebonye ilagho jingi jizamie. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.36",
            "verseOrgIds": [
              "ACT.19.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "ACT 19:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Angu mwawireda awa wandu aha, wiseiwie kindo chingi cha hekalu, hata kusholia mlungu ghodu ghwa waka anduangi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.37",
            "verseOrgIds": [
              "ACT.19.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "ACT 19:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikakaia Demetrio na mafundi weko na ilagho jingi na mndungi, koti reko, na wabaa weko aeni; ndewishitakiane weni na weni. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.38",
            "verseOrgIds": [
              "ACT.19.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "ACT 19:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ela ikakaia muko na ilagho jingi jichumbagha, jichaboiswa ni mwandu ghwa waisanga. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.39",
            "verseOrgIds": [
              "ACT.19.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "ACT 19:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Angu deko ndengonyi eshitakilwa kwa wundu ghwa ihi nganyi ya idime, nesi ndedine ilagho jingi ja hachi jekudederia kwa wundu ghwaro anduangi.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.40",
            "verseOrgIds": [
              "ACT.19.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "ACT 19:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao uendaghora huwo ukafunga mwandu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.41",
            "verseOrgIds": [
              "ACT.19.41"
            ]
          }
        }
      ]
    }
  ],
