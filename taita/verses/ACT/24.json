  "reference": "Mabonyo Gha Wadumi 24",
  "copyright": "PUBLIC DOMAIN",
  "verseCount": 27,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "24",
