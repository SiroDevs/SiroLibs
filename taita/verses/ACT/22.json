        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ACT 22:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ela nakesho, m'baa wa majeshi ukikunda kumanya nicha ni malaghoki Paulo wawuyashitakilwa nagho ni Wayahudi, ukamfungua; ukafunya momu Mkohani M'baa chiaimweri na mwandu ghukwane, ukamreda Paulo na kummbika imbiri kwawo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.30",
            "verseOrgIds": [
              "ACT.22.30"
            ]
          }
        }
      ]
