  "reference": "Mabonyo Gha Wadumi 4",
  "copyright": "PUBLIC DOMAIN",
  "verseCount": 32,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
