              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.25",
            "verseOrgIds": [
              "ACT.13.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 13:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Wanidu, wana wa kichuku cha Abrahamu, nenyo mmbose mumuobuagha Mlungu; ilagho iji ja kukia jederedwa kodu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.26",
            "verseOrgIds": [
              "ACT.13.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ACT 13:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kwa kukaia wandu wikaiagha Jerusalemu na wabaa wawo wiseremmanyireghe nuo Mkiri, hata kutambukilwa ni malagho gha walodi ghishomwagha kula Sabato, wereghikatishireghe agho kwa kumtanya ubwagho. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.27",
            "verseOrgIds": [
              "ACT.13.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 13:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hata ngera ndewerepatireghe ilagho jingi jimfwanagha kufwa, ela wikamlomba Pilato umfunye ubwagho.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.28",
            "verseOrgIds": [
              "ACT.13.28"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.27.22+MAT.27.23"
              },
              "items": [
                {
                  "text": "Mat. 27.22-23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.15.13+MRK.15.14"
              },
              "items": [
                {
                  "text": "Mk. 15.13-14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.23.21+LUK.23.22+LUK.23.23"
              },
              "items": [
                {
                  "text": "Lk. 23.21-23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.19.15"
