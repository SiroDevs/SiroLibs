              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.29",
            "verseOrgIds": [
              "ACT.13.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ACT 13:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ela Mlungu oremrukishireghe kufuma kwa wafu, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.30",
            "verseOrgIds": [
              "ACT.13.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ACT 13:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "na kwa matuku malazi orewoneloghe ni awo werechanyeghe nao kufuma Galilaya hata Jerusalemu, awo idana wiko washahidi wake kwa wandu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.31",
            "verseOrgIds": [
              "ACT.13.31"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.1.3"
              },
              "items": [
                {
                  "text": "Mab. 1.3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.31",
            "verseOrgIds": [
              "ACT.13.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ACT 13:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nesi damredia Ilagho Jiboie, kukaia, ijo Mlungu orewilaghirieghe weke aba, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.32",
            "verseOrgIds": [
              "ACT.13.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ACT 13:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "wadikatishira isi wana wawo kwa kumrukisha Jesu; seji iandikilo wori kwa Zaburi ya kawi:",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.33",
            "verseOrgIds": [
              "ACT.13.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "ACT 13:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.41",
            "verseOrgIds": [
              "ACT.13.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "ACT 13:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao iji werekoghe wikifuma, wandu wikalomba wighorelo malagho agho Sabato ya kawi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.42",
            "verseOrgIds": [
              "ACT.13.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "ACT 13:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikwanyiko jiendasia, Wayahudi wengi na wandu winughie dini ya Kiyahudi wimuobuagha Mlungu, wikanughana na Paulo na Barnaba, nawo wikawija malagho na kuwishashira angu widuo andenyi ya mvono ghwa Mlungu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.43",
            "verseOrgIds": [
              "ACT.13.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "ACT 13:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.43",
            "verseOrgIds": [
              "ACT.13.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "ACT 13:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sabato ya kawi, wandu werekwanyikieghe kaavui muzi ghose kusikira ilagho ja Mlungu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.44",
            "verseOrgIds": [
              "ACT.13.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "ACT 13:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ela iji Wayahudi wajiwona izungu ja wandu wikachulwa ni iriso, wikaghikana malagho gherekoghe ghikighorwa ni Paulo na kumdukana. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.45",
            "verseOrgIds": [
              "ACT.13.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "ACT 13:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hata huwo saki, Paulo na Barnaba wikaghora kwa wuwana wikighamba, “Erekoghe suti ilagho ja Mlungu jighoro konyu kande. Idana angu mwajilegha, na kukutanya inyo mmbeni kukaia wandu msefwane irangi ja kala na kala, olenyi diaghenda kwa wandu wa mbari zima. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.46",
            "verseOrgIds": [
              "ACT.13.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "ACT 13:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Angu niko Bwana udilaghirie ukighamba:",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.47",
            "verseOrgIds": [
              "ACT.13.47"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "ACT 13:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.47",
            "verseOrgIds": [
              "ACT.13.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "ACT 13:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao iji wandu wa mbari zima wasikira huwo, wikaboilwa na kujikasa ilagho ja Mlungu; na awo wose weretaliloghe kukaia wandu wepata irangi ja kala na kala, wikarumiria. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.48",
            "verseOrgIds": [
              "ACT.13.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "ACT 13:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilagho ja Bwana jikaera andu kose isangenyi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.49",
            "verseOrgIds": [
              "ACT.13.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "ACT 13:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ela Wayahudi wikawikumba sheshe waka wa mbari zima wa ishima, wimuobuagha Mlungu, na womi werekoghe vilongozi va muzi. Wikazoya kuwitirira Paulo na Barnaba, na kuwiwinga isangenyi kwawo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.50",
            "verseOrgIds": [
              "ACT.13.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "ACT 13:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paulo na Barnaba wikaghughudua teri ra maghu ghawo, kukaia wushuhuda aighu ya awo wandu, wikaghenda Ikonio.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.51",
            "verseOrgIds": [
              "ACT.13.51"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.10.14"
              },
              "items": [
                {
                  "text": "Mat. 10.14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.6.11"
              },
              "items": [
                {
                  "text": "Mk. 6.11",
                  "type": "text"
                }
              ]
            },
