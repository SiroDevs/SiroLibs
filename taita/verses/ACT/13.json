              },
              "items": [
                {
                  "text": "Mat. 3.11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.1.7"
              },
              "items": [
                {
                  "text": "Mk. 1.7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
