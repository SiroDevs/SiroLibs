        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.6",
            "verseOrgIds": [
              "ECC.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ECC 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwengere ni mucha, na kuwona iruwa kwaboie. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.7",
            "verseOrgIds": [
              "ECC.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ECC 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundu ukakaia moyo miaka mingi, ndefunye chawucha andenyi ya matuku gha irangi jake; ela ukumbuke kukaia uchafwa. Iro naro ni maza ra duu.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.8",
            "verseOrgIds": [
              "ECC.11.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Wandu wa irika kunekwa njama",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
