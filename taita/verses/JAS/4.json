{
  "id": "JAS.4",
  "number": "4",
  "bookId": "JAS",
  "reference": "Jakobo 4",
  "copyright": "PUBLIC DOMAIN",
  "verseCount": 17,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
