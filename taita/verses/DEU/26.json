              "items": [
                {
                  "text": "1 Pet. 2.9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.18",
            "verseOrgIds": [
              "DEU.26.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 26:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ucham'bonya wabaa kuchumba mbari ingi ya wandu uwiumbie, nenyu mchajikasa na kujibonyera ishima irina jake. Mchakaia wandu wake moni, sa iji koni orelaghirieghe.”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.19",
            "verseOrgIds": [
              "DEU.26.19"
            ]
          }
        }
      ]
    }
