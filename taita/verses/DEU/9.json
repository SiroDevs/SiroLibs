        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DEU 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hata iji BWANA oremdumieghe kufuma Kadesh-barnea ukimzera mjoke mjiwuse ijo isanga umnekie moreleghieghe malaghiro gha BWANA Mlungu onyu, mkalegha kumrumiria hata kumsikira lwaka lwake.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.23",
            "verseOrgIds": [
              "DEU.9.23"
            ]
          }
        },
