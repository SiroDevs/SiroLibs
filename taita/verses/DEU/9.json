              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.24",
            "verseOrgIds": [
              "DEU.9.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DEU 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kwa wundu ugho ngaghwa kijimijimi imbiri ya BWANA matuku mirongo ina kio na dime, angu BWANA Mlungu orekundeghe kumtotesha. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.25",
            "verseOrgIds": [
              "DEU.9.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DEU 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngamlomba BWANA, ‘Ee Bwana MLUNGU, kusakewitotesha wandu wako, ifwa jako; awo korewikombueghe kwa ndighi rako mbaa na kudima, kukawifunya Misri. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.26",
            "verseOrgIds": [
              "DEU.9.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DEU 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumbuka mdumiki wako Abrahamu, na Isaaka na Jakobo; kusaketala kughilika kwa awa wandu, hata mawiwi ghawo, na kaung'a yawo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.27",
            "verseOrgIds": [
              "DEU.9.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DEU 9:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wamisri wicheghamba wei BWANA oolemwa ni kuwighenja ijo isanga orewilaghirieghe, na angu wei weemzamia ukawighenja uendewibwagha kireti. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.28",
            "verseOrgIds": [
              "DEU.9.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DEU 9:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Angu awo ni ifwa jako; awo korewifunyireghe kwa ndighi rako mbaa na kwa wusimi ghwako m'baa.’",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.29",
            "verseOrgIds": [
              "DEU.9.29"
            ]
          }
        }
      ]
