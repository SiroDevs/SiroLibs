          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ela ikakaia mndumu wakwana na mwai shighadi ya muzi, na uo mwai wakumbilo wulanga, na uo mundu ummbwade na kulala nao, uo mndwawomi uekeri nuo ubwaghwagha. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.25",
            "verseOrgIds": [
              "DEU.22.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DEU 22:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ela uo mwai msem'bonye ilagho jingi, kwa kukaia ndebonyere ikosa jingi jimfwanagha kufwa; jaafwanana na mundu wawada mmbao na kum'bwagha; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.26",
            "verseOrgIds": [
              "DEU.22.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DEU 22:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwa kukaia oombwadia shighadi ya muzi, na mwai ukakema, ela ndekorekoghe na mndungi omvuvua.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.27",
            "verseOrgIds": [
              "DEU.22.27"
            ]
          }
        }
      ]
    },
