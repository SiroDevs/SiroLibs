              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ngera mndungi wakulwa ukimdidika mwai wakwana nao, na uo mwai ndekumbilo wulanga,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.28",
            "verseOrgIds": [
