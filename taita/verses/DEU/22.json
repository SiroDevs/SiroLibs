              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mundu ukawadwa ukilala na muka wa mundu mzima, wose wichabwaghwa mndwawomi na muka. Na kwa iyo chia, mchainja ugho wuwiwi kwa Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.22",
            "verseOrgIds": [
              "DEU.22.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 22:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
