            "number": "23",
            "style": "v",
            "sid": "DEU 22:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ngera wakaia mwai ungi ukumbilo wulanga, na mndumu ukwane nao andenyi ya muzi na kulala nao, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.23",
            "verseOrgIds": [
              "DEU.22.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 22:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "mchawifunya shighadi wose mbengenyi ya ugho muzi andu kokwania na kuwilasa na magho hata wifo; kwa kukaia uo nderekemieghe ukikunda wutesia, na sena odeeka aeni mzinyi; na uja mundu nao odenonia mmbao muka wake. Na kwa iyo chia mchainja ugho wuwiwi aghadi konyu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.24",
            "verseOrgIds": [
              "DEU.22.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
