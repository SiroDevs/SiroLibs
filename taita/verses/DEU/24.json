        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.16",
            "verseOrgIds": [
              "DEU.24.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 24:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kuselaghashe hachi ya mghenyi omara-mara, hata mwana mkiwa, hata kusewadie nguwo ya mka-mkiwa ikaie wufunga;",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.17",
            "verseOrgIds": [
              "DEU.24.17"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.23.9"
              },
              "items": [
                {
                  "text": "Kuf. 23.9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.19.33+LEV.19.34"
              },
              "items": [
                {
                  "text": "Wal. 19.33-34",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.27.19"
              },
              "items": [
                {
                  "text": "Wuk. 27.19",
                  "type": "text"
                }
              ]
            }
          ]
        },
