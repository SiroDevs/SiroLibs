          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uchabonya wazuri wawo muwisime, nenyo mchawibwagha na kuwimeria hata wiliwike isangenyi; mndungi ndechaadima kumtangala, hata mwameria kuwitotesha. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.24",
            "verseOrgIds": [
              "DEU.7.24"
            ]
          }
        },
        {
          "name": "verse",
