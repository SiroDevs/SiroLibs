              "type": "text"
            }
          ]
        },
        {
          "text": "Ela BWANA Mlungu onyu uchawingira wamaiza wenyu mikonunyi konyu na kuwikambira chongo hata widime watota putu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.23",
            "verseOrgIds": [
              "DEU.7.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
