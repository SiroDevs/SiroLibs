          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mserede ghungi ghwa iyo milimu mizinyi konyu, mchewadwa ni njowe yawo; muimenye putu angu iwasirilo njowe ni Mlungu.",
          "type": "text",
          "attrs": {
