                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.15.23"
              },
              "items": [
                {
                  "text": "15.23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.4",
            "verseOrgIds": [
              "GEN.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngera mndungi wadia bagha enyu, loli nichaikotia angu bagha ni irangi ja mundu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.5",
            "verseOrgIds": [
              "GEN.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mdamu oreumbiloghe kufwanana na Mlungu, kwa huwo uo ose uchaidia bagha ya mdamu, bagha yake ichadilwa ni mdamu wokoni.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.6",
            "verseOrgIds": [
              "GEN.9.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.1.26"
              },
              "items": [
                {
                  "text": "Kuz. 1.26",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.20.13"
              },
              "items": [
                {
                  "text": "Kuf. 20.13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.6",
            "verseOrgIds": [
              "GEN.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na inyo muve mchurikie, muichure ndoe kwa wungi.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.7",
            "verseOrgIds": [
              "GEN.9.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.1.28"
              },
              "items": [
                {
                  "text": "Kuz. 1.28",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.7",
            "verseOrgIds": [
              "GEN.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mlungu ukamzera Nuhu na wana wake, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.8",
            "verseOrgIds": [
              "GEN.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Idana niabonya ilaghano japo nenyo, andwamweri na kivalwa chenyu chichaanugha nyuma, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.9",
            "verseOrgIds": [
              "GEN.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "na icho chose chiko moyo chikwanye andwamweri nenyo: nyonyi, mfugho na nyamandu ra ndoenyi rose rerefumieghe safinenyi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.10",
            "verseOrgIds": [
              "GEN.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabonya ilaghano japo na inyo, angu jingi wori, mimbi yose iko moyo ndeichaatoteshwa kwa machi anduangi, hata na jingi sena ndekuchaakaia na gharika enona wurumwengu anduangi.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.11",
            "verseOrgIds": [
              "GEN.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mlungu ukaghamba, “Ihi niyo alama ya ilaghano nijibonyagha aghadi ya ini na inyo, andwamweri na icho chose chiko moyo, na vivalwa vose vichaanugha nyuma. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.12",
            "verseOrgIds": [
              "GEN.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawika lusenge lwa vua andenyi ya mawingu nalo luchakaia alama ya ilaghano japo nijibonyagha na wurumwengu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.13",
            "verseOrgIds": [
              "GEN.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iji nareda mawingu aighu ndoenyi, na ulo lusenge luwoneke andenyi ya mawingu, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.14",
            "verseOrgIds": [
              "GEN.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "nichakumbuka ilaghano japo jiko aghadi yapo na inyo, na mimbi yose iko moyo, na machi ndeghichaakaia gharika ebwagha mumbi ghungi jingi sena anduangi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.15",
            "verseOrgIds": [
              "GEN.9.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iji lusenge lwadunga andenyi ya mawingu, nichaluzighana kukumbuka ijo ilaghano ja kala na kala jerewikiloghe aghadi ya Mlungu na icho chose chiko moyo chiumbilo, na mimbi yose iko ndoenyi.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.16",
            "verseOrgIds": [
              "GEN.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao Mlungu ukamzera Nuhu, “Ihi niyo alama ya ilaghano najimangisha aghadi yapo na kula mumbi ghuko ndoenyi.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.17",
            "verseOrgIds": [
              "GEN.9.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nuhu na wana wake",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.17",
            "verseOrgIds": [
              "GEN.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wana wa Nuhu awa werefumieghe safinenyi ni Shemu, Hamu, na Jafethi. Hamu orekoghe ndee Kanaani. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.18",
            "verseOrgIds": [
              "GEN.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awa wana wadadu wa Nuhu niwo weni wichurie wandu wurumwengu ghose.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.19",
            "verseOrgIds": [
              "GEN.9.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.19",
            "verseOrgIds": [
              "GEN.9.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuhu nuo orekoghe mundu wa imbiri kuilima ndoe na kuwa mizabibu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.20",
            "verseOrgIds": [
              "GEN.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukanywa divei ukawongia, ukalala andenyi ya hema yake usekufinikire wuduu ghwake. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.21",
            "verseOrgIds": [
              "GEN.9.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hamu, ndee Kanaani, ukammbona ndee uko duu, ukawighoria waja waruna wawi werekoghe shighadi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.22",
            "verseOrgIds": [
              "GEN.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niko Shemu na Jafethi wikawada nguwo, wikaiwikiria maongenyi kwawo, na kughenda kinyuma-nyuma, wikaghufinikira wuduu ghwa ndee, na mawushu ghawo gherekoghe ghikizighana noko, hata ndewereghuwonieghe wuduu ghwa ndee anduangi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.23",
            "verseOrgIds": [
              "GEN.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hata iji Nuhu waelwa ni meso, na kumanya seji mwana wake mtini wam'bonyera, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.24",
            "verseOrgIds": [
              "GEN.9.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "ukaghamba,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.25",
            "verseOrgIds": [
              "GEN.9.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
