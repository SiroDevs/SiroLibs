  "verseCount": 43,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "30",
        "style": "c",
        "sid": "GEN 30"
      },
      "items": [
        {
          "text": "30",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 30:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao iji Raheli orewonieghe angu uo nderemvaieghe Jakobo wana wangi, ukammbonia mruna iriso, ukamzera Jakobo, “Nineke wana! Si huwo nifo noko!” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.1",
            "verseOrgIds": [
              "GEN.30.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 30:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jakobo ukajokwa ni machu loli-loli, ukamzera Raheli, “Welee, ini neeka Mlungu nidimagha kukughiria kuva?” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.2",
            "verseOrgIds": [
              "GEN.30.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 30:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Raheli ukaghamba, “Mwai wapo wa kazi Bilha hoyu, kukanye nao, upate kuvaia mangonyi kwapo, eri nikupatire wana kwa chia yake uo.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.3",
            "verseOrgIds": [
              "GEN.30.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 30:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukamneka uo mwai wake wa kazi Bilha ukaie sa mkake, na Jakobo ukammbusa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.4",
            "verseOrgIds": [
              "GEN.30.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 30:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bilha ukapata kifu, ukamvaia Jakobo mwana wa womi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.5",
            "verseOrgIds": [
              "GEN.30.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 30:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niko Raheli ukaghamba, “Mlungu wanibonyera mecha, sena wasikira kililo chapo ukanineka mwana wa womi.” Kwa huwo ukammbanga Dani. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.6",
            "verseOrgIds": [
              "GEN.30.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 30:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uja mwai wa kazi ukapata kifu sena, ukamvaia Jakobo mwana wa womi wa kawi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.7",
            "verseOrgIds": [
              "GEN.30.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 30:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aho Raheli ukaghamba, “Nasimana na mwanidu kwa kufunga ndighi nani ngasima.” Kwa huwu irina jake ukammbanga Naftali.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.8",
            "verseOrgIds": [
              "GEN.30.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 30:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.8",
            "verseOrgIds": [
              "GEN.30.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 30:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao iji Lea wawona angu waleka kuva, ukamfunya Zilpa mwai wake wa kazi ukamneka Jakobo ukanye nao. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.9",
            "verseOrgIds": [
              "GEN.30.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 30:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao uo Zilpa ukamvaia Jakobo mwana wa womi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.10",
            "verseOrgIds": [
              "GEN.30.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 30:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lea ukaghamba, “Ni bahati iboie.” Ukammbanga irina jake Gadi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.11",
            "verseOrgIds": [
              "GEN.30.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 30:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zilpa ukamvaia Jakobo mwana wa womi sena. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.12",
            "verseOrgIds": [
              "GEN.30.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 30:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lea ukaghamba, “Naboilwa na ndighi! Na waka wichaniwanga Maboilo.” Nao ukammbanga irina jake Asheri.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.13",
            "verseOrgIds": [
              "GEN.30.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 30:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.13",
            "verseOrgIds": [
              "GEN.30.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 30:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao matuku gha kukuwida ngano, Reubeni ukaghenda mbuwenyi, ukawaya tunguja ukamghenjera mae Lea. Raheli ukamzera Lea, “Nakulomba kunineke tunguja rimu ra mwana wako.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.14",
            "verseOrgIds": [
              "GEN.30.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 30:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ela Lea ukatumbulia, “Kuaghesha ni ilagho itini oho kunisoka mumi wapo, na idana sena kwakunda na tunguja ra mwanwapo wori?” Nao Raheli ukaghamba, “Kenyi mwadima kulalanya kwa wundu ghwa tunguja ra mwana wako.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.15",
            "verseOrgIds": [
              "GEN.30.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 30:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.15",
            "verseOrgIds": [
              "GEN.30.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 30:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hata iji Jakobo wacha kufuma mbuwenyi luma lwa kenyi, Lea ukafuma kummara ukighamba, “Ni suti kuche kwapo idime, nakughua na tunguja ra mwanwapo.” Wikalalanya kio chija. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.16",
            "verseOrgIds": [
              "GEN.30.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 30:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao Mlungu ukasikira malombi gha Lea ukapata kifu, ukava mwana wa womi wa kasanu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.17",
            "verseOrgIds": [
              "GEN.30.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 30:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukaghamba, “Mlungu wanilipa, angu nerefunyireghe mwai wa kazi kwa mumi wapo.” Nao ukammbanga irina jake Isakari. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.18",
            "verseOrgIds": [
              "GEN.30.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 30:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lea ukapata kifu sena, ukamvaia Jakobo mwana wa womi wa karandadu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.19",
            "verseOrgIds": [
              "GEN.30.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 30:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukaghamba, “Mlungu wanineka inosi jiboie, idana mumi wapo uchanitala kwa kukaia namvaia wana wa womi warandadu.” Kwa huwu ukammbanga irina jake Zebluni. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.20",
            "verseOrgIds": [
              "GEN.30.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 30:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konyuma ukava mwai, ukammbanga irina jake Dina.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.21",
            "verseOrgIds": [
              "GEN.30.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 30:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.21",
            "verseOrgIds": [
              "GEN.30.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 30:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao Mlungu ukamkumbuka Raheli, ukamsikira kililo chake, ukam'bonya upate wana. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.22",
            "verseOrgIds": [
              "GEN.30.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 30:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao ukapata kifu, ukava mwana wa womi ukaghamba, “Mlungu waniinjira waya ghwapo.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.23",
            "verseOrgIds": [
              "GEN.30.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 30:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukammbanga irina jake Josefu ukighamba, “BWANA ndenichurie mwana umu wa womi.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.24",
            "verseOrgIds": [
              "GEN.30.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jakobo kupatana na Labani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 30:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.24",
            "verseOrgIds": [
              "GEN.30.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 30:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao nyuma ya Raheli kumva Josefu, Jakobo ukamzera Labani, “Idana nisighe nighale, nipate kuwuya mzinyi kwapo na isangenyi japo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.25",
            "verseOrgIds": [
              "GEN.30.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 30:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nineke waka wapo na wana wapo niwipatire kwa kukudumikia, nighende; angu ugho wudumiki nighubonyere kwako kwaghumanya putu.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.26",
            "verseOrgIds": [
              "GEN.30.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 30:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ela Labani ukamzera, “Leka nighore ilagho jimu. Namerie kumanya putu angu BWANA oonirasimia kwa wundu ghwako. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.27",
            "verseOrgIds": [
              "GEN.30.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 30:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Idana ghora ifungu jako na ini nichakulipa.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.28",
            "verseOrgIds": [
              "GEN.30.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 30:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.28",
            "verseOrgIds": [
              "GEN.30.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 30:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao Jakobo ukaghamba, “Oho kumoni kwamanya sa iji nikudumikie, na sa iji mfugho rako rikaie nicha kwa wundu ghwa wulisha ghwapo, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.29",
            "verseOrgIds": [
              "GEN.30.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 30:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwa kukaia kodeeka na mfugho ndinieri ngelo nerechagha, ela idana rachurikia na ndighi, na BWANA ukakurasimia kwa chia iyo yose nereighendieghe; da ni lii nichaabonya ghapo gheni?” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.30",
            "verseOrgIds": [
              "GEN.30.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 30:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukamtumbulia, “Niki kukunde nikuneke?” Jakobo ukatumbulia, “Ndekuchaanineka kindo chingi, ela nichakulishira na kukulindiria mfugho rako iji kwanibonyera huwu: ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.31",
            "verseOrgIds": [
              "GEN.30.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 30:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunisighe niide aghadi ya chagha chako idime, nisaghuo kula ng'ondi na kula mburi riko na virapa-virapa na ra vitaranga, na wana wa ng'ondi wose wa chilu, na ijo nijo jichaakaia ifungu japo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.32",
            "verseOrgIds": [
              "GEN.30.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 30:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niko wuloli ghwapo ghuchaawonyera ghoni konyuma, iji kwachazighana ifungu japo. Mburi ingi iseko na virapa-virapa, angu ya kitaranga, na mwana wa ng'ondi useko wa chilu richaawoneka kwapo richatalika wori reeiwa.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.33",
            "verseOrgIds": [
              "GEN.30.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 30:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.33",
            "verseOrgIds": [
              "GEN.30.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "GEN 30:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Labani ukaghamba, “Niko koni! Ndeikaie woruwo.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.34",
            "verseOrgIds": [
              "GEN.30.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "GEN 30:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ela ituku jija jeni, Labani ukainja fwandi rose riko ra njaria-njaria, na ra vitaranga, na mburi ra waka rose riko ra virapa-virapa na ra vitaranga, na iro rose rerekoghe na maboli gha chokwa, na wana wa ng'ondi wose wa chilu, ukarineka wana wake wirizighaneghe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.35",
            "verseOrgIds": [
              "GEN.30.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "GEN 30:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Labani ukakutanya na Jakobo kwa kughenda charo cha matuku adadu, na Jakobo ukasighwa ukilisha iro mfugho ra Labani reresigharikieghe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.36",
            "verseOrgIds": [
              "GEN.30.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "GEN 30:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.36",
            "verseOrgIds": [
              "GEN.30.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "GEN 30:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao Jakobo ukadema vangu va midi mmbishi ya vichuku vidadu ukaikonua zaria-zaria ipate kuwonyera zaria ra chokwa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.37",
            "verseOrgIds": [
              "GEN.30.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "GEN 30:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukavidunga ivo vangu imbiri ya chagha kiriwenyi, andu mfugho rerekoghe rikinywa machi. Na angu rerekoghe rikidediana ngelo rikinywa machi, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.38",
            "verseOrgIds": [
              "GEN.30.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "GEN 30:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "rikapata vifu rikiwona vija vangu; naro rikava wana wiko wa njaria-njaria na wa virapa-virapa na wa vitaranga.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.39",
            "verseOrgIds": [
              "GEN.30.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "GEN 30:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.39",
            "verseOrgIds": [
              "GEN.30.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "GEN 30:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jakobo ukasaghua ng'ondi kufuma kwa mburi, ukaribonya rilangaye iro ra njaria-njaria na iro ra chilu ra mfugho ra Labani. Kwa chia ihi, ukashama mfugho rake na kuriwika kula na iro ra Labani. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.40",
            "verseOrgIds": [
              "GEN.30.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "GEN 30:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iji iro ribandie rerekoghe rikidediana, Jakobo ukaridungia ivo vangu kiriwenyi, ripate vifu rikivilangaya ivo vangu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.41",
            "verseOrgIds": [
              "GEN.30.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "GEN 30:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ela nderedungieghe ivo vangu imbiri ya iro mfugho ridarume anduangi. Kwa huwo mfugho ridarume rikakaia ra Labani na ribandie rikakaia ra Jakobo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.42",
            "verseOrgIds": [
              "GEN.30.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "GEN 30:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa chia ihi Jakobo ukawuya mzuri loli-loli; ukakaia na mfugho, wadumiki wa womi na wa waka, ngamila na punda.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.43",
            "verseOrgIds": [
              "GEN.30.43"
            ]
          }
        }
