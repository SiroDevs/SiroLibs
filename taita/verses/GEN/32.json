          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao ukamzera, “Irina jako nani?” Ukamtumbulia, “Jakobo.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.27",
            "verseOrgIds": [
              "GEN.32.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 32:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uja mundu ukamzera, “Ndekuchaawangwa Jakobo sena, ela kuchawangwa Israeli, angu kwasimana na Mlungu na wandu kukasima.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.28",
            "verseOrgIds": [
              "GEN.32.28"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
