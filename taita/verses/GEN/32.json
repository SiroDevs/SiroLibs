          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao Jakobo ukakuwanga andu aja Penieli",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.30",
            "verseOrgIds": [
              "GEN.32.30"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "32.30",
              "type": "text"
            },
            {
              "text": "Penieli:",
              "type": "text"
            },
            {
              "text": "Kutambua kwaro ni “Wushu ghwa Mlungu.”",
              "type": "text"
            }
          ]
        },
        {
          "text": " ukighamba, “Angu nammbona Mlungu wushu kwa wushu sena hoku naduagha moyo.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.30",
            "verseOrgIds": [
              "GEN.32.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 32:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iruwa jerekoghe jajoka iji Jakobo orefumagha Penieli, ukaghenda ukitighina kwa wundu ghwa bara yake. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.31",
            "verseOrgIds": [
              "GEN.32.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 32:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa wundu ughu, Waisraeli ndewijagha lugha lwa kiwonu andu lukwaniagha na bara hata linu, angu Jakobo oreadadiroghe lugha lwa bara aja kukwane na kiwonu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.32",
            "verseOrgIds": [
              "GEN.32.32"
            ]
