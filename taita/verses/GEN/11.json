          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abramu na Nahori wikalowua. Muka wa Abramu orewangwaghwa Sarai, na muka wa Nahori orewangwaghwa Milka mwai wa Harani uo orekoghe ndee Isaaka. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.29",
            "verseOrgIds": [
              "GEN.11.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
