          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tera ukafuya isanga ja Harani, mundu wa miaka maghana awi na isanu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.32",
