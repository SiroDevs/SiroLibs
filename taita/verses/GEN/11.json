            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ichi nicho kivalwa cha Tera ndee wake Abramu, Nahori na Harani; Harani oremvaeghe Loti. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.27",
            "verseOrgIds": [
              "GEN.11.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao Harani ukafwa andu orevailoghe kwa ghuja muzi ghwa Uri ghwa Wakaldayo ndee uko moyo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.28",
            "verseOrgIds": [
              "GEN.11.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
