              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iji Tera orekoghe mundu wa miaka mirongo mfungade, orewivaeghe Abramu, Nahori na Harani.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.26",
