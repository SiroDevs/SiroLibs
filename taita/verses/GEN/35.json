              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Matuku gha Isaaka gherekoghe miaka ighana na mirongo wunyanya. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.28",
            "verseOrgIds": [
              "GEN.35.28"
            ]
