          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wana wa Zilpa, mwai wa kazi wa Lea ni: Gadi na Asheri. Awa werekoghe wana wa Jakobo werevailoghe Padan-aramu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.26",
            "verseOrgIds": [
              "GEN.35.26"
            ]
          }
        }
