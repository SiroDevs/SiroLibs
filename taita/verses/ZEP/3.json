              },
              "items": [
                {
                  "text": "Wuf. 14.5",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lumbo lwa maboilo",
          "type": "text"
        }
      ]
    }
