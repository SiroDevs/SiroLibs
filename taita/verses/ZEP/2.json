              "type": "text"
            }
          ]
        },
        {
          "text": "BWANA uchamtotesha Ashuru kwa ndighi rake. Muzi ghwa Nineve ghuchakimbilwa ghuwuye kireti chisena machi.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.13",
