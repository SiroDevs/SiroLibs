              "type": "text"
            }
          ]
        },
        {
          "text": "Huwo niko wandu wa Moabu na Amoni wichaakabwa kwa wundu ghwa lukaso na kukuduka kwawo, na kwa kuwidukana wandu wa BWANA Uwadie-Ndighi-Rose. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.10",
            "verseOrgIds": [
              "ZEP.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ZEP 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "BWANA uchawiobosha. Uchaimeria milungu yawo na kuibonya kukaia si kindo chingi, na kula mbari ichamtasa BWANA isangenyi kwake.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.11",
            "verseOrgIds": [
              "ZEP.2.11"
            ]
          }
        }
      ]
