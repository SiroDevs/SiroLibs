              "type": "text"
            }
          ]
        },
        {
          "text": "Inyo mbari isewadie waya, kwanyikenyi mmbose m'bonye ikwanyiko ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.1",
            "verseOrgIds": [
              "ZEP.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ZEP 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "imbiri mseinjiro sa mafozi ghadukwa ni mbeo, imbiri msechelo ni machu ghibirie gha BWANA, imbiri ijo ituku ja lubio jisechee aighu yenyu. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.2",
            "verseOrgIds": [
              "ZEP.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ZEP 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mghalukienyi BWANA inyo mmbose wandu wa isanga mkuserie, inyo m'bonyagha agho umlaghiragha. Bonyenyi ijo jiko ja hachi, mkusere mmbeni; kewada mwadima kufuilwa wughoma ijo ituku ja lubio lwa BWANA.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.3",
            "verseOrgIds": [
              "ZEP.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kutoteshwa kwa iro mbari riko mbai mbai ya Israeli",
          "type": "text"
        }
      ]
    },
    {
