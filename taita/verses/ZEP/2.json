          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mndungi ndechaasigharika muzi ghwa Gaza. Ashkeloni ichakimbilwa ni wandu. Wandu wa Ashdodi wichafunywa kwa nusu ituku, na wandu wa Ekroni wichafunywa mzinyi kwawo.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.4",
            "verseOrgIds": [
              "ZEP.2.4"
            ]
          }
        },
