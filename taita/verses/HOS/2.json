              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.17",
            "verseOrgIds": [
              "HOS.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "HOS 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ituku ijo nichabonya ilaghano na nyamandu, nyonyi, na shimandu riavuagha andoenyi, kukaia nderichaabonya wandu wapo ilagho jingi. Wokoni nichainja ndana rose na chufu relwa wuda isangenyi na wandu wapo wichakaia banana.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.18",
            "verseOrgIds": [
              "HOS.2.18"
            ]
          }
        }
      ]
    }
