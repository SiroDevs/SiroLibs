              "1CH.5.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 5:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wandu wa nusu ya kichuku chose cha Manase werekoghe wikikaia isangenyi kufuma Bashani hata Baal-herimoni, hata Seiri, hata mghondi ghwa Hermoni; wandu wengi nandighi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.23",
            "verseOrgIds": [
              "1CH.5.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 5:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na wandu awa niwo werekoghe wabaa wa kichuku chawo. Eferi, Ishi, Elieli, Azrieli, Jeremia, Hodavia, na Jahdieli; mang'oni gha wuda, wandu wikumikie, wabaa wa kichuku chawo.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.24",
            "verseOrgIds": [
              "1CH.5.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kubarishwa kwa mbari ya mashariki",
          "type": "text"
        }
      ]
    },
    {
