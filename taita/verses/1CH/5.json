              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ela wikam'bonyera Mlungu wa weke ndee kaung'a; wikamsigha na kunugha milungu ya wandu wa isanga, awo Mlungu orewitoteshereghe imbiri yawo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.25",
            "verseOrgIds": [
              "1CH.5.25"
            ]
          }
        },
        {
          "name": "verse",
