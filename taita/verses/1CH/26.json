      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kazi ra Walawi wazima",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
