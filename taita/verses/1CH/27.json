                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.23",
            "verseOrgIds": [
              "1CH.27.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 27:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joabu uo mae orewangwaghwa Seruaia orekoghe wazoya kuwitala; kwa wundu ugho Waisraeli wikachelwa ni ikabo. Nderedimieghe kumeria mtalo ghwaro, nagho ndeghuchaamanyika hata mtalo ghwaro kuwikwa andenyi ya vuo va Mzuri Daudi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.24",
            "verseOrgIds": [
              "1CH.27.24"
            ]
          }
        },
        {
