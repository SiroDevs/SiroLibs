          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "ela Daudi nderedimieghe kughenda ukotie BWANA aho, angu oreobueghe lufu lwa malaika wa BWANA.",
          "type": "text",
