              "type": "text"
            }
          ]
        },
        {
          "text": "angu Mlungu oremzerieghe Musa, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.48",
            "verseOrgIds": [
              "NUM.1.48"
            ]
