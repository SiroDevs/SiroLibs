          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyo Hema ikakadukwa, Walawi niwo wiikuagha; na sena ikakawikirilwa, niwo weni wiidungagha. Mndungi mzima ukaisoghodera uchabwaghwa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.51",
            "verseOrgIds": [
              "NUM.1.51"
            ]
          }
        },
