          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kivalwa cha Reubeni, mwana wa imbiri wa Israeli wiendatalwa wose vichuku vawo, na nyumba rawo kwa marina ghawo, mundu wa womi udimagha kughenda wudenyi uvikie miaka mirongo iwi na kuchumba, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.20",
            "verseOrgIds": [
              "NUM.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "mtalo ghwawo ghorekoghe elfu mirongo ina na irandadu na maghana masanu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.21",
            "verseOrgIds": [
              "NUM.1.21"
            ]
          }
        }
      ]
