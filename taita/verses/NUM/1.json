              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ituku ja imbiri ja mori ghwa kawi, mwaka ghwa kawi nyuma ya kufuma isanga ja Misri, BWANA ukaghora na Musa aho kireti cha Sinai andenyi ya Hema ekwania ukighamba,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.1",
            "verseOrgIds": [
              "NUM.1.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
