          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "ela kuwiwike wikaie wazighaniri wa Hema ya andu kwapo kokaia, na vilambo varo vose. Wichakaia wikiiduka Hema na vilambo varo vose; nawo wichadunga kambi kuimara iyo Hema, na kuilindia. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.50",
            "verseOrgIds": [
              "NUM.1.50"
            ]
          }
        },
