          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kukakatala vichuku va Israeli, kusetale kichuku cha Lawi; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.49",
            "verseOrgIds": [
              "NUM.1.49"
            ]
          }
        },
