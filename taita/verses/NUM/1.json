              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Huwo niko wandu wa Israeli werebonyereghe sa iji koni BWANA oremlaghirieghe Musa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.54",
            "verseOrgIds": [
