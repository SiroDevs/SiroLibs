            }
          ]
        },
        {
          "text": "nguro ra wurigha ghwa waza iko mbai mbai, na vishawalata varo va nandonyi, vigingi na kamba chiaimweri na vilambo varo vose. Na oho kuchawipangia vilambo kwa marina gharo ivo iwifwanagha wividuke. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.32",
            "verseOrgIds": [
