          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 4:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.28",
            "verseOrgIds": [
              "NUM.4.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 4:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kuwitale wana wa Merari kunughana na vichuku na nyumba rawo; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.29",
            "verseOrgIds": [
              "NUM.4.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 4:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "awo wivikie irika ja miaka mirongo idadu, hata irika ja miaka mirongo misanu, awo wose widimagha kudumika kwa kazi riko andenyi ya Hema ekwania. ",
          "type": "text",
