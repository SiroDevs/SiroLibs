          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balaamu ukamzera Balaki, “Ola idana niaghala cha mzedu, ela choo nikughorie seji awandu wichaawibonya wandu wako matuku ghichagha.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.14",
            "verseOrgIds": [
              "NUM.24.14"
            ]
          }
        },
        {
