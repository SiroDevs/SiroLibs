                "loc": "LEV.24.22"
              },
              "items": [
                {
                  "text": "Wal. 24.22",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.16",
            "verseOrgIds": [
              "NUM.15.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "BWANA ukamzera Musa uwizere wandu wa Israeli huwu, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.17",
            "verseOrgIds": [
              "NUM.15.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ngelo mwavika ijo isanga nawuyamghenja, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.18",
            "verseOrgIds": [
              "NUM.15.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "na iji mwakaja vindo va ijo isanga, mchamfunyira BWANA kizongona. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.19",
            "verseOrgIds": [
              "NUM.15.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkakaja vindo venyu va imbiri, mfunye keki ikaie sa kizongona chafuma andu kokuwidiria viro. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.20",
            "verseOrgIds": [
              "NUM.15.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mchadua mkimredia BWANA vizongona va mavalo gha imbiri gha viro venyu vivalwa venyu vose.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.21",
            "verseOrgIds": [
              "NUM.15.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.21",
            "verseOrgIds": [
              "NUM.15.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 15:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ela iji mwachumbwa na kulemwa ni kughikatisha agho malaghiro BWANA umghorie Musa, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.22",
            "verseOrgIds": [
              "NUM.15.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 15:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "agho ghose umlaghirie kufuma ituku jija BWANA orezoeghe kumlaghira, hata na kivalwa chenyu chose chichagha, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.23",
            "verseOrgIds": [
              "NUM.15.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "na ikakaia mookosa izungu jose ja wandu jisemanyire, jichafunya mwanwanjau ukaie kizongona chekora; ni irumba jinukagha nicha kwa BWANA. Chichafunywanya na kizongona cha viro, na cha kunywa, kunughana na malaghiro; sena wichurie fwandi imweri ikaie kizongona kwa wundu ghwa kaung'a. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.24",
            "verseOrgIds": [
              "NUM.15.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 15:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mkohani uchabonya wupatanisho kwa wundu ghwa izungu jose ja wandu wa Israeli, nawo wichafuilwa wughoma kwa kukaia wedechumbwa wikabonya ikosa kuseko kukunda, nawo wareda kizongona chawo chekora na kizongona cha viro kwa BWANA kwa wundu ghwa kaung'a. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.25",
            "verseOrgIds": [
              "NUM.15.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na izungu jose ja wandu wa Israeli chiaimweri na mghenyi wawuyamaranya, jichafuilwa wughoma angu wandu wose wedengia ikosenyi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.26",
            "verseOrgIds": [
              "NUM.15.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.26",
            "verseOrgIds": [
              "NUM.15.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 15:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ngera mndungi wachumbwa na kubonya kaung'a, uchafunya mburi ya waka ya mwaka ghumweri ikaie kizongona kwa wundu ghwa kaung'a.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.27",
            "verseOrgIds": [
              "NUM.15.27"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.4.27+LEV.4.28+LEV.4.29+LEV.4.30+LEV.4.31"
              },
              "items": [
                {
                  "text": "Wal. 4.27-31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.27",
            "verseOrgIds": [
              "NUM.15.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 15:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mkohani uchabonya wupatanisho imbiri ya BWANA kwa wundu ghwa uja mundu wachumbwa ukabonya kaung'a; nao uchafuilwa wughoma. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.28",
            "verseOrgIds": [
              "NUM.15.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 15:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sharia ni imweri kwa muisanga wa wandu wa Israeli na mghenyi wimaranyagha, iji wachumbwa wikabonya kaung'a. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.29",
            "verseOrgIds": [
              "NUM.15.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 15:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ela mundu ukabonya ilagho jingi kidali, ukaiagha ni mwisanga angu mghenyi, uamdukana BWANA; mundu uo, uchainjwa kufuma kwa wandu wake. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.30",
            "verseOrgIds": [
              "NUM.15.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NUM 15:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Angu wajimenya ilagho ja BWANA, na kurinona sharia rake. Mundu uo uchainjwa putu kufuma kwa wandu, nao uchaduka ikosa jake moni.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.31",
            "verseOrgIds": [
              "NUM.15.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mundu oreinonieghe Sabato",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NUM 15:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.31",
            "verseOrgIds": [
              "NUM.15.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NUM 15:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ituku jimu, ngelo wandu wa Israeli werekoghe kireti, weremmbonieghe mndumu ukishoa mbande ituku ja Sabato. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.32",
            "verseOrgIds": [
              "NUM.15.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NUM 15:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waja wandu weremmbonieghe, wikamghenja kwa Musa na Haruni, na izungu jose ja wandu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.33",
            "verseOrgIds": [
              "NUM.15.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NUM 15:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wikakaia wikimlindia angu wiseremanyireghe nicha ngera ubonywa wada. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.34",
            "verseOrgIds": [
              "NUM.15.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "NUM 15:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "BWANA ukamzera Musa, “Uo mundu uchabwaghwa; izungu jose ja wandu jichamlasa na magho shighadi ya kambi.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.35",
            "verseOrgIds": [
              "NUM.15.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "NUM 15:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao izungu jose jikamfunya shighadi ya kambi, jikamlasa na magho hata ukafwa, seji koni BWANA oremlaghirieghe Musa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.36",
            "verseOrgIds": [
              "NUM.15.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Malaghiro aighu ya mafindikio",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "NUM 15:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.36",
            "verseOrgIds": [
              "NUM.15.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "NUM 15:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "BWANA ukamzera Musa, “Ghora na wandu wa Israeli, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.37",
            "verseOrgIds": [
              "NUM.15.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "NUM 15:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuwizere wibonye mafindikio mbembenyi ra nguwo rawo, vivalwa vawo vose, na kula ifindikio jifungwanyo na lugha lwa buluu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.38",
            "verseOrgIds": [
              "NUM.15.38"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.22.12"
              },
              "items": [
                {
                  "text": "Wuk. 22.12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.38",
            "verseOrgIds": [
              "NUM.15.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "NUM 15:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mchakaia mkizighanagha ijo ifindikio na kukumbukagha malaghiro ghose gha BWANA mpate kughibonya; eri msechebonya seji ngolo renyu righeshagha kunughana na maza muriwonagha na meso ghenyu; iro mkundagha kurinugha kwa bea mbaa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.39",
            "verseOrgIds": [
              "NUM.15.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "NUM 15:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa chia ihi, mchakumbuka na kubonya malaghiro ghapo ghose; mpate kukaia muelie kwa Mlungu onyu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.40",
            "verseOrgIds": [
              "NUM.15.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "NUM 15:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ini ne BWANA Mlungu onyu, uo oremfunyireghe isanga ja Misri, nipate kukaia Mlungu onyu: Nani ne BWANA Mlungu onyu.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.41",
            "verseOrgIds": [
              "NUM.15.41"
            ]
          }
        }
      ]
    }
