          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngelo iyo yose Sanduku ya Ilaghano erezoyagha kudukwa, Musa orekoghe ukighamba, “Wuka ee BWANA, kuwisaghise wamaiza wako; na awo wizamilwagha ni oho, ndewikimbie imbiri yako.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.35",
            "verseOrgIds": [
              "NUM.10.35"
            ]
          }
        },
        {
