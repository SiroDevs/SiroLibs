              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na iji yadulwa, orekoghe ukighamba, “Wuya ee BWANA kwa elfu ikumi ra maelfu gha Israeli.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.36",
