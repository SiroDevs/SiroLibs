          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ituku ja ikumi na isanu ja ugho mori kuchakaia na ndima ya matuku mfungade, mseje mikate iko na chachu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.17",
            "verseOrgIds": [
              "NUM.28.17"
            ]
          }
        },
