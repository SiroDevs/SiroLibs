          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "chiaimweri na fwandi imweri ebonya wupatanisho kwa wundu ghonyu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.30",
            "verseOrgIds": [
              "NUM.28.30"
            ]
          }
        },
        {
