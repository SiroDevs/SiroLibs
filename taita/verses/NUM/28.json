          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "na kilo imweri kwa kula umu wa wana wa ng'ondi mfungade; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.29",
            "verseOrgIds": [
              "NUM.28.29"
            ]
          }
        },
