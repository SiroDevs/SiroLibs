              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.6.23",
            "verseOrgIds": [
              "JER.6.23"
            ]
          }
        },
        {
          "name": "verse",
