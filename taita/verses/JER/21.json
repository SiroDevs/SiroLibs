        "style": "s1"
      },
      "items": [
        {
          "text": "Wulodi aighu ya kusimwa kwa Jerusalemu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
