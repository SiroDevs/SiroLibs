          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kutala kwa Mlungu aighu ya Israeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "BWANA ukaghora nani ukighamba,",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.1",
            "verseOrgIds": [
              "JER.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kaung'a ra weke wawa wa Israeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mashitakio gha Mlungu kwa wandu wake",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mafungu gha kusowa wuloli kwa Israeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Israeli kulegha kumtasa BWANA",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kufwana kwa Israeli kunekwa adhabu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.25",
            "verseOrgIds": [
              "JER.2.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 2:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "BWANA waghamba, “Seji kitoi chifwagha waya ingelo chawadwa, ni huwo koni Israeli uchaafwa waya, awo weni, na wazuri wawo, na wabaa wawo wa wandu, na wakohani wawo, na walodi wawo ",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.26",
            "verseOrgIds": [
              "JER.2.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 2:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "awo wighuzeragha mudi, ‘Oho ko aba,’ na igho, ‘Oho ko mao.’ Kwa kukaia waghalukie na mbai kufuma kwapo, hata ndewikunde kunizighana; ela wikapatwa ni wasi waghamba, ‘Wuka kudikire!’ ",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.27",
            "verseOrgIds": [
              "JER.2.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JER 2:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Da milungu yako iyo korekubonyereghe kumoni iao? Ndeiwukecho ikakaia idimagha kukukira ngelo ya wasi ghwako? Kwa kukaia eko mingi andenyi ya mizi yako ee Juda. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.28",
            "verseOrgIds": [
              "JER.2.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JER 2:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwaki munishitakiagha na hoku mmbose moonilegha? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.29",
            "verseOrgIds": [
              "JER.2.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JER 2:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawinekie wana wako adhabu, ela ndewicheetala kukuboisa weni. Mwawibwaghie walodi wenyu mmbeni, karakara na shimba ifondiagha. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.30",
            "verseOrgIds": [
              "JER.2.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JER 2:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na inyo ee mbari ya Israeli, nisikirenyi ini BWANA. Huwo neewuya kireti angu kira chikambie kwa Israeli? Kwaki sena wandu wapo wighambagha, ‘Isi deko huru, ndedichawuya kwako sena?’ ",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.31",
            "verseOrgIds": [
              "JER.2.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JER 2:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wele mwai wadima kuliwa mapambo ghake gha lulu angu mwai ulowolwagha nguwo yake ya arusi? Ela wandu wapo waniliwie kwa matuku ghisetalikagha. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.32",
            "verseOrgIds": [
              "JER.2.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JER 2:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koko na wuya loli-loli gholola waka, hata aweni wizamie putu kwawifundishire chia rako. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.33",
            "verseOrgIds": [
              "JER.2.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JER 2:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nguwo rako reechulwa ni bagha ya wakiwa wiseko na ikosa jingi, hata kusewiwonie wikibara nyumba; ela sena aighu ya agho ghose, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.34",
            "verseOrgIds": [
              "JER.2.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JER 2:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwadaghamba, ‘Ini siwadie ikosa, na kwa loli BWANA walekie kunibonyera machu.’ Ola nichakutanya kwa wundu ghwa oho kughamba wei ndekubonyere kaung'a ingi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.35",
            "verseOrgIds": [
              "JER.2.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JER 2:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwaghalue chia rako mando mengi! Kuchafushwa waya ni Wamisri, sa iji koni korefushiroghe waya ni Waashuru. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.36",
            "verseOrgIds": [
              "JER.2.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JER 2:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wokoni kuchafuma Misri kwaduka mikonu yako chongo kwa waya, angu ini BWANA namerie kuwilegha awo wose kukusaghikagha nawo, hata ndekuchaapata wucha ghungi kwawo.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.37",
            "verseOrgIds": [
              "JER.2.37"
            ]
          }
        }
      ]
    }
  ],
