            "style": "v",
            "sid": "JER 29:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa kukaia wadumie barua kodu isi didwalo wunyika Babuloni ukighamba, ‘Kudwalwa wunyika konyu kucham'bonya mkaie aho kwa ngelo ndacha; kwa huwo aghenyi nyumba rekaia, muwe mbuwa renyu mpate vindo veja.’”",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.28",
            "verseOrgIds": [
              "JER.29.28"
            ]
          }
        }
