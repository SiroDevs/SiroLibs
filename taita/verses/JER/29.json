          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niko BWANA ukaghora na Jeremia ukighamba, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.30",
            "verseOrgIds": [
              "JER.29.30"
