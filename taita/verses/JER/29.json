          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "BWANA wakubonyere kukaie mkohani wulalo ghwa mkohani Jehoiada, kupate kukaie mzighaniri wa Hekalu ya BWANA, na kumfunga kula mundu wa isu, uo ukubonyagha moni kukaia mlodi kwa kilingo na izango ja chuma singonyi kwake. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.26",
            "verseOrgIds": [
              "JER.29.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
