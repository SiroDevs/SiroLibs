            }
          ]
        },
        {
          "text": "BWANA wa majeshi, uo Mlungu wa Israeli waghora huwu, “Kwaghenjere barua kwa irina jako kwa wandu wose wikaiagha Jerusalemu, na kwa mkohani Zefania mwana wa Maaseia, na kwa wakohani wose, kukighamba wei ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.25",
            "verseOrgIds": [
              "JER.29.25"
            ]
          }
        },
        {
