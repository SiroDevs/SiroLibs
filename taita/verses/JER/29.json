            }
          ]
        },
        {
          "text": "Nao mkohani Zefania ukaishoma iyo barua mlodi Jeremia ukisikira. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.29",
            "verseOrgIds": [
