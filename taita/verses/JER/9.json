              "JER.9.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "BWANA waghamba, “Ola matuku ghichacha, nichawikaba wandu wishamishiro, sena wiseshamishiro kungi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.25",
            "verseOrgIds": [
              "JER.9.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nichawikaba wandu wa Misri, na wa Juda, na wa Edomu, na wana wa Amoni, na wandu wa Moabu, na wandu wose wikaiagha kireti widumbuagha maridia ghawo virodi;",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.26",
            "verseOrgIds": [
              "JER.9.26"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "9.26",
              "type": "text"
            },
            {
              "text": "virodi:",
              "type": "text"
            },
            {
              "text": "kudumbua maridia virodi: Wandu wa kireti werekoghe wikidumbua maridia ghawo virodi kwa kuneka milungu yawo ishima; ilagho jighirilo Waisraeli (Walawi 19.27).",
              "type": "text"
            }
          ]
        },
        {
          "text": " wandu awa wose ndewishamishiro, na wandu wa Israeli wori ndewishamishiro ngolonyi kwawo.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.26",
            "verseOrgIds": [
              "JER.9.26"
            ]
          }
        }
      ]
    }
