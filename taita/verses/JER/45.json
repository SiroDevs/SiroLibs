              "type": "text"
            }
          ]
        },
        {
          "text": "Mwaka ghwa kana ghwa kubonya nguma kwa Jehoiakimu mwana wa Josia mzuri wa Juda, Baruku oreandikieghe malagho neremghorieghe,",
          "type": "text",
          "attrs": {
