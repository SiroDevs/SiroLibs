                "loc": "2SA.9.3"
              },
              "items": [
                {
                  "text": "2 Sam. 9.3",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 4:4"
          },
          "items": [
            {
              "text": "4",
