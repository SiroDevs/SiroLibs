            "sid": "2SA 12:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.23",
            "verseOrgIds": [
              "2SA.12.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2SA 12:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao Daudi ukamhoresha mkake Bathsheba, ukangia kwake, ukalala nao; ukava mwana wa womi, nao ukammbanga irina jake Solomoni. BWANA ukamkunda uo mwana. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.24",
            "verseOrgIds": [
              "2SA.12.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2SA 12:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "BWANA ukamduma mlodi Nathani uendemmbanga uo mwana Jedidia; kwa kukaia BWANA oremkundieghe.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.25",
            "verseOrgIds": [
              "2SA.12.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Daudi kuwada muzi ghwa Raba",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2SA 12:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.25",
            "verseOrgIds": [
              "2SA.12.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2SA 12:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joabu ukabonya wuda na Raba muzi ghwa Waamoni na kughuwada ugho muzi ghwa kiwuzuri. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.26",
            "verseOrgIds": [
              "2SA.12.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2SA 12:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukaduma wandu kwa Daudi ukighamba, “Nakaba muzi ghwa Raba, ngawada machi garo. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.27",
            "verseOrgIds": [
              "2SA.12.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2SA 12:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Idana kwanya wandu wose wisigharikie chiaimweri, kubonye kambi na kughumara ugho muzi hata kughuwade; nisecheghuwada ghuchewangwa kwa irina japo.” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.28",
            "verseOrgIds": [
              "2SA.12.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2SA 12:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao Daudi ukawikwanya wandu wose chiaimweri, ukaghenda Raba; ukalwa na kughuwada. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.29",
            "verseOrgIds": [
              "2SA.12.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2SA 12:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi ukawusa kirumbu cha dhahabu kufuma chongonyi cha Milkomu chiko na wulemeri ghwa kilo mirongo idadu na isanu, na andenyi yaro korekoghe na lulu iboie; na icho kirumbu chikangirwa chongonyi kwa Daudi, ukadwa wunyika vilambo vingi va ugho muzi va zoghori mbaa. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.30",
            "verseOrgIds": [
              "2SA.12.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2SA 12:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukawidwa wunyika wandu wa ugho muzi, ukawiwika wibonye kazi na misumeno, na sururu ra chuma, na masoka gha chuma; ukawiwika wibonyeghe matofali. Na huwo niko orebonyereghe kwa mizi yose ya Waamoni. Niko Daudi na wandu wose wikawuya Jerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.31",
            "verseOrgIds": [
              "2SA.12.31"
            ]
          }
        }
      ]
    }
