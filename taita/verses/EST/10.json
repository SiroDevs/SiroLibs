            "number": "1",
            "style": "v",
            "sid": "EST 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao Mzuri Ahasuero ukafunya momu wandu wose isangenyi na masanga gha pwani andenyi ya wuzuri ghwake wifunye kodi. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.10.1",
            "verseOrgIds": [
              "EST.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EST 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mabonyo ghake mabaa ghose gha mashiniko oreghibonyereghe, chiaimweri na maza remjosa daraja ra ishima Mordekai, agho ghose ghaandikilo andenyi ya Chuo cha Wukumbuso cha wuzuri ghwa Media na Pashia. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.10.2",
            "verseOrgIds": [
              "EST.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EST 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uo Mordekai Myahudi orekoghe wa kawi kwa Mzuri Ahasuero kunughana na daraja orenekeloghe. Nao orekundiloghe na kunekwa ishima ni Wayahudi, kwa kukaia orewibonyereghe nicha, na kuwiwika andenyi ya wulindiri ghwa loli.",
          "type": "text",
          "attrs": {
            "verseId": "EST.10.3",
            "verseOrgIds": [
              "EST.10.3"
            ]
          }
        }
      ]
    }
