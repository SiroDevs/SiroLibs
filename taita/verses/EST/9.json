          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wayahudi wose wikaghenjerwa kopi ya barua iyo, masanga ghose ighana na mirongo iwi na mfungade gha mzuri Ahasuero, iwonyeragha angu weko na wulindiri ghwa loli; ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.30",
            "verseOrgIds": [
              "EST.9.30"
            ]
          }
        },
        {
