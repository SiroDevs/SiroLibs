              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mzuri Hiramu ukaduma mabaharia wake wiichi kudumika baharinyi widumike chiaimweri na wadumiki wa Solomoni. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.27",
