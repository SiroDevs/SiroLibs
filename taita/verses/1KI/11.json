        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1KI 11:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.39",
            "verseOrgIds": [
              "1KI.11.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1KI 11:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa ilagho ijo, Solomoni ukalola kum'bwagha Jeroboamu, ela Jeroboamu ukakimbiria kwa Mzuri Shishaki wa Misri; ukakaia aho hata Solomoni ukafwa.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.40",
            "verseOrgIds": [
              "1KI.11.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kufwa kwa Solomoni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1KI 11:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.40",
            "verseOrgIds": [
              "1KI.11.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1KI 11:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maza rose zima ra Solomoni, na kula ilagho ujibonyere, na hikima yake vaandikilo andenyi ya chuo cha mabonyo gha Solomoni. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.41",
            "verseOrgIds": [
              "1KI.11.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1KI 11:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoni orebonyereghe nguma Jerusalemu aighu ya Israeli yose kwa miaka mirongo ina. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.42",
            "verseOrgIds": [
              "1KI.11.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "1KI 11:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoni ukafwa ukarikwa andenyi ya muzi ghwa ndee Daudi; na mwana wake Rehoboamu ukabonya nguma wulalo ghwake.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.43",
            "verseOrgIds": [
              "1KI.11.43"
            ]
          }
        }
      ]
    }
