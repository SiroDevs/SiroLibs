          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wokoni Solomoni ukabonya vilambo va dhahabu kwa wundu ghwa Hekalu, navo ni madhabahu, meza ya mikate ewikwa kwa Mlungu,",
          "type": "text",
          "attrs": {
