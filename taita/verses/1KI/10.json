          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Farasi ra Solomoni rerekoghe rikiredwa kufuma Misri na Kilikia, na washami wa mzuri wikarighua kufuma Kilikia.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.28",
            "verseOrgIds": [
