          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoni orekoghe na hikima kuchumba wandu wose wa mashariki, na kuchumba wandu wose wa hikima wa Misri. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.30",
            "verseOrgIds": [
              "1KI.4.30"
            ]
          }
        },
