          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orekoghe na hikima kuchumba wandu wose, hata kumchumba Ethani Muezrahi, na Hemani, Kalkoli, na Darda, awo wana wa Maholi; sare ya hikima yake ikaera isanga jose ja mbai-mbai.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.31",
            "verseOrgIds": [
              "1KI.4.31"
            ]
          }
