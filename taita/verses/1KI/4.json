              "type": "text"
            }
          ]
        },
        {
          "text": "Mlungu ukamneka Solomoni hikima na kumanya kubaa, na akili nyingi risepimikagha. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.29",
            "verseOrgIds": [
