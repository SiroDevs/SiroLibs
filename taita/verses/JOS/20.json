              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.6",
            "verseOrgIds": [
              "JOS.20.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niko aho wikafunya muzi ghwa isanga ja Kedeshi ghuko andenyi ya Galilaya, isanga ja mighondinyi ja Naftali, na Shekemu ghuko isanga ja mighondinyi ja Efraimu, na Kiriath-araba (nigho Hebroni) isanga ja mighondinyi ja Juda. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.7",
            "verseOrgIds": [
              "JOS.20.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mashariki ya Jeriko, kimonu cha Jordani, wikasaghua Bezeri muzi ghuko wurindinyi kireti kufuma kwa kichuku cha Reubeni, na Ramothi, ghuko Gileadi kufuma kwa kichuku cha Gadi, na Golani ghuko Bashani kufuma kwa kichuku cha Manase. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.8",
            "verseOrgIds": [
              "JOS.20.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihi niyo mizi ekimbiria eresaghuloghe kwa wundu ghwa wandu wa Israeli wose, na kwa wundu ghwa waghenyi wiko aghadi kwawo; eri mndungi ubwaghagha mundu kwa ndengwa, upate andu kokimbiria; eri usechebwaghwa ni mundu olipia kisasi usekaie imbiri ya izungu ja wandu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.9",
            "verseOrgIds": [
              "JOS.20.9"
            ]
          }
        }
      ]
    }
