          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Machu gha Jona na wughoma ghwa Mlungu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JON 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ela Jona ukazamilwa na kubonya machu nandighi. ",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.1",
            "verseOrgIds": [
              "JON.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JON 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukamlomba BWANA ukaghamba, “Wona BWANA! Huwu siko koni nerekoghe ngighamba iji nerekoghe mzedu? Hata iyo niyo shekeria erenibonyereghe nikimbie cha Tarshishi. Neremanyireghe wori oho ko Mlungu wa mvono na wughoma, kusebonyagha machu shwa-shwa; koko na lukundo lubaa lukatie, kulekiagha mawiwi.",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.2",
            "verseOrgIds": [
              "JON.4.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.34.6"
              },
              "items": [
                {
                  "text": "Kuf. 34.6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.2",
            "verseOrgIds": [
              "JON.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JON 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa huwo idana nakulomba ee BWANA kuniinjire irangi japo angu ni baa nifo, kuchumba kukaia moyo.”",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.3",
            "verseOrgIds": [
              "JON.4.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.19.4"
              },
              "items": [
                {
                  "text": "1 Waz. 19.4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.3",
            "verseOrgIds": [
              "JON.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JON 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "BWANA ukaghamba, “Huwo koko na hachi ebonya machu?”",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.4",
            "verseOrgIds": [
              "JON.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JON 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.4",
            "verseOrgIds": [
              "JON.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JON 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niko Jona ukafuma shighadi ya muzi, ukaghenda na kusea kidombo iichia cha mashariki; ukakubonyera kiwanda aho. Ukakaia akijunyi cha icho kiwanda, upate kuwona agho ghibonyekagha kwa ugho muzi. ",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.5",
            "verseOrgIds": [
              "JON.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JON 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao BWANA Mlungu ukasaghua mmbonu ukaghubonya ghuzoghuo na kubonya kiju aighu ya Jona chimhoresheghe. ",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.6",
            "verseOrgIds": [
              "JON.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JON 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ela ituku ja kawi ndoe iendaela, Mlungu ukawika kivunyu chikaghuja ghuja mmbonu nagho ghukanyaya. ",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.7",
            "verseOrgIds": [
              "JON.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JON 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iji iruwa jabuka, Mlungu ukareda mbeo ya mruke ifumagha cha mashariki, na Jona ukakabwa ni iruwa ja chongo hata ukadumbuka; ukalomba ufo ukaghamba, “Ni baa nifo, kuchumba kukaia moyo.” ",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.8",
            "verseOrgIds": [
              "JON.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JON 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ela Mlungu ukamzera Jona, “Huwo koko na hachi ebonya machu kwa wundu ghwa mmbonu?” Nao ukaghamba, “Neko na hachi ebonya machu; machu ghikate kunibwagha.”",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.9",
            "verseOrgIds": [
              "JON.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JON 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.9",
            "verseOrgIds": [
              "JON.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JON 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "BWANA ukamzera Jona, “Ola kwaawadwa ni wughoma ghwa mmbonu ugho kusereghubonyereghe kazi ingi, hata kusereghuzoghoreghe; ghoocha ghukaakaia kio chimweri, na ghukaafwa kwa kio chimweri. ",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.10",
            "verseOrgIds": [
              "JON.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JON 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Welee, na ini ndeinifwane niwado ni wughoma ghwa ugho muzi m'baa ghwa Nineve ghuko na wandu kuchumba elfu ighana na mirongo iwi wisemanyagha jebonya ni jiao na wokoni ghuko na ng'ombe nyingi?”",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.11",
            "verseOrgIds": [
              "JON.4.11"
            ]
          }
        }
      ]
    }
  ],
