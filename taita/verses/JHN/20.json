          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu orebonyereghe weke mwakilimbiti walazi imbiri ya wanughi wake, wiseandikilo aha. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.30",
