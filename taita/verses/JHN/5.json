              },
              "items": [
                {
                  "text": "Dan. 12.2",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Wushuhuda aighu ya Jesu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JHN 5:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.29",
            "verseOrgIds": [
              "JHN.5.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JHN 5:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Sidimagha kubonya ilagho jingi kwa nguma yapo ini moni anduangi; ela nadatanya sa iji nisikiragha kwa Aba, na kutanya kwapo ni kwa hachi, kwa kukaia silolagha lukundo lwapo ini moni anduangi, ela lukundo lwake uo orenidumieghe. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.30",
            "verseOrgIds": [
              "JHN.5.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JHN 5:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakushuhudia ini moni, wushuhuda ghwapo ndeghukaa ghwa loli anduangi. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.31",
            "verseOrgIds": [
              "JHN.5.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JHN 5:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oko umu unishuhudiagha ini, nani namanya angu ugho wushuhuda unishuhudiagha nagho ni ghwa loli. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.32",
            "verseOrgIds": [
              "JHN.5.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JHN 5:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inyo morewidumieghe wandu kwa Johane, nao moni ukashuhudia agho gha loli.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.33",
            "verseOrgIds": [
              "JHN.5.33"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.1.19+JHN.1.20+JHN.1.21+JHN.1.22+JHN.1.23+JHN.1.24+JHN.1.25+JHN.1.26+JHN.1.27"
              },
              "items": [
                {
                  "text": "Joh. 1.19-27",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.3.27+JHN.3.28+JHN.3.29+JHN.3.30"
              },
              "items": [
                {
                  "text": "3.27-30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.33",
            "verseOrgIds": [
              "JHN.5.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JHN 5:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Si angu nakusaghika kwa wushuhuda ghwa wadamu, ela naghora malagho agha inyo mpate kukia. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.34",
            "verseOrgIds": [
              "JHN.5.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JHN 5:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Johane orekoghe sa taa iakagha na kulangalishira mwengere, nenyo kwa ngelo vui morekoghe mkiboilwa kwa mwengere ghwake.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.35",
            "verseOrgIds": [
              "JHN.5.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JHN 5:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.35",
            "verseOrgIds": [
              "JHN.5.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JHN 5:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ela neko na wushuhuda m'baa kuchumba ugho ghwa Johane. Angu iro kazi niribonyagha, iro Aba oreninekieghe niribonye, niro reni rinishuhudiagha kukaia uo orenidumieghe ni Aba. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.36",
            "verseOrgIds": [
              "JHN.5.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JHN 5:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na wokoni uja Aba orenidumieghe wanishuhudia; na inyo jingi ndemlusikire lwaka lwake hata kughuwona wushu ghwake anduangi;",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.37",
            "verseOrgIds": [
              "JHN.5.37"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.3.17"
              },
              "items": [
                {
                  "text": "Mat. 3.17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.1.11"
              },
              "items": [
                {
                  "text": "Mk. 1.11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.3.22"
              },
              "items": [
                {
                  "text": "Lk. 3.22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.37",
            "verseOrgIds": [
              "JHN.5.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JHN 5:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "na ilagho jake ndejiko ngolonyi konyu kwa kukaia ndemumrumirie Uo oredumiloghe ni Uo moni. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.38",
            "verseOrgIds": [
              "JHN.5.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JHN 5:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwadazighana-zighana Maandiko, mkiririkanya wei ghadima kumneka irangi ja kala na kala, nagho nigho ghinishuhudiagha ini; ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.39",
            "verseOrgIds": [
              "JHN.5.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JHN 5:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "nenyo mwalegha kucha kwapo mpate irangi.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.40",
            "verseOrgIds": [
              "JHN.5.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JHN 5:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.40",
            "verseOrgIds": [
              "JHN.5.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JHN 5:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Si angu nawuyalola kukaswa ni wandu, ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.41",
            "verseOrgIds": [
              "JHN.5.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JHN 5:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "ela namwichi seji muko, angu lukundo lwa Mlungu ndeluko ngolonyi konyu anduangi. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.42",
            "verseOrgIds": [
              "JHN.5.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "JHN 5:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ini nachee kwa nguma ra Aba, nenyo ndemuniwusagha; ela ngera mndungi wacha kwa nguma rake, mchammbusa. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.43",
            "verseOrgIds": [
              "JHN.5.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "JHN 5:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mdima wada kurumiria mkinekana wubaa mmbeni na mmbeni, nenyo msekunde kughulola ugho wubaa ghufumagha kwa Mlungu moni? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.44",
            "verseOrgIds": [
              "JHN.5.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "JHN 5:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Msakeghesha wei ini nichamshitakia kwa uja Aba, ela uo Musa mumsuwiriagha, nuo moni uchaamshitakia. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.45",
            "verseOrgIds": [
              "JHN.5.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "JHN 5:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngera loli modemrumiria Musa, kumangu mwanirumiria ini wori, kwa kukaia Musa oreandikieghe malagho aighu yapo. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.46",
            "verseOrgIds": [
              "JHN.5.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "JHN 5:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikakaia mseghirumirie maandiko gha Musa, mdima wada kughirumiria malagho ghapo?”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.47",
            "verseOrgIds": [
              "JHN.5.47"
            ]
          }
        }
      ]
    }
