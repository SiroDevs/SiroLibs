          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.22",
            "verseOrgIds": [
              "1SA.28.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1SA 28:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sauli ukalegha ukighamba, “Sijagha kungi.” Ela wabaa wake chiaimweri na uja muka wikamshingira uje, hata ukadima wasikira malagho ghawo. Niko ukawuka kufuma andonyi, ukasea kidombo wulinyi. ",
          "type": "text",
