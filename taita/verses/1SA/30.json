              "type": "text"
            }
          ]
        },
        {
          "text": "na wa Rakali, andenyi ya mizi ya wa Jerahimeeli, na mizi ya Wakeni; ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.29",
            "verseOrgIds": [
              "1SA.30.29"
            ]
          }
        },
