          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vilambo ivo ukaviwaghia wandu wa Betheli, na wandu werekoghe Ramothi ya Negebu, na wandu wa Jatiri, ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.27",
            "verseOrgIds": [
              "1SA.30.27"
            ]
          }
        },
