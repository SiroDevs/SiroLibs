              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi uendavika Siklagi, ukawiwaghia waghenyi wake ivo vilongozi va Juda ivo vilambo wavidwa wunyika ukighamba, “Wadenyi zawadi ya vilambo vawadwa wunyika kufuma kwa wamaiza wa BWANA.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.26",
            "verseOrgIds": [
              "1SA.30.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
