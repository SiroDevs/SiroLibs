            }
          ]
        },
        {
          "text": "andenyi ya Horma, na Borashani, na Athaki; ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.30",
            "verseOrgIds": [
              "1SA.30.30"
            ]
