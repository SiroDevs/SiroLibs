      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niko wandu wa Kiriath-jearimu wikaghenda na kuionda Sanduku ya Ilaghano ya BWANA, wikaiwika nyumbenyi kwa Abinadabu ukaiagha mghondinyi, wikammbika mwana wake Eleazari ukaie mlindiri wa iyo Sanduku ya BWANA.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.1",
            "verseOrgIds": [
              "1SA.7.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
