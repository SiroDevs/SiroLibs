              "type": "text"
            }
          ]
        },
        {
          "text": "Ukabonya andu kotasira mighondinyi andenyi ya kula muzi ghwa Juda; kufukiria milungu mizima marumba, na kum'bonya BWANA uo Mlungu wa weke ndee ujoko ni machu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.25",
            "verseOrgIds": [
              "2CH.28.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CH 28:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malagho gha mabonyo ghake na seji orekoghe kufuma kuzoya hata kutua, ghaandikilo andenyi ya Chuo cha Wazuri wa Juda na Israeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.26",
            "verseOrgIds": [
              "2CH.28.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
