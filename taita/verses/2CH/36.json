        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kuro kufunya momu Wayahudi wiwuye",
          "type": "text"
        }
      ]
    },
    {
