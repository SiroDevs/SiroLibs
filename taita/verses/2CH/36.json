              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wokoni Nebukadnezari ukadwa vilambo vimu va Hekalu cha Babuloni, ukaviwika ngomenyi kwake. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.7",
            "verseOrgIds": [
              "2CH.36.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 36:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mabonyo gha Jehoiakimu mazima na maza rizamie oreribonyereghe, na agho gherewonekieghe kwake, ghaandikilo andenyi ya Chuo cha Wazuri wa Israeli na Juda. Mwana wake Jehoiakini ukabonya nguma wulalo ghwake.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.8",
            "verseOrgIds": [
              "2CH.36.8"
            ]
          }
        }
