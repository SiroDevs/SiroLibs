          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wandu wa kichuku cha Benjamini werekaieghe Geba Mikmashi, na Ai, na Betheli na mizi mitini iko kaavui. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.31",
            "verseOrgIds": [
              "NEH.11.31"
            ]
