          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azareli, Shelemia, Shemaria, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.41",
            "verseOrgIds": [
              "EZR.10.41"
            ]
