          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kichuku cha Bebai ni: Jehohanani, Hanania, Zabai, na Athlai. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.28",
            "verseOrgIds": [
              "EZR.10.28"
            ]
          }
        },
