            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wa Waisraeli wazima ni awa: Kichuku cha Paroshi: Ramia, Izia, Malkija, Mijamini, Eliazari, Malkija na Benaia. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.25",
            "verseOrgIds": [
              "EZR.10.25"
            ]
          }
        },
        {
          "name": "verse",
