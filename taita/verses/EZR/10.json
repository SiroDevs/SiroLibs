          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shalumu, Amaria na Josefu, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.42",
            "verseOrgIds": [
              "EZR.10.42"
            ]
