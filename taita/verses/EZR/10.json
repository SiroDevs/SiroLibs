          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kichuku cha Zatu: Elioenai, Eliashibu, Matania, Jeremothi, Zabadi, na Aziza. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.27",
            "verseOrgIds": [
              "EZR.10.27"
            ]
          }
