          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shelemia, Nathani, Adaia, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.39",
            "verseOrgIds": [
              "EZR.10.39"
            ]
          }
        },
