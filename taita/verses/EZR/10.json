          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kichuku cha Hashumu: Matenai, Malala, Matatha, Zabadi, Elifeleti, Jeremai, Manase na Shimei. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.33",
