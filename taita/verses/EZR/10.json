          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kichuku cha Nebo ni: Jeieli, Matithia, Zabadi Zebina, Jadai, Joeli na Benaia. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.43",
