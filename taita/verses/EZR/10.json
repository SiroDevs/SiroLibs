          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kichuku cha Harimu ni: Eliezeri, Ishija, Malkija, Shemaia, Shimeoni, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.31",
            "verseOrgIds": [
              "EZR.10.31"
            ]
