          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Benjamini, Maluku, na Shemaria. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.32",
            "verseOrgIds": [
              "EZR.10.32"
