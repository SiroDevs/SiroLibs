          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kichuku cha Pahath-moabu ni: Adina, Chelali, Benaia, Maaseia, Matania, Baazaleli, Binui, na Manase. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.30",
            "verseOrgIds": [
