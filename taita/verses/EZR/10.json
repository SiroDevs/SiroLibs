          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kichuku cha Banini: Maadai Amramu, Ueli, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.34",
            "verseOrgIds": [
              "EZR.10.34"
