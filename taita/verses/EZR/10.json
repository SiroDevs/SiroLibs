          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EZR 10:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kichuku cha Bani ni Meshulamu, Maluku, Adaia, Jashubu, Sheali, na Jeremothi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.29",
            "verseOrgIds": [
              "EZR.10.29"
            ]
          }
