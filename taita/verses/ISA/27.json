              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngelo iyo, BWANA uchamkaba Leviathani, iyo choka ikimbiagha, kwa lufu lwake lukurie, lubaa, sena luwadie ndighi; uchamkaba Leviathani, iyo choka ighalaaghala, na kuibwagha iyo choka mbaa ikaiagha baharinyi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.1",
            "verseOrgIds": [
              "ISA.27.1"
            ]
          }
        },
