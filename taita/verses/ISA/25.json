          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawo wichakaia wikighorua mikonu yawo andenyi ya icho kina sa mundu ubung'agha machinyi, ela BWANA uchasera uko kukujosa kwawo hata ngera weko na akili; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.11",
            "verseOrgIds": [
              "ISA.25.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "na BWANA uchaghusha mawurigha gha ngome rawo ghiko ighu, na kughighusha andoenyi hata terinyi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.12",
            "verseOrgIds": [
              "ISA.25.12"
            ]
          }
        }
      ]
