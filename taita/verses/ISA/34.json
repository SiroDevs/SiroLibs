          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "BWANA wawika lufu lwake tayari mlungunyi, nalo luasea kukaba Edomu, ee, awo wandu umerie kuwitanya kufwa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.5",
            "verseOrgIds": [
              "ISA.34.5"
            ]
          }
        },
        {
