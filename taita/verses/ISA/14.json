              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "BWANA Uwadie Ndighi Rose wabonya ighemi huwu, “Agho nighibonyere mpango ghichabonyeka, na makusudi ghapo ghichakatia.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.24",
            "verseOrgIds": [
