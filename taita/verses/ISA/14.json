            "number": "29",
            "style": "v",
            "sid": "ISA 14:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Msakeboilwa inyo mmbose Wafilisti, mkikalikia wei ghuja mzata ghoremkabieghe ghoochika; kwa kukaia choka ichafunya choka iko na wusungu, nayo ichava choka iburukagha.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.29",
            "verseOrgIds": [
              "ISA.14.29"
            ]
          }
        },
