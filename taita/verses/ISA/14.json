        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.28",
            "verseOrgIds": [
              "ISA.14.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
