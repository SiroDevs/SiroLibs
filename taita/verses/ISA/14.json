            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 14:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "BWANA wa majeshi waghamba, “Nichawuka aighu ya Babuloni, na kughunona ugho muzi putu hata usoweke mndungi oghorwa aho, hata mwana ungi, hata kivalwa chingi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.22",
            "verseOrgIds": [
              "ISA.14.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ISA 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nichaghubonya ugho muzi ghuwuye malalo gha kiseseghede na kubuka vichi; nani nichaguinja kwa mfwagio ghototesha; ini BWANA wa majeshi naghamba.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.23",
            "verseOrgIds": [
              "ISA.14.23"
            ]
          }
        }
      ]
    },
