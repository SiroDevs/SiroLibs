            "number": "30",
            "style": "v",
            "sid": "2KI 6:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao iji mzuri wasikira malagho gha uo muka, ukarashua nguwo rake, ukikambwa ni chongo, na angu orekoghe ukiida aighu wurighenyi, wandu wikammbona warwa nguwo ra magunia nandenyi ya nguwo rake. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.30",
            "verseOrgIds": [
              "2KI.6.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2KI 6:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mzuri ukaghamba, “Naghema Mlungu unibwaghe iji nisemdumbue Elisha mwana wa Shafati chongo idime.”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.31",
            "verseOrgIds": [
              "2KI.6.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2KI 6:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.31",
            "verseOrgIds": [
              "2KI.6.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2KI 6:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elisha orekoghe kidombo nyumbenyi kwake, chiaimweri na wabaa wamu. Na mzuri orekoghe waduma mundu ukirie; ela mundu uja imbiri usevikie, Elisha ukawizera waja wabaa, “Uja m'bawaghi waduma mundu unidumbuo chongo. Olenyi ukavika aha, mrughe mnyango msemlekerie ungie; mzuri moni hoyo waawuyamnugha nanyuma.” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.32",
            "verseOrgIds": [
              "2KI.6.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2KI 6:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hata iji orekoghe ukideda, mzuri moni ukabusa ukaghamba, “Ughu wasi ghwaafuma kwa BWANA; nisindammbesera BWANA hata lii?”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.33",
            "verseOrgIds": [
              "2KI.6.33"
            ]
          }
        }
