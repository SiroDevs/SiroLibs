                {
                  "text": "Kuz. 32.28",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.35.10"
              },
              "items": [
                {
                  "text": "35.10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.34",
            "verseOrgIds": [
              "2KI.17.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2KI 17:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "BWANA orebonyereghe ilaghano nawo ukiwilaghira, “Msaketasa milungu mizima, hata msakeighoghomia angu kuidumikia, hata kuifunyira vizongona;",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.35",
            "verseOrgIds": [
              "2KI.17.35"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.20.5"
              },
              "items": [
                {
                  "text": "Kuf. 20.5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.5.9"
              },
              "items": [
                {
                  "text": "Wuk. 5.9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.35",
            "verseOrgIds": [
              "2KI.17.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "2KI 17:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "ela mchamtasa BWANA, uo oremfunyireghe isanga ja Misri kwa ndighi mbaa ya mkonu ghwake; nenyo mchamghoghomia uo, na kumfunyira vizongona.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.36",
            "verseOrgIds": [
              "2KI.17.36"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.6.13"
              },
              "items": [
                {
                  "text": "Wuk. 6.13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.36",
            "verseOrgIds": [
              "2KI.17.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "2KI 17:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nenyo mchalindia kuiwadia memu na sharia rake iro oremwandikieghe. Msetase milungu mizima, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.37",
            "verseOrgIds": [
              "2KI.17.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "2KI 17:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "hata mseliwe ijo ilaghano nerebonyereghe nenyo. Msetase milungu mizima, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.38",
            "verseOrgIds": [
              "2KI.17.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "2KI 17:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "ela mumtase BWANA Mlungu onyu, nao uchamkira na mikonu ya wamaiza wenyu wose.” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.39",
            "verseOrgIds": [
              "2KI.17.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "2KI 17:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elaima ndeweresikireghe, werenughieghe tu tabia rawo ra kala. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.40",
            "verseOrgIds": [
              "2KI.17.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "2KI 17:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa huwo mbari iri rikakaia rikimtasa BWANA, na kudumikia fwana ra milimu yawo, hata na wana wawo na weke wawae wikanugha mfwano ugho hata linu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.41",
            "verseOrgIds": [
              "2KI.17.41"
            ]
          }
        }
