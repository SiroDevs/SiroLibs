        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.24",
            "verseOrgIds": [
              "2KI.8.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 8:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwaka ghwa ikumi na iwi ghwa kubonya nguma kwake Joramu mwana wa Ahabu mzuri wa Israeli, niko Ahazia mwana wa Jehoramu orezoeghe kubonya nguma isanga ja Juda. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.25",
            "verseOrgIds": [
              "2KI.8.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 8:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orekoghe mundu wa irika ja miaka mirongo iwi na iwi ngelo orezoyagha kubonya nguma. Ukabonya nguma Jerusalemu kwa mwaka ghumweri. Mae orewangwagha Athalia nao ni wawae Omri mzuri wa Israeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.26",
            "verseOrgIds": [
              "2KI.8.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 8:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao moni wori orebonyereghe mawiwi mesonyi kwa BWANA kara kara na Ahabu, angu orekoghe mlamu wa kinyumba cha Ahabu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.27",
            "verseOrgIds": [
              "2KI.8.27"
            ]
          }
        }
      ]
    },
