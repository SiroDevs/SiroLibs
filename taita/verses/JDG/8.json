          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kusimwa kwa kutua kwa Wamidiani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JDG 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niko wandu wa Efraimu wikamzera Gideoni, “Kwaki kudibonyere huwu? Kwaki kuserediwangagha iji koreghendagha kulwa na Wamidiani?” Wikamrasha kwa kubia. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.1",
            "verseOrgIds": [
              "JDG.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JDG 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao ukawizera, “Da nabonya ilaghoki icha kumchumba inyo? Agha matini ghabonywa ni wandu wa Efraimu ndaghakaia na fwaida mbaa kuchumba agho ghabonywa ni Wabiezeri wandu wa kichuku chapo? ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.2",
            "verseOrgIds": [
              "JDG.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JDG 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mlungu wawingira wabaa wawi wa Wamidiani mkonunyi konyu, Orebu na Zeebu; niki chimu nabonya chedima kukatanishwa na ghenyu?” Gideoni uendaghora huwo, machu ghawo ghikahoa.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.3",
            "verseOrgIds": [
              "JDG.8.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.83.11"
              },
              "items": [
                {
                  "text": "Zab. 83.11",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JDG 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.3",
            "verseOrgIds": [
              "JDG.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JDG 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao Gideoni chiaimweri na wandu wake maghana adadu wikacha na kuruwuka Moda ghwa Jordani; werekoghe wasilwa ela wiko tayari kuwinugha wamaiza. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.4",
            "verseOrgIds": [
              "JDG.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JDG 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukawizera wandu wa Sukothi, “Namlomba muwineke mikate awandu wawuyanughana nani, angu wasilwa na ndighi; nani naawuyawinugha wazuri wa Midiani awo Zeba na Zalimuna.” ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.5",
            "verseOrgIds": [
              "JDG.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JDG 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo wabaa wa Sukothi wikamzera, “Huwo kwameria kuwiwada Zeba na Zalimuna hata difunye mikate kwa ijeshi jako?” ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.6",
            "verseOrgIds": [
              "JDG.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niko Gideoni ukawizera, “Haya, BWANA ukanitesia kuwiwada Zeba na Zalimuna, nichamkaba na minjwa ya kireti, na mtaranganga.” ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.7",
            "verseOrgIds": [
              "JDG.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JDG 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kufuma aho ukaghenda hata Penueli; ukaghora nawo kwa madedo ghaja gheni; ela wandu wa Penueli, wikamtumbulia sa wandu wa Sukothi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.8",
            "verseOrgIds": [
              "JDG.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JDG 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gideoni ukawizera wandu wa Penueli “Ngaghenda na kuwuya kwa sere, nichaghuchikanya ughu mnara.”",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.9",
            "verseOrgIds": [
              "JDG.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JDG 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.9",
            "verseOrgIds": [
              "JDG.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JDG 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Idana Zeba na Zalimuna, werekoghe Karkori chiaimweri na ijeshi jawo, sa wandu elfu ikumi na isanu awo weresigharikieghe kufumanya na ijeshi jose ja wandu wa Mashariki; angu werefueghe masikari ghetumia lufu elfu ighana na mirongo iwi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.10",
            "verseOrgIds": [
              "JDG.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JDG 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gideoni ukachuria kughenda na chia iko mbai mbai ya kireti, mashariki ya Noba na Yokbeha, ukajifutukia jija ijeshi ja wandu wisemanyire na kuwikaba. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.11",
            "verseOrgIds": [
              "JDG.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JDG 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo wazuri wawi wa Midiani, Zeba na Zalimuna wikakimbia, ela ukawiwinga na kuwiwada awo wazuri wawi Zeba na Zalimuna, na ijeshi jose jikangilwa ni wowa.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.12",
            "verseOrgIds": [
              "JDG.8.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JDG 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.12",
            "verseOrgIds": [
              "JDG.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JDG 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niko Gideoni mwana wa Joashi ukawuya kufuma wudenyi kwa chia ejokeria Heresi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.13",
            "verseOrgIds": [
              "JDG.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JDG 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukakwana na mdawana umu wa Sukothi ukamkotia makoto. Uja mdawana ukamuandikia marina ghwa wabaa na waghosi wa Sukothi wandu mirongo mfungade na mfungade. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.14",
            "verseOrgIds": [
              "JDG.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JDG 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukacha kwa wandu wa Sukothi ukawizera, “Olenyi Zeba na Zalimuna hawa, awo morenimenyagha mkighamba, ‘Huwo kwameria kuwiwada Zeba na Zalimuna hata difunye mikate kwa wandu wako wasilwa nandighi?’” ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.15",
            "verseOrgIds": [
              "JDG.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JDG 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukawiwada waja waghosi wa muzi, nao ukawada minjwa ya kireti na mtaranganga, ukawifundisha wandu wa Sukothi kwa kuwikaba nayo; ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.16",
            "verseOrgIds": [
              "JDG.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JDG 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "ukaghuchikanya ghuja mnara ghwa Penueli na kuwibwagha wandu wa ghuja muzi.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.17",
            "verseOrgIds": [
              "JDG.8.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JDG 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.17",
            "verseOrgIds": [
              "JDG.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JDG 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niko ukawizera Zeba na Zalimuna, “Waja wandu morewibwaghieghe Tabori weko hao?” Wikatumbulia, “Seji kuko nikokoni werekoghe; kula umu wawo odefwanana na wana wa mzuri.” ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.18",
            "verseOrgIds": [
              "JDG.8.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JDG 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao ukawizera, “Awo ni wanidu wa mao. Sa iji BWANA uko moyo, wei modewisigha wikaie moyo, sam'bwaghagha.” ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.19",
            "verseOrgIds": [
              "JDG.8.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JDG 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukamzera Jetha mwana wake wa imbiri, “Wuka kuwibwaghe.” Ela uja mdawana nderedimieghe kuwusira lufu lwake, angu orekoghe na wowa, kwa kukaia orekoghe mundu mtini. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.20",
            "verseOrgIds": [
              "JDG.8.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JDG 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niko Zeba na Zalimuna wikaghamba, “Wuka kudibwaghe kumoni, kwa kukaia seji mundu uko, nikokoni na ndighi rake riko.” Nao Gideoni ukawuka, ukawibwagha Zeba na Zalimuna, ukawusa mapambo gherekoghe singonyi kwa ngamila rawo.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.21",
            "verseOrgIds": [
              "JDG.8.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JDG 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.21",
            "verseOrgIds": [
              "JDG.8.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JDG 8:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niko wandu wa Israeli wikamzera Gideoni, “Dibonyere nguma, oho, na mwana wako, na wawayo wori; kwa kukaia kwadikira na mkonu ghwa Wamidiani.” ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.22",
            "verseOrgIds": [
              "JDG.8.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JDG 8:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gideoni ukawizera, “Ini sichaam'bonyera nguma, hata mwana wapo wori; ela BWANA nuo uchaabonya nguma aighu enyu.” ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.23",
            "verseOrgIds": [
              "JDG.8.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JDG 8:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gideoni ukawizera, “Lekenyi nimlombe kilambo chimu; kula umu onyu unineke kipuli cha madu orechidwaeghe wunyika;” (angu Waishmaeli werekoghe wikirwa vipuli va dhahabu) ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.24",
            "verseOrgIds": [
              "JDG.8.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JDG 8:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wikatumbulia, “Dichakuneka kwa kuboilwa.” Wikaala nguwo, na kula mundu ukapotua kipuli orechidwaeghe wunyika. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.25",
            "verseOrgIds": [
              "JDG.8.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JDG 8:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wulemeri ghwa vipuli orenekeloghe, ivo veredwaloghe wunyika ghorekoghe kaavui na kilo mirongo iwi ra dhahabu, kula na mapambo gherekoghe singonyi kwa ngamila, na vipuli, na nguwo ra zambarau rererwalwagha ni wazuri wa Midiani, na kula na iro kola rerengirwagha singonyi kwa ngamila rawo. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.26",
            "verseOrgIds": [
              "JDG.8.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JDG 8:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gideoni ukabonya naivera kwa vilambo ivo, ukaiwika mzinyi kwake Ofra; na Waisraeli wose wikaghenda kuitasa wulalo ghwa Mlungu; na ilagho ijo jikawuya mdegho kwa Gideoni na nyumba yake. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.27",
            "verseOrgIds": [
              "JDG.8.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JDG 8:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niko huwo Midiani ikasimwa ni Waisraeli, hata ndewerewisumbueghe Waisraeli sena anduangi. Isanga ja Israeli jikakaia na sere kwa miaka mirongo ina, matuku ghose Gideoni uko moyo.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.28",
            "verseOrgIds": [
              "JDG.8.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kifwa cha Gideoni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JDG 8:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.28",
            "verseOrgIds": [
              "JDG.8.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JDG 8:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jerubaali mwana wa Joashi ukaghenda na kukaia andenyi ya nyumba yake cheni. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.29",
            "verseOrgIds": [
              "JDG.8.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JDG 8:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gideoni orekoghe na wana wa womi mirongo mfungade, wana wake moni, angu orelowueghe waka wengi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.30",
            "verseOrgIds": [
              "JDG.8.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JDG 8:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na muka wake mzima orekoghe Shekemu wokoni oremvaieghe mwana wa womi, ukammbanga irina jake Abimeleki. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.31",
            "verseOrgIds": [
              "JDG.8.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JDG 8:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao Gideoni mwana wa Joashi ukafwa mghosi wa irangi jiboie, ukarikwa andenyi ya kaburi ya ndee Joashi, aho Ofra muzi ghwa Wabiezeri. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.32",
            "verseOrgIds": [
              "JDG.8.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JDG 8:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyuma ya Gideoni kufwa, wandu wa Israeli wikazoya kutasa Baali, na kubonya Baal-berithi kukaia mlungu ghwawo. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.33",
            "verseOrgIds": [
              "JDG.8.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JDG 8:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na wandu wa Israeli ndeweremkumbukieghe BWANA Mlungu wawo, uo orewivuvueghe kufuma mikonunyi kwa wamaiza wawo wose kula andu; ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.34",
            "verseOrgIds": [
              "JDG.8.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JDG 8:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "hata ndewerewonyereghe wughoma aighu ya nyumba ya Jerubaali (Nuo Gideoni) kwa wundu ghwa wucha ghose orewibonyereghe Waisraeli.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.35",
            "verseOrgIds": [
              "JDG.8.35"
            ]
          }
        }
      ]
    }
