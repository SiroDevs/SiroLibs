              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wikaghuwanga ugho muzi “Dani” kunughana na irina ja wawae, orevaloghe kwa Israeli; ela koimbiri ugho muzi ghorewangwagha Laishi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.29",
            "verseOrgIds": [
