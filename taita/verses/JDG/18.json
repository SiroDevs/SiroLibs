          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niko aho wikaiwika ija milimu erebonyeroghe ni Mika ngelo rose nyumba ya Mlungu erekoghe ikikaia Shilo.",
          "type": "text",
