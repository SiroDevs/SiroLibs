          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niko Wadani wikawika ghuja mlimu wipate kughutasa, na Jonathani mwana wa Gershoni, wawae Musa na wana wawo, werekoghe wakohani kwa mbari ya Dani, hata ituku waja wandu weredwaloghe wunyika. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.30",
            "verseOrgIds": [
              "JDG.18.30"
            ]
          }
        },
