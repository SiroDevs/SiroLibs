          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waamori wikawitangala wandu wa mbari ya Gadi, na kuwiwinga cha isanga ja mighondinyi; hata ndewerewisighieghe kusea cha kirindinyi anduangi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.34",
            "verseOrgIds": [
              "JDG.1.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JDG 1:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waamori wikadua wikikaia Aijaloni, Shaalbimu, na mghondi ghwa Heresi. Ela mbari ya Efraimu na Manase wikawiwika aisi ya nguma yawo wikawibonya wiwidumikieghe.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.35",
            "verseOrgIds": [
              "JDG.1.35"
            ]
          }
        }
