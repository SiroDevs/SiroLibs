          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbari ya Asheri ndeerewiwingieghe awo wandu werekoghe wikikaia andenyi ya iyo mizi ya Ako, Sidoni, Ahlabu, Akzibu, Helba, Afeki, na Rehobu. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.31",
            "verseOrgIds": [
              "JDG.1.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JDG 1:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wandu wa Asheri wikakaianya na waisanga wa Kanaani angu werelemeloghe ni kuwifunya. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.32",
            "verseOrgIds": [
              "JDG.1.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JDG 1:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbari ya Naftali ndeerewiwingieghe awo wandu werekoghe wikikaia andenyi ya mizi ya Beth-shemeshi na Beth-anathi. Wandu wa Naftali werekanyeghe na waisanga wa Kanaani, ela wikawibonya wikaie wadumiki wawo.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.33",
            "verseOrgIds": [
              "JDG.1.33"
            ]
          }
        }
      ]
