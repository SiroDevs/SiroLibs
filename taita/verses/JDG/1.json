          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ela iji Waisraeli wachurikia ndighi wikawidumikisha awo Wakanaani; ela ndewerewiwingieghe anduangi.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.28",
            "verseOrgIds": [
              "JDG.1.28"
            ]
          }
        }
