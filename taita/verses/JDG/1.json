              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uo mundu ukaghenda cha kwa Wahiti, ukaagha muzi aho, ukaghuwanga Luzu na ijo jikawuya irina ja ugho muzi hata idime.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.26",
            "verseOrgIds": [
