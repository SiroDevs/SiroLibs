              "items": [
                {
                  "text": "Lk. 22.30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.28",
            "verseOrgIds": [
              "MAT.19.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 19:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kula umu usighie nyumba, angu waruna wa womi na wa waka, angu ndee, angu mae, angu wana, angu mbuwa kwa wundu ghwapo; uchapata mando ighana na kuchumba chiaimweri na irangi ja kala na kala. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.29",
            "verseOrgIds": [
              "MAT.19.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 19:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ela wengi wiko imbiri wichakaia wa kutua, na wa kutua, wikaie wa imbiri.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.30",
            "verseOrgIds": [
              "MAT.19.30"
            ]
          }
