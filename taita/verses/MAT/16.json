          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Angu Mwana wa Mdamu uchacha na wubaa ghwa Ndee andwamweri na weke malaika wake, nao uchamlipa kula mundu kunughana na mabonyo ghake.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.27",
            "verseOrgIds": [
