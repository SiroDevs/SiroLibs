          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niko Jesu ukawizera wanughi wake, “Mndungi ukakunda kukaia mnughi wapo, suti ukukane uo moni, ughuduke msalaba ghwake uninughe.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.24",
            "verseOrgIds": [
              "MAT.16.24"
            ]
