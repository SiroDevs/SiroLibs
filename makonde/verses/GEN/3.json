            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bahi Yahwe Nnungu nkunnyaulila nnyongo kuchidoni,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.14",
            "verseOrgIds": [
              "GEN.3.14"
            ]
          }
