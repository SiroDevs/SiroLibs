          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anepo Yahwe Nnungu nkunnyaulila ayula nnume kuchidoni,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.17",
            "verseOrgIds": [
              "GEN.3.17"
            ]
          }
        }
      ]
