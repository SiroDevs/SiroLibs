          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Obali na Abimaeli na Seba, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.28",
            "verseOrgIds": [
              "GEN.10.28"
            ]
          }
        },
        {
