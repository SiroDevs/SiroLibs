          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 10:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanu anevo váikelenge kutandikila ku Mesha mpaka ku Sefali, chilambo cha machinga chivêle m'bali wa mashaliki. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.30",
            "verseOrgIds": [
              "GEN.10.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 10:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anevo njo vanu va nnukolo lwanga Shemu kupapatana na matawa lao na luga dyavo na ding'olo dyavo na vilambo vyao.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.31",
            "verseOrgIds": [
              "GEN.10.31"
            ]
          }
        }
      ]
