              "GEN.37.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "GEN 37:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mmahiku ulolo, Vaisumaili nkunsumisa Yusufu aneko ku Misili kwa munu yumo uvanchema Potifa, afisa yumo wa Falao, nfalume wa ku Misili. Potifa ávele nkulu wa valinzi va paing'ande ya nfalume.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.36",
            "verseOrgIds": [
              "GEN.37.36"
            ]
          }
        }
      ]
