            }
          ]
        },
        {
          "text": "Iblahimu nkuchidoni, “Hambi kwa kuva ǹnikudungila kutangola na Nang'olo, ikànava nangu nni litutunga na liu, bahi leka ngutangole kavila. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.27",
            "verseOrgIds": [
              "GEN.18.27"
            ]
          }
        },
        {
          "name": "verse",
