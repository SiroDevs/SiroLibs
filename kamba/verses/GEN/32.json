          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yakovo eeyĩendea, na alaĩka ma Ngai makomana nake. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.1",
            "verseOrgIds": [
              "GEN.32.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 32:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yakovo amona asya, Nguthu ya Ngai nĩ ĩno: na aveta vandũ vau syĩtwa yavo Maanaimu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.2",
            "verseOrgIds": [
              "GEN.32.2"
            ]
          }
        },
        {
