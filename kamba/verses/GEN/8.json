          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "nasyo nthongo sya kyũngũ kyu na mbũthi sya ĩtunĩ syavingwa, na mbua kuma ĩtunĩ yasiĩĩwa; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.2",
            "verseOrgIds": [
              "GEN.8.2"
            ]
          }
        },
        {
