        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.19",
            "verseOrgIds": [
              "GEN.8.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Noa aakĩa Yeova kĩthembeo, na oosa ya kĩla nyamũ ntheu, na kĩla nyũnyi ntheu, na athemba nthembo sya kũvĩvw’a kĩthembeonĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.20",
            "verseOrgIds": [
              "GEN.8.20"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
