                {
                  "text": "Mwa 7.13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.16",
            "verseOrgIds": [
              "GEN.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vamwe naku umya kĩla kĩ thayũ kyonthe kĩ vamwe naku kya mĩĩ yonthe, nyũnyi, o na indo, na kĩla kĩtambũkaa kyonthe, kĩla kĩtambũkaa ĩũlũ wa nthĩ; nĩ kana isyaanĩe mũno nthĩ, na kwongeleka, na kwingĩva ĩũlũ wa nthĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.17",
            "verseOrgIds": [
              "GEN.8.17"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
