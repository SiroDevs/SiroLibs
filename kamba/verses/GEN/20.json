              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Avalaamu athi kyalo kuma vo aende nthĩ ya ngalĩ ya Ĩtheo, na ekala katĩ wa Katesi na Suli; na ekala ũeni kũu Ngelali. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.20.1",
            "verseOrgIds": [
              "GEN.20.1"
            ]
          }
        },
        {
