              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.20.11",
            "verseOrgIds": [
              "GEN.20.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 20:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩngĩ nĩ w’o nĩ mwĩĩtu‐a‐ia, mwĩĩtu wa nau, ĩndĩ ti mwĩĩtu wa mwaitũ; na atw’ĩka mũka wakwa: ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.20.12",
            "verseOrgIds": [
              "GEN.20.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.11.29"
              },
              "items": [
                {
                  "text": "Mwa 11.29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.20.12",
            "verseOrgIds": [
              "GEN.20.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 20:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "na kweethĩwa, yĩla Ngai watumie nĩthi kyalo kuma nyũmbanĩ ya nau, namwĩa, Ũseo waku ũla wĩmbĩkaa nĩ ũũ: kĩla vandũ vala twĩvikaa, ũndũ wakwa aasya, Nĩ mwana‐a‐ia. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.20.13",
            "verseOrgIds": [
              "GEN.20.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.12.1"
              },
              "items": [
                {
                  "text": "Mwa 12.1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.12.13"
              },
              "items": [
                {
                  "text": "13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.20.13",
            "verseOrgIds": [
              "GEN.20.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 20:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Avimeleki oosa malondu na ng’ombe, na athũkũmi aũme na eĩtu, amũnenga Avalaamu, na amũtũngĩa Sala mũka wake. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.20.14",
            "verseOrgIds": [
              "GEN.20.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 20:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Avimeleki amwĩa, Sisya, nthĩ yakwa yĩ mbee waku: ĩkala vala ũkwenda. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.20.15",
            "verseOrgIds": [
              "GEN.20.15"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.13.9"
              },
              "items": [
                {
                  "text": "Mwa 13.9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.20.15",
            "verseOrgIds": [
              "GEN.20.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 20:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake amwĩa Sala, Sisya, nĩnanenga mwana‐a‐au ilungu ngili sya vetha: sisya, kwaku nĩ sya ũkũvw’ĩka metho kwa onthe ala me vamwe naku; na ĩngĩ nũlũngalĩtw’e kwa onthe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.20.16",
            "verseOrgIds": [
              "GEN.20.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 20:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Avalaamu avoya Ngai: na Ngai avosya Avĩmeleki, na mũka wake, na athũkũmi make eĩtu; na masyaa syana. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.20.17",
            "verseOrgIds": [
              "GEN.20.17"
            ]
          }
        },
