        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Avalaamu asya ũndũ wa Sala mũka wake, Nĩwe mwĩĩtuwa‐ia: na Avimeleki mũsumbĩ wa Ngelali atũmana, na amwosa Sala. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.20.2",
            "verseOrgIds": [
              "GEN.20.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ Ngai amũkĩa Avimeleki ndotonĩ ya ũtukũ, na amwĩa, Sisya, we wĩ o mũndũ mũkw’ũ, kwondũ wa mũndũ mũka ũla wosete; nĩkwĩthĩwa nĩ mũka wa mũndũ. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.20.3",
            "verseOrgIds": [
              "GEN.20.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
