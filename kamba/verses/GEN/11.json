          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ Yeova amanyaĩĩkya ĩũlũ wa nthĩ yonthe kuma vau: na maeka kwaka ndũa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.8",
            "verseOrgIds": [
              "GEN.11.8"
            ]
          }
        },
        {
