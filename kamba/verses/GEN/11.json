              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Alivakasati ekala ĩtina wa kũsyaa Siela myaka maana ana na ĩtatũ, o akĩsyaa ana na eĩtu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.13",
