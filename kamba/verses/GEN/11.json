          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Semu ekala ĩtina wa kũsyaa Alivakasati myaka maana atano, o akĩsyaa ana na eĩtu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.11",
