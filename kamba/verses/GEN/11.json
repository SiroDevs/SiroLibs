          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwondũ wa ũu syĩtwa yayo yeetwa Mbaveli; nũndũ nĩvo Yeova wathokoanĩsye kĩthyomo kya nthĩ yonthe: na kuma vau Yeova amanyaĩĩkya ĩũlũ wa nthĩ yonthe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.9",
            "verseOrgIds": [
              "GEN.11.9"
            ]
          }
        }
      ]
