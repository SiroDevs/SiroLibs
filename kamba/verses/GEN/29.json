          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yakovo amwĩa Lavani, Nenga mũka wakwa, nĩlike kwake nũndũ matukũ makwa nĩ meanĩu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.21",
            "verseOrgIds": [
              "GEN.29.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 29:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Lavani oomban’ya andũ onthe ma vandũ vau, avoka mboka. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.22",
            "verseOrgIds": [
              "GEN.29.22"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
