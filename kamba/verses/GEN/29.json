              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.14",
            "verseOrgIds": [
              "GEN.29.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 29:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Lavani amwĩa Yakovo, Nĩkwĩthĩwa wĩ mwana‐a‐asa, we, kwondũ wa ũu ũnthũkũme mana? Ndavya, ĩtuvi yaku yĩkeethĩwa kyaũ? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.15",
            "verseOrgIds": [
              "GEN.29.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 29:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ Lavani aĩ na eĩtu elĩ: ũla mũkũũ syĩtwa yake eetawa Lea, na ũla mũnini syĩtwa yake eetawa Lakeli. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.16",
            "verseOrgIds": [
              "GEN.29.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 29:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Lea, metho make matyaĩ na vinya, ĩndĩ Lakeli aĩ mwanake na aĩ na wũmbe mũseo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.17",
            "verseOrgIds": [
              "GEN.29.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 29:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yakovo amwendete Lakeli; nake asya, Ngakũthũkũma myaka mũonza kwondũ wa Lakeli mwĩĩtu waku ũla mũnini. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.18",
            "verseOrgIds": [
              "GEN.29.18"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.30.26"
              },
              "items": [
                {
                  "text": "Mwa 30.26",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.31.41"
              },
              "items": [
                {
                  "text": "31.41",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.18",
            "verseOrgIds": [
              "GEN.29.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 29:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Lavani amwĩa, Kavaa nĩkũnenge we, kwĩ kũmũnenga mũndũ ũngĩ: ĩkalaa kwakwa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.19",
            "verseOrgIds": [
              "GEN.29.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 29:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yakovo athũkũma myaka mũonza kwondũ wa Lakeli; na kwake yeethĩwa o ta matukũ mavũthũ, nũndũ wa wendo ũla wamwendaa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.20",
            "verseOrgIds": [
              "GEN.29.20"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
