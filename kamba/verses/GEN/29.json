              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yeova oona kana Lea nĩ mũmene, na amũnenga kũsyaa: ĩndĩ Lakeli aĩ ngũngũ. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.31",
            "verseOrgIds": [
