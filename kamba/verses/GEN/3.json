                "loc": "MAT.10.16"
              },
              "items": [
                {
                  "text": "Mt 10.16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.12.9"
              },
              "items": [
                {
                  "text": "Ũvu 12.9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
