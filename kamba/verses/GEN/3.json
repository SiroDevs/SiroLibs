                {
                  "text": "Mika 7.17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.14",
            "verseOrgIds": [
              "GEN.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "na ngeekĩa ũmaitha katĩ wenyu we na mũndũ mũka, na katĩ wa ũsyao waku na ũsyao wake: akatumba mũtwe waku, naku ũkatumba kĩtiinyo kyake. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.15",
            "verseOrgIds": [
              "GEN.3.15"
            ]
          }
        },
