                "loc": "GEN.17.20"
              },
              "items": [
                {
                  "text": "Mwa 17.20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.25.12+GEN.25.13+GEN.25.14+GEN.25.15+GEN.25.16"
              },
              "items": [
                {
                  "text": "25.12–16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.10",
            "verseOrgIds": [
              "GEN.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mũlaĩka wa Yeova amwĩa, Sisya, wĩ ĩvu, na ũkasyaa mwana; na ũkamwĩta syĩtwa yake Isumaeli, nũndũ Yeova nĩwew’a thĩna waku. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.11",
            "verseOrgIds": [
              "GEN.16.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.29.32"
              },
              "items": [
                {
                  "text": "Mwa 29.32",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.11",
            "verseOrgIds": [
              "GEN.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake akeethĩwa ta ĩng’oi ya kĩthekanĩ katĩ wa andũ; kw’oko kwake kũkeethĩwa ĩũlũ wa kĩla mũndũ, na kw’oko kwa kĩla mũndũ ĩũlũ wake; nake akatũa elekanĩle na ana‐a‐ĩthe make onthe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.12",
            "verseOrgIds": [
              "GEN.16.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.25.18"
              },
              "items": [
                {
                  "text": "Mwa 25.18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.39.5+JOB.39.6+JOB.39.7+JOB.39.8"
              },
              "items": [
                {
                  "text": "Yovu 39.5–8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.12",
            "verseOrgIds": [
              "GEN.16.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na eeta syĩtwa ya Yeova ũla waneenie nake, Nue Ngai ũla wonaa: nũndũ aisye, O na vaa nĩnamwonea ũla ũnziasya? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.13",
            "verseOrgIds": [
              "GEN.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwondũ wa ũu kĩthima kyeetwa Mbeeli‐laai‐loi; sisya, kĩ katĩ wa Katesi na Mbeleti.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.14",
            "verseOrgIds": [
              "GEN.16.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
