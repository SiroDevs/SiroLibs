          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.14",
            "verseOrgIds": [
              "GEN.16.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Akalĩ amũsyaĩa Avalamu mwana: na Avalamu amwĩta mwana wake Isumaeli, ũla Akali wasyaie. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.15",
            "verseOrgIds": [
              "GEN.16.15"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.16.11"
              },
              "items": [
                {
                  "text": "Mwa 16.11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.15",
            "verseOrgIds": [
              "GEN.16.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Avalamu aĩ wa myaka mĩongo nyanya na thanthatũ, yĩla Akali wamũsyaĩe Avalamu Isumaeli.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.16",
            "verseOrgIds": [
              "GEN.16.16"
            ]
          }
        }
      ]
