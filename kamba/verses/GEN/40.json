              "items": [
                {
                  "text": "Nda 2.36",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.12",
            "verseOrgIds": [
              "GEN.40.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 40:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "o ĩtina wa matukũ atatũ Valao akookĩlya mũtwe waku, na akakũtũnga wĩanĩ waku: naku ũkanengane kĩkombe kya Valao kw’okonĩ kwake, o tondũ weekaa mbee yĩla waĩ mũnengani wake wa mbinyu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.13",
            "verseOrgIds": [
              "GEN.40.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
