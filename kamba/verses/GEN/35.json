        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.9",
            "verseOrgIds": [
              "GEN.35.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 35:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Ngai amwĩa, Syĩtwa yaku nĩ Yakovo: ndũketwa ĩngĩ syĩtwa yaku Yakovo, ĩndĩ Isilaeli nĩyo yĩĩthĩwa syĩtwa yaku: na amwĩta syĩtwa yake Isilaeli. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.10",
            "verseOrgIds": [
              "GEN.35.10"
            ]
          }
        },
