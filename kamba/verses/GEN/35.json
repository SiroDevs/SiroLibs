          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Ndevola mũei wa Leveka akw’a, na athikwa ĩtheo wa Mbethi‐eli ĩtina wa mũtĩ wa mwaloni: na syĩtwa yaw’o weetawa Mwaloni‐mbakuthi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.8",
            "verseOrgIds": [
              "GEN.35.8"
            ]
          }
        },
