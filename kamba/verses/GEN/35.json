              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "ana ma Lakeli: Yosevu na Mbenyamini; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.24",
            "verseOrgIds": [
              "GEN.35.24"
            ]
