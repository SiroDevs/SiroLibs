              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na matukũ ma Isaka maĩ myaka ĩana na mĩongo nyanya. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.28",
            "verseOrgIds": [
