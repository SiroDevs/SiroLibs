        },
        {
          "text": "Na Ngai amumĩlĩla Yakovo ĩngĩ, auma Vatani‐alamu, na amũathima. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.9",
            "verseOrgIds": [
