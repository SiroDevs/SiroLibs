            "number": "7",
            "style": "v",
            "sid": "GEN 35:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na aaka kĩthembeo vau, na aveeta vandũ vau Eli‐Mbethi‐eli; nĩkwĩthĩwa nĩvo Ngai weyonanĩsye kwake, yĩla wakĩĩte kuma mbee wa ũthyũ wa mwana‐a‐inyia. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.7",
            "verseOrgIds": [
              "GEN.35.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
