              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "na ana ma Mbila, mũthũkũmi mwĩĩtu wa Lakeli: Ndani na Navitali; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.25",
            "verseOrgIds": [
              "GEN.35.25"
            ]
          }
        },
