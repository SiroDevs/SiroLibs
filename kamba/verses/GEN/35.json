              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "na ana ma Nziliva, mũthũkũmi mwĩĩtu wa Lea: Ngati na Aseli; asu nĩo ana ma Yakovo, ala wasyaĩwe Vatani‐alamu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.26",
            "verseOrgIds": [
