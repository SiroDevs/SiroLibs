              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ ana ma Yakovo maĩ ĩkũmi na elĩ: ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.22",
            "verseOrgIds": [
