          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kweethĩwa, akyaũnya na vinya, mwĩsikya amwĩa, Ndũkakĩe; nũndũ yu nũkwĩthĩwa na mwana ũngĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.17",
            "verseOrgIds": [
              "GEN.35.17"
            ]
          }
        },
        {
