          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "ana ma Lea: Leuveni, ĩkithathi ya Yakovo, na Simeoni, na Livai, na Yuta, na Isakali, na Nzevuluni; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.23",
            "verseOrgIds": [
              "GEN.35.23"
            ]
          }
        },
