          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "na nthĩ ĩla namanengie Avalaamu na Isaka, ngakũnenga we, na ũsyao waku ĩtina waku ngaũnenga nthĩ ĩsu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.12",
            "verseOrgIds": [
              "GEN.35.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 35:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Ngai ambata kuma vala ũĩ o vandũ vala waneenee nake. ",
          "type": "text",
