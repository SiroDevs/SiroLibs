              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ũtũo woo waĩ kuma Mesa, ũendete Sevali, kĩĩma kya wumĩlonĩ wa syũa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.30",
            "verseOrgIds": [
              "GEN.10.30"
            ]
          }
        },
        {
