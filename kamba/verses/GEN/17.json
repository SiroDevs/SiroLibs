              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Avalaamu amwĩa Ngai, Ame, kethĩwa Isumaeli nĩwĩkalaa thayũ mbee waku! ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.18",
