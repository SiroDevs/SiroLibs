          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ũla wa matukũ nyanya katĩ wenyu akaĩkwa, kĩla mũndũ mũũme mosyaanĩonĩ menyu, ũla ũsyaĩtwe nyũmbanĩ, kana ũla ũthooetwe na mbesa kwa mũeni o na wĩva w’onthe ũte wa ũsyao waku. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.12",
            "verseOrgIds": [
              "GEN.17.12"
            ]
          }
        },
