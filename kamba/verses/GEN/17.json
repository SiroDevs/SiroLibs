          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ngakwingĩvya mũno mũnene, na ngakũtw’ĩkĩthya mbaĩ, na asumbĩ makauma kwaku. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.6",
