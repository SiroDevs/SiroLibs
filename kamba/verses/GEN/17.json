          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakwa ngamũathima, na ĩngĩ ngakũnenga mwana kuma kwake: ĩĩ, ngamũathima, nake akeethĩwa inyia wa mbaĩ; asumbĩ ma andũ makauma kwake. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.16",
            "verseOrgIds": [
              "GEN.17.16"
            ]
          }
