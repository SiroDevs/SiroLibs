                "loc": "GEN.7.4"
              },
              "items": [
                {
                  "text": "Mwa 7.4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2PE.2.5"
              },
              "items": [
                {
                  "text": "2 Vet 2.5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.17",
            "verseOrgIds": [
              "GEN.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ ngalũlũmĩlya ũtianĩo wakwa naku; naku ũkalika ngalawanĩ, we, na ana maku, na mũkau, na aka ma ana maku vamwe naku. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.18",
            "verseOrgIds": [
              "GEN.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kĩla kĩndũ kĩ thayũ kya mĩĩ yonthe, ilĩ sya kĩla mũthemba ũkaete nthĩnĩ wa ngalawa, kũsyĩkalya thayũ vamwe naku; ikeethĩwa nũme na nga. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.19",
            "verseOrgIds": [
              "GEN.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyũnyi o mũthemba wasyo, na indo o mũthemba wasyo, na kĩla kasamũ katambũkaa ka nthĩ o mũthemba wako, ili sya kĩla mũthemba w’onthe ikakũkĩa, ũsyĩkalye thayũ. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.20",
            "verseOrgIds": [
              "GEN.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naku ũkeyosee lĩu w’onthe ũla ũĩsawa, wĩyũmbanĩsye; na ũkeethĩwa wĩ lĩu waku, na wasyo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.21",
            "verseOrgIds": [
              "GEN.6.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noa eeka ũu; kwĩanana na w’onthe ũla Ngai wamwĩaĩe, nĩw’o wekie. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.22",
            "verseOrgIds": [
              "GEN.6.22"
            ]
          }
