          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yeova asya, Ngaananga mũndũ ũla natw’ĩkĩthisye aume ĩũlũ wa nthĩ; mũndũ, vamwe na nyamũ, na kĩla kasamũ katambũkaa, na nyũnyi sya yayaya; nĩkwĩthĩwa nĩngwĩlila nũndũ nĩnasyũmbie. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.7",
            "verseOrgIds": [
              "GEN.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ Noa nĩwendeesye mbee wa Yeova. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.8",
            "verseOrgIds": [
              "GEN.6.8"
            ]
          }
