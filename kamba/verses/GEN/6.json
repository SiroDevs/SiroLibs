          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nevilimu maĩ kũũ nthĩ matukũ asu, o na ĩtina wa ĩvinda yĩu, yĩla ana ma Ngai malikile kwa eĩtu ma andũ, na mamasyaĩa syana: syo syaĩ ngũmbaũ tene, andũ me nguma.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.4",
            "verseOrgIds": [
              "GEN.6.4"
            ]
          }
        }
      ]
