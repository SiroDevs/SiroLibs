            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mosyaanĩo ma Noa nĩmo aa. Noa aĩ mũndũ mũlũngalu, na mwĩanĩu nzyawanĩ sya ĩvinda yake: Noa aendanasya na Ngai. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.9",
            "verseOrgIds": [
              "GEN.6.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
