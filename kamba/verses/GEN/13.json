        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Loto ookĩlya metho, oona Ũiĩ wa Yolotani w’onthe, kana wĩ na manzĩ ngalĩ syonthe, Yeova atanamba kwananga Sotomo na Ngomola, o ta ũla mũũnda wa Yeova, ta nthĩ ya Misili, ũendete Nzoali. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.10",
            "verseOrgIds": [
              "GEN.13.10"
            ]
          }
        },
