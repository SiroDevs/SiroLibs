                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.14",
            "verseOrgIds": [
              "GEN.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "nũndũ nthĩ yonthe ĩla ũkwona, ngakũnenga we, na ũsyao waku tene na tene. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.15",
            "verseOrgIds": [
              "GEN.13.15"
            ]
          }
        },
        {
