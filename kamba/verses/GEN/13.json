              "GEN.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nthĩ yonthe ndĩ mbee waku? Nĩngũkwĩsũva, ũtaanĩsye nakwa: wenda kũthi ngalĩ ya kw’oko kwa aka, nakwa ngathi ngalĩ ya kw’oko kwa aũme; kana wathi ngalĩ ya kw’oko kwa aũme, nakwa ngathi ngalĩ ya kw’oko kwa aka. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.9",
            "verseOrgIds": [
              "GEN.13.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
