            "verseOrgIds": [
              "GEN.25.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "GEN 25:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yakovo amũnenga Esau kĩmũtũ na ũsũũ wa ndengũ; nake aya na anyw’a, na ookĩla, na akwata nzĩa yake, na athi: ũu nĩw’o Esau wavũthisye ũkithathi wake.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.34",
