            "sid": "GEN 25:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ Isaka amwendaa Esau, nũndũ aĩsaa nyama sya nzyĩma yake: na Leveka amwendaa Yakovo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.28",
            "verseOrgIds": [
              "GEN.25.28"
            ]
          }
        },
