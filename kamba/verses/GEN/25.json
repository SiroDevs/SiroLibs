            }
          ]
        },
        {
          "text": "Na aa nĩmo mosyaanĩo ma Isaka, mwana wa Avalaamu: Avalaamu asyaa Isaka: ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.19",
            "verseOrgIds": [
              "GEN.25.19"
            ]
