          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ĩkalaa ũeni nthĩ ĩno, nakwa ngeethĩwa vamwe naku, na ngakũathima; nũndũ nthĩ ii syonthe ngakũnenga, we na ũsyao waku, na ngalũlũmĩlya wĩvĩto ũla neevĩtĩe Avalaamu ĩthe waku; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.3",
            "verseOrgIds": [
              "GEN.26.3"
            ]
          }
        },
        {
