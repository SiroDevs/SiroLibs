          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Isaka atũaa Ngelali: ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.6",
            "verseOrgIds": [
              "GEN.26.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 26:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "na andũ ma vandũ vau mamũkũlya ũndũ wa mũka wake; nake amea, Nĩ mwĩĩtu‐a‐ia: nũndũ akĩaa kwasya, Nĩ mũka wakwa; akĩsũanĩa, andũ ma vandũ vau maikese ũmbũaa nũndũ wa Leveka; nũndũ aĩ mwanake kwa kũsiw’a. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.7",
            "verseOrgIds": [
              "GEN.26.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
