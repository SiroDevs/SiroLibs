          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "kana ndũkatwĩka ũthũku, tondũ ithyĩ tũtaakũkiita, na tondũ ithyĩ tũtaakwĩka ũndũ ate o ũseo, na twakumya kwitũ na mũuo: naku yu wĩ mũathimwa wa Yeova. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.29",
            "verseOrgIds": [
