          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na menza kĩthima kĩngĩ, nakyo makĩtetanĩsya: na akĩta syĩtwa yakyo Sitina. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.21",
            "verseOrgIds": [
              "GEN.26.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 26:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na auma ku, enza kĩthima kĩngĩ; na kyu maiaakĩtetanĩsya: na akĩta syĩtwa yakyo Leovothi; na asya, Nũndũ yu Yeova nũtwonee ũthei, naitũ tũkongeleka ĩ nthĩ.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.22",
            "verseOrgIds": [
