          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ ithima syonthe ila athũkũmi ma ĩthe wake menzie matukũ ma ĩthe wake Avalaamu, Avilisiti nĩmailindĩte, na kũsyusũsya mũthanga. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.15",
            "verseOrgIds": [
              "GEN.26.15"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
