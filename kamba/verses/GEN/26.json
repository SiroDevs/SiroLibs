          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na athũkũmi ma Isaka menza mwandanĩ, na vo moona kĩthima kya manzĩ meũvulutya. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.19",
            "verseOrgIds": [
              "GEN.26.19"
