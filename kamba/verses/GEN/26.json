              },
              "items": [
                {
                  "text": "Mwa 21.30",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.15",
            "verseOrgIds": [
              "GEN.26.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 26:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Avimeleki amwĩa Isaka, Uma kwitũ; nũndũ wĩ vinya mũno kwĩ ithyĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.16",
            "verseOrgIds": [
              "GEN.26.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 26:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Isaka auma kũu, na aaka maeema mwandanĩ wa Ngelali, na atũa kw’o.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.17",
            "verseOrgIds": [
              "GEN.26.17"
            ]
          }
        }
      ]
    },
