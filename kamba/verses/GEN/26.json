            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.10",
            "verseOrgIds": [
              "GEN.26.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Avimeleki ameaĩa andũ onthe, akĩmea, Ũla ũkakiita mũndũ ũũ kana mũka wake ndakatĩa kũawa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.11",
            "verseOrgIds": [
              "GEN.26.11"
            ]
          }
        }
