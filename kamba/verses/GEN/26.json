          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "nĩkwĩthĩwa Avalaamu nĩwew’aa wasya wakwa, na asũvĩaa wĩaĩo wakwa, na myamũlo yakwa, na motw’ĩo makwa, na mĩao yakwa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.5",
            "verseOrgIds": [
              "GEN.26.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
