          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Isaka avanda nthĩ ĩsu, na oona mwaka ũsu kũndũ ĩana: na Yeova amũathima. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.12",
