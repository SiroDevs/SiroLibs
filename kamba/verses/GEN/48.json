                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.35.12"
              },
              "items": [
                {
                  "text": "12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.4",
            "verseOrgIds": [
              "GEN.48.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 48:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na yu ĩndĩ ana maku elĩ, ala wasyaĩwe nthĩ ya Misili ndanoka kwaku Misili, nĩ makwa; Evalaimu na Manase, makeethĩwa makwa, o ta Leuveni na Simeoni. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.5",
            "verseOrgIds": [
              "GEN.48.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.46.20"
              },
              "items": [
                {
                  "text": "Mwa 46.20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.14.4"
              },
              "items": [
                {
                  "text": "Yos 14.4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.5",
            "verseOrgIds": [
              "GEN.48.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 48:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ũsyao waku, ũla ũkasyaa ĩtina wa aa, ũkeethĩwa waku; makeetawa kũatĩĩa syĩtwa ya ana‐a‐ĩthe moo ũtiĩwanĩ woo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.6",
            "verseOrgIds": [
              "GEN.48.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 48:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakwa, yĩla naumĩte Vatani, nakw’ĩĩwe nĩ Lakeli nzĩanĩ nthĩ ya Kanaani, yĩla vatiele o mũendo nĩvike Evilathi: na namũthikie vo nzĩanĩ ya Evilathi (nĩyo Mbethi‐leemu). ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.7",
            "verseOrgIds": [
              "GEN.48.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
