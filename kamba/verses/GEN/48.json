                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 48:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.7",
            "verseOrgIds": [
              "GEN.48.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 48:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Isilaeli oona ana ma Yosevu, na akũlya, Aa naaũ? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.8",
            "verseOrgIds": [
              "GEN.48.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 48:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yosevu amwĩa ĩthe, Aa nĩ ana makwa, ala Ngai wanengee kũũ. Na amwĩa, Nĩngũkwĩsũva, maete vaa nĩĩ, nakwa nĩngũmaathima. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.9",
            "verseOrgIds": [
              "GEN.48.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.33.5"
              },
              "items": [
                {
                  "text": "Mwa 33.5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.9",
            "verseOrgIds": [
              "GEN.48.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 48:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ metho ma Isilaeli maĩ mbindu nũndũ wa kũkũa, ũndũ ũtatonya kwona. Na amathengeesya kwake, na amamumunya, na amevĩtĩĩsya. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.10",
            "verseOrgIds": [
              "GEN.48.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 48:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Isilaeli amwĩa Yosevu, Ndyaatalĩlya kwona ũthyũ waku: na, sisya, Ngai nũnengete kwona ũsyao waku naw’o. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.11",
            "verseOrgIds": [
              "GEN.48.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.45.26"
              },
              "items": [
                {
                  "text": "Mwa 45.26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.11",
            "verseOrgIds": [
              "GEN.48.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 48:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yosevu amaumya katĩ wa mau make; na eekunamya ũthyũ wake welekele nthĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.12",
            "verseOrgIds": [
              "GEN.48.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 48:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yosevu amatwaa me elĩ, Evalaimu kw’okonĩ kwake kwa aũme elekele kw’oko kwa aka kwa Isilaeli, na Manase kw’okonĩ kwake kwa aka elekele kw’oko kwa aũme kwa Isilaeli, amathengeesya vala ũĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.13",
            "verseOrgIds": [
              "GEN.48.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 48:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Isilaeli atambũũkya kw’oko kwake kwa aũme, ailĩĩla mũtwenĩ wa Evalaimu, ũla waĩ mũnini, na kw’oko kwake kwa aka ailĩĩla mũtwenĩ wa Manase, aivĩtan’ya moko make kwa kũmanya; nũndũ Manase aĩ ĩkithathi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.14",
            "verseOrgIds": [
              "GEN.48.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 48:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na amũathima Yosevu, na asya, Ngai ũla aasa makwa Avalaamu na Isaka maendaa mbee wake, Ngai ũla wandĩthisye thayũ wakwa w’onthe kũvika mũnthĩ ũũ, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.15",
            "verseOrgIds": [
              "GEN.48.15"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.17.1"
              },
              "items": [
                {
                  "text": "Mwa 17.1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.24.40"
              },
              "items": [
                {
                  "text": "24.40",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.15",
            "verseOrgIds": [
              "GEN.48.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 48:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "mũlaĩka ũla wambovoisye kuma ũthũkunĩ w’onthe, aathime imwana; na syĩtwa yakwa yĩtanĩaw’e nasyo, na syĩtwa ya aasa makwa Avalaamu na Isaka; nao nĩmeane methĩwe nguthu katĩ wa nthĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.16",
            "verseOrgIds": [
              "GEN.48.16"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.4.9"
              },
              "items": [
                {
                  "text": "2 Sam 4.9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.63.9"
              },
              "items": [
                {
                  "text": "Isa 63.9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.16",
            "verseOrgIds": [
              "GEN.48.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 48:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yosevu oona kana ĩthe wake ailĩĩla kw’oko kwake kwa aũme mũtwenĩ wa Evalaimu, ndaendeew’a: na ookĩlya kw’oko kwa ĩthe, nĩ kana akumye mũtwenĩ wa Evalaimu, ailĩĩle mũtwenĩ wa Manase. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.17",
            "verseOrgIds": [
              "GEN.48.17"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.48.14"
              },
              "items": [
                {
                  "text": "Mwa 48.14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.17",
            "verseOrgIds": [
              "GEN.48.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 48:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yosevu amwĩa ĩthe, Ti w’o, nau; nũndũ ũũ nĩwe ĩkithathi; ilĩĩla kw’oko kwaku kwa aũme mũtwenĩ wake. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.18",
            "verseOrgIds": [
              "GEN.48.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 48:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩthe alea, na amwĩa, Nĩnĩsĩ, mwana wakwa, nĩnĩsĩ; nake we akatw’ĩka mbaĩ, nake we akeethĩwa mũnene: ĩndĩ nĩ w’o mũinae akeethĩwa mũnene kwĩ we, na ũsyao wake ũkatw’ĩka mbaĩ mbingĩ mũno. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.19",
            "verseOrgIds": [
              "GEN.48.19"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.2.19"
              },
              "items": [
