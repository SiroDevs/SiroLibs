            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.16",
            "verseOrgIds": [
              "GEN.23.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ kĩsesi kya Eveloni, kĩla kyaĩ nthĩnĩ wa Makivela, kĩla kyaĩ mbee wa Mamile, kĩsesi, na ngunga ĩla yaĩ nthĩnĩ wakyo, na mĩtĩ yonthe ĩla yaĩ kĩsesinĩ, ĩla yaĩ nthĩnĩ wa mĩvaka yakyo yonthe, kyalũlũmĩlw’a ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.17",
            "verseOrgIds": [
              "GEN.23.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "kyatw’ĩka kya Avalaamu ki, ana ma Ethi me vo, mbee wa onthe ala malikaa mbingilonĩ ya ndũa yake. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.18",
            "verseOrgIds": [
              "GEN.23.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 23:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩtina wa ũu, Avalaamu athika Sala mũka wake ngunganĩ ya kĩsesi kĩ Makivela mbee wa Mamile (nĩyo Eviloni), kũu nthĩ ya Kanaani. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.19",
            "verseOrgIds": [
              "GEN.23.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 23:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kĩsesi, na ngunga ĩla yaĩ nthĩnĩ wakyo, kyalũlũmĩlw’a kwa Avalaamu nĩ ana ma Ethi kĩthĩwe vandũ va mbũa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.20",
            "verseOrgIds": [
              "GEN.23.20"
            ]
          }
        },
