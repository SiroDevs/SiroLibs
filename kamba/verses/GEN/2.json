            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.9",
            "verseOrgIds": [
              "GEN.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ũsĩ waumĩte Eteni wa kũnyithya mũũnda; na kuma vau wataanĩsya, watw’ĩka mbũsĩ inya. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.10",
            "verseOrgIds": [
              "GEN.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Syĩtwa ya ũla wa mbee nĩ Visoni: nĩw’o ũthyũlũlũkĩte nthĩ yonthe ya Avila, kũla kwĩ thaavu; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.11",
            "verseOrgIds": [
              "GEN.2.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.25.18"
              },
              "items": [
                {
                  "text": "Mwa 25.18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.15.7"
              },
              "items": [
                {
                  "text": "1 Sam 15.7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.11",
            "verseOrgIds": [
              "GEN.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "na thaavu wa nthĩ ĩsu nĩ mũseo: ve veteliumu na tũvila twa nzumalati. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.12",
            "verseOrgIds": [
              "GEN.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na syĩtwa ya ũsĩ wa kelĩ nĩ Ngioni: nĩw’o ũthyũlũlũkĩte nthĩ yonthe ya Kusi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.13",
            "verseOrgIds": [
              "GEN.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na syĩtwa ya ũsĩ wa katatũ nĩ Itekelĩ: nĩw’o ũvĩtĩle mbee wa Asũli. Na ũsĩ wa kana nĩ Euvalati. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.14",
            "verseOrgIds": [
              "GEN.2.14"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.10.4"
              },
              "items": [
                {
                  "text": "Nda 10.4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.14",
            "verseOrgIds": [
              "GEN.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yeova Ngai oosa mũndũ, na amwia mũũndanĩ wa Eteni oseũvasye na kũsũvĩaa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.15",
            "verseOrgIds": [
              "GEN.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yeova Ngai amwĩaĩa mũndũ, akĩmwĩa, Wa kĩla mũtĩ wa mũũndanĩ nũtonya ũya o ũndũ ũkwenda: ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.16",
            "verseOrgIds": [
              "GEN.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "ĩndĩ wa mũtĩ wa kũmanyĩthya ũseo na ũthũku, ndũkaye: nĩkwĩthĩwa mũthenya ũla ũkaya waw’o ndũkatĩa ũkw’a.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.17",
            "verseOrgIds": [
              "GEN.2.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
