            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.17",
            "verseOrgIds": [
              "GEN.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yeova Ngai asya, Ti ũseo mũndũ ethĩwe e weka; nĩngũmũmbĩa mũtetheesya ũmwaĩle. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.18",
            "verseOrgIds": [
              "GEN.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kuma mũthanganĩ Yeova Ngai oombie kĩla nyamũ ya kĩthekanĩ, na kĩla nyũnyi ya yayaya; nake atwaĩa mũndũ one ũndũ wĩsyĩta: na o ũndũ wetie kĩla kyũmbe kĩ thayũ, noyo syĩtwa yakyo. ",
          "type": "text",
