              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "na wau, ũla Yeova Ngaĩ waumisye mũndũnĩ, oombie mũndũ mũka, na amũtwaĩa ũ mũndũ. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.22",
            "verseOrgIds": [
              "GEN.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
