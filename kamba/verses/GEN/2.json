          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yeova Ngai akomethya mũndũ too mũnene, na akoma; nake aumya wau ũmwe wake, na akwantan’ya nyama vandũ vaw’o: ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.21",
            "verseOrgIds": [
              "GEN.2.21"
            ]
