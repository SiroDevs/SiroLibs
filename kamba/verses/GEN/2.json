            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na matu na nthĩ syathela kũmbwa, na nguthu yonthe yasyo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.1",
            "verseOrgIds": [
              "GEN.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mũthenya wa mũonza Ngaĩ nĩwaminĩte wĩa wake ũla watethasya; nake athũmũa mũthenya wa mũonza ũndũ wa wĩa wake w’onthe ũla watethasya. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.2",
            "verseOrgIds": [
              "GEN.2.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
