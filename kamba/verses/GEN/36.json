          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "na mũnene Oolivama, na mũnene Ela, na mũnene Vinoni, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.41",
            "verseOrgIds": [
              "GEN.36.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "GEN 36:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "na mũnene Kenasi, na mũnene Temani, na mũnene Mivisalu, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.42",
            "verseOrgIds": [
              "GEN.36.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "GEN 36:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "na mũnene Makitieli, na mũnene Ilami: asu nĩo anene ma Etomu, kwĩanana na mawĩkalo moo nthĩ ya ng’ũndũ yoo. Ũsũ nĩwe Esau, ĩthe wa Aetomu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.43",
            "verseOrgIds": [
              "GEN.36.43"
            ]
          }
