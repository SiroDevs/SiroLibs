          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na aa nĩo masyĩtwa ma anene ala maĩ ma Esau, kũatĩĩa mĩvĩa yoo, kwĩanana na kũndũ kwoo, na masyĩtwa moo: mũnene Timina, na mũnene Aliva, na mũnene Yethethi, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.40",
            "verseOrgIds": [
              "GEN.36.40"
            ]
          }
        },
        {
