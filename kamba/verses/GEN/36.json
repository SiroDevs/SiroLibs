            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.11",
            "verseOrgIds": [
              "GEN.36.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 36:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Timina aĩ mũka ngombo wa Elivasi mwana wa Esau; nake amũsyaĩa Elivasi Amaleki: asu nĩo ana ma Ata, mũka wa Esau. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.12",
            "verseOrgIds": [
              "GEN.36.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
