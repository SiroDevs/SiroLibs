          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na aa nĩo ana ma Leueli: Naathi, na Nzela, na Samama, na Misa: asu nĩo maĩ ana ma Mbasemathi, mũka wa Esau. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.13",
            "verseOrgIds": [
              "GEN.36.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 36:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na aa maĩ ana ma Oolivama mwĩĩtu wa Anaa, mwĩĩtu wa Nziveoni, mũka wa Esau: na amũsyaĩa Esau Yeusu, na Yalamu, na Kola.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.14",
            "verseOrgIds": [
              "GEN.36.14"
            ]
          }
        }
      ]
