          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aa nĩo ana ma Seili Mũoli, ala matwĩe nthĩ ĩsu: Lotani na Sovali na Nziveoni na Anaa, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.20",
            "verseOrgIds": [
              "GEN.36.20"
            ]
          }
        },
        {
