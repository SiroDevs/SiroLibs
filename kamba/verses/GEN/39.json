          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yeova aĩ vamwe na Yosevu, nake aĩ mũndũ mũathime; na aĩ nyũmbanĩ ya vwana wake Mũmisili. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.2",
            "verseOrgIds": [
              "GEN.39.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
