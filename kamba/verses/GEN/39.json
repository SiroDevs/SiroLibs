                "loc": "GEN.21.22"
              },
              "items": [
                {
                  "text": "Mwa 21.22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.28.15"
              },
              "items": [
                {
                  "text": "28.15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
