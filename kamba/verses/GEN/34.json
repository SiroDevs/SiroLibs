          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nenyu mũkatũaa naitũ: na ĩ nthĩ ĩkeethĩwa mbee wenyu; tũai mũtandĩthĩsye kw’o, mwĩmanthĩe ũthwii kw’o. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.10",
            "verseOrgIds": [
              "GEN.34.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
