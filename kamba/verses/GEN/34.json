          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwondũ wa ũndũ ũũ w’oka ithyĩ tũkamwĩtĩkĩla inyw’ĩ; ethiwa ĩnyw’ĩ mũkeethĩwa taitũ, kana kĩla mũndũ mũũme wĩ kwenyu nĩaĩkwe; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.15",
            "verseOrgIds": [
              "GEN.34.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 34:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "nĩvo twĩmũnenga inyw’ĩ eĩtu maitũ, naitũ tũkatwaa eĩtu menyu, na tũkatũaa vamwe nenyu, naitũ tũkeethĩwa mbaĩ ĩmwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.16",
            "verseOrgIds": [
              "GEN.34.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 34:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ ethĩwa mũitwĩw’a, na kwaĩkwa; nĩvo ĩndĩ twĩosa mwĩĩtu waitũ, na tũkathi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.17",
            "verseOrgIds": [
              "GEN.34.17"
            ]
          }
        }
      ]
