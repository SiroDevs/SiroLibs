          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 34:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Sekemu amwĩa ĩthe wa Ndina na ana‐a‐ĩthe make, Nĩnone ĩnee methonĩ menyu, na kĩla mwĩndavya nĩngumya. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.11",
            "verseOrgIds": [
              "GEN.34.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
