                {
                  "text": "Isa 5.8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.2",
            "verseOrgIds": [
              "MIC.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MIC 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwondũ wa ũu Yeova easya atĩĩ: Sisyai, mũvĩa ũũ nĩngũsũanĩĩa ũthũku, ũla mũtakeyumya ngingo syenyu vo, o na mũikathi na wĩng’athĩlĩlyo; nũndũ nĩ ĩvinda ĩthũku. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.3",
            "verseOrgIds": [
              "MIC.2.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
