                {
                  "text": "Sav 36.4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.1",
            "verseOrgIds": [
              "MIC.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MIC 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na nĩmew’ĩaa mĩũnda ĩtomo, na kũmyosa; o na nyũmba, na maivenana: na nĩmathĩnasya mũndũ na nyũmba yake, o na mũndũ na ũtiĩwa wake. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.2",
            "verseOrgIds": [
              "MIC.2.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
