              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Woo nĩ wa ala masũanĩaa ũthũku na kwĩkĩa ũthũku mokomonĩ moo! Na kĩoko kũikya maiwĩka, nũndũ wĩ ũtonyinĩ wa kw’oko kwoo. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.1",
            "verseOrgIds": [
              "MIC.2.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
