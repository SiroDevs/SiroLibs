              "type": "tag",
              "attrs": {
                "loc": "AMO.3.1"
              },
              "items": [
                {
                  "text": "Amo 3.1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "AMO.3.2"
