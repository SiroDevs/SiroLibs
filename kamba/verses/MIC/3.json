          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na oni makasonokw’a, na ala maaũasya makathokoana; ĩĩ, onthe makeevw’ĩka ilomo; nũndũ vati ũsũngĩo wa Ngai. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.7",
