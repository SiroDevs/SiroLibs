            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ ngalĩ ĩ yakwa, kwondũ wa Veva wa Yeova, nĩnusũĩtw’e nĩ vinya, na ũsili, na ũtonyi, non’ye Yakovo ĩvĩtyo yake, na Isilaeli naĩ yake. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.8",
            "verseOrgIds": [
              "MIC.3.8"
            ]
          }
