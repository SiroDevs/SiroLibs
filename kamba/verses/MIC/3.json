          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩvo memwĩkaĩla Yeova, ĩndĩ ndakamasũngĩa; ĩĩ, akamavitha ũthyũ wake ĩvinda yĩu, kwĩanana na ũndũ meekie ũthũku mekonĩ moo. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.4",
            "verseOrgIds": [
              "MIC.3.4"
            ]
          }
        },
        {
