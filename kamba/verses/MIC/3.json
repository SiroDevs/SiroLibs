          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Meaka Saioni na nthakame, na Yelusaleme na ũthũku. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.10",
            "verseOrgIds": [
              "MIC.3.10"
            ]
          }
