                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.2",
            "verseOrgIds": [
              "MIC.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MIC 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "o na ĩngĩ ala mũĩsaa nyama sya mĩĩ ya andũ makwa, na kũmathĩnza kĩkonde kyoo, na kũtũlanga mavĩndĩ moo, na kũmatilanga tũlungu, ta tũkwĩkĩwa mbisũnĩ, na ta nyama kĩtevenĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.3",
            "verseOrgIds": [
              "MIC.3.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
