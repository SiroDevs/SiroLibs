            "number": "6",
            "style": "v",
            "sid": "MIC 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwondũ wa ũu kũkeethĩwa ũtukũ kwenyu, nĩ kana mũtikethĩwe na woni; na kũkeethĩwa kĩvindu kwenyu, nĩ kana mũtikaaũsye; na syũa yĩkamathũĩa athani, na mũthenya ũkeethĩwa mwiũ kwoo. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.6",
            "verseOrgIds": [
              "MIC.3.6"
            ]
          }
        },
