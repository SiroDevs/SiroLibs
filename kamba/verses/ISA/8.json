          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ Yeova ambĩie ndeto ii na kw’oko kwĩ vinya, na amanyĩsya ndikaende mũendelenĩ wa andũ aa, akyasya, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.11",
            "verseOrgIds": [
              "ISA.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũtikasye, Nĩ wĩw’ano mũthũku, ũndũ wa w’onthe ũla andũ aa mekwasya, Nĩ wĩw’ano mũthũku; o na mũikakĩe kũtĩsya kwoo, kana kwĩthĩwa na w’ĩa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.12",
            "verseOrgIds": [
              "ISA.8.12"
            ]
          }
        },
        {
