          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeova wa nguthu, nĩwe mũkonan’ya atĩ nĩ mũtheu; nake nĩethĩwe kũkĩa kwenyu, na nĩethĩwe kũtelema kwenyu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.13",
            "verseOrgIds": [
              "ISA.8.13"
            ]
          }
        },
        {
