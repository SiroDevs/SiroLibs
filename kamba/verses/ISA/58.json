          "attrs": {
            "verseId": "ISA.58.13",
            "verseOrgIds": [
              "ISA.58.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 58:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "nĩvo ĩndĩ wĩĩtanĩthya nthĩnĩ wa Yeova; na ngakwambatya kũndũ kũtũlu kwa nthĩ; na ngakũĩthya na ũtiĩwa wa ĩthe waku Yakovo: nũndũ kanyw’a wa Yeova nũneenete ũu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.14",
            "verseOrgIds": [
              "ISA.58.14"
            ]
          }
        },
        {
