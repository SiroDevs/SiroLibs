              "ISA.58.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 58:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ethĩwa ũkatũnga kũũ kwaku kũeke mũthenya wa savato, ũte kwĩka kwenda kwaku mũthenya wakwa mũtheu; na ĩndĩ ũkeeta savato wa kũtanĩthya, na mũthenya mũtheu wa Yeova wa kũtaĩwa; na ũkootaĩa, ũkĩlea nzĩa syaku, kana kũmantha ũtanu waku mwene, kana kũneena ndeto syaku mwene: ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.13",
            "verseOrgIds": [
              "ISA.58.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
