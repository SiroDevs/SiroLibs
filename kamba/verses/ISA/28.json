        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.11",
            "verseOrgIds": [
              "ISA.28.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 28:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "ala wameie, Ũũ nĩw’o ũthũmũo, mũnengei ũthũmũo ũla ũnoete; na ũũ nĩw’o ũvuũkyo: ĩndĩ matyaaĩw’a. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.12",
            "verseOrgIds": [
              "ISA.28.12"
            ]
          }
        },
        {
