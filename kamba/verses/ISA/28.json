            "number": "9",
            "style": "v",
            "sid": "ISA 28:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akamanyĩsya ũmanyi aaũ? Na akamanyĩthya ũvoo aaũ? Nĩ ala maaĩĩtw’e, na kũvatwa kwonga? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.9",
            "verseOrgIds": [
              "ISA.28.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
