        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.7",
            "verseOrgIds": [
              "ISA.28.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 28:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ mesa syonthe nĩsyusũĩtwe nĩ matavĩka na ũvuku, o na vati vandũ vatheu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.8",
            "verseOrgIds": [
              "ISA.28.8"
            ]
          }
        }
      ]
    },
    {
