            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 28:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ngatw’ĩkĩthya ũsili wa katĩ ũlii wa kũthima, na ũlũngalu nĩw’o kavilũ; na mbua ya mavia ĩkatwaa ũla wĩvitho wa movũngũ, na manzĩ makakĩla vandũ va kwĩvitha. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.17",
            "verseOrgIds": [
              "ISA.28.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 28:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ũtianĩo wenyu ũla mwatianĩe na kĩkw’ũ ũkaanangwa, na wĩw’ano wenyu ũla mweew’anie na Seoli ndũkaũngama; yĩla ũthĩn’yo wũkĩlanĩtye wĩvĩtĩla katĩ, nĩvo ĩndĩ mwĩkinyangwa nĩw’o. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.18",
            "verseOrgIds": [
              "ISA.28.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 28:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "O yĩla wĩvĩtĩla katĩ, ũkakũkwata; nũndũ ũkavĩtĩla kĩoko na kĩoko, mũthenya na ũtukũ; na kũkeethĩwa no ũtĩsyo mũthei kũmanya ũvoo ũsu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.19",
            "verseOrgIds": [
              "ISA.28.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 28:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ ũkomo nĩ mũkuvĩ ũndũ mũndũ ũtatonya kwĩkootea ĩũlũ waw’o; na ngũa ya kwĩvw’ĩka nĩ ntheke ũndũ ũtatonya kwĩlingĩlĩĩla. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.20",
            "verseOrgIds": [
              "ISA.28.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 28:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ Yeova akookĩla o tondũ wekie kĩĩmanĩ kya Velasimu, na akathilĩka o tondũ wekie mwandanĩ wa Ngiveoni; nĩ kana atethye wĩa wake, wĩa wake mũeni, na kwĩkĩthya wĩko wake, wĩko wake mũeni. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.21",
            "verseOrgIds": [
              "ISA.28.21"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
