            "number": "11",
            "style": "v",
            "sid": "ISA 28:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aiee, ĩndĩ akaneena na andũ aa na ilomo ngeni na ũĩmĩ ũngĩ; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.11",
            "verseOrgIds": [
              "ISA.28.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
