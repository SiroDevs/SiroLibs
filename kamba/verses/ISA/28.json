              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.12",
            "verseOrgIds": [
              "ISA.28.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 28:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwondũ wa ũu ndeto ya Yeova ĩkeethĩwa kwoo wĩaĩo ĩũlũ wa wĩaĩo, wĩaĩo ĩũlũ wa wĩaĩo; mũsoa ĩũlũ wa mũsoa, mũsoa ĩũlũ wa mũsoa, vaa ũndũ ũnini, vaya ũndũ ũnini; nĩ kana maende, na kũvalũka na ngala, na kũtũlĩka, na kũtewa, na kũkwatw’a. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.13",
            "verseOrgIds": [
              "ISA.28.13"
            ]
          }
        },
        {
