                "loc": "JER.6.10"
              },
              "items": [
                {
                  "text": "Yel 6.10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.9",
            "verseOrgIds": [
              "ISA.28.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 28:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ nĩ wĩaĩo ĩũlũ wa wĩaĩo, wĩaĩo ĩũlũ wa wĩaĩo; mũsoa ĩũlũ wa mũsoa, mũsoa ĩũlũ wa mũsoa; vaa ũndũ ũnini, vaya ũndũ ũnini.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.10",
            "verseOrgIds": [
              "ISA.28.10"
            ]
          }
        }
      ]
