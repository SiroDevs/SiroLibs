              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũndũ mũkũũ wĩ ndaĩa, nĩwe mũtwe; na mwathani ũla ũmanyĩasya movũngũ, nĩwe kĩsithe. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.15",
            "verseOrgIds": [
              "ISA.9.15"
            ]
          }
        },
        {
          "name": "verse",
