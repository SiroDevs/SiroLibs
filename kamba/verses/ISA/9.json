          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ ũito wa ĩsoki yayo, na ndata ya kĩtuo kyayo, ndata ya mũthĩn’ya wayo, nũtũlĩte o ta mĩthenya ya Mitiani. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.4",
            "verseOrgIds": [
              "ISA.9.4"
            ]
          }
        },
        {
