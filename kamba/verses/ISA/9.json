          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ andũ matyaaĩthũũa na kũmwelekela ũla wamakũnie, o na matyaamantha Yeova wa nguthu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.13",
            "verseOrgIds": [
              "ISA.9.13"
            ]
          }
        },
        {
