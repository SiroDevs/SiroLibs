          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ ala matongoeasya andũ aa nĩo mamavĩtĩthasya; na ala matongoeaw’a nĩo manangawa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.16",
            "verseOrgIds": [
              "ISA.9.16"
            ]
          }
        },
        {
