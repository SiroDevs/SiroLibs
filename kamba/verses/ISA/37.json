            "sid": "ISA 37:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kweethĩwa, yĩla mũsumbĩ Esekia wewie ũu, atembũanga ngũa syake, na eekĩa makunia, na alika nyũmbanĩ ya Yeova. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.1",
            "verseOrgIds": [
              "ISA.37.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.19.1+2KI.19.2+2KI.19.3+2KI.19.4+2KI.19.5+2KI.19.6+2KI.19.7+2KI.19.8+2KI.19.9+2KI.19.10+2KI.19.11+2KI.19.12+2KI.19.13+2KI.19.14+2KI.19.15+2KI.19.16+2KI.19.17+2KI.19.18+2KI.19.19+2KI.19.20+2KI.19.21+2KI.19.22+2KI.19.23+2KI.19.24+2KI.19.25+2KI.19.26+2KI.19.27+2KI.19.28+2KI.19.29+2KI.19.30+2KI.19.31+2KI.19.32+2KI.19.33+2KI.19.34+2KI.19.35+2KI.19.36+2KI.19.37"
              },
              "items": [
                {
                  "text": "2 Asu 19.1–37",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.1",
            "verseOrgIds": [
              "ISA.37.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 37:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na atũma Eliakimu, ũla waĩ mũsyaĩĩsya wa andũ ma nyũmba, na mũandĩki Sevina, na atumĩa athembi, kwa mwathani Isaia mwana wa Amosu, mekĩĩte makunia. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.2",
            "verseOrgIds": [
              "ISA.37.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 37:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao mamwĩa, Ũũ nĩw’o Esekia ũnũkwasya, Ũmũnthĩ nĩ mũthenya wa thĩna, na wa ũkanw’a, na wa kũvũthw’a; nũndũ twana nĩtũvikĩte ĩvinda ya kũsyawa, na vati vinya wa kũsyaa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.3",
            "verseOrgIds": [
              "ISA.37.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.22.5"
              },
              "items": [
                {
                  "text": "Isa 22.5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HOS.13.13"
              },
              "items": [
                {
                  "text": "Osea 13.13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.3",
            "verseOrgIds": [
              "ISA.37.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 37:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokwĩthĩwa Yeova Ngai waku akeew’a ndeto sya Lavi‐sake, ũla mũsumbĩ wa Asuli vwana wake ũmũtũmĩte amũvũthĩĩsye Ngai wĩ thayũ, na akakan’ya ndeto ila Yeova Ngai waku wĩw’ĩte: kwondũ wa ũu ũkĩlya mboya yaku kwondũ wa ũtialo ũla ũtialĩte. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.4",
            "verseOrgIds": [
              "ISA.37.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.1.9"
              },
              "items": [
                {
                  "text": "Isa 1.9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 37:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.4",
            "verseOrgIds": [
              "ISA.37.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 37:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwondũ wa ũu athũkũmi ma mũsumbĩ Esekia mavika kwa Isaia. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.5",
            "verseOrgIds": [
              "ISA.37.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 37:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Isaia amea, Ũũ nĩw’o mwĩmũtavya vwana wenyu, Ũũ nĩw’o Yeova ũnũkwasya, Ndũkakĩe ndeto ila wĩw’ĩte, ila athũkũmi ma mũsumbĩ wa Asuli manumangĩte nasyo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.6",
            "verseOrgIds": [
              "ISA.37.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 37:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sisya, ngeekĩa veva nthĩnĩ wake na akeew’a maũvoo, na akasyoka nthĩ yake mwene; na ngatuma avalũkĩlw’a na ũvyũ nthĩ yake mwene. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.7",
            "verseOrgIds": [
              "ISA.37.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.19.14"
              },
              "items": [
                {
                  "text": "Isa 19.14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.37.38"
              },
              "items": [
                {
                  "text": "37.38",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 37:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.7",
            "verseOrgIds": [
              "ISA.37.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 37:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwondũ wa ũu Lavi‐sake asyoka, na amwĩthĩa mũsumbĩ wa Asuli aiũkita na Livina; nũndũ aĩ aneew’a kana nĩwumĩte vu Lakisi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.8",
            "verseOrgIds": [
              "ISA.37.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 37:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na nĩwewie kũineenwa ũndũ wa Tiliaka mũsumbĩ wa Ethiovia, Nĩwumaalĩte okite naku. Na yĩla wewie ũu, atũma atũmwa kwa Esekia, akyasya, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.9",
            "verseOrgIds": [
              "ISA.37.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.20.5"
              },
              "items": [
                {
                  "text": "Isa 20.5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.9",
            "verseOrgIds": [
              "ISA.37.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 37:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ũũ nĩw’o mwĩmũtavya Esekia mũsumbĩ wa Yuta, mũkĩmwĩa, Ngai waku ũla ũmwĩkwatasya ndakakũkenge, aikwĩa, Yelusaleme ndĩkanenganwe kw’okonĩ kwa mũsumbĩ wa Asuli. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.10",
            "verseOrgIds": [
              "ISA.37.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.36.15"
              },
              "items": [
                {
                  "text": "Isa 36.15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.10",
            "verseOrgIds": [
              "ISA.37.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 37:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sisya, nĩwĩw’ĩte ũndũ asumbĩ ma Asuli mekĩte nthĩ syonthe, ũndũ wa kũsyananga vyũ: naku ũkavonoka? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.11",
            "verseOrgIds": [
              "ISA.37.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 37:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngai sya mbaĩ nĩsyaivonokisye, ila aasa makwa masyanangie, Ngosani, na Aalani, na Lesevu, na ana ma Eteni ala maĩ Telasali? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.12",
            "verseOrgIds": [
              "ISA.37.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.36.18"
              },
              "items": [
                {
                  "text": "Isa 36.18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.36.19"
              },
              "items": [
                {
                  "text": "19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.12",
            "verseOrgIds": [
              "ISA.37.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 37:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aĩva mũsumbĩ wa Amathi, na mũsumbĩ wa Alivati, na mũsumbĩ wa ndũa ya Sevalivaimu, na ya Ena, na ya Iva?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.13",
            "verseOrgIds": [
              "ISA.37.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 37:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.13",
            "verseOrgIds": [
              "ISA.37.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 37:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Esekia oosa valũa kuma mokonĩ ma ala matũmiwe, na oosoma; na Esekia ambata alika nyũmbanĩ ya Yeova, na ootambũũkĩsya mbee wa Yeova. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.14",
            "verseOrgIds": [
              "ISA.37.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 37:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Esekia amũvoya Yeova, akyasya, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.15",
            "verseOrgIds": [
              "ISA.37.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 37:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ame Yeova wa nguthu, Ngai wa Isilaeli, ũla wĩkalaa ĩũlangũ wa akeluvi, nue Ngai, o we wĩ weka, wa mosumbĩ onthe ma nthĩ; nue woombie ĩtu na nthĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.16",
            "verseOrgIds": [
              "ISA.37.16"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.25.22"
              },
              "items": [
                {
                  "text": "Kuma 25.22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.16",
            "verseOrgIds": [
              "ISA.37.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 37:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tea kũtũ kwaku, ame Yeova, wĩw’e; salukya metho maku, ame Yeova, wone; ĩw’a ndeto syonthe sya Senakelivu, ũla ũtũmanĩte avũthĩĩsye Ngai wĩ thayũ. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.17",
            "verseOrgIds": [
              "ISA.37.17"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.9.18"
              },
              "items": [
                {
                  "text": "Nda 9.18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.17",
            "verseOrgIds": [
              "ISA.37.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 37:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩ w’o, Yeova, asumbĩ ma Asuli nĩmanangĩte nthĩ syonthe, o na mĩũnda yasyo, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.18",
            "verseOrgIds": [
              "ISA.37.18"
            ]
          }
        },
        {
