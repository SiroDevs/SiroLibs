        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.31",
            "verseOrgIds": [
              "ISA.37.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ISA 37:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ ũtialo ũkauma Yelusaleme, na ala avonoku makauma kĩĩmanĩ kya Saioni. Kĩwĩu kya Yeova wa nguthu kĩkeanĩsya ũndũ ũsu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.32",
            "verseOrgIds": [
              "ISA.37.32"
            ]
          }
        },
