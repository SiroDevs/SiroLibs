          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngatavya ngalĩ ya ĩũlũ, Umya; na ngalĩ ya ĩtheo, Ndũkasiĩĩe; ete ana makwa kuma kũasa, na eĩtu makwa kuma kĩtulunĩ kya nthĩ; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.6",
            "verseOrgIds": [
              "ISA.43.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 43:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "kĩla ũmwe wĩtanĩaw’a na syĩtwa yakwa, na ũla noombie ethĩwe wa kũndaĩa, ũla noombie, ĩĩ, ũla namũtw’ĩkĩthisye.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.7",
            "verseOrgIds": [
              "ISA.43.7"
            ]
          }
        }
      ]
