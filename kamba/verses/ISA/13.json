            "sid": "ISA 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndeto ngito ũndũ wa Mbaviloni, ĩla Isaia mwana wa Amosu wonie.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.1",
            "verseOrgIds": [
              "ISA.13.1"
            ]
          }
        }
      ]
    },
    {
