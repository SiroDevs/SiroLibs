              "ISA.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sisya, ngamokĩlĩlya Ametia, ala matakasisya vetha, o na thaavu matikendeew’a nĩw’o. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.17",
            "verseOrgIds": [
              "ISA.13.17"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.51.11"
              },
              "items": [
                {
                  "text": "Yel 51.11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.17",
            "verseOrgIds": [
              "ISA.13.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mata moo makavalũkya anake mavevenzeke; na matikawĩw’ĩa tei ũsyao wa ĩvu; metho moo matikaeka syana. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.18",
            "verseOrgIds": [
              "ISA.13.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Mbaviloni, ndaia ya mosumbĩ, ũseo wa ngathĩĩo ya Akalitei, ĩkeethĩwa ĩilyĩ ta yĩla Ngai wang’uthũlangile Sotomo na Ngomola. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.19",
            "verseOrgIds": [
              "ISA.13.19"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.47.5"
              },
              "items": [
                {
