          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ũmwe akĩmbĩta kuma Seili, Mũsyaĩĩsya, ũtukũ ũkũvika va? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.11",
            "verseOrgIds": [
              "ISA.21.11"
            ]
          }
        },
        {
