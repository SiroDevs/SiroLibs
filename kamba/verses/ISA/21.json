              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "We ngetha yakwa ĩvũĩtwe, na lĩu wa mbaa ngetha wa kĩvũĩo kyakwa! Ũla nĩw’ĩte kuma kwa Yeova wa nguthu, Ngai wa Isilaeli, now’o nĩkũtavĩtye. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.10",
            "verseOrgIds": [
              "ISA.21.10"
            ]
          }
        },
