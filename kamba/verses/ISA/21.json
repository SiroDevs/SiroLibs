          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũsyaĩĩsya asya, Kĩoko nĩkyũkĩte, o na ũtukũ naw’o; ethĩwa nĩmũkwenda ũkũlya, kũlyai: ĩthyũũei, ũkai.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.12",
            "verseOrgIds": [
              "ISA.21.12"
            ]
          }
        }
      ]
    },
