          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndeto ngito ũndũ wa Alavia.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.13",
            "verseOrgIds": [
              "ISA.21.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũtitũnĩ wa Alavia mũkakoma, inyw’ĩ Andetani, aendi ma syalo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.13",
            "verseOrgIds": [
              "ISA.21.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
