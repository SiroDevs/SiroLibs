          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na nzũi nĩkekalanasya na katena ka ĩlondu, na ngo nĩkatindianĩaa na katena ka mbũi; na kasaũ ka ng’ombe na mũnyambũ wa mũika na ng’ombe nou vamwe; na kana kanini nĩkakaitongoeasya. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.6",
            "verseOrgIds": [
              "ISA.11.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
