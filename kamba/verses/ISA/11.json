            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwendeew’a kwake kũkethĩawa nthĩnĩ wa kũmũkĩa Yeova; na ndakasila kwĩanana na kwona kwa metho make, kana kũtw’a kwĩanana na kwĩw’a kwa matũ make; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.3",
            "verseOrgIds": [
              "ISA.11.3"
            ]
          }
        },
        {
