              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ũlũngalu ũkethĩawa mũsivi wa kwĩvotoa kwake, na kĩthito mũsivi wa kĩnyunyu kyake. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.5",
            "verseOrgIds": [
              "ISA.11.5"
            ]
          }
        },
