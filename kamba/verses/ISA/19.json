          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũthenya ũsu kũkethĩwa ndũa itano nthĩ ya Misili ila ineenaa kĩthyomo kya Kanaani, na kũmwĩvĩtĩa Yeova wa nguthu; ĩmwe ĩkeetwa Ndũa ya wanangĩko.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.18",
            "verseOrgIds": [
              "ISA.19.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
