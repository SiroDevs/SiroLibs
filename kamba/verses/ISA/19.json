          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũthenya ũsu Amisili makethĩwa mailyĩ ta aka; na makatetema na kũkĩa nũndũ wa kũtukangĩwa kw’oko nĩ Yeova wa nguthu, kũla wĩmatukangĩa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.16",
            "verseOrgIds": [
              "ISA.19.16"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
