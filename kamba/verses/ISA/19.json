        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na nthĩ ya Yuta ĩkatw’ĩka ũtĩsyo kwa Misili; kĩla ũmwe ũla wĩĩw’a ĩkĩwetwa akakwatwa nĩ w’ĩa, nũndũ wa ũtw’ĩo wa Yeova wa nguthu, ũla ũmĩtw’ĩĩe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.17",
            "verseOrgIds": [
              "ISA.19.17"
            ]
          }
        }
      ]
    },
    {
