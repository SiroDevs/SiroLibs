              },
              "items": [
                {
                  "text": "1 Asu 22.22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.14",
            "verseOrgIds": [
              "ISA.19.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "O na kũikethĩwa wĩa o na wĩva wa Misili, ũla mũtwe kana kĩsithe, ĩthangũ ya mĩtende kana malula, ikatonya kwĩka. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.15",
            "verseOrgIds": [
              "ISA.19.15"
            ]
          }
        },
        {
