                  "type": "text"
                }
              ]
            },
            {
              "text": "Esek 29.1—31.2; 31.18—32.32.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.1",
            "verseOrgIds": [
              "ISA.19.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ngookĩlya Amisili mokite na Amisili: na makokita kĩla ũmwe na mwana‐a‐inyia, na kĩla ũmwe na mũtũi wake; ndũa ĩkokita na ndũa, na ũsumbĩ na ũsumbĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.2",
            "verseOrgIds": [
              "ISA.19.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na veva wa Misili ũkathelekela nthĩnĩ wayo; na ngaananga ũtao wayo; na makamantha ũtethyo kwa mĩvw’anano, na kwa eki ma syama, na kwa ala mesene na maveva, na kwa ala mombasya ithitũ. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.3",
            "verseOrgIds": [
              "ISA.19.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na nganengane Amisili kw’okonĩ kwa mwĩaĩi mũthũku; na mũsumbĩ mwai akamasumbĩka, easya ũu Mwĩaĩi, Yeova wa nguthu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.4",
            "verseOrgIds": [
              "ISA.19.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.30.12"
              },
              "items": [
                {
                  "text": "Esek 30.12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.4",
            "verseOrgIds": [
              "ISA.19.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na manzĩ makanyiva ũkanganĩ, na ũla ũsĩ ũkang’ala wũme vyũ. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.5",
            "verseOrgIds": [
              "ISA.19.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mbũsi ikanyunga naĩ; na mĩtaũnĩ mĩnene manzĩ makanyiva na kũng’ala; mĩangi na makangaa makavova. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.6",
            "verseOrgIds": [
              "ISA.19.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyeki yĩ vakuvĩ na ũsĩ wa Naelo, mwaĩĩonĩ wa Naelo, na kw’onthe kũla kũvandĩtwe vakuvĩ na Naelo, kũkooma, na kũvetwa, na kũikethĩwa kw’o ĩngĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.7",
            "verseOrgIds": [
              "ISA.19.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na atei ma makũyũ makaĩa, na onthe ala mekasya itei ũsĩnĩ wa Naelo makameta, na ala malanasya itei sya makũyũ manzĩnĩ ĩũlũ makaaa vinya. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.8",
            "verseOrgIds": [
              "ISA.19.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩngĩ ala matethasya wĩa na ndii nzanũe sya katane, na ala matumaa ngũa nzaũ, makathokoanw’a. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.9",
            "verseOrgIds": [
              "ISA.19.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ituĩ sya Misili ikatũlangwa ilungu; onthe ala matethasya wĩa wa ũtuvwa makeew’a woo ngoonĩ syoo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.10",
            "verseOrgIds": [
              "ISA.19.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.10",
            "verseOrgIds": [
              "ISA.19.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anene me mbee ũsumbĩnĩ ma Nzoani nĩ atumanu vyũ; ũtao wa atai ala oĩ mbee ma Valao nũtw’ĩkĩte ta wa nyamũ: mwĩmwĩa Valao ata, Nyie nĩ mwana wa ala oĩ, mwana wa asumbĩ ma tene tene? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.11",
            "verseOrgIds": [
              "ISA.19.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Andũ maku oĩ maĩva ĩndĩ? Makũtavye yu; nĩmamanye ũndũ Yeova wa nguthu ũsũanĩĩte wa Misili. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.12",
            "verseOrgIds": [
              "ISA.19.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.22"
              },
              "items": [
                {
                  "text": "Meko 7.22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.12",
            "verseOrgIds": [
              "ISA.19.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anene me mbee ũsumbĩnĩ ma Nzoani nĩmatw’ĩkĩte ndia, ala me mbee ũsumbĩnĩ wa Memivisi nĩmakengetwe; nĩmatumĩte Misili yaa, asu ĩvia ya kĩkotonĩ ya mbaĩ syayo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.13",
            "verseOrgIds": [
              "ISA.19.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeova nũvulanĩtye veva wa ũng’endu nthĩnĩ wayo; na nĩmatumĩte Misili yaa kĩla wĩanĩ wayo, o ta mũndũ ũnyw’ĩte ailũalũa matavĩkanĩ make. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.14",
            "verseOrgIds": [
              "ISA.19.14"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
