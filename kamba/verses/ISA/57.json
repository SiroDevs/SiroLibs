            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 57:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ thengeeai vaa, inyw’ĩ ana ma kĩveti kĩoi, ũsyao wa kĩlaalai na ĩlwaya. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.3",
            "verseOrgIds": [
              "ISA.57.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
