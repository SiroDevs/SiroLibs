          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na akasya, Ĩnzai, ĩnzai, seũvyai nzĩa, vetai ũlulutĩkyo nzĩanĩ ya andũ makwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.14",
            "verseOrgIds": [
              "ISA.57.14"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.62.10"
              },
              "items": [
                {
