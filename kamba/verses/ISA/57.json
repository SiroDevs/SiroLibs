              },
              "items": [
                {
                  "text": "Yoa 8.41",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.8.42"
              },
              "items": [
                {
                  "text": "42",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.3",
            "verseOrgIds": [
              "ISA.57.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 57:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwĩthaũkĩa ũũ? Na nũũ mũkwathamangĩsya makanyw’a, na kumĩlangĩlya nĩmĩ? Mũti syana sya ũvĩtyo, ũsyao wa ũvũngũ, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.4",
            "verseOrgIds": [
              "ISA.57.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.35.21"
              },
              "items": [
                {
                  "text": "Sav 35.21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.1.4"
              },
              "items": [
                {
                  "text": "Isa 1.4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.4",
            "verseOrgIds": [
              "ISA.57.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 57:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "inyw’ĩ ala mũkwĩyakan’ya ene katĩ wa mĩtĩ ya myaloni, ĩtina wa kĩla mũtĩ mwĩũ; ala mũaĩaa syana myandanĩ, ungu wa mĩvatĩ ya mavia? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.5",
            "verseOrgIds": [
              "ISA.57.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.16.4"
              },
              "items": [
                {
                  "text": "2 Asu 16.4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.1.29"
              },
              "items": [
                {
                  "text": "Isa 1.29",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.16.20"
              },
              "items": [
                {
                  "text": "Esek 16.20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.16.21"
              },
              "items": [
                {
                  "text": "21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.5",
            "verseOrgIds": [
              "ISA.57.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 57:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kĩanda kyaku kĩ katĩ wa mavia matendeu me mwandanĩ; asu, nĩmo kĩanda kyaku; o asu nĩwametĩe nthembo ya kũnyuwa, nũthembete nthembo ya mũtu. Ngavoovw’a nĩ syĩndũ isu? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.6",
            "verseOrgIds": [
              "ISA.57.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 57:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩwiĩte ũkomo waku kĩĩmanĩ kĩtũlu na kĩnene; o na vau nĩvo wambatie kũthemba. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.7",
            "verseOrgIds": [
              "ISA.57.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.14.23"
              },
              "items": [
                {
                  "text": "1 Asu 14.23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.7",
            "verseOrgIds": [
              "ISA.57.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 57:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mbĩlĩlo wa mĩomo na ituĩ nũngamĩtye ũlilikan’yo waku: nĩwĩvuĩe ũngĩ na ti nyie, na nĩwambatĩte; nũnenevetye ũkomo waku, na kũtianĩa ũtianĩo nao: nĩwendie ũkomo woo vala wawonie. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.8",
            "verseOrgIds": [
              "ISA.57.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.16.25"
              },
              "items": [
                {
                  "text": "Esek 16.25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.23.17"
              },
              "items": [
                {
                  "text": "23.17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.8",
            "verseOrgIds": [
              "ISA.57.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 57:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na niwaendie na mauta kwa mũsumbĩ, na waingĩvisye syĩndũ syaku ila inyungaa nesa, na watũma atũmwa maku kũasa, na weethũkya o na kũvika Seoli. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.9",
            "verseOrgIds": [
              "ISA.57.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 57:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waĩ ũnanow’a nĩ ũasa wa nzĩa yaku; ĩndĩ ndwaaasya, Nĩ mana: nĩwoonie vinya waku ũkyongelela: kwondũ wa ũu ndwaanyala. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.10",
            "verseOrgIds": [
              "ISA.57.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
