        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.13",
            "verseOrgIds": [
              "ISA.32.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 32:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ nyũmba nene mbanakavye ĩkaekwa; ndũa yĩ andũ aingĩ ĩkeethĩwa ĩte mũndũ; kalĩma na mwako mũtũlu wa kũsyaĩĩsya ikeethĩwa ngunga ĩndĩ yonthe, ũtanu wa mang’oi ma kĩthekanĩ, kĩsesi kya ndĩthya sya mbũi na malondu; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.14",
            "verseOrgIds": [
              "ISA.32.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 32:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "kũvika yĩla Veva wĩtulũĩlwa ithyĩ kuma ĩũlũ, na weũ wĩtw’ĩka mũũnda ũla ũsyaaa mũno, na mũũnda ũla ũsyaaa mũno ũitalwa ta mũtitũ. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.15",
            "verseOrgIds": [
              "ISA.32.15"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
