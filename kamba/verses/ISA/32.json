                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.17",
            "verseOrgIds": [
              "ISA.32.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
