          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ nyie Yeova, nendaa sĩla wa katĩ, nĩmenaa ũng’ei vamwe na ũthũku; na ngamanenga ĩtuvi yoo na w’o, na ngatianĩa ũtianĩo wa tene na tene nao. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.8",
            "verseOrgIds": [
              "ISA.61.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
