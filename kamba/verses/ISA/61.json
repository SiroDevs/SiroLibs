          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na aeni makaũngamaa na kũĩthya ndĩthya syenyu sya mbũi na malondu, na andũ ma nthĩ ĩngĩ makeethĩwa andũ menyu ma kũima, na asei ma mĩsavivũ mĩũndanĩ yenyu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.5",
            "verseOrgIds": [
              "ISA.61.5"
            ]
          }
