          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sisya, Mwĩaĩi Yeova akandethya; nũũ ũla wĩndw’a mũvĩtan’ya? Sisya, asu onthe makakũa ta ngũa; lungulu ũkamaya.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.9",
            "verseOrgIds": [
              "ISA.50.9"
            ]
