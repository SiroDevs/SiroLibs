        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.12",
            "verseOrgIds": [
              "ISA.55.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 55:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vandũ va mĩw’a kũkamea mũtĩ wa mũsonovali; na vandũ va mũtae wa kĩthekanĩ kũkamea mũtĩ wa mwandasi: na ũu ũkeethĩwa syĩtwa kwa Yeova, wonan’yo wa tene na tene ũla ũtakavetwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.13",
            "verseOrgIds": [
              "ISA.55.13"
            ]
          }
        },
