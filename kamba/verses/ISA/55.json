            "number": "3",
            "style": "v",
            "sid": "ISA 55:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Teai matũ, na mũimbũkĩa; ĩthukĩĩsyei, na ngoo syenyu ikeethĩwa thayũ: na ngatianĩa ũtianĩo nenyu wa tene na tene, o matei malũmu ma Ndaviti. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.3",
            "verseOrgIds": [
              "ISA.55.3"
            ]
          }
        },
        {
