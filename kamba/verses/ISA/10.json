              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Woo nĩ wa ala matusaa motw’ĩo mate malũngalu, na wa aandĩki ala maandĩkaa mong’endu; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.1",
            "verseOrgIds": [
