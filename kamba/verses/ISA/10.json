            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kyeni kya Isilaeli kĩkeethĩwa mwaki, na Ũla Mũtheu wake akeethĩwa ũmũĩ wa mwaki; na ũkavĩvya na kũmina mĩw’a yake na mĩtae yake mũthenya ũmwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.17",
            "verseOrgIds": [
              "ISA.10.17"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
