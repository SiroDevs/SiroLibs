            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.12",
            "verseOrgIds": [
              "ISA.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ nũneenete, Kwondũ wa vinya wa kw’oko kwakwa nĩnĩkĩte ũu, na kwondũ wa ũĩ wakwa; nũndũ nĩ na ũmanyi: na nĩnĩthamĩtye mĩvaka ya ngo sya andũ, na kũtava mothwii moo maie, na ta mũndũ ngũmbaũ nĩnĩtheeetye ala mekalaa ivĩlanĩ sya ũsumbĩ: ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.13",
            "verseOrgIds": [
              "ISA.10.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.37.23+ISA.37.24+ISA.37.25"
              },
              "items": [
                {
                  "text": "Isa 37.23–25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.13",
            "verseOrgIds": [
              "ISA.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "na kw’oko kwakwa nĩkwonete mothwii na ngo sya andũ ta ndala; na tondũ mũndũ wũmbanasya matumbĩ ala matiĩtwe, now’o nũmbanĩtye nthĩ yonthe: na vatyaĩ ũmwe ũla waavaalalya ũthwau, kana kwathamya kanyw’a, kana kũnyiila.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.14",
            "verseOrgIds": [
              "ISA.10.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
