                {
                  "text": "2 Asu 16.9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.17.6"
              },
              "items": [
                {
                  "text": "17.6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.19.13"
              },
              "items": [
                {
                  "text": "19.13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.9",
            "verseOrgIds": [
              "ISA.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tondũ kw’oko kwakwa kwonete mosumbĩ ma mĩvw’anano, ala mĩvw’anano yamo myasũvye nĩvĩtũkĩte ĩla ya Yelusaleme na ya Samalia; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.10",
            "verseOrgIds": [
              "ISA.10.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.19.17"
              },
              "items": [
                {
                  "text": "2 Asu 19.17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.19.18"
              },
              "items": [
                {
                  "text": "18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.10",
            "verseOrgIds": [
              "ISA.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndikeka Yelusaleme na mĩvw’anano yayo o tondũ neekie Samalia na mĩvw’anano yayo? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.11",
            "verseOrgIds": [
              "ISA.10.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
