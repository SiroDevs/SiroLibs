          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩthoka yĩkamwĩkathĩĩĩa ũla ũtemaa nayo? Ĩng’weli yĩkamwĩnenevesya ũla ũtethasya wĩa nayo? Nĩ ta kwasya ndata ĩkatethya wĩa na ala mamyũkĩlasya, kana ndata ĩkamũkĩlya mwene nake ti mũtĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.15",
            "verseOrgIds": [
              "ISA.10.15"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
