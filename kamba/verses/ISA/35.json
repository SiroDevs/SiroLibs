          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 35:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Matavyei ala me na ngoo yĩ w’ĩa, Ĩthĩwai na vinya, mũtikakĩe: sisyai, Ngai wenyu akooka na ũĩvanĩsyo, ũĩvanĩsyo wa Ngai; akooka amũtangĩĩe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.4",
            "verseOrgIds": [
              "ISA.35.4"
            ]
          }
        }
      ]
    },
