          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vatikethĩwa mũnyambũ kw’o, o na nyamũ mbai ndĩkambata nayo; itikoneka kw’o; ĩndĩ ala ovosye makamĩkinyĩlaa: ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.9",
            "verseOrgIds": [
              "ISA.35.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
