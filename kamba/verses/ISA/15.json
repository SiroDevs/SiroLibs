              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndeto ngito ũndũ wa Moavi. Nũndũ ũtukũ o ũmwe ndũa ya Ali nthĩ ya Moavi nĩtw’ĩkĩthĩtw’e ĩanzo, na kwanangwa vyũ; nũndũ ũtukũ o ũmwe ndũa ya Kili nthĩ ya Moavi nĩtw’ĩkĩthĩw’e ĩanzo, na kwanangwa vyũ. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.1",
            "verseOrgIds": [
              "ISA.15.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.48.1+JER.48.2+JER.48.3+JER.48.4+JER.48.5+JER.48.6+JER.48.7+JER.48.8+JER.48.9+JER.48.10+JER.48.11+JER.48.12+JER.48.13+JER.48.14+JER.48.15+JER.48.16+JER.48.17+JER.48.18+JER.48.19+JER.48.20+JER.48.21+JER.48.22+JER.48.23+JER.48.24+JER.48.25+JER.48.26+JER.48.27+JER.48.28+JER.48.29+JER.48.30+JER.48.31+JER.48.32+JER.48.33+JER.48.34+JER.48.35+JER.48.36+JER.48.37+JER.48.38+JER.48.39+JER.48.40+JER.48.41+JER.48.42+JER.48.43+JER.48.44+JER.48.45+JER.48.46+JER.48.47"
              },
