          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tavan’yai maũndũ ala mokĩte ĩtina, nĩ kana tũmanye mwĩ ngai; ĩĩ, ĩkai ũseo, kana ĩkai ũthũku, nĩ kana tũteve, na kũsisya ũu vamwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.23",
            "verseOrgIds": [
              "ISA.41.23"
            ]
          }
        },
