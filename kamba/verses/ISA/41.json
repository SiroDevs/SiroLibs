          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sisyai, mwĩ ma mana, na wĩa wenyu nĩ wa mana; ũla ũmũnyuvaa nĩ ũthatyo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.24",
