          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ we, Isilaeli, mũthũkũmi wakwa, Yakovo ũla nĩnyuvĩte, ũsyao wa mũnyanyawa Avalaamu, ",
          "type": "text",
          "attrs": {
