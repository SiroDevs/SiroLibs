              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Etei ndeto syenyu, easya ũu Yeova; umĩlyai itumi syenyu syĩ vinya, easya ũu Mũsumbĩ wa Yakovo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.21",
            "verseOrgIds": [
