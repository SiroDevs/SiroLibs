          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩ mũathime mũndũ ũla wĩkaa ũu, na mwana wa mũndũ ũla ũlũmanasya naw’o; ũla ũlilikanaa mũthenya wa savato ndakovukye, na ũla ũsiĩĩa kw’oko kwake kũtikeke ũthũku o na wĩva. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.2",
            "verseOrgIds": [
              "ISA.56.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
