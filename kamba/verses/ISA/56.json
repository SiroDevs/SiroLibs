                  "text": "Isa 58.13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.2",
            "verseOrgIds": [
              "ISA.56.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 56:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "O na mũndũ wa nthĩ ĩngĩ, ũla ũlũmanĩtye na Yeova ndakaneene, akyasya, Nĩ w’o Yeova akambathan’ya na andũ make; o na mũvakũe ndakasye, Sisya, nyie nĩ mũtĩ mũmũ. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.3",
            "verseOrgIds": [
              "ISA.56.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
