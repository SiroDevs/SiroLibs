        },
        {
          "text": "Ũũ nĩw’o Yeova ũnũkwasya, Lũmyai sĩla wa katĩ, na kwĩka ũlũngalu; nũndũ ũtangĩĩo wakwa ũkilyĩ kũka, na ũlũngalu wakwa kwonanw’a. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.1",
            "verseOrgIds": [
              "ISA.56.1"
            ]
          }
        },
