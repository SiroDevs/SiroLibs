            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kũkeethĩwa mĩthenya ya mũminũkĩlyo, kana kĩĩma kĩ nyũmba ya Yeova kĩkekalaa kĩ kĩtũlu kwĩ ila ingĩ, na kũkĩla ĩũlũ wa tũlĩma; na mbaĩ syonthe ikakĩendeaa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.2",
            "verseOrgIds": [
              "ISA.2.2"
            ]
          }
        },
        {
