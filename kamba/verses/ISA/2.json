            "verseId": "ISA.2.10",
            "verseOrgIds": [
              "ISA.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũsyaĩlye wa ngathĩĩo wa mũndũ ũkanyivw’a, na wĩng’athĩlĩlyo wa andũ ũkatheew’a, na Yeova e weka akethĩwa mũnene mũthenya ũsu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.11",
            "verseOrgIds": [
              "ISA.2.11"
            ]
          }
        }
      ]
