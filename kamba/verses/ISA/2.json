          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "na ĩũlũ wa iĩma syonthe ndũlu, na tũlĩma tw’onthe tũtũlu, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.14",
            "verseOrgIds": [
              "ISA.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "na ĩũlũ wa kĩla mwako mũtũlu wa mũnyoolo, na kĩla ũvai mwiie, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.15",
            "verseOrgIds": [
              "ISA.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "na ĩũlũ wa ngalawa syonthe sya Talisisi, na mĩvw’anano yonthe yendeeasya. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.16",
            "verseOrgIds": [
              "ISA.2.16"
            ]
          }
        },
