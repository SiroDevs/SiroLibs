          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũthenya ũsu andũ makekĩsya mbuko na mbuvu mĩvw’anano yoo ya vetha, na mĩvw’anano yoo ya thaavu, ĩla maseũvisye mamĩthaithae; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.20",
            "verseOrgIds": [
              "ISA.2.20"
            ]
          }
