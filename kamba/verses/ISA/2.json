          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mũndũ ũte nguma nũkwĩkunamya, na mũndũ mũnene nũkwĩnyivya: kwondũ wa ũu ndũkamaekee. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.9",
            "verseOrgIds": [
              "ISA.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lika ĩvianĩ, na ĩvithe kĩtoonĩ, kuma mbee wa ũtisyo wa Yeova, na ũtheu mũtisu wa ũnene wake. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.10",
            "verseOrgIds": [
              "ISA.2.10"
            ]
          }
        },
        {
