        },
        {
          "text": "Ndeto ĩla Isaia mwana wa Amosu wonie ũndũ wa Yuta na Yelusaleme.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.1",
            "verseOrgIds": [
