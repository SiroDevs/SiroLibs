              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.36.3",
            "verseOrgIds": [
              "ISA.36.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 36:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Lavi‐sake amea, Mũtavyei Esekia yu, Ũũ nĩw’o mũsumbĩ mũnene, mũsumbĩ wa Asuli, ũnũkwasya, Wĩkwatyo ũũ nĩ mwaũ ũla wĩkwatĩtye? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.36.4",
            "verseOrgIds": [
              "ISA.36.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 36:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩngwasya, ũtao waku na vinya waku ũndũ wa kaũ no ndeto sya mana: yu wĩkwatasya ũũ, nũndũ nũng’endee nyie? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.36.5",
            "verseOrgIds": [
              "ISA.36.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 36:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sisya, wĩkwatasya ndata ya mũangi ũũ mũkanyange, nayo nĩ Misili, na ethĩwa mũndũ nũnũkwĩvandĩĩa nayo, ĩkalika kw’okonĩ kwake, na kũtonya: now’o Valao mũsumbĩ wa Misili ũilyĩ kwa onthe ala mamũĩkĩĩaa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.36.6",
            "verseOrgIds": [
              "ISA.36.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.29.6"
              },
              "items": [
                {
                  "text": "Esek 29.6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.29.7"
              },
              "items": [
                {
                  "text": "7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.36.6",
            "verseOrgIds": [
              "ISA.36.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 36:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ ethĩwa wĩmbĩa, Ithyĩ nĩtũmũĩkĩĩa Yeova Ngai waitũ: ĩndĩ tiwe, ũla Esekia ũvetete kũndũ kwake kũtũlu o na ithembeo syake, na nũtavĩtye Yuta na Yelusaleme, Mũkathaithĩaa kĩthembeonĩ kĩĩ? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.36.7",
            "verseOrgIds": [
              "ISA.36.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.18.4"
              },
              "items": [
                {
                  "text": "2 Asu 18.4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.36.7",
            "verseOrgIds": [
              "ISA.36.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 36:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yu kwondũ wa ũu, nĩngũkwĩsũva, nenga vwana wakwa mũsumbĩ wa Asuli ngwatĩlĩlyo, na ngakũnenga mbalasi ngili ilĩ, ethĩwa ngalĩko ĩ yaku nũtonya kũtũlya andũ ĩũlũ wasyo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.36.8",
            "verseOrgIds": [
              "ISA.36.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 36:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ũtonya ata ĩndĩ kũthyũũa ũthyũ wa kavuteni ũmwe wa ala anini mũno ma athũkũmi ma vwana wakwa, na kwĩkwatya Misili ĩkũnenge makasya na andũ ma ũtũlaa mbalasi? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.36.9",
            "verseOrgIds": [
              "ISA.36.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.31.1"
              },
              "items": [
                {
                  "text": "Isa 31.1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.36.9",
            "verseOrgIds": [
              "ISA.36.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 36:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na yu nĩnambatĩte nde na Yeova kũkita na nthĩ ĩno nĩmyanange? Yeova ambĩa, Ambata ũkite na nthĩ ĩsu, ũmyanange. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.36.10",
            "verseOrgIds": [
              "ISA.36.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.10.5"
              },
              "items": [
                {
                  "text": "Isa 10.5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.10.6"
              },
              "items": [
                {
                  "text": "6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
