              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kweethĩwa mwaka wa ĩkũmi na ĩna wa kũsumbĩka kwa mũsumbĩ Esekia, Senakelivu mũsumbĩ wa Asuli ambatĩĩa ndũa mbiie syonthe sya Yuta, na asyosa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.36.1",
            "verseOrgIds": [
              "ISA.36.1"
            ]
          }
        },
        {
