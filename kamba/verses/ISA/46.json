            "number": "8",
            "style": "v",
            "sid": "ISA 46:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lilikanai ũu, na mũkyonan’ya mwĩ aũme; lilikanai ĩngĩ, ĩnyw’ĩ avĩtan’ya. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.8",
            "verseOrgIds": [
              "ISA.46.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 46:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lilikanai maũndũ mavĩtu ma tene: nũndũ ninyie Ngai, na vati ũngĩ; ninyie Ngai, na vati ũngĩ takwa; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.9",
            "verseOrgIds": [
              "ISA.46.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 46:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngĩtavan’ya mũminũkĩlyo kuma mwambĩlĩlyonĩ, na kuma tene tene maũndũ ala matanamba kwĩkwa; ngyasya, Ũtao wakwa ũkaũngama, na ngeeka kwenda kwakwa kw’onthe; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.10",
            "verseOrgIds": [
              "ISA.46.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
