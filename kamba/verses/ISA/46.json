          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngĩta nyũnyi mbai kuma ngalĩ ya wumĩlonĩ wa syũa, mũndũ wa ũtao wakwa kuma nthĩ ndasa; ĩĩ, nĩnĩneenete, na ngawĩanĩsya; nĩnĩsũanĩĩte, na ngawĩka. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.11",
            "verseOrgIds": [
              "ISA.46.11"
            ]
          }
        },
        {
