              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbĩthukĩĩsyai, inyw’ĩ mwĩ ngoo nyũmũ, ala mwĩ kũasa na ũlũngalu: ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.12",
            "verseOrgIds": [
              "ISA.46.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 46:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "nĩngũthengeesya ũlũngalu wakwa, ndwĩĩthĩwa wĩ kũasa, na ũtangĩĩo wakwa ndũtĩa kũka; na ngaia ũtangĩĩo nthĩnĩ wa Saioni kwondũ wa Isilaeli ũtaĩo wakwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.13",
            "verseOrgIds": [
              "ISA.46.13"
            ]
          }
        },
