              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninyie Yeova, nĩyo syĩtwa yakwa; na ũnene wakwa ndikanenga ũngĩ, kana ndaĩa yakwa kũmĩnenga mĩvw’anano myasũvye. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.8",
            "verseOrgIds": [
