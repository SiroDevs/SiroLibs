          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũũ katĩ wenyu wĩtea kũtũ ũndũnĩ ũũ? Ũla wĩthukĩĩsya na kwĩw’a ũndũ wa ĩvinda yũkĩte? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.23",
            "verseOrgIds": [
              "ISA.42.23"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
