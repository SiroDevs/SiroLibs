              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndakaĩa, o na ndakokĩlya wasya wake, o na ndakatuma wĩw’ĩka nzĩanĩ nene. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.2",
            "verseOrgIds": [
