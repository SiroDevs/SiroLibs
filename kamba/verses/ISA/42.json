          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "ũsalukye metho ma ililinda, wumye ala ove kasũmbanĩ ke nthĩnĩ wa nthĩ, na wumye nyũmbanĩ ya kolokolo ala mekalĩte kĩvindunĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.7",
