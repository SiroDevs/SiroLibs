          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sisya, maũndũ ma mbee nĩmekĩkĩte, na nĩngũtavan’ya maũndũ meũ; matanamba kumĩla nĩngũmũtavya ũndũ wamo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.9",
            "verseOrgIds": [
              "ISA.42.9"
            ]
          }
        },
