                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.51.13"
              },
              "items": [
                {
                  "text": "Yel 51.13",
                  "type": "text"
                }
              ]
            },
            {
