            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.40.4"
              },
              "items": [
                {
                  "text": "Isa 40.4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.2",
            "verseOrgIds": [
              "ISA.45.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
