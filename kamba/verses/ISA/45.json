            "sid": "ISA 45:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "na ngakũnenga syĩndũ syĩ vata mũno syĩ kĩvindunĩ, na mothwii mavithe ma kũndũ kũtesĩkĩwe, nĩ kana ũmanye atĩ ninyie Yeova, ũla ũkwĩtaa na syĩtwa yaku, o Ngai wa Isilaeli. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.3",
            "verseOrgIds": [
              "ISA.45.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
