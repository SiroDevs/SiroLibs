            "number": "17",
            "style": "v",
            "sid": "ISA 45:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ Isilaeli akatangĩĩwa nĩ Yeova na ũtangĩĩo wa tene na tene: mũtikasonokw’a kana kũthokoanw’a kũvika tene na tene. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.17",
            "verseOrgIds": [
              "ISA.45.17"
            ]
          }
        },
