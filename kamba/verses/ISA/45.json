          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngathi mbee waku, na ngatw’ĩkĩthya kũndũ kũthũku kũtindimalu; ngatilanga ilungu mĩomo ya ũthuku, na ngatilanga ivingi sya iaa; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.2",
            "verseOrgIds": [
              "ISA.45.2"
            ]
          }
        },
        {
