              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩ w’o nue Ngai ũla wĩvithaa, ame Ngai wa Isilaeli, Mũtangĩĩi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.15",
            "verseOrgIds": [
              "ISA.45.15"
            ]
