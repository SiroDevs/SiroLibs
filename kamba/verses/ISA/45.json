          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makasonokw’a, ĩĩ, makathokoanw’a, asu onthe; ala maseũvasya mĩvw’anano makalika kĩthokoonĩ vamwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.16",
            "verseOrgIds": [
              "ISA.45.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
