          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Woo nĩ wa ũla ũkũlasya ĩthe, Wĩsyaa kyaũ? Kana mũndũ mũka, Wĩaũnya kyaũ?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.10",
