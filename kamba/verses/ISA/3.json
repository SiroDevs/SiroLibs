          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngũa sya kwĩkĩa yĩla kwĩ mboka, na makoti maasa, na masuka ma ũvw’ĩka mũtwe, na ngusu sya mbesa; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.22",
            "verseOrgIds": [
              "ISA.3.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
