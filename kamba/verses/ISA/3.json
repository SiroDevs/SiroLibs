              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Andũ maku makavalũkw’a na ũvyũ, o na ala maku me ũtonyi kaũnĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.25",
            "verseOrgIds": [
              "ISA.3.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
