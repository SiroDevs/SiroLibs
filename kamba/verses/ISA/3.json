        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.12",
            "verseOrgIds": [
              "ISA.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
