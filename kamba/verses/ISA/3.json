          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngome, na syĩndũ sya wanake sya kwĩkĩa manyiũũ; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.21",
            "verseOrgIds": [
              "ISA.3.21"
            ]
          }
        },
        {
