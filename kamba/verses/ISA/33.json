          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 33:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "ũsu akekalaa ĩũlũ; vandũ vake va kũsũvĩĩwa vakeethĩwa ngome ya mavia; akanengwa lĩu wake; manzĩ make maikang’ala. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.16",
            "verseOrgIds": [
              "ISA.33.16"
            ]
          }
        },
