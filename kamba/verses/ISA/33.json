                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.14",
            "verseOrgIds": [
              "ISA.33.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 33:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ũla ũkinyaa ũlũngalunĩ, na kũneenaa w’o; ũla ũmenaa ũtandĩthyo wa kũthĩn’ya, ũla ũvuunzaa moko make ndakose ĩvaki, ũla ũlindaa matũ make matikew’a ũvoo wa nthakame, na kũlalya metho make matikone ũthũku: ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.15",
            "verseOrgIds": [
              "ISA.33.15"
            ]
          }
        },
        {
