              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ kw’oko kwa Yeova kũkekalaa kĩĩmanĩ kĩĩ; na Moavi ĩkakinyangĩwa nthĩ vandũ vayo, o tondũ ũa ũkinyangĩawa ũtũndanĩ wa kyaa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.10",
            "verseOrgIds": [
              "ISA.25.10"
            ]
          }
        },
