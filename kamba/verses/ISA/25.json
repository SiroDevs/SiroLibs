              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kĩĩmanĩ kĩĩ Yeova wa nguthu akavokea ngo syonthe sya andũ mboka ya syĩndũ nou, mboka ya mbinyu syĩ ĩũlũ wa kĩmongoyo, ya syĩndũ nou syusũĩte mũthungo, ya mbinyu syĩ ĩũlũ wa kĩmongoyo ikeletwe nesa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.6",
            "verseOrgIds": [
              "ISA.25.6"
            ]
          }
