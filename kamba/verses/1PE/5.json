            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩnyivyei ĩndĩ ungu wa kw’oko kwa Ngai kwĩ na vinya, nĩ kana amũnenevye ĩvinda yeanĩa; ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.6",
            "verseOrgIds": [
              "1PE.5.6"
            ]
          }
        },
        {
