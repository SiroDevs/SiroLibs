                "loc": "PSA.55.22"
              },
              "items": [
                {
                  "text": "Sav 55.22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.6.25"
              },
              "items": [
                {
                  "text": "Mt 6.25",
