            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "sũvĩai ĩĩthya ya Ngai yĩla yĩ kwenyu, mũkĩyĩsisya, ti ũndũ wa kũingĩĩw’a, ĩndĩ na kwenda, o na ti ũndũ wa kũunwa nĩ syĩndũ itaĩle, ĩndĩ na kĩlĩko kĩyũmbanĩtye; ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.2",
            "verseOrgIds": [
              "1PE.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1PE 5:3"
          },
          "items": [
