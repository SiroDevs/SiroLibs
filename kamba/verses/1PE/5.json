              "items": [
                {
                  "text": "2 Tim 4.8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na yĩla Mũĩthi mũnene ũkaumĩla, mũkoosa ngovia ya ũsumbĩ ya ũtheu mũtisu ĩla ĩtaalyũkaa. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.4",
            "verseOrgIds": [
              "1PE.5.4"
            ]
          }
        },
