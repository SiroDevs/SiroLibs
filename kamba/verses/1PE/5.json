                {
                  "text": "Avi 4.6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "mũkĩmwiĩa kwĩmakĩa kwenyu kw’onthe, nũndũ nĩwe ũmũsũvĩaa. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.7",
            "verseOrgIds": [
              "1PE.5.7"
            ]
