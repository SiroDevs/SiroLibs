            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "o na ti kwĩsumbĩkya kĩandanĩ kĩla mũnengetwe, ĩndĩ mũkĩtw’ĩkĩthya ene ngelekan’yo sya yĩla ĩĩthya. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.3",
            "verseOrgIds": [
              "1PE.5.3"
            ]
          }
        },
        {
