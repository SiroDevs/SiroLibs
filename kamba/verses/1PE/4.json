            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "nĩ kana kuma yu, ĩvinda yenyu yĩla yĩtiele mwĩ mwĩĩnĩ, mũikekalae mĩmeonĩ ya andũ, ĩndĩ kwendanĩ kwa Nagi. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.2",
            "verseOrgIds": [
              "1PE.4.2"
            ]
          }
        },
        {
