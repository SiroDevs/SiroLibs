            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ethĩwa mwĩvũthw’a kwondũ wa syĩtwa ya Klĩsto, mwĩ aathime: nĩkwĩthĩwa Veva wa ũtaĩo, o Veva wa Ngai, ekalaa ĩũlũ wenyu. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.14",
            "verseOrgIds": [
              "1PE.4.14"
            ]
          }
        },
        {
