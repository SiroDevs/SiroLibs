            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.2.2"
              },
              "items": [
                {
                  "text": "Aev 2.2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
