            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ĩndĩ ethĩwa mũndũ nũthĩnaw’a nĩkwĩthĩwa nĩ Mũklĩsto, ndakasonoke; ĩndĩ namũkathe Ngai syĩtwanĩ yĩũ. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.16",
            "verseOrgIds": [
