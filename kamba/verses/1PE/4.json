          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kũikethĩwe ũmwe wenyu kũthĩnw’a nĩkwĩthĩwa nĩ mũaani, kana kĩng’ei, kana mwĩki wa naĩ, kana mwĩlikya maũndũnĩ ma andũ angĩ: ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.15",
            "verseOrgIds": [
              "1PE.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
