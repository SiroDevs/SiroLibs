            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na athani makũlilye na kũmantha mũno ũvoo wa ũtangĩĩo ũsu, namo nĩmathanie ũndũ wa mumo ũla ũkoka kwenyu: ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.10",
            "verseOrgIds": [
              "1PE.1.10"
            ]
          }
        },
