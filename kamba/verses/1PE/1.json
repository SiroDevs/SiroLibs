                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "mũkyosa mũminũkĩlyo wa mũĩkĩĩo wenyu, naw’o nĩ ũtangĩĩo wa mathayũ menyu. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.9",
            "verseOrgIds": [
