              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "nĩ kana kũtatwa kwa mũĩkĩĩo wenyu, nakw’o kwĩ vata mũno kwĩ thaavu ũla wanangĩkaa o na watatwa na mwaki, kũtonye kũete ngatho na ndaĩa na nguma ĩvinda ya kwonanw’a kwa Yesũ Klĩsto: ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.7",
            "verseOrgIds": [
              "1PE.1.7"
            ]
          }
        },
