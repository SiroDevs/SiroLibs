                  "text": "Lk 2.13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao nĩmooniw’e, kana ti kwondũ woo ene, ĩndĩ nĩ kwondũ wenyu, mathũkũmie maũndũ asu, ala matavaniw’e kwenyu nĩ andũ ala mamũtavisye ũvoo mũseo nthĩnĩ wa Veva Mũtheu ũla watũmiwe kuma ĩtunĩ; maũndũ asu alaĩka mendaa ũkunĩkĩla.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.12",
            "verseOrgIds": [
