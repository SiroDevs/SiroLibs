              },
              "items": [
                {
                  "text": "Aevl 12.24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwĩanana na ũndũ Ngai Asa wamanyie kuma tene, kwondũ wa kũvathanw’a nĩ Veva kwĩthĩwe atheu kũvika kwĩw’a na kũminzangĩw’a nthakame ya Yesũ Klĩsto: Mumo nĩwĩthĩwe nenyu na mũuo nĩwingĩvw’e.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.2",
            "verseOrgIds": [
              "1PE.1.2"
            ]
          }
        }
      ]
    },
