                  "text": "Sav 22.1",
                  "type": "text"
                }
              ]
            },
            {
              "text": "Isa 52.13—53.12",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.24.26"
