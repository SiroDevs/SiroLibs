                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "twĩthĩwe na ũtiĩwa ũtanangĩkaa, na ũtavukaa, na ũtathelaa, wiĩtwe ĩtunĩ kwondũ wenyu, ",
          "type": "text",
          "attrs": {
