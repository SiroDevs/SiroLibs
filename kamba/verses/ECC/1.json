              "type": "tag",
              "attrs": {
                "loc": "ECC.2.9"
              },
              "items": [
                {
                  "text": "Mũta 2.9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
