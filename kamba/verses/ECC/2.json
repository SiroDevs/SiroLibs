                {
                  "text": "1 Asu 12.13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.12.14"
              },
              "items": [
