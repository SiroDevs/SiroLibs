            }
          ]
        },
        {
          "text": "Nũndũ nũũ ũtonya kũya, kana nũũ ũtonya kwĩthĩwa na ũtanu, kwĩ nyie? ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.25",
            "verseOrgIds": [
