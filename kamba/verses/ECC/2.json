              "attrs": {
                "loc": "SNG.4.16"
              },
              "items": [
                {
                  "text": "Wa 4.16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "SNG.5.1"
              },
              "items": [
                {
                  "text": "5.1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.5",
            "verseOrgIds": [
              "ECC.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ECC 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "nĩneeseũvĩsye ndia sya manzĩ, nĩnyithasye na manzĩ asu mũtitũ kũla kũvandĩtwe mĩtĩ mĩnini yĩane; ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.6",
            "verseOrgIds": [
              "ECC.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ECC 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "nĩnathooie athũkũmi aũme na eĩtu, na naĩ na athũkũmi ala masyaĩwe nyũmbanĩ yakwa; o na naĩ na ũthwii wa ndĩthya sya ng’ombe na sya mbũi na malondu, kwĩ onthe ala maĩ Yelusaleme mbee wakwa; ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.7",
            "verseOrgIds": [
              "ECC.2.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.14.14"
              },
              "items": [
                {
                  "text": "Mwa 14.14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.7",
            "verseOrgIds": [
              "ECC.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ECC 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "o na nĩneeyũmbanĩsye vetha na thaavu, na ũthwii wa asumbĩ na wa ilungu nene sya nthĩ; nĩneeyosee aini aũme na aini aka, na motanu ma ana ma andũ, na syĩndũ sya kũinga, nasyo syaĩ sya mĩthemba yonthe. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.8",
            "verseOrgIds": [
              "ECC.2.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
