        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ECC 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.17",
            "verseOrgIds": [
              "ECC.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ECC 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na namena wĩa wakwa w’onthe ũla neethĩnĩsye ĩtheo wa syũa, nũndũ no mũvaka nĩũtiĩe mũndũ ũla ũkethĩwa ĩtina wakwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.18",
            "verseOrgIds": [
              "ECC.2.18"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
