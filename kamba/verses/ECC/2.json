            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ECC 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ noona kana ũĩ nũvĩtũkĩte motanu kũasa, o tondũ kyeni kĩvĩtũkĩte kĩvindu. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.13",
            "verseOrgIds": [
              "ECC.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ECC 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Metho ma mũndũ mũĩ me mũtwe kwake, na ndia nĩkinyaa kĩvindunĩ: ĩndĩ noona atĩ ũndũ ũmwe nĩwĩkĩkaa kwa onthe. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.14",
            "verseOrgIds": [
              "ECC.2.14"
            ]
          }
        },
        {
