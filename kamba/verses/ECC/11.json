              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩkya kĩmũtũ kyaku ĩũlũ wa manzĩ; nũndũ ũkakyona ĩtina wa mĩthenya mingĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.1",
            "verseOrgIds": [
              "ECC.11.1"
            ]
          }
