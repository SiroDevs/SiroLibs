                {
                  "text": "Sav 112.9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.6.30"
              },
              "items": [
                {
                  "text": "Lk 6.30",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.5.16"
              },
              "items": [
                {
                  "text": "Aev 5.16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.2",
            "verseOrgIds": [
              "ECC.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ECC 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ethĩwa mathweo nĩmausũĩtwe nĩ mbua, nĩmekwonosya manzĩ mamo ĩũlũ wa nthĩ; na ethĩwa mũtĩ nũũvalũka kwelekela ngalĩ ya ĩtheo, kana kwelekela ngalĩ ya ĩũlũ, vandũ, vala mũtĩ wĩvalũka, vu novo ũkethĩwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.3",
            "verseOrgIds": [
              "ECC.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ECC 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ũla ũsiasya kĩseve ndakavuĩa; na ũla ũsiasya mathweo ndakaketha. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.4",
            "verseOrgIds": [
              "ECC.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ECC 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "O ũndũ ũtesĩ nzĩa ya kĩseve, kana ũndũ mavĩndĩ meanaa ĩvunĩ ya ũla mũito; o ta ũu ndwĩsĩ wĩa wa Ngai ũla wĩkaa maũndũ onthe. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.5",
            "verseOrgIds": [
              "ECC.11.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.139.15"
              },
              "items": [
                {
                  "text": "Sav 139.15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.3.8"
              },
              "items": [
                {
                  "text": "Yoa 3.8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.5",
            "verseOrgIds": [
              "ECC.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ECC 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kĩoko vuĩa mbeũ syaku, na wĩoo ndũkasiĩĩe kw’oko kwaku; nũndũ ndwĩsĩ ila ikaĩla, ethĩwa nĩ ii kana iya, kana ethĩwa syelĩ ikeethĩwa nzeo ũndũ ũmwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.6",
            "verseOrgIds": [
              "ECC.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ECC 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩ w’o kyeni kĩ mũyo, na kũsisya syũa nĩkwendeeasya metho. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.7",
            "verseOrgIds": [
              "ECC.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ECC 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩĩ, ethĩwa mũndũ akekala thayũ myaka mingĩ, natane nthĩnĩ wayo yonthe; ĩndĩ nalilikane mĩthenya ya kĩvindu, nũndũ ĩkeethĩwa mingĩ. Kyonthe kĩla kyũkaa nĩ mana. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.8",
            "verseOrgIds": [
              "ECC.11.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
