            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũtavan’ya nĩwatatie kwona ndeto syĩ mũyo, na ũvoo ũla ũandĩkĩtwe ũlũngalunĩ, o ndeto sya w’o.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.10",
            "verseOrgIds": [
