              },
              "items": [
                {
                  "text": "Mwa 43.14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.16",
            "verseOrgIds": [
              "EST.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EST 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ Molitekai eeyĩendea, na eeka kwĩanana na w’onthe ũla Esita wamwĩaĩe.",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.17",
            "verseOrgIds": [
              "EST.4.17"
            ]
