                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.50.20"
              },
              "items": [
                {
                  "text": "50.20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.14",
            "verseOrgIds": [
              "EST.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EST 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩvo ĩndĩ Esita wameaĩe mamũtũngĩe Molitekai ũsũngĩo, ",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.15",
            "verseOrgIds": [
              "EST.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EST 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enda, ũmban’ye Ayuti onthe ala me Susani, na mũitĩĩa kũya nũndũ wakwa, o na mũikaye o na mũikanyw’e mĩthenya ĩtatũ, ũtukũ kana mũthenya: nyie nakwa na eĩtu athũkũmi makwa tũkatĩĩa kũya o ta ũu; na ĩndĩ ngaenda vala ve mũsumbĩ, o na kau ti kwĩanana na mwĩao: na ethĩwa nĩngwaa, nongwaa. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.16",
            "verseOrgIds": [
              "EST.4.16"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
