          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.12",
            "verseOrgIds": [
              "EST.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EST 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩvo ĩndĩ Molitekai wameaĩe mamũtũngĩe Esita ũsũngĩo, Ndũkeesũanĩĩe mwene kana ũkavĩtĩa nyũmbanĩ ya mũsumbĩ, kwĩ Ayuti onthe. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.13",
            "verseOrgIds": [
              "EST.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EST 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ ethĩwa ũkavindya ki ĩvinda yĩĩ, nĩvo ĩndĩ ũthasyo na ũvonokyo ũkookĩla kwa Ayuti kuma vandũ vangĩ, ĩndĩ we na nyũmba ya au mũkaaa: na nũũ wĩsĩ kana ndwaalika ũsumbĩnĩ nũndũ wa ĩvinda ta yĩĩ? ",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.14",
            "verseOrgIds": [
              "EST.4.14"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
