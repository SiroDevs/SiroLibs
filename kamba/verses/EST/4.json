              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ yĩla Molitekai wamanyie w’onthe ũla wĩkĩtwe, Molitekai atembũanga ngũa syake, na eekĩa makunia na kwĩyũmba mũu, na aenda na ku ndũani katĩ, na akaya na wasya mũtũlu na kĩĩo kĩ woo; ",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.1",
            "verseOrgIds": [
              "EST.4.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
