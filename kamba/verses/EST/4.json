              },
              "items": [
                {
                  "text": "2 Asu 19.1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.1",
            "verseOrgIds": [
              "EST.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EST 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "na ooka o vu mbee wa mbingĩlo ya kwa mũsumbĩ: nũndũ vatyaĩ ũtonya kũlika mbingĩlonĩ kwa mũsumbĩ ekĩe makunia. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.2",
            "verseOrgIds": [
              "EST.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EST 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kĩla kĩlungu kĩnene kya nthĩ, o vala mwĩao wa mũsumbĩ na ũtw’ĩo wake wavikie, kwaĩ woo mũnene katĩ wa Ayuti, na kũtĩĩa kũya, na kũĩa, na kũmeta; na aingĩ makoma makunianĩ na mũunĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.3",
            "verseOrgIds": [
              "EST.4.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
