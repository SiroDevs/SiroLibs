          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩvo ĩndĩ mũsumbĩ wamavokee anene make onthe me mbee ũsumbĩnĩ na athũkũmi make mboka nene, nayo nĩ mboka ya Esita; na athũmũsya ilungu nene sya nthĩ koti, na anengane mĩthĩnzĩo, kwĩanana na ũlau wa mũsumbĩ.",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.18",
            "verseOrgIds": [
              "EST.2.18"
            ]
          }
        }
      ]
    },
