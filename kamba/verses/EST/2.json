                {
                  "text": "1 Asu 1.2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.2",
            "verseOrgIds": [
              "EST.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EST 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "na mũsumbĩ naie anene ilungunĩ nene syonthe sya nthĩ sya ũsumbĩ wake, nĩ kana mombanĩsye eĩtu onthe ma mũika atheu na aseo nyũmbanĩ nene ya ũsumbĩ ku Susani, nyũmbanĩ ya aka, ũsũvĩonĩ kwa Ekai, mũvakũe wa kwa mũsumbĩ, ũla ũsũvĩaa aka; na manengwe syĩndũ syoo kwondũ wa kwĩthesya; ",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.3",
            "verseOrgIds": [
              "EST.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EST 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "na mwĩĩtu ũla wĩendeesya mũsumbĩ natw’ĩke mũka wa mũsumbĩ vandũ va Vasiti. Na ũndũ ũsu wendeesya mũsumbĩ; na eeka ũu.",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.4",
            "verseOrgIds": [
              "EST.2.4"
            ]
          }
        }
      ]
    },
