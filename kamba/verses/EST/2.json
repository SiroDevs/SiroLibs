          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "ũla watwaĩtwe kuma Yelusaleme na ala matavĩtwe vamwe na Yekonĩa mũsumbĩ wa Yuta, ũla Nevukatilesa mũsumbĩ wa Mbaviloni wamũtwaie. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.6",
            "verseOrgIds": [
              "EST.2.6"
            ]
          }
        },
        {
