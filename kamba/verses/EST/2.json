          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kwaĩ Mũyuti ũmwe nyũmbanĩ ya ũsumbĩ ku Susani, ũla wetawa Molitekai, mwana wa Yaili, mwana wa Simei, mwana wa Kisu, Mũmbenyamini, ",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.5",
            "verseOrgIds": [
              "EST.2.5"
            ]
          }
        },
        {
