              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kweethĩwa mĩthenyanĩ ya Aasuelo (Aasuelo ũsu nĩ ũla wasumbĩkĩte kuma India o na kũvika Ethiovia, ĩũlũ wa ilungu nene sya nthĩ ĩana na mĩongo ĩlĩ na mũonza), ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.1",
            "verseOrgIds": [
              "EST.1.1"
            ]
          }
        },
        {
