          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "na ala mamũatĩĩe ũnenenĩ maĩ Kalisena, na Sethali, na Atimatha, na Talisisi, na Melesi, na Malisena, na Memukani, anene mũonza me mbee ũsumbĩnĩ ma Velisia na Metia, ala moonaa ũthyũ wa mũsumbĩ, na mekalaa me ma mbee ũsumbĩnĩ ũsu), ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.14",
            "verseOrgIds": [
              "EST.1.14"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.25.19"
              },
              "items": [
                {
                  "text": "2 Asu 25.19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
