          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake Vasiti mũka wa mũsumbĩ avokea iveti ila syaĩ nyũmbanĩ ya kĩũsumbĩ ya mũsumbĩ Aasuelo mboka. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.9",
            "verseOrgIds": [
              "EST.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EST 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũthenya wa mũonza, yĩla ngoo ya mũsumbĩ yatanĩtw’e nĩ mbinyu, ameaĩa Meumani, na Mbisitha, na Alivona, na Mbikitha, na Avakitha, na Nzethali, na Kalikasi, avakũe mũonza ala mathũkũmĩaa mbee wa mũsumbĩ Aasuelo, ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.10",
            "verseOrgIds": [
              "EST.1.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
