              },
              "items": [
                {
                  "text": "1 Sam 15.32",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.15.33"
              },
              "items": [
                {
                  "text": "33",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.1",
            "verseOrgIds": [
              "EST.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EST 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na athũkũmi onthe ma mũsumbĩ, ala maĩ mbingĩlonĩ kwa mũsumbĩ, makunama, na kũmwĩkunamĩsya Amani vyũ; nũndũ mũsumbĩ nĩweaĩte ũu ũndũ wake. Ĩndĩ Molitekai ndaakunama, o na kũmwĩkunamĩsya. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.2",
            "verseOrgIds": [
              "EST.3.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EST.5.9"
              },
              "items": [
                {
                  "text": "Est 5.9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.2",
            "verseOrgIds": [
              "EST.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EST 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩvo ĩndĩ athũkũmi ma mũsumbĩ, ala maĩ mbingĩlonĩ kwa mũsumbĩ, makũlilye Molitekai, Nĩkĩ ũũtũla mwĩao wa mũsumbĩ? ",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.3",
            "verseOrgIds": [
              "EST.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EST 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ kweethĩwa, makĩneena nake mũthenya na mũthenya, nake ndaamethukĩĩsya, mamũtavya Amani, masisye ethĩwa maũndũ ma Molitekai makaũngama: nũndũ amatavĩtye kana nĩ Mũyuti. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.4",
            "verseOrgIds": [
              "EST.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EST 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na yĩla Amani wonie kana Molitekai ndaakunama, o na kũmwĩkunamĩsya, nĩvo ĩndĩ Amani wausũiwe nĩ ũthilĩku. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.5",
            "verseOrgIds": [
              "EST.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EST 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ asũanĩa ndwĩanĩa kũmũkwata Molitekai e weka; nũndũ nĩmamũmanyĩthĩtye ũko wa andũ wa Molitekai: kwondũ wa ũu Amani amantha kũmananga Ayuti onthe ala maĩ ũsumbĩnĩ w’onthe wa Aasuelo, o ũko wa andũ wa Molitekai.",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.6",
            "verseOrgIds": [
              "EST.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
