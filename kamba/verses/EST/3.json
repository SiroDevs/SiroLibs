          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwei wa mbee, naw’o nĩ mwei wa Nisani, mwaka wa ĩkũmi na ĩlĩ wa kũsumbĩka kwa mũsumbĩ Aasuelo, mekya Vuli, naw’o nĩ kũlimana, vu mbee wa Amani mũthenya na mũthenya, na mwei na mwei, kũvika mwei wa ĩkũmi na ĩlĩ, naw’o nĩ mwei wa Atali. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.7",
            "verseOrgIds": [
              "EST.3.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
