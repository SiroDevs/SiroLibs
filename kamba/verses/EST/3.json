            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mũsumbĩ amwĩa Amani, Ũla vetha nĩwanengwa, o na ũko wa andũ naw’o, wĩke naw’o ũndũ ũkwona wĩ ũseo.",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.11",
            "verseOrgIds": [
              "EST.3.11"
            ]
          }
        }
