              "EST.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EST 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Amani amwĩa mũsumbĩ Aasuelo, Ve ũko ũmwe wa andũ ũnyaĩĩkĩe kũũ na kũũ katĩ wa ngo sya andũ ilungunĩ nene sya nthĩ sya ũsumbĩ waku; na mĩao yoo ĩ kĩvathũkan’yo na ya kĩla ũko wa andũ; o na maikwataa mĩao ya mũsumbĩ: kwondũ wa ũu kũti ũuno kwa mũsumbĩ kũmaeka mekale. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.8",
            "verseOrgIds": [
              "EST.3.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
