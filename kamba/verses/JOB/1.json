                "loc": "JOB.42.13"
              },
              "items": [
                {
                  "text": "Yovu 42.13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.2",
            "verseOrgIds": [
              "JOB.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "O na ũthwii wake naw’o waĩ malondu ngili mũonza, na ngamĩle ngili itatũ, na syove maana atano sya ng’ombe, na mang’oi maka maana atano, na andũ aingĩ mũno ma nyũmba yake; kwondũ wa ũu mũndũ ũsu aĩ mũnene kwĩ ana onthe ma ngalĩ ya wumĩlonĩ wa syũa. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.3",
            "verseOrgIds": [
              "JOB.1.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.6.3"
              },
              "items": [
                {
                  "text": "Asi 6.3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.3",
            "verseOrgIds": [
              "JOB.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ana make maenda makĩvoka mboka nyũmbanĩ ya kĩla ũmwe mũthenya wake; na matũmana mameta eĩtu‐a‐inyia moo atatũ maye na kũnyw’a nao. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.4",
            "verseOrgIds": [
              "JOB.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kweethĩwa, yĩla mĩthenya ya mboka yoo yakomanie, kana Yovu atũmana amatheethya, na ookĩla kĩoko tene, na athemba nthembo sya kũvĩvw’a kwĩanana na ũtalo woo onthe: nũndũ Yovu aasya, Nokwĩthĩwa ana makwa nĩmavĩtisye, na kũmũuma Ngai ngoonĩ syoo. Ũu now’o Yovu wekaa mavinda onthe. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.5",
            "verseOrgIds": [
              "JOB.1.5"
            ]
          }
        },
        {
