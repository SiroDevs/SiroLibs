          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na asyaĩwe ana mũonza na eĩtu atatũ. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.2",
            "verseOrgIds": [
