          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "atĩ mũtũmwa ooka vala ve Yovu, na amwĩa, Ng’ombe syĩĩ ikĩĩma na mang’oi makĩya vakuvĩ nasyo; ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.14",
            "verseOrgIds": [
              "JOB.1.14"
            ]
          }
        },
        {
