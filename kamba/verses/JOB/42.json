          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ Yovu akw’a, e mũkũu na wa matukũ maingĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.17",
