            "sid": "JOB 42:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ Elivasi Mũtemani na Mbilitati Mũsui na Nzovali Mũnamaathi maenda, na meeka kwĩanana na ũndũ Yeova wameaĩe: na Yeova amwĩtĩkĩla Yovu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.9",
            "verseOrgIds": [
              "JOB.42.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
