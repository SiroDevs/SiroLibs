              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yeova amũthatĩa Aluni mũno akyenda kũmũaa: nakwa ĩvinda yĩu namũvoyea Aluni nake. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.20",
