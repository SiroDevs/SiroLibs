              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na namũvoya Yeova, ngyasya, Ame Mwĩaĩi Yeova, ndũkanange andũ maku na ũtiĩwa waku, ala wamovoisye kwondũ wa ũnene waku, ala wamaumisye Misili na kw’oko kwĩ vinya. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.26",
            "verseOrgIds": [
              "DEU.9.26"
            ]
          }
        },
