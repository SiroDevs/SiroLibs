          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩvinda yĩu Yeova avatha mbaĩ ya Livai, ĩkuae ĩsandũkũ ya ũtianĩo ya Yeova, na kũũngamaa mbee wa Yeova ĩmũthũkũme, na kũathimaa syĩtwanĩ yake, kũvika ũmũnthĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.8",
            "verseOrgIds": [
              "DEU.10.8"
            ]
          }
        },
