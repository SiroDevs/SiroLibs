            "number": "4",
            "style": "v",
            "sid": "DEU 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake aandĩka masengeanĩ asu, o ũndũ ũandĩko wa mbee wailyĩ, ĩla mĩao ĩkũmi, ĩla Yeova wamũtavĩsye kĩĩmanĩ, e katĩ wa mwaki mũthenya wa ũmbano: na Yeova anenga nyie. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.4",
            "verseOrgIds": [
              "DEU.10.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
