        },
        {
          "text": "Ĩvinda yĩu Yeova ambĩa, Asũvya masengea elĩ ma mavia mailyĩ ta ala ma mbee, na ambata vala nĩĩ kĩĩmanĩ, na tuma ĩsandũkũ ya mĩtĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.1",
            "verseOrgIds": [
              "DEU.10.1"
            ]
          }
        },
