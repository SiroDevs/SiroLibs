          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "O na ndũkamwĩw’ĩe ĩtomo mũka wa mũtũi waku; o na ndũkew’ĩe ĩtomo nyũmba ya mũtũi waku, kana mũũnda wake, kana mũthũkũmi wake mũndũ mũũme, kana mũthũkũmi wake mwĩĩtu, kana ng’ombe yake, kana ĩng’oi yake, kana kĩndũ o na kĩva kya mũtũi waku.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.21",
            "verseOrgIds": [
              "DEU.5.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 5:21"
          },
          "items": [
