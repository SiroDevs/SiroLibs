                {
                  "text": "Kuma 24.12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.4.11"
              },
              "items": [
                {
                  "text": "Kũt 4.11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.22",
            "verseOrgIds": [
              "DEU.5.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DEU 5:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kweethĩwa, mweew’a wasya wĩ kĩvindunĩ, yĩla kĩĩma kyakanĩte mwaki, mwanthengeea, o atongoi onthe ma mbaĩ syenyu, na atumĩa menyu; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.23",
            "verseOrgIds": [
              "DEU.5.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 5:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "na mwanbĩa, Sisya, Yeova Ngai waitũ nũtwonetye ũtheu mũtisu wake na ũnene wake, na ithyĩ nĩtwĩw’ĩte wasya wake wĩ nthĩnĩ wa mwaki: ũmũnthĩ nĩtwoona kana Ngai nũneenaa na mũndũ, nake akekala thayũ. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.24",
            "verseOrgIds": [
              "DEU.5.24"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.4.33"
              },
              "items": [
                {
                  "text": "Kũt 4.33",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.24",
            "verseOrgIds": [
              "DEU.5.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DEU 5:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na yu ĩndĩ twĩkw’ĩa kĩ? Nũndũ mwaki ũũ mũnene ũkatũmina: ethĩwa tũkeew’a ĩngĩ wasya wa Yeova Ngai waitũ, tũkakw’a. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.25",
            "verseOrgIds": [
              "DEU.5.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DEU 5:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ nĩ wĩva wa onthe me mĩĩ, ũla wewie wasya wa Ngai ũla wĩ thayũ akĩneena e katĩ wa mwaki, o tondũ tweew’a, nake akekala thayũ? ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.26",
            "verseOrgIds": [
              "DEU.5.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DEU 5:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Thi ũthengeee, wĩw’e w’onthe ũla Yeova Ngai waitũ wĩneena: naku ũtũtavye w’onthe ũla Yeova Ngai waitũ wĩneena naku; naitũ tũkawĩw’a, na kũwĩka. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.27",
            "verseOrgIds": [
              "DEU.5.27"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
