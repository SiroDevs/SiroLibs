              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninyie Yeova Ngai waku, ũla wakumisye nthĩ ya Misili, ũkumya nyũmbanĩ ya ũkombo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.6",
            "verseOrgIds": [
              "DEU.5.6"
            ]
