          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ũtianĩo ũũ Yeova ndaatianĩa na aaĩthe maitũ, ĩndĩ nĩ ithyĩ, o ithyĩ ala twĩ thayũ vaa ithyonthe ũmũnthĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.3",
            "verseOrgIds": [
              "DEU.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeova aneena nenyu ũthyũ kwa ũthyũ kĩĩmanĩ e mwakinĩ ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.4",
            "verseOrgIds": [
              "DEU.5.4"
            ]
          }
        },
