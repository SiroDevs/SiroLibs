        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 5:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndeto isu Yeova aneena na ũmbano wenyu w’onthe kĩĩmanĩ e katĩ wa mwaki, na mũumbĩnĩ, na kĩvindunĩ kya ngokomi, na wasya mũnene: o na ndaongela. Na aiandĩka masengeanĩ elĩ ma mavia, na anenga nyie. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.22",
            "verseOrgIds": [
              "DEU.5.22"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
