              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "(nakwa naũngama katĩ wa Yeova nenyu ĩvinda yĩu, nĩmwon’ye ndeto ya Yeova: nĩkwĩthĩwa nĩmwakĩaa nũndũ wa mwaki, na mũtyaambata kĩĩmanĩ), akĩmwĩa, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.5",
            "verseOrgIds": [
              "DEU.5.5"
            ]
          }
        },
        {
