          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.11",
            "verseOrgIds": [
              "DEU.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lilikana mũthenya wa savato, ũwĩkalye wĩ mũtheu, o tondũ Yeova Ngai waku wakwĩaĩe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.12",
            "verseOrgIds": [
              "DEU.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tethya wĩa mĩthenya thanthatũ, wĩke mawĩa maku onthe; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.13",
            "verseOrgIds": [
              "DEU.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "ĩndĩ mũthenya wa mũonza nĩ savato wa Yeova Ngai waku: mũthenya ũsu ndũkatethye wĩa o na wĩva, we, kana mwana waku, kana mwĩĩtu waku, kana mũthũkũmi waku mũndũ mũũme, kana mũthũkũmi waku mwĩĩtu, kana ng’ombe yaku, kana ĩng’oi yaku, kana indo syaku o na syĩva, kana mũeni waku ũla wĩ kwaku; nĩ kana mũthũkũmi waku mũndũ mũũme na mũthũkũmi waku mwĩĩtu mathũmũe o taku. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.14",
            "verseOrgIds": [
              "DEU.5.14"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
