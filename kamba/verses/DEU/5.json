        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.14",
            "verseOrgIds": [
              "DEU.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na lilikana atĩ waĩ mũthũkũmi nthĩ ya Misili, na Yeova Ngai waku akumya vo na kw’oko kwĩ vinya na kw’oko kũtambũũku: kwondũ wa ũu Yeova Ngai waku nĩwakwĩaĩe ũlilikane mũthenya wa savato. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.15",
            "verseOrgIds": [
              "DEU.5.15"
            ]
          }
        },
