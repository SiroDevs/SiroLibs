            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.20.9",
            "verseOrgIds": [
              "DEU.20.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 20:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yĩla ũkathengeea ndũa ũkite nayo, nĩvo ĩndĩ mĩkũlye wĩw’ano. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.20.10",
            "verseOrgIds": [
              "DEU.20.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
