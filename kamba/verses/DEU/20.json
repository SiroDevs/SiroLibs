                "loc": "DEU.2.26"
              },
              "items": [
                {
                  "text": "Kũt 2.26",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.21.13"
              },
              "items": [
                {
                  "text": "Asi 21.13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.20.20"
              },
              "items": [
                {
                  "text": "2 Sam 20.20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.20.10",
            "verseOrgIds": [
              "DEU.20.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 20:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kũkeethĩwa, ethĩwa ĩkakũsũngĩa ũsũngĩo wa mũuo, na ũkũvingũĩa, nĩvo kũkethĩwa, kana andũ onthe ala makethĩwa nthĩnĩ wayo makatw’ĩka maku, na makakũthũkũma. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.20.11",
            "verseOrgIds": [
              "DEU.20.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.9.21"
              },
              "items": [
                {
                  "text": "1 Asu 9.21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.20.11",
            "verseOrgIds": [
              "DEU.20.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 20:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ethĩwa ĩkalea kwĩw’ana naku, ĩndĩ ĩkenda kũkita naku, nĩvo ũkamĩthyũlũlũka ũmĩtw’ĩkanĩsye: ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.20.12",
            "verseOrgIds": [
              "DEU.20.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 20:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "na yĩla Yeova Ngai waku ũkamĩnengane kw’okonĩ kwaku, ũaa kĩla mũndũ mũũme wayo kwa kũmũtemanga na ũvyũ: ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.20.13",
            "verseOrgIds": [
              "DEU.20.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.31.7"
              },
              "items": [
                {
                  "text": "Mot 31.7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.20.13",
            "verseOrgIds": [
              "DEU.20.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 20:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "ĩndĩ aka, na twana tũnini, na indo, na kyonthe kĩla kĩ ndũanĩ, o mũtavo wayo w’onthe, osa wĩthĩwe waku mwene; na wĩya mũtavo wa amaitha maku, ũla Yeova Ngai waku ũkũnengete. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.20.14",
            "verseOrgIds": [
              "DEU.20.14"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.31.9"
              },
              "items": [
                {
                  "text": "Mot 31.9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.8.2"
              },
              "items": [
                {
                  "text": "Yos 8.2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.20.14",
            "verseOrgIds": [
              "DEU.20.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 20:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩka ũu ndũa syonthe ila syĩ kũasa naku, ila ite sya ndũa sya mbaĩ ii. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.20.15",
            "verseOrgIds": [
              "DEU.20.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 20:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ nthĩnĩ wa ndũa sya mbaĩ ii, ila Yeova Ngai waku ũkũnengae syĩthĩwe ũtiĩwa waku, ndũkakĩtie kĩ thayũ kĩndũ kĩla kĩvevaa; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.20.16",
            "verseOrgIds": [
              "DEU.20.16"
            ]
          }
        },
        {
