        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 20:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "ĩndĩ maminei vyũ: Mũititi, na Mũamoli, na Mũkanaani, na Mũvelisi, na Mũivi, na Mũyevusi; o tondũ Yeova Ngai waku wakwĩaĩe; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.20.17",
            "verseOrgIds": [
              "DEU.20.17"
            ]
          }
        },
        {
