              "DEU.20.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kũkeethĩwa, yĩla mwĩthengeea kaũnĩ, mũthembi akathengeea na kũneena na andũ, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.20.2",
            "verseOrgIds": [
              "DEU.20.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "na akamea, Ĩw’ai, Isilaeli, ũmũnthĩ nĩmũthengeea kũkita na amaitha menyu: ngoo syenyu itikaleele; mũikakĩe, kana kũtetema, o na mũikatĩsw’e nĩo; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.20.3",
            "verseOrgIds": [
              "DEU.20.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "nũndũ Yeova Ngai wenyu nĩwe ũendaa nenyu, ũmũkitĩaa amitha menyu, amũtangĩĩe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.20.4",
            "verseOrgIds": [
              "DEU.20.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.1.30"
              },
              "items": [
                {
                  "text": "Kũt 1.30",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.3.22"
              },
              "items": [
                {
                  "text": "3.22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.23.10"
              },
              "items": [
                {
                  "text": "Yos 23.10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.20.4",
            "verseOrgIds": [
              "DEU.20.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na anene makaneena na andũ, makyasya, Nĩ mũndũ wĩva ũla wakĩte nyũmba nzaũ, na ndanamba ũmĩvingũa? Naende asyoke nyũmbanĩ kwake, ndakese kũkw’ĩa kaũnĩ, na mũndũ ũngĩ aimĩvingũa. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.20.5",
            "verseOrgIds": [
              "DEU.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na nĩ mũndũ wĩva ũla ũvandĩte mũũnda wa mĩsavivũ, na ndanamba kũya ũsyao waw’o? Naende asyoke nyũmbanĩ kwake, ndakese kũkw’ĩa kaũnĩ, na mũndũ ũngĩ aiya ũsyao waw’o. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.20.6",
            "verseOrgIds": [
              "DEU.20.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na nĩ mũndũ wĩva ũla ũasĩtye mwĩĩtu, na ndanamba ũmũtwaa? Naende asyoke nyũmbanĩ kwake, ndakese kũkw’ĩa kaũnĩ, na mũndũ ũngĩ aimũtwaa. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.20.7",
            "verseOrgIds": [
              "DEU.20.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na anene asu makaendeea na kũneena na andũ, na makasya, Nũũ ũla wĩ na w’ĩa na mũleelu ngoonĩ? Naende asyoke nyũmbanĩ kwake, ngoo sya ana‐a‐ithe make itikese kũtweka o ta ngoo yake. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.20.8",
            "verseOrgIds": [
              "DEU.20.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.7.3"
              },
              "items": [
                {
                  "text": "Asi 7.3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.20.8",
            "verseOrgIds": [
              "DEU.20.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kũkeethĩwa, anene mamina kũneena na andũ, makaia makavuteni ma nguthu methĩwe atongoi ma andũ.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.20.9",
            "verseOrgIds": [
              "DEU.20.9"
            ]
          }
        }
      ]
    },
    {
