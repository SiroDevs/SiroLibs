                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "RUT.4.7"
              },
              "items": [
                {
                  "text": "Lu 4.7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.9",
            "verseOrgIds": [
              "DEU.25.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na syĩtwa yake yĩkeetawa kwa Isilaeli, Nyũmba ya mumw’a kĩatũ.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.10",
            "verseOrgIds": [
              "DEU.25.10"
            ]
          }
        }
      ]
    },
