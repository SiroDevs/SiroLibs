            "number": "5",
            "style": "v",
            "sid": "DEU 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ethĩwa mũndũ na mwana‐a‐inyia mekalaa vamwe, na ũmwe aikw’a, na nde na mwana wa kavĩsĩ, kĩveti kya ũla wakwie kĩikatwawe nĩ mũeni: mwana‐a‐inyia wa mũũme akalike kwake, na kũmũtw’ĩkĩthya mũka wake, na kũmwĩka ũndũ waĩlĩte mwana‐a‐inyia wa mũũme. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.5",
            "verseOrgIds": [
              "DEU.25.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
