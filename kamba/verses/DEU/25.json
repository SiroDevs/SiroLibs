              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngusunĩ yaku ndũkethĩwe na mavia mavathũkene ma ũthima namo, manene na manini. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.13",
