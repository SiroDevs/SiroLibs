          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yĩla aũme meũkita, na kĩveti kya ũmwe kĩkathengeea kũmũtaan’ya mũũme kw’okonĩ kwa ũla ũnũũmũkũna, na kũtambũũkya kw’oko kwakyo, na ũkwata ũũme wake; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.11",
            "verseOrgIds": [
              "DEU.25.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "kĩtile kw’oko kwakyo, itho yaku yĩtikew’ĩe tei.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.12",
            "verseOrgIds": [
              "DEU.25.12"
            ]
          }
        }
      ]
    },
