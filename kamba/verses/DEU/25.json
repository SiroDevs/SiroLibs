          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndũkamyove ng’ombe kanyw’a, ĩkĩvũa lĩu wa mbaa ngetha. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.4",
            "verseOrgIds": [
              "DEU.25.4"
            ]
          }
        },
        {
