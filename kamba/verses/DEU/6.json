              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "na atumya kw’o, nĩ kana atũlikye kũũ, atũnenge nthĩ ĩla wamevĩtĩe aaĩthe maitũ. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.23",
            "verseOrgIds": [
