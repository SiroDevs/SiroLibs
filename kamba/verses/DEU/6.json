          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "naku imanyĩasye syana syaku na kĩthing’ĩĩsyo, na ineenae ndeto isu yĩla ũilyĩ nyũmbanĩ yaku, na yĩla ũendaa nzĩanĩ, na yĩla ũkomaa, na yĩla wũkĩlaa. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.7",
            "verseOrgIds": [
              "DEU.6.7"
            ]
          }
        },
        {
          "name": "note",
