          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na syoveee kw’okonĩ kwaku syĩthĩwe wonan’yo, na syĩthĩwe ũlilikan’yo katĩ wa metho maku. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.8",
            "verseOrgIds": [
              "DEU.6.8"
            ]
