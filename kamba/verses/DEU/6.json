          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "na nyũmba syusĩe syĩndũ syonthe nzeo, ila ũtaausũsya, na ithima mbĩnze, ila ũtaaĩnza, na mĩũnda ya mĩsavivũ na mĩthata, ĩla ũtaavanda, naku ũkaya na kũvũna; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.11",
            "verseOrgIds": [
              "DEU.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
