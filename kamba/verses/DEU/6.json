              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩka ũla Yeova wonaa wĩ wa w’o na ũseo; nĩ kana kwĩthĩwe ũseo kwaku, na nĩ kana ũtonye kũlika na kũmesya nthĩ ĩsu nzeo ĩla Yeova wevĩtĩe aaĩthe maku, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.18",
            "verseOrgIds": [
              "DEU.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "kũlũngya amaitha maku onthe maume mbee waku, o tondũ Yeova ũneenete.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.19",
            "verseOrgIds": [
              "DEU.6.19"
            ]
