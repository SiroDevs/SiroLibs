        {
          "text": "Na ndeto ii, ila ngũkwĩaĩa ũmũnthĩ, ikeethĩwa ngoonĩ yaku; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.6",
            "verseOrgIds": [
