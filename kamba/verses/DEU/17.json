          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "na nĩ mũendu kũthũkũma ngai ingĩ, na kwithaitha, kana syũa, kana mwei, kana imwe sya nguthu ya ĩtunĩ, ũndũ ndaeaa, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.3",
            "verseOrgIds": [
              "DEU.17.3"
            ]
          }
        },
