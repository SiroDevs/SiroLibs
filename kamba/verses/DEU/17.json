              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndũkathembee Yeova Ngai waku ng’ombe, kana ĩlondu, yĩla yĩ kĩema, kana ũndũ o na wĩva ũthũku; nũndũ ũndũ ũsu nũmũthatasya Yeova Ngai waku. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.1",
            "verseOrgIds": [
              "DEU.17.1"
            ]
          }
        },
