          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa kanyw’a wa ngũsĩ ilĩ, kana ngũsĩ itatũ, ũla wa kũawa nĩoaawe; ndakoawe kwa kanyw’a wa ngũsĩ ĩmwe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.6",
            "verseOrgIds": [
              "DEU.17.6"
            ]
          }
        },
        {
