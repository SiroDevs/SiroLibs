          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ethĩwa kũkooneka nthĩnĩ waku, nthĩnĩ wa mbingĩlo syaku o na syĩva ila Yeova Ngai waku ũkũnengae, mũndũ mũũme kana mũndũ mũka, ũla wĩkaa ũla Yeova Ngai waku wonaa wĩ ũthũku, aivĩtya ũtianĩo wake, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.2",
            "verseOrgIds": [
              "DEU.17.2"
            ]
          }
        },
