              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.5",
            "verseOrgIds": [
              "DEU.17.5"
            ]
          }
        },
        {
          "name": "verse",
