                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.14",
            "verseOrgIds": [
              "DEU.17.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "mũvaka ũmwie ũla Yeova Ngai waku wĩnyuva ethĩwe mũsumbĩ waku; ia ũmwe wa ana‐a‐au akũsumbĩke; ndũkaamũsumbĩkye mũndũ wa nthĩ ĩngĩ, ũla ũte mwana‐a‐au. ",
          "type": "text",
