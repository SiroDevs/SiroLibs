          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yĩla wĩvika nthĩ ĩla Yeova Ngai waku ũkũnengae, na wamĩmesya, na kũtũa vo, na kwasya, Ngaia mũsumbĩ anzumbĩke, ta mbaĩ syonthe ila inthyũlũlũkĩte; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.14",
            "verseOrgIds": [
              "DEU.17.14"
            ]
          }
        },
