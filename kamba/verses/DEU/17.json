          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na andũ onthe makeew’a, na kũkĩa, na matikang’enda ĩngĩ.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.13",
