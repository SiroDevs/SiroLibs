              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũndũ ũsyaĩwe ũlaalainĩ ndakaalike ũmbanonĩ wa Yeova; o na kũvika nzyawa ya ĩkũmi kũikaalike ũmwe wake ũmbanonĩ wa Yeova.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.2",
