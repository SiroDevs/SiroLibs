            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na andũ onthe moombanĩa vamwe ta mũndũ ũmwe vala vandũ vathanthau vaĩ mbee wa mbingĩlo ya manzĩ; na matavya mũandĩki Esala aete ĩvuku ya mĩao ya Mose, ĩla Yeova weaĩe Isilaeli. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.1",
            "verseOrgIds": [
              "NEH.8.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
