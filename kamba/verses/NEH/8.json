            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "O na Yesua, na Mbani, na Selevia, na Yamini, na Akuvu, na Savethai, na Otia, na Maaseia, na Kelita, na Asalia, na Yosavati, na Aananu, na Velaia, na Alivai, mamalyũlĩla andũ ĩla mĩao: na andũ no maũngeme vala maĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.7",
            "verseOrgIds": [
              "NEH.8.7"
            ]
          }
        },
