              "attrs": {
                "loc": "NEH.3.26"
              },
              "items": [
                {
                  "text": "Nee 3.26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.1",
