                "loc": "LEV.23.24"
              },
              "items": [
                {
                  "text": "Ali 23.24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.31.11"
              },
              "items": [
                {
                  "text": "Kũt 31.11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.2",
            "verseOrgIds": [
              "NEH.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NEH 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake ayĩsoma elekele vala vandũ vathanthau vaĩ mbee wa mbingĩlo ya manzĩ kuma kĩoko tene kũvika mũthenya katĩ, e mbee wa aũme na aka, na ala maĩ matonya kũmanya; na matũ ma andũ onthe meethukĩĩsye ĩvuku ya mĩao. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.3",
            "verseOrgIds": [
              "NEH.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NEH 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mũandĩki Esala aũngama vandũ vatũlu vakĩtwe na mĩtĩ, vala maseũvisye kwondũ wa ũndũ ũsu; na ũtee wake kwaũngama Matithia, na Sema, na Anaia, na Uliya, na Ilikia, na Maaseia, kw’okonĩ kwake kwa aũme; na kw’okonĩ kwake kwa aka kwaũngama Vetaia, na Misaeli, na Malikiya, na Asumu, na Asivatana, na Nzekalia, na Mesulamu. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.4",
            "verseOrgIds": [
              "NEH.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NEH 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Esala avuũa ĩvuku andũ onthe mene (nũndũ aĩ ĩũlũ wa andũ onthe); na yĩla wayĩvuũie, andũ onthe maũngama. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.5",
            "verseOrgIds": [
              "NEH.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NEH 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Esala amũtaia Yeova, Ngai mũnene; na andũ onthe masũngĩa, Ameni, Ameni, makyũkĩlya moko moo: na makunamya mĩtwe yoo, na mathaitha Yeova mothyũ moo melekelye nthĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.6",
            "verseOrgIds": [
              "NEH.8.6"
            ]
          }
        },
        {
