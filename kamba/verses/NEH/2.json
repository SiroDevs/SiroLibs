          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩvo ĩndĩ mũsumbĩ wangũlilye, Wĩenda ata? Na ĩndĩ navoya Ngai wa itunĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.4",
            "verseOrgIds": [
              "NEH.2.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZR.5.12"
              },
              "items": [
                {
                  "text": "Esa 5.12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.1.4"
              },
              "items": [
                {
                  "text": "Nee 1.4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.1.5"
              },
              "items": [
                {
