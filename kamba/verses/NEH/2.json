              "NEH.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NEH 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na namwĩa mũsumbĩ, Ethĩwa mũsumbĩ nũkwendeew’a, na ethĩwa mũthũkũmi waku nĩwonete ũseo vala ũĩ, nĩenda ũndũme ku Yuta, ndũanĩ yĩ ngunga sya aaĩthe makwa vala vathikawa akw’ũ, nĩmĩtũngĩĩe. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.5",
            "verseOrgIds": [
              "NEH.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NEH 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mũsumbĩ angũlya (kĩveti kyake nakyo kyekalĩte vamwe nake), Kyalo kyaku kĩkeethĩwa kya ĩvinda yĩana ata? Na ũkasyoka ĩndĩĩ? Na ĩndĩ mũsumbĩ nĩwendeew’e nĩ kũndũma; nakwa namũtavya ĩvinda. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.6",
            "verseOrgIds": [
              "NEH.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NEH 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩngĩ namwĩa mũsumbĩ, Ethĩwa nĩkũmwendeesya mũsumbĩ, nĩnengwe mavalũa, nĩmatwaĩe makavana ala me mũingo wa ũla Ũsĩ, nĩ kana manenge ũthei nĩvĩte mũvaka nĩvike Yuta; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.7",
            "verseOrgIds": [
              "NEH.2.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZR.8.36"
              },
              "items": [
                {
                  "text": "Esa 8.36",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.7",
            "verseOrgIds": [
              "NEH.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NEH 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "na valũa wa kũmũtwaĩa Asavu, mũsũvĩi wa mũtitũ wa mũsumbĩ, nĩ kana anenge mĩtĩ nĩseũvye mĩamba ya mbingĩlo sya nyũmba nene yĩ kĩemo ĩla ĩkwatanĩte na ĩ nyũmba, na ya ũvai wa ndũa, na ya nyũmba ĩla nĩmĩlika. Na mũsumbĩ nĩwanengie, kwĩanana na kw’oko kũseo kwa Ngai wakwa ĩũlũ wakwa. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.8",
            "verseOrgIds": [
              "NEH.2.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
