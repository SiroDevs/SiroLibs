            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.4",
            "verseOrgIds": [
              "NEH.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NEH 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "na ndũkavw’ĩke ũthũku woo, na naĩ yoo ndĩkavutwe vala ũĩ; nũndũ nĩmakũthatisye aki mene. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.5",
            "verseOrgIds": [
              "NEH.4.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
