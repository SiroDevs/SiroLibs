            "number": "1",
            "style": "v",
            "sid": "NEH 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ kweethĩwa yĩla Sanavalati wewie kana nĩtũtũngĩĩa ũvai, athilĩka, na akwatwa nĩ woo mũnene, na amathekeea Ayuti mũno. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.1",
            "verseOrgIds": [
              "NEH.4.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.2.10"
              },
              "items": [
                {
                  "text": "Nee 2.10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.1",
            "verseOrgIds": [
              "NEH.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NEH 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na aneenea vu mbee wa ana‐a‐ĩthe na ita sya Samalia, na akũlya, Ayuti aa mate na vinya meĩka ata? Makelũlũmĩlya? Makathemba nthembo? Makamina mũthenya o ũmwe? Makokĩlya mavia kuma ivumbunĩ sya mavuthĩ, na nĩ mavĩvye? ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.2",
            "verseOrgIds": [
              "NEH.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NEH 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ Tovia Mũamimoni aĩ vakuvĩ nake, na asya, Wako ũũ mekwaka, ethĩwa mbĩwa ĩkambata ĩũlũ, ĩkaomboa ũvai woo wa mavia. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.3",
            "verseOrgIds": [
              "NEH.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NEH 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩthukĩĩsye, ame Ngai waitũ; nũndũ nĩtũũvũthw’a: na tũnga kũtũvũthya kwoo mĩtwenĩ yoo ene, noimanengane methĩwe mũtavo nthĩ ya kũtavwa; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.4",
            "verseOrgIds": [
              "NEH.4.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
