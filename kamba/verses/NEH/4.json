              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.5",
            "verseOrgIds": [
              "NEH.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NEH 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ nĩtwatũngĩĩe ũvai; na ũvai w’onthe wakwatanw’a kũvika nyunzu ya ũtũlu waw’o: nũndũ andũ maĩ na kwenda kwa kũtethya wĩa.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.6",
            "verseOrgIds": [
              "NEH.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NEH 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.6",
            "verseOrgIds": [
              "NEH.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NEH 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ kweethĩwa, yĩla Sanavalati, na Tovia, na Alavu, na Aamimoni, na Aasitoti, meewie kana kũtũngĩĩa kwa maũvai ma Yelusaleme nĩkũendeeaa, na moomboku nĩmambĩlĩlw’e kũlindwa, nĩvo ĩndĩ mathilĩkile mũno; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.7",
            "verseOrgIds": [
              "NEH.4.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.2.10"
              },
              "items": [
                {
                  "text": "Nee 2.10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.7",
            "verseOrgIds": [
              "NEH.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NEH 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "na onthe masũanĩa vamwe moke mokite na Yelusaleme, na kwĩkĩa kĩthokoo nthĩnĩ wayo. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.8",
            "verseOrgIds": [
              "NEH.4.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.83.3+PSA.83.4+PSA.83.5"
              },
              "items": [
                {
                  "text": "Sav 83.3–5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.8",
            "verseOrgIds": [
              "NEH.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NEH 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ twamũvoya Ngai waitũ, na twaia asyaĩĩsya mũthenya na ũtukũ, nũndũ woo. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.9",
            "verseOrgIds": [
              "NEH.4.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.14.38"
              },
              "items": [
                {
                  "text": "Mko 14.38",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.9",
            "verseOrgIds": [
              "NEH.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NEH 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yuta asya, Vinya wa ala makuaa mĩio nĩ mũoleku, na ve mavuthĩ maingĩ; na kwondũ wa ũu tũtitonya kwaka ũvai. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.10",
            "verseOrgIds": [
              "NEH.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NEH 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na nthũ sitũ syasya, Matikamanya, o na kwona, kũvika yĩla twĩlika katĩ woo, na kũmoaa, na kũekethya ũ wĩa. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.11",
            "verseOrgIds": [
              "NEH.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NEH 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kweethĩwa, yĩla Ayuti ala matwĩe vakuvĩ nao mookie, matũtavya mavinda ĩkũmi kuma kũndũ kw’onthe, Mũvaka mũtũsyokee. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.12",
            "verseOrgIds": [
              "NEH.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NEH 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwondũ wa ũu naia andũ kũndũ kwĩ ĩtheo mũno ũtheinĩ wĩ mbĩlĩlo wa ũvai, kũndũ kũthei, naia vo andũ kũatĩĩa mĩvĩa yoo me na mbyũ syoo, na matumo moo, na mata moo. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.13",
            "verseOrgIds": [
              "NEH.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NEH 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na nasisya, na nookĩla, na namea ala anene me ndaĩa, na asumbĩki, na andũ ala angĩ, Mũtikamakĩe: lilikanai Mwĩaĩi, ũla mũnene na wa kũtĩsya, na mũimokitĩa ana‐a‐ĩthe menyu, na ana menyu na eĩtu menyu, na iveti syenyu, na nyũmba syenyu. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.14",
            "verseOrgIds": [
              "NEH.4.14"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
