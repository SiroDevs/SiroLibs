            "sid": "NEH 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩtina wake Melemothi mwana wa Uliya mwana wa Akosi atũngĩĩa kĩlungu kĩngĩ, kuma mũomonĩ wa nyũmba ya Eliasivu o kũvika mũthya wa nyũmba ya Eliasivu. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.21",
            "verseOrgIds": [
              "NEH.3.21"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
