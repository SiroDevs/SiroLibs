          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na itina wake Atekoa matũngĩĩa kĩlungu kĩngĩ, kwelekela mwako mũnene mũtũlu wa mũnyoolo ũla wumĩlĩte, na kũvika ũvai wa Oveli. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.27",
