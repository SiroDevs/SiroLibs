              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.30",
            "verseOrgIds": [
              "NEH.3.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NEH 3:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩtina wake Malikiya ũmwe wa atwii ma thaavu atũngĩĩa kũvika nyũmba ya Anethini, na ya athoosya ma mĩio, kwelekela mbingĩlo ya Amivikati, na kũvika kwambata kwa kĩkoto. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.31",
            "verseOrgIds": [
              "NEH.3.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NEH 3:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na atwii ma thaavu ma athoosya ma mĩio matũngĩĩa katĩ wa kwambata kwa kĩkoto na mbingĩlo ya malondu. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.32",
            "verseOrgIds": [
              "NEH.3.32"
            ]
          }
