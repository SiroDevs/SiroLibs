              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Asoli, na Lama, na Ngitaimu, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.33",
            "verseOrgIds": [
              "NEH.11.33"
            ]
          }
        },
