              "type": "text"
            }
          ]
        },
        {
          "text": "Na andũ mamaathima andũ onthe ala meenenganie na kwenda kwa ngoo matuae Yelusaleme.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.2",
