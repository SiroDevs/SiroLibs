        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.14",
            "verseOrgIds": [
              "NEH.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NEH 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ma Alivai: Semaia mwana wa Asuvu, mwana wa Asilikamu, mwana wa Asavia, mwana wa Mbuni; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.15",
            "verseOrgIds": [
              "NEH.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NEH 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Savethai na Yosavati, ma anene ma Alivai, ala maĩ asyaĩĩsya ma wĩa wa nza wa nyũmba ya Ngai; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.16",
            "verseOrgIds": [
              "NEH.11.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NEH 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Matania mwana wa Mika, mwana wa Nzaveti, mwana wa Asavu, ũla waĩ mũtongoesya wa kwambĩlĩlya kũtũnga mũvea mboyanĩ, na Mbakivukia, ũla waĩ wa kelĩ katĩ wa ana‐a‐ĩthe make; na Avata mwana wa Samua, mwana wa Ngalali, mwana wa Yetuthuni. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.17",
            "verseOrgIds": [
              "NEH.11.17"
            ]
          }
        },
