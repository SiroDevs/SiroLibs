              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Nzikilaki, na Mekona na tũtũla twayo, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.28",
            "verseOrgIds": [
