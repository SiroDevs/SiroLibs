              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ana ma Mbenyamini nao nĩmatũaa kuma Ngeva na mbee wa kw’o, Mikimasi na Aiya, na ku Mbethi‐eli na tũtũla twayo, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.31",
            "verseOrgIds": [
              "NEH.11.31"
            ]
          }
        },
