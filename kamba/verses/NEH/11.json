            "number": "23",
            "style": "v",
            "sid": "NEH 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ kwaĩ mwĩao wumĩte kwa mũsumbĩ ũndũ woo, na wĩanĩsyo wa mavata nũtw’ĩtwe kwondũ wa aini, o tondũ mavata ma kĩla mũthenya meanaa. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.23",
            "verseOrgIds": [
              "NEH.11.23"
            ]
          }
        },
