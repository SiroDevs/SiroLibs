                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ yĩla Mwana wa mũndũ ũkoka ũtheunĩ wake mũtisu, na alaĩka onthe vamwe nake, nĩvo ũkekalĩla kĩvĩla kya ũsumbĩ kya ũtheu wake mũtisu: ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.31",
            "verseOrgIds": [
              "MAT.25.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 25:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.14.10"
              },
              "items": [
                {
                  "text": "Alo 14.10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "na mbee wake nikomban’wa mbaĩ syonthe: nake nũkamavathan’ya aa na aya, tondũ mũĩthi ũvathanasya malondu na mbũi; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.32",
            "verseOrgIds": [
              "MAT.25.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 25:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.34.17"
              },
              "items": [
                {
                  "text": "Esek 34.17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "na nũkaia malondu ngalĩ ya kw’oko kwake kwa aũme, ĩndĩ mbũi ngalĩ ya kw’oko kwake kwa aka. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.33",
            "verseOrgIds": [
              "MAT.25.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MAT 25:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ Mũsumbĩ nũkamea ala me ngalĩ ya kw’oko kwake kwa aũme, Ũkai inyw’ĩ mũathimĩtwe nĩ Asa wakwa, osai ũsumbĩ ũla mwaseũvĩw’e kuma mwambĩlĩlyo wa nthĩ: ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.34",
            "verseOrgIds": [
              "MAT.25.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MAT 25:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.58.7"
              },
              "items": [
                {
                  "text": "Isa 58.7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "nũndũ naĩ na nzaa, na mwanenga kya ũya; naĩ na waũni, na mwanenga kya ũnyw’a; naĩ mũeni, na mwanthokya; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.35",
            "verseOrgIds": [
              "MAT.25.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MAT 25:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "naĩ mũthei, na mwambw’ĩka; naĩ mũwau, na mwooka ũnzisya; naĩ kolokolonĩ, na mwooka vala naĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.36",
            "verseOrgIds": [
              "MAT.25.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MAT 25:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.6.3"
              },
              "items": [
                {
                  "text": "Mt 6.3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩvo ala alũngalu makamũsũngĩa, makyasya, Mwĩaĩi, nĩ ĩndĩĩ twakwonie wĩ na nzaa, twaũnenga kya ũya? Kana wĩ na waũni, na twaũnenga kya ũnyw’a? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.37",
            "verseOrgIds": [
              "MAT.25.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MAT 25:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na nĩ ĩndĩĩ twakwonie wĩ mũeni, na twakũthokya? Kana wĩ mũthei, na twakũvw’ĩka? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.38",
            "verseOrgIds": [
              "MAT.25.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "MAT 25:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na nĩ ĩndĩĩ twakwonie wĩ mũwau, kana wĩ kolokolonĩ, na twooka vala waĩ? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.39",
            "verseOrgIds": [
              "MAT.25.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "MAT 25:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.19.17"
              },
              "items": [
                {
                  "text": "Nth 19.17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.2.11"
              },
              "items": [
                {
                  "text": "Aevl 2.11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Mũsumbĩ akasũngĩa na kũmea, Nĩ w’o nĩngũmwĩa, O ũndũ mwamwĩkie ũmwe wa ana‐a‐asa aa makwa, o na ala anini, mwambĩkie nyie. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.40",
            "verseOrgIds": [
              "MAT.25.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "MAT 25:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.7.23"
              },
              "items": [
                {
                  "text": "Mt 7.23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩvo ũkamea asu nao ala me ngalĩ ya kw’oko kwake kwa aka, Umai vaa nĩĩ, inyw’ĩ mwaumanĩwe, mũthi mwakinĩ wa tene na tene ũla waseũvĩw’e Satani na alaĩka make: ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.41",
            "verseOrgIds": [
              "MAT.25.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "MAT 25:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "nũndũ naĩ na nzaa, na mũtyaanenga kya ũya; naĩ na waũni, na mũtyaanenga kya ũnyw’a; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.42",
            "verseOrgIds": [
              "MAT.25.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "MAT 25:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "naĩ mũeni, na mũtyaanthokya; naĩ mũthei, na mũtyaambw’ĩka; naĩ mũwau, na naĩ kolokolonĩ, na mũtyaaũka kũnzisya. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.43",
            "verseOrgIds": [
              "MAT.25.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "MAT 25:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ asu nao makasũngĩa, makyasya, Mwĩaĩi, nĩ ĩndĩĩ twakwonie wĩ na nzaa, kana wĩ na waũni, kana wĩ mũeni, kana wĩ mũthei, kana wĩ mũwau, kana wĩ kolokolonĩ, na twalea ũkũtethya? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.44",
            "verseOrgIds": [
              "MAT.25.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "MAT 25:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩvo ũkamasũngĩa, akyasya, Nĩ w’o nĩngũmwĩa, O ũndũ mũtaamwĩka ũmwe wa aa anini, mũtyaambĩka nyie. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.45",
            "verseOrgIds": [
              "MAT.25.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "MAT 25:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.5.29"
              },
              "items": [
                {
                  "text": "Yoa 5.29",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.12.2"
              },
              "items": [
                {
                  "text": "Nda 12.2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na asu makathi makalika thĩnanĩ wa tene wa tene; ĩndĩ ala alũngalu makalika thayũnĩ ũtathela.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.46",
            "verseOrgIds": [
              "MAT.25.46"
            ]
          }
        }
      ]
