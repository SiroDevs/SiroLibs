              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.1",
            "verseOrgIds": [
              "MAT.20.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.21.33"
              },
              "items": [
                {
                  "text": "Mt 21.33",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ ũsumbĩ wa ĩtu ũilyĩ ta mũndũ mwene wa nyũmba, ũla waumaalile kĩoko tene kũandĩka atethya ma wĩa ma mũũnda wake wa mũsavivũ. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.1",
            "verseOrgIds": [
              "MAT.20.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na eeaanĩa na atethya ma wĩa kũmanenga mũthenya silingi ĩmwe, amatũma mũũndanĩ wake wa mĩsavivũ. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.2",
            "verseOrgIds": [
              "MAT.20.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na aumaala ta saa itatũ, na oona angĩ maũngeme kĩng’ang’anĩ mate na wĩa; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.3",
            "verseOrgIds": [
              "MAT.20.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "na asu amea, Nenyu endai mũũndani wa mĩsavivũ, na ngamũnenga kĩla kĩmwĩanĩe. Nao mathi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.4",
            "verseOrgIds": [
              "MAT.20.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aumaala ĩngĩ ta syũa yaũngama na saa kenda, eeka o ta ũu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.5",
            "verseOrgIds": [
              "MAT.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ta saa ĩkũmi na ũmwe aumaala, na oona angĩ maũngeme; na amakũlya, Nĩkĩ mũũngamie vaa mũthenya mũima mũte na wĩa? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.6",
            "verseOrgIds": [
              "MAT.20.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mamwĩa, Nĩkwĩthĩwa vai mũndũ ũnatũandĩka. Amea, Endai nenyu mũũndanĩ wa mĩsavivũ. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.7",
            "verseOrgIds": [
              "MAT.20.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kwavika wĩoo, ũla mwene wa mũũnda wa mĩsavivũ amwĩa mũũngamĩi wa kwake, Mete atethya ma wĩa, ũmanenge ĩtuvi yoo, wambĩlĩlye kuma ũla wa ĩtina kũvivika ũla wa mbee. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.8",
            "verseOrgIds": [
              "MAT.20.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mooka ala maandĩkiwe ta saa ĩkũmi na ũmwe, manengwa kĩla mũndũ silingi ĩmwe. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.9",
            "verseOrgIds": [
              "MAT.20.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 20:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ala ma mbee mooka, matalĩthya kana makoosa mbee; nao manengwa kĩla mũndũ silingi ĩmwe. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.10",
            "verseOrgIds": [
              "MAT.20.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 20:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na moosa, mamũnyungunyĩĩsya ũla mwene wa nyũmba, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.11",
            "verseOrgIds": [
              "MAT.20.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 20:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "makyasya, Aa ma ĩtina matethya wĩa saa o ũmwe, naku wameanan’ya naitũ ala tũmĩĩsye thĩna na ũvyũvu wa mũthenya mũima. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.12",
            "verseOrgIds": [
              "MAT.20.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 20:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ asũngĩa ũmwe woo, amwĩa, Mũnyanyawa ndinakwĩka naĩ: ndũneaanĩa nakwa silingi ĩmwe? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.13",
            "verseOrgIds": [
              "MAT.20.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 20:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Osa kĩla kyaku, noithi; nĩ kwenda kwakwa kũmũnenga ũũ wa ĩtina o taku. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.14",
            "verseOrgIds": [
              "MAT.20.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 20:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.9.16"
              },
              "items": [
                {
                  "text": "Alo 9.16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.9.21"
              },
              "items": [
                {
                  "text": "21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.6.23"
              },
              "items": [
                {
                  "text": "Mt 6.23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kũiosana na mĩao nyie kwĩka ũndũ ngwenda na syĩndũ syakwa mwene? Kana itho yaku nĩ ĩthũku nĩkwĩthĩwa nyie nĩ mũseo? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.15",
            "verseOrgIds": [
              "MAT.20.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 20:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.19.30"
              },
              "items": [
                {
                  "text": "Mt 19.30",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "No ta ũu ala me ĩtina makethĩwa me mbee, na ala me mbee makethĩwa me ĩtina.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.16",
            "verseOrgIds": [
              "MAT.20.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 20:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.16",
            "verseOrgIds": [
              "MAT.20.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 20:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yesũ akyambata Yelusaleme, oosa ala amanyĩw’a ĩkũmi na elĩ nzama, na me nzĩanĩ amea, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.17",
            "verseOrgIds": [
              "MAT.20.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 20:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.16.21"
              },
              "items": [
                {
                  "text": "Mt 16.21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.17.22"
              },
              "items": [
                {
                  "text": "17.22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.17.23"
              },
              "items": [
                {
                  "text": "23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sisyai, nĩtũkwambata Yelusaleme; na Mwana wa mũndũ akanenganwe mokonĩ ma athembi anene na aandĩki; nao makamũsilĩla oawe, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.18",
            "verseOrgIds": [
              "MAT.20.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 20:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "na makamũnengane mokonĩ ma Andũ‐ma‐mbaĩ‐ingĩ mamũthekee na kĩvũthya, na kũmũvũa, na kũmwamba ngelan’yonĩ: na mũthenya wa katatũ akathayũũkw’a.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.19",
            "verseOrgIds": [
              "MAT.20.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
