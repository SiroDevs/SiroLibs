                "loc": "MRK.9.35"
              },
              "items": [
                {
                  "text": "Mko 9.35",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "na o ũla ũkwenda kwĩthĩwa wa mbee katĩ wenyu akeethĩwa ngombo yenyu: ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.27",
            "verseOrgIds": [
              "MAT.20.27"
            ]
          }
        },
