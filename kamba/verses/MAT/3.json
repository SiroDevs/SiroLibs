              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "na sisya, wasya wauma matunĩ, ũkyasya, Ũũ nĩwe Mwana wakwa mwendwa, ũla nendeeaw’a nĩwe.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.17",
