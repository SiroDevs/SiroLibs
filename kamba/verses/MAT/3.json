              "type": "text"
            }
          ]
        },
        {
          "text": "Na matukũ asu Yoana Mũvatisi aumĩla, akĩtavan’ya weũnĩ wa Yutia, akyasya, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.1",
            "verseOrgIds": [
