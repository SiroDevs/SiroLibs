                {
                  "text": "Mt 4.17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alyũlai ngoo; nũndũ ũsumbĩ wa ĩtu nĩ mũthengeeu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.2",
            "verseOrgIds": [
              "MAT.3.2"
            ]
          }
        },
        {
