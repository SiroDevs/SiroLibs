              "attrs": {
                "loc": "MAT.10.1"
              },
              "items": [
                {
                  "text": "Mt 10.1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩvo ĩndĩ ala amanyĩw’a maendie vala ve Yesũ kasama, masya, Nĩkĩ ithyĩ tũinatonya kũmyumya? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.19",
            "verseOrgIds": [
              "MAT.17.19"
            ]
          }
        },
        {
