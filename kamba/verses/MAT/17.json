            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na yĩla mekalĩte Kalilii, Yesũ amea, Mwana wa mũndũ ethi kũnenganwe mokonĩ ma andũ; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.22",
            "verseOrgIds": [
