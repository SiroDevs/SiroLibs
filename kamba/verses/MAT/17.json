          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "nao makamũaa, na mũthenya wa katatũ akathayũũkw’a. Nao meew’a woo mũno.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.23",
