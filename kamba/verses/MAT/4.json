            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.3.2"
              },
              "items": [
                {
                  "text": "Mt 3.2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuma ĩvinda yĩu Yesũ ambĩlĩlya kũtavan’ya, na kwasya, Alyũlai ngoo; nũndũ ũsumbĩ wa ĩtu ni mũthengeeu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.17",
            "verseOrgIds": [
              "MAT.4.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
