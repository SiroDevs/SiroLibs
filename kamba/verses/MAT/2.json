            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.1.46"
              },
              "items": [
                {
                  "text": "Yoa 1.46",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "na athi atũa ndũanĩ yĩtawa Nasaleti; nĩ kana kwĩanĩw’e ũla waneeniwe nĩ athani, kana we aketwa Mũnasaleti.",
          "type": "text",
