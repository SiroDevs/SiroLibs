              "type": "text"
            }
          ]
        },
        {
          "text": "Yesũ amea, Mũtyaamba ũsoma maandĩkonĩ,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.42",
            "verseOrgIds": [
