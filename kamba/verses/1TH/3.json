                "loc": "ACT.17.14"
              },
              "items": [
                {
                  "text": "Meko 17.14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.17.15"
              },
              "items": [
                {
                  "text": "15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwondũ wa ũu yĩla twaĩ tũtatonya kũmĩĩsya mbee wa ũu, nĩtwoonie nĩ ũseo tũtiwe Athene ithyoka; ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.1",
            "verseOrgIds": [
              "1TH.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1TH 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.16.1+ACT.16.2+ACT.16.3"
              },
              "items": [
                {
                  "text": "Meko 16.1–3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "na twamũtũma Timotheo, mwana‐a‐asa waitũ na mũthũkũmi wa Ngai ũvoonĩ mũseo wa Klĩsto, amũlũlũmĩlye, na kũmũkiakisya mũĩkĩĩonĩ wenyu; ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.2",
            "verseOrgIds": [
              "1TH.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1TH 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "nĩ kana kũikethĩwe mũndũ o na wĩva kũthingithangw’a nĩ mathĩna aa; nĩkwĩthĩwa inyw’ĩ ene nĩmwĩsĩ nĩmo twiĩwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.3",
            "verseOrgIds": [
              "1TH.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1TH 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TH.3.10"
              },
              "items": [
                {
                  "text": "2 Ath 3.10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.14.22"
              },
              "items": [
                {
                  "text": "Meko 14.22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ nĩ w’o, yĩla twaĩ nenyu, nĩtwamũtavisye mbee kana tũkathĩnw’a; o tondũ kweekĩkie, nenyu nĩmwĩsĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.4",
            "verseOrgIds": [
              "1TH.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1TH 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.2.16"
              },
              "items": [
                {
                  "text": "Avi 2.16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwondũ wa ũu nyie nakwa, yĩla ndaĩ ndonya kũmĩĩasya ĩngĩ, natũmanie nĩ kana nĩmanye mũĩkĩĩo wenyu, kana ũla mũtati nĩwĩthĩwa amũtatie inyw’ĩ na ũndũ o na wĩva, na wĩa witũ ũla twathĩnĩaa ũkethĩwa wĩ wa mana. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.5",
            "verseOrgIds": [
              "1TH.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1TH 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.18.5"
              },
              "items": [
                {
                  "text": "Meko 18.5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ yu yĩla Timotheo woka kwitũ kuma kwenyu, na atũetee ũvoo mũseo wa mũĩkĩĩo wenyu na wendo, na ĩngĩ kana mũtũlilikanaa nesa mavinda onthe, mwĩ na mea ma kũtwona, o ũndũ naitũ twĩ na mea ma kũmwona; ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.6",
            "verseOrgIds": [
              "1TH.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1TH 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TH.1.4"
              },
              "items": [
                {
                  "text": "2 Ath 1.4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwondũ wa ũu, ana‐a‐asa, nĩtũkiakiiw’e kwondũ wenyu thĩnanĩ na ũnyamaonĩ witũ w’onthe kwondũ wa mũĩkĩĩo wenyu: ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.7",
            "verseOrgIds": [
              "1TH.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1TH 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "nũndũ yu twĩ thayũ ethĩwa inyw’ĩ nĩmũkũũngama na ũlũmu nthĩnĩ wa Mwĩaĩi. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.8",
            "verseOrgIds": [
              "1TH.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1TH 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ nĩ mũvea wĩva ũla tũtonya kũmũtũngĩa Ngai kwondũ wenyu, nũndũ wa ũtanu w’onthe ũla tũtanaa kwondũ wenyu mbee wa Ngai waitũ; ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.9",
            "verseOrgIds": [
              "1TH.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1TH 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "tũkĩvoya mũno ũtukũ na mũthenya nĩ kana tũtonye kwona mothyũ menyu, na kwĩanĩsya kĩla kĩtiele mũĩkĩĩonĩ wenyu?",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.10",
            "verseOrgIds": [
              "1TH.3.10"
            ]
          }
        }
      ]
    },
