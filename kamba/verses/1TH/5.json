              "1TH.5.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.16.18"
              },
              "items": [
                {
                  "text": "1 Ako 16.18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.5.17"
              },
              "items": [
                {
                  "text": "1 Tim 5.17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ nĩtũũmwĩsũva, ana‐a‐asa, mũmanye ala mathĩnĩaa wĩa katĩ wenyu, na me ĩũlũ wenyu nthĩnĩ wa Mwĩaĩi, na mamũtaaa inyw’ĩ; ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.12",
            "verseOrgIds": [
              "1TH.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1TH 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "na kũmataĩa mũno nthĩnĩ wa wendo kwondũ wa wĩa woo. Ĩthĩwai na mũuo inyw’ĩ kwa inyw’ĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.13",
            "verseOrgIds": [
              "1TH.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1TH 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TH.3.6"
              },
              "items": [
                {
                  "text": "2 Ath 3.6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TH.3.11"
              },
              "items": [
                {
                  "text": "11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TH.3.15"
              },
              "items": [
                {
                  "text": "15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na nĩtũũmũtaa, ana‐a‐asa, mataaei ala matekalaa nesa, mekĩaei vinya ala me na ngoo mbũthũ, tw’ĩĩkaai ala onzu, ũmĩanĩasyai na andũ onthe. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.14",
            "verseOrgIds": [
              "1TH.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1TH 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.20.22"
              },
              "items": [
                {
                  "text": "Nth 20.22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.12.17"
              },
              "items": [
                {
                  "text": "Alo 12.17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.3.9"
              },
              "items": [
                {
                  "text": "1 Vet 3.9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sisyai kana mũndũ o na wĩva ndakekũle kwa ũngĩ; ĩndĩ mavinda onthe atĩĩaai ũla ũseo, ene kwa ene, na kwa onthe. ",
