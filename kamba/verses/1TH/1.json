                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vaulo, na Silivano, na Timotheo, valũa ũũ witũ ũyĩvikĩe ĩkanisa ya Athesalonika yĩla yĩ nthĩnĩ wa Ngai Asa na Mwĩaĩi Yesũ Klĩsto: Mumo nĩwĩthĩwe nenyu na mũuo.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.1.1",
            "verseOrgIds": [
              "1TH.1.1"
            ]
          }
        }
      ]
    },
    {
