          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZR 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na onthe ala mamathyũlũlũkĩte mamekĩa moko moo vinya nĩ kũmanenga mĩio ya vetha, na thaavu, na isamũ, na nyamũ, na syĩndũ syĩ vata mũno, vamwe na syonthe ila syathembiwe na ngoo ya kwenda. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.6",
            "verseOrgIds": [
              "EZR.1.6"
            ]
          }
        },
