          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩvo ĩndĩ atongoi ma nyũmba sya aaĩthe ma Yuta na Mbenyamini, na athembi, na Alivai, mookĩlile, o asu onthe ala Ngai waamũkisye maveva moo mambate matũngĩĩe nyũmba ya Yeova ĩla yĩ Yelusaleme. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.5",
            "verseOrgIds": [
              "EZR.1.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
