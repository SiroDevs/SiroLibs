              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "O na mũsumbĩ Kulusi aumaalya mĩio ya nyũmba ya Yeova, ĩla Nevukatilesa waetie kuma Yelusaleme, na nĩwamĩkĩĩte nyũmbanĩ ya ngai syake; ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.7",
            "verseOrgIds": [
              "EZR.1.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
