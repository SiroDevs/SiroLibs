        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.18",
            "verseOrgIds": [
              "EZR.8.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
