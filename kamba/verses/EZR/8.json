            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ natavan’ya kũtĩĩa ũya ku, ũsĩnĩ wa Aaaa, nĩ kana tũmwĩnyivĩsye Ngai waitũ, tũmanthe kwake nzĩa ndũngalu ũndũ witũ ene, na ũndũ wa syana sitũ nini, na ũndũ wa syĩndũ sitũ syonthe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.21",
            "verseOrgIds": [
              "EZR.8.21"
            ]
          }
        },
