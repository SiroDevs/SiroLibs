            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.14",
            "verseOrgIds": [
              "EZR.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZR 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakwa namombanĩsya ũsĩnĩ ũla ũtheeete Aava; na twekala maeemanĩ maitũ kw’o mĩthenya ĩtatũ: na namasisya andũ, o na athembi, na ndyaaona vo ũmwe wa ana ma Livai. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.15",
            "verseOrgIds": [
              "EZR.8.15"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZR.7.7"
              },
              "items": [
                {
                  "text": "Esa 7.7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.15",
            "verseOrgIds": [
              "EZR.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZR 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩvo ĩndĩ natũmanie Elieseli, na Alieli, na Semaia, na Elinathani, na Yalivu, na Elinathani, na Nathani, na Nzekalia, na Mesulamu, andũ anene; o na Yoialivu, na Elinathani, ala maĩ amanyĩsya. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.16",
            "verseOrgIds": [
              "EZR.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZR 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na namatũma kwa mũnene Ito vandũ vetawa Kasivia; na namatavya ũla memũtavya Ito, na ana‐a‐ĩthe make Anethini, vandũ vau Kasivia, matũetee athũkũmi ma nyũmba ya Ngai waitũ. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.17",
            "verseOrgIds": [
              "EZR.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZR 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kwĩanana na kw’oko kũseo kwa Ngai waitũ ĩũlũ waitũ matũetee mũndũ wĩ ũmanyi wa ana ma Mali mwana wa Livai, mwana wa Isilaeli; na Selevia, e na ana make na ana‐a‐ĩthe make, ĩkũmi na nyanya; ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.18",
            "verseOrgIds": [
              "EZR.8.18"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
