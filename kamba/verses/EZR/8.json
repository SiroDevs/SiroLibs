          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "na namathimĩa vetha, na thaavu, na mĩio, o nthembo ũndũ wa nyũmba ya Ngai waitũ, ĩla mũsumbĩ, na atai make, na anene make me mbee ũsumbĩnĩ, na Isilaeli onthe ala maĩ vo, maumisye: ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.25",
            "verseOrgIds": [
              "EZR.8.25"
            ]
          }
        },
