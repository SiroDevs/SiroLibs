            "sid": "EZR 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Asavia, na vamwe nake Yesaia wa ana ma Melali, e na ana‐a‐ĩthe make na ana moo, mĩongo ĩlĩ; ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.19",
            "verseOrgIds": [
              "EZR.8.19"
            ]
          }
        },
