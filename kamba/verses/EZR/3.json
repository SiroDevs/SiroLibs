            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mailĩĩla kĩthembeo ĩtinanĩ yakyo; nũndũ maĩ na w’ĩa nũndũ wa andũ ma nthĩ isu: na mamũthembea Yeova nthembo sya kũvĩvw’a ĩũlũ wakyo, o nthembo sya kũvĩvw’a kĩoko na wĩoo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.3",
            "verseOrgIds": [
              "EZR.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
