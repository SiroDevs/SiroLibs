              },
              "items": [
                {
                  "text": "1 Ako 4.21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ nĩnatwie ũu nyie mwene, kana ndikoke kwenyu ĩngĩ nĩ na woo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.1",
            "verseOrgIds": [
              "2CO.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CO 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ ethĩwa nyie ngamwĩw’ĩthya woo, nũũ ũla ũkambĩw’ĩthya mũyo ate o ũla wĩw’ĩthĩtw’e woo nĩ nyie? ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.2",
            "verseOrgIds": [
              "2CO.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CO 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na nĩnaandĩkie ũndũ ũũ naw’o, nĩ kana, nooka, ndikew’ĩthw’e woo nĩ ala naĩle nĩ ũmatanĩa; ngĩmũĩkĩĩa inyw’onthe, kana ũtanu wakwa nĩ ũtanu wenyu inyw’onthe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.3",
            "verseOrgIds": [
              "2CO.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CO 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.20.31"
              },
              "items": [
                {
                  "text": "Meko 20.31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ namũandĩkĩe na methoi maingĩ nĩ na thĩna mwingĩ na kũũũya kwa ngoo; ti kana inyw’ĩ mwĩw’ĩthw’e woo, ĩndĩ nĩ kana mũmanye wendo ũla nĩ naw’o, ũndũ wingĩvĩte kwenyu.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.4",
            "verseOrgIds": [
              "2CO.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
