              "2CO.11.16"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.12.6"
              },
              "items": [
                {
                  "text": "2 Ako 12.6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩmũtavya ĩngĩ, Mũndũ ndakasye nĩ mũtumanu; ĩndĩ ethĩwa no ũu, mbosai ta mũtumanu, nĩ kana nyie nakwa nĩkathĩĩe vanini. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.16",
            "verseOrgIds": [
              "2CO.11.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CO 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ũu ngũneena, ndiũneena ta wumĩte kwa Mwĩaĩi, ĩndĩ ta kwa ũtumanu, wĩkwatyonĩ ũũ wa kwĩkathĩĩa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.17",
            "verseOrgIds": [
              "2CO.11.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CO 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩkwĩthĩwa aingĩ mekathĩĩaa maũndũni ma mwĩĩ, nakwa ngeekathĩĩa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.18",
            "verseOrgIds": [
              "2CO.11.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CO 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ nĩmũmĩĩasya ala atumanu na ũtanu, nĩkwĩthĩwa mwĩ oĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.19",
            "verseOrgIds": [
              "2CO.11.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CO 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ nĩmũmĩĩasya mũndũ, akĩmũlikya ũkombonĩ, aimũya, aimũtava, akĩnenevya, aimũkũna ũthyũ. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.20",
            "verseOrgIds": [
              "2CO.11.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CO 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩneena na kwĩvũthĩĩsya, ta twaĩ onzu ithyĩ. Ĩndĩ ũndũnĩ o na wĩva ve ngũmbaũ (nĩneena na ũtumanu), nyie nakwa nĩ ngũmbaũ. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.21",
            "verseOrgIds": [
              "2CO.11.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CO 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.3.5"
              },
              "items": [
                {
                  "text": "Avi 3.5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩ Ayuti mo? O nakwa. Nĩ Aisilaeli mo? O nakwa. Nĩ ũsyao wa Avalaamu mo? O nakwa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.22",
            "verseOrgIds": [
              "2CO.11.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CO 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.15.10"
              },
              "items": [
                {
                  "text": "1 Ako 15.10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩ athũkũmi ma Klĩsto? (Nĩneena ta ũla wĩ na ndũũka) nyie nĩ mbee; mathĩnanĩ ma wĩa nyie nĩ mbee mũno, naĩ kolokolonĩ kaingĩ muno, kũkũnwa nĩ kaingĩ mbee, na kĩkw’ũnĩ nĩ kaingĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.23",
            "verseOrgIds": [
              "2CO.11.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CO 11:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.25.3"
              },
              "items": [
                {
                  "text": "Kũt 25.3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa Ayuti nĩnakũniwe mavinda atano ivoko mĩongo ĩna kũoleka kĩmwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.24",
            "verseOrgIds": [
              "2CO.11.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CO 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.16.22"
              },
              "items": [
                {
                  "text": "Meko 16.22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.14.19"
              },
              "items": [
                {
                  "text": "14.19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩkũnangĩtwe na ndata mavinda atatũ, nĩkimangĩtwe na mavia ĩvinda yĩmwe, ngalawa syaanangĩkie mavinda atatũ nĩ kyalonĩ, naĩ ũkanganĩ ũtukũ ũmwe na mũthenya ũmwe; ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.25",
            "verseOrgIds": [
              "2CO.11.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CO 11:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "naĩ syalonĩ kaingĩ, mĩisyonĩ ya mbũsĩ, mĩisyo ya ing’ei, mĩisyo ya andũ ma mbaitũ, mĩisyo ya Andũ‐ma‐mbaĩ‐ingĩ, mĩisyo ya ndũanĩ, mĩisyo ya weũnĩ, mĩisyo ya ũkanganĩ, mĩisyo ya ana‐a‐asa ma ũvũngũ; ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.26",
            "verseOrgIds": [
              "2CO.11.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CO 11:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.6.5"
              },
              "items": [
                {
                  "text": "2 Ako 6.5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "thĩnanĩ wa mawĩa na woonĩ, kũsyaĩĩsya nĩ kaingĩ, kwĩw’a nzaa na waũni, kũtĩĩa kũya nĩ kaingĩ, mbevonĩ na kũtwĩkĩwa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.27",
            "verseOrgIds": [
              "2CO.11.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2CO 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.20.18+ACT.20.19+ACT.20.20+ACT.20.21"
              },
              "items": [
                {
                  "text": "Meko 20.18–21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na eka maũndũ ala ndanaweta, ve ũla ũmbivinyaa matukũ onthe, kũũũyĩa makanisa onthe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.28",
            "verseOrgIds": [
              "2CO.11.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2CO 11:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.9.22"
              },
              "items": [
                {
                  "text": "1 Ako 9.22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũũ ũla mwonzu, nakwa ndi mwonzũ? Nũũ ũla ũnũũlulutĩkw’a, na ndikũvya nĩ woo? ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.29",
            "verseOrgIds": [
              "2CO.11.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2CO 11:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.12.6"
              },
              "items": [
                {
                  "text": "2 Ako 12.6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ethĩwa no mũvaka nĩkathĩĩe, ngeekathĩĩa maũndũnĩ asu ma wonzu wakwa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.30",
            "verseOrgIds": [
              "2CO.11.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2CO 11:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.1.23"
              },
              "items": [
                {
                  "text": "2 Ako 1.23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngai, Ĩthe wa Mwĩaĩi waitũ Yesũ, ũla ũtaĩawa kũvika tene na tene nĩwĩsĩ kana ndiũneena ũvũngũ. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.31",
            "verseOrgIds": [
              "2CO.11.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2CO 11:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndũanĩ ya Ndamasiku, ngavana ũla waĩ ĩtheo wa mũsumbĩ Aleta nĩwasũvĩie ndũa ĩsu ya Andamasiku, nĩ kana angwate: ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.32",
            "verseOrgIds": [
              "2CO.11.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2CO 11:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.9.24"
              },
              "items": [
                {
                  "text": "Meko 9.24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.9.25"
              },
              "items": [
                {
                  "text": "25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "na natonyelw’e mbũthinĩ natheelelw’a ũvainĩ nĩ kĩkavũnĩ nthĩnĩ, na natbonoka mokonĩ make.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.33",
            "verseOrgIds": [
              "2CO.11.33"
            ]
          }
        }
      ]
    }
  ],
