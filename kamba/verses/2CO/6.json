                {
                  "text": "Aev 5.11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũtikovanĩw’e ĩsoki yĩmwe na ala mate etĩkĩli: nũndũ ũlũngalu na ũthũku wĩ mũamba mwaũ? Kana kyeni kĩ na mũamba mwaũ na kĩvindu? ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.14",
            "verseOrgIds": [
              "2CO.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CO 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Klĩsto e na mũamba mwaũ na Veliali? Na ũla wĩtĩkĩlĩte e na kĩanda kyaũ vamwe na ũla ũtetĩkĩlĩte? ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.15",
            "verseOrgIds": [
              "2CO.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
