            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.4.4"
              },
              "items": [
                {
                  "text": "Avi 4.4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.15.33"
              },
              "items": [
                {
                  "text": "Alo 15.33",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kũminũkĩlya, ana‐a‐asa, ĩkalai na ũvoo. Ianĩai; kiakiw’ai; ĩthĩwai na kĩlilikano kĩmwe; ĩkalai mũuonĩ: na Ngai wa wendo na mũuo akeethĩwa nenyu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.13.11",
            "verseOrgIds": [
              "2CO.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CO 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.16.20"
              },
              "items": [
                {
                  "text": "1 Ako 16.20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kethan’yai na ũmumunyano mũtheu.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.13.12",
            "verseOrgIds": [
              "2CO.13.12"
            ]
          }
        }
      ]
    },
