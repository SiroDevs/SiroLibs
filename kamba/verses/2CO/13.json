                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.5.19"
              },
              "items": [
                {
                  "text": "1 Tim 5.19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yũka yĩĩ niũka kwenyu nĩ ya katatũ. Ũndũ wa makanyw’a ma ngũsĩ ili kana itatũ kĩla ũndũ ũkalũlũmĩlw’a. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.13.1",
            "verseOrgIds": [
              "2CO.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CO 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambie kũneena na nĩngũneena ĩngĩ nde vo, o tondũ namũtavisye yĩla naĩ nenyu ĩvinda ya kelĩ, no ta ũu yu, kana ala meekie naĩ na vu tene na ala angĩ onthe, ethĩwa nĩngũka ĩngĩ, ndiĩw’ĩa tei; ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.13.2",
            "verseOrgIds": [
              "2CO.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CO 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "nũndũ nĩmũkũmantha ũndũ wa kũmũmanyĩthya kana Klĩsto nĩwe ũneenaa nthĩnĩ wakwa; ũla ũte mwonzu kwenyu, ĩndĩ e na vinya nthĩnĩ wenyu: ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.13.3",
            "verseOrgIds": [
              "2CO.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CO 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.2.7"
              },
              "items": [
                {
                  "text": "Avi 2.7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.2.8"
              },
              "items": [
                {
                  "text": "8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "nũndũ ambiwe kwondũ wa wonzu, ĩndĩ e thayũ kwondũ wa vinya wa Ngai. Nũndũ ithyĩ naitũ twĩ onzu nthĩnĩ wake, ĩndĩ tũkeethĩwa thayũ vamwe nake kwondũ wa vinya Ngai ũla welekele kwenyu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.13.4",
            "verseOrgIds": [
              "2CO.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CO 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.11.28"
              },
              "items": [
                {
                  "text": "1 Ako 11.28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩthimei inyw’ĩ ene, kana mwĩ ũla mũĩkĩĩonĩ; iosyei inyw’ĩ ene. Kana mũtyĩsĩ ũndũ wenyu, atĩ Yesũ Klĩsto e nthĩnĩ wenyu? Ate ũu mwĩthĩwa mũleetwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.13.5",
            "verseOrgIds": [
              "2CO.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CO 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ nĩngwĩkwatya kana mũkamanya kana ithyĩ tũtileetwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.13.6",
            "verseOrgIds": [
              "2CO.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CO 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na yu twĩmũvoya Ngai kana mũikeke naĩ; ti kana ithyĩ twoneke twĩtĩkĩlwe, ĩndĩ nĩ kana inyw’ĩ mwĩke ũla waĩle, o na kau nĩ ta tũleetwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.13.7",
            "verseOrgIds": [
              "2CO.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CO 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.13.6"
              },
              "items": [
                {
                  "text": "1 Ako 13.6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ tũtitonya kwĩka ũndũ o na wĩva wa ũsiĩĩa ũla w’o, ĩndĩ no kwa ngalĩ ya ũla w’o. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.13.8",
            "verseOrgIds": [
              "2CO.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CO 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ nĩtũtanaa, yĩla ithyĩ twĩ onzu, na inyw’ĩ mwĩ na vinya: na ĩngĩ nĩtũvoyeaa ũndũ ũũ naw’o, nĩ kana mwĩanĩe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.13.9",
            "verseOrgIds": [
              "2CO.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CO 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.2.3"
              },
              "items": [
                {
                  "text": "2 Ako 2.3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.10.8"
              },
              "items": [
                {
                  "text": "10.8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.10.11"
              },
              "items": [
                {
                  "text": "11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwondũ wa ũu nĩandĩka maũndũ aa nde vo, nĩ kana yĩla nĩĩthĩwa vo ndikeke ũndũ na ũkandĩa, kwĩanana na ũkũmũ ũla Mwĩaĩi wanengie kwondũ wa kwaka, na ti kũomboa.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.13.10",
            "verseOrgIds": [
              "2CO.13.10"
            ]
          }
        }
      ]
    },
    {
