                "loc": "DEU.27.26"
              },
              "items": [
                {
                  "text": "Kũt 27.26",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.1.17"
              },
              "items": [
                {
                  "text": "Alo 1.17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
