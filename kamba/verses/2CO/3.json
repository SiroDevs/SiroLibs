                  "text": "1 Ako 9.2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Valũa witũ nĩ inyw’ĩ, ũandĩkĩtwe ngoonĩ sitũ, ũla wĩsĩkĩwe na ũsomawa nĩ andũ onthe; ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.2",
            "verseOrgIds": [
              "2CO.3.2"
            ]
          }
        },
