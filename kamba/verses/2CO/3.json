                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ũla nake watwĩanĩsye twĩthĩwe athũkũmi ma ũtianĩo mweũ; ti wa ũandĩko, ĩndĩ nĩ wa veva; nũndũ ũandĩko nĩwũaa, ĩndĩ veva ũetae thayũ.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.6",
            "verseOrgIds": [
              "2CO.3.6"
            ]
          }
        }
