                  "text": "Mwa 2.14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.10.4",
            "verseOrgIds": [
              "DAN.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DAN 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "nookĩlya metho makwa, noona, na, sisya, mũndũ ũmwe ekĩĩte ngũa ya katane, na kĩnyunyu kyake kĩvotoetwe thaavu mũtheu wa Uvasi: ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.10.5",
            "verseOrgIds": [
              "DAN.10.5"
            ]
          }
        },
        {
