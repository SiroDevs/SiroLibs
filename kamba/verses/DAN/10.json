              "items": [
                {
                  "text": "Nda 9.23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.10.11",
            "verseOrgIds": [
              "DAN.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DAN 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩvo ĩndĩ wambĩie, Ndanieli, ndũkakĩe; nũndũ kuma mũthenya wa mbee ũla waiie ngoo yaku kũmanya, na kwĩnyivya vala ve Ngai waku, ndeto syaku nĩsyeew’ĩkie: nakwa nooka kwondũ wa ndeto syaku. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.10.12",
            "verseOrgIds": [
              "DAN.10.12"
            ]
          }
        },
        {
