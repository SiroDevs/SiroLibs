              "items": [
                {
                  "text": "Nda 7.28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.10.8",
            "verseOrgIds": [
              "DAN.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DAN 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ neew’a wasya wa ndeto syake; nakwa yĩla newie wasya wa ndeto syake, nĩvo ĩndĩ nakwatiwe nĩ too mũnene nĩvalũkĩte na ũthyũ wakwa, ũthyũ wakwa welekele nthĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.10.9",
            "verseOrgIds": [
              "DAN.10.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
