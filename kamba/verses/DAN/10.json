            "verseId": "DAN.10.5",
            "verseOrgIds": [
              "DAN.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DAN 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "mwĩĩ wake naw’o watilyĩ ta nzumalati ntheu, na ũthyũ wake ta kwoneka kwa ũtisi, na metho make ta mũĩ syakanĩte mwaki, na moko make na maũũ make ta ũthuku mũkute, na wasya wa ndeto syake ta wasya wa wingĩ wa andũ. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.10.6",
            "verseOrgIds": [
              "DAN.10.6"
            ]
          }
        },
