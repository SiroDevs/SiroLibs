            }
          ]
        },
        {
          "text": "Nĩvo ĩndĩ wangiitie ĩngĩ ũmwe ũilyĩ mũvw’ano wa mũndũ, nake ambĩkĩa vinya. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.10.18",
