              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake aneena nakwa ndeto ta isu, neelekelya ũthyũ wakwa nthĩ, ndaneenekya. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.10.15",
