            "sid": "DAN 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mũthenya wa mĩongo ĩlĩ na ĩna wa mwei wa mbee, yĩla naĩ ũtee wa ũsĩ mũnene, nĩw’o Itekeli, ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.10.4",
            "verseOrgIds": [
              "DAN.10.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
