        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DAN 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Matukũ asu nyie, Ndanieli, neethĩiwe na kĩmako syumwa itatũ nima. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.10.2",
            "verseOrgIds": [
              "DAN.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DAN 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndyaaya lĩu mũseo, o na nyama o na mbinyu ityaalika kanyw’anĩ wakwa, o na ndyaaĩvaka mauta nongi, mũvaka syumwa itatũ nima syeanĩa. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.10.3",
            "verseOrgIds": [
              "DAN.10.3"
            ]
          }
        },
        {
