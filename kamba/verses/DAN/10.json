              "items": [
                {
                  "text": "Ũvu 1.17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.10.12",
            "verseOrgIds": [
              "DAN.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DAN 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ mũnene wĩ mbee ũsumbĩnĩ wa ũsumbĩ wa Velisia anziĩĩa mĩthenya mĩongo ĩlĩ na ũmwe; ĩndĩ, sisya, Mikaeli, ũmwe wa anene, ooka kũndethya: nakwa nekala vau na asumbĩ ma Velisia. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.10.13",
            "verseOrgIds": [
              "DAN.10.13"
            ]
          }
        },
