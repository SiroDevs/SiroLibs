            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.7",
            "verseOrgIds": [
              "DAN.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
