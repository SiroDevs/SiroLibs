            "sid": "DAN 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ andũ oĩ onthe ma mũsumbĩ mooka; ĩndĩ maiaatonya kũsoma ũandĩko, o na kũmanyĩthya mũsumbĩ ũalyũlo waw’o. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.8",
            "verseOrgIds": [
              "DAN.5.8"
            ]
          }
        },
