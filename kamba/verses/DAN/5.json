          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "TEKELI; nũthimĩtwe kĩthiminĩ, na nĩwonekete kwĩthĩwa nũtielye. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.27",
