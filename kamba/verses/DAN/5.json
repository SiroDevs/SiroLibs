        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.8",
            "verseOrgIds": [
              "DAN.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DAN 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩvo ĩndĩ mũsumbĩ Mbelisasa waũũyie mũno, na ũthyũ wake waalyũka, na eaĩi ma kwake masũanĩwa.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.9",
            "verseOrgIds": [
              "DAN.5.9"
            ]
          }
        }
