              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naku mwanae, we Mbelisasa, ndwaanyivya ngoo yaku, o na wamanya maũndũ asu onthe, ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.22",
