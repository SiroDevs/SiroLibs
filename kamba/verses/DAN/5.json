              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ũalyũlo waw’o nĩ ũũ: MENE; Ngai nũtalĩte ũsumbĩ waku, na kũwũmina. ",
          "type": "text",
          "attrs": {
