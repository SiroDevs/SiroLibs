        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.10",
            "verseOrgIds": [
              "DAN.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
