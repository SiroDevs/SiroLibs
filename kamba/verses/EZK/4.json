              "EZK.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩngĩ, yĩla ũkethĩwa ũminĩte ĩsu, ũkakoma na ĩvava yaku ya ngalĩ ya kw’oko kwa aũme, na ũkakua ũthũku wa nyũmba ya Yuta: mĩthenya mĩongo ĩna, kĩla mũthenya vandũ va mwaka, nĩngũtw’ĩĩĩte. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.4.6",
            "verseOrgIds": [
              "EZK.4.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
