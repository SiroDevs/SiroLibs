                {
                  "text": "Osea 9.3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.4.13",
            "verseOrgIds": [
              "EZK.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩvo ĩndĩ naisye, A! Mwĩaĩi Yeova! Sisya, thayũ wakwa ndwaavukw’a; nũndũ kuma wana wakwa o na kũvika yu ndyaaya kĩla kya kũkw’a, kana kĩlĩku; o na kũtyaalika nyama mbuku kanyw’anĩ wakwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.4.14",
            "verseOrgIds": [
              "EZK.4.14"
            ]
          }
        },
        {
