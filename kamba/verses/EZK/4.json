                "loc": "EZK.23.11"
              },
              "items": [
                {
                  "text": "Esek 23.11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.23.12"
