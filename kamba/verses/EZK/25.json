          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwondũ wa ũu, sisya, nĩnĩkũtambũũkĩsye kw’oko kwakwa, na ngakũnengane wĩthĩwe mũtavo kwa i mbaĩ; na ngakũveta wume ngonĩ sya andũ, na ngatuma waa wume i nthĩ: ngakwananga; na ũkamanya ninyie Yeova.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.7",
            "verseOrgIds": [
              "EZK.25.7"
            ]
          }
        }
