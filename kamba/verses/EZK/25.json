            "number": "2",
            "style": "v",
            "sid": "EZK 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana wa mũndũ, elekelya ana ma Amimoni ũthyũ waku, noimathanĩa: ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.2",
            "verseOrgIds": [
              "EZK.25.2"
            ]
          }
        },
