          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ ũũ nĩw’o Mwĩaĩi Yeova ũnũkwasya: Nĩkwĩthĩwa nũkũnanganĩtye mbĩ syaku, na nũtuangĩĩte maũũ nthĩ, na nũtanĩte na kĩvũthya kyonthe kya ngoo yaku ĩũlũ wa nthĩ ya Isilaeli; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.6",
            "verseOrgIds": [
              "EZK.25.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
