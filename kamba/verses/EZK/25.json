            "sid": "EZK 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "kũvika ana ma wumĩlonĩ wa syũa, mũkite na ana ma Amimoni; na ngamanengane methĩwe menyu, nĩ kana ana ma Amimoni matikaalilikanwe katĩ wa i mbaĩ: ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.10",
            "verseOrgIds": [
              "EZK.25.10"
            ]
          }
        },
