        {
          "text": "kwondũ wa ũu, sisya, ngavingũa ngalĩko ya Moavi kuma ndũanĩ, kuma ndũanĩ syayo ila syĩ mĩvakanĩ yayo, ndaĩa ya ĩ nthĩ, Mbethi‐yesimothi, na Mbaali‐meoni, na Kiliathaimu, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.9",
            "verseOrgIds": [
              "EZK.25.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
