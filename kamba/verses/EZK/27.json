          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "na makakwĩw’ĩthya wasya woo, na makaĩa me na woo, na makekya kĩtoo mĩtwenĩ yoo; makeeyalalya mũunĩ: ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.30",
