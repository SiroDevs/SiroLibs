        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.2",
            "verseOrgIds": [
              "EZK.27.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 27:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "noitavya Tile, We ũla ũtwĩe ũlikĩlonĩ wa ũkanga, wĩ mũthoosya kwa ngoosya andũ kwondũ wa ithama nyingĩ, ũũ nĩw’o Mwĩaĩi Yeova ũnũkwasya: We, Tile, ũneenete, Nyie nĩ mwĩanĩu kwanakavanĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.3",
            "verseOrgIds": [
              "EZK.27.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
