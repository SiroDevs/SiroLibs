              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ala atwai maku makũetie manzĩnĩ maingĩ: kĩseve kyumĩte wumĩlonĩ wa syũa nĩkĩkũtũĩlĩe katĩ wa maũkanga. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.26",
            "verseOrgIds": [
              "EZK.27.26"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
