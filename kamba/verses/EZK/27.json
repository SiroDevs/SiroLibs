              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.3",
            "verseOrgIds": [
              "EZK.27.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 27:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mĩvaka yaku yĩ nthĩnĩ wa maũkanga; aki maku nĩmeanĩĩtye kwanakava kwaku. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.4",
            "verseOrgIds": [
              "EZK.27.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 27:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩmaseũvĩtye mbwaũ syaku syonthe sya ngalawa sya mĩtĩ ya mĩsonovali kuma Senili; nĩmosete mũkũũ ku Levanoni makũseũvĩsye mũlingoti. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.5",
            "verseOrgIds": [
              "EZK.27.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.3.9"
              },
              "items": [
                {
                  "text": "Kũt 3.9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.5",
            "verseOrgIds": [
              "EZK.27.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 27:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩmaseũvĩtye mĩtĩ yaku ya ũkũtwaa ya mĩtĩ ya myaloni ya ku Mbasani; nĩmaseũvĩtye ivĩla syaku sya mĩtĩ ya mĩvuena ithũĩĩwe na tũlungu twa maeo ma nzou, kuma ithamanĩ sya Kitimu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.6",
            "verseOrgIds": [
              "EZK.27.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.2.13"
              },
              "items": [
                {
                  "text": "Isa 2.13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.6",
            "verseOrgIds": [
              "EZK.27.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 27:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngũa yaku ĩla yĩkĩawa mũtĩnĩ ĩkwate kĩseve yaĩ ya katane nzeo yatumĩĩwe wanake ku Misili, nĩ kana yĩthĩwe kwaku kĩvevelo; kyandalua kyaku kyaĩ kya vuluu na kya langi wailyĩ mũtune kuma ithamanĩ sya Elisaa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.7",
            "verseOrgIds": [
              "EZK.27.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 27:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ala matwĩe Sitoni na Alivati maĩ atwai maku: andũ maku oĩ, we Tile, maĩ nthĩnĩ waku, nĩmo maĩ atongoi maku. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.8",
            "verseOrgIds": [
              "EZK.27.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 27:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atumĩa ma Ngevali o na andũ oĩ ma vo nĩmo malindaa mbatũku syaku: ngalawa syonthe sya ũkanganĩ vamwe na andũ ala maendaa nasyo maĩ nthĩnĩ waku matandĩthye syĩndũnĩ syaku sya ũthoosya. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.9",
            "verseOrgIds": [
              "EZK.27.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 27:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Andũ ma Velisia na Luti na Vutu maĩ itanĩ syaku, andũ maku ma kaũ: nĩmanĩkie ngao na ngovia nthĩnĩ waku; nĩmoonanisye ndaĩa yaku. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.10",
            "verseOrgIds": [
              "EZK.27.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
