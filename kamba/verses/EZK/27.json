          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndetani yaĩ mũtandĩthya kwaku wa ngũa nzeo sya kwilĩĩla ĩũlũ wa mbalasi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.20",
