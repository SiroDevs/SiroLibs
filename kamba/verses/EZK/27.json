          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alavia, na anene onthe me mbee ũsumbĩnĩ ma Ketali, mathooasya kw’okonĩ kwaku; tũtena twa malondũ na ndũũme, na mbũi, nĩsyo mathooasya kwaku. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.21",
            "verseOrgIds": [
              "EZK.27.21"
            ]
          }
        },
