        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.10",
            "verseOrgIds": [
              "EZK.27.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 27:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Andũ ma Alivati vamwe na ita syaku maĩ maũvainĩ maku ngalĩ syonthe, na andũ me na ũkũmbaũ maĩ myakonĩ yaku mĩtũlu ya mĩnyoolo; nĩmanĩkie ngao syoo maũvainĩ maku ngalĩ syonthe; nĩmeanĩĩtye kwanakava kwaku.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.11",
            "verseOrgIds": [
              "EZK.27.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
