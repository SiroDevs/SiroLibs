              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.26",
            "verseOrgIds": [
              "EZK.27.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 27:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mothwii maku, na mĩio yaku, syĩndũ syaku sya ũthoosya, na andũ maku ma ngalawa syaku, na atongoi maku, na maku ala malindaa mbatũku, na akũan’ya ma mĩio yaku, na andũ maku onthe ma kaũ, ala me nthĩnĩ waku, vamwe na nguthu yaku yonthe ĩla yĩ katĩ waku, makavalũka katĩ wa maũkanga mũthenya wa wanangĩko waku. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.27",
            "verseOrgIds": [
              "EZK.27.27"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
