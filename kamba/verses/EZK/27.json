              "EZK.27.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EZK 27:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "na makeeyenza ũvaa kwondũ waku, na kwĩvotoa makunĩa, na makakũĩĩa me na woo ngoonĩ makĩmeta na woo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.31",
            "verseOrgIds": [
              "EZK.27.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EZK 27:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na makĩmeta makambĩlĩlya kĩĩo kwondũ waku, na makakũĩĩa, makyasya, Nũũ ũilyĩ ta Tile, ta ũla ũvindĩthĩtw’e katĩ wa ũkanga? ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.32",
            "verseOrgIds": [
              "EZK.27.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EZK 27:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yĩla syĩndũ syaku sya ũthoosya syaumaw’a maũkakanganĩ, wausũasya ngo mbingĩ sya andũ; wathuasya asumbĩ ma nthĩ na wingĩ wa mothwii maku na wa syĩndũ syaku sya ũthoosya. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.33",
            "verseOrgIds": [
              "EZK.27.33"
            ]
          }
        },
