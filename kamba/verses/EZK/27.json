        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 27:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndamasiku yathoosya kwaku kwondũ wa wingĩ wa mawĩa maku ma moko, nũndũ wa wingĩ wa mĩthemba yonthe ya ũthwii, maetae mbinyu kuma Elivoni, na w’ĩa mweũ wa malondu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.18",
            "verseOrgIds": [
              "EZK.27.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
