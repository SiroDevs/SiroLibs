          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ngili itano ila itialĩte sya ũthanthau, mbee wa ila ngili mĩongo ĩlĩ na itano, ikeethĩwa sya kũtethya onthe, kwondũ wa ndũa, kwondũ wa kũtũaa na kwondũ wa isesi; na ndũa ĩkeethĩwa vu katĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.15",
            "verseOrgIds": [
              "EZK.48.15"
            ]
          }
        },
