          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kĩkeethĩwa kwoo nthembo kuma nthembonĩ ya nthĩ, kĩndũ kĩtheu ki, mũvakanĩ wa Alivai.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.12",
