                "loc": "EZK.47.15+EZK.47.16+EZK.47.17+EZK.47.18+EZK.47.19+EZK.47.20"
              },
              "items": [
                {
                  "text": "Esek 47.15–20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.1",
            "verseOrgIds": [
              "EZK.48.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 48:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩngĩ mũvakanĩ wa Ndani, kuma ngalĩ ya wumĩlonĩ wa syũa kũvika ngalĩ ya ũthũĩlonĩ wa syũa, Aseli, kĩanda kĩmwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.2",
            "verseOrgIds": [
              "EZK.48.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 48:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mũvakanĩ wa Aseli, kuma ngalĩ ya wumĩlonĩ wa syũa o kũvika ngalĩ ya ũthũĩlonĩ wa syũa, Navitali, kĩanda kĩmwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.3",
            "verseOrgIds": [
              "EZK.48.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 48:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mũvakanĩ wa Navitali, kuma ngalĩ ya wumĩlonĩ wa syũa kũvika ngalĩ ya ũthũĩlonĩ wa syũa, Manase, kĩanda kĩmwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.4",
            "verseOrgIds": [
              "EZK.48.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
