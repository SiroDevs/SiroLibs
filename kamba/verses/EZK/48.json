          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩngĩ mũvakanĩ wa Simeoni, kuma ngalĩ ya wumĩlonĩ wa syũa kũvika ngalĩ ya ũthũĩlonĩ wa syũa, Isakali, kĩanda kĩmwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.25",
            "verseOrgIds": [
              "EZK.48.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
