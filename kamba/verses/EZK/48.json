          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩngĩ mũvakanĩ wa Mbenyamini, kuma ngalĩ ya wumĩlonĩ wa syũa kũvika ngalĩ ya ũthũĩlonĩ wa syũa, Simeoni, kĩanda kĩmwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.24",
            "verseOrgIds": [
              "EZK.48.24"
            ]
          }
        },
        {
