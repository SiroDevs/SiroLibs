          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩngĩ mũvakanĩ wa Isakali, kuma ngalĩ ya wumĩlonĩ wa syũa kũvika ngalĩ ya ũthũĩlonĩ wa syũa, Nzevuluni, kĩanda kĩmwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.26",
            "verseOrgIds": [
              "EZK.48.26"
            ]
          }
        },
        {
