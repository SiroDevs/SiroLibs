          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mũvakanĩ wa Manase, kuma ngalĩ ya wumĩlonĩ wa syũa kũvika ngalĩ ya ũthũĩlonĩ wa syũa, Evalaimu, kĩanda kĩmwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.5",
            "verseOrgIds": [
              "EZK.48.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 48:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mũvakanĩ wa Evalaimu, kuma ngalĩ ya wumĩlonĩ wa syũa kũvika ngalĩ ya ũthũĩlonĩ wa syũa, Leuveni, kĩanda kĩmwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.6",
            "verseOrgIds": [
              "EZK.48.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 48:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩngĩ mũvakanĩ wa Leuveni, kuma ngalĩ ya wumĩlonĩ wa syũa kũvika ngalĩ ya ũthũĩlonĩ wa syũa, Yuta, kĩanda kĩmwe.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.7",
