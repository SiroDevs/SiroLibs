        },
        {
          "text": "Na aa nĩmo mawumaalĩlo ma ndũa: Ngalĩ ya ĩũlũ mĩangi ngili inya na maana atano kwa kũthima; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.30",
            "verseOrgIds": [
