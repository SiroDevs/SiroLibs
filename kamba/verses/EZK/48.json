          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.10",
            "verseOrgIds": [
              "EZK.48.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 48:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kĩkeethĩwa kya athembi ala mavathĩtwe methĩwe atheu ma ana ma Nzatoki, ala masũvĩaa wĩaĩo wakwa, ala mataandia yĩla ana ma Isilaeli mandiĩte, o tondũ Alivai mandiie. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.11",
            "verseOrgIds": [
              "EZK.48.11"
            ]
          }
        },
        {
