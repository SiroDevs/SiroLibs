            "number": "8",
            "style": "v",
            "sid": "EZK 26:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akooaa na ũvyũ eĩtu maku me kĩsesinĩ; na akakwakĩĩa ngome, na kũkũmbĩĩa mbumbu, na ũkũkĩlĩlya kakalo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.8",
            "verseOrgIds": [
              "EZK.26.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.21.22"
              },
              "items": [
                {
                  "text": "Esek 21.22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.8",
            "verseOrgIds": [
              "EZK.26.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 26:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na akaiĩa maũvai maku mĩio yake ya kũmavũthũa, na akaomboa myako yaku mĩtũlu ya mĩnyoolo na mathoka make. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.9",
            "verseOrgIds": [
              "EZK.26.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 26:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ wa wingĩ wa mbalasi syake kĩtoo kyasyo kĩkakũvw’ĩka: maũvai maku makathingithanga ũndũ wa kĩlonzo kya ala matũlĩte mbalasi, na kya makasya ma mĩio, na makasya ma kaũ, yĩla wĩlika mbingĩlonĩ syaku, o tondũ andũ malikaa ndũanĩ ĩla yavũthũiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.10",
            "verseOrgIds": [
              "EZK.26.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akakinyanga nzĩa syaku syonthe nene na mavũngũ ma mbalasi syake; akooaa andũ maku na ũvyũ; na itũĩ sya vinya waku ikavalũka nthĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.11",
            "verseOrgIds": [
              "EZK.26.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 26:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na makatava ũthwii waku, na syĩndũ syaku sya kũthoosya ikeethĩwa mũtavo; na makaomboa maũvai maku, na kwananga nyũmba syaku sya kwendeesya; na makeekĩa mavia maku na mĩtĩ yaku na kĩtoo kyaku manzĩnĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.12",
            "verseOrgIds": [
              "EZK.26.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
