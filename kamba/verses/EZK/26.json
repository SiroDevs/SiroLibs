          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngavindĩthya kĩlonzo kya mbathi syaku; na wasya wa mbeve syaku ndũkew’ĩka ĩngĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.13",
            "verseOrgIds": [
