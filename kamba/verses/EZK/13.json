              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.16",
            "verseOrgIds": [
              "EZK.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naku, mwana wa mũndũ, lutĩla eĩtu ma andũ maku ũthyũ waku, asu ala mathanaa kuma ngoonĩ syoo ene; noimathanĩa, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.17",
            "verseOrgIds": [
              "EZK.13.17"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.13.2"
              },
              "items": [
                {
                  "text": "Esek 13.2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.17",
            "verseOrgIds": [
              "EZK.13.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "ũkyasya, Ũũ nĩw’o Mwĩaĩi Yeova ũnũkwasya: Woo nĩ wa aka ala matumĩaa mĩto ikokoa syonthe, na kũtuma itambaa sya mĩtwe ya andũ ma kĩla kĩũngamo matee mathayũ ma andũ! Mũkatea mathayũ ma andũ makwa, na kũtangĩĩa andũ mekale thayũ kwondũ wenyu? ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.18",
            "verseOrgIds": [
              "EZK.13.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩmũmbukĩtye katĩ wa andũ makwa kwondũ wa mbĩ syusĩe mbaale na kwondũ wa ilungu sya imũtũ, mũae andũ mataĩle kũkw’a, na kũeka me thayũ ala mataĩle kwĩkala thayũ, ũndũ wa kũmatavya andũ makwa movũngũ ala methukĩĩasya movũngũ. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.19",
            "verseOrgIds": [
              "EZK.13.19"
            ]
          }
        },
