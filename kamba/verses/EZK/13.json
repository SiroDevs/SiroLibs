                "loc": "EZK.22.28"
              },
              "items": [
                {
                  "text": "22.28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.6",
            "verseOrgIds": [
              "EZK.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũtyaaona woni wa ũvũngũ, na mũtyaaneena ũvũngũ wa kũaũsya, ũndũ mũkwasya, Yeova easya; nakwa ndyaaneena?",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.7",
            "verseOrgIds": [
              "EZK.13.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.7",
            "verseOrgIds": [
              "EZK.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwondũ wa ũu Mwĩaĩi Yeova easya atĩĩ: Nĩkwĩthĩwa nĩmũneenete ũvũngũ, na mwonete movũngũ, kwondũ wa ũu sisyai, nĩ na ũndũ nenyu, easya ũu Mwĩaĩi Yeova. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.8",
            "verseOrgIds": [
              "EZK.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kw’oko kwakwa kũkeethĩwa ĩũlũ wa athani ala monaa mawoni ma ũvũngũ, na maaũasya makengane; matikethĩwa nzamanĩ ya andũ makwa, o na matikaandĩkwa vala nyũmba ya Isilaeli ĩandĩkĩtwe, o na matikalika nthĩ ya Isilaeli; na mũkamanya ninyie Mwĩaĩi Yeova. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.9",
            "verseOrgIds": [
              "EZK.13.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.7.5"
              },
              "items": [
                {
                  "text": "Nee 7.5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.20.38"
              },
              "items": [
                {
                  "text": "Esek 20.38",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.9",
            "verseOrgIds": [
              "EZK.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩkwĩthĩwa, ĩĩ, nĩkwĩthĩwa nĩmavĩtĩthĩtye andũ makwa, makyasya, Mũuo; na vati mũuo; na yĩla ũmwe ũnũkwaka ũvai, sisya, nĩmekũvaka sokaa ũte mũlue nesa: ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.10",
            "verseOrgIds": [
              "EZK.13.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.6.14"
              },
              "items": [
                {
                  "text": "Yel 6.14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.22.28"
              },
              "items": [
                {
                  "text": "Esek 22.28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.10",
            "verseOrgIds": [
              "EZK.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "matavye ala meũvaka ũvai sokaa ũte mũlue nesa, ũkavalũka: kũkeethĩwa mbua ya mũono ĩtulĩtye; na inyw’ĩ, mavia manene ma mbua, mũkavalũka; na kĩseve kĩnene kĩkootembũa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.11",
            "verseOrgIds": [
              "EZK.13.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.38.22"
              },
              "items": [
                {
                  "text": "Esek 38.22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.11",
            "verseOrgIds": [
              "EZK.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sisya, yĩla ũvai wĩvalũka, mũikakũlw’a, Kũĩva kũvaka kũla mwĩũvakĩte? ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.12",
            "verseOrgIds": [
              "EZK.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwondũ wa ũu Mwĩaĩi Yeova easya atĩĩ: Ngootembũa na kĩseve kĩnene ũthilĩkunĩ wakwa; na kũkeethĩwa mbua ya mũono ĩtulĩtye ũthatunĩ wakwa, na mavia manene ma mbua ma kũmina ũvai ũthilĩkunĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.13",
            "verseOrgIds": [
              "EZK.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Now’o ngaomboa ũvai ũla mũvakĩte sokaa ũte mũlue nesa, na kũũvalũkya nthĩ, na ĩndĩ mwambĩlĩlyo waw’o ũkaumĩla; na ũkavalũka, na mũkaminĩwa vu: na mũkamanya ninyie Yeova. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.14",
            "verseOrgIds": [
              "EZK.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "O ta ũu ngeanĩsya ũthilĩku wakwa ũvainĩ, na andũnĩ ala movakĩte sokaa ũte mũlue nesa; na ngamwĩa. Ũvai ti vo ũĩ, o na ala movakie; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.15",
            "verseOrgIds": [
              "EZK.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "nao, nĩ athani ma Isilaeli ala mathanaa ũndũ wa Yelusaleme, ala monaa mawoni ma mũuo kwondũ wayo, na vati mũuo, easya ũu Mwĩaĩi Yeova.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.16",
            "verseOrgIds": [
              "EZK.13.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
