              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na akeluvi mambata: kyu nĩkyo kyũmbe kĩ thayũ kĩla noonie vakuvĩ na ũsĩ wa Kevali. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.15",
