                "loc": "EZK.1.22"
              },
              "items": [
                {
                  "text": "Esek 1.22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.1.26"
              },
              "items": [
                {
                  "text": "26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.1",
            "verseOrgIds": [
              "EZK.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na aneena na ũla mũndũ wevw’ĩkĩte ngũa ya katane, na amwĩa, Lika katĩ wa ndĩa ila ithyũlũlũkaa, o ungu wa mũkeluvi noyusũsya moko maku elĩ makaa ma mwaki kuma katĩ wa akeluvi, noimanyaĩĩkya ndũanĩ. Na alika nĩmwene. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.2",
            "verseOrgIds": [
              "EZK.10.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.9.2"
              },
              "items": [
                {
                  "text": "Esek 9.2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.2",
            "verseOrgIds": [
              "EZK.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na akeluvi maũngama ngalĩ ya kw’oko kwa aũme kwa nyũmba, yĩla ũla mũndũ walikile; na ũla mũumbĩ wausũa nza ya nthĩnĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.3",
            "verseOrgIds": [
              "EZK.10.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.8.10"
              },
              "items": [
                {
                  "text": "1 Asu 8.10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.8.16"
              },
              "items": [
                {
                  "text": "Esek 8.16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.3",
            "verseOrgIds": [
              "EZK.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ũtheu mũtisu wa Yeova wambata kuma mũkeluvinĩ, na waũngama mwalyonĩ wa mũomo wa nyũmba; na nyũmba yausũwa nĩ mũumbĩ, na nza yausũĩtwe nĩ ũtisũku wa ũtheu mũtisu wa Yeova. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.4",
            "verseOrgIds": [
              "EZK.10.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.1.28"
              },
              "items": [
                {
                  "text": "Esek 1.28",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.43.2"
              },
              "items": [
                {
                  "text": "43.2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.4",
            "verseOrgIds": [
              "EZK.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kĩuumo kya nthwau sya akeluvi nĩkyeew’ĩkie kũvika nza yĩ ũtee, ta wasya wa Ngai Mwene Vinya W’onthe yĩla ũnũũneena. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.5",
            "verseOrgIds": [
              "EZK.10.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.1.24"
              },
              "items": [
                {
                  "text": "Esek 1.24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.5",
            "verseOrgIds": [
              "EZK.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kweethĩwa, yĩla weaĩe mũndũ ũla wevw’ĩkĩte ngũa ya katane, akĩmwĩa, Osa mwaki kuma katĩ wa ndĩa ila ithyũlũlũkaa, kuma katĩ wa akeluvi, alika, na aũngama ũtee wa ndĩa ĩmwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.6",
            "verseOrgIds": [
              "EZK.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mũkeluvi atambũũkya kw’oko kwake kuma katĩ wa akeluvĩ kũvika mwakinĩ ũla waĩ katĩ wa akeluvi, na awosa, ne eekĩa mokonĩ ma ũla wevw’ĩkĩte ngũa ya katane, nake awosa na aumaala. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.7",
            "verseOrgIds": [
              "EZK.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kwaumĩla akeluvinĩ mũvw’ano wa kw’oko kwa mũndũ ungu wa nthwau syoo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.8",
            "verseOrgIds": [
              "EZK.10.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
