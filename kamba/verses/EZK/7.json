        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yu mũminũkĩlyo nũkũvikĩe, na nĩngũete ũthatu wakwa ĩũlũ waku, na nĩngũũsilĩla kwĩanana na mĩendele yaku; na nĩngũete mothatyo maku onthe ĩũlũ waku. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.3",
            "verseOrgIds": [
              "EZK.7.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
