              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩngĩ ndeto ya Yeova yambũkĩa, ĩkĩmbĩa, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.1",
            "verseOrgIds": [
              "EZK.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naku, mwana wa mũndũ, ũũ nĩw’o Mwĩaĩi Yeova ũnũũtavya nthĩ ya Isilaeli, Mũminũkĩlyo: mũminũkĩlyo nũvikĩe ikotonĩ inya sya nthĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.2",
            "verseOrgIds": [
              "EZK.7.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
