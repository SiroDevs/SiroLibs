              "items": [
                {
                  "text": "Esek 18.30",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.3",
            "verseOrgIds": [
              "EZK.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na itho yakwa yĩtikakũekea, o na ndikew’ĩa tei; ĩndĩ ngaete mĩendele yaku ĩũlũ waku, na mothatyo maku makeethĩwa katĩ waku: na mũkamanya ninyie Yeova. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.4",
            "verseOrgIds": [
              "EZK.7.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
