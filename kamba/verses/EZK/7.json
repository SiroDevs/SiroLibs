          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ andũ moo ala makathonoka, makathonoka, na makeethĩwa iĩmanĩ ta mavũĩ ma myandanĩ, onthe makĩkayaa, kĩla ũmwe e ũthũkunĩ wake. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.16",
            "verseOrgIds": [
              "EZK.7.16"
            ]
          }
        },
