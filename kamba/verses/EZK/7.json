          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ mũthoosya ndakasyokea kĩla kyathooiw’e, o na ethĩwa me thayũ: nũndũ ũ woni nĩ ũndũ wa wingĩ woo w’onthe, vaĩ ũla ũkasyoka; o na vai ũla ũkeyĩkĩa vinya e ũthũkunĩ wa thayũ wake.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.13",
            "verseOrgIds": [
              "EZK.7.13"
            ]
          }
        }
      ]
    },
