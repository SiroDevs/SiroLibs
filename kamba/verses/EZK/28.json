              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana wa mũndũ, elekelya ũthyũ waku Sitoni, noimyathanĩa, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.21",
