          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na yu nũvandĩtwe weũnĩ, nthĩ nyũmũ na yĩ waũni. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.13",
            "verseOrgIds": [
              "EZK.19.13"
            ]
          }
