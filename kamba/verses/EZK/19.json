        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na waĩ na mbonge syĩ vinya kwondũ wa ndata sya ala masumbĩkaa, na kĩũngamo kyaw’o kyookĩla katĩ wa mbonge nthungu, na wooneka ũtũlunĩ waw’o vamwe na wingĩ wa mbonge syaw’o. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.11",
            "verseOrgIds": [
              "EZK.19.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ wakũwa ũthilĩkunĩ, wekw’a nthĩ, na kĩseve kyumĩte wumĩlonĩ wa syũa kyoomĩthya ũsyao waw’o: ndata syaw’o syĩ vinya syatũlangwa na syooma; na mwaki waivĩvya. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.12",
            "verseOrgIds": [
              "EZK.19.12"
            ]
          }
        },
