          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Syawĩkĩa kyũũnĩ na mboloi, na syooete kwa mũsumbĩ wa Mbaviloni; mooete ngomenĩ syĩ vinya, wasya waw’o ndũkaaĩw’ĩke ĩngĩ iĩmanĩ sya Isilaeli. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.9",
            "verseOrgIds": [
              "EZK.19.9"
            ]
          }
        },
