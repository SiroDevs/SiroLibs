            "sid": "EZK 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "O na i mbaĩ nĩsyeewie ũvoo waw’o; naw’o wakwatĩw’a ĩimanĩ yasyo; na syooete na mboloi nthĩ ya Misili. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.4",
            "verseOrgIds": [
              "EZK.19.4"
            ]
          }
        },
        {
          "name": "note",
