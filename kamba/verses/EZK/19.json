              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.15.6"
              },
              "items": [
                {
                  "text": "Esek 15.6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.10",
            "verseOrgIds": [
