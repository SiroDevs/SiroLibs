          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "nokyasya, Ĩnyĩa waku aĩ mwaũ? Mũnyambũ mũka: nĩwamandĩkie katĩ wa mĩnyambũ, aĩthĩsye maswii make katĩ wa mĩnyambũ ya mũika. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.2",
            "verseOrgIds": [
              "EZK.19.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
