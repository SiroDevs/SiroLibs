            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.23.31"
              },
              "items": [
                {
                  "text": "31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.3",
            "verseOrgIds": [
              "EZK.19.3"
            ]
