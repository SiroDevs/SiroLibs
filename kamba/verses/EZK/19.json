            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inyia waku ailyĩ mũsavivũ, nthakamenĩ yaku, ũvandĩtwe vakuvĩ na manzĩ: waĩ na ũsyao na wusũĩtwe mbonge nũndũ wa manzĩ kwingĩva. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.10",
            "verseOrgIds": [
              "EZK.19.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
