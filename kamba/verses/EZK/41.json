          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.14",
            "verseOrgIds": [
              "EZK.41.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 41:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na athima ũasa wa mwako mbee wa vandũ vavathan’ye vala vaĩ ĩtina waw’o, na mavalasya maw’o me ĩũlũ nthĩnĩ ngalĩ ĩmwe na ngalĩ ĩla ĩngĩ, mĩkono ĩana; na ĩkalũ ya nthĩnĩ, na mavalasya ma nza; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.15",
            "verseOrgIds": [
              "EZK.41.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 41:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "myalyo ya mĩomo, na mbũthi mbinge, na mavalasya me ĩũlũ nthĩnĩ mathyũlũlũkĩte tũsũmba tũũ tũtatũ, kamwe ĩũlũ wa kangĩ, kwelekela mwalyo wa mũomo, syaseũvw’a nthĩnĩ kw’onthe na mbwaũ, na kuma nthĩ kũvika mbũthi (na mbũthi syaĩ mbw’ĩke), ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.16",
            "verseOrgIds": [
              "EZK.41.16"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
