                {
                  "text": "1 Asu 6.5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.6.6"
              },
              "items": [
                {
                  "text": "6",
                  "type": "text"
                }
