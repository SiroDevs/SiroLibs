        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.2",
            "verseOrgIds": [
              "EZK.41.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 41:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩvo ĩndĩ walikile nthĩnĩ, na athima kĩla kĩtuĩ kya ũlikĩlonĩ, mĩkono ĩlĩ; na ũlikĩlo, mĩkono thanthatũ; na ũthanthau wa ũlikĩlo, mĩkono mũonza. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.3",
            "verseOrgIds": [
              "EZK.41.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 41:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na athima ũasa wa vo, mĩkono mĩongo ĩlĩ, na ũthanthau, mĩkono mĩongo ĩlĩ, na ũthanthau, mĩkono mĩongo ĩlĩ, ngalĩ ya mbee ya ĩkalũ: na ambĩa, Vaa nĩ vandũ vala vatheu mbee. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.4",
            "verseOrgIds": [
              "EZK.41.4"
            ]
          }
        },
        {
