            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.11",
            "verseOrgIds": [
              "EZK.41.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 41:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mwako ũla waĩ mbee wa vandũ vavathan’ye ngalĩ ĩla yelekele ũthũĩlonĩ wa syũa ũthanthau waw’o waĩ mĩkono mĩongo mũonza; na kĩemo kya wako wa mwako ũsu kyaĩ mĩkono ĩtano ngalĩ syonthe, na ũasa waw’o waĩ mĩkono mĩongo kenda. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.12",
            "verseOrgIds": [
              "EZK.41.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 41:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "O ta ũu athima nyũmba, ũasa wayo waĩ mĩkono ĩana; na vandũ vavathan’ye, na mwako, vamwe na mawako maw’o, ũasa nĩ mĩkono ĩana; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.13",
            "verseOrgIds": [
              "EZK.41.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 41:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "o na ũthanthau wa ngalĩ ya mbee ya nyũmba, na wa vandũ vavathan’ye kwelekela wumĩlonĩ wa syũa, nĩ mĩkono ĩana.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.14",
            "verseOrgIds": [
              "EZK.41.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
