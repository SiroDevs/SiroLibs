          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuma nthĩ kũvika ĩũlũ wa mũomo kwaseũviw’e akeluvi na mĩtĩ ya mĩtende; wako wa ĩkalũ wailyĩ ta ũu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.20",
            "verseOrgIds": [
              "EZK.41.20"
            ]
          }
        }
