              "type": "text"
            }
          ]
        },
        {
          "text": "Nyie mwene ngethĩwa mũĩthi wa malondu makwa, ngamatindisya, easya ũu Mwĩaĩi Yeova. ",
          "type": "text",
          "attrs": {
