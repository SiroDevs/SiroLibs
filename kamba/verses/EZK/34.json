          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malondu makwa nĩmangangaa iĩmanĩ syonthe, na ĩũlũ wa kĩla kalĩma katũlu: ĩĩ, malondu makwa manyaĩĩkw’a ĩũlũ wa nthĩ yonthe; na vatyaĩ ũmwe waakũlĩĩlya kana kũmamantha.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.6",
            "verseOrgIds": [
              "EZK.34.6"
            ]
          }
        }
