          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩmũĩsaa mathunya, na nĩmwĩvw’ĩkaa w’ĩa wa malondu, nĩmũaaa ala manou; ĩndĩ mũtiĩthasya malondu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.3",
            "verseOrgIds": [
              "EZK.34.3"
            ]
          }
        },
