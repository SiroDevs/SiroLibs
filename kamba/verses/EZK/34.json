              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwondũ wa ũu, inyw’ĩ aĩthi, ĩthukĩĩsyei ndeto ya Yeova: ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.7",
            "verseOrgIds": [
              "EZK.34.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 34:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "O tondũ nĩ thayũ, easya ũu Mwĩaĩi Yeova, nũndũ vate ndĩi malondu makwa nĩmataviwe, na malondu makwa matw’ĩka lĩu wa nyamũ syonthe sya kĩthekanĩ, nĩkwĩthĩwa kũtyaĩ mũĩthi, o na aĩthi makwa matyaamantha malondu makwa, ĩndĩ aĩthi nĩmeeĩthasya, na matyaaĩthya malondu makwa; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.8",
            "verseOrgIds": [
              "EZK.34.8"
            ]
          }
        },
