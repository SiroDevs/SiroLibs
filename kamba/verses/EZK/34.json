          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ngamaiĩa mũĩthi ũmwe, na akamaĩthya, o mũthũkũmi wakwa Ndaviti; akamaĩthya, na akeethĩwa mũĩthi woo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.23",
            "verseOrgIds": [
