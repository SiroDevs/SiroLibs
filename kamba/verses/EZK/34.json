        },
        {
          "text": "Na ngamokĩlĩlya mũũnda wĩ nguma, na matikaminwa ĩngĩ nĩ yũa nthĩ ĩsu, o na matikakua, nthoni sya i mbaĩ ĩngĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.29",
            "verseOrgIds": [
              "EZK.34.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
