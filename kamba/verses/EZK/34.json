        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 34:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ nĩmũũtindĩkana na mbau na kĩtuo, na kũlumangya onthe awau na mbya syenyu, kũvika nĩmũmanyaĩĩkĩtye; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.21",
            "verseOrgIds": [
              "EZK.34.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 34:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwondũ wa ũu ngatangĩĩa ndĩthya yakwa, na matikethĩwa mũtavo ĩngĩ: na ngasilan’ya malondu na malondu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.22",
            "verseOrgIds": [
              "EZK.34.22"
            ]
          }
        },
        {
