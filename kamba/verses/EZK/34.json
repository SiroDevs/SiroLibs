        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 34:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana wa mũndũ, athanĩa aĩthi ma Isilaeli, athana, noimea, o aĩthi, Ũũ nĩw’o Mwĩaĩi Yeova ũnũkwasya: Woo nĩ wa aĩthi ma Isilaeli ala meĩthasya! Aĩthi matyaĩle kũĩthya malondũ? ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.2",
            "verseOrgIds": [
              "EZK.34.2"
            ]
          }
        },
