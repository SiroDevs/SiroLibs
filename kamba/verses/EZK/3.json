        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.13",
            "verseOrgIds": [
              "EZK.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
