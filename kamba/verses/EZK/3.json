          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na neew’a kĩuumo kya nthwau sya syũmbe syĩ thayũ yĩla syakiitanganaa, na kĩuumo kya ndĩa ũtee wasyo, o kĩlonzo kya kĩuumo kĩnene. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.13",
            "verseOrgIds": [
              "EZK.3.13"
            ]
          }
        },
        {
