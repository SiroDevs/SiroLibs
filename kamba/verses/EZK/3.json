              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kweethĩwa mĩthenya mũonza yathela, ndeto ya Yeova yambũkĩa, ĩkĩmbĩa. ",
          "type": "text",
          "attrs": {
