            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ambĩa, Mwana wa mũndũ, ya kĩla wĩona; ya ĩvuku yĩĩ ĩkũnze, noithi, ũneene na nyũmba ya Isilaeli. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.1",
            "verseOrgIds": [
              "EZK.3.1"
            ]
          }
        },
        {
