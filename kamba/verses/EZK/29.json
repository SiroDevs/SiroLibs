            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwaka wa ĩkũmi, mwei wa ĩkũmi, mũthenya wa ĩkũmi na ĩlĩ wa mwei, ndeto ya Yeova yambũkĩa, ĩkĩmbĩa, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.1",
            "verseOrgIds": [
              "EZK.29.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
