          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vati kũũ kwa mũndũ kũkamĩvĩtĩla, o na kũũ kwa nyamũ kũikamĩvĩtĩla, o na ndĩkatũwa myaka mĩongo ĩna. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.11",
            "verseOrgIds": [
              "EZK.29.11"
            ]
          }
        },
