              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katĩ wa mosumbĩ ũkeethĩwa ĩtheo vyũ; o na ndũketũlya ĩngĩ ĩũlũ wa i mbai: na ngamanyivya, nĩ kana matikasumbĩke i mbaĩ ĩngĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.15",
            "verseOrgIds": [
