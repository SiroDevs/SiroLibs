            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 29:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ngakwĩkya weũnĩ, we na makũyũ onthe ma mbũsĩ syaku: ũkavalũka weũnĩ; ndũkombanw’a vamwe, o na ndũkatũngĩanĩwa; nĩnĩkũnenganĩte wĩthĩwe lĩu wa nyamũ sya kũũ nthĩ na nyũnyi sya yayaya. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.5",
            "verseOrgIds": [
              "EZK.29.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
