            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.38.4"
              },
              "items": [
                {
                  "text": "Esek 38.4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
