          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ndũkethĩwa wĩkwatyo wa nyũmba ya Isilaeli ĩngĩ, ũkĩete ũkilikan’yo wa ũthũku, yĩla makethyũũa kũmasisya: na makamanya ninyie Mwĩaĩi Yeova. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.16",
            "verseOrgIds": [
