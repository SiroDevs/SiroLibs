            "number": "2",
            "style": "v",
            "sid": "EZK 35:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana wa mũndũ, lutĩla kĩĩma kya Seili ũthyũ waku, noikyathanĩa, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.35.2",
            "verseOrgIds": [
