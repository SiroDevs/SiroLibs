          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakũtw’ĩkĩthya mũthei mavinda onthe, na ndũa syaku itikatũwa; na mũkamanya ninyie Yeova. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.35.9",
