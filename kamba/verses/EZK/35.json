          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwondũ wa ũu, o tondũ nĩ thayũ, easya ũu Mwĩaĩi Yeova, ngakwia kũvikĩa nthakame, na nthakame ĩkakũatĩĩa: nũndũ ndwaamena nthakame, kwondũ wa ũu nthakame ĩkakũatĩĩa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.35.6",
            "verseOrgIds": [
              "EZK.35.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
