            "verseOrgIds": [
              "EZK.35.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 35:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ũkĩtavye, Ũũ nĩw’o Mwĩaĩi Yeova ũnũkwasya: Sisya, nĩ na ũndũ naku, we kĩĩma kya Seili, na ngakũtambũũkĩsya kw’oko kwakwa, na ngakũtw’ĩkĩthya mũthei na ũseng’yo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.35.3",
            "verseOrgIds": [
              "EZK.35.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
