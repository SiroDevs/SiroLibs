                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.35.4",
            "verseOrgIds": [
              "EZK.35.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 35:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩkwĩthĩwa waĩ na ũthũ mavinda onthe, na nĩwanenganie ana ma Isilaeli vinyanĩ wa ũvyũ ĩvinda ya wanangĩko woo mũnene, ĩvinda ya ũthũku wa mũminũkĩlyo; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.35.5",
            "verseOrgIds": [
              "EZK.35.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
