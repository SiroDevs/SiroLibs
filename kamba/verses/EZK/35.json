            "sid": "EZK 35:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngatw’ĩkĩthya ndũa syaku maanzo, na ũkeethĩwa wĩ mũthei; na ũkamanya ninyie Yeova. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.35.4",
            "verseOrgIds": [
              "EZK.35.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
