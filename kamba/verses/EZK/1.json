                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.4.6+REV.4.7+REV.4.8"
              },
              "items": [
                {
                  "text": "Ũvu 4.6–8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.5",
            "verseOrgIds": [
              "EZK.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "na kĩla kĩmwe kyaĩ na mothyũ ana, na kĩla kĩmwe kyasyo kyaĩ na nthwau inya. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.6",
            "verseOrgIds": [
              "EZK.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na maũũ masyo maĩ malũngalu; na nyaĩĩ sya maũũ masyo syailyĩ ta ũnyaĩĩ wa kũũ kwa kasaũ; na syatisatisaa ta ũthuku mũkute. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.7",
            "verseOrgIds": [
              "EZK.1.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
