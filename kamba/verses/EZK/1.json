            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.12",
            "verseOrgIds": [
              "EZK.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
