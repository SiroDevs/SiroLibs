        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "nthwau syasyo syakwatene ũmwe na ũla ũngĩ; ityeethyũũaa yĩla syaendaa; syaendaa kimwe na kĩmwe ilũngalĩte. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.9",
            "verseOrgIds": [
              "EZK.1.9"
            ]
          }
        },
