          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ũla wĩ kũasa akooawa nĩ mũimũ; na ũla wĩ vakuvĩ akavalũkw’a na ũvyũ; na ũla wĩtiala na kũtw’ĩkanĩw’a akooawa nĩ yũa: ũu nĩw’o ngeanĩsya ũthilĩku wakwa kwoo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.6.12",
            "verseOrgIds": [
              "EZK.6.12"
            ]
          }
        },
