              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.6.8",
            "verseOrgIds": [
              "EZK.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ala makavonoka ma inyw’ĩ makandilikanĩla me i mbaĩnĩ vala makatwawa me atave, ũndũ navevenzetwe ũndũ wa ngoo syoo mbathe, ila syandiie, na ũndũ wa metho moo, ala mekaa ũmalwaya makĩatĩĩa mĩvw’anano yoo: na makeekola methonĩ moo nũndũ wa mothũku ala meekie mothatyonĩ moo onthe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.6.9",
            "verseOrgIds": [
              "EZK.6.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
