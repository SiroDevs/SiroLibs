          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ ngatialya ũtialo, nũndũ mũkeethĩwa na amwe ala makavonoka ũvyũ me katĩ wa i mbaĩ, yĩla mũkanyaĩĩkĩw’a i nthĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.6.8",
            "verseOrgIds": [
              "EZK.6.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
