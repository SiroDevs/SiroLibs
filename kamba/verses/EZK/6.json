            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.6.5",
            "verseOrgIds": [
              "EZK.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Motũonĩ menyu onthe ndũa ikatw’ĩka maanzo, na kũndũ kũtũlu kũkeethĩwa kwĩ kũthei; nĩ kana ithembeo syenyu syanangwe na kũtw’ĩkĩthw’a nthei, na mĩvw’anano yenyu ĩtũlangwe na kũekwa, na mĩvw’anano yenyu ya syũa ĩtilangwe, na mawĩa menyu manangwe vyũ. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.6.6",
            "verseOrgIds": [
              "EZK.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na oawa makavalũka katĩ wenyu, na mũkamanya ninyie Yeova.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.6.7",
            "verseOrgIds": [
              "EZK.6.7"
            ]
          }
        }
      ]
    },
