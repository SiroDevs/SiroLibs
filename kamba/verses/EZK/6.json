            "verseOrgIds": [
              "EZK.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ũkyasya, Inyw’ĩ iĩma sya Isilaeli, ĩthũkĩĩsyei ndeto ya Mwĩaĩi Yeova: Ũũ nĩw’o Mwĩaĩĩ Yeova ũnũũtavya iĩma na tũlĩma, mbũsĩ na myanda: Sisya, nyie, o nyie, ngaete ũvyũ ĩũlũ wenyu, na ngaananga kũndũ kwenyu kũtũlu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.6.3",
            "verseOrgIds": [
              "EZK.6.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
