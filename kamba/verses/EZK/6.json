          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana wa mũndũ, lũlũmĩlya ũthyũ waku welekele iĩma sya Isilaeli, ũsyathanĩe, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.6.2",
            "verseOrgIds": [
              "EZK.6.2"
            ]
          }
        },
