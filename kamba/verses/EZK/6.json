                "loc": "2KI.23.14"
              },
              "items": [
                {
                  "text": "2 Asu 23.14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.23.16"
              },
              "items": [
                {
                  "text": "16",
                  "type": "text"
