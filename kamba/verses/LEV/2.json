              "type": "text"
            }
          ]
        },
        {
          "text": "Mũkaithembee Yeova syĩthĩwe nthembo ya mosyao ma mbee: ĩndĩ itikethĩwe kĩthembeonĩ syĩthĩwe mũuke mũseo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.12",
            "verseOrgIds": [
