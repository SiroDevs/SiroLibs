          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na akamũetee Yeova nthembo yake ya ĩvĩtyo, ndũũme ya ndĩthya ĩte kĩema, kwĩanana na ũndũ wĩona thooa wayo wĩana, yĩthĩwe nthembo ya ĩvĩtyo, ĩetwe kwa mũthembi: ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.6",
            "verseOrgIds": [
              "LEV.6.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.5.18"
              },
