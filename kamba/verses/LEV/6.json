            "number": "11",
            "style": "v",
            "sid": "LEV 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na akaumye ngũa syake, na kwĩkĩa ngũa ingĩ, na kũtwaa mũu ũtee wa mwako wa maeema vandũ vatheu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.11",
            "verseOrgIds": [
              "LEV.6.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.44.19"
              },
              "items": [
                {
                  "text": "Esek 44.19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.11",
            "verseOrgIds": [
              "LEV.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mwaki wakanae kĩthembeonĩ, ndũkaavoe; na mũthembi akavĩvasye ngũ ĩũlũ wakyo kĩla kĩoko: na kwaĩĩa nthembo ya kũvĩvw’a ĩũlũ wasyo, na akavĩvĩsye mathunya ma nthembo sya mũuo vo ĩũlũ. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.12",
            "verseOrgIds": [
              "LEV.6.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.3.3+LEV.3.4+LEV.3.5"
              },
              "items": [
                {
                  "text": "Ali 3.3–5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.12",
            "verseOrgIds": [
              "LEV.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwaki wakanae kĩthembeonĩ ũtatw’ĩkanaa; ndũkaavoe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.13",
            "verseOrgIds": [
              "LEV.6.13"
            ]
          }
        }
      ]
    },
