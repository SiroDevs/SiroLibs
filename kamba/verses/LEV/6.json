            "sid": "LEV 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "nake mũthembi akamwĩw’anĩthya ũsu mbee wa Yeova; na akaekewa ũndũ o na wĩva ũla watumie ethĩwa mũvĩtan’ya.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.7",
            "verseOrgIds": [
              "LEV.6.7"
            ]
          }
        }
