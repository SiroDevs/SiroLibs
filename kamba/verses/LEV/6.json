          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ethĩwa mũndũ o na wĩva akeeka naĩ, na kũmũvĩtanĩsya Yeova, na kũkenga mũtũi wake kwondũ wa kĩndũ wiĩte kwake, kana kwondũ wa wĩw’ano, kana kũvutana, kana kũmũthĩn’ya mũtũi wake, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.2",
            "verseOrgIds": [
              "LEV.6.2"
            ]
          }
        },
