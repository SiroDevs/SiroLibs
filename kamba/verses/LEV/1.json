                "loc": "LEV.3.8"
              },
              "items": [
                {
                  "text": "Ali 3.8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.5",
            "verseOrgIds": [
              "LEV.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake akathĩnze ĩla nthembo ya kũvĩvw’a, na kũmĩtilanga ilungu syayo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.6",
            "verseOrgIds": [
              "LEV.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ana ma mũthembi Aluni makekĩe mwaki kĩthembeonĩ, na kwaĩĩa ngũ ĩũlũ wa mwaki; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.7",
            "verseOrgIds": [
              "LEV.1.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.22.9"
              },
              "items": [
                {
                  "text": "Mwa 22.9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.7",
            "verseOrgIds": [
              "LEV.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "na ana ma Aluni, ala athembi, makaie ila ilungu, vamwe na mũtwe, na mathunya, maĩĩe ĩũlũ wa ngũ ila syĩ mwakinĩ ũla wĩ kĩthembeonĩ: ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.8",
            "verseOrgIds": [
              "LEV.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "ĩndĩ mavu mako na maũũ mako akathambye na manzĩ. Na mũthembi akavĩvĩsye konthe kĩthembeonĩ, kethĩwe nthembo ya kũvĩvw’a, nthembo ĩvĩvaw’a na mwaki, yĩ mũuke mũseo kwa Yeova. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.9",
            "verseOrgIds": [
              "LEV.1.9"
            ]
          }
        },
