          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.15",
            "verseOrgIds": [
              "LEV.27.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 27:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ethĩwa mũndũ akamũvathĩa Yeova kĩlungu kya mũũnda wake wa ng’ũndũ yake kĩthĩwe kĩtheu, nĩvo ũtalo waku ũkethĩwe kwĩanana na kũvandwa kwaw’o: kũvandwa kwa omeli ya mbaale kũkatalwe thooa wakw’o sekeli mĩongo ĩtano sya vetha. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.16",
            "verseOrgIds": [
              "LEV.27.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 27:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ethĩwa akavatha mũũnda wake wĩthĩwe mũtheu kuma mwaka wa yuvilii, ũtalo waku o ũndũ wĩana ũkekale. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.17",
            "verseOrgIds": [
              "LEV.27.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 27:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ ethĩwa akavatha mũũnda wake wĩthĩwe mũtheu mwaka wa yuvilii wathela, nĩvo mũthembi ũkamũtalĩle mbesa kwĩanana na ũndũ myaka yĩana ĩla yĩtialĩte ya kũvika mwaka wa yuvilii; na ikaolwe ũtalonĩ waku. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.18",
            "verseOrgIds": [
              "LEV.27.18"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
