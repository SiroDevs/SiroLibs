            "number": "2",
            "style": "v",
            "sid": "LEV 27:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neena na ana ma Isilaeli, noimea, Yĩla mũndũ wĩĩvĩta wĩvĩto, andũ makeethĩwa ma Yeova kwĩanana na ũndũ wĩmatalĩla wovosyo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.2",
            "verseOrgIds": [
              "LEV.27.2"
            ]
          }
        },
