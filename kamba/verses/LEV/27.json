          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwaka wa yuvilii mũũnda nũsyokee ũla wathooisye, o ũsu ũla ĩ nthĩ nĩ yake. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.24",
