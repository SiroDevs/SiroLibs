              "LEV.27.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 27:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na yĩla mũndũ wĩmũvathĩa Yeova nyũmba yake yĩthĩwe ntheu, nĩvo mũthembi wĩtw’a thooa wayo, ethĩwa nĩ nzeo kana nthũku; o ũndũ mũthembi wĩtw’a thooa wayo, o ũu thooa ũkekala. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.14",
            "verseOrgIds": [
              "LEV.27.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 27:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ethĩwa ũla wamĩvathie yĩthĩwe ntheu akenda kwovosya nyũmba yake, akawongeleele ũtalo waku kĩlungu kya katano kya mbesa, na ĩkeethĩwa yake.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.15",
            "verseOrgIds": [
              "LEV.27.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
