                "loc": "ISA.66.17"
              },
              "items": [
                {
                  "text": "Isa 66.17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.29",
            "verseOrgIds": [
              "LEV.11.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 11:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "na mwilũ, na ngusw’ĩ, na ĩtelembũ, na nzana, na kĩmbu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.30",
            "verseOrgIds": [
              "LEV.11.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 11:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tũu nĩtw’o tũvuku kwenyu twa tw’onthe tũla tũtambũkaa: o ũla ũkatũkiita twĩ tũkw’ũ, akeethĩwa mũvuku kũvika wĩoo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.31",
            "verseOrgIds": [
              "LEV.11.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 11:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kamwe katw’o ke kakw’ũ kakavalũkĩla kĩndũ o na kĩva, kĩkeethĩwa kĩvuku: ethĩwa nĩ kĩndũ kĩseũvĩtw’e kya mũtĩ, kana ngũa, kana kĩthuma, kana ĩkunia, kĩndũ o na kĩva, kĩla kĩtetheaw’a wĩa o na wĩva, mũvaka kĩkĩwe manzĩnĩ, na kĩkeethĩwa kĩvuku kũvika wĩoo; nĩvo ĩndĩ kĩĩthĩwa kĩtheu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.32",
            "verseOrgIds": [
              "LEV.11.32"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.15.12"
              },
              "items": [
                {
                  "text": "Ali 15.12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.32",
            "verseOrgIds": [
              "LEV.11.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LEV 11:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kĩla kĩndũ kyũmbĩtwe kya yũmba, kĩla kamwe katw’o kakavalũka nthĩnĩ wakyo, o kĩla kĩ nthĩnĩ wakyo kĩkeethĩwa kĩvuku, na mũkakyũaa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.33",
            "verseOrgIds": [
              "LEV.11.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LEV 11:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lĩu w’onthe nthĩnĩ wakyo ũla ũtonya kũĩwa, ũla manzĩ asu meĩkĩwa ĩũlũ waw’o, ũkeethĩwa mũvuku; na kya ũnyw’a kyonthe kĩla kĩtonya kũnyw’ĩwa kĩ mũionĩ ũilyĩ ũu kĩkeethĩwa kĩvuku. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.34",
            "verseOrgIds": [
              "LEV.11.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LEV 11:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kĩla kĩndũ kĩkavalũkĩlwa nĩ kĩlungu o na kĩva kyatw’o twĩ tũkw’ũ kĩkeethĩwa kĩvuku; ethĩwa nĩ iko, kana mbisũ, ĩkooawa ilungu: nĩ mbuku, na ikeethĩwa mbuku kwenyu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.35",
            "verseOrgIds": [
              "LEV.11.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LEV 11:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ nthongo kana ĩima yĩla manzĩ mombanĩe yĩkeethĩwa yĩ ĩtheu: ĩndĩ o ũla ũkatũkiita twĩ tũkw’ũ akeethĩwa mũvuku. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.36",
            "verseOrgIds": [
              "LEV.11.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LEV 11:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ethĩwa kĩlungu kyatw’o twĩ tũkw’ũ kĩkavalũkĩla mbeũ ila sya ũvandwa, nĩ ntheu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.37",
            "verseOrgIds": [
              "LEV.11.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LEV 11:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ ethĩwa mbeũ ikeekĩwa manzĩ, na kĩlungu kyatw’o twĩ tũkw’ũ kĩkaivalũkĩla, nĩ mbuku kwenyu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.38",
            "verseOrgIds": [
              "LEV.11.38"
            ]
          }
        }
      ]
    },
