          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ nyie nĩ Yeova Ngai wenyu: kwondũ wa ũu ĩvathan’yei, na ĩthĩwai atheu; nũndũ nyie nĩ mũtheu: o na mũikevukye na kasamũ o na keva kala katambũkaa kala kaendaa ĩũlũ wa nthĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.44",
            "verseOrgIds": [
              "LEV.11.44"
            ]
          }
        },
