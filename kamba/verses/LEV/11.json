          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tũsamũnĩ tũla tũtambũkaa ĩũlũ wa nthĩ tũũ nĩtw’o tũvuku kwenyu: kamũũngũu, na kavĩla, na ndĩlya nene o mũthemba wayo, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.29",
            "verseOrgIds": [
              "LEV.11.29"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
