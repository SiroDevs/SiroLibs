          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ tũsamũ tw’onthe tũla twĩ na nthwau na tũtambũkaa, tũla twĩ na maũũ ana, nĩ ũthatyo kwenyu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.23",
            "verseOrgIds": [
              "LEV.11.23"
            ]
          }
        }
      ]
    },
