          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Matikatwae mũndũ mũka ĩlwaya, kana mũvukye; o na matikatwae mũndũ mũka ũeketwe nĩ mũũme: nũndũ mũthembi nĩ mũtheu kwa Ngai wake. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.7",
            "verseOrgIds": [
              "LEV.21.7"
            ]
          }
        },
        {
          "name": "note",
