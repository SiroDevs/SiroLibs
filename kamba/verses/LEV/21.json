            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake akatwae mwĩĩtu mũtheu ethĩwe mũka wake. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.13",
            "verseOrgIds": [
              "LEV.21.13"
            ]
          }
        },
        {
