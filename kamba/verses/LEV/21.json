              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaĩsaa lĩu ũla mũtheu mũno, na ũla mũtheu, wa Ngai wake: ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.22",
