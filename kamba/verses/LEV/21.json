            }
          ]
        },
        {
          "text": "kana mũndũ ũla wĩ kũũ kũtũlĩku, kana kw’oko kũtũlĩku, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.19",
            "verseOrgIds": [
              "LEV.21.19"
            ]
          }
        },
        {
