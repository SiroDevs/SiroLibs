        {
          "text": "o na ndakalike vala ve mũndũ mũkw’ũ, kana kwĩvukya kwondũ wa ĩthe wake, kana nyinyia; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.11",
            "verseOrgIds": [
