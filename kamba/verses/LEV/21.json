              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "ĩndĩ ndakalike vala ve ũla tũtũ, kana kũthengeea kĩthembeo, nĩkwĩthĩwa e kĩema; ndakavukye kũndũ kwakwa kũtheu: nũndũ ninyie Yeova ũla ũmavathanasya methĩwe atheu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.23",
            "verseOrgIds": [
              "LEV.21.23"
            ]
          }
        },
        {
          "name": "verse",
