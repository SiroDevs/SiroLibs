          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "mũndũ o na wĩva wa ũsyao wa mũthembi Aluni, ũla wĩ kĩema, ndakathengeee kũthemba nthembo sya Yeova ila ivĩvaw’a na mwaki: e kĩema; ndakathengeee kũthemba lĩu wa Ngai wake. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.21",
            "verseOrgIds": [
              "LEV.21.21"
            ]
          }
        },
        {
