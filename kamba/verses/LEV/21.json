              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũndũ o na wĩva wĩ kĩema, ndakathengeee: ethĩwa nĩ kĩlilinda, kana ũla ũthuaa, kana ũla wĩ ĩnyiũũ ĩmandĩku, kana ũla wĩ ĩmutha yongeleku, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.18",
            "verseOrgIds": [
              "LEV.21.18"
            ]
          }
        },
