          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "kana ũla wĩ ngathĩ mũongo, kana mũndũ ũteanaa, kana ũla wĩ ĩlai, kana ũla wĩ na mũvolekango, kana ũla wĩ na ngũsĩ, kana ũla wĩ mee mavevenze; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.20",
            "verseOrgIds": [
              "LEV.21.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
