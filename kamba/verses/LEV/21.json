            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mwĩĩtu wa mũthembi o na wĩva, ethĩwa akeevukya kwondũ wa kũtw’ĩka ĩlwaya, nũvukasya ĩthe wake: akavĩvw’e na mwaki. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.9",
            "verseOrgIds": [
              "LEV.21.9"
            ]
          }
        },
