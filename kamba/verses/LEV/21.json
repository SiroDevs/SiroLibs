          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwondũ wa ũu mũvathe ethĩwe mũtheu; nũndũ nũthembaa lĩu wa Ngai waku; akeethĩwa mũtheu kwaku; nũndũ nyie Yeova, ũla ũkũvathanasya, nĩ mũtheu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.8",
            "verseOrgIds": [
              "LEV.21.8"
            ]
          }
        },
        {
