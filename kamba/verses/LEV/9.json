            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake ooaa nthembo ya kũvĩvw’a; na ana ma Aluni mamũetee nthakame, na amĩminzangĩsya ĩũlũ wa kĩthembeo kw’onthe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.12",
            "verseOrgIds": [
              "LEV.9.12"
            ]
          }
        },
        {
