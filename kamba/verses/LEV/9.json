            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.3",
            "verseOrgIds": [
              "LEV.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "na ng’ombe na ndũũme syĩthĩwe nthembo sya mũuo, sya kũthembwa mbee wa Yeova; na nthembo ya mũtu ũvulanĩtw’e na mauta: nũndũ ũmũnthĩ Yeova nũnũkũmumĩlĩla. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.4",
            "verseOrgIds": [
              "LEV.9.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.29.43"
              },
              "items": [
                {
                  "text": "Kuma 29.43",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
