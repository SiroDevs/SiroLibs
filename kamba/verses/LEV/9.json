          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "ĩndĩ mathunya, na mbio, na koa mũvũthũ ũla waumiw’e ĩtemanĩ ya nthembo ya naĩ, avĩvĩsya kĩthembeonĩ; o tondũ Yeova wamwĩaĩe Mose. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.10",
            "verseOrgIds": [
              "LEV.9.10"
            ]
          }
        },
        {
