          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na athambya mavu na maũũ, na amavĩvĩsya ĩũlũ wa nthembo ya kũvĩvw’a kĩthembeonĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.14",
            "verseOrgIds": [
              "LEV.9.14"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.1.9"
              },
              "items": [
