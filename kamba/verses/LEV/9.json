          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na nyama na kĩthuma avĩvĩsya na mwaki ũtee wa mwako wa maeema. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.11",
            "verseOrgIds": [
              "LEV.9.11"
            ]
          }
        },
