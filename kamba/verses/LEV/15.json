        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "nake mũthembi akaithembe, ĩmwe ĩthĩwe nthembo ya naĩ, na ĩla ĩngĩ ĩthĩwe nthembo ya kũvĩvw’a; na mũthembi akamwĩw’anĩthya ũsu na Yeova kwondũ wa mũluo wake. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.15",
            "verseOrgIds": [
              "LEV.15.15"
            ]
          }
        },
        {
