          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ũsu wĩ na mũluo athew’a mũluo wake, nĩvo wĩĩtalĩla mwene matukũ mũonza ma kũthew’a kwake, na akathambye ngũa syake; na kũthamba mwĩĩ wake na manzĩ mavĩtĩte, na akeethĩwa e mũtheu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.13",
            "verseOrgIds": [
              "LEV.15.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
