          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ethĩwa mũndũ akaumwa nĩ ũsamba wake, nĩvo ĩndĩ athambe mwĩĩ wake w’onthe na manzĩ, na akeethĩwa mũvuka kũvika wĩoo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.16",
            "verseOrgIds": [
              "LEV.15.16"
            ]
          }
        },
        {
