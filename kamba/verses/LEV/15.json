              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ ethĩwa akathew’a kwa kumwa kwake kwa nthakame, nĩvo ĩndĩ wĩĩtalĩla mwene mĩthenya mũonza, na ĩtina wa ũu akeethĩwa mũtheu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.28",
            "verseOrgIds": [
              "LEV.15.28"
            ]
          }
