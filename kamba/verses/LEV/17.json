            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yeova aneena na Mose, akĩmwĩa, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.1",
            "verseOrgIds": [
              "LEV.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neena na Aluni, na ana make, na ana onthe ma Isilaeli, noimea: Ũũ nĩw’o ũla Yeova weaie, akyasya, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.2",
            "verseOrgIds": [
              "LEV.17.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũndũ o na wĩva wa nyũmba ya Isilaeli, ũla wĩũaĩa ng’ombe, kana katena ka ĩlondu, kana mbũi, mwakonĩ wa maeema, kana kũmyũaĩa ũtee wa mwako wa maeema, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.3",
            "verseOrgIds": [
              "LEV.17.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "na ndanamĩete mũomonĩ wa ĩeema ya kũmbanĩa, kũmĩnengane yĩthĩwe nthembo ya kũmũthembea Yeova mbee wa wĩkalo wa Yeova: nthakame ĩkatalĩlwa mũndũ ũsu; nake nĩwĩtĩte nthakame; na mũndũ ũsu akavetwe andũnĩ make: ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.4",
            "verseOrgIds": [
              "LEV.17.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.12.5"
              },
              "items": [
                {
                  "text": "Kũt 12.5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.4",
            "verseOrgIds": [
              "LEV.17.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "nĩ kana ana ma Isilaeli maete nthembo syoo, ila mathembeaa weũnĩ, o kana maietee Yeova, mũomonĩ wa ĩeema ya kũmbanĩa, vala ve mũthembi, na kwithembea Yeova syĩthĩwe nthembo sya nthembo sya mũuo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.5",
            "verseOrgIds": [
              "LEV.17.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
