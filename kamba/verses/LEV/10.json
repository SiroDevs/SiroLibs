          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwondũ wa ũu mathengeea, na mamakua me o na makanzũ moo mamatwaa ũtee wa mwako wa maeema, o tondũ Mose waisye.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.5",
            "verseOrgIds": [
              "LEV.10.5"
            ]
          }
