              "type": "text"
            }
          ]
        },
        {
          "text": "Na mwaki wauma mbee wa Yeova, na wamavĩvya, na makw’ĩa mbee wa Yeova. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.2",
