              "attrs": {
                "loc": "LEV.20.11+LEV.20.12+LEV.20.13+LEV.20.14+LEV.20.15+LEV.20.16+LEV.20.17+LEV.20.18+LEV.20.19+LEV.20.20+LEV.20.21"
              },
              "items": [
                {
                  "text": "Ali 20.11–21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.7",
            "verseOrgIds": [
              "LEV.18.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndũkavue mũka wa au ũmwone e mũthei; nĩ kũvua au. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.8",
            "verseOrgIds": [
              "LEV.18.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
