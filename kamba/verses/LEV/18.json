              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "nĩ kana nthĩ ndĩkaamũtavĩke inyw’ĩ, yĩla mwĩmĩvukya, o tondũ yatavĩkie mbaĩ ĩla yaĩ mbee wenyu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.28",
            "verseOrgIds": [
