          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "(nũndũ mothatyo asu onthe aũme ma ĩ nthĩ, ala maĩ mbee wenyu, nĩmamekĩte, na ĩ nthĩ nĩvukĩtw’e); ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.27",
            "verseOrgIds": [
              "LEV.18.27"
            ]
          }
        },
