              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ o ũla ũkeka mothatyo asu o na meva, o andũ ala makameka makavetwe andũnĩ moo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.29",
            "verseOrgIds": [
              "LEV.18.29"
            ]
          }
        },
