              "attrs": {
                "loc": "PRO.31.10"
              },
              "items": [
                {
                  "text": "31.10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.3.11",
            "verseOrgIds": [
              "RUT.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "RUT 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ nĩ w’o kana ninyie mũndũ wa mũvĩa wa vakuvĩ; ĩndĩ ve mũndũ wa mũvĩa wa vakuvangĩ kwĩ nyie. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.3.12",
            "verseOrgIds": [
              "RUT.3.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
