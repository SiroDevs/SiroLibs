            "sid": "RUT 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Naomi inyia wa mũũme amũkũlya, Mwĩĩtu wakwa, ndikakũmanthĩe ũthũmũo, nĩ kana kwĩthĩwe ũseo kwaku? ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.3.1",
            "verseOrgIds": [
              "RUT.3.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "RUT.1.9"
              },
              "items": [
                {
                  "text": "Lu 1.9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.3.1",
            "verseOrgIds": [
              "RUT.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "RUT 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ Mboasi ti mũndũ wa mũvĩa witũ, ũla wĩĩ na athũkũmi make eĩtu? Sisya, ũtukũ ũũ wa ũmũnthĩ eũlũkĩlya mbaale kĩvũĩonĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.3.2",
            "verseOrgIds": [
              "RUT.3.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "RUT.2.1"
              },
              "items": [
                {
                  "text": "Lu 2.1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "RUT.2.8"
              },
              "items": [
                {
                  "text": "8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.3.2",
            "verseOrgIds": [
              "RUT.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "RUT 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwondũ wa ũu thamba, na ũyĩvaka mauta, na ũkĩkĩa ngũa syaku, na ũitheea kĩvũĩonĩ; ĩndĩ ndũkemanyĩthe ũ mũndũ, mũvaka yĩla wĩĩthĩwa anaya na kũnyw’a. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.3.3",
            "verseOrgIds": [
              "RUT.3.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.12.20"
              },
              "items": [
                {
                  "text": "2 Sam 12.20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.3.3",
            "verseOrgIds": [
              "RUT.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "RUT 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kũkeethĩwa, yĩla wĩkoma, nĩvo wĩsisya vandũ vala wĩkoma, na wĩlika, na ũivw’ĩkũa nyaĩĩ syake, na ũikoma; na akaũtavya ũndũ ũla wĩĩka. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.3.4",
            "verseOrgIds": [
              "RUT.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "RUT 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake amwĩa, Ũu w’onthe waneena ngawĩka.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.3.5",
            "verseOrgIds": [
              "RUT.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "RUT 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.3.5",
            "verseOrgIds": [
              "RUT.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "RUT 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na atheea kĩvũĩonĩ, na eeka kwĩanana na ũndũ w’onthe ũla inyia wa mũũme ũmwĩaĩie. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.3.6",
            "verseOrgIds": [
              "RUT.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "RUT 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na yĩla Mboasi waĩ anaya na kũnyw’a, na ngoo yake yaĩ ndanu, athi kũkoma mũthyanĩ wa kĩvumbu kya lĩu wa mbaa ngetha: nake ooka kavola, na amũvw’ĩkũa nyaĩĩ, na akoma. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.3.7",
            "verseOrgIds": [
              "RUT.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "RUT 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kweethĩwa ũtukũ katĩ, mũndũ ũsu atĩsa, na eethyũũa; na, sisya, mũndũ mũka akomete nyaĩĩnĩ syake. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.3.8",
            "verseOrgIds": [
              "RUT.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "RUT 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na akũlya, Nue ũũ? Na amũsũngĩa, Ninyie Luthi mũthũkũmi waku mwĩĩtu: kwondũ wa ũu tambũũkya mũthya wa ngũa syaku ĩũlũ wa mũthũkũmi waku mwĩĩtu; nũndũ nue mũndu wa mũvĩa wa vakuvĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.3.9",
            "verseOrgIds": [
              "RUT.3.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "RUT.2.20"
              },
              "items": [
                {
                  "text": "Lu 2.20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.16.8"
              },
              "items": [
                {
                  "text": "Esek 16.8",
                  "type": "text"
                }
              ]
