            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwondũ wa ũu lilikanai, kana ĩvinda ya tene inyw’ĩ, Andũ‐ma‐mbaĩ‐ingĩ kwa mwĩĩ, ala mwĩtawa Mũtaĩkawa nĩ ala metawa Maĩkawa, nayo nĩ nzaĩko ya mwĩĩ, ĩla yaĩkawa na moko; ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.11",
            "verseOrgIds": [
              "EPH.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
