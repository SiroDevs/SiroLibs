              "items": [
                {
                  "text": "1 Ath 4.13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kana inyw’ĩ ĩvinda yĩu mũtyaĩ na Klĩsto, mwavathũkenw’e na mbaĩ ya Isilaeli, na mwaĩ aeni, andũ mate na motianĩo ma ũla watho, mũtaĩ na wĩkwatyo na mũtaĩ na Ngai kũũ nthĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.12",
            "verseOrgIds": [
              "EPH.2.12"
            ]
          }
        },
        {
