            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "nake ooka na atavan’ya ũvoo mũseo wa mũuo kwa inyw’ĩ ala mwaĩ kũasa, na mũuo kwa ala maĩ vakuvĩ: ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.17",
