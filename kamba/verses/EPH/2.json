                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ yu nthĩnĩ wa Klĩsto Yesũ inyw’ĩ ala mwaĩ kũasa nĩmũthengeew’e nĩ nthakame ya Klĩsto. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.13",
            "verseOrgIds": [
              "EPH.2.13"
            ]
          }
        },
        {
