                "loc": "COL.1.13"
              },
              "items": [
                {
                  "text": "Ako 1.13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ila mwaendie nthĩni wasyoĩvinda ya tene kwĩanana na mĩendele ya nthĩ ĩno, kwĩanana na mũnene wa mavinya ma yayaya, wa veva ũla wĩkaa wĩa yu nthĩnĩ wa ana ma ũlei; ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.2",
            "verseOrgIds": [
              "EPH.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EPH 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.3.6"
              },
              "items": [
                {
                  "text": "Ako 3.6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "o naitũ ithyonthe tene twekalile katĩ woo mĩmeonĩ ya mĩĩ yaitũ, tũkĩka mawendi ma mĩĩ na ma mosũanĩo, na nũndu wa mwĩkalĩle witũ twaĩ syana sya ũthatu, o ta ala angĩ:— ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.3",
            "verseOrgIds": [
              "EPH.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EPH 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "ĩndĩ Ngai, nĩkwĩthĩwa aĩ na tei mwingĩ, nũndũ wa wendo wake mũnene ũla watwendie naw’o, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.4",
            "verseOrgIds": [
              "EPH.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EPH 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.15.24"
              },
              "items": [
                {
                  "text": "Lk 15.24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.15.32"
              },
              "items": [
                {
                  "text": "32",
