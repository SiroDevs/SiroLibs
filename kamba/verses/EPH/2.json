              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "nũndũ kwondũ wake ithyelĩ twĩ na ũthei witũ wa kũthengeea mbee wa Asa nthĩnĩ wa Veva ũmwe. ",
          "type": "text",
          "attrs": {
