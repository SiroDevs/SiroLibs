          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.9.4"
              },
              "items": [
                {
                  "text": "Alo 9.4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
