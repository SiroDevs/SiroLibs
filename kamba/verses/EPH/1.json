                  "text": "6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "na nthĩnĩ wake o nenyu, mweew’a ndeto ya ũla w’o, nayo nĩ ũvoo mũseo wa ũtangĩĩo wenyu, — nake, mwamwĩtĩkĩla, nĩmwekĩiwe ũsiĩlo, naw’o nĩ Veva Mũtheu ũla wathaniwe, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.13",
            "verseOrgIds": [
              "EPH.1.13"
            ]
          }
        },
        {
