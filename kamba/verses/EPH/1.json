            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakathwe Ngai, Ĩthe wa Mwĩaĩi waitũ Yesũ Klĩsto, ũla ũtũathimĩte na kĩla ũathimo wa veva nthĩnĩ wa Klĩsto ĩtunĩ: ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.3",
            "verseOrgIds": [
              "EPH.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
