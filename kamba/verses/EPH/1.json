                "loc": "JHN.15.16"
              },
              "items": [
                {
                  "text": "Yoa 15.16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.17.24"
              },
