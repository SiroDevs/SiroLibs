            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "nake nthĩnĩ wake twĩ na wovosyo witũ kwondũ wa nthakame yake, ũekeo wa mavĩtyo maitũ, kwĩanana na ũthwii wa mumo wake, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.7",
            "verseOrgIds": [
              "EPH.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EPH 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
