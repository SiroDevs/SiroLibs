                  "text": "Alo 16.25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "akĩtũmanyĩthya nzama ya kwenda kwake, kwĩanana na kwenda kwake kũseo kũla watwie nthĩnĩ wake ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.9",
            "verseOrgIds": [
              "EPH.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
