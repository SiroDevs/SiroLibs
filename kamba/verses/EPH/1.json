              "items": [
                {
                  "text": "Aev 5.27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "o ũndũ watũnyuvie nthĩnĩ wake nthĩ ĩtanambĩlĩlw’a, nĩ kana twĩthĩwe atheu tũte na ũndũ ũtaĩle mbee wake nthĩnĩ wa wendo: ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.4",
            "verseOrgIds": [
              "EPH.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EPH 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
