            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.4.4"
              },
              "items": [
                {
                  "text": "Aka 4.4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.1.16"
              },
              "items": [
                {
                  "text": "Ako 1.16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kũvika walanyonĩ wa wĩanĩu wa mavinda, atũngĩanĩe syĩndũ syonthe nthĩnĩ wa Klĩsto, syĩndũ syi ĩtunĩ, na syĩndũ syĩ kũũ nthĩ; ĩĩ, nthĩnĩ wake we, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.10",
            "verseOrgIds": [
              "EPH.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EPH 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.1.12"
              },
              "items": [
                {
                  "text": "Ako 1.12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.8.28"
              },
              "items": [
                {
                  "text": "Alo 8.28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "na ingĩ nthĩnĩ wake ithyĩ nĩtwatwiwe ũtiĩwa wake, nĩkwĩthĩwa nĩtwanyuviwe kuma tene kwĩanana na kwenda kwake we ũla wĩkaa maũndũ onthe kwa ũtw’ĩo wa kwenda kwake; ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.11",
            "verseOrgIds": [
              "EPH.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EPH 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "nĩ kana ithyĩ twĩthĩwe ma kũtuma ũtheu wake mũtisu ũkathwa, ithyĩ ala twambie kwĩkwatya Klĩsto; ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.12",
            "verseOrgIds": [
              "EPH.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EPH 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
