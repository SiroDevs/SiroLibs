            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.5.16"
              },
              "items": [
                {
                  "text": "Kũt 5.16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "nĩ kana kwĩthĩwe ũseo kwaku, na wĩkale mũno kũũ nthĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.3",
            "verseOrgIds": [
              "EPH.6.3"
            ]
          }
        },
