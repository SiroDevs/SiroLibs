                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na, inyw’ĩ aaĩthe, mũikathatye syana syenyu: ĩndĩ ieei na mosilĩlo na motao ma Mwĩaĩi.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.4",
