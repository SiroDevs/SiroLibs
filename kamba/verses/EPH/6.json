                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.14.30"
              },
              "items": [
                {
                  "text": "Yoa 14.30",
                  "type": "text"
                }
