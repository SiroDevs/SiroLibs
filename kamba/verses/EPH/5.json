            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "nũndũ inyw’ĩ tene mwai kĩvindu, ĩndĩ yu mwĩ kyeni nthĩni wa Mwĩaĩi: endaai ta syana sya kyeni ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.8",
            "verseOrgIds": [
              "EPH.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EPH 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "(nũndũ ũsyao wa kyeni wĩ nthĩnĩ wa ũseo w’onthe na ũlũngalu na w’o), ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.9",
            "verseOrgIds": [
              "EPH.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EPH 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.12.2"
              },
              "items": [
                {
                  "text": "Alo 12.2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "mũkĩthima maũndũ ala mamwendeeasya Mwĩaĩi; ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.10",
            "verseOrgIds": [
              "EPH.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EPH 5:11"
          },
          "items": [
