              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ ũlaalai, na ũvuku w’onthe, na wendi, maikawetwe kati wenyu, o ũndũ kwaĩle atheu; ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.3",
            "verseOrgIds": [
              "EPH.5.3"
            ]
          }
        },
