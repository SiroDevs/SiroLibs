          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.12.2"
              },
              "items": [
                {
                  "text": "Alo 12.2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwondũ wa ũu mũikethĩwe atumanu, ĩndĩ manyai kwenda kwa Mwĩaĩi ũndũ kũilyĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.17",
            "verseOrgIds": [
              "EPH.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EPH 5:18"
          },
          "items": [
