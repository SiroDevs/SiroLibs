            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EPH 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "mũkĩtangĩĩa ĩvinda, nĩkwĩthĩwa mĩthenya nĩ myathe. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.16",
            "verseOrgIds": [
              "EPH.5.16"
            ]
          }
        },
        {
          "name": "verse",
