              },
              "items": [
                {
                  "text": "8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũndũ ndakamũkenge na ndeto sya mana: nũndũ kwondũ wa maũndũ aa ũthatu wa Ngai nũmokiaa ana ma ũlei. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.6",
            "verseOrgIds": [
              "EPH.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EPH 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũikethĩwe mwĩ mũamba nao; ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.7",
            "verseOrgIds": [
              "EPH.5.7"
            ]
          }
        },
