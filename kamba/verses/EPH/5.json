                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inyw’i iveti, ĩnyivĩsyei aũme menyu ta mwinyivĩsye Mwĩaĩi. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.22",
            "verseOrgIds": [
              "EPH.5.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EPH 5:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.11.3"
              },
              "items": [
                {
                  "text": "1 Ako 11.3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.1.18"
              },
              "items": [
                {
                  "text": "Ako 1.18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ mũndũ mũũme nĩ mũtwe wa kĩveti, o tondũ Klĩsto nake nĩ mũtwe wa ikanisa, nake nĩ mũtangĩĩi wa mwĩĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.23",
            "verseOrgIds": [
              "EPH.5.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EPH 5:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ o ũndũ ikanisa yimwinyivĩasya Klĩsto, o ta ũu iveti nasyo nĩsyinyiviasye aũme masyo maũndũni onthe. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.24",
            "verseOrgIds": [
              "EPH.5.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EPH 5:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.3.19"
              },
              "items": [
                {
                  "text": "Ako 3.19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aũme, endai iveti syenyu, o ũndũ Klĩsto wendie ĩkanisa, na enengane mwene kwondũ wayo; ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.25",
            "verseOrgIds": [
              "EPH.5.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EPH 5:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "TIT.3.5"
              },
              "items": [
                {
                  "text": "Tito 3.5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "nĩ kana ayĩvathan’ye, ayĩtheetye ũndũ wa kũthambya na manzĩ nthinĩ wa ndeto, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.26",
            "verseOrgIds": [
              "EPH.5.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EPH 5:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.45.13"
              },
              "items": [
                {
                  "text": "Sav 45.13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.11.2"
              },
              "items": [
                {
                  "text": "2 Ako 11.2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "nĩ kana atonye kwĩnenga mwene ĩkanisa ĩtaie, yĩte na ilanga kana ũkũnzanu kana ũndũ ũngĩ ta asu; ĩndĩ nĩ kana yĩthĩwe itheu yĩte na ũndũ ũtaĩle. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.27",
            "verseOrgIds": [
              "EPH.5.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EPH 5:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "O ta ũu aũme namo nĩmaĩlwe nĩ kũsyenda iveti syoo o ũndũ mendete mĩĩ yoo ene. Ũla wendaa kĩveti kyake eyendaa mwene: ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.28",
            "verseOrgIds": [
              "EPH.5.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EPH 5:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "nũndũ vai mũndũ waamena mwĩĩ wake o na ĩndĩĩ; ĩndi nĩwũnengae lĩu na kũũsũvĩa, o tondũ Klĩsto ũyĩsũvĩaa ikanisa; ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.29",
            "verseOrgIds": [
              "EPH.5.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EPH 5:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.1.23"
              },
              "items": [
                {
                  "text": "Aev 1.23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.6.15"
              },
              "items": [
                {
                  "text": "1 Ako 6.15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
