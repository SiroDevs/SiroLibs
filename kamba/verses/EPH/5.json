              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.3.17"
              },
              "items": [
                {
                  "text": "Ako 3.17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "mũkĩmũtũngĩa Ngai Asa mũvea, mavinda onthe kwondũ wa maũndũ onthe, syĩtwanĩ ya Mwĩaĩi waitũ Yesũ Klĩsto; ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.20",
            "verseOrgIds": [
              "EPH.5.20"
            ]
          }
        },
        {
