              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.5.5"
              },
              "items": [
                {
                  "text": "1 Vet 5.5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "mũkĩnyivanĩsya ene kwa ene nũndũ wa kũmũkĩa Klĩsto.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.21",
            "verseOrgIds": [
              "EPH.5.21"
            ]
          }
        }
