            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ nĩmwĩsĩ ũũ vyũ, atĩ kĩlaalai, kana mũndũ mũvuku, kana mũndũ wĩ na wendi, nake ni mũthaithi wa mĩvw’anano, asu mati na ũtiĩwa o na wiva ũsumbĩnĩ wa Klĩsto na Ngai. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.5",
            "verseOrgIds": [
              "EPH.5.5"
            ]
          }
        },
