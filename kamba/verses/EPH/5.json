              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.23.31"
              },
              "items": [
                {
                  "text": "Nth 23.31",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.21.34"
              },
              "items": [
                {
                  "text": "Lk 21.34",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mũikatoonw’e nĩ mbinyu, nayo ĩ mĩkwa mĩthũku, ĩndĩ usũwai nĩ Veva; ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.18",
            "verseOrgIds": [
              "EPH.5.18"
            ]
          }
        },
        {
