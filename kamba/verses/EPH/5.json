              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "na mũkĩendaa nthinĩ wa wendo, o ũndũ Klĩsto nake wamwendie inyw’ĩ, na eeyumya mwene kwondũ witũ, mũthĩnzĩo na nthembo kwa Ngai, yi na mũuke mũseo.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.2",
            "verseOrgIds": [
              "EPH.5.2"
            ]
          }
        }
      ]
