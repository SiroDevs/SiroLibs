            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ maũndũ onthe makanw’a nĩmonananw’a nĩ kyeni: nũndũ kĩla ũndũ wonanĩtw’e no kyeni. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.13",
            "verseOrgIds": [
              "EPH.5.13"
            ]
          }
        },
