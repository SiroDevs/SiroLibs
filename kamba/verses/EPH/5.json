                  "text": "Ako 3.16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.33.2"
              },
              "items": [
                {
                  "text": "Sav 33.2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.33.3"
              },
              "items": [
                {
                  "text": "3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "mũkĩneena ene kwa ene na savuli na mbathi sya kũmũkumya Ngai na mbathi sya veva, mũkĩmwinĩa Mwĩaĩi na kũmũtaia ngoonĩ syenyu; ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.19",
            "verseOrgIds": [
              "EPH.5.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EPH 5:20"
          },
          "items": [
