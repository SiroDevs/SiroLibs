                "loc": "JHN.16.8"
              },
              "items": [
                {
                  "text": "Yoa 16.8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "na mũikethĩwe na mũamba na mawĩa ma kĩvindu mate na ũsyao, ĩndĩ kavaa nĩ kũmakan’ya; ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.11",
            "verseOrgIds": [
              "EPH.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EPH 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.1.24"
              },
              "items": [
                {
                  "text": "Alo 1.24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "nũndũ maũndũ ala mekawa nĩmo kĩmbithĩ nĩ nthoni o na kũmaweta. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.12",
            "verseOrgIds": [
              "EPH.5.12"
            ]
          }
        },
        {
