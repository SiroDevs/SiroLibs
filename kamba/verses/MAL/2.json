            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mweethĩwa mũtikwĩw’a, na mweethĩwa mũtikwĩkĩa ũu ngoonĩ, mũnengae syĩtwa yakwa ndaĩa, nĩvo ĩndĩ nĩmũetee kĩumo, na ngamaumanĩa moathimo menyu, easya ũu Yeova wa nguthu; ĩĩ, nĩnĩminĩte kũmaumanĩa, nĩkwĩthĩwa mũtiwĩkĩaa ngoonĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.2",
            "verseOrgIds": [
              "MAL.2.2"
            ]
          }
        },
