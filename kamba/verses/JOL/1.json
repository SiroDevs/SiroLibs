            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.5",
            "verseOrgIds": [
              "JOL.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOL 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ mbaĩ nĩyambatĩĩa nthĩ yakwa, yĩ vinya, na ĩtatalĩka; maeo mayo nĩ maeo ma mũnyambũ, na yĩ na mbosela sya mũnyambũ mũka. ",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.6",
            "verseOrgIds": [
              "JOL.1.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
