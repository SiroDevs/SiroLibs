          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩa ta mwĩĩtu mũtheu ũvotoetwe makunia nũndũ wa mũũme wamwĩvaĩtye. ",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.8",
            "verseOrgIds": [
              "JOL.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOL 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nthembo ya mũtu na nthembo ya kũnyuwa nivetetwe nyũmbanĩ ya Yeova; athembi, athũkũmi ma Yeova, nĩmeũmeta. ",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.9",
            "verseOrgIds": [
              "JOL.1.9"
            ]
          }
        },
        {
