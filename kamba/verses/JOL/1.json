            "number": "7",
            "style": "v",
            "sid": "JOL 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩyanangĩte mũsavivũ wakwa, na yasyũlya mũkũyũ wakwa: yũsyũlĩtye ũkathea kw’ũ, na kũwĩkya kũasa; mbonge syaw’o syeeũva.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.7",
            "verseOrgIds": [
              "JOL.1.7"
            ]
          }
        }
      ]
