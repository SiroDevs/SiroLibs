            "number": "2",
            "style": "v",
            "sid": "JOL 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩw’ai ũũ, inyw’ĩ atumĩa, na teai kũtũ, inyw’onthe ala mũtwĩe ĩ nthĩ. Ũũ waaĩthĩwa mĩthenyanĩ yenyu, kana mĩthenyanĩ ya aaĩthe menyu? ",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.2",
            "verseOrgIds": [
              "JOL.1.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
