            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.3",
            "verseOrgIds": [
              "JOL.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOL 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyu kĩla kyatialilw’e nĩ kĩtĩlĩ nĩkyalĩkile nĩ ngie; na kyu kĩla kyatialilw’e nĩ ngie nĩkyalĩkile nĩ mbandi; na kyu kĩla kyatialilw’e nĩ mbandi nĩkyalĩkile nĩ kĩthesa. ",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.4",
            "verseOrgIds": [
              "JOL.1.4"
            ]
          }
        },
