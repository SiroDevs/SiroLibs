          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amũkai, inyw’ĩ athengi, na ĩai; na kayai, inyw’onthe anywi ma mbinyu, kwondũ wa mbinyu ĩ mũyo; nũndũ nĩvetetwe makanyw’anĩ menyu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.5",
            "verseOrgIds": [
              "JOL.1.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
