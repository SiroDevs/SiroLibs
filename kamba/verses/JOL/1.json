          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "A! Ũndũ nyamũ iũluma! Ndĩthya sya ng’ombe nisaanĩw’e, nĩkwĩthĩwa iti na ũĩthyo; ĩĩ, ndĩthya sya malondu nĩ nthĩnu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.18",
            "verseOrgIds": [
