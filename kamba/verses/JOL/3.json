          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "nĩngomban’ya mbaĩ syonthe, na ngaitheesya mwandanĩ wa Yeosavati; na ngaisilĩĩla o vo nũndũ wa andũ makwa na nũndũ wa ũtiĩwa wakwa Isilaeli, ala syanyaĩĩkisye katĩ wa mbaĩ i ingĩ: na syaaan’ya nthĩ yakwa, ",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.2",
            "verseOrgIds": [
              "JOL.3.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
