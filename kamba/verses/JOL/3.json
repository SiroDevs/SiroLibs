            "style": "v",
            "sid": "JOL 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "na syalimana nũndũ wa andũ makwa, na syakũan’ya kĩvĩsĩ na ĩlwaya, na kũthoosya mwĩĩtu nũndũ wa mbinyu, nĩ kana manyw’e. ",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.3",
            "verseOrgIds": [
              "JOL.3.3"
            ]
          }
        },
