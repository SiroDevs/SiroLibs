          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩkwĩthĩwa nĩmwosete vetha wakwa na thaavu wakwa, na mwatwaa makalũnĩ menyu syĩndũ syakwa nzeo syĩ vata mũno, ",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.5",
            "verseOrgIds": [
              "JOL.3.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
