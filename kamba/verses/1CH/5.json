              "items": [
                {
                  "text": "Mot 32.3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.32.38"
              },
              "items": [
                {
                  "text": "38",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.8",
            "verseOrgIds": [
              "1CH.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "na atũaa ngalĩ ya wumĩlonĩ wa syũa o kũvika vandũ va ũlikĩla weũnĩ kuma ũsĩnĩ wa Euvalati, nĩkwĩthĩwa indo syoo nĩsyaingĩvie nthĩ ya Ngileati. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.9",
            "verseOrgIds": [
              "1CH.5.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.22.9"
              },
              "items": [
                {
                  "text": "Yos 22.9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.9",
            "verseOrgIds": [
              "1CH.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mĩthenya ya Saulo, makwatya kaũ na Aakali, nao nĩmooaiwe na moko moo; na nimatũaa maeemanĩ moo nthĩ yonthe ngalĩ ya wumĩlonĩ wa syũa ya Ngileati.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.10",
            "verseOrgIds": [
              "1CH.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
