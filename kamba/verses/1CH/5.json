                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MIC.5.2"
              },
              "items": [
                {
                  "text": "Mika 5.2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.2",
            "verseOrgIds": [
              "1CH.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ana ma Leuveni ĩkithathi ya Isilaeli: Anoki, na Valu, na Esiloni, na Kalimi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.3",
            "verseOrgIds": [
              "1CH.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ana ma Yoeli: Semaia mwana wake, na Ngoki mwana wake, na Simei mwana wake, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.4",
            "verseOrgIds": [
              "1CH.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Mika mwana wake, na Leaia mwana wake, na Mbaali mwana wake, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.5",
            "verseOrgIds": [
              "1CH.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Mbeela mwana wake, ũla Tilikathivilineseli mũsumbi wa Asuli wamũtwaie e mũtave: nake aĩ mũnene wa Aleuveni. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.6",
            "verseOrgIds": [
              "1CH.5.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.15.29"
              },
              "items": [
                {
                  "text": "2 Asu 15.29",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.28.20"
              },
              "items": [
                {
                  "text": "2 Mav 28.20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.6",
            "verseOrgIds": [
              "1CH.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ana‐a‐ĩthe make kũatĩĩa mĩvĩa yoo, yĩla mosyaanĩo ma nzyawa syoo matalilwe: mũnene aĩ Yeieli Nzekalia, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.7",
            "verseOrgIds": [
              "1CH.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Mbela mwana wa Asasi, mwana wa Sema, mwana wa Yoeli, ũla watwĩe Aloeli, o kũvika Nevo na Mbaali‐meoni: ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.8",
            "verseOrgIds": [
              "1CH.5.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
