          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ Yuta nĩwakĩlilye ana‐a‐ĩthe vinya, na ũla mũnene wĩ mbee ũsumbĩnĩ aumie kwake; ĩndĩ ũkithathi waĩ wa Yosevu), ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.2",
            "verseOrgIds": [
              "1CH.5.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
