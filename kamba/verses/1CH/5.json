              "1CH.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ana ma Ngati nĩmatũaa mamelekele, nthĩ ya Mbasani kũvika Saleka: ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.11",
            "verseOrgIds": [
              "1CH.5.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.32.33"
              },
              "items": [
                {
                  "text": "Mot 32.33",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.12.5"
              },
              "items": [
                {
                  "text": "Yos 12.5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.13.11"
              },
              "items": [
                {
                  "text": "13.11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.11",
            "verseOrgIds": [
              "1CH.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "mũnene Yoeli, na wa kelĩ Savamu, na Yanai, na Savati ku Mbasani. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.12",
            "verseOrgIds": [
              "1CH.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ana‐a‐ĩthe moo ma nyũmba sya aaĩthe moo: nĩ Mikaeli, na Mesulamu, na Sieva, na Yolai, na Yakani, na Nzia, na Eeveli, asu mũonza. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.13",
            "verseOrgIds": [
              "1CH.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asu nĩ ana ma Aviaili, mwana wa Uuli, mwana wa Yaloa, mwana wa Ngileati, mwana wa Mikaeli, mwana wa Yeisai, mwana wa Yato, mwana wa Mbusi; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.14",
            "verseOrgIds": [
              "1CH.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aai mwana wa Avitieli, mwana wa Nguni, mũnene wa nyũmba sya aaĩthe moo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.15",
            "verseOrgIds": [
              "1CH.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na nĩmatũaa Ngileati ku Mbasani, na tũtũla twayo, na syengonĩ syonthe sya Saloni, kũvika mĩvaka yoo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.16",
            "verseOrgIds": [
              "1CH.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asu onthe matalawa kũatĩĩa mosyaanĩo mĩthenya ya Yothamu mũsumbĩ wa Yuta, na mĩthenya ya Yelovoamu mũsumbĩ wa Isilaeli. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.17",
            "verseOrgIds": [
              "1CH.5.17"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
