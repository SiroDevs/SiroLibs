            "verseOrgIds": [
              "1CH.22.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sisya, ũkasyaa mwana, ũla ũkethĩwa mũndũ wa ũthũmũo; na ngamũnenga kũthũmũa kuma amaithanĩ make onthe ala mamũthyũlũlũkĩte; nũndũ syĩtwa yake yĩkeethĩwa Solomoni, na nganenga Isilaeli mũuo na ũthũmũo mĩthenyanĩ yake. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.9",
            "verseOrgIds": [
              "1CH.22.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
