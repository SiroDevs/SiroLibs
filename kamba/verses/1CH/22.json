          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Ndaviti oomban’ya iaa mbingĩ mũno kwondũ wa mĩsumaa ya mĩomo ya i mbingĩlo, na kwondũ wa ikolethyo; na ũthuku mwingĩ mũno ũtathimĩka; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.3",
            "verseOrgIds": [
              "1CH.22.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
