          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ amwĩta Solomoni mwana wake, na amwĩaĩa akĩe Yeova, Ngai wa Isilaeli, nyũmba. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.6",
            "verseOrgIds": [
              "1CH.22.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Ndaviti amwĩa Solomoni mwana wake, Ngalĩ ĩ yakwa, nasũanĩaa ngoonĩ yakwa kwaka nyũmba kwondũ wa syĩtwa ya Yeova Ngai wakwa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.7",
            "verseOrgIds": [
              "1CH.22.7"
            ]
          }
        },
        {
