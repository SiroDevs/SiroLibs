          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwondũ wa kwĩthĩwa mũtyaayĩkua mbee, Yeova Ngai waitũ nĩwatũkũnie ĩkũna, nũndũ tũtyaamũmantha kwĩanana na ũtw’ĩo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.13",
            "verseOrgIds": [
              "1CH.15.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
