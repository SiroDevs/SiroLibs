          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Ndaviti oomban’ya Isilaeli onthe ku Yelusaleme, nĩ kana maete ĩsandũkũ ya Yeova vandũ vayo, vala waseũvĩtye kwondũ wayo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.3",
            "verseOrgIds": [
              "1CH.15.3"
            ]
          }
        },
        {
