            "number": "25",
            "style": "v",
            "sid": "1CH 15:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ Ndaviti, na atumĩa ma Isilaeli, na makavuteni ma ngili ngili, maenda mambatye ĩsandũkũ ya ũtianĩo ya Yeova kũyumya nyũmbanĩ ya Oveti‐etomu me na ũtanu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.25",
            "verseOrgIds": [
              "1CH.15.25"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
