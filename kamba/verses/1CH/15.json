                "loc": "2SA.6.12+2SA.6.13+2SA.6.14+2SA.6.15"
              },
              "items": [
                {
                  "text": "2 Sam 6.12–15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.25",
            "verseOrgIds": [
              "1CH.15.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CH 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kweethĩwa, yĩla Ngai watethisye Alivai ala makuĩte ĩsandũkũ ya ũtianĩo ya Yeova, mathemba tũsalũ twa mũew’a mũonza na ndũũme mũonza. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.26",
            "verseOrgIds": [
              "1CH.15.26"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.23.1"
              },
              "items": [
                {
                  "text": "Mot 23.1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.42.8"
              },
              "items": [
                {
                  "text": "Yovu 42.8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.26",
            "verseOrgIds": [
              "1CH.15.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 15:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Ndaviti nake eekĩĩte ngũa ndasa ya katane nzeo, na Alivai onthe ala makuĩte yĩla ĩsandũkũ, na aini, na Kenania mũnene wa wini vamwe na aini: na Ndaviti eekĩĩte evoti ya katane. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.27",
            "verseOrgIds": [
              "1CH.15.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 15:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ũu nĩw’o Isilaeli onthe maetie ĩsandũkũ ya ũtianĩo ya Yeova makyũkĩlya mawasya manene, vamwe na wasya wa soo mũkelemu, na masoo, na tũmasaya, ikĩamba mũno vamwe na inanda na mbeve. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.28",
            "verseOrgIds": [
              "1CH.15.28"
            ]
          }
        },
