        },
        {
          "text": "Na Ndaviti eeyakĩa nyũmba ndũanĩ ya Ndaviti; na aseũvya vandũ va ĩsandũkũ ya Ngai, na ayambĩa ĩeema. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.1",
            "verseOrgIds": [
              "1CH.15.1"
            ]
          }
        },
