          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwondũ wa ũu Alivai maia Emani mwana wa Yoeli; na ma ana‐a‐ĩthe make, Asavu mwana wa Mbelekia; na ma ana ma Melali ana‐a‐ĩthe moo. Ethani mwana wa Kusaia; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.17",
            "verseOrgIds": [
              "1CH.15.17"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
