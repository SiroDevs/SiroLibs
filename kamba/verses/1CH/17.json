                "loc": "HEB.1.5"
              },
              "items": [
                {
                  "text": "Aevl 1.5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.13",
            "verseOrgIds": [
              "1CH.17.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "ĩndĩ ngamũlũmya nyũmbanĩ yakwa na ũsumbĩnĩ wakwa tene na tene; na kĩvĩla kyake kya ũsumbĩ kĩkalũlũmĩlw’a tene na tene. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.14",
            "verseOrgIds": [
              "1CH.17.14"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.28.7"
              },
              "items": [
                {
                  "text": "1 Mav 28.7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.1.33"
              },
              "items": [
                {
                  "text": "Lk 1.33",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.14",
            "verseOrgIds": [
              "1CH.17.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwĩanana na ndeto ii syonthe, na kwĩanana na woni ũũ w’onthe, now’o Nathani wamũtavisye Ndaviti.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.15",
            "verseOrgIds": [
              "1CH.17.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.15",
            "verseOrgIds": [
              "1CH.17.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ mũsumbĩ Ndaviti alika nthĩnĩ, na ekala mbee wa Yeova; na akũlya, Nyie nĩ ũũ, ame Yeova Ngai, na nyũmba yakwa nĩ kyaũ, ũndũ ũmbikĩtye ta vaa nĩĩ? ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.16",
            "verseOrgIds": [
              "1CH.17.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 17:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ũndũ ũsu no ũnini methonĩ maku, ame Ngai; ĩndĩ nũneenete ũvoo wa nyũmba ya mũthũkũmi waku kũvika ĩvinda yĩ vaasa mũno yĩla yĩkoka, na wanzisya ta nĩ mũndũ wĩ kĩlionĩ kĩnene, ame Yeova Ngai. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.17",
            "verseOrgIds": [
              "1CH.17.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndaviti atonya ũkũtavya ũndũ ũngĩ mwaũ mbee wa ũu ũndũ wa ũtaĩo ũla weekiwe mũthũkũmi waku? Nũndũ nĩwĩsĩ mũthũkũmi waku. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.18",
            "verseOrgIds": [
              "1CH.17.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 17:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ame Yeova, kwondũ wa mũthũkũmi waku, na kwĩanana na ngoo yaku mwene, nĩwĩkĩte ũnene ũu w’onthe, ũmanyĩthan’ye maũndũ aa onthe manene. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.19",
            "verseOrgIds": [
              "1CH.17.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 17:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ame Yeova, vati ũngĩ ũilyĩ taku, o na vati Ngai ũngĩ ate o we, kwĩanana na w’onthe ũla twĩw’ĩte na matũ maitũ. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.20",
            "verseOrgIds": [
              "1CH.17.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 17:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na nĩ yĩva mbaĩ ĩmwe kũũ nthĩ ĩilyĩ ta andũ maku Isilaeli, ala Ngai waendie kwĩyovoesya mwene methĩwe ũko wa andũ, wĩyonee syĩtwa nũndũ wa maũndũ manene na ma kũtĩsya, ũkĩlũngya mbaĩ syume mbee wa andũ maku, ala wamovoisye kũmaumya Misili? ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.21",
            "verseOrgIds": [
              "1CH.17.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 17:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ andũ maku Isilaeli nĩwamatw’ĩkĩthisye andũ maku mwene tene na tene; naku, Yeova, watw’ĩka Ngai woo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.22",
            "verseOrgIds": [
              "1CH.17.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 17:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na yu, ame Yeova, ndeto ĩla ũneenete ũndũ wa mũthũkũmi waku, na ũndũ wa nyũmba yake, nĩlũlũmĩlw’e tene na tene, na ũkĩka o tondũ ũneenete. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.23",
            "verseOrgIds": [
              "1CH.17.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 17:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na syĩtwa yaku nĩyĩlũlũmĩlw’e na kũnenevw’a tene na tene, kũkyaw’a, Yeova wa nguthu nĩ Ngai wa Isilaeli, o Ngai kwa Isilaeli: na nyũmba ya Ndaviti mũthũkũmi waku nĩlũlũmĩlĩtw’e mbee waku. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.24",
            "verseOrgIds": [
              "1CH.17.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 17:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ we, ame Ngai wakwa, nũmũvuanĩsye mũthũkũmi waku atĩ ũkamwakĩa nyũmba: kwondũ wa ũu mũthũkũmi waku nĩwonete ngoonĩ yake kũvoyea mbee waku. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.25",
            "verseOrgIds": [
              "1CH.17.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CH 17:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na yu, ame Yeova, nue Ngai, na nũmwathĩte mũthũkũmi waku ũndũ ũũ ũseo: ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.26",
            "verseOrgIds": [
              "1CH.17.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 17:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "na yu nũkwendeew’a nĩ kũathima nyũmba ya mũthũkũmi waku, nĩ kana yĩkalae tene na tene ĩ mbee waku: nũndũ we, ame Yeova, nũathimĩte, na nĩathimĩkĩte tene na tene. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.27",
            "verseOrgIds": [
              "1CH.17.27"
            ]
          }
        },
