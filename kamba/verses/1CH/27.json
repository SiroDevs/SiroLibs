            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.3",
            "verseOrgIds": [
              "1CH.27.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 27:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kavuteni wa nguthu ya mwei wa kelĩ aĩ Ndotai Mũaoi, na nguthu yake; na Mikilothi mũsumbĩki; na nguthunĩ yake kwaĩ ngili mĩongo ĩlĩ na inya. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.4",
            "verseOrgIds": [
              "1CH.27.4"
            ]
          }
        },
