            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kavuteni wa katatũ wa nguthu ya mwei wa katatũ aĩ Mbenaia, mwana wa mũthembi Yeoiata, mũnene: na nguthunĩ yake kwaĩ ngili mĩongo ĩlĩ na inya. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.5",
            "verseOrgIds": [
              "1CH.27.5"
            ]
          }
        },
