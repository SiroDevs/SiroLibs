              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.24",
            "verseOrgIds": [
              "1CH.27.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 27:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Asemavethi mwana wa Atieli aĩ mũsũvĩi wa mothwii maie ma mũsumbĩ: na Yonathani mwana wa Usia aĩ mũsũvĩi wa mothwii maie mĩũndanĩ, na ndũanĩ, na mĩsyĩ, na nyũmbanĩ nene syĩ iemo: ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.25",
            "verseOrgIds": [
              "1CH.27.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CH 27:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Esili mwana wa Keluvu aĩ mũsyaĩĩsya wa ala matethasya wĩa wa kũĩma mũũndanĩ: ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.26",
            "verseOrgIds": [
              "1CH.27.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 27:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Simei Mũlamathi aĩ mũsyaĩĩsya wa mĩũnda ya mĩsavivũ: na Nzaveti Mũsivimi aĩ mũsyaĩĩsya wa wingĩ wa ũsyao wa mĩũnda ya mĩsavivũ akĩkĩaa matungulunĩ ma kwia mbinyu: ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.27",
            "verseOrgIds": [
              "1CH.27.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 27:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Mbaali‐aanani Mũngeteli aĩ mũsyaĩĩsya wa mĩthata na mĩkũyũ ĩla yaĩ nthĩ ndindimalu: na Yoasi aĩ mũsyaĩĩsya wa matungulu ma kwia mauta: ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.28",
            "verseOrgIds": [
              "1CH.27.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CH 27:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Sitilai Mũsaloni aĩ mũsyaĩĩsya wa ndĩthya sya ng’ombe ila syaĩthaw’a ku Saloni: na Savati mwana wa Atilai aĩ mũsyaĩĩsya wa ndĩthya sya ng’ombe ila syaĩ myandanĩ: ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.29",
            "verseOrgIds": [
              "1CH.27.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CH 27:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Ovili Mũisumaeli aĩ mũsyaĩĩsya wa ngamĩle: na Yeteia Mũmelonothi aĩ mũsyaĩĩsya wa mang’oi: na Yasisi Mũakali aĩ mũsyaĩĩsya wa ndĩthya sya mbũi na malondu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.30",
            "verseOrgIds": [
              "1CH.27.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CH 27:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asu onthe maĩ asyaĩĩsya ma syĩndũ sya mũsumbĩ Ndaviti.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.31",
            "verseOrgIds": [
              "1CH.27.31"
            ]
          }
        }
      ]
    },
