              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ma ana ma Isakali: Tola, na Vua na Yasuvu, na Similoni, ana, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.1",
            "verseOrgIds": [
