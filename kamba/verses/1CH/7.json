              "items": [
                {
                  "text": "Yos 17.1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.14",
            "verseOrgIds": [
              "1CH.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Makili atwaa mũka kuma kwa a Uvimu na Suvimu, na mwĩĩtu‐a‐inyia woo eetawa Maaka; na syĩtwa ya ũla wa kelĩ eetwa Nzeloveati: na Nzeloveati aĩ na eĩtu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.15",
            "verseOrgIds": [
              "1CH.7.15"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
