          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ana ma Manase: Asilieli, ũla mũka wake ngombo Mũalamu wasyaie; nake asyaa Makili ĩthe wa Ngileati. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.14",
            "verseOrgIds": [
              "1CH.7.14"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
