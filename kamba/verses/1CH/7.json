            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.6",
            "verseOrgIds": [
              "1CH.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ana ma Mbela: Esevoni, na Usisi, na Usieli, na Yelimothi, na Ili, atano; atongoi ma nyũmba sya aaĩthe, ngũmbaũ nene; na matalwa ũtalonĩ wa nzyawa ngili mĩongo ĩlĩ na ilĩ na mĩongo ĩtatũ na ana. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.7",
            "verseOrgIds": [
              "1CH.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ana ma Mbekeli: Nzemila, na Yoasi, na Elieseli, na Elioenai, na Omili, na Yelemothi, na Aviya, na Anathothi, na Alemethi. Asu onthe nĩ ana ma Mbekeli. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.8",
            "verseOrgIds": [
              "1CH.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na matalwa ũtalonĩ wa nzyawa, kũatĩĩa nzyawa syoo, atongoi ma nyũmba sya aaĩthe moo, ngũmbaũ nene, ngili mĩongo ĩlĩ na maana elĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.9",
            "verseOrgIds": [
              "1CH.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ana ma Yetiaeli: Mbiliani. Na ana ma Mbiliani: Yeusu, na Mbenyamini, na Euti, na Kanaana, na Nzethani, na Talisisi, na Aisaali. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.10",
            "verseOrgIds": [
              "1CH.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asu onthe nĩ ana ma Yetiaeli, kwĩanana na atongoi ma nyũmba sya aaĩthe moo, ngũmbaũ nene, ngili ĩkũmi na mũonza na maana elĩ, ala maĩ matonya kũthi nguthunĩ ya kaũ ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.11",
            "verseOrgIds": [
              "1CH.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "O na Suvimu, na Uvimu, ana ma Ili, na Usimu, ana ma Aeli.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.12",
            "verseOrgIds": [
              "1CH.7.12"
            ]
          }
        }
      ]
    },
