            "number": "2",
            "style": "v",
            "sid": "1CH 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ana ma Tola: Usisi, na Levaia, na Yelieli, na Yamai, na Ivisamu, na Semueli, atongoi ma nyũmba sya aaĩthe moo, ma Tola; ngũmbaũ nene nzyawanĩ syoo: ũtalo woo mĩthenya ya Ndaviti waĩ ngili mĩongo ĩlĩ na ĩlĩ na maana thanthatũ. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.2",
            "verseOrgIds": [
              "1CH.7.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
