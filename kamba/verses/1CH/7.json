                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.24.2"
              },
              "items": [
                {
                  "text": "2",
                  "type": "text"
