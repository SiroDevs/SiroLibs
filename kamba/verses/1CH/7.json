            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ana ma Semita nĩ Aiani, na Sekemu, na Liki, na Aniamu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.19",
            "verseOrgIds": [
