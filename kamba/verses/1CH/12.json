            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.15",
            "verseOrgIds": [
              "1CH.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kwooka ngomenĩ yĩ vinya vala ve Ndaviti amwe ma ana ma Mbenyamini na Yuta. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.16",
            "verseOrgIds": [
              "1CH.12.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Ndaviti aumaala akomane nao, na amasũngĩa, amea, Ethĩwa mũkĩte kwakwa na mũuo mũndethye, ngoo yakwa ĩkalũman’ya nenyu; ĩndĩ ethĩwa nĩmũkĩte mũmbũnyanĩe kwa amaitha makwa, nũndũ kũti ĩvĩtyo mokonĩ makwa, Ngai wa aaĩthe maitũ nasisye ũndũ ũsu, na ookan’ye. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.17",
            "verseOrgIds": [
              "1CH.12.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 12:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩvo ĩndĩ Veva amũvw’ĩkie Amasai, ũla waĩ mũnene wa ala mĩongo ĩtatũ, na asya, Ithyĩ twĩ maku, Ndaviti, na twĩ ngalĩ yaku, we mwana wa Yese: mũuo, mũuo wĩthĩwe kwaku, na mũuo wĩthĩwe kwa atethya maku; nũndũ Ngai waku nũkũtethasya. Na ĩndĩ Ndaviti amosa, na amatw’ĩkĩthya makavuteni ma ĩla nguthu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.18",
            "verseOrgIds": [
              "1CH.12.18"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
