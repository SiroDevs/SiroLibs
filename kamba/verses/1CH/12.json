                "loc": "JOS.3.15"
              },
              "items": [
                {
                  "text": "Yos 3.15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
