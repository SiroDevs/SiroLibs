          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "na ndaakũlya Yeova: kwondũ wa ũu amũaa, na aalyũla ũsumbĩ wĩthĩwe wa Ndaviti mwana wa Yese. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.14",
