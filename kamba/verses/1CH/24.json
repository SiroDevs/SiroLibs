            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.20",
            "verseOrgIds": [
              "1CH.24.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 24:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Leavia: ma ana ma Leavia, mũnene Isia. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.21",
            "verseOrgIds": [
              "1CH.24.21"
            ]
          }
        },
        {
