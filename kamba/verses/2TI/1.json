          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vaulo, mũtũmwa wa Klĩsto Yesũ kwondũ wa kwenda kwa Ngai, kwĩanana na watho wa thayũ ũla wĩ nthĩnĩ wa Klĩsto Yesũ, ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.1",
            "verseOrgIds": [
              "2TI.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2TI 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "valũa ũũ wakwa ũmũvikĩe Timotheo, mwana wakwa mwendwa: Mumo, na tei, na mũuo, kuma kwa Ngai Asa na Klĩsto Yesũ Mwĩaĩi waitũ.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.2",
            "verseOrgIds": [
              "2TI.1.2"
            ]
          }
        }
      ]
    },
    {
