                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ andũnĩ asu ve ala melikasya nyũmbanĩ sya andũ na kũtava aka atumanu ala makuaa mũio ya naĩ, matongoew’e nĩ mĩmeo ya mĩthemba mingĩ, ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.6",
            "verseOrgIds": [
              "2TI.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2TI 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
