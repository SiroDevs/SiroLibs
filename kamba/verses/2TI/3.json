                "loc": "2TI.2.25"
              },
              "items": [
                {
                  "text": "2 Tim 2.25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "memanyĩasya mĩthenya yonthe, na maitonya o na ĩndĩĩ kũvikĩa ũmanyi wa ũla w’o. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.7",
            "verseOrgIds": [
              "2TI.3.7"
            ]
          }
        },
