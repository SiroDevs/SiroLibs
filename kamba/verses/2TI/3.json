            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "me na mũvw’ano wa kĩkĩo kwa Ngai, ĩndĩ nĩmakaĩĩte vinya wakyo: ĩvathane na asu nao. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.5",
            "verseOrgIds": [
              "2TI.3.5"
            ]
          }
        },
        {
