              "2SA.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Ndaviti atũma atũmwa, mamũlatye; nake ooka kwake, na akoma nake (nũndũ nĩwatheetw’e ũvuku wake); na asyoka nyũmbanĩ yake. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.4",
            "verseOrgIds": [
              "2SA.11.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
