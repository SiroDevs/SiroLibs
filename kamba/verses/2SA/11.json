        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mũndũ mũka aitava; na atũmana na amũtavya Ndaviti, na asya, Nĩ ĩvu.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.5",
            "verseOrgIds": [
              "2SA.11.5"
            ]
          }
        }
      ]
