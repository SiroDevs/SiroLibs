        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2SA 11:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na yĩla kĩveti kya Ulia kyeewie Ulia mũũme wakyo nũkwie, kyamũĩĩa mũũme. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.26",
            "verseOrgIds": [
              "2SA.11.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2SA 11:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na yĩla kũmeta kwathelile, Ndaviti atũmana na kyaetwe nyũmbanĩ yake, na kyatw’ĩka kĩveti kyake, na kyamũsyaĩa mwana. Ĩndĩ ũndũ ũsu ũla Ndaviti wekie nĩwamwĩw’ĩthisye Yeova woo.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.27",
            "verseOrgIds": [
              "2SA.11.27"
            ]
          }
        }
      ]
