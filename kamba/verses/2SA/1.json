            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.11",
            "verseOrgIds": [
              "2SA.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "na mameta, na kũĩa, na kũtĩĩa ũya kũvika wĩoo, kwondũ wa Saulo, na kwondũ wa Yonathani mwana wake, na kwondũ wa andũ ma Yeova, na kwondũ wa nyũmba ya Isilaeli; nũndũ nĩmavalũkilw’e na ũvyũ. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.12",
            "verseOrgIds": [
              "2SA.1.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.31.13"
              },
              "items": [
                {
                  "text": "1 Sam 31.13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.3.35"
              },
              "items": [
                {
                  "text": "2 Sam 3.35",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.12",
            "verseOrgIds": [
              "2SA.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Ndaviti amũkũlya mwanake ũla wamũtavisye, Wĩ wa va? Na amũsũngĩa, Nĩ mwana wa mwĩkali wa ũenini, Mũamaleki. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.13",
            "verseOrgIds": [
              "2SA.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Ndaviti amũkũlya, Nũndũ wa ki ndwaakĩa kũtambũũkya kw’oko kwaku wanange mwĩtĩkĩw’a mauta wa Yeova? ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.14",
            "verseOrgIds": [
              "2SA.1.14"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
