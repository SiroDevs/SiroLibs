              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kweethĩwa ĩtina wa kĩkw’ũ kya Saulo, yĩla Ndaviti waĩ anasyoka kuma kũmoaa Aamaleki, na Ndaviti aĩ anekala mĩthenya ĩlĩ Nzikilaki; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.1",
            "verseOrgIds": [
              "2SA.1.1"
            ]
          }
        },
        {
