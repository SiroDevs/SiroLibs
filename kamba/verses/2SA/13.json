              "items": [
                {
                  "text": "2 Sam 12.16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.31",
            "verseOrgIds": [
              "2SA.13.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2SA 13:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yonatavu, mwana wa Simea, mwana‐a‐inyia wa Ndaviti, asũngĩa na amwĩa, Mwĩaĩĩ wakwa ndakasũanĩe kana nĩmoaĩte anake onthe ana ma mũsumbĩ; nũndũ no Aminoni wũaiwe: nĩkwĩthĩwa ũndũ wa ũtw’ĩo wa Avisalomu ũndũ ũũ nĩwatwiwe kuma mũthenya ũla wakindie mwĩĩtu‐a‐inyia wake Tamali. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.32",
            "verseOrgIds": [
              "2SA.13.32"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
