              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ Avisalomu akĩa, na athi kwa Talimai mwana wa Amiuli mũsumbĩ wa Ngesuli. Na Ndaviti ametea mwana wake kĩla mũthenya. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.37",
            "verseOrgIds": [
              "2SA.13.37"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
