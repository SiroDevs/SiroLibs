                  "text": "Mwa 37.3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.18",
            "verseOrgIds": [
              "2SA.13.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Tamali eekĩa mũu mũtwe wake, na atembũanga ngũa yake yĩ langi wa mĩthemba mingĩ, ĩla wekĩĩte; na ailĩĩla kw’oko kwake mũtwe kwake, na eeendea, akĩĩa na wasya aendete. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.19",
            "verseOrgIds": [
              "2SA.13.19"
            ]
          }
        },
