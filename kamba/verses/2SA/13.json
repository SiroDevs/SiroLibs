              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kweethĩwa ĩtina wa ũu, Avisalomu mwana wa Ndaviti aĩ na mwĩĩtu‐a‐inyia mwanake, ũla wetawa syĩtwa yake Tamali; na Aminoni mwana wa Ndaviti amwenda. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.1",
            "verseOrgIds": [
              "2SA.13.1"
            ]
          }
        },
