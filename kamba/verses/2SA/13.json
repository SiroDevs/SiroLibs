            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.12",
            "verseOrgIds": [
              "2SA.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakwa, ngaenda na nthoni syakwa nakũ? Naku ngalĩ ĩ yaku, ũkeethĩwa ta ũmwe wa ndia sya Isilaeli. Kwondũ wa ũu nĩngũkwĩsũva, neena na mũsumbĩ; nũndũ ndakakũvata ũindwaa. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.13",
            "verseOrgIds": [
              "2SA.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ ndaaĩtĩkĩla kwĩthukĩĩsya wasya wake; ĩndĩ nũndũ aĩ vinya kwĩ we, amũkĩlya vinya na amũkinda.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.14",
            "verseOrgIds": [
              "2SA.13.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
