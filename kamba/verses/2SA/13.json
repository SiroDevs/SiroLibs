          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ Avisalomu akĩa na athi Ngesuli, na ekala kw’o myaka ĩtatũ. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.38",
            "verseOrgIds": [
              "2SA.13.38"
            ]
          }
