        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Avisalomu mwana‐a‐inyia amũkũlya, Aminoni mwana‐a‐asa waku eĩ naku? Yu ĩndĩ vindya mwĩĩtu‐a‐ia: we nĩ mwana‐a‐au; ndũkaie ũndũ ũũ ngoonĩ. Kwondũ wa ũu Tamali ekala nyũmbanĩ ya mwana‐a‐inyia Avisalomu e na ĩvou. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.20",
            "verseOrgIds": [
              "2SA.13.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ yĩla mũsumbĩ Ndaviti wewie maũndũ asu onthe, athilĩka mũno. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.21",
            "verseOrgIds": [
              "2SA.13.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 13:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Avisalomu ndaaneena na Aminoni ũseo kana ũthũku; nũndũ Avisalomu nĩwamenie Aminoni, nĩkwĩthĩwa nĩwakindie mwĩĩtu‐a‐inyia Tamali.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.22",
            "verseOrgIds": [
              "2SA.13.22"
            ]
          }
        }
      ]
    },
