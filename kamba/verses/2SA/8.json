                {
                  "text": "Mot 34.8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.9",
            "verseOrgIds": [
              "2SA.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "nĩvo ĩndĩ Toi watũmie Yolamu mwana wake kwa mũsumbĩ Ndaviti, akamũkethye, na kũmũathima, nĩkwĩthĩwa aĩ anokita na Atateseli na kũmũkũna: nũndũ Atateseli eethĩawa na makaũ na Toi. Na Yolamu atwaa mĩio ya vetha, na mĩio ya thaavu, na mĩio ya ũthuku: ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.10",
            "verseOrgIds": [
              "2SA.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "na ĩsu nayo mũsumbĩ Ndaviti amĩvathie yĩthĩwe mĩtheu kwa Yeova, vamwe na vetha na thaavu ila wavathie syĩthĩwe ntheu, ila sya mbaĩ syonthe ila waikĩlĩtye vinya; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.11",
            "verseOrgIds": [
              "2SA.8.11"
            ]
          }
        },
        {
