          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na akũna Moavi, na amathima na ũlii wa kũthima, amakomethetye nthĩ; na athima na ũlii mĩta ĩlĩ ya kũawa, na mwĩta ũmwe wa ũlii wa kũekwa wĩ thayũ. Na Amoavi matw’ĩke athũkũmi ma Ndaviti, na kumasya koti.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.2",
            "verseOrgIds": [
              "2SA.8.2"
            ]
          }
        }
      ]
    },
