            "sid": "2SA 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na yĩla Toi mũsumbĩ wa Amathi wewie kana Ndaviti nũkũnĩte nguthu yonthe ya Atateseli, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.9",
            "verseOrgIds": [
              "2SA.8.9"
            ]
          }
        },
        {
