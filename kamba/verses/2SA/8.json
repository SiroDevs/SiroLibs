          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "O na Ndaviti amũkũna Atateseli mwana wa Leovu, mũsumbĩ wa Sova, aendete kũtũnga ũsumbĩko wake ĩngĩ ũla waĩ ũla Ũsĩnĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.3",
            "verseOrgIds": [
              "2SA.8.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
