              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ nĩweekie ũu kĩmbĩthĩ: ĩndĩ nyie ngeeka ũndũ ũũ Isilaeli onthe mene, o na syũa. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.12",
            "verseOrgIds": [
              "2SA.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Ndaviti amwĩa Nathani, Nĩnĩmũvĩtanĩsye Yeova. Na Nathani amwĩa Ndaviti, O na Yeova nũvetete naĩ yaku; ndũkakw’a. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.13",
            "verseOrgIds": [
              "2SA.12.13"
            ]
          }
        },
