                "loc": "1CH.22.9"
              },
              "items": [
                {
                  "text": "1 Mav 22.9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.1.6"
              },
              "items": [
                {
                  "text": "Mt 1.6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.24",
            "verseOrgIds": [
              "2SA.12.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2SA 12:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "na atũmana na kw’oko kwa mwathani Nathani; nake amwĩta syĩtwa yake Yetitia, kwondũ wa Yeova.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.25",
            "verseOrgIds": [
              "2SA.12.25"
            ]
          }
        }
      ]
