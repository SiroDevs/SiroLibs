            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwondũ wa ũu ĩndĩ ũvyũ ndũkauma nyũmbanĩ yaku o na ĩndĩĩ, nũndũ nũmbũthĩtye, na nũtwaĩte kĩveti kya Ulia ũla Mũititi kĩthĩwe kĩveti kyaku. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.10",
            "verseOrgIds": [
              "2SA.12.10"
            ]
          }
        },
