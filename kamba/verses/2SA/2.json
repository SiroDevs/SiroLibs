              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kweethĩwa ĩtina wa ũu, Ndaviti akũlya Yeova, akyasya, Nambate ndũanĩ o na yĩva ya Yuta? Na Yeova amwĩa, Ambata. Na Ndaviti akũlya, Nambate va? Na asũngĩa, Eviloni. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.1",
            "verseOrgIds": [
              "2SA.2.1"
            ]
          }
        },
