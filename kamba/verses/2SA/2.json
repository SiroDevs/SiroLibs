              "2SA.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Asaeli akũa Avineli; na amũkũĩte ndaathũka ngali ya kw’oko kwa aũme kana kwa aka aeke kũmũkũa Avineli. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.19",
            "verseOrgIds": [
              "2SA.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩvo ĩndĩ Avineli wasiisye ĩtina wake, na asya, Nue, Asaeli? Na asũngĩa, Ninyie. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.20",
            "verseOrgIds": [
              "2SA.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Avineli amwĩa, Athũka ngalĩ ya kw’oko kwa aũme kwaku kana kwa aka, ũkwate mwanake ũmwe, nokyosa mĩio yake ya kaũ. Ĩndĩ Asaeli ndaaĩtĩkĩla kwathũka aeke ũmũkũa. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.21",
            "verseOrgIds": [
              "2SA.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Avineli amwĩa Asaeli ĩngĩ, Athũka ũeke kũngũa: nĩkĩ ngũkũne ũvalũke nthĩ? Ngatonya ata ĩndĩ kũkĩlya ũthyũ wakwa vala ve Yoavu mwana‐a‐mwenyu? ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.22",
            "verseOrgIds": [
              "2SA.2.22"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.3.27"
              },
              "items": [
                {
                  "text": "2 Sam 3.27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.22",
            "verseOrgIds": [
              "2SA.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2SA 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ alea kwathũka: kwondũ wa ũu Avineli amũtonya na mũla wa ĩtumo ĩvunĩ, na ĩtumo yaumĩlĩla mũongo; na avalũka vo, na akw’ĩa o vo: na kweethĩwa, o ala mavikĩe vandũ vala Asaeli wavalũkile akĩkw’a maũngama.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.23",
            "verseOrgIds": [
              "2SA.2.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2SA 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.23",
            "verseOrgIds": [
              "2SA.2.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2SA 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ Yoavu na Avisai maatĩĩa Avineli: na syũa yathũa yĩla mavikie kĩĩmanĩ kya Ama, kĩla kĩ mbee wa Ngia nzĩanĩ ĩla ĩelete weũnĩ wa Ngiveoni. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.24",
            "verseOrgIds": [
              "2SA.2.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2SA 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ana ma Mbenyamini meeyũmbanĩsya vala ve Avineli, na matw’ĩka nguthu ĩmwe, na maũngama mũtumbĩnĩ wa kĩĩma. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.25",
            "verseOrgIds": [
              "2SA.2.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2SA 2:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩvo ĩndĩ Avineli wamwĩtie Yoavu, na amũkũlya, Ũvyũ ũkamina matukũ onthe? Ndũũmanya kũkeethĩwa ũũ mũminũkĩlyonĩ? Kũkeethĩwa kũvika ĩndĩĩ ũkĩsa kũtavya andũ masyoke maeke kũatĩĩa ana‐a‐ĩthe moo? ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.26",
            "verseOrgIds": [
              "2SA.2.26"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.11.25"
              },
              "items": [
                {
                  "text": "2 Sam 11.25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.26",
            "verseOrgIds": [
              "2SA.2.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2SA 2:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yoavu asya, O tondũ Ngai wĩ thayũ, o na kethĩwa ndũnaneena, vate ndĩi andũ meĩ yĩnũka kĩoko, na makĩeka kũatĩĩa kĩla ũmwe mwana‐a‐ĩthe wake. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.27",
            "verseOrgIds": [
              "2SA.2.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2SA 2:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwondũ wa ũu Yoavu avuva soo; na andũ onthe maũngama, na matyaaatĩĩa Isilaeli ĩngĩ, kana kũkita namo ĩngĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.28",
            "verseOrgIds": [
              "2SA.2.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2SA 2:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Avineli na andũ make maenda ũtukũ ũsu w’onthe mavĩtĩla Alava; na mainga Yolotani, na mavĩtĩla Vithiloni yonthe, na mavika Maanaimu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.29",
            "verseOrgIds": [
              "2SA.2.29"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.2.8"
              },
              "items": [
                {
                  "text": "2 Sam 2.8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2SA 2:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.29",
            "verseOrgIds": [
              "2SA.2.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2SA 2:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yoavu asyoka aeka kũatĩĩa Avineli: na yĩla waminie kũmban’ya andũ onthe, athũkũmi ma Ndaviti maolekete andũ ĩkũmi na kenda, na Asaeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.30",
            "verseOrgIds": [
              "2SA.2.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2SA 2:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ athũkũmi ma Ndaviti nĩmakũnĩte andũ ma Mbenyamini, o andũ ma Avineli, makakw’a andũ maana atatũ na mĩongo thanthatũ. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.31",
            "verseOrgIds": [
              "2SA.2.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2SA 2:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mamwosa Asaeli na mamũthika ngunganĩ ya ĩthe wake vala vathikawa akw’ũ, ĩla yaĩ Mbethi‐leemu. Na Yoavu na andũ make maenda ũtukũ w’onthe, na makeewe ku Eviloni.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.32",
            "verseOrgIds": [
              "2SA.2.32"
            ]
          }
        }
      ]
    }
