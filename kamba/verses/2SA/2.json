          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na yu Avineli mwana wa Neli, kavuteni wa nguthu ya Saulo, aĩ anamwosa Isi‐vosethi mwana wa Saulo, na kũmũtwaa ku Maanaimu; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.8",
            "verseOrgIds": [
              "2SA.2.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
