                {
                  "text": "1 Sam 26.6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.23.24"
              },
              "items": [
                {
                  "text": "2 Sam 23.24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.2.16"
              },
              "items": [
                {
                  "text": "1 Mav 2.16",
                  "type": "text"
