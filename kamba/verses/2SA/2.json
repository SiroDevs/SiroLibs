            "sid": "2SA 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na andũ ma Yuta mooka, na mamwĩtĩkĩĩsya Ndaviti mauta kw’o ethĩwe mũsumbĩ wa nyũmba ya Yuta.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.4",
            "verseOrgIds": [
              "2SA.2.4"
            ]
          }
        }
      ]
    },
    {
