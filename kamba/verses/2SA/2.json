            "sid": "2SA 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na matavya Ndaviti, makyasya, Andũ ma Yavesi‐ngileati nĩmo ala mamwĩnzĩie Saulo nthĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.4",
            "verseOrgIds": [
              "2SA.2.4"
            ]
          }
        },
