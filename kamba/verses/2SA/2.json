          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ Ndaviti ambata kw’o, o na aka make eli, Ainoamu Mũyesileeli, na Avikaili ũla waĩ kĩveti kya Navali Mũkalimeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.2",
            "verseOrgIds": [
              "2SA.2.2"
            ]
          }
        },
