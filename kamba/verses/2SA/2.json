          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Avineli amwĩa Yoavu, Nĩngũkwĩsũva, anake mokĩle mathaũke twene. Na Yoavu asya, Mokĩle. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.14",
            "verseOrgIds": [
              "2SA.2.14"
            ]
          }
        },
        {
