          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Livisa mwĩĩtu wa Aia oosa ngũa sya makunia, na eeyalanĩlya ĩũlũ wa ĩvia, kuma wambĩlĩlyo wa ngetha kũvika yĩla mbua yasyuĩe kuma ĩtunĩ; na ndaaeka nyũnyi sya yayaya sivuĩle mũthenya, kana nyamũ sya kĩtheka ũtukũ. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.10",
            "verseOrgIds": [
              "2SA.21.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Ndaviti atavw’a ũndũ Lisiva mwĩĩtu wa Aia, mũka ngombo wa Saulo, wĩkĩte.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.11",
            "verseOrgIds": [
              "2SA.21.11"
            ]
          }
        }
      ]
    },
    {
