              },
              "items": [
                {
                  "text": "2 Sam 3.7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.8",
            "verseOrgIds": [
              "2SA.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "na amanengane mokonĩ ma Angiveoni, na mamasũsya kĩĩmanĩ Yeova ene, na asu onthe mũonza mavalũka vamwe. Na mooawa mĩthenya ya ngetha, o mĩthenyanĩ ya mbee, wambĩlĩlyonĩ wa kũketha mbaale.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.9",
            "verseOrgIds": [
              "2SA.21.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
