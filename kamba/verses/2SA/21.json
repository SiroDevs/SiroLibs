          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ mũsumbĩ atĩa Mevivosethi, mwana wa Yonathani mwana wa Saulo, nũndũ wa wĩvĩto wa Yeova ũla waĩ katĩ woo, katĩ wa Ndaviti na Yonathani mwana wa Saulo. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.7",
            "verseOrgIds": [
              "2SA.21.7"
            ]
          }
        },
        {
