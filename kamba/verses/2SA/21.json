                "loc": "JOS.9.3+JOS.9.4+JOS.9.5+JOS.9.6+JOS.9.7+JOS.9.8+JOS.9.9+JOS.9.10+JOS.9.11+JOS.9.12+JOS.9.13+JOS.9.14+JOS.9.15+JOS.9.16+JOS.9.17"
              },
              "items": [
                {
                  "text": "Yos 9.3–17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.2",
            "verseOrgIds": [
              "2SA.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Ndaviti akũlya Angiveoni, Nĩmwĩka ata? Na ngeew’anĩthya na kyaũ, nĩ kana mũathime ũtiĩwa wa Yeova? ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.3",
            "verseOrgIds": [
              "2SA.21.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
