            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.12",
            "verseOrgIds": [
              "2SA.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "na aete kuma kw’o mavindĩ ma Saulo na mavĩndĩ ma Yonathani mwana wake: na moomban’ya mavĩndĩ ma ala masũiw’e. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.13",
            "verseOrgIds": [
              "2SA.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mathika mavĩndĩ ma Saulo na Yonathani mwana wake nthĩ ya Mbenyamini ku Nzeela, ngunganĩ ya Kisu ĩthe wake vala vathikawa akw’ũ: na meeka w’onthe ũla mũsumbĩ weaie. Na ĩtina wa ũu Ngai nĩwesũvĩkie ũndũ wa ĩ nthĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.14",
            "verseOrgIds": [
              "2SA.21.14"
            ]
          }
        },
        {
