          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ mũsumbĩ oosa ana elĩ ma Lisiva mwĩĩtu wa Aia, ala wamũsyaĩe Saulo, nao nĩ Alimoni na Mevivosethi; na ana atano ma Mikali mwĩĩtu wa Saulo, ala wamũsyaĩe Atilieli mwana wa Mbalisilai Mũmeolathi: ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.8",
            "verseOrgIds": [
              "2SA.21.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
