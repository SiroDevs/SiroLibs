          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Avilisiti maĩ na kaũ ĩngĩ na Isilaeli; na Ndaviti atheea, e na athũkũmi make, na okita na Avilisiti. Na Ndaviti anyala; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.15",
            "verseOrgIds": [
              "2SA.21.15"
            ]
          }
        },
        {
