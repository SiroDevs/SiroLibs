            "number": "2",
            "style": "v",
            "sid": "2SA 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mũsumbĩ ameta Angiveoni, na amea (Angiveoni ĩndĩ matyaĩ ma ana ma Isilaeli, ĩndĩ maĩ ma ũtialo wa Aamoli; na ana ma Isilaeli maĩ mameavie; na Saulo amantha kũmoaa nũndũ wa kĩwĩu kyake kwondũ wa ana ma Isilaeli na Yuta); ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.2",
            "verseOrgIds": [
              "2SA.21.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
