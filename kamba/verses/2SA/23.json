                "loc": "1SA.22.1"
              },
              "items": [
                {
                  "text": "1 Sam 22.1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.5.18"
              },
              "items": [
                {
                  "text": "2 Sam 5.18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.13",
            "verseOrgIds": [
              "2SA.23.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩvinda yĩu Ndaviti aĩ ngomenĩ yĩ vinya; na asikalĩ ma Avilisiti ĩvinda yĩu maĩ Mbethi‐leemu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.14",
            "verseOrgIds": [
              "2SA.23.14"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.22.4"
              },
              "items": [
                {
                  "text": "1 Sam 22.4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.22.5"
              },
              "items": [
                {
                  "text": "5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.14",
            "verseOrgIds": [
              "2SA.23.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Ndaviti akwatwa nĩ mũng’atũko, na asya, Ame! Kethĩwa mũndũ ũmwe akanenga manzĩ ma ũnyw’a ma kĩthima kya Mbethi‐leemu, kĩla kĩ vakuvĩ na mbingĩlo! ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.15",
            "verseOrgIds": [
              "2SA.23.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ngũmbaũ isu itatũ syavithũkĩa syavũthũĩla nguthunĩ ya Avilisiti, na syatava manzĩ kĩthimanĩ kya Mbethi‐leemu, kĩla kyaĩ vakuvĩ na mbingĩlo, na syakua, na syamũtwaĩa Ndaviti: ĩndĩ ndaaĩtĩkĩla kũmanyw’a, ĩndĩ etĩa Yeova nthĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.16",
            "verseOrgIds": [
              "2SA.23.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na asya, Nĩkwĩthĩwe kũasa nakwa, ame Yeova, nĩke ũndũ ũilyĩ ũu: nĩnyw’a nthakame ya andũ ala malekilye mathayũ moo mũisyonĩ? Kwondũ wa ũu ndaaĩthĩkĩla kũmanyw’a. Maũndũ asu nĩmeekiwe nĩ ila ngũmbaũ ĩtatũ. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.17",
            "verseOrgIds": [
              "2SA.23.17"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
