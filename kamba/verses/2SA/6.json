                "loc": "1SA.6.7"
              },
              "items": [
                {
                  "text": "1 Sam 6.7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.7.1"
              },
              "items": [
                {
                  "text": "7.1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.3",
            "verseOrgIds": [
              "2SA.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mayumya nyũmbanĩ ya Avinatavu, ĩla yaĩ kĩĩmanĩ, vamwe na ĩsandũkũ ya Ngai: na Aio atongoesya yĩla ĩsandũkũ. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.4",
            "verseOrgIds": [
              "2SA.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Ndaviti na nyũmba yonthe ya Isilaeli mainga me mbee wa Yeova mĩthemba yonthe ya syĩndũ sya kũinga iseũvĩtw’e na mĩtĩ ya mĩsonovali, na mbeve, na inanda, na tũthembe, na tũmĩtĩ twa ũkunangan’ya, na tũmasaya. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.5",
            "verseOrgIds": [
              "2SA.6.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
