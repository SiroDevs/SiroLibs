          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mũsumbĩ Ndaviti wataviw’e, kũkyaw’a, Yeova nũathimĩte nyũmba ya Oveti‐etomu, na syĩndũ syake syonthe, nũndũ wa ĩsandũkũ ya Ngai. Na Ndaviti aenda na aete ĩsandũkũ ya Ngai ndũanĩ ya Ndaviti kuma nyũmbanĩ ya Oveti‐etomu ayĩlikya ndũanĩ ya Ndaviti e na ũtanu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.12",
            "verseOrgIds": [
              "2SA.6.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
