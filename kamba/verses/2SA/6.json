        {
          "text": "Na Ndaviti asũnga e mbee wa Yeova na vinya wake w’onthe; na Ndaviti evotoete evoti ya katane. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.14",
            "verseOrgIds": [
              "2SA.6.14"
            ]
          }
