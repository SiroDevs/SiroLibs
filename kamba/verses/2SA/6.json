            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mailĩĩla ĩsandũkũ ya Ngai ĩkasyanĩ yeũ, na mayumya nyũmbanĩ ya Avinatavu ĩla yaĩ kĩĩmanĩ: na Usa na Aio, ana ma Avinatavu mainga yĩla ĩkasya yeũ. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.3",
            "verseOrgIds": [
              "2SA.6.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
