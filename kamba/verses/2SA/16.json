            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩvo ĩndĩ Avisai mwana wa Nzeluia wakũlilye mũsumbĩ, Nũndũ wa kĩ ngitĩ ĩno ngw’ũ ĩkũumanga mwĩaĩi wakwa mũsumbĩ? Ndeka nĩinge, nĩngũkwĩsũva, na ngĩtila mũtwe wake. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.9",
            "verseOrgIds": [
              "2SA.16.9"
            ]
          }
        },
