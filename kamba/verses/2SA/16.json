              "items": [
                {
                  "text": "2 Sam 19.21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.7",
            "verseOrgIds": [
              "2SA.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeova nũtũngĩte ĩũlũ waku nthakame yonthe ya nyũmba ya Saulo, ũla wasumbĩkie vandũ vake; na Yeova nũnenganĩte ũsumbĩ kw’okonĩ kwa Avisalomu mwana waku; na, sisya, nũkwatĩtw’e ũthũkunĩ waku mwene, nĩkwĩthĩwa wĩ mũndũ wa nthakame. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.8",
            "verseOrgIds": [
              "2SA.16.8"
            ]
          }
        },
