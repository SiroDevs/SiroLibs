          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na nthĩ yonthe yenda kũvika kwa Solomoni, yĩw’e ũĩ wake, ũla Ngai wekĩie ngoonĩ yake. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.24",
            "verseOrgIds": [
              "1KI.10.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 10:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na maete kĩla mũndũ mũvothi wake, mĩio ya vetha, na mĩio ya thaavu, na ngũa, na mĩio ya kaũ, na mĩtĩ ĩla ĩnyungaa nesa, na mbalasi, na nyũmbũ, syĩanĩe kĩla mwaka.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.25",
            "verseOrgIds": [
              "1KI.10.25"
            ]
          }
        }
      ]
