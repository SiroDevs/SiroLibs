        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "(na ĩndĩ Ilamu mũsumbĩ wa Tile nĩwamũnengete Solomoni mĩtĩ ya mĩkũũ na mĩtĩ ya mĩsonovali, vamwe na thaavu, kwĩanana na kwenda kwake kw’onthe), nĩvo mũsumbĩ Solomoni wamũnengie Ilamu ndũa mĩongo ĩlĩ nthĩ ya Ngalilii. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.11",
            "verseOrgIds": [
              "1KI.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Ilamu auma Tile asisye ndũa ila Solomoni wamũnengie; na ityaamwendeesya. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.12",
            "verseOrgIds": [
              "1KI.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na asya, Nĩ ndũa myaũ ii ila ũnengete, mwana‐a‐asa? Na asyĩta nthĩ ya Kavuli kũvika ũmũnthĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.13",
            "verseOrgIds": [
              "1KI.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Ilamu amũtwaĩa mũsumbĩ talendi ĩana na mĩongo ĩlĩ sya thaavu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.14",
            "verseOrgIds": [
              "1KI.9.14"
            ]
          }
        }
      ]
