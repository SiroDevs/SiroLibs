              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.15",
            "verseOrgIds": [
              "2PE.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2PE 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ tũtyaaatĩĩa mbano itilĩtwe na ũĩ, yila twamũmanyĩthisye vinya wake na kũka kwa Mwĩaĩi waitũ Yesũ Klĩsto, ĩndĩ twaĩ ngũsĩ sya ũtheu mũtisu wake sya kwona na metho. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.16",
            "verseOrgIds": [
              "2PE.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2PE 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.17.5"
              },
              "items": [
                {
                  "text": "Mt 17.5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ nĩwosie kuma kwa Ngai Asa ndaĩa na ũtheu mũtisu, yĩla wavikĩwe nĩ wasya waumie ũtheuni mũnene mũtisu, ũkyasya, Ũũ nĩwe Mwana wakwa mwendwa, ũla nenendeeaw’a nĩwe: ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.17",
            "verseOrgIds": [
              "2PE.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2PE 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "na ithyĩ nĩtweewie wasya ũsu ũiuma ĩtunĩ, yĩla twaĩ vamwe nake kĩĩmanĩ kĩla kĩtheu. ",
          "type": "text",
