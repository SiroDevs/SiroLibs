              },
              "items": [
                {
                  "text": "Yuta 5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwondũ wa ũu ngeethĩawa nĩyũmbanĩtye mavinda onthe kũmũlilikanasya maũndũ aa, o na kau nĩmũmesĩ, na kũlũlũmĩlw’a nthĩnĩ wa ũla w’o mwĩ naw’o. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.12",
            "verseOrgIds": [
              "2PE.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2PE 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.5.1"
              },
              "items": [
                {
                  "text": "2 Ako 5.1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakwa nĩona nĩ ũseo, ĩvinda yĩla ngwĩkala ĩeemanĩ, yĩĩ, kũmũvindũa ũndũ wa kũmũlilikan’ya; ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.13",
            "verseOrgIds": [
              "2PE.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2PE 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.21.18"
              },
              "items": [
                {
                  "text": "Yoa 21.18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.21.19"
              },
              "items": [
                {
                  "text": "19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngĩmanya kana kũveta ĩeema yakwa kwĩũka mĩtũkĩ, o ũndũ Mwĩaĩi waitũ Yesũ Klĩsto wambonisye. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.14",
            "verseOrgIds": [
              "2PE.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2PE 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩĩ, nĩngũthangaaa nĩ kana mavinda onthe ĩtina wa kũkw’a kwakwa mũtonye ũlilikana maũndũ aa.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.15",
            "verseOrgIds": [
              "2PE.1.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2PE 1:15"
          },
          "items": [
            {
