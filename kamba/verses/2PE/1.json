            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Simoni Vetelo, ngombo na mũtũmwa wa Yesũ Klĩsto, valũa ũũ wakwa ũmavikĩe ala moosie vamwe naitũ mũĩkĩĩo o ũsu ũmwe ũla wĩ vata mũnene nthĩnĩ wa ũlũngalu wa Ngai waitũ na Mũtangĩĩi waitũ Yesũ Klĩsto: ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.1",
            "verseOrgIds": [
              "2PE.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2PE 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JUD.1.2"
              },
              "items": [
                {
                  "text": "Yuta 2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumo nĩwĩthĩwe nenyu na mũuo wingĩvw’e nthĩnĩ wa ũmũmanya Ngai na Yesũ Mwĩaĩi waitũ.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.2",
            "verseOrgIds": [
              "2PE.1.2"
            ]
          }
        }
      ]
    },
    {
