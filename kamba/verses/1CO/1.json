              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.13.4"
              },
              "items": [
                {
                  "text": "2 Ako 13.4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩkwĩthĩwa ũtumanu wa Ngai wĩ ũĩ kwĩ andũ; na wonzu wa Ngai wĩ vinya kwĩ andũ.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.25",
