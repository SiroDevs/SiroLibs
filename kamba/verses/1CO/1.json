                  "text": "Ako 2.3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ĩndĩ kwa ala metawa, ethĩwa nĩ Ayuti kana Akiliki, nĩ Klĩsto vinya wa Ngai na ũi wa Ngai. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.24",
            "verseOrgIds": [
              "1CO.1.24"
            ]
          }
        },
        {
