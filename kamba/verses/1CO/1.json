            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aĩva ũla mũĩ? Aĩva mũandĩkĩ? Aĩva ũla mũkananĩi wa ĩvinda yĩĩ? Ngai ndaatw’ĩkĩthya ũĩ wa nthĩ ũtumanũ? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.20",
            "verseOrgIds": [
              "1CO.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
