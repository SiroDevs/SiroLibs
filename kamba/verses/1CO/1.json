              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩkwĩthĩwa Ayutĩ mendaa syama, na Akilili mamanthaa ũĩ: ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.22",
