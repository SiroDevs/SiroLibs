              },
              "items": [
                {
                  "text": "Alo 9.32",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ĩndĩ ithyĩ tũtavanasya Klĩsto ũla wambiwe, kwa Ayuti nĩ ũndũ wa ũlulutĩkya, na kwa Andũ‐ma‐mbaĩ‐ĩngĩ nĩ ũtumanũ; ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.23",
            "verseOrgIds": [
              "1CO.1.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CO 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
