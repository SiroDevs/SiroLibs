          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "na syĩndũ sya nthĩ ite ndaĩa, na syĩndũ ila ivũthaw’a, nĩsyo Ngai wanyuvie, ĩĩ, na syĩndũ ila ite vo, nĩ kana atonye kwitw’ĩkĩthya sya mana syĩndũ ila syĩ vo: ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.28",
            "verseOrgIds": [
              "1CO.1.28"
            ]
          }
        },
