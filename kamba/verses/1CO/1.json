                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩkwĩthĩwa ũĩnĩ wa Ngai, nthĩ, kwondũ wa ũĩ wayo, ndĩaamũmanya Ngai, Ngai endie kũmatangĩĩa asu metĩkĩlaa kwondũ wa ũtumanu wa ũvoo ũla ũtavanaw’a. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.21",
            "verseOrgIds": [
              "1CO.1.21"
            ]
          }
        },
