            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ ũĩ wa nthĩ ĩno nĩ ũtumanu kwa Ngai. Nũndũ nĩkũandĩkĩtwe, Ũla ũmakwataa ala oĩ ũselekenĩ woo: ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.3.19",
            "verseOrgIds": [
              "1CO.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
