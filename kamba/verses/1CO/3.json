                  "text": "Sav 94.11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "na ĩngĩ, Mwĩaĩi nĩwĩsĩ mosũanĩo ma ala oĩ, kana nĩ ma mana. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.3.20",
            "verseOrgIds": [
              "1CO.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CO 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwondũ wa ũu, mũndũ ndakekathĩĩe ũndũ wa andũ. Nũndũ syĩndũ syonthe nĩ syenyu; ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.3.21",
            "verseOrgIds": [
              "1CO.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CO 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "ethĩwa nĩ Vaulo, kana Avolo, kana Keva, kana nthĩ, kana thayũ, kana kĩkw’ũ, kana syĩndũ ila syĩ kw’o, kana ila ĩkethĩwa kw’o; syonthe nĩ syenyu; ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.3.22",
            "verseOrgIds": [
              "1CO.3.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
