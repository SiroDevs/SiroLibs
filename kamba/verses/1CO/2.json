              "attrs": {
                "loc": "PHP.3.15"
              },
              "items": [
                {
                  "text": "Avi 3.15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ, o na ũu, tũneenaa ũĩ kwa ala meanĩe: ĩndĩ ti ũĩ wa nthĩ ĩno, kana wa anene ma nthĩ ĩno, ala makatuwa ma mana: ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.6",
            "verseOrgIds": [
              "1CO.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CO 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.16.25"
              },
              "items": [
                {
                  "text": "Alo 16.25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ĩndĩ tũneenaa ũĩ wa Ngai na nzama, naw’o nĩ ũla wavithĩtwe, ũla Ngai watwie tene mbee wa mavinda aa ũndũ wa ũtaĩo witũ: ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.7",
            "verseOrgIds": [
              "1CO.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
