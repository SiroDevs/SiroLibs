              "items": [
                {
                  "text": "Ako 1.26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "naw’o ũĩ ũsu vatyaĩ ũmwe wa anene ma nthĩ ĩno wawĩsĩ: nũndũ kethĩwa nĩmoomanyie, matyaĩ mamwamba Mwĩaĩi ũla ũtaĩawa: ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.8",
            "verseOrgIds": [
              "1CO.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CO 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "ĩndĩ o tondũ kũandĩkĩtwe,",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.9",
            "verseOrgIds": [
              "1CO.2.9"
            ]
          }
        }
