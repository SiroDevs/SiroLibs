            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Syaĩĩsyai, ũngamai mwĩ alũmu mũĩkĩĩonĩ, ĩthĩwai aũme, ongelekai vinya. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.13",
            "verseOrgIds": [
              "1CO.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CO 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maũndũ onthe ala mwĩkaa mekaei na wendano.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.14",
