          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.2.12"
              },
              "items": [
                {
                  "text": "2 Ako 2.12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.4.3"
              },
              "items": [
                {
                  "text": "Ako 4.3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.3.8"
              },
              "items": [
                {
                  "text": "Ũvu 3.8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "nũndũ nĩvingũĩwe mũomo mũnene ũla waĩlĩte wa wĩa, na kwĩ nthũ nyingĩ.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.9",
            "verseOrgIds": [
              "1CO.16.9"
            ]
          }
        }
