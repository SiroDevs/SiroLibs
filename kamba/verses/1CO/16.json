                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.16.5"
              },
              "items": [
                {
                  "text": "Alo 16.5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na yũ nĩmwĩsũva, ana‐a‐asa (nĩmwĩsĩ ĩla nyũmba ya Sitevana, kana nĩ ũsyao wa mbee wa Akaia, namo meyiĩte ene kũmathũkũma atheu,) ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.15",
            "verseOrgIds": [
              "1CO.16.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CO 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.2.29"
              },
              "items": [
                {
                  "text": "Avi 2.29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "nĩ kana ĩnyw’ĩ nenyu mwĩnyivye ene kwa ala mailyĩ ũu, na kwa kĩla mũndũ ũtethasya ũla wĩa na kũũthĩnĩa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.16",
            "verseOrgIds": [
              "1CO.16.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CO 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TH.5.12"
              },
              "items": [
                {
                  "text": "1 Ath 5.12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakwa nĩngũtana kwondũ wa kũka kwa Sitevana na Volitunato na Akaiko: nĩkwĩthĩwa nĩmeanĩsye ũla mũtaaĩanĩsya. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.17",
            "verseOrgIds": [
              "1CO.16.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CO 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ nĩmambuũkĩtye veva wakwa o na maveva menyu: mamanyei ala mailyĩ ũu.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.18",
            "verseOrgIds": [
              "1CO.16.18"
            ]
          }
        }
      ]
