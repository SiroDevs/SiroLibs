              "items": [
                {
                  "text": "Alo 12.5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩkwĩthĩwa ithyĩ ala twĩ aingĩ, twĩ kĩmũtũ kĩmwe, mwĩĩ ũmwe; nũndũ ithyonthe twĩ osi ma kĩmũtũ o kĩmwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.17",
            "verseOrgIds": [
              "1CO.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
