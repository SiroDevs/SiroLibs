            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũtitonya kũnyw’a kĩkombe kya Mwĩaĩi, na kĩkombe kya ndaimoni: mũtitonya kũĩsanĩa mesanĩ ya Mwĩaĩi, na mesanĩ ya ndaimoni. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.21",
            "verseOrgIds": [
              "1CO.10.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
