              "items": [
                {
                  "text": "Sav 106.37",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.9.20"
              },
              "items": [
                {
                  "text": "Ũvu 9.20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ nĩasya, kana syĩndũ ila Andũ‐ma‐mbaĩ‐ingĩ mathembaa, mathembeaa ndaimoni, matĩthembeaa Ngai: nakwa ndikwenda mwĩthĩwe na mũamba na ndaimoni. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.20",
            "verseOrgIds": [
              "1CO.10.20"
            ]
          }
        },
        {
