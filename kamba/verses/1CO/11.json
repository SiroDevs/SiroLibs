              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ nyie noosie kwa Mwĩaĩi kyu kĩla namũnengie inyw’ĩ, kana Mwĩaĩi Yesu, ũtũku ũla wavũnyanĩiwe oosie kĩmũtũ; ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.23",
            "verseOrgIds": [
              "1CO.11.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CO 11:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "na atũnga mũvea, atilan’ya na asya, Kĩĩ nĩkyo mwĩĩ wakwa, naw’o nĩ kwondũ wenyu: ĩkaai ũu ũndũ wa kũndilikana. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.24",
            "verseOrgIds": [
              "1CO.11.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CO 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.24.8"
              },
              "items": [
                {
                  "text": "Kuma 24.8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.9.11"
              },
              "items": [
                {
                  "text": "Nzek 9.11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "No ta ũu oosie kĩkombe nakyo, ĩtina wa kũya, aiasya, Kĩkombe kĩĩ nĩ ũtianio mweũ nthakamenĩ yakwa: ĩkaai ũu, yĩla mũũnyw’a, ũndũ wa kũndilikana. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.25",
            "verseOrgIds": [
              "1CO.11.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CO 11:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.26.29"
              },
              "items": [
                {
                  "text": "Mt 26.29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ o yĩla mũũya kĩmũtũ kĩĩ, na kũnyw’a kĩkombe kĩĩ, mwionan’ya kĩkw’ũ kya Mwĩaĩi kũvika yĩla wĩũka.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.26",
            "verseOrgIds": [
              "1CO.11.26"
            ]
          }
        }
      ]
