              },
              "items": [
                {
                  "text": "1 Ako 4.16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.3.17"
              },
              "items": [
                {
                  "text": "Avi 3.17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩthĩwai mũkĩelekan’ya nakwa, o ũndũ nyie nakwa nĩelekanasya na Klĩsto.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.1",
            "verseOrgIds": [
              "1CO.11.1"
            ]
          }
        }
