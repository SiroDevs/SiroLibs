          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yu amwe nĩmekwĩkathĩĩa, ta ndeũka kwenyu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.4.18",
            "verseOrgIds": [
              "1CO.4.18"
            ]
          }
