            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ nĩmwĩsũva mwĩthĩwe mũkĩelekan’ya nakwa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.4.16",
