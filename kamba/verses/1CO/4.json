              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ ũsumbĩ wa Ngai ndwĩ ndetonĩ, ĩndĩ wĩ vinyanĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.4.20",
