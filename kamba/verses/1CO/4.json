            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwondũ wa ũu nĩnamũtũmie Timotheo oke kwenyu, nake nĩ mwana wakwa mwendwa wĩ kĩthito nthĩnĩ wa Mwĩaĩi, ũla wĩmũlilikan’ya ũvoo wa mĩendele yakwa ĩla ĩ nthĩnĩ wa Klĩsto, o tondũ nĩmanyĩasya kũndũ kw’onthe nthĩnĩ wa kĩla ĩkanisa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.4.17",
            "verseOrgIds": [
              "1CO.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
