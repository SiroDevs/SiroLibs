          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.4.14"
              },
              "items": [
                {
                  "text": "Aev 4.14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.3.12"
              },
              "items": [
                {
                  "text": "Avi 3.12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.3.15"
              },
              "items": [
                {
                  "text": "15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ana‐a‐asa, mũikethĩwe syana ilĩkonĩ syenyu: ĩndĩ kũla kwĩ ũthũkũ ĩthĩwaĩ tũũkenge, ĩndĩ kĩlĩkonĩ ĩthĩwai mwĩ aima. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.20",
            "verseOrgIds": [
              "1CO.14.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CO 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.28.49"
              },
              "items": [
                {
                  "text": "Kũt 28.49",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.28.11"
              },
              "items": [
                {
                  "text": "Isa 28.11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.28.12"
              },
              "items": [
                {
                  "text": "12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mĩaonĩ nĩkũandĩkĩtwe, Nganeena na andũ aa na andũ me na ithyomo ĩtesĩkĩwe, na ilomo sya aenĩ; ĩndĩ o na neeka ũu, maikambĩw’a, eneena ũu Ngai. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.21",
            "verseOrgIds": [
              "1CO.14.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CO 14:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwondũ wa ũu ithyomo nĩ kwondũ wa wonan’yo, na ti kwondũ wa ala metĩkĩlĩte, ĩndĩ nĩ kwondũ wa ala matetĩkĩlĩte; ĩndĩ kwathana ti kwondũ wa ala matetĩkĩlĩte, ĩndĩ nĩ kwondũ wa ala metĩkĩlĩte. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.22",
            "verseOrgIds": [
              "1CO.14.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CO 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.2.13"
              },
              "items": [
                {
                  "text": "Meko 2.13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ ethĩwa ĩkanisa yonthe nĩyũmbanĩte vamwe, na onthe maĩneena na ithyomo, na vaiũka vo andũ mataamanyĩw’a kana ala matetĩkĩlĩte, matiasya kana mwĩ na ndũũka? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.23",
            "verseOrgIds": [
              "1CO.14.23"
            ]
          }
