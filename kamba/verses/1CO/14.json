                "loc": "COL.2.5"
              },
              "items": [
                {
                  "text": "Ako 2.5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ maũndũ onthe nĩmekwe ũndũ kwaĩle, maatĩanĩe.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.40",
