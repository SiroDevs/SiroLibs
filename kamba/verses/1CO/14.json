              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "O ũndũ kũilyĩ makanisanĩ onthe ma atheu, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.33",
            "verseOrgIds": [
              "1CO.14.33"
            ]
