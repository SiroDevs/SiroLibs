              "items": [
                {
                  "text": "1 Yoa 4.6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ethĩwa mũndũ o na wĩva eĩtalĩlya mwene kwĩthĩwa nĩ mwathanĩ, kana nĩ wa vevanĩ, namanye nesa maũndũ asu ngũmũandĩkĩa, kana nĩ mwĩao wa Mwĩaĩi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.37",
            "verseOrgIds": [
              "1CO.14.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1CO 14:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ ethĩwa mũndũ o na wĩva nde na ũmanyi, nĩethĩwe ate na ũmanyi.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.38",
            "verseOrgIds": [
              "1CO.14.38"
            ]
          }
        }
      ]
    },
