            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.8",
            "verseOrgIds": [
              "HAG.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HAG 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwaasya mũkoona nyingĩ, na, sisya, ikyoneka nini; na mwaiete mũsyĩ, ngivutũkya. Nĩkĩ? Ekũlya ũu Yeova wa nguthu. Nũndũ wa nyũmba yakwa kũekwa ĩ mbanangĩku, yĩla mũũsemba kĩla mũndũ nyũmbanĩ yake mwene. ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.9",
            "verseOrgIds": [
              "HAG.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HAG 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwondũ wa ũu nũndũ wenyu matu nĩmaleaa kũete ĩmwe, na nthĩ nĩleaa kũete ũsyao wayo. ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.10",
            "verseOrgIds": [
              "HAG.1.10"
            ]
          }
        },
