                "loc": "2SA.7.2"
              },
              "items": [
                {
                  "text": "2 Sam 7.2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.64.11"
              },
              "items": [
                {
                  "text": "Isa 64.11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HOS.4.10"
              },
              "items": [
                {
                  "text": "Osea 4.10",
                  "type": "text"
                }
              ]
