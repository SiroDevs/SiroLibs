            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HAG 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeova wa nguthu eneena ũũ, akyasya, Andũ aa measya, Ĩvinda yĩtinamba kũvika, ĩvinda ya kwaka nyũmba ya Yeova. ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.2",
            "verseOrgIds": [
              "HAG.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HAG 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩvo ĩndĩ ndeto ya Yeova yookie na kanyw’a wa mwathani Akai, ĩkĩkũlya, ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.3",
            "verseOrgIds": [
              "HAG.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HAG 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩ ĩvinda yenyu ene kwĩkalaa nyũmbanĩ syenyu nzeũvye na mbwaũ nthĩnĩ, yĩla nyũmba ĩno ĩeketwe ĩ mbanangĩku? ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.4",
            "verseOrgIds": [
              "HAG.1.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
