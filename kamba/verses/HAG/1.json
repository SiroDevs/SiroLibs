            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.132.14"
              },
              "items": [
                {
                  "text": "14",
                  "type": "text"
                }
              ]
