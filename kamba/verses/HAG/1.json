        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HAG 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na neeta mũnyao wũke ĩũlũ wa nthĩ, na ĩũlũ wa ĩĩma, na ĩũlũ wa lĩu wa mbaa ngetha, na ĩũlũ wa mbinyu nbĩthĩ, na ĩũlũ wa mauta, na ĩũlũ wa kĩla nthĩ ĩmeasya, na ĩũlũ wa andũ, na ĩũlũ wa indo, na ĩũlũ wa wĩa w’onthe wa moko.",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.11",
            "verseOrgIds": [
              "HAG.1.11"
            ]
          }
        }
      ]
