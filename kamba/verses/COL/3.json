              "items": [
                {
                  "text": "Aev 5.20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ũndũ o na wĩva mwĩkaa, kwa ndeto kana kwa meko, ĩkaai w’onthe syĩtwanĩ ya Mwĩaĩi Yesũ, mũimũnenga Ngai Asa mũvea kwondũ wake.",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.17",
            "verseOrgIds": [
              "COL.3.17"
            ]
          }
        }
      ]
