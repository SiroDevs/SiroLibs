              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.12.27"
              },
              "items": [
                {
                  "text": "27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mũuo wa Klĩsto ũsumbĩke ngoonĩ syenyu, ũla kwondũ waw’o nenyu mweetiwe nthĩnĩ wa mwĩĩ ũmwe; na ĩthĩwai na mũvea. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.15",
            "verseOrgIds": [
              "COL.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "COL 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.5.19"
              },
              "items": [
                {
                  "text": "Aev 5.19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndeto ya Klĩsto yĩkalae na ũthwii mwingĩ nthĩnĩ wenyu; nthĩnĩ wa ũĩ w’onthe mũimanyĩan’ya na kũtaana inyw’ĩ kwa inyw’ĩ na savuli na mbathi sya kũmũkumya Ngai na mbathi sya veva, mũkĩmwinĩa Ngai na mumo ngoonĩ syenyu. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.16",
            "verseOrgIds": [
              "COL.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "COL 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.10.31"
              },
              "items": [
                {
                  "text": "1 Ako 10.31",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.5.20"
