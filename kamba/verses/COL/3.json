              "items": [
                {
                  "text": "5.2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kũmĩĩasya ũmwe kwa ũla ũngĩ, na kũekeanĩa ene kwa ene, ethĩwa mũndũ o na wĩva e na ũndũ na ũngĩ; o tondu Mwĩaĩi wamũekeie, inyw’ĩ nenyu ĩkaai o ta ũu: ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.13",
            "verseOrgIds": [
              "COL.3.13"
            ]
          }
        },
