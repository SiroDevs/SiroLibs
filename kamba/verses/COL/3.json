                "loc": "EPH.4.3"
              },
              "items": [
                {
                  "text": "Aev 4.3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "na mbee wa maũndũ aa onthe ĩvw’ĩkei wendo, naw’o nĩ wovano wa wĩanĩu. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.14",
            "verseOrgIds": [
              "COL.3.14"
            ]
          }
        },
        {
