            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "nĩ kana ngoo syoo ikiakiw’e, makwatanĩtw’e nĩ wendo, mavikĩe ũthwii w’onthe wa wĩanĩu wa ũmanyi, nĩ kana mamanye ĩla nzama ya Ngai, nayo nĩ Klĩsto, ",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.2",
            "verseOrgIds": [
              "COL.2.2"
            ]
          }
        },
