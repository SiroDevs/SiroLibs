            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "na inyw’ĩ nĩmwĩanĩw’e nthĩnĩ wake, nake nĩ mũtwe wa monene na mokũmũ onthe: ",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.10",
            "verseOrgIds": [
