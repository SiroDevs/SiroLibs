              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩneena ũu, nĩ kana mũndũ o na wĩva ndakamũkenge na ndeto nzeũvye. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.4",
