              "type": "text"
            }
          ]
        },
        {
          "text": "na nthĩnĩ wake nĩmwaĩkĩtwe na nzaĩko ĩtaĩkawa na moko, ũndũ wa kũveta mwĩĩ wa nyama, nthĩnĩ wa nzaĩko ya Klĩsto; ",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.11",
            "verseOrgIds": [
