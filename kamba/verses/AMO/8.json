        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "AMO 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kũkeethĩwa mũthenya ũsu, ngathũsya syũa yĩ katambanga, na ngatulĩthya nthĩ kĩvindu kwĩ mũthenya kwĩsang’ũlĩtye, easya ũu Mwĩaĩi Yeova. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.9",
            "verseOrgIds": [
              "AMO.8.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
