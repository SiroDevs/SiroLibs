            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.4",
            "verseOrgIds": [
              "AMO.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "AMO 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "mũkyasya, Mũtiso wa mwei ũkathela ĩndĩĩ, nĩ kana twĩthoosye lĩu wa mbaa ngetha? Na savato ũkathela ĩndĩĩ, nĩ kana tumĩlye nganũ, tũkĩnyivya eva, na tũkyongela sekeli, na kũkenga andũ na ithimi sya ũkengani; ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.5",
            "verseOrgIds": [
              "AMO.8.5"
            ]
          }
        },
        {
