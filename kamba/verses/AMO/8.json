              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HOS.8.13"
              },
              "items": [
                {
                  "text": "Osea 8.13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.7",
            "verseOrgIds": [
              "AMO.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "AMO 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nthĩ ndĩkatetema nũndũ wa ũu, na kĩla ũmwe ũmĩtwĩe ndakameta? Ĩĩ, ĩkookĩla vyũ ta ũla Ũsĩ; na ĩkathokoana na kũusya ĩngĩ, ta Ũsĩ wa Misili. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.8",
            "verseOrgIds": [
              "AMO.8.8"
            ]
          }
        },
        {
