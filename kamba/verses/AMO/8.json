            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na makangangaa kuma ũkanga kũvika ũkanga, na kuma ngalĩ ya ĩũlũ o na kũvika ngalĩ ya wumĩlonĩ wa syũa; makasemba kũũ na kũũ mamanthe ndeto ya Yeova, na matikamyona. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.12",
            "verseOrgIds": [
              "AMO.8.12"
            ]
          }
        },
