              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩw’ai ũũ, inyw’ĩ ala mwendaa kũmelya athĩni, na kũtuma ngya sya nthĩ ithela, ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.4",
