          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "O na ĩngĩ nakwa nĩnĩmĩsiĩĩe mbua ndĩkaue kwenyu, yĩla vatiele myei ĩtatũ kũvikĩa ngetha; na namyusya ndũanĩ ĩmwe, na natuma ĩtaua ndũanĩ ĩngĩ: kĩlungu kĩmwe nĩkyauie, na kĩlungu kĩla kĩtaaua kyooma. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.7",
            "verseOrgIds": [
              "AMO.4.7"
            ]
          }
        },
