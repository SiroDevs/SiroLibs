          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nenyu nĩmũkaumaalĩla vala ve movũthũe, kĩla ũmwe aeleele mbee wake; na mũkeeyĩkya inyw’ĩ ene Alimoni, easya ũu Yeova.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.3",
            "verseOrgIds": [
              "AMO.4.3"
            ]
          }
        }
