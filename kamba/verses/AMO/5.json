                {
                  "text": "Esek 19.1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.1",
            "verseOrgIds": [
              "AMO.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "AMO 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwĩĩtu mũtheu wa Isilaeli nũvalũkĩte; ndakokĩla ĩngĩ: nĩwĩkĩtw’e nthĩ ĩũlũ wa nthĩ yake; vai ũmwe wa kũmũkĩlya. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.2",
            "verseOrgIds": [
              "AMO.5.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LAM.2.1"
              },
              "items": [
                {
                  "text": "Iĩo 2.1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.2",
            "verseOrgIds": [
              "AMO.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "AMO 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ ũũ nĩw’o Mwĩaĩi Yeova ũnũkwasya: Ndũa ĩla yaumaalile me ngili ĩkatiala ĩana, na ĩla yaumaalile me ĩana ĩkatiala ĩkũmi, ma nyũmba ya Isilaeli.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.3",
            "verseOrgIds": [
              "AMO.5.3"
            ]
          }
        }
      ]
    },
    {
