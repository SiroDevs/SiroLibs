                {
                  "text": "Nzev 2.3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.4",
            "verseOrgIds": [
              "AMO.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "AMO 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "ĩndĩ mũikamanthe Mbethi‐eli, o na mũikalike Ngilikali, na mũikavĩte mũthi Mbeeli‐sieva: nũndũ vate ndĩi Ngilikali ĩkaenda yĩ ndave, na Mbethi‐eli ĩkatw’ĩka mana. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.5",
            "verseOrgIds": [
              "AMO.5.5"
            ]
          }
        },
