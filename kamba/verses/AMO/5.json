            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩw’ai, inyw’ĩ, ndeto ĩno ĩla ngũneena ĩtw’ĩke kĩĩo kya kũmũĩĩa, inyw’ĩ nyũmba ya Isilaeli. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.1",
            "verseOrgIds": [
              "AMO.5.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
