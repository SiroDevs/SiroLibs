              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ Yeova etavya nyũmba ya Isilaeli atĩĩ, Manthai nyie, na mũkeethĩwa thayũ; ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.4",
            "verseOrgIds": [
              "AMO.5.4"
            ]
          }
        },
