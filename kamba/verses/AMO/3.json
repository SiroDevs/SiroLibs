            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.6",
            "verseOrgIds": [
              "AMO.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "AMO 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩ w’o, Mwĩaĩi Yeova ndakeka ũndũ, ateũvuanĩsya athũkũmi make athani nzama yake. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.7",
            "verseOrgIds": [
              "AMO.3.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.18.17"
              },
              "items": [
                {
                  "text": "Mwa 18.17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.7",
            "verseOrgIds": [
              "AMO.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "AMO 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũnyambũ nũminĩte kũluma; nũũ ũteĩw’a w’ĩa? Mwĩaĩi Yeova nũneenete; nũũ ĩndĩ ũtonya kũlea kwathana? ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.8",
            "verseOrgIds": [
              "AMO.3.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
