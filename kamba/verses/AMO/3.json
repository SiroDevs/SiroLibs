          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "No inyw’ĩ nĩsĩ katĩ wa mĩvĩa yonthe ya nthĩ: kwondũ wa ũu ngamũsilĩlaa ũndũ wa mothũku menyu onthe. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.2",
            "verseOrgIds": [
              "AMO.3.2"
            ]
          }
        },
