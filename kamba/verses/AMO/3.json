            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ mũthenya ũla nĩsilĩla Isilaeli ũndũ wa mavĩtyo make, ngasilĩla ithembeo sya Mbethi‐eli nasyo; na mbya sya kĩthembeo ikatilwa, na kũvalũka nthĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.14",
            "verseOrgIds": [
              "AMO.3.14"
            ]
          }
        },
