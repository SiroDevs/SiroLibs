          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ matyĩsĩ kwĩka w’o, easya Yeova, ala meyiĩaa ũng’endu na ũvutani nyũmbanĩ nene syoo mbanakavye. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.10",
            "verseOrgIds": [
              "AMO.3.10"
            ]
          }
        },
        {
