              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩvo naisye, Ame Mwĩaĩi Yeova, eka, nĩngũkwĩsũva: Yakovo akaũngama ata? Nũndũ nĩ mũnini. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.5",
            "verseOrgIds": [
              "AMO.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "AMO 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeova eetũnga ũndũ wa ũu: O na ũũ ndũkethĩwa, easya ũu Yeova.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.6",
            "verseOrgIds": [
              "AMO.7.6"
            ]
          }
        }
      ]
