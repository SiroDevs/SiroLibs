            "number": "11",
            "style": "v",
            "sid": "AMO 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ Amosi aasya atĩĩ, Yelovoamu akooawa na ũvyũ, na vate ndĩi Isilaeli akatavwa kumw’a nthĩ yake. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.11",
            "verseOrgIds": [
              "AMO.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "AMO 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩngĩ Amasia amwĩa Amosi, We mwoni, kĩa, ũthi nthĩ ya Yuta, na ũkĩaa kĩmũtũ kw’o, na kwathanĩaa kw’o: ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.12",
            "verseOrgIds": [
              "AMO.7.12"
            ]
          }
        },
