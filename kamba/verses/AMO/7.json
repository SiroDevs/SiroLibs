          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na yu kwondũ wa ũu ĩw’a ndeto ya Yeova: We wĩmbĩa, Ndũkathanĩe Isilaeli, na ndũkaneenee nyũmba ya Isaka ndeto yaku; ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.16",
            "verseOrgIds": [
              "AMO.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
