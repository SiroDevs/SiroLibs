                {
                  "text": "Mt 5.17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Endwa, ndiũmũandĩkĩa mwĩao mweũ, ĩndĩ nĩ mwĩao wa tene ũla mwaĩ naw’o kuma mwambĩlĩlyonĩ: na mwĩao ũsu wa tene nĩ ndeto ĩla mweewie. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.7",
            "verseOrgIds": [
              "1JN.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1JN 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.13.12"
              },
              "items": [
                {
                  "text": "Alo 13.12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.13.34"
              },
              "items": [
                {
                  "text": "Yoa 13.34",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.15.10"
              },
              "items": [
                {
                  "text": "15.10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.15.12"
              },
              "items": [
                {
                  "text": "12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩngĩ, nĩmũandĩkĩa mwĩao mweũ, naw’o nĩ wa w’o nthĩnĩ wake na nthĩnĩ wenyu; nĩkwĩthĩwa kĩvĩndu nĩkĩũvĩta na kyeni kya w’o nĩkĩkenaa o na yu. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.8",
            "verseOrgIds": [
              "1JN.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1JN 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.4.20"
              },
              "items": [
                {
                  "text": "1 Yoa 4.20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ũla waasya e kyeninĩ na amenaa mwana‐a‐ĩthe, ũsu e kĩvindunĩ kũvika yu. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.9",
            "verseOrgIds": [
              "1JN.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1JN 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.14.13"
              },
              "items": [
                {
                  "text": "Alo 14.13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.14.15"
              },
              "items": [
                {
                  "text": "15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.11.9"
              },
              "items": [
                {
                  "text": "Yoa 11.9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ũla ũmwendaa mwana‐a‐ĩthe atwĩe kyeninĩ, na nthĩnĩ wake vai ũlulutĩkyo. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.10",
            "verseOrgIds": [
              "1JN.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1JN 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.11.10"
              },
              "items": [
                {
                  "text": "Yoa 11.10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.12.35"
              },
              "items": [
                {
                  "text": "12.35",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ ũla ũmenaa mwana‐a‐ĩthe e kĩvindunĩ, na aendaa kĩvindunĩ, na ndesĩ kũla ũnũũthi, nũndũ kĩvindu nĩkĩmwaĩtye metho.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.11",
            "verseOrgIds": [
              "1JN.2.11"
            ]
          }
        }
      ]
    },
