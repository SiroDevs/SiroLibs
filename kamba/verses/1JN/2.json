              },
              "items": [
                {
                  "text": "1 Ako 10.11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Syana nini, nĩ saa wa mũminũkĩlyo: na tondũ mweewie kana nthũ ya Klĩsto nĩnĩkũka, o na yu nthũ sya Klĩsto nĩsyaingĩvie; na ũndũ wa ũu nĩtwĩsĩ kana nĩ saa wa mũminũkĩlyo. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.18",
            "verseOrgIds": [
              "1JN.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1JN 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.20.30"
              },
              "items": [
                {
                  "text": "Meko 20.30",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.11.19"
              },
              "items": [
                {
                  "text": "1 Ako 11.19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩmeeyumisye kwitũ, ĩndĩ matyaĩ maitũ; nũndũ kethĩwa maĩ maitũ, methĩwa makĩkala vamwe naitũ: ĩndĩ nĩmeeyumisye, nĩ kana monanw’e atĩ asu onthe ti maitũ. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.19",
            "verseOrgIds": [
              "1JN.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1JN 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.2.15"
              },
              "items": [
                {
                  "text": "1 Ako 2.15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nenyu mwĩ amenesye mauta kuma kwa ũla Mũtheu, na nĩmwĩsĩ maũndũ onthe. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.20",
            "verseOrgIds": [
              "1JN.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1JN 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndinamũandĩkĩa nũndũ mũtyĩsĩ ũla w’o, ĩndĩ nũndũ nĩmũwĩsĩ, na vai ũvũngũ o na wĩva wumaa nthĩnĩ wa ũla w’o. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.21",
            "verseOrgIds": [
              "1JN.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1JN 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ũla wĩ ũvũngũ nũũ, ate o ũla ũnũũlea kana Yesũ nĩwe Klĩsto? Ũsu nĩwe nthũ ya Klĩsto, ũla ũkaĩaa Asa na Mwana. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.22",
            "verseOrgIds": [
              "1JN.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1JN 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.4.15"
              },
              "items": [
                {
                  "text": "1 Yoa 4.15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.5.23"
              },
              "items": [
                {
                  "text": "Yoa 5.23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.15.23"
              },
              "items": [
                {
                  "text": "15.23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "O ũla ũnũũmũkaĩa Mwana, ũsu nde na Asa: ũla ũnũũmumbũla Mwana e na Asa nake. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.23",
            "verseOrgIds": [
              "1JN.2.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1JN 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ inyw’ĩ, ũekei wĩkale nthĩnĩ wenyu ũvoo ũla mweewie kuma mwambĩlĩlyonĩ. Ethĩwa ũvoo ũsu mweewie kuma mwambĩlĩlyonĩ wĩkalaa nthĩnĩ wenyu, mũkekalaa nthĩnĩ wa Mwana, na nthĩnĩ wa Asa. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.24",
            "verseOrgIds": [
              "1JN.2.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1JN 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ũũ nĩw’o watho ũla watwathie ithyĩ, naw’o nĩ ũla thayũ ũtathela. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.25",
            "verseOrgIds": [
              "1JN.2.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1JN 2:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maũndũ aa namũandĩkĩa ũndũ wa ala mekwenda kũmwasya. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.26",
            "verseOrgIds": [
              "1JN.2.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1JN 2:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.14.26"
              },
              "items": [
                {
                  "text": "Yoa 14.26",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.16.13"
              },
              "items": [
                {
                  "text": "16.13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.31.34"
              },
              "items": [
                {
                  "text": "Yel 31.34",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nenyu, kũmenew’a mauta kũla mwanengiwe nĩwe nĩkwĩkalĩte nthĩnĩ wenyu na mũi na vata wa kũmanyĩw’a nĩ mũndũ; ĩndĩ nũndũ kũmenew’a mauta kũla kumaa kwake nĩkũmũmanyĩasya maũndũ onthe, na nĩ kwa w’o, na ti ũvũngũ, na o ũndũ kwamũmanyĩisye, ĩkalai nthĩnĩ wake. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.27",
            "verseOrgIds": [
              "1JN.2.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1JN 2:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.3.2"
              },
              "items": [
                {
                  "text": "1 Yoa 3.2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.4.17"
              },
              "items": [
                {
                  "text": "4.17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na yu, syana syakwa nini, ĩkalai nthĩnĩ wake; nĩ kana yĩla wĩonanw’a twĩthĩwe na ũnyiau, na tũtikasonoke mbee wake, ooka. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.28",
            "verseOrgIds": [
              "1JN.2.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1JN 2:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.3.7"
              },
              "items": [
                {
                  "text": "1 Yoa 3.7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.3.10"
              },
              "items": [
                {
                  "text": "10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ethĩwa nĩmwĩsĩ kana we nĩ mũlũngalu, manyai kana kĩla mũndũ wĩkaa ũlũngalu nũsyaĩtwe nĩwe.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.29",
            "verseOrgIds": [
              "1JN.2.29"
            ]
          }
        }
