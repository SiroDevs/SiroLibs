                "loc": "1CO.6.11"
              },
              "items": [
                {
                  "text": "1 Ako 6.11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩmũandĩkĩa inyw’ĩ, syana syakwa nini, nũndũ nĩmũekewe naĩ syenyu kwondũ wa syĩtwa yake. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.12",
            "verseOrgIds": [
              "1JN.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1JN 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.1.1"
              },
              "items": [
                {
                  "text": "1 Yoa 1.1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩmũandĩkĩa inyw’ĩ, aasa, nĩkwĩthĩwa nĩmũmwĩsĩ we ũla wĩ kuma mwambĩlĩlyonĩ. Nĩmũandĩkĩa inyw’ĩ, anake, nĩkwĩthĩwa nĩmwakĩlilye ũla mũthũku vinya. Nĩnamũandĩkĩa inyw’ĩ, syana nini, nũndũ nĩmũmwĩsĩ Asa. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.13",
            "verseOrgIds": [
              "1JN.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1JN 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.6.10"
              },
              "items": [
                {
                  "text": "Aev 6.10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩnamũandĩkĩa inyw’ĩ, aasa, nũndũ nĩmũmwĩsĩ we ũla wĩ kuma mwabĩlĩlyonĩ. Nĩnamũandĩkĩa inyw’ĩ, anake, nũndũ mwĩ na vinya, na ndeto ya Ngai ĩtwĩe nthĩnĩ wenyu, na nĩmwakĩlilye ũla mũthũku vinya. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.14",
            "verseOrgIds": [
              "1JN.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1JN 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JAS.4.4"
              },
              "items": [
                {
                  "text": "Yak 4.4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũikamyende nthĩ, o na syĩndũ sya nthĩ. Ethĩwa mũndũ o na wĩva nũnũũmyenda nthĩ, wendo wa Asa ndwĩ nthĩnĩ wake. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.15",
            "verseOrgIds": [
              "1JN.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1JN 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.27.20"
              },
              "items": [
                {
                  "text": "Nth 27.20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JAS.4.16"
              },
              "items": [
                {
                  "text": "Yak 4.16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "TIT.2.12"
              },
              "items": [
                {
                  "text": "Tito 2.12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩkwĩthĩwa kĩla kĩ kũũ nthĩ, wendi wa mwĩĩ na wendi wa metho na wĩyĩan’yo wa thayũ ityumaa kwa Asa, ĩndĩ nĩ sya nthĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.16",
            "verseOrgIds": [
              "1JN.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1JN 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.7.21"
              },
              "items": [
                {
                  "text": "Mt 7.21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.4.2"
              },
              "items": [
                {
                  "text": "1 Vet 4.2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na nthĩ nĩnĩũvĩta, na wendi wayo: ĩndĩ ũla wĩkaa kwenda kwa Ngai ekalaa tene na tene.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.17",
            "verseOrgIds": [
              "1JN.2.17"
            ]
          }
        }
      ]
    },
