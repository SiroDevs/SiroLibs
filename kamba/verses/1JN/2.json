              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.1.20"
              },
              "items": [
                {
                  "text": "Ako 1.20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
