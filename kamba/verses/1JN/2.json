              "items": [
                {
                  "text": "Yoa 11.51",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "nake nĩwe nthembo ya wĩw’anĩthyo kwondũ wa naĩ sitũ; na ti sitũ syoka, ĩndĩ nũndũ wa naĩ sya nthĩ yonthe.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.2",
            "verseOrgIds": [
              "1JN.2.2"
            ]
          }
        }
