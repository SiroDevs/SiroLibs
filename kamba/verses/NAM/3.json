              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ethiovia na Misili nĩsyo syaĩ vinya wayo, na waĩ ũtathela; Vutu na Luvimu syaĩ atethya maku. ",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.9",
