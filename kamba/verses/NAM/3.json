              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩwingĩvĩtye athoosya maku kwĩ ndata sya ĩtu: mbandi nikwananga, na ikĩũlũka ikĩthi. ",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.16",
            "verseOrgIds": [
