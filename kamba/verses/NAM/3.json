              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ngakwĩkĩsya ũvuku ũthatasya, na ũkũvukya, na ngakwĩkalya ta wĩ wa kukũnũĩwa metho. ",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.6",
            "verseOrgIds": [
