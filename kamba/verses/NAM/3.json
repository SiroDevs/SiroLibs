              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngome syaku syonthe ikeethĩwa ta mĩkũyũ ĩ na makũyũ mambaa kwĩwa: ethĩwa ĩkathingithw’a, nĩmeũvalũka kanyw’anĩ wa mũyi. ",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.12",
            "verseOrgIds": [
              "NAM.3.12"
            ]
          }
        },
        {
