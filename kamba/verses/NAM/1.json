          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iĩma nitetemaa nũndũ wake, na tũlĩma tũkĩtweka; na nthĩ nĩyũkĩlanĩtye mbee wake, ĩĩ, nthĩ, na syonthe ila imĩtwĩa. ",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.5",
            "verseOrgIds": [
              "NAM.1.5"
            ]
          }
        },
        {
