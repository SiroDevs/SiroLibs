          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "O na makwatanĩte ta mĩw’a, na matoonetw’e nĩ kũnyw’a kwoo, ĩndĩ nĩmaminĩtwe vyũ ta ũa wũmũ. ",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.10",
            "verseOrgIds": [
              "NAM.1.10"
            ]
          }
        },
