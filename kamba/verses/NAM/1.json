              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeova nĩ Ngai wĩ kĩwĩu na nũĩvanĩasya; Yeova nũĩvanĩasya na nĩwusũĩtwe nĩ ũthilĩku; Yeova nĩwĩĩvanĩasya kwa nthũ syake, na nĩwiaa ũthilĩku nũndũ wa amaitha make. ",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.2",
            "verseOrgIds": [
              "NAM.1.2"
            ]
          }
        },
        {
