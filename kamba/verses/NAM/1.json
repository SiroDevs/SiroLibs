              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwĩ ũmwe wumĩte kwaku, ũla ũsũanĩĩaa Yeova ũthũku, ũla ũtaanaa ũtao mũthũku. ",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.11",
