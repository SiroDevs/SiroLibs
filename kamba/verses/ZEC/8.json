          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "na ngamaete, na makatũa nthĩnĩ wa Yelusaleme; na makeethĩwa andũ makwa, na ngeethĩwa Ngai woo, nthĩnĩ wa w’o na nthĩnĩ wa ũlũngalu. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.8",
            "verseOrgIds": [
              "ZEC.8.8"
            ]
          }
        },
