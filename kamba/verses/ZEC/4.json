                "loc": "HOS.1.7"
              },
              "items": [
                {
                  "text": "Osea 1.7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HAG.1.1"
              },
              "items": [
                {
                  "text": "Akai 1.1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.6",
            "verseOrgIds": [
              "ZEC.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ZEC 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nue ũũ, we kĩĩma kĩnene? Mbee wa Nzeluvaveli ũkatw’ĩka ũiĩ; nake akayumĩlya ĩvia ya ĩũlũ mũthya akĩyũkĩlĩlya wasya mũnene, Mumo, mumo. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.7",
            "verseOrgIds": [
              "ZEC.4.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.40.4"
              },
              "items": [
                {
                  "text": "Isa 40.4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.7",
            "verseOrgIds": [
              "ZEC.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ZEC 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩngĩ ndeto ya Yeova yambũkĩa, ĩkĩmbĩa, ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.8",
            "verseOrgIds": [
              "ZEC.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ZEC 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moko ma Nzeluvaveli nĩmakwatisye mwambĩlĩlyo wa nyũmba ĩno; na ĩngĩ moko make makamĩmina; na ũkamanya kana Yeova wa nguthu nũndũmĩte kwenyu. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.9",
            "verseOrgIds": [
              "ZEC.4.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZR.3.10"
              },
              "items": [
                {
                  "text": "Esa 3.10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.2.9"
              },
              "items": [
                {
                  "text": "Nzek 2.9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.9",
            "verseOrgIds": [
              "ZEC.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ZEC 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ nũũ ũvũthĩtye mũthenya wa maũndũ manini? Nũndũ asu mũonza makatana, na makoona kavilũ ke kw’okonĩ kwa Nzeluvaveli; asu nĩ metho ma Yeova, ala masembaa kũũ na kũũ nthĩ yonthe. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.10",
            "verseOrgIds": [
              "ZEC.4.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
