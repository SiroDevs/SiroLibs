                "loc": "2CH.16.9"
              },
              "items": [
                {
                  "text": "2 Mav 16.9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HAG.2.3"
              },
              "items": [
                {
                  "text": "Akai 2.3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.3.9"
              },
              "items": [
                {
                  "text": "Nzek 3.9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        }
      ]
    },
