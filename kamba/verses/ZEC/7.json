          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ndeto ya Yeova yamũkĩa Nzekalia, ĩkĩmwĩa, ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.7.8",
            "verseOrgIds": [
              "ZEC.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
