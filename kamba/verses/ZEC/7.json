          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kwĩkĩkĩte atĩĩ, o tondũ wetanie, nao matyaaĩtĩkĩla kwĩw’a, nao makeetana o ta ũu, nakwa ndikew’a, easya ũu Yeova wa nguthu; ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.7.13",
            "verseOrgIds": [
              "ZEC.7.13"
            ]
          }
        },
