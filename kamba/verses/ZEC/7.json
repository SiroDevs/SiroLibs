        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.7.11",
            "verseOrgIds": [
              "ZEC.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ZEC 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩĩ, nĩmoomĩsye ngoo syoo ta ĩvia ya ũana, matikese kwĩw’a mĩao, na ndeto ila Yeova wa nguthu watwaie na Veva wake na kanyw’a wa athani tene: kwondũ wa ũu nĩkwaumie ũthilĩku mũnene kwa Yeova wa nguthu. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.7.12",
            "verseOrgIds": [
              "ZEC.7.12"
            ]
          }
        },
