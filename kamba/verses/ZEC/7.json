            "sid": "ZEC 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kweethĩwa mwaka wa kana wa kũsumbĩka kwa mũsumbĩ Ndalio, ndeto ya Yeova yamũkĩa Nzekalia mũthenya wa kana wa mwei wa kenda, wĩtawa Kiselevu. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.7.1",
            "verseOrgIds": [
              "ZEC.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ZEC 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na yu ala ma Mbethi‐eli matũma Saleseli na Lekemimeleki, na andũ moo, kũvoya tei kwa Yeova, ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.7.2",
            "verseOrgIds": [
              "ZEC.7.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
