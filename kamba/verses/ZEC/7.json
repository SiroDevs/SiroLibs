            "number": "9",
            "style": "v",
            "sid": "ZEC 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ũũ nĩw’o Yeova wa nguthu ũneenete, akyasya, Silaai sila wa katĩ, na kĩla mũndũ akyon’ya mwanaa‐ĩthe ũseo na ĩnee; ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.7.9",
            "verseOrgIds": [
              "ZEC.7.9"
            ]
          }
        },
