                "loc": "EZK.28.3+EZK.28.4+EZK.28.5"
              },
              "items": [
                {
                  "text": "Esek 28.3–5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.2",
            "verseOrgIds": [
              "ZEC.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ZEC 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Tile nĩĩyakĩe ngome yĩ vinya, na kũmban’ya vetha ta kĩtoo, na kũmban’ya thaavu mũtheu ta ndaka nzĩanĩ nene. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.3",
            "verseOrgIds": [
              "ZEC.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ZEC 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sisya, Mwĩaĩi akamĩvuta, na akakũnĩa ũtonyi wayo ũkanganĩ; na ĩkaanangwa na mwaki. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.4",
            "verseOrgIds": [
              "ZEC.9.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.26.17"
              },
              "items": [
                {
                  "text": "Esek 26.17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.28.18"
              },
              "items": [
                {
                  "text": "28.18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.4",
            "verseOrgIds": [
              "ZEC.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ZEC 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asikeloni ĩkoona ũu, na ĩkĩkĩa: na Ngasa o ta ũu, na ĩkeethĩwa na kyalya kĩnene; o na Ekiloni, nũndũ wĩkwatyo wayo ũkasonokw’a; na Ngasa ĩkaaa mũsumbĩ, na Asikeloni ndĩkatũwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.5",
            "verseOrgIds": [
              "ZEC.9.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEP.2.4"
              },
              "items": [
                {
                  "text": "Nzev 2.4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.5",
            "verseOrgIds": [
              "ZEC.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ZEC 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mũndũ wasyaĩwe ũlaalainĩ akatũa Asitoti, na ngaveta ngathiĩo sya Avilisiti. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.6",
            "verseOrgIds": [
              "ZEC.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ZEC 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ngaveta kũnyw’a nthakame kanyw’anĩ wake, na mothatyo make maume maeonĩ make; o nake akeethĩwa ũtialo kwa Ngai waitũ; na akeethĩwa ta mũnene nthĩnĩ wa Yuta, na Ekiloni ta Mũyevusĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.7",
            "verseOrgIds": [
              "ZEC.9.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
