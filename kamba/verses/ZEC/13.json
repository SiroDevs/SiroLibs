        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.13.6",
            "verseOrgIds": [
              "ZEC.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ZEC 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amũka, we ũvyũ, ĩũlũ wa mũĩthi wakwa, na ĩũlũ wa mũndũ ũla mũtindan’ya wakwa, easya ũu Yeova wa nguthu: mũkũne mũĩthi, na malondu makanyaĩĩka; ngathyũũĩa tũla tũnini kw’oko kwakwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.13.7",
            "verseOrgIds": [
              "ZEC.13.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
