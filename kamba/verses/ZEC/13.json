                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.26.31"
              },
              "items": [
                {
                  "text": "Mt 26.31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.13.7",
            "verseOrgIds": [
              "ZEC.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ZEC 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kũkeethĩwa, ĩ nthĩ yonthe, ilungu ilĩ syayo ikavetwa na kũkw’a, easya ũu Yeova; ĩndĩ kya katatũ kĩkatiwa nthĩnĩ wayo. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.13.8",
            "verseOrgIds": [
              "ZEC.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ZEC 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kĩlungu kya katatũ ngakĩete mwakinĩ, na ngamathesya o tondũ vetha ũtheaw’a, na ngamatata o tondũ thaavu ũtatawa. Makeekaĩla syĩtwa yakwa, na ngamew’a: ngasya, Nĩ andũ makwa; namo makasya, Yeova nĩ Ngai wakwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.13.9",
            "verseOrgIds": [
              "ZEC.13.9"
            ]
          }
        },
