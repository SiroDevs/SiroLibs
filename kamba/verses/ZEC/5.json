              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.5.3",
            "verseOrgIds": [
              "ZEC.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ZEC 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngatuma kyuma kĩthi, na kĩkalika nyũmbanĩ ya kĩng’ei, na nyũmbanĩ ya ũla wĩvĩtaa ũvũngũ na syĩtwa yakwa, easya ũu Yeova wa nguthu; na kĩkekala katĩ wa nyũmba yake, na kĩkamĩmina vamwe na mĩtĩ yayo na mavia mayo. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.5.4",
            "verseOrgIds": [
              "ZEC.5.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
