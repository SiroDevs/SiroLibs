              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ nookĩlya metho makwa ĩngĩ, na noona, na, sisya, ĩvuku ĩkũnze yĩũlũkĩte. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.5.1",
            "verseOrgIds": [
              "ZEC.5.1"
            ]
          }
        },
        {
