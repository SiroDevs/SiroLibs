            "number": "2",
            "style": "v",
            "sid": "ZEC 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na angũlya, Wĩona kyaũ? Nakwa nasũngĩa, Nĩona ĩvuku ĩkũnze yĩũlũkĩte; ũasa wayo nĩ mĩkono mĩongo ĩlĩ, na ũthanthau wayo mĩkono ĩkũmi. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.5.2",
            "verseOrgIds": [
              "ZEC.5.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.2.9"
              },
              "items": [
                {
                  "text": "Esek 2.9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.2.10"
              },
              "items": [
                {
                  "text": "10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.5.2",
            "verseOrgIds": [
              "ZEC.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ZEC 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩvo wambĩie, Kĩĩ nĩ kĩumo kĩla kyumite kĩthi ĩũlũ wa nthĩ yonthe: nũndũ kĩla ũmwe ũla wũyaa akavetwa aume ngalĩ ĩmwe kwĩanana na ũndũ kũandĩkĩtwe; na kĩla ũmwe wĩavaa akavetwa aume ngalĩ ĩla ĩngĩ kwĩanana na ũndũ kũandĩkĩwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.5.3",
            "verseOrgIds": [
              "ZEC.5.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
