                "loc": "DEU.28.28"
              },
              "items": [
                {
                  "text": "Kũt 28.28",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.76.6"
              },
              "items": [
                {
                  "text": "Sav 76.6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.4",
            "verseOrgIds": [
              "ZEC.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ZEC 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na anene ma Yuta makaasya ngoonĩ syoo, Ala matwĩe Yelusaleme nĩmo vinya wakwa nthĩnĩ wa Yeova wa nguthu Ngai woo. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.5",
            "verseOrgIds": [
              "ZEC.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ZEC 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũthenya ũsu ngatw’ĩkĩthya anene ma Yuta ta kĩlĩo kĩ mwaki katĩ wa ngũ, na ta ũmũĩ mwakanu katĩ wa syove sya ngetha; na makamina ngo syonthe sya andũ ila ithyũlũlũkĩte kw’onthe, ngalĩ ya kw’oko kwa aũme na kwa aka; na ala ma Yelusaleme makatũa o ĩngĩ kũndũ kwoo, o Yelusaleme. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.6",
            "verseOrgIds": [
              "ZEC.12.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
