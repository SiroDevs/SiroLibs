            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ũũ nĩw’o Yeova ũnũkwasya, ũla ũtambũũkasya matu, na ũkwatasya mwambĩlĩlyo wa nthĩ, na wũmbaa veva wa mũndũ nthĩnĩ wake: ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.1",
            "verseOrgIds": [
              "ZEC.12.1"
            ]
          }
        },
