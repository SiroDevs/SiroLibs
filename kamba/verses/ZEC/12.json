              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kũkeethĩwa mũthenya ũsu, ngamantha kwananga mbaĩ syonthe ila syĩũkĩa Yelusaleme. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.9",
            "verseOrgIds": [
              "ZEC.12.9"
            ]
