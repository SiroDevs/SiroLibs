            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.51.22"
              },
              "items": [
                {
                  "text": "22",
                  "type": "text"
                }
              ]
