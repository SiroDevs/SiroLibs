          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ũthatu wakwa nĩwakanĩe aĩthi, na ngasilĩla i nthenge; nũndũ Yeova wa nguthu nũsyaĩĩtye ĩĩthya yake, nyũmba ya Yuta, na akamatw’a o ta mbalasi yake nzeo kaũnĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.3",
            "verseOrgIds": [
              "ZEC.10.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
