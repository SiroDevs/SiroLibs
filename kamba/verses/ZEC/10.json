              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngamauĩsya kĩlũli, na kũmomban’ya; nũndũ nĩnĩmovoetye; na makaingĩva o tondũ maingĩvĩte. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.8",
            "verseOrgIds": [
