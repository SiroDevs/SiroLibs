                "loc": "PSA.118.22"
              },
              "items": [
                {
                  "text": "Sav 118.22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.22.23"
              },
              "items": [
                {
                  "text": "Isa 22.23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.4",
            "verseOrgIds": [
              "ZEC.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ZEC 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na makeethĩwa ta ngũmbaũ, maiangĩa amaitha moo nthĩ ndakanĩ sya nzĩa nene kaũnĩ; na makokita, nĩkwĩthĩwa Yeova e vamwe namo; na ala matũlĩte mbalasi makathokoanw’a. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.5",
            "verseOrgIds": [
              "ZEC.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ZEC 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ngeekĩa nyũmba ya Yuta vinya, na ngatangĩĩa nyũmba ya Yosevu, na ngamatũnga; nũndũ nĩ na tei kwoo; na makeethĩwa ta ndaamba kũmaveta: nũndũ ninyie Yeova Ngai woo, na ngamew’a. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.6",
            "verseOrgIds": [
              "ZEC.10.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
