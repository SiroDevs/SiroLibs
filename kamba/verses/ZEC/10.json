          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngamaete o ĩngĩ kuma nthĩ ya Misili, na kũmomban’ya kuma nthĩ ya Asuli; na ngamaete nthĩ ya Ngileati na Levanoni; na vatikoneka vandũ vameanĩe. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.10",
            "verseOrgIds": [
              "ZEC.10.10"
            ]
          }
        },
