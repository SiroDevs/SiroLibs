          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ethĩwa mũvĩa wa Misili ndũkambata, wũke, o na ndĩkaua kwoo; kũkeethĩwa ũthĩn’yo ũla Yeova wĩkũna i mbaĩ naw’o ila iteambata kũlilikana mboka ya malwanda. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.18",
            "verseOrgIds": [
              "ZEC.14.18"
            ]
          }
        },
        {
