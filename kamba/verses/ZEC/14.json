              "type": "text"
            }
          ]
        },
        {
          "text": "Sisya, mũthenya wa Yeova nĩwũkĩte, yĩla mũtavo waku ũkaaanw’a katĩ waku. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.1",
            "verseOrgIds": [
              "ZEC.14.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
