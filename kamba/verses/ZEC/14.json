              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ũu nĩw’o wĩĩthĩwa ũsilĩlo wa Misili, na ũsilĩlo wa mbaĩ syonthe ila iteambata kũlilikana mboka ya malwanda. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.19",
            "verseOrgIds": [
              "ZEC.14.19"
            ]
          }
        },
