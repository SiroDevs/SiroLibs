              "items": [
                {
                  "text": "Lk 21.24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.2",
            "verseOrgIds": [
              "ZEC.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ZEC 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩvo Yeova ũkaumĩla, na kũkita na mbaĩ ĩsu, ta yĩla wokitie mũthenya wa kaũ. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.3",
            "verseOrgIds": [
              "ZEC.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ZEC 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na maũũ make makaũngama mũthenya ũsu ĩũlũ wa kĩla kĩĩma kya Mĩthata, kĩla kyelekele Yelusaleme ngalĩ ya wumĩlonĩ wa syũa: na kĩĩma kya Mĩthata kĩkaatũkanĩla katĩ kyelekele wumĩlonĩ wa syũa na kyelekele ũthũĩlonĩ wa syũa, na vakeethĩwa kyanda kĩnene mũno; na nyunzu ya kĩĩma ĩkathi yelekele ngalĩ ya ĩũlũ na nyunzu yakyo yelekele ngalĩ ya ĩtheo. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.4",
            "verseOrgIds": [
              "ZEC.14.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.11.23"
              },
              "items": [
                {
                  "text": "Esek 11.23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.4",
            "verseOrgIds": [
              "ZEC.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ZEC 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mũkakĩĩla kyandanĩ kya iĩma syakwa; nũndũ kyanda kya iĩma kĩkavika Aseli; ĩĩ, mũkakĩa, o tondũ mwakĩie kĩtetemo kya nthĩ mĩthenya ya Usia mũsumbĩ wa Yuta; na Yeova Ngai wakwa akooka, na atheu onthe vamwe naku. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.5",
            "verseOrgIds": [
              "ZEC.14.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
