              "attrs": {
                "loc": "JOL.1.15"
              },
              "items": [
                {
                  "text": "Yoe 1.15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.1",
            "verseOrgIds": [
              "ZEC.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ZEC 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ ngoomban’ya mbaĩ syonthe ĩũlũ wa Yelusaleme syũkĩte; na ndũa ĩkooswa, na nyũmba ikatavwa mĩio, na aka makakindwa; na nyunzu ya ndũa ĩkatavwa, na ũtialo wa andũ ndũkavetwa ndũanĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.2",
            "verseOrgIds": [
              "ZEC.14.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
