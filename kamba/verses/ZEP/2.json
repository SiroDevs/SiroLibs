              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "O nenyu Aethiovia, mũkooawa na ũvyũ wakwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.12",
            "verseOrgIds": [
              "ZEP.2.12"
            ]
          }
        },
        {
