          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ũũ nĩw’o meĩthĩwa nũndũ wa ngathĩĩo syoo, nĩkwĩthĩwa nĩmavũthĩtye na kwĩtũlya ene ĩũlũ wa andũ ma Yeova wa nguthu. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.10",
            "verseOrgIds": [
              "ZEP.2.10"
            ]
          }
        },
