          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngamina mũndũ o na nyamũ; ngamina nyũnyi sya yayayanĩ, na makũyũ ma ũkanganĩ, na molulutĩkyo vamwe na ala athũku; na ngaveta mũndũ aume ĩũlũ wa nthĩ, easya ũu Yeova. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.3",
            "verseOrgIds": [
              "ZEP.1.3"
            ]
          }
        },
        {
          "name": "note",
