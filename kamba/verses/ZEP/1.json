        },
        {
          "text": "Ndeto ya Yeova ĩla yamũkĩe Nzevania mwana wa Kusi, mwana wa Ngetalia, mwana wa Amalia, mwana wa Esekia, mĩthenya ya Yosia mwana wa Amoni, mũsumbĩ wa Yuta. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.1",
            "verseOrgIds": [
              "ZEP.1.1"
            ]
          }
        },
