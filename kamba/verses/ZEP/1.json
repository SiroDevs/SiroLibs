            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mũthenya ũsu ngasilĩla onthe ala makĩlĩlaa mwalyonĩ wa mũomo, ala mausũasya nyũmba ya vwana woo ũng’endu na ũkengani. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.9",
            "verseOrgIds": [
              "ZEP.1.9"
            ]
          }
        },
        {
          "name": "verse",
