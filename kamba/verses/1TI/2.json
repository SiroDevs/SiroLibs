              "type": "tag",
              "attrs": {
                "loc": "GEN.3.6"
              },
              "items": [
                {
                  "text": "Mwa 3.6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.11.3"
              },
              "items": [
                {
                  "text": "2 Ako 11.3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Atamu ndaakengwa, ĩndĩ mũka akengwa nĩwavalũkile ĩvĩtyonĩ: ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.14",
            "verseOrgIds": [
              "1TI.2.14"
            ]
          }
        },
        {
          "name": "verse",
