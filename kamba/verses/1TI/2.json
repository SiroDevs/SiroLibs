            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ Atamu oombiwe mbee, na Eva ĩtina; ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.13",
            "verseOrgIds": [
              "1TI.2.13"
            ]
          }
        },
