                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "TIT.1.14"
              },
              "items": [
                {
                  "text": "Tito 1.14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "TIT.3.9"
              },
              "items": [
                {
                  "text": "3.9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ĩndĩ lea mbano mbuku na sya iveti ngũũ. Ĩthangaasye mwene kũmũkĩa Ngai: ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.4.7",
            "verseOrgIds": [
              "1TI.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1TI 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.6.6"
              },
              "items": [
                {
                  "text": "1 Tim 6.6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "nũndũ kwĩthangaasya kwa mwĩĩ kwaĩlaa vanini; ĩndĩ kũmũkĩa Ngai kwaĩlaa maũndũnĩ onthe, kwĩ na watho wa thayũ wa ĩvinda yĩĩ, na wa ũla ũkoka. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.4.8",
            "verseOrgIds": [
              "1TI.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1TI 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.1.15"
              },
              "items": [
                {
                  "text": "1 Tim 1.15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndeto nĩ ya kũĩkĩĩwa, na nĩyaĩle kwĩtĩkĩlwa. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.4.9",
            "verseOrgIds": [
              "1TI.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1TI 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.2.3"
              },
              "items": [
                {
                  "text": "1 Tim 2.3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.2.4"
              },
              "items": [
                {
                  "text": "4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwondũ wa ũu nĩtũũtethya wĩa na kwĩthing’ĩĩsya, nĩkwĩthĩwa twiĩte wĩkwatyo wĩtũ kwa Ngai ũla wĩ thayũ, nake nĩ Mũtangĩĩi wa andũ onthe, na mbee mũno wa ala metĩkĩlaa. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.4.10",
            "verseOrgIds": [
              "1TI.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1TI 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maũndũ aa meaĩe na mamanyĩsye. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.4.11",
            "verseOrgIds": [
              "1TI.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1TI 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "TIT.2.15"
              },
              "items": [
                {
                  "text": "Tito 2.15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũndũ o na wĩva ndakavũthye wana waku; ĩndĩ ĩthĩwa wĩ ngelekan’yo kwa ala metĩkĩlaa, nthĩnĩ wa ndeto, na mwĩkalĩle wa thayũ, na wendo, na mũĩkĩĩo, na ũtheu. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.4.12",
            "verseOrgIds": [
              "1TI.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1TI 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩthĩwa wĩ mũthangaau kũsoma, kũtaa, na kũmanyĩsya, mũvaka nooka. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.4.13",
            "verseOrgIds": [
              "1TI.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1TI 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.5.22"
              },
              "items": [
                {
                  "text": "1 Tim 5.22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TI.1.6"
              },
              "items": [
                {
                  "text": "2 Tim 1.6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.6.6"
              },
              "items": [
                {
                  "text": "Meko 6.6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.8.17"
              },
              "items": [
                {
                  "text": "8.17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndũkethĩwe ũteũsũvĩa mũthĩnzĩo ũla wĩ nthĩnĩ waku, ũla wanengiwe kwondũ wa wathani, vamwe na kwilĩĩlwa moko ma atumĩa. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.4.14",
            "verseOrgIds": [
              "1TI.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1TI 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩthĩwa na ũthangaau maũndũnĩ aa; ĩnengane kwamo vyũ; nĩ kana kũendeea na mbee kwaku kwĩthĩwe kwĩ kwoneku kwa onthe. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.4.15",
            "verseOrgIds": [
              "1TI.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1TI 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.11.14"
              },
              "items": [
                {
                  "text": "Alo 11.14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩsũvĩe mwene, vamwe na momanyĩsyo maku. Ĩkalaa maũndũnĩ asu; nũndũ kwa kwĩka ũu ũkeetangĩĩa mwene na asu nao ala makakwĩw’aa.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.4.16",
            "verseOrgIds": [
              "1TI.4.16"
            ]
          }
        }
      ]
    }
