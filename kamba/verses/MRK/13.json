              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ inyw’ĩ ĩsũvĩei: sisyai, nĩnamũtavya maũndũ onthe mbee.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.23",
            "verseOrgIds": [
              "MRK.13.23"
            ]
          }
