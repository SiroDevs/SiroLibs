                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ ũndũ wa akw’ũ, kana makathayũũkw’a; mũiaasoma ĩvukunĩ ya Mose, vala vaandĩkĩtwe ũvoo wa kala Kakuthu, ũndũ Ngai waneenie nake, akyasya, Nyie nĩ Ngai wa Avalaamu, na Ngai wa Isaka, na Ngai wa Yakovo? ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.26",
            "verseOrgIds": [
              "MRK.12.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MRK 12:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "We ti Ngai wa ala akw’ũ, indĩ nĩ wa ala me thayũ: nĩmũũvĩtya mũno.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.27",
            "verseOrgIds": [
              "MRK.12.27"
            ]
          }
        }
      ]
    },
