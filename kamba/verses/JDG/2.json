            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "na mamũtia Yeova, Ngai wa aaĩthe moo, ũla wamaumisye nthĩ ya Misili, na maatĩĩa ngai ingĩ, ngainĩ sya ngo sya andũ ila syamathyũlũlũkĩte, na masyĩkunamĩsya: na mamũthatya Yeova. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.12",
            "verseOrgIds": [
