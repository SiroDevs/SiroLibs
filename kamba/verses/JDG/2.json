            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ana ma Isilaeli meekaa ũla Yeova wonaa wĩ ũthũku, na mathũkũmaa Mbaalimu; ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.11",
