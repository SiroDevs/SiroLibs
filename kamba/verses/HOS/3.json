          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ ana ma Isilaeli makekala mĩthenya mingĩ mate na mũsumbĩ, na mate na mũnene wa mbee ũsumbĩnĩ, na mate na nthembo, na mate na kĩtuĩ, na mate na evoti kana telavimu: ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.3.4",
            "verseOrgIds": [
              "HOS.3.4"
            ]
          }
        },
