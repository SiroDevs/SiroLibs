              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ namwĩthooee we na ilungu ĩkũmi na itano sya vetha, na omeli ya mbaale, na nyunzu ya omeli ya mbaale; ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.3.2",
            "verseOrgIds": [
              "HOS.3.2"
            ]
          }
        },
        {
