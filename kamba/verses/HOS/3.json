        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.3.2",
            "verseOrgIds": [
              "HOS.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HOS 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "na namwĩa, Ukekala nũndũ wakwa mĩthenya mingĩ; ndũkeka ũmalwaya, na ndũkethĩwa kĩveti kya mũndũ ũngĩ: nakwa kwaku ngeethĩwa o ta ũu. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.3.3",
            "verseOrgIds": [
              "HOS.3.3"
            ]
          }
        },
