          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ ndaamanya kana nĩnamũnengaa lĩu wa mbaa ngetha, na mbinyu mbĩthĩ, na mauta, na kũmwingĩvĩsya vetha na thaavu, ila maumĩasya Mbaali. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.8",
            "verseOrgIds": [
              "HOS.2.8"
            ]
          }
        },
