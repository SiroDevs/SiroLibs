            "sid": "HOS 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakwa yu ngamũvua kwake kwĩ nthoni endwa make mene, na kũti ũmwe wĩmũtangĩĩa kuma kw’okonĩ kwakwa. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.10",
            "verseOrgIds": [
              "HOS.2.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
