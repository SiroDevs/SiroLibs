              "HOS.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HOS 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na akaatĩĩa endwa make, ĩndĩ ndakamawĩla; na akamamantha, ĩndĩ ndakamona: nĩvo wĩasya, Nĩngũenda nĩsyokee mũũme wakwa wa mbee; nũndũ ĩvinda yĩu kwaĩ kavaa kwakwa kwĩ yu. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.7",
            "verseOrgIds": [
              "HOS.2.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
