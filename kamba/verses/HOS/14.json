              },
              "items": [
                {
                  "text": "Sav 91.1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.7",
            "verseOrgIds": [
              "HOS.14.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HOS 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Evalaimu akasya, Nĩ ũndũ ũngĩ mwaũ na mĩvw’anano? Nĩnzũngĩĩte, nakwa ngamũsyaĩĩsya: nĩilyĩ ta mũtĩ wa mũsonovali mũthithinĩu; vala nĩĩ ũsyao waku nĩwonekaa. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.8",
            "verseOrgIds": [
              "HOS.14.8"
            ]
          }
        },
        {
