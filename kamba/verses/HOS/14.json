              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngavosya kũsyoka na ĩtina kwoo, ngamenda mũno; nũndũ ũthatu wakwa nũalyũkĩte kuma kwake. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.4",
            "verseOrgIds": [
              "HOS.14.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
