            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HOS 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asuli ndĩkatũtangĩĩa; tũikatũla mbalasi; o na tũikea wĩa wa moko maitũ ĩngĩ, Nĩ inyw’ĩ ngai sitũ; nũndũ ala makw’ĩĩwe nĩ aaĩthe monaa tei kwaku. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.3",
            "verseOrgIds": [
              "HOS.14.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
