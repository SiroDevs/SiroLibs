              "items": [
                {
                  "text": "Osea 13.16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.14",
            "verseOrgIds": [
              "HOS.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "HOS 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Now’o Mbethi‐eli wĩkwĩka nũndũ wa ũthũku waku mũnene: o w’oa ũkĩtema mũsumbĩ wa Isilaeli akavetwa vyũ.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.15",
            "verseOrgIds": [
              "HOS.10.15"
            ]
          }
        }
