                "loc": "1KI.12.28"
              },
              "items": [
                {
                  "text": "1 Asu 12.28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.5",
            "verseOrgIds": [
              "HOS.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HOS 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "O na ĩngĩ kakatwawa Asuli katw’ĩke mũthĩnzĩo kwa mũsumbĩ Yalevu: Evalaimu akasonokw’a, na Isilaeli akasonokea ũtao wake mwene. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.6",
            "verseOrgIds": [
              "HOS.10.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HOS.5.13"
              },
              "items": [
                {
                  "text": "Osea 5.13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.6",
            "verseOrgIds": [
              "HOS.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HOS 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ũvoo wa Samalia, mũsumbĩ wayo nĩ mũvete, o ta ĩvuo ĩũlũ wa manzĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.7",
            "verseOrgIds": [
              "HOS.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HOS 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩngĩ kũndũ kũtũlu kwa Aveni, nĩkw’o naĩ ya Isilaeli, kũkaanangwa: mĩw’a na thangila ikamea ĩũlũ wa ithembeo syoo; na makatavya iĩma, Tũvw’ĩkei; na tũlĩma, Tũvalũkĩlei. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.8",
            "verseOrgIds": [
              "HOS.10.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.12.30"
              },
              "items": [
                {
                  "text": "1 Asu 12.30",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "AMO.8.14"
              },
              "items": [
                {
                  "text": "Amo 8.14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
