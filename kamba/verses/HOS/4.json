          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HOS 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndikasilĩla eĩtu menyu meeka ũmalwaya, kana atwawa menyu meeka ũlaalai; nũndũ o namo ene maendaa mwathũko na malwaya, na makĩthemba me na malwaya; na andũ ala mate na ũmanyi makaanangwa. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.14",
            "verseOrgIds": [
              "HOS.4.14"
            ]
          }
        },
