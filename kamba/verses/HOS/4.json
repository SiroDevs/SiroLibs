            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩw’ai ndeto ya Yeova, inyw’ĩ ana ma Isilaeli; nũndũ Yeova e na ngananĩo na ala matwĩe ĩ nthĩ, nũndũ kũti w’o, kana ũseo, kana ũmanyi wa Ngai ĩ nthĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.1",
            "verseOrgIds": [
              "HOS.4.1"
            ]
          }
        },
        {
          "name": "note",
