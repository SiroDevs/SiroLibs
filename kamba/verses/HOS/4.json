          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.5",
            "verseOrgIds": [
              "HOS.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HOS 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Andũ makwa nĩmanangawa nĩ kwaa ũmanyi: nĩkwĩthĩwa nĩwaleile ũmanyi, o nakwa ngakũlea, nĩ kana ndũkethĩwe mũthembi kwakwa: nũndũ nĩwũlĩtwe nĩ mĩao ya Ngai waku, o nakwa ngoolwa nĩ syana syaku. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.6",
            "verseOrgIds": [
              "HOS.4.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
