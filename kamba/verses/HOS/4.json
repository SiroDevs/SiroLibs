          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ũmalwaya na mbinyu na mbinyu mbĩthĩ nivetaa ũmanyi. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.11",
            "verseOrgIds": [
              "HOS.4.11"
            ]
          }
        },
