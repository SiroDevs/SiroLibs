            "sid": "HOS 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kũti ũndũ ũngĩ no kwĩavaa, na kwanangaa wĩw’ano, na kũaaa, na kũyaa, na kwĩkaa ũlaalai; nĩmeyalĩlasya, na nthakame nikwataa nthakame. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.2",
            "verseOrgIds": [
              "HOS.4.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
