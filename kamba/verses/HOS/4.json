            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.11",
            "verseOrgIds": [
              "HOS.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HOS 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Andũ makwa nĩmakũlasya kĩthukĩ kyoo ũtao, na ndata yoo nĩmavuanĩasya; nũndũ veva wa ũmalwaya nũmavĩtĩthasya, na nĩmekaa ũmalwaya, makyuma ungu wa Ngai woo. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.12",
            "verseOrgIds": [
              "HOS.4.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
