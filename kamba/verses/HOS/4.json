              "items": [
                {
                  "text": "Yel 23.39",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.6",
            "verseOrgIds": [
              "HOS.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HOS 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "O tondũ maingĩvie, now’o mambĩtanĩsye: ngaalyũla ndaĩa yoo ĩtw’ĩke nthoni. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.7",
            "verseOrgIds": [
              "HOS.4.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAL.2.9"
              },
              "items": [
                {
                  "text": "Mal 2.9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.7",
            "verseOrgIds": [
              "HOS.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HOS 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maĩsaa naĩ ya andũ makwa, na kwenda mũno ngoonĩ syoo ũthũku woo. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.8",
            "verseOrgIds": [
              "HOS.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HOS 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kũkeethĩawa, o ũndũ andũ mailyĩ, now’o mũthembi; nakwa ngamasilĩla nũndũ wa mĩendele yoo, na ngamaĩva o meko moo. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.9",
            "verseOrgIds": [
              "HOS.4.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.24.2"
              },
              "items": [
                {
                  "text": "Isa 24.2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.9",
            "verseOrgIds": [
              "HOS.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HOS 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na makaya, na matikavũna; makeeka ũmalwaya, na matikongeleka; nĩkwĩthĩwa nĩmaekie kũmwĩw’a Yeova. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.10",
            "verseOrgIds": [
              "HOS.4.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
