                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.12",
            "verseOrgIds": [
              "HOS.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HOS 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩmathembaa iĩmanĩ ĩũlũ, na kũtoeesya ũvani ĩũlũ wa tũlĩma, ĩtina wa mĩtĩ ya myaloni na mĩlivina na mĩelo, nĩkwĩthĩwa muunyĩ wayo nĩ mũseo: kwondũ wa ũu eĩtu menyu nĩmekaa ũmalwaya, na atwawa menyu nĩmekaa ũlaalai. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.13",
            "verseOrgIds": [
              "HOS.4.13"
            ]
          }
        },
        {
