              },
              "items": [
                {
                  "text": "Mt 14.3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.14.4"
              },
              "items": [
                {
                  "text": "4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.6.17"
              },
              "items": [
                {
                  "text": "Mko 6.17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.6.18"
              },
              "items": [
                {
                  "text": "18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ĩndĩ mũsumbĩ Elote, akĩkanw’a nĩwe ũndũ wa Elotia mũka wa mwana‐a‐inyia, na ũndũ wa maũndũ onthe mathũku ala Elote wekĩte, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.19",
            "verseOrgIds": [
              "LUK.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "ongela ũthũku ũngĩ ĩũlũ wa ala wekĩte, amũvingĩa Yoana kolokolonĩ.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.20",
            "verseOrgIds": [
              "LUK.3.20"
            ]
          }
        }
      ]
    },
