          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.9.35"
              },
              "items": [
                {
                  "text": "Lk 9.35",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.2.7"
              },
              "items": [
                {
                  "text": "Sav 2.7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.42.1"
              },
              "items": [
                {
                  "text": "Isa 42.1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Veva Mũtheu amũtheea e na mwĩĩ ũvw’ana ta wa ĩvũĩ, amũvũĩla, na wasya wauma ĩtunĩ, We nue Mwana wakwa mwendwa; nendeaaw’a nue.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.22",
