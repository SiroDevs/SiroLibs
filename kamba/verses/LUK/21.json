                {
                  "text": "Sav 65.7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kũkethĩwa mawonan’yo syũanĩ na mweinĩ na ndatanĩ; na kũũ nthĩ kũkethĩwa ũnyamao wa mbaĩ, ikĩsũanĩwa nũndũ wa kĩlitũko kya ũkanga na itulumo syaw’o; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.25",
            "verseOrgIds": [
              "LUK.21.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 21:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.34.4"
              },
              "items": [
                {
                  "text": "Isa 34.4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "andũ nĩmakatw’ĩka nda nĩ w’ĩa, na ũndũ wa kweteela maũndũ ala mokĩte ĩũlũ wa nthĩ: nũndũ mavinya ma ĩtu nĩmakathingithangw’a. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.26",
            "verseOrgIds": [
              "LUK.21.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 21:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.7.13"
              },
              "items": [
                {
                  "text": "Nda 7.13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.26.64"
              },
              "items": [
                {
                  "text": "Mt 26.64",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩvinda yĩu nĩmakamwona Mwana wa mũndũ okĩte ĩthweonĩ na vinya na ũtheu mũnene mũtisu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.27",
            "verseOrgIds": [
              "LUK.21.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 21:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.4.4"
              },
              "items": [
                {
                  "text": "Avi 4.4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
