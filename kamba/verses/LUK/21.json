                  "text": "5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ yĩla maũndũ asu makambĩlĩlya kwĩkĩka, sisyai ĩũlũ, na ũkĩlyai mĩtwe yenyu; nũndũ wovosyo wenyu nĩ mũthengeeu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.28",
            "verseOrgIds": [
              "LUK.21.28"
            ]
          }
        }
