                  "text": "Yel 5.29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ matukũ asu nĩ ma ũĩvanĩsyo, nĩ kana maũndũ onthe ala maandĩkĩtwe meanĩw’e. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.22",
            "verseOrgIds": [
              "LUK.21.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 21:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.7.26"
              },
              "items": [
                {
                  "text": "1 Ako 7.26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Woo nĩ wa ala aito na wa ala mekwongya mĩthenya ĩsu! Nũndũ kũkethĩwa ũnyamao mũnene nthĩ, na ũthilĩku ĩũlũ wa andũ aa. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.23",
            "verseOrgIds": [
              "LUK.21.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 21:24"
          },
          "items": [
