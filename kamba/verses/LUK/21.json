            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ yĩla mwĩona Yelusaleme yeelingĩlwa nĩ ita, manyai kana wanangĩko wayo wĩ vakuvĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.20",
            "verseOrgIds": [
              "LUK.21.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩvinda yĩu ala me Yutia makie mathi iĩmanĩ; na ala me nthĩnĩ wayo maume vo; na ala me ndee matikavote vo. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.21",
            "verseOrgIds": [
              "LUK.21.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
