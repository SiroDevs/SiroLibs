                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.12.25"
              },
              "items": [
                {
                  "text": "Yoa 12.25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũndũ akyũka kwakwa atamenete ĩthe wake, na inyia, na mũka, na syana syake, na ana‐a‐inyia na eĩtu‐a‐inyia, ĩĩ, o na thayũ wake, ndatonya kwĩthĩwa e mũmanyĩw’a wakwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.26",
            "verseOrgIds": [
              "LUK.14.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 14:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.9.23"
              },
              "items": [
                {
                  "text": "Lk 9.23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "O ũla ũtakuaa ngelan’yo yake, aingatĩĩa, ndatonya kwĩthĩwa e mũmanyĩw’a wakwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.27",
            "verseOrgIds": [
              "LUK.14.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 14:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũũ kwenyu, akyenda kwaka nyũmba yĩ mũnyoolo ũtambaa kwĩkala nthĩ na kũtala mbesa sya kũmyakĩthya, nĩ kana amanye ethĩwa e nasyo sya kũmĩmina? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.28",
            "verseOrgIds": [
              "LUK.14.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 14:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndakese kwĩthĩa aaka wambĩlĩlyo, na ndatonya kũmĩmina, onthe ala monaa mambĩlĩlye ũmũthekeea, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.29",
            "verseOrgIds": [
              "LUK.14.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 14:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "makyasya, Mũndũ ũũ nĩwambĩlĩlye kwaka, na nĩwaemiwe nĩ ũminũkĩlya. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.30",
            "verseOrgIds": [
              "LUK.14.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 14:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana nĩ mũsumbĩ wĩva akĩthi kũkita na mũsumbĩ ũngĩ ũtambaa kwĩkala nthĩ na kũsũanĩa kana we, e na andũ ngili ĩkũmi, nũtonya kũkomana na ũla ũmũkĩe wĩ na andũ ngili mĩongo ĩlĩ? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.31",
            "verseOrgIds": [
              "LUK.14.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 14:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ethĩwa ti ũu, nũnũũtũmana, yĩla ũsu wĩ kũasa, amũkũlye ũndũ matonya kwĩthĩwa na mũuo. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.32",
            "verseOrgIds": [
              "LUK.14.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LUK 14:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwondũ wa ũu kĩla ũmwe wenyu ũla ũteũekana na syonthe ila wĩ nasyo, ndatonya kwĩthĩwa mũmanyĩw’a wakwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.33",
            "verseOrgIds": [
              "LUK.14.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LUK 14:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.5.13"
              },
              "items": [
                {
                  "text": "Mt 5.13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.9.50"
              },
              "items": [
                {
                  "text": "Mko 9.50",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũnyũ nĩ mũseo: ĩndĩ ethĩwa nũthelete mũsamo waw’o, ũkasamĩthw’a ĩngĩ na kyaũ? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.34",
            "verseOrgIds": [
              "LUK.14.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 14:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ti mũseo wa kwĩkĩa mũũndanĩ kana vũũnĩ: ĩndĩ ũkekw’a ĩtheka. Ũla wĩ matũ ma kwĩw’a, nĩew’e.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.35",
            "verseOrgIds": [
              "LUK.14.35"
            ]
          }
        }
      ]
    }
