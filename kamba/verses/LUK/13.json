                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.21.19"
              },
              "items": [
                {
                  "text": "21.19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.11.13"
              },
              "items": [
                {
                  "text": "Mko 11.13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.3.9"
              },
              "items": [
                {
                  "text": "Lk 3.9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake aneena ngelekan’yo ĩno; Mũndũ ũmwe aĩ na mũkũyũ ũvandĩtwe mũũndanĩ wake wa mĩsavivũ; nake ooka akĩmantha makũyũ mũkũyũnĩ ũsu, na ndaamona. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.6",
            "verseOrgIds": [
              "LUK.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na amwĩa mũĩmi wa mĩsavivũ, Sisya, myaka ĩno ĩtatũ nũkaa kũmantha makũyũ mũkũyũnĩ ũũ, na ndyaamona: ũteme; wĩanangĩa nthĩ kĩ? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.7",
            "verseOrgIds": [
              "LUK.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2PE.3.9"
              },
              "items": [
                {
                  "text": "2 Vet 3.9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2PE.3.15"
              },
              "items": [
                {
                  "text": "15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake asũngĩa, amwia, Vwana, ekana naw’o mwaka ũũ, nambe kũĩmĩa na kwĩkĩa vũũ: ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.8",
            "verseOrgIds": [
              "LUK.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "na ĩndĩ wasyaa, nĩ ũseo; na walea ũsyaa, ũkatema.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.9",
            "verseOrgIds": [
              "LUK.13.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.9",
            "verseOrgIds": [
              "LUK.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mũthenya wa savato ekala ĩsinakokenĩ yĩmwe akĩmanyĩsya. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.10",
            "verseOrgIds": [
              "LUK.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na sisya, nĩvo vaĩ mũndũ mũka ũla waĩ na veva wa wonzu ĩvinda ya myaka ĩkũmi na nyanya; na nĩwakungulele, na ndaĩ atonya kũũngalala nongi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.11",
            "verseOrgIds": [
              "LUK.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesũ amwona, amwĩta, na amwĩa, Mũndũ mũka, nĩwathaw’a wonzu waku. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.12",
            "verseOrgIds": [
              "LUK.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.7.32"
              },
              "items": [
                {
                  "text": "Mko 7.32",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na amwilĩĩla moko make: na kavinda kau aũngalala, na amũkatha Ngai. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.13",
            "verseOrgIds": [
              "LUK.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.20.9"
              },
              "items": [
                {
                  "text": "Kuma 20.9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.5.13"
              },
              "items": [
                {
                  "text": "Kũt 5.13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mũnene wa ĩsinakoke athata nũndũ Yesũ wavosya mũthenya wa savato, na asũngĩa na ayĩa ĩkomano, Kwĩ mĩthenya thanthatũ ĩla andũ maĩlwe nĩ kũtethya wĩa: mĩthenya ĩsu ũkai mũvow’e, ĩndĩ ti mũthenya wa savato. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.14",
            "verseOrgIds": [
              "LUK.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.14.5"
              },
              "items": [
                {
                  "text": "Lk 14.5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ Mwĩaĩi amũsũngĩa, amwĩa, Inyw’ĩ angangan’ya, kĩla mũndũ wenyu ndathaasya ng’ombe kana ĩng’oi yake vala yovetwe mũthenya wa savato, akatwaa kũnyithya? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.15",
            "verseOrgIds": [
              "LUK.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.19.9"
              },
              "items": [
                {
                  "text": "Lk 19.9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.3.25"
              },
              "items": [
                {
                  "text": "Meko 3.25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mũndũ mũka ũũ, mwĩĩtu wa Avalaamu, ũla wovetwe nĩ Satani myaka ĩno ĩkũmi na nyanya, ndaĩlwe nĩ kũthaw’a kuma wovonĩ ũũ mũthenya wa savato? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.16",
            "verseOrgIds": [
              "LUK.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na akĩneena maũndũ asu nthũ syake syonthe syasonoka; na ĩkomano yonthe yatana ũndũ wa maũndũ asu onthe maseo ala meekiwe nĩwe.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.17",
            "verseOrgIds": [
              "LUK.13.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.17",
            "verseOrgIds": [
              "LUK.13.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ asya, Ũsumbĩ wa Ngai ũtilyĩ ata? Na nĩũelekan’ya na kyaũ? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.18",
            "verseOrgIds": [
              "LUK.13.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.4.12"
              },
              "items": [
                {
                  "text": "Nda 4.12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.4.21"
              },
              "items": [
                {
                  "text": "21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.17.23"
              },
              "items": [
                {
                  "text": "Esek 17.23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
