              "items": [
                {
                  "text": "12.8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "na nĩ kana maumye nthembo o tondũ kwaĩtw’e mĩaonĩ ya Mwĩaĩi, Ndumbũ ilĩ, kana maswii elĩ ma mavũĩ.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.24",
            "verseOrgIds": [
              "LUK.2.24"
            ]
          }
        }
