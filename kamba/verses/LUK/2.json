              "items": [
                {
                  "text": "2.52",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kana kaneneva, na keethĩwa na vinya, na kausũwa nĩ ũĩ: na mumo wa Ngai waĩ ĩũlũ wako.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.40",
            "verseOrgIds": [
              "LUK.2.40"
            ]
          }
        }
