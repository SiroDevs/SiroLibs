              },
              "items": [
                {
                  "text": "15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "(o tondũ kũandĩkĩtwe mĩaonĩ ya Mwĩaĩi, Kala kaũme kakasyawa mbee kaketawa katheu ka Mwĩaĩi), ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.23",
            "verseOrgIds": [
              "LUK.2.23"
            ]
          }
        },
        {
