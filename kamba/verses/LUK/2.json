                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na matukũ meanĩa ma kwĩthesya kwoo kwĩanana na mĩao ya Mose, mambata nako Yelusaleme, kakanenganwe kwa Mwĩaĩi ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.22",
            "verseOrgIds": [
              "LUK.2.22"
            ]
          }
        },
        {
