            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yesũ aendeea akyũĩva na akĩana, e mwaĩlu kwa Ngai na kwa andũ.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.52",
