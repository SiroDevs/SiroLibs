              "items": [
                {
                  "text": "Ali 12.3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na matukũ nyanya mavika ma kũkaĩka, syĩtwa yako keetwa Yesũ, o tondũ keetiwe nĩ mũlaĩka katanamba kũitavwa.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.21",
