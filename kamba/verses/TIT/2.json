            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngombo syĩnyivye kwa mavwana masyo, na syĩthĩwe ĩkĩmendeesya maũndũnĩ onthe; itikatũngĩthasya; ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.9",
            "verseOrgIds": [
              "TIT.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "TIT 2:10"
