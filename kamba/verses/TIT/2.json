                  "text": "1 Vet 2.15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "na ndeto syaĩle itatonya kũsilĩlwa; nĩ kana ũla ũkwenda ũkũvinganĩsya atonye kũsonoka, nũndũ ndakethĩwa na ndeto sya kũtũneenea. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.8",
            "verseOrgIds": [
              "TIT.2.8"
            ]
          }
        },
