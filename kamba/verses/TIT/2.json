                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "maũndũnĩ onthe ũkĩyonan’ya mwene wĩ ngelekan’yo ya meko maseo; ũmanyĩsyonĩ waku ũkyonan’ya ũndũ ũla ũtatonya kũthũkya, na kĩkĩo, ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.7",
            "verseOrgIds": [
              "TIT.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "TIT 2:8"
          },
          "items": [
