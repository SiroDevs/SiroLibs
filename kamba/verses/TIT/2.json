                "loc": "1TI.5.1"
              },
              "items": [
                {
                  "text": "1 Tim 5.1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "atĩ atumĩa akũũ methĩwe na wĩting’o, na kĩkĩo, na kĩlĩko, methĩwe aima mũĩkĩĩonĩ, na wendonĩ, na wũmĩĩsyonĩ: ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.2",
            "verseOrgIds": [
              "TIT.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "TIT 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.3.11"
              },
              "items": [
                {
                  "text": "1 Tim 3.11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "na ivetĩ ngũũ nasyo no ta ũu syĩthĩwe na mwĩkalĩle wa ũtheu, ite nzũkani kana ngombo sya mbinyu mbingĩ, syĩthĩwe amanyĩsya ma maũndũ ala maseo; ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.3",
            "verseOrgIds": [
              "TIT.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "TIT 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "nĩ kana imanyĩasye aka ma mũika kwenda aũme moo, na kũsyenda syana syoo, ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.4",
            "verseOrgIds": [
              "TIT.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "TIT 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.5.22"
              },
              "items": [
                {
                  "text": "Aev 5.22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "methĩwe na kĩlĩko, mate na wathe, atethya ma wĩa mĩsyĩ kwoo, kwĩka angĩ nesa, na kwĩnyivya kwa aũme moo ene, nĩ kana ndeto ya Ngai ndĩkaumwe: ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.5",
            "verseOrgIds": [
              "TIT.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "TIT 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "aũme mate akũũ nao mataae methĩwe na kĩlĩko: ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.6",
            "verseOrgIds": [
              "TIT.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "TIT 2:7"
          },
          "items": [
