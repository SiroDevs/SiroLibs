                  "text": "Tito 1.3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "na itikethĩwe osangi ma syĩndũ, ĩndĩ ikyonan’ya kĩthito kĩseo kyonthe; nĩ kana syanakavye maũndũnĩ onthe ũmanyĩsyo wa Ngai Mũtangĩĩi waitũ.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.10",
