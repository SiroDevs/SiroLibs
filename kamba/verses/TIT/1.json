              "attrs": {
                "loc": "2TI.2.24"
              },
              "items": [
                {
                  "text": "2 Tim 2.24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ mũsyaĩĩsya nĩwaĩle kwĩthĩwa ataweteka ũndũ ũthũku, ta mũsũvĩi maũndũnĩ ma Ngai; na ndakethĩwe na mĩtavyo, kana kũthata mitũkĩ, ndakethiwe mũnywi wa ũki, kana mũkũni wa andũ, ndakethiwe mwendi wa kũunwa nĩ syĩndũ itamwaĩle; ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.7",
            "verseOrgIds": [
              "TIT.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "TIT 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "ĩndĩ ethĩwe mũthokya wa aeni, na mwendi wa ũseo, ũla wĩ na kĩlĩko, mũndũ mũlũngalu, mũndũ mũtheu, na mwĩting’u; ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.8",
            "verseOrgIds": [
              "TIT.1.8"
            ]
          }
        },
