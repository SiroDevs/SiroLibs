                {
                  "text": "1 Vet 5.2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "namo mũvaka makanyw’a moo mavindĩthw’e; andũ ala makulumanasya nyũmba nĩma sya andũ, makimanyĩsya maũndũ mataĩle, kwondũ wa kwenda kũunwa nĩ syĩndũ itamaĩle. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.11",
            "verseOrgIds": [
              "TIT.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
