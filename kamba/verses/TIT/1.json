          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwondũ wa ũndũ ũũ nakũtiie Kilete, nĩ kana maũndũ ala matiele kwikwa ũmaseũvye, na kwia atumĩa kĩla ndũa, o tondũ nakwĩaĩe; ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.5",
            "verseOrgIds": [
              "TIT.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "TIT 1:6"
          },
          "items": [
