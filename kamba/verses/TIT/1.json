                {
                  "text": "11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ĩndĩ mavindanĩ make nĩwavuanisye ndeto yake nthĩnĩ wa ũtũmane, ũla nyie naĩkĩĩwe nĩthĩwe naw’o kwondũ wa mwĩao wa Ngai Mũtangĩĩi waitũ; ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.3",
            "verseOrgIds": [
              "TIT.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "TIT 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.1.2"
              },
              "items": [
                {
                  "text": "1 Tim 1.2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "valũa ũũ wakwa ũmũvikĩe Tito, mwana wakwa wa w’o nũndũ wa mũĩkĩĩo ũmwe ũla twĩ naw’o: Mumo na mũuo kuma kwa Ngai Asa na Klĩsto Yesũ Mũtangĩĩi waitũ.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.4",
            "verseOrgIds": [
              "TIT.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
