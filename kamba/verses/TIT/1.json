              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ kwi mbaa matũ mbingĩ, aneenĩ ma ndeto sya mana na akengani, na mũno nĩ ma ala maĩkawa, ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.10",
            "verseOrgIds": [
              "TIT.1.10"
            ]
          }
        },
