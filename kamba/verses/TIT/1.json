              "items": [
                {
                  "text": "2 Tim 4.3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ailũmya ndeto ĩla ya kĩthito ĩla yĩanene na ũla ũmanyĩsyo, nĩ kana atonye kũtaa ũmanyĩsyonĩ ũla wa w’o, vamwe na kũmaĩkĩĩthya akananĩi mavĩtyo.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.9",
            "verseOrgIds": [
              "TIT.1.9"
            ]
          }
        }
