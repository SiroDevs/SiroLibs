          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.3.2+1TI.3.3+1TI.3.4"
              },
              "items": [
                {
                  "text": "1 Tim 3.2–4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ethĩwa mũndũ ndaweteka ũndũ ũthũku, na nĩ mũũme wa kiveti o kimwe, ũla wĩ na syana syĩtikĩlaa, itavinganĩw’a kwĩthĩwa na ngũlũ na wau wa matũ. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.6",
            "verseOrgIds": [
              "TIT.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
