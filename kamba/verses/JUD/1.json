            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na yu nĩngwenda kũmũlilikan’ya, o na kau nĩmũminĩte kũmanya maũndũ onthe, ũndũ Mwĩaĩi wambie kũtangĩĩa andũ kũmaumya nthĩ ya Misili, na ĩtina nĩwamanangie ala mataaĩtĩkĩla. ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.5",
            "verseOrgIds": [
              "JUD.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JUD 1:6"
          },
