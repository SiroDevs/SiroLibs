            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2PE.2.12"
              },
              "items": [
                {
                  "text": "2 Vet 2.12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ andũ aa nĩmaumaa maũndũ matesĩ: na maũndũ ala mamanyaa na ũĩ wa mwĩĩ, maũndũnĩ asu nĩmeyanangaa, o ta nyamũ ite na kĩlĩko. ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.10",
            "verseOrgIds": [
              "JUD.1.10"
            ]
          }
        },
