                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ Mikaeli ũla mũlaĩka mũnene, yĩla wakandanĩe na ndevili na ũkananĩa nake ũndũ wa mwĩĩ wa Mose, ndaatata kũmũvinganĩsya ta kũmũuma, ĩndĩ aisye, Mwĩaĩi nakũkan’ye. ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.9",
            "verseOrgIds": [
              "JUD.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JUD 1:10"
          },
          "items": [
