        },
        {
          "text": "Yuta, ngombo ya Yesũ Klĩsto, na mwana‐a‐inyia wa Yakovo, valũa ũũ wakwa ũmavikĩe ala meetiwe, endwa nthĩnĩ wa Ngai Asa, na asũvĩwa ũndũ wa Yesũ Klĩsto: ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.1",
            "verseOrgIds": [
              "JUD.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JUD 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tei na mũuo na wendo nĩmaingĩv’we kwenyu.",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.2",
            "verseOrgIds": [
              "JUD.1.2"
            ]
          }
        },
