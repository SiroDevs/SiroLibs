              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Ndaviti ookĩla, na akũka mũthenya ũsu nũndũ wa kũkĩa Saulo, na athi kwa Akisi, mũsumbĩ wa Ngathi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.10",
