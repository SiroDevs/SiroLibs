              },
              "items": [
                {
                  "text": "1 Sam 30.6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.16",
            "verseOrgIds": [
              "1SA.23.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na amwĩa, Ndũkakĩe; nũndũ kw’oko kwa Saulo ĩthe wakwa kũikakwona; naku ũkeethĩwa mũsumbĩ wa Isilaeli, nakwa ngeethĩwa nĩ wa kelĩ ũsumbĩnĩ; na Saulo ĩthe wakwa nĩwĩsĩ ũu naw’o. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.17",
            "verseOrgIds": [
              "1SA.23.17"
            ]
          }
        },
        {
