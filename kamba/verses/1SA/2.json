          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Eli amũathima Elikana na mũka wake, na amwĩa, Yeova nakũnenge ũsyao kwa kĩveti kĩĩ nũndũ wa kyu kĩla kyeetiw’e kwa Yeova. Na menũka mũsyĩ kwoo. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.20",
            "verseOrgIds": [
              "1SA.2.20"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
