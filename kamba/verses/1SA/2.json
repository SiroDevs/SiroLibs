          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yeova amũkĩa Aana, na aitava, na asyaa ana atatũ na eĩtu elĩ. Na kamwana Samueli keana ke o mbee wa Yeova. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.21",
            "verseOrgIds": [
              "1SA.2.21"
            ]
          }
        },
