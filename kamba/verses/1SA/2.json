              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Elikana athi Lama nyũmba kwake. Na ũ mwana amũthũkũmaa Yeova e mbee wa mũthembi Eli.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.11",
