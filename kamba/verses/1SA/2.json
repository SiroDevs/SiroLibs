          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kĩmanyĩo kya athembi andũnĩ kyaĩ, atĩ yĩla mũndũ o na wĩva wathembaa nthembo, mũthũkũmi wa mũthembi nĩwokaa yĩla nyama iũtheũka, akwete kĩtonyi kya nyama kĩ maeo atatũ kw’okonĩ kwake; ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.13",
            "verseOrgIds": [
              "1SA.2.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
