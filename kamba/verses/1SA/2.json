              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ Samueli athũkũmaa vu mbee wa Yeova, e o kana, ekĩĩte evoti ya katane. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.18",
            "verseOrgIds": [
