          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yeova nũkwĩkĩte, o tondũ waneenie na kanyw’a wakwa: na Yeova nũvenanĩte ũsumbĩ kw’okonĩ kwaku, na akonenga mũtũi waku, o Ndaviti. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.17",
            "verseOrgIds": [
              "1SA.28.17"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
