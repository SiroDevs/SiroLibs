          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Samueli amũkũlya, Wĩngũlya nĩkĩ ĩndĩ, na Yeova nake nũkũtiĩte, na atw’ĩkĩte mũmaitha waku? ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.16",
            "verseOrgIds": [
              "1SA.28.16"
            ]
          }
        },
        {
          "name": "note",
