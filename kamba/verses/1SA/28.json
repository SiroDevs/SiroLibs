        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.18",
            "verseOrgIds": [
              "1SA.28.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 28:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "O na ĩngĩ Yeova akanengane Isilaeli o vamwe naku kw’okonĩ kwa Avilisiti; na ũnĩ we na ana maku mũkeethĩwa vamwe nakwa: Yeova nake akanengane nguthu ya Isilaeli nayo kw’okonĩ kwa Avilisiti. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.19",
            "verseOrgIds": [
              "1SA.28.19"
            ]
          }
        },
