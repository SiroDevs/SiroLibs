        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 28:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩvo Saulo wameie athũkũmi make, Manthĩai mũndũ mũka wĩsene na veva, nĩ kana nĩende kwake, na ngĩkũlya kwake. Na athũkũmi make mamwĩa, Sisya, kwĩ mũndũ mũka wĩsene na veva ku Eni‐ndoli. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.7",
            "verseOrgIds": [
              "1SA.28.7"
            ]
          }
        },
