              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.15",
            "verseOrgIds": [
              "1SA.30.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 30:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na yĩla wamũtheeisye, sisya, manyaĩĩkĩte nthĩ yonthe, makĩya, na makĩnyw’a, na makĩsũnga, nũndũ wa mũtavo ũsu w’onthe mũnene ũla matavĩte nthĩ ya Avilisiti, na nthĩ ya Yuta. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.16",
            "verseOrgIds": [
              "1SA.30.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 30:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Ndaviti amakũna kuma kwĩ ũmithi o kũvika wĩoo wa ũnĩ ũla ũngĩ: na kũtyaavonoka mũndũ wamo, ate o anake maana ana, ala makuĩtwe nĩ ngamĩle na makĩie. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.17",
            "verseOrgIds": [
              "1SA.30.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 30:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Ndaviti atũnga syonthe ila Aamaleki matwaĩte, na Ndaviti atangĩĩa iveti syake ilĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.18",
            "verseOrgIds": [
              "1SA.30.18"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.30.8"
              },
              "items": [
                {
                  "text": "1 Sam 30.8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.18",
            "verseOrgIds": [
              "1SA.30.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 30:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kũtyaĩ kĩndũ kyaatiala kwoo, kĩnini kana kĩnene, ana o na eĩtu, o na mũtavo, o na kĩndũ o na kĩva kĩla meetavĩe: Ndaviti nĩwatũngie syonthe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.19",
            "verseOrgIds": [
              "1SA.30.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 30:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Ndaviti oosa ndĩthya syonthe sya mbũi na malondu na sya ng’ombe, ila maingĩte mbee wa indo ila ingĩ, na asya, Ii nĩ mũtavo wa Ndaviti.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.20",
            "verseOrgIds": [
              "1SA.30.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 30:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.20",
            "verseOrgIds": [
              "1SA.30.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 30:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Ndaviti avika vala ve ala andũ maana elĩ, ala maĩ anyalu mataĩ matonya kũmũatĩĩa Ndaviti, o ala mamatiĩlĩte kalũsĩnĩ Mbesoli; na mauma mamũthaũe Ndaviti, na kũthaũa andũ ala maĩ nake: na yĩla Ndaviti wathengeeie andũ, amakethya. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.21",
            "verseOrgIds": [
              "1SA.30.21"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.30.10"
              },
              "items": [
                {
                  "text": "1 Sam 30.10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.21",
            "verseOrgIds": [
              "1SA.30.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 30:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩvo ĩndĩ andũ athũku o na ala athe onthe, katĩ wa asu maendie na Ndaviti, masũngĩie, na masya, Nĩkwĩthĩwa matyaaenda naitũ, tũtikamenenga kĩndũ o na kĩmwe kya mũtavo ũla tũtũngĩte, ate o kĩla mũndũ kĩveti kyake na syana syake, nĩ kana amatongoesye, mathi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.22",
            "verseOrgIds": [
              "1SA.30.22"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.25.17"
              },
              "items": [
                {
                  "text": "1 Sam 25.17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.22",
            "verseOrgIds": [
              "1SA.30.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1SA 30:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩvo ĩndĩ Ndaviti waisye, Mũtitonya kwĩka ũu, ana‐a‐asa makwa, na kĩla Yeova ũtũnengete, ũla ũtũsũvĩĩte, na kũnengane kw’okonĩ kwitũ nguthu ĩla yatũvithũkĩe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.23",
            "verseOrgIds": [
              "1SA.30.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1SA 30:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na nũũ ũla wĩmwĩthukĩĩsya ũndũnĩ ũũ? Nũndũ o tondũ kĩanda kya ũla ũkatheeaa kaũnĩ kĩkethĩawa, now’o kĩanda kya ũla ũkekalaa na mĩio kĩkethĩawa: makaaĩawa ũndũ ũmwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.24",
            "verseOrgIds": [
              "1SA.30.24"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
