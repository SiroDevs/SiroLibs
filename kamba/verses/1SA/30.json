            "sid": "1SA 30:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Ndaviti amũkũlya, Ũkandwaa kũla kwĩ nguthu ĩsu? Na asũngĩa, Mbĩavĩa Ngai, kana ndũkambũaa, o na kũnengane mokonĩ ma vwana wakwa, nakwa ngakũtheesya kũla kwĩ nguthu ĩsu.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.15",
            "verseOrgIds": [
              "1SA.30.15"
            ]
          }
        }
