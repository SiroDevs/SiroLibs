                {
                  "text": "Asi 15.19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.12",
            "verseOrgIds": [
              "1SA.30.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 30:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Ndaviti amũkũlya, Wĩ waũ? Na wumĩte va? Na asũngĩa, Nyie nĩ mwanake wa ku Misili, mũthũkũmi wa Mũamaleki; na vwana wakwa nĩwandiie, nĩkwĩthĩwa yu nĩ matukũ atatũ nĩ mũwau. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.13",
            "verseOrgIds": [
              "1SA.30.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 30:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩtwavithũkie ngalĩ ya Ĩtheo ya Akelethi, na kũla kwa Yuta, na ngalĩ ya Ĩtheo ya Kalevu; na twavĩvya Nzikilaki na mwaki. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.14",
            "verseOrgIds": [
              "1SA.30.14"
            ]
          }
        },
