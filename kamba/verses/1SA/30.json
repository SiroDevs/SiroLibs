            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.23.2"
              },
              "items": [
                {
                  "text": "1 Sam 23.2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.23.4"
              },
              "items": [
                {
                  "text": "4",
                  "type": "text"
                }
              ]
