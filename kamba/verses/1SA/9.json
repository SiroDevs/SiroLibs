              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ Yeova aĩ anamũvuanĩisye Samueli ta ĩoo Saulo atanoka, akĩmwĩa, ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.15",
