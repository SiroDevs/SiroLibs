              },
              "items": [
                {
                  "text": "Mwa 24.11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.11",
            "verseOrgIds": [
              "1SA.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namo mamasũngĩa, na masya, E vo; sisyai, e vu mbee wenyu: ĩkalaatei yu, nũndũ ookie ndũanĩ ũmũnthĩ; nũndũ andũ nĩmeũthemba ũmũnthĩ vala vandũ vatũlu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.12",
            "verseOrgIds": [
              "1SA.9.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
