          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩvo ĩndĩ Saulo wamwĩie mũthũkũmi wake, Waneena nesa; ũka, tũthi. Kwondũ wa ũu mathi ndũanĩ vala ũ mũndũ wa Ngai waĩ.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.10",
            "verseOrgIds": [
              "1SA.9.10"
            ]
          }
        }
      ]
    },
    {
