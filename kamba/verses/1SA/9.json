                {
                  "text": "1 Sam 16.12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.17",
            "verseOrgIds": [
              "1SA.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩvo ĩndĩ Saulo wamũthengee Samueli mbingĩlonĩ, na amwĩa, Ndavya, nĩngũkwĩsũva, vala nyũmba ya mwoni ĩĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.18",
            "verseOrgIds": [
              "1SA.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Samueli amũsũngĩa Saulo, na amwĩa, Ninyie mwoni; ambata ũndongoesye kũvika vala vandũ vatũlu, nũndũ mũkaya vamwe nakwa ũmũnthĩ: na kĩoko ngakũeka ũthi, na kũũtavya w’onthe ũla wĩ ngoonĩ yaku. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.19",
            "verseOrgIds": [
              "1SA.9.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ũndũ wa mang’oi maku ala manaaie yu nĩ mĩthenya ĩtatũ mĩthelu, ndũkethĩn’ye ũndũ wamo; nũndũ nĩ moneku. Na w’onthe ũla ũkwendwa katĩ wa Isilaeli nĩ ũndũ waũ? Ti ũndũ waku, na ũndũ wa nyũmba yonthe ya ithe waku? ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.20",
            "verseOrgIds": [
              "1SA.9.20"
            ]
          }
        },
        {
