          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩtina wa matheea kuma vala vandũ vatũlu makĩlika ndũanĩ, aneenanĩsya na Saulo nyũmbanĩ ĩũlũ. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.25",
            "verseOrgIds": [
              "1SA.9.25"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
