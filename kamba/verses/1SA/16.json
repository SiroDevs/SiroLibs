          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwondũ wa ũu Saulo atũma atũmwa kwa Yese, na amwĩa, Tũma kwakwa Ndaviti mwana waku, ũla wĩ vamwe na malondu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.19",
            "verseOrgIds": [
              "1SA.16.19"
            ]
          }
        },
