                  "text": "1 Sam 17.18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.20",
            "verseOrgIds": [
              "1SA.16.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 16:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Ndaviti avika kwa Saulo, na aũngama mbee wake: nake amwenda mũno; na atw’ĩka mũkui wa mĩio yake ya kaũ. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.21",
            "verseOrgIds": [
              "1SA.16.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 16:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Saulo atũmana kwa Yese, akĩmwĩa, Nĩngũkwĩsũva, ũeke Ndaviti aũngamae mbee wakwa; nũndũ nĩwonete ũseo methonĩ makwa. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.22",
            "verseOrgIds": [
              "1SA.16.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1SA 16:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kweethĩwa, yĩla veva mũthũku wumĩte kwa Ngai waĩ ĩũlũ wa Saulo, nĩvo Ndaviti wosaa mbeve, na akĩinga na kw’oko kwake: kwondũ wa ũu Saulo akĩvuũka, na akĩvoa, na ũla veva mũthũku ũkyuma vala ũĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.23",
            "verseOrgIds": [
              "1SA.16.23"
            ]
          }
