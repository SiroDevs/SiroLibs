              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kweethĩwa, mavika, amũketeea Eliavu, na asya, Vate ndĩi mwĩtĩkĩw’a mauta wa Yeova e mbee wake. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.6",
