          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yese oosa ĩng’oi yakuĩthw’a imũtũ, na kathatwa ka mbinyu, na katena ka mbũi, na aitũmanĩsya na Ndaviti mwana wake kwa Saulo. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.20",
            "verseOrgIds": [
              "1SA.16.20"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
