                "loc": "1SA.9.16"
              },
              "items": [
                {
                  "text": "1 Sam 9.16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.3",
            "verseOrgIds": [
              "1SA.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Samueli eeka o ũla Yeova waneenie, na avika Mbethi‐leemu. Na atumĩa ma ĩ ndũa mathi mamũthaũe makĩtetema, na mamũkũlya, Waetwe nĩ mũuo? ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.4",
            "verseOrgIds": [
              "1SA.16.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.2.13"
              },
              "items": [
                {
                  "text": "1 Asu 2.13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.4",
            "verseOrgIds": [
              "1SA.16.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake asya, Nĩ mũuo; nĩnooka nĩmũthembee Yeova, ĩvathan’yei mwĩthĩwe atheu, na mũkĩendan’ya nakwa nthembonĩ. Na avathan’ya Yese na ana make, na ameta moke nthembonĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.5",
            "verseOrgIds": [
              "1SA.16.5"
            ]
          }
        },
        {
