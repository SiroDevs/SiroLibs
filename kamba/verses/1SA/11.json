                "loc": "LUK.19.27"
              },
              "items": [
                {
                  "text": "Lk 19.27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.11.12",
            "verseOrgIds": [
              "1SA.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
