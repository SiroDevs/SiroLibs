          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na andũ mamũkũlya Samueli, Nũũ ũla ũnakũlilye, Saulo akatũsumbĩka? Ete andũ asu, kana tũmoae. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.11.12",
            "verseOrgIds": [
              "1SA.11.12"
            ]
          }
        },
