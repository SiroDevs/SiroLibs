              "1SA.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ ũndũ ũsu wamwĩw’ĩthisye Samueli woo, yĩla maisye, Tũnenge mũsumbĩ wa kũtũsilanasya. Na Samueli avoya Yeova. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.6",
            "verseOrgIds": [
              "1SA.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yeova amwĩa Samueli, Ĩthukĩĩsye wasya wa andũ maũndũnĩ onthe ala meũkũtavya: nũndũ maikũleete we, ĩndĩ ninyie maleete, nĩ kana ndikethĩwe mũsumbĩ ĩũlũ woo. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.7",
            "verseOrgIds": [
              "1SA.8.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.16.8"
              },
              "items": [
                {
                  "text": "Kuma 16.8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.10.19"
              },
              "items": [
                {
                  "text": "1 Sam 10.19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.7",
            "verseOrgIds": [
              "1SA.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwĩanana na mawĩa onthe ala meekie kuma mũthenya ũla namambatisye kũmaumya nthĩ ya Misili o na kũvika mũthenya ũũ, o ũndũ mandiĩte, na makathũkũmaa ngai ingĩ, nĩmeũkwĩka o ta ũu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.8",
            "verseOrgIds": [
              "1SA.8.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.2.12"
              },
              "items": [
                {
                  "text": "Asi 2.12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.10.13"
              },
              "items": [
                {
                  "text": "10.13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.8",
            "verseOrgIds": [
              "1SA.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwondũ wa ũu ĩndĩ ĩthukĩĩsye wasya woo: ĩndĩ ũkamakũsĩĩe vyũ, na ũkamon’ye mũthemba wa mũsumbĩ ũla wĩmasumbĩka. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.9",
            "verseOrgIds": [
              "1SA.8.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.10.25"
              },
              "items": [
                {
                  "text": "1 Sam 10.25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
