          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "nĩ kana naitũ tũtonye kwĩthĩwa tũilyĩ ta mbaĩ syonthe, na nĩ kana mũsumbĩ waitũ atonye kũtũsilanasya, na kũendaa mbee waitũ, na kũtũkitĩthasya makaũ. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.20",
            "verseOrgIds": [
              "1SA.8.20"
            ]
          }
        },
