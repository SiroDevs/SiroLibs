              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Samueli eew’a ndeto syonthe sya andũ, nake aineena o ta ũu matũnĩ ma Yeova. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.21",
