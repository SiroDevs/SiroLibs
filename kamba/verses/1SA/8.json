            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.9",
            "verseOrgIds": [
              "1SA.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Samueli amatavya andũ ala mamũkũlilye mũsumbĩ ndeto syonthe sya Yeova. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.10",
            "verseOrgIds": [
              "1SA.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na amea, Mũsumbĩ ũla wĩmũsumbĩka akeethĩwa ailyĩ ũũ: akoosaa ana menyu, na kũmaia methĩwe make, nũndũ wa makasya make, na kũtw’ĩka andũ make ma ũtũlaa mbalasi; na makasembaa matongoesye makasya make; ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.11",
            "verseOrgIds": [
              "1SA.8.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.17.16"
              },
              "items": [
                {
                  "text": "Kũt 17.16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.14.52"
              },
              "items": [
                {
                  "text": "1 Sam 14.52",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.1.5"
              },
              "items": [
                {
                  "text": "1 Asu 1.5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.11",
            "verseOrgIds": [
              "1SA.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "na akamaiaa methĩwe kwake makavuteni ma ngili ngili, na makavuteni ma mĩongo ĩtano mĩongo ĩtano; na akaiaa amwe ma kũĩmaa nthĩ yake, na kũkethaa ngetha yake, na kũtuaa mĩio yake ya kaũ na mĩio ya makasya make. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.12",
            "verseOrgIds": [
              "1SA.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na akoosaa eĩtu menyu methĩawe aseũvya ma manukato, na kwĩthĩawa aui, na kwĩthĩawa aui ma mĩkate. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.13",
            "verseOrgIds": [
              "1SA.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na akoosaa mĩũnda yenyu, na mĩũnda yenyu ya mĩsavivũ, na mĩũnda yenyu ya mĩthata, o na ĩla mĩseo mbee yayo, na aimĩnenga athũkũmi make. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.14",
            "verseOrgIds": [
              "1SA.8.14"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.21.7"
              },
              "items": [
                {
                  "text": "1 Asu 21.7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.46.18"
              },
              "items": [
                {
                  "text": "Esek 46.18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.14",
            "verseOrgIds": [
              "1SA.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na akoosaa kĩlungu kya ĩkũmi kya mbeũ syenyu, na kya mĩũnda yenyu ya mĩsavivũ, na akĩmanenga anene ma kwake, na athũkũmi make. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.15",
            "verseOrgIds": [
              "1SA.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na akoosaa athũkũmi menyu aũme, na athũkũmi menyu eĩtu, na anake menyu ala aseo mbee, na mang’oi menyu, na kũmekĩaa wĩanĩ wake. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.16",
            "verseOrgIds": [
              "1SA.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akoosaa kĩlungu kya ĩkũmi kya ndĩthya syenyu sya mbũi na malondu: na mũkeethĩawa mwĩ athũkũmi make. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.17",
            "verseOrgIds": [
              "1SA.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mũkakaya mũthenya ũsu nũndũ wa mũsumbĩ wenyu ũla mwĩĩthĩwa mwĩnyuvĩe; na Yeova ndakamũsũngĩa mũthenya ũsu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.18",
            "verseOrgIds": [
              "1SA.8.18"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
