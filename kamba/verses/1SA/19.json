              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.12",
            "verseOrgIds": [
              "1SA.19.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Mikali oosa mũvw’anano wĩtawa telavimu, na awia ũkomonĩ, na aia mũto wa w’ĩa wa mbũi mũtwenĩ waw’o, na oovw’ĩka ngũa. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.13",
            "verseOrgIds": [
              "1SA.19.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.31.19"
              },
              "items": [
                {
                  "text": "Mwa 31.19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.13",
            "verseOrgIds": [
              "1SA.19.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na yĩla Saulo watũmie atũmwa makamũkwate Ndaviti, asya, Nĩ mũwau. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.14",
            "verseOrgIds": [
              "1SA.19.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Saulo atũma ala atũmwa makasisye Ndaviti, akĩmea, Mwambatyei kũũ nĩĩ e ũkomonĩ, nĩ kana ndonye kũmũaa. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.15",
            "verseOrgIds": [
              "1SA.19.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na yĩla ala atũmwa malikile nthĩnĩ, sisya, telavimu waĩ ũkomonĩ wĩ na mũto wa w’ĩa wa mbũi mũtwe waw’o. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.16",
            "verseOrgIds": [
              "1SA.19.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Saulo amũkũlya Mikali, Nĩkĩ ũngengie ta ũu, na waeka mũmaitha wakwa athi, na ĩndĩ avonoka? Na Mikali asũngĩa Saulo, We ambĩie, Eka nĩthi; nĩkũaĩa kĩ?",
          "type": "text",
          "attrs": {
