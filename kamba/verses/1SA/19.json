                {
                  "text": "1 Sam 1.19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.18",
            "verseOrgIds": [
              "1SA.19.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 19:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kwatavanw’a kwa Saulo, kũkyaw’a, Sisya, Ndaviti e Naiothi yĩ Lama. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.19",
            "verseOrgIds": [
              "1SA.19.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 19:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Saulo atũma atũmwa makamũkwate Ndaviti: na yĩla moonie nguthu ya athani ĩkyathana, na Samueli aũngamĩte e mũtongoi woo, Veva wa Ngai ooka ĩũlũ wa atũmwa ma Saulo, na o namo mathana. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.20",
            "verseOrgIds": [
              "1SA.19.20"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
