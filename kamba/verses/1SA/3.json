              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kweethĩwa ĩvinda yĩu, yĩla Eli wakomete vandũ vake (na yu metho make maĩ manambĩlĩlya kũya mbindu, ũndũ ũtatonya kwona), ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.2",
            "verseOrgIds": [
              "1SA.3.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
