                "loc": "GEN.27.1"
              },
              "items": [
                {
                  "text": "Mwa 27.1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.34.7"
              },
              "items": [
                {
                  "text": "Kũt 34.7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.4.15"
              },
              "items": [
                {
                  "text": "1 Sam 4.15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.2",
            "verseOrgIds": [
              "1SA.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "na taa wa Ngai ndwaĩ ũnamba kũvoa, na Samueli nĩwakomete ĩkalũnĩ ya Yeova, vala yĩla ĩsandũkũ ya Ngai yaĩ; ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.3",
            "verseOrgIds": [
              "1SA.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "nĩvo Yeova wamwĩtie Samueli: nake asya, Nĩ vaa. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.4",
            "verseOrgIds": [
              "1SA.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na asemba vala ve Eli, na amwĩa, Ninyioo; nũndũ nĩwambĩta. Nake asya, Ndinetana; koma ĩngĩ. Nake athi na akoma. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.5",
            "verseOrgIds": [
              "1SA.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yeova eetana o ĩngĩ, Samueli. Na Samueli ookĩla na athi vala ve Eli, na asya, Ninyioo; nũndũ nĩwambĩta. Nake asũngĩa, Ndinetana, mwana wakwa; koma ĩngĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.6",
            "verseOrgIds": [
              "1SA.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ũ Samueli ndambĩte kũmũmanya Yeova, o na ndeto ya Yeova ndĩambĩte kũvuanw’a kwake. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.7",
            "verseOrgIds": [
              "1SA.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yeova amwĩta Samueli ĩngĩ ĩvinda ya katatũ. Na ookĩla na athi vala ve Eli, na asya, Ninyioo; nũndũ nĩwambĩta. Na Eli amanya kana Yeova nũkwĩtaa kamwana. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.8",
            "verseOrgIds": [
              "1SA.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwondũ wa ũu Eli amwĩa Samueli, Thi, ũkakome; na kũkethĩwe atĩĩ, ethĩwa nũkũkwĩta, nĩw’o wĩasya, Neena, Yeova; nũndũ mũthũkũmi waku nũkwĩw’a. Na ĩndĩ Samueli athi na akoma vandũ vake.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.9",
            "verseOrgIds": [
              "1SA.3.9"
            ]
          }
        }
      ]
    },
