              "1SA.27.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 27:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Ndaviti akũna ĩ nthĩ, na ndaatialya mũndũ mũũme kana mũndũ mũka e thayũ, na atwaa malondu, na ng’ombe, na mang’oi, na ngamĩle, na ngũa; na asyoka, na avika kwa Akisi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.27.9",
            "verseOrgIds": [
              "1SA.27.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.15.3"
              },
              "items": [
                {
                  "text": "1 Sam 15.3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.27.9",
            "verseOrgIds": [
              "1SA.27.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 27:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Akisi amũkũlya, Ũvithũkie kwaaũ ũmũnthĩ? Na Ndaviti amũsũngĩa, Tũvithũkie ngalĩ ya Ĩtheo ya Yuta, na ngalĩ ya Ĩtheo ya Ayelameeli, na ngalĩ ya Ĩtheo ya Akeni. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.27.10",
            "verseOrgIds": [
              "1SA.27.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
