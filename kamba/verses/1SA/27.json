              "1SA.27.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 27:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Ndaviti ndaatialya mũndũ mũũme o na mũndũ mũka e thayũ, nĩ kana amaete Ngathi, akyasya, Matikese kumbũla ũndũ witũ, makyasya, Ũu now’o Ndaviti wekaa, na now’o wailyĩ ĩvinda yonthe yĩla wekalaa nthĩ ya Avilisiti. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.27.11",
            "verseOrgIds": [
              "1SA.27.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 27:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Akisi eetĩkĩla Ndaviti, akyasya, Nũtumĩte andũ make Isilaeli mamũthĩtha mũno vyũ; kwondũ wa ũu akeethĩwa mũthũkũmi wakwa tene na tene.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.27.12",
            "verseOrgIds": [
              "1SA.27.12"
            ]
          }
        }
