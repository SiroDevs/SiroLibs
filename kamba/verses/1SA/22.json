                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.14",
            "verseOrgIds": [
              "1SA.22.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyie nĩnambĩlĩlye ũmũnthĩ kũkũlya Ngai kwondũ wake? Ũu wĩthĩwe kũasa nakwa: mũsumbĩ ndakatalĩthye ũndũ o na wĩva kwa mũthũkũmi wake, kana kwa nyũmba yonthe ya asa wakwa; nũndũ mũthũkũmi waku ndesĩ ũndũ o na wĩva wa ũu w’onthe, ũnini kana ũnene. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.15",
            "verseOrgIds": [
              "1SA.22.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mũsumbĩ asya, Vate ndĩi nũũkw’a, Aimeleki, we, na nyũmba ya au yonthe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.16",
            "verseOrgIds": [
              "1SA.22.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 22:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mũsumbĩ amea asũvĩi ala mamũũngamĩe, Ĩthyũũei, na ũaai athembi ma Yeova; nĩkwĩthĩwa kw’oko kwoo nakw’o kwĩ vamwe na Ndaviti, na nĩkwĩthĩwa mo nĩmamanyie kana nĩwakĩĩte, na matyaamanyĩthya ũndũ ũsu. Ĩndĩ athũkũmi ma mũsumbĩ matyaaĩtĩkĩla kũtambũũkya kw’oko kwoo kũvalũkĩle athembi ma Yeova. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.17",
            "verseOrgIds": [
              "1SA.22.17"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
