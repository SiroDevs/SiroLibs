            "number": "9",
            "style": "v",
            "sid": "1SA 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩvo ĩndĩ Ndoeki Mũetomu, ũla waũngamĩte na athũkũmi ma Saulo, wasũngĩie, na amwĩa, Nĩnamwonie mwana wa Yese okĩte ku Novu, kwa Aimeleki mwana wa Aituvu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.9",
            "verseOrgIds": [
              "1SA.22.9"
            ]
          }
        },
        {
