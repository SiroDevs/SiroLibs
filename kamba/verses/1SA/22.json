            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Saulo amea athũkũmi make ala maũngamĩte mamũthyũlũlũkĩte, Ĩw’ai yu, inyw’ĩ Ambenyamini; mwana wa Yese akamũnenga kĩla ũmwe wenyu isesi na mĩũnda ya mĩsavivũ, akamũtw’a inyw’onthe makavuteni ma ngili ngili na makavuteni ma maana, ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.7",
            "verseOrgIds": [
              "1SA.22.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.8.14"
              },
              "items": [
                {
                  "text": "1 Sam 8.14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.7",
            "verseOrgIds": [
              "1SA.22.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "ũndũ inyw’onthe mũnzamĩĩte, na vati ũmwe ũla waamanyĩthya yĩla mwana wakwa ũnũkũseũvya wĩw’ano na mwana wa Yese, na vati ũmwe wenyu ũla ũmbĩw’ĩaa tei, kana kũmanyĩthya kana mwana wakwa nũmbulũanĩtye na mũthũkũmi wakwa, amboveesye, o tondũ ũilyĩ ũmũnthĩ? ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.8",
            "verseOrgIds": [
              "1SA.22.8"
            ]
          }
        },
        {
