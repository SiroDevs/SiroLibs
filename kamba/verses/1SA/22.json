                  "text": "1 Sam 21.7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.22",
            "verseOrgIds": [
              "1SA.22.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1SA 22:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩkala vamwe nakwa, ndũkakĩe; nũndũ we ũla ũmanthaa thayũ wakwa emantha thayũ waku: nũndũ wĩ vamwe nakwa ũkeethĩwa ũsũvĩonĩ mũlũmu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.23",
