            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake nĩwamũkũlilye Yeova nũndũ wake, na amũnenga lĩu, na amũnenga ũvyũ wa Ngoliathu Mũvilisiti. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.10",
