            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩvo ĩndĩ Aimeleki wamũsũngĩie mũsumbĩ, na amũkũlya, Nũũ ĩndĩ katĩ wa athũkũmi maku onthe ũla mũĩkĩĩwa ta Ndaviti, ũla mũthoni wa mũsumbĩ, na nũlikĩtw’e nzamanĩ yaku, na nũtaĩawa nyũmbanĩ yaku? ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.14",
            "verseOrgIds": [
              "1SA.22.14"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
