              "1SA.22.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 22:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na akũna Novu, ndũa ya athembi, kwa kũtemanga na ũvyũ, aũme o na aka, twana na tũla tũkwongw’a, na ng’ombe na mang’oi na malondu, o kwa kũtemanga na ũvyũ. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.19",
            "verseOrgIds": [
              "1SA.22.19"
            ]
          }
        },
