              },
              "items": [
                {
                  "text": "2 Asu 10.25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.17",
            "verseOrgIds": [
              "1SA.22.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 22:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mũsumbĩ amwĩa Ndoeki, Ĩthyũũe we, na ũimathũũmũkĩa athembi. Na Ndoeki Mũetomu eethyũũa, na athũũmũkĩa athembi, na ooaa mũthenya ũsu andũ mĩongo nyanya na atano ala meekĩaa evoti ya katane. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.18",
            "verseOrgIds": [
              "1SA.22.18"
            ]
          }
        },
        {
