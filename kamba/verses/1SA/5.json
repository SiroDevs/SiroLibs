              "type": "text"
            }
          ]
        },
        {
          "text": "Na Avilisiti moosa ĩsandũkũ ya Ngai, na mayĩlikya nyũmbanĩ ya Ndakoni, na mayia vakuvĩ na Ndakoni. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.2",
            "verseOrgIds": [
              "1SA.5.2"
            ]
          }
        },
        {
          "name": "note",
