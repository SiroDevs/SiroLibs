              },
              "items": [
                {
                  "text": "Asi 16.23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.2",
            "verseOrgIds": [
              "1SA.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na yĩla ala ma Asitoti mookĩlile ũnĩ ũsu kĩoko tene, sisya, Ndakoni nĩwavalũkĩte na ũthyũ wake nthĩ mbee wa ĩsandũkũ ya Yeova. Na moosa Ndakoni, na mamũũngamya ĩngĩ vandũ vake. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.3",
            "verseOrgIds": [
              "1SA.5.3"
            ]
          }
        },
        {
