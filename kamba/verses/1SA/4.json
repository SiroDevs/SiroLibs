              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.16",
            "verseOrgIds": [
              "1SA.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ũla waetie ũvoo asũngĩa na asya, Isilaeli nĩmakĩie Avilisiti, o na ĩngĩ kwĩthĩĩtwe kũawa kũnene andũnĩ, na ana maku elĩ namo, Ovini na Vineasi, nĩ akw’ũ, na ĩsandũkũ ya Ngai nĩ yose. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.17",
            "verseOrgIds": [
              "1SA.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kweethĩwa, yĩla wawetie ĩsandũkũ ya Ngai, Eli avalũka kuma kĩvĩlanĩ kyake na ngala ũtee wa mbingĩlo; na ngingo yake yatũlĩka, na akw’a: nũndũ aĩ mũndũ mũkũu, na mũito. Na nĩwasilanĩtye Isilaeli myaka mĩongo ĩna. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.18",
            "verseOrgIds": [
              "1SA.4.18"
            ]
          }
        },
        {
