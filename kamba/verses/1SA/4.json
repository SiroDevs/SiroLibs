              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na yĩla ĩsandũkũ ya ũtianĩo ya Yeova yookie mwakonĩ wa maeema, Isilaeli onthe mausya ngemi na wasya mũtũlu, mũvaka nthĩ yeetĩkĩanĩsya ĩngĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.5",
            "verseOrgIds": [
              "1SA.4.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
