          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩthĩwai na vinya, na ĩthĩwai aũme, inyw’ĩ Avilisiti, nĩ kana mũikethĩwe athũkũmi ma Aevelania, o tondũ methĩĩtwe kwenyu: ĩthĩwai aũme, na mũkyũkita. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.9",
            "verseOrgIds": [
              "1SA.4.9"
            ]
          }
        },
