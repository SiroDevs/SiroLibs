            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.12",
            "verseOrgIds": [
              "NUM.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ũkaie Alivai mbee wa Aluni, na mbee wa ana make, na kũmũnenga Yeova methĩwe nthembo ya kũvyũlw’a.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.13",
            "verseOrgIds": [
              "NUM.8.13"
            ]
          }
        }
      ]
    },
