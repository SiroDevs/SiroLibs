              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ũu nĩw’o wĩmavathan’ya Alivai na ana ma Isilaeli; na Alivai makeethĩwa makwa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.14",
            "verseOrgIds": [
              "NUM.8.14"
            ]
          }
        },
