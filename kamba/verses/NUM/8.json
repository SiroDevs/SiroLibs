              "type": "tag",
              "attrs": {
                "loc": "LEV.1.4"
              },
              "items": [
                {
                  "text": "Ali 1.4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.8.14"
              },
              "items": [
                {
                  "text": "8.14",
                  "type": "text"
                }
              ]
