          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩvo ĩndĩ mose kasalũ, na nthembo ya mũtu ya kũthembanĩsya nako, mũtu mũvinyu ũvulanĩtw’e na mauta; na ũkose kasalũ kangĩ kethĩwe nthembo kwondũ wa naĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.8",
            "verseOrgIds": [
              "NUM.8.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
