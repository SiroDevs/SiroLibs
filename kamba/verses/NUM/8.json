              "type": "text"
            }
          ]
        },
        {
          "text": "na ala mavikĩtye myaka mĩongo ĩtano makaeke ũtethya wĩa ũsu, na maikathũkũma ĩngĩ, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.25",
            "verseOrgIds": [
