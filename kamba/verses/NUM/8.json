            "number": "6",
            "style": "v",
            "sid": "NUM 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maumye Alivai nthĩnĩ wa ana ma Isilaeli, ũmathesye. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.6",
            "verseOrgIds": [
              "NUM.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ũũ nĩw’o wĩmeka ũmathesye: maminzangĩsye manzĩ ma kũmathesya, nao meyenze mĩĩ yoo yonthe, na mathambye ngũa syoo, na kwĩthesya ene. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.7",
            "verseOrgIds": [
              "NUM.8.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
