          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "matikatialye kĩndũ kyaw’o kũvika kĩoko, o na maikatũle ĩvĩndĩ yayo: kwĩanana na mwamũlo w’onthe wa vasaka nĩw’o meya. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.12",
            "verseOrgIds": [
              "NUM.9.12"
            ]
          }
        },
