            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yeova aneena na Mose weũnĩ wa Sinai, mwei wa mbee wa mwaka wa kelĩ ĩtina wa mauma nthĩ ya Misili, akĩmwĩa, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.1",
            "verseOrgIds": [
              "NUM.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩngĩ, ana ma Isilaeli nĩmalilikanae vasaka ĩvinda yĩla yĩtw’ĩtwe yaw’o. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.2",
            "verseOrgIds": [
              "NUM.9.2"
            ]
          }
        },
        {
