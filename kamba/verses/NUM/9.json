          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Meaĩwa nĩ Yeova nĩmambaa maeema, na meaĩwa nĩ Yeova nĩmaendaa kyalo: nĩmasũvĩaa wĩaĩo wa Yeova, kwĩanana na mwĩao wa Yeova ũla weaĩe Mose. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.23",
