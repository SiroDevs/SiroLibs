              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Mbalaamu oona Yeova nũkwendeew’a nĩ kũathima Isilaeli, ndaathi, ta mavinda ala angi, kũmantha mowe, ĩndĩ eelekelya ũthyũ wake weũnĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.1",
            "verseOrgIds": [
              "NUM.24.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Mbalaamu ookĩlya metho make, na oona Isilaeli matũĩte kwĩanana na mbaĩ syoo; na Veva wa Ngai ooka ĩũlũ wake. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.2",
            "verseOrgIds": [
              "NUM.24.2"
            ]
          }
        },
