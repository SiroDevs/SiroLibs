          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na asisya Mũkeni, na aneena ngelekan’yo yake, na asya,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.21",
            "verseOrgIds": [
