            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na aneena ngelekan’yo yake, na asya,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.3",
            "verseOrgIds": [
              "NUM.24.3"
            ]
