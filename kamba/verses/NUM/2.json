              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ Alivai matyaatalanĩlw’a katĩ wa ana ma Isilaeli; o tondũ Yeova wamwĩaĩe Mose. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.33",
