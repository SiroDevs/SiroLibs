            "verseId": "NUM.2.14",
            "verseOrgIds": [
              "NUM.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na nguthu yake, na ala matalilwe mayo, maĩ ngili mĩongo ĩna na itano na maana thanthatũ na mĩongo ĩtano. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.15",
            "verseOrgIds": [
              "NUM.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onthe ala matalilwe ma mwako wa maeema wa Leuveni maĩ ngili ĩana na mĩongo ĩtano na ĩmwe na maana ana na mĩongo ĩtano, kwĩanana na nguthu syoo. Asu nĩo ma kelĩ ma kũthi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.16",
            "verseOrgIds": [
              "NUM.2.16"
            ]
          }
