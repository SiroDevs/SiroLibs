          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ Isilaeli matwĩe nthĩ ya Aamoli. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.31",
            "verseOrgIds": [
              "NUM.21.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NUM 21:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Mose atũma andũ kũthiana Yaseli; na makwata tũtũla twa vo, na mamalũngya Aamoli ala maĩ vo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.32",
            "verseOrgIds": [
              "NUM.21.32"
            ]
          }
        },
