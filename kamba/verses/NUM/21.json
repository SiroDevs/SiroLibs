            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.3",
            "verseOrgIds": [
              "NUM.21.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na maenda kyalo kuma kĩĩma kya Olu na nzĩa ĩla ĩelete Ũkanga Mũtune, mathyũlũlũke nthĩ ya Etomu: na andũ asu makw’a ngoo nũndũ wa ĩ nzĩa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.4",
            "verseOrgIds": [
              "NUM.21.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.33.41"
              },
