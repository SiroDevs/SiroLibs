            "sid": "NUM 21:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndeka nĩvĩtĩle nthĩ yaku: tũiathũka ũtee mũũndanĩ, kana kũlika mũũndanĩ wa mĩsavivũ; tũinyw’a manzĩ ma ithima: tũkavĩtĩla lelũnĩ wa mũsumbĩ, kũvika twakĩla mũvaka waku. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.22",
            "verseOrgIds": [
              "NUM.21.22"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
