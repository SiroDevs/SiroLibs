                "loc": "EXO.16.3"
              },
              "items": [
                {
                  "text": "Kuma 16.3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.17.3"
              },
              "items": [
                {
                  "text": "17.3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
