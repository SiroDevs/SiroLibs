            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.24",
            "verseOrgIds": [
              "NUM.21.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 21:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Isilaeli makwata ndũa isu syonthe: na Isilaeli matwĩe ndũanĩ syonthe sya Aamoli, ndũanĩ ya Esivoni, na tũtũla twayo tw’onthe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.25",
            "verseOrgIds": [
              "NUM.21.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 21:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ Esivoni yaĩ ndũa ya Sioni mũsumbĩ wa Aamoli, ũla wokitie na mũsumbĩ wa Moavi ũla waĩ mbeange wa ĩvinda yĩu, na amũvena nthĩ yake kw’okonĩ kwake, o kũvika Alinoni. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.26",
            "verseOrgIds": [
              "NUM.21.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 21:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwondũ wa ũu ala maneenaa na nthimo measya,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.27",
            "verseOrgIds": [
              "NUM.21.27"
            ]
          }
        }
      ]
    },
