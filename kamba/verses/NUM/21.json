              },
              "items": [
                {
                  "text": "Mot 20.17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.22",
            "verseOrgIds": [
              "NUM.21.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 21:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Sioni ndaaĩtĩkĩla kũmaeka Isilaeli mavĩtĩle mũvakanĩ wake: ĩndĩ Sioni oomban’ya andũ make onthe, na amaumaalĩla Isilaeli weũnĩ, na avika Yaasa; na okita na Isilaeli. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.23",
            "verseOrgIds": [
              "NUM.21.23"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.2.32"
              },
              "items": [
                {
                  "text": "Kũt 2.32",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.23",
            "verseOrgIds": [
              "NUM.21.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 21:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Isilaeli mamũkũna kwa kũmũtemanga na ũvyũ, na mamesya nthĩ yake kuma ũsĩ wa Alinoni kũvika ũla wa Yavoki, o kũvika ana ma Amimoni; nũndũ mũvaka wa ana ma Amimoni waĩ na vinya. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.24",
            "verseOrgIds": [
              "NUM.21.24"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
