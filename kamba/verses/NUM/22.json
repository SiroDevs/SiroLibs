          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.40",
            "verseOrgIds": [
              "NUM.22.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "NUM 22:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kweethĩwa ũnĩ ũsu, Mbalaki amwosa Mbalaamu, na amwambatya kũndũ kũtũlu kwa Mbaali; na e kũu oona andũ onthe o vala mathelele.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.41",
            "verseOrgIds": [
              "NUM.22.41"
            ]
          }
        }
      ]
    }
