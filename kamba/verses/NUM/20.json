            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.8",
            "verseOrgIds": [
              "NUM.20.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Mose oosa ĩla ndata kuma vu mbee wa Yeova, o tondũ wamwĩaĩe.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.9",
            "verseOrgIds": [
              "NUM.20.9"
            ]
          }
        }
      ]
