            "sid": "NUM 20:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asu nĩ manzĩ ma Meliva; nũndũ ana ma Isilaeli matetanisye na Yeova, nake eeyonan’ya kwoo atĩ nĩ mũtheu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.13",
            "verseOrgIds": [
              "NUM.20.13"
            ]
          }
        }
