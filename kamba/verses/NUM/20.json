        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.9",
            "verseOrgIds": [
              "NUM.20.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
