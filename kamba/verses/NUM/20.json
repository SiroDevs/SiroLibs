                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.11",
            "verseOrgIds": [
              "NUM.20.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 20:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yeova amea Mose na Aluni, Nĩkwĩthĩwa mũinandĩkĩĩa, mwonan’ye methonĩ ma ana ma Isilaeli atĩ nĩ mũtheu, kwondũ wa ũu mũtikatwaa ũmbano ũũ mũlikye nthĩ ĩla namanengie. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.12",
            "verseOrgIds": [
              "NUM.20.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
