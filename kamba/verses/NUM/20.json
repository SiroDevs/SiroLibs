              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na maenda kyalo kuma Katesi: na ana ma Isilaeli, o ũmbano w’onthe, mavika kĩĩma kya Olu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.22",
            "verseOrgIds": [
