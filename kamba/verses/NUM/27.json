              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yeova amwĩa Mose, Ũkĩla wambate kĩĩmanĩ kĩĩ kya Avalimu, ũsisye nthĩ ĩla nĩnengete ana ma Isilaeli. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.12",
            "verseOrgIds": [
              "NUM.27.12"
            ]
          }
        },
        {
