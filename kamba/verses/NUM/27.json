            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩvo ĩndĩ eĩtu mookie ma Nzeloveati, mwana wa Eevieli, mwana wa Ngileati, mwana wa Makili, mwana wa Manase, ma mĩvĩa ya Manase mwana wa Yosevu; na aa nĩo masyĩtwa ma eĩtu make: Maala, na Noa, na Okila, na Milika, na Tilisa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.1",
            "verseOrgIds": [
              "NUM.27.1"
            ]
          }
        },
        {
          "name": "note",
