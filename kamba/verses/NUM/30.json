          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yĩla mũndũ mũũme ũkevĩtĩa Yeova wĩvĩto kana kwĩyĩava wĩavo wa kwova ngoo yake na wovo, ndakaeke ndeto yake; akeke kwĩanana na w’onthe ũla wumaa kanyw’anĩ wake. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.2",
            "verseOrgIds": [
              "NUM.30.2"
            ]
          }
        },
