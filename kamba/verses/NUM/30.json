            }
          ]
        },
        {
          "text": "Na Mose aneena na atongoi ma mbaĩ sya ana ma Isilaeli, akĩmea, Ũũ nĩw’o Yeova weaie. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.1",
