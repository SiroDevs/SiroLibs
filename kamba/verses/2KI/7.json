                {
                  "text": "Ũvu 6.6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.1",
            "verseOrgIds": [
              "2KI.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩvo ĩndĩ kavuteni ũla mũsumbĩ wekwatĩlaa kw’oko kwake wasũngĩie mũndũ wa Ngai, na amwĩa, Sisya, o na kethĩwa Yeova akaseũvya mbũthi ĩtunĩ, ũndũ ũsu nũtonya kwĩthĩwa? Na amũsũngĩa, Sisya, ũkawona na metho maku, ĩndĩ ndũkaya. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.2",
            "verseOrgIds": [
              "2KI.7.2"
            ]
          }
        },
