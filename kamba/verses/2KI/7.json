          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Elisa asya, Ĩw’ai ndeto ya Yeova: ũũ nĩw’o Yeova ũnũkwasya, Ũnĩ ta ĩvinda yĩĩ kĩthimo kya mũtu mũvinyũ kĩkathoow’a na sekeli, na ithimo ilĩ sya mbaale na sekeli, mbingĩlonĩ ya Samalia. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.1",
            "verseOrgIds": [
              "2KI.7.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
