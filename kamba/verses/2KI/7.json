        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.15",
            "verseOrgIds": [
              "2KI.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na andũ maumaala, na matava mwakonĩ wa maeema wa Asilia. Na kwondũ wa ũu kĩthimo kya mũtu mũvinyu wathoow’a sekeli, na ithimo ilĩ sya mbaale sekeli, kwĩanana na ndeto ya Yeova. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.16",
            "verseOrgIds": [
              "2KI.7.16"
            ]
          }
        },
