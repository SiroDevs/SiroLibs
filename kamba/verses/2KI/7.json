          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "na kavuteni ũsu asũngĩa mũndũ wa Ngai, na amwĩa, Yu, sisya, o na kethĩwa Yeova akaseũvya mbũthi ĩtunĩ, ũndũ ta ũsu nũtonya kwĩthĩwa? Na amũsũngĩa, Sisya, ũkawona na metho maku, ĩndĩ ndũkaya; ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.19",
            "verseOrgIds": [
              "2KI.7.19"
            ]
          }
        },
