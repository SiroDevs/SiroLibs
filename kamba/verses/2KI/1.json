              "items": [
                {
                  "text": "Mko 3.22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.2",
            "verseOrgIds": [
              "2KI.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ mũlaĩka wa Yeova amwĩa Eliya Mũtisivi, Ũkĩla, nokyambata ũkomane na ala matũmĩtwe nĩ mũsumbĩ wa Samalia, noimakũlya, Nĩ kwakwĩthĩwa kũti Ngai nthĩnĩ wa Isilaeli, nĩmũkũthi kũkũlya kwa Mbaali‐nzevuvu, ngai ya Ekiloni? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.3",
            "verseOrgIds": [
              "2KI.1.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.17.1"
              },
              "items": [
                {
                  "text": "1 Asu 17.1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.3",
            "verseOrgIds": [
              "2KI.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yu kwondũ wa ũu Yeova easya atĩĩ, Ndũkauma ũkomonĩ ũla ũlĩsĩte, ĩndĩ ndwĩtĩa ũkw’a. Na Eliya athi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.4",
            "verseOrgIds": [
              "2KI.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.4",
            "verseOrgIds": [
              "2KI.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ala matũmĩtwe mamũsyokea, na amakũlya, Nũndũ wa kĩ mwasyoka? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.5",
            "verseOrgIds": [
              "2KI.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mamwĩa, Nĩkũkie mũndũ akomana naitũ, na atwĩa, Endai, mũmũsyokee mũsumbĩ ũla ũmũtũmie, na mũimwĩa, Ũũ nĩw’o Yeova ũnũũkũlya, Nĩ kwakwĩthĩwa kũti Ngai nthĩnĩ wa Isilaeli, kana ũtũmane kũkũlya Mbaali‐nzevuvu, ngai ya Ekiloni? Kwondũ wa ũu ndũkauma ũkomonĩ ũla ũlĩsĩte, ĩndĩ ndwĩtĩa ũkw’a. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.6",
            "verseOrgIds": [
              "2KI.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na amakũlya, Mũndũ ũsu ũla wũkie akomana nenyu, na amũtavya ndeto isu, nĩ mũndũ ũilyĩ ata? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.7",
            "verseOrgIds": [
              "2KI.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mamũsũngĩa, Eĩ mũndũ wĩ maw’ĩa, na eĩvotoete mũsivi wa mũkwa kĩnyunyunĩ kyake. Na asya, Nĩ Eliya Mũtisivi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.8",
            "verseOrgIds": [
              "2KI.1.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.13.4"
              },
              "items": [
                {
                  "text": "Nzek 13.4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.1.6"
              },
              "items": [
                {
                  "text": "Mko 1.6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 1:8"
          },
          "items": [
            {
