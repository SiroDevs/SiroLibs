            "number": "2",
            "style": "v",
            "sid": "2KI 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Aasia avalũkĩla mbũthinĩ kasũmbanĩ kake ke ĩũlũ ke Samalia, na awaa: na atũma atũmwa, na amea, Endai, mũkũlyei Mbaali‐nzevuvu, ngai ya Ekiloni, ethĩwa ngavoa ũwau ũũ. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.2",
            "verseOrgIds": [
              "2KI.1.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
