                "loc": "2KI.8.8"
              },
              "items": [
                {
                  "text": "2 Asu 8.8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.10.25"
              },
              "items": [
                {
                  "text": "Mt 10.25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.3.22"
