                {
                  "text": "Mwa 14.23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.16",
            "verseOrgIds": [
              "2KI.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Naamani asya, Ethĩwa ti ũu, ĩndĩ, nĩngũkwĩsũva, mũthũkũmi waku nanengwe mũthanga wa mĩio ĩtonya kũkuwa nĩ nyũmbũ ilĩ; nũndũ mũthũkũmi waku kuma yu ndakathembea ngai ingĩ ate o Yeova, nthembo ya kũvĩvw’a kana nthembo ya kũtonywa. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.17",
            "verseOrgIds": [
              "2KI.5.17"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
