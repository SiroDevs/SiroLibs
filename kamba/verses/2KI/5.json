              "2KI.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kweethĩwa, yĩla Elisa mũndũ wa Ngai wewie kana mũsumbĩ wa Isilaeli nũtembũangĩte ngũa syake, atũmana kwa mũsumbĩ, akĩmũkũlya, Nũndũ wa kĩ ũnatembũangie ngũa syaku? Nĩoke yu vala nĩĩ, na akamanya ve mwathani nthĩnĩ wa Isilaeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.8",
            "verseOrgIds": [
              "2KI.5.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.2.5"
              },
              "items": [
                {
                  "text": "Esek 2.5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.8",
            "verseOrgIds": [
              "2KI.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwondũ wa ũu Naamani ooka e na mbalasi syake na makasya make, na aũngama mũomonĩ wa nyũmba ya Elisa. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.9",
            "verseOrgIds": [
              "2KI.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Elisa atũma mũtũmwa vala ũĩ, akĩmwĩa, Enda ũthambe ũsĩnĩ wa Yolotani mavinda mũonza, na mwĩĩ waku ũkakũsyokea, na ũkeethĩwa mũtheu. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.10",
            "verseOrgIds": [
              "2KI.5.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.9.7"
              },
              "items": [
                {
                  "text": "Yoa 9.7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.10",
            "verseOrgIds": [
              "2KI.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ Naamani aĩ mũthatu, na athi, na asya, Sisya, nĩsũanĩaa, nde ndĩi ya kũmbumaalĩla, na kũũngama, na kwĩkaĩla syĩtwa ya Yeova Ngai wake, na kũvĩtĩlya kw’oko kwake ĩũlũ wa vala vandũ, na kũvosya ũla ũwaĩte mangũ. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.11",
            "verseOrgIds": [
              "2KI.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Avana na Vaalivali mbũsĩ sya Ndamasiku ti nzeo kwĩ iw’ũ syonthe sya Isilaeli? Nditonya kũthambĩa nthĩnĩ wasyo, na ngeethĩwa mũtheu? Kwondũ wa ũu eethyũũa na athi athatĩte mũno. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.12",
            "verseOrgIds": [
              "2KI.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na athũkũmi make mathengeea, na maneena nake, na masya, Asa wakwa, kethĩwa mwathani akũtavya wĩke ũndũ ũnene, ndwĩthĩwa weeka? Ti kavaa mũno ĩndĩ, akĩkwĩa, Thamba, nokĩthea? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.13",
            "verseOrgIds": [
              "2KI.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩvo ĩndĩ watheeie, na eethika mavinda mũonza ũsĩnĩ wa Yolotani, kwĩanana na ndeto ya mũndũ wa Ngai; na mwĩĩ wake wasyoka wekala ĩngĩ ta mwĩĩ wa kana kanini, na aĩ mũtheu. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.14",
            "verseOrgIds": [
              "2KI.5.14"
            ]
          }
        },
        {
