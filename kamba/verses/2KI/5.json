              },
              "items": [
                {
                  "text": "Kuma 20.24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.17",
            "verseOrgIds": [
              "2KI.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeova naekee mũthũkũmi waku ũndũnĩ ũũ: yĩla vwana wakwa wĩlikaa nyũmbanĩ ya Limoni athaithe vo, na akĩkwatĩla kw’oko kwakwa, na ngĩkunamya nyũmbanĩ ya Limoni, yĩla ngekunamya nyũmbanĩ ya Limoni, Yeova naekee mũthũkũmi waku ũndũnĩ ũsu. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.18",
            "verseOrgIds": [
              "2KI.5.18"
            ]
          }
        },
        {
