              "2KI.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na amwĩa, Enda na ũvoo. Kwondũ wa ũu auma vala ũĩ athi vandũ vaasanga.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.19",
            "verseOrgIds": [
              "2KI.5.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.19",
            "verseOrgIds": [
              "2KI.5.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ Ngeasi, mũthũkũmi wa Elisa mũndũ wa Ngai, asya, Sisya, vwana wakwa nĩwamũeka Naamani ũũ Mũsilia, ailea kwosa mokonĩ make kĩla waetie: o tondũ Yeova wĩ thayũ, ngasemba nĩmũvikile, na ngyosa kĩndũ kwake. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.20",
            "verseOrgIds": [
              "2KI.5.20"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.4.12"
              },
              "items": [
                {
                  "text": "2 Asu 4.12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.20",
            "verseOrgIds": [
              "2KI.5.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ Ngeasi amũvikĩla Naamani. Na yĩla Naamani wonie mũndũ asembete amũvikĩlĩte, auma ĩkasyanĩ amũthaũe, na akũlya, Nĩ kũseo? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.21",
            "verseOrgIds": [
              "2KI.5.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 5:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake asũngĩa, Nĩ kũseo. Vwana wakwa nĩwandũma, akyasya Sisya, oyu kwooka anake elĩ ma ana ma athani kuma nthĩ yĩ iĩma ya Evalaimu; manenge, nĩngũkwĩsũva, talendi ya vetha, na ngũa sya ũkũan’ya makũan’ya elĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.22",
            "verseOrgIds": [
              "2KI.5.22"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.5.5"
              },
              "items": [
                {
                  "text": "2 Asu 5.5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.22",
            "verseOrgIds": [
              "2KI.5.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 5:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Naamani asya, Endeew’a nĩ kwosa talendi ilĩ. Na amũingĩĩsya, na ova talendi ilĩ sya vetha mĩvukonĩ ĩlĩ, vamwe na ngũa sya ũkũan’ya makũan’ya elĩ, na amaĩkya athũkũmi make elĩ; na mamĩkua me mbee wake. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.23",
            "verseOrgIds": [
              "2KI.5.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2KI 5:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na yĩla wavikie kĩĩmanĩ, amyosa kuma mokonĩ moo, na amia nyũmbanĩ, na aeka andũ asu mathi, na maenda. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.24",
            "verseOrgIds": [
              "2KI.5.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 5:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ alika, na aũngama mbee wa vwana wake. Na Elisa amwĩa, Wauma va, Ngeasi? Na asya, Mũthũkũmi waku ndaathi vandũ. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.25",
            "verseOrgIds": [
              "2KI.5.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 5:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na amũkũlya, Ngoo yakwa ndĩnaendan’ya naku, yĩla mũndũ ũsu wĩtulũlile atia ĩkasya yake akũthaũe? Nĩ ĩvinda ya kwosa mbesa, na kwosa ngũa, na mĩũnda ya mĩthata na mĩũnda ya mĩsavivũ, na malondu na ng’ombe, na athũkũmi aũme na athũkũmi eĩtu? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.26",
            "verseOrgIds": [
              "2KI.5.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 5:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwondũ wa ũu mangũ ma Naamani makalũman’ya naku, na ũsyao waku tene na tene. Na auma mbee wake eũvĩtw’e nĩ mangũ ta ĩa. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.27",
            "verseOrgIds": [
              "2KI.5.27"
            ]
          }
        },
