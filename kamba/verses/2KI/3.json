              "2KI.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na asya, Ũũ nĩw’o Yeova ũnũkwasya, Ĩnzai mĩtaũ mwandanĩ ũũ wusũe. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.16",
            "verseOrgIds": [
              "2KI.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ ũũ nĩw’o Yeova ũnũkwasya, Mũtikona kĩseve, o na mũtikona mbua; ĩndĩ mwanda ũũ ũkausũa manzĩ, na mũkanyusaa, inyw’ĩ na indo syenyu na nyamũ syenyu. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.17",
            "verseOrgIds": [
              "2KI.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ũu no ũndũ ũvũthũ methonĩ ma Yeova: nake akanengane Amoavi nao kw’okonĩ kwaku. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.18",
            "verseOrgIds": [
              "2KI.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mũkakũne kĩla ndũa mbiie, na kĩla ndũa yĩ vata, na mũkateme kĩla mũtĩ mũseo, na kũlinda nthongo syonthe sya manzĩ, na kũthũkya kĩla kĩlungu kĩseo kya nthĩ na mavia. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.19",
            "verseOrgIds": [
              "2KI.3.19"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.20.19"
              },
              "items": [
                {
                  "text": "Kũt 20.19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.19",
            "verseOrgIds": [
              "2KI.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kweethĩwa kĩoko, ta ĩvinda ya kũthemba nthembo, sisya, kwooka manzĩ na nzĩa ya Etomu, na nthi yausũa manzĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.20",
            "verseOrgIds": [
              "2KI.3.20"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.29.39"
              },
              "items": [
                {
                  "text": "Kuma 29.39",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.20",
            "verseOrgIds": [
              "2KI.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ yĩla Amoavi onthe meewie atĩ asumbĩ mambatĩte mokite nao, meeyũmbanĩsya, onthe ala maĩ matonya kwĩkĩa mĩio ya kaũ, o na ala akũangũ, na maũngama mũvakanĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.21",
            "verseOrgIds": [
              "2KI.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mookĩla kĩoko tene, na syũa yaatha ĩũlũ wa manzĩ, na Amoavi moona manzĩ me mbee woo me matune ta nthakame: ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.22",
            "verseOrgIds": [
              "2KI.3.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "na masya, ĩno nĩ nthakame; asumbĩ nĩmanangĩtwe vate ndĩi, na nĩmoaĩte kĩla mũndũ mũtindan’ya wake: yu kwondũ wa ũu, Moavi, endai mũtavonĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.23",
            "verseOrgIds": [
              "2KI.3.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2KI 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na yĩla mavikie mwakonĩ wa maeema wa Isilaeli, Aisilaeli mookĩla na makũna Amoavi, mũvaka makũka mbee woo; na maendeea na malika ĩ nthĩ makũnĩte Amoavi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.24",
            "verseOrgIds": [
              "2KI.3.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 3:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mavalũkya i ndũa nthĩ; na kĩla kĩlungunĩ kĩseo kya nthĩ mekya kĩla mũndũ ĩvia yake, na makyusũsya; na malinda nthongo syonthe sya manzĩ, na mavalũkya mĩtĩ yonthe mĩseo, mũvaka Kili‐alesethio yoka matialilye mavĩa mayo; ĩndĩ ala mekasya mavia na ikũtha mamĩthyũlũlũka, na mamĩkũna. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.25",
            "verseOrgIds": [
              "2KI.3.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 3:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na yĩla mũsumbĩ wa Moavi wonie kana kaũ nũvyũvie kwake athi na andũ maana mũonza ala makũaa ũvyũ, mavũthũe nzĩa mavike kwa mũsumbĩ wa Etomu; ĩndĩ matyaatonya. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.26",
            "verseOrgIds": [
              "2KI.3.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 3:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ oosa ĩkithathi yake yĩla yaaĩle kũsumbĩka vandũ vake, na ayĩthemba ũvainĩ yĩthĩwe nthembo ya kũvĩvw’a. Na kwaĩ ũthatu mũnene ĩũlũ wa Isilaeli: na mamũtia, na masyoka nthĩ yoo ene. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.27",
            "verseOrgIds": [
              "2KI.3.27"
            ]
          }
        },
