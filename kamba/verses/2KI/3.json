          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ o na ũu alũman’ya na naĩ sya Yelovoamu mwana wa Nevati, ila wavĩtĩthĩtye Isilaeli nasyo; ndaaitia. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.3",
            "verseOrgIds": [
              "2KI.3.3"
            ]
          }
        },
        {
          "name": "note",
