            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.3",
            "verseOrgIds": [
              "2KI.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ Mesa mũsumbĩ wa Moavi aĩ mũĩthya wa malondu; na amũnengae mũsumbĩ wa Isilaeli tũtena twa malondu ngili ĩana, na ndũũme ngili ĩana, o na maw’ĩa. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.4",
            "verseOrgIds": [
              "2KI.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ kweethĩwa, yĩla Aavu wakwie, mũsumbĩ wa Moavi amũng’endea mũsumbĩ wa Isilaeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.5",
            "verseOrgIds": [
              "2KI.3.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.1.1"
              },
              "items": [
                {
                  "text": "2 Asu 1.1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.5",
            "verseOrgIds": [
              "2KI.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mũsumbĩ Yeolamu auma Samalia ĩvinda yĩu, na oomban’ya Isilaeli onthe. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.6",
            "verseOrgIds": [
              "2KI.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na athi atũmana kwa Yeosavati mũsumbĩ wa Yuta, akĩmwĩa, Mũsumbĩ wa Moavi nũng’endeete: ũkathi vamwe nakwa tũkite na Moavi kaũnĩ? Na asya, Ngambata: nyie nĩilyĩ o taku, na andũ makwa ta andũ maku, na mbalasi syakwa ta mbalasi syaku. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.7",
            "verseOrgIds": [
              "2KI.3.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.22.4"
              },
              "items": [
                {
                  "text": "1 Asu 22.4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.7",
            "verseOrgIds": [
              "2KI.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na amũkũlya, Twĩambata na nzĩa yĩva? Na amũsũngĩa, Nzĩa ya weũ wa Etomu. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.8",
            "verseOrgIds": [
              "2KI.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ mũsumbĩ wa Isilaeli athi, na mũsumbĩ wa Yuta, na mũsumbĩ wa Etomu; na mathi melingĩlĩte kyalo kya mĩthenya mũonza: na kũtyaĩ manzĩ ma ĩ nguthu, o na ma nyamũ ila syamaatĩĩe. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.9",
            "verseOrgIds": [
              "2KI.3.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.22.47"
              },
              "items": [
                {
                  "text": "1 Asu 22.47",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.9",
            "verseOrgIds": [
              "2KI.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mũsumbĩ wa Isilaeli asya, Ĩiaa! Nũndũ Yeova nĩwĩtĩte asumbĩ aa atatũ mombane vamwe amanengane kw’okonĩ kwa Moavi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.10",
            "verseOrgIds": [
              "2KI.3.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.7.7"
              },
              "items": [
                {
                  "text": "Yos 7.7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.10",
            "verseOrgIds": [
              "2KI.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ Yeosavati akũlya, Vati mwathani wa Yeova vaa, nĩ kana tũmũkũlye Yeova na kanyw’a wake? Na ũmwe wa athũkũmi ma mũsumbĩ wa Isilaeli asũngĩa na asya, Elisa mwana wa Savati e vaa, ũla wetĩkĩasya moko ma Eliya manzĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.11",
            "verseOrgIds": [
              "2KI.3.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.19.21"
              },
              "items": [
                {
                  "text": "1 Asu 19.21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.22.7"
              },
              "items": [
                {
                  "text": "22.7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.11",
            "verseOrgIds": [
              "2KI.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yeosavati asya, Ndeto ya Yeova yĩ nake. Kwondũ wa ũu mũsumbĩ wa Isilaeli na Yeosavati na mũsumbĩ wa Etomu matheea vala ũĩ.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.12",
            "verseOrgIds": [
              "2KI.3.12"
            ]
          }
        }
      ]
    },
    {
