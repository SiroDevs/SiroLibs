              },
              "items": [
                {
                  "text": "2 Asu 1.17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.1",
            "verseOrgIds": [
              "2KI.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na eekaa ũla Yeova wonaa wĩ ũthũku, ĩndĩ ti ta ĩthe wake, na ta inyia wake; nũndũ nĩwavetie kĩtuĩ kya Mbaali kĩla ĩthe wake waseũvĩtye. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.2",
            "verseOrgIds": [
              "2KI.3.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
