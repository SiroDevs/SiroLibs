              "items": [
                {
                  "text": "1 Asu 17.1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.14",
            "verseOrgIds": [
              "2KI.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ yu ndetee mũndũ wĩsĩ kũinga mbeve. Na kweethĩwa, yĩla mũingi ũsu waingaa, kw’oko kwa Yeova kwooka ĩũlũ wake. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.15",
            "verseOrgIds": [
              "2KI.3.15"
            ]
          }
        },
