              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ Yeolamu mwana wa Aavu ambĩlĩlya kũsumbĩka Isilaeli ku Samalia mwaka wa ĩkũmi na nyanya wa kũsumbĩka kwa Yeosavati mũsumbĩ wa Yuta, na asumbĩka myaka ĩkũmi na ĩlĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.1",
            "verseOrgIds": [
              "2KI.3.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
