            "sid": "2KI 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yeoaasi amwĩsũva Yeova, na Yeova amwĩthukĩĩsya; nũndũ nĩwonie thĩna wa Isilaeli, ũndũ mũsumbĩ wa Silia wamathĩnasya. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.4",
            "verseOrgIds": [
              "2KI.13.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
