          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mũsumbĩ wa Misili ndaaũka ĩngĩ kuma nthĩ yake; nũndũ mũsumbĩ wa Mbaviloni nĩwosete, kuma kalũsĩnĩ ka Misili kũvika ũsĩ wa Euvalati, yonthe ĩla yaĩ ya mũsumbĩ wa Misili. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.7",
            "verseOrgIds": [
              "2KI.24.7"
            ]
          }
        },
