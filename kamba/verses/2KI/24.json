          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩvinda yĩu athũkũmi ma Nevukatilesa mũsumbĩ wa Mbaviloni mambata Yelusaleme, na ndũa yathyũlũlũkwa ĩtw’ĩkanĩw’e. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.10",
            "verseOrgIds": [
              "2KI.24.10"
            ]
          }
        },
