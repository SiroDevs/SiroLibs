          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Nevukatilesa mũsumbĩ wa Mbaviloni ooka ndũanĩ ĩsu, yĩla athũkũmi make mamĩtw’ĩkanĩasya; ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.11",
            "verseOrgIds": [
              "2KI.24.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 24:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Yeoiakini mũsumbĩ wa Yuta amumaalĩla mũsumbĩ wa Mbaviloni, we, na inyia wake, na athũkũmi make, na anene make me mbee ũsumbĩnĩ, na anene ma kwake: na mũsumbĩ wa Mbaviloni amwosa mwaka wa nyanya wa kũsumbĩka kwake. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.12",
            "verseOrgIds": [
              "2KI.24.12"
            ]
          }
        },
