        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2KI 6:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kweethĩwa, yĩla mũsumbĩ wewie ndeto sya ũ mũndũ mũka, atembũanga ngũa syake (na nĩwavĩtĩle ĩũlũ wa ũvai); na andũ moona, na, sisya, aĩ na ĩkunia nthĩnĩ mwĩĩnĩ wake. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.30",
            "verseOrgIds": [
              "2KI.6.30"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
