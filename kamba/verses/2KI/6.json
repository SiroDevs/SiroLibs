            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.25",
            "verseOrgIds": [
              "2KI.6.25"
            ]
          }
