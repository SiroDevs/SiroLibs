              },
              "items": [
                {
                  "text": "Mot 22.31",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.2.11"
              },
              "items": [
                {
                  "text": "2 Asu 2.11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
