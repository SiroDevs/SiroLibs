              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.28",
            "verseOrgIds": [
              "2KI.8.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2KI 8:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mũsumbĩ Yolamu asyoka avoee ku Yesileeli mawũkite ala Asilia mamũkitĩe Lama, yĩla wokitaa na Aasaeli mũsumbĩ wa Silia. Na Aasia mwana wa Yeolamu mũsumbĩ wa Yuta atheea kũsisya Yolamu mwana wa Aavu ku Yesileeli, nũndũ aĩ mũwau. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.29",
            "verseOrgIds": [
              "2KI.8.29"
            ]
          }
