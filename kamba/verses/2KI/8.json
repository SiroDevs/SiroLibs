              "2KI.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Aasaeli asya, Ĩndĩ mũthũkũmi waku nĩ mwaũ, ũla no ta ngitĩ, nĩ kana eke ũndũ ũnenevete ũu? Na Elisa asũngĩa, Yeova nũmbonetye atĩ ũkeethĩwa mũsumbĩ wa Silia. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.13",
            "verseOrgIds": [
              "2KI.8.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
