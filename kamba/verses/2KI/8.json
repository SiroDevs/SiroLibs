          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ Elisa nĩwaneenete na mũndũ mũka, ũla wathayũũkĩsye mwana, akĩmwĩa, Ũkĩla, ũende we na andũ ma nyũmba yaku, nokĩkala ũeni o vala ũtonya kwĩkala: nũndũ Yeova nĩwĩtĩte yũa yũke; nayo yĩkooka ĩũlũ wa nthĩ myaka mũonza. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.1",
            "verseOrgIds": [
              "2KI.8.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
