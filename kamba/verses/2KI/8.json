                "loc": "1SA.9.7"
              },
              "items": [
                {
                  "text": "1 Sam 9.7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.19.15"
              },
              "items": [
                {
                  "text": "1 Asu 19.15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.19.17"
              },
              "items": [
                {
