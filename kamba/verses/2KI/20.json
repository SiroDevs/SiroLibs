              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩvo ĩndĩ wethyũũie na eelekelya ũthyũ wake wakonĩ, na amũvoya Yeova, akĩmwĩa, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.2",
            "verseOrgIds": [
              "2KI.20.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lilikana yu, ame Yeova, nĩngũkwĩsũva, ũndũ nĩendete mbee waku nthĩnĩ wa w’o na ngoo mbĩanĩu, na nĩnĩkĩte ũla wonaa wĩ ũseo. Na Esekia aĩa mũno. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.3",
            "verseOrgIds": [
              "2KI.20.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
