              },
              "items": [
                {
                  "text": "2 Asu 19.34",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.6",
            "verseOrgIds": [
              "2KI.20.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Isaia asya, Osa kakũmbwa ka makũyũ. Na moosa na makailĩĩla mũimũnĩ, na avoa.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.7",
            "verseOrgIds": [
              "2KI.20.7"
            ]
          }
        }
      ]
