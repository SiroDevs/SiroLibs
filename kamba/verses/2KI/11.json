              "2KI.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mwaka wa mũonza Yeoiata atũmana na aete makavuteni ma maana ma Akali na ma nguthu ya asũvĩi, na amaete vala ũĩ nyũmbanĩ ya Yeova; na atianĩa ũtianĩo nao, na ameavĩthĩsya nyũmbanĩ ya Yeova, na amon’ya mwana wa mũsumbĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.4",
            "verseOrgIds": [
              "2KI.11.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
