              "2KI.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mũthembi Yeoiata ameaĩa makavuteni ma maana ala maiĩtwe ĩũlũ wa nguthu, na amea, Mumaalĩlye katĩ wa mĩselele; na ũla wĩmũatĩĩa mũaei na ũvyũ. Nũndũ mũthembi aisye, Ndakoaĩwe nyũmbanĩ ya Yeova. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.15",
            "verseOrgIds": [
              "2KI.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwondũ wa ũu mamwathũkĩa; na athi na nzĩa ya ũlikĩlo wa mbalasi wa nyũmba ya mũsumbĩ: na ooaĩwa vo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.16",
            "verseOrgIds": [
              "2KI.11.16"
            ]
          }
        }
      ]
    },
