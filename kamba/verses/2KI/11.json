          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "na aĩ nake avithĩtwe nyũmbanĩ ya Yeova myaka thanthatũ. Na Athalia asumbĩka ĩ nthĩ.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.3",
            "verseOrgIds": [
              "2KI.11.3"
            ]
          }
        }
