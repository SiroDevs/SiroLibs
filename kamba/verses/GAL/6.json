                "loc": "MAT.18.15"
              },
              "items": [
                {
                  "text": "Mt 18.15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JAS.5.19"
              },
              "items": [
                {
                  "text": "Yak 5.19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ana‐a‐asa, o na ethĩwa mũndũ ekwatwa nĩ ĩvĩtyo o na yĩva, inyw’ĩ ala mwĩ ma Veva, mũtũngĩĩei ta ũsu na veva wa ũuu; ũkĩsyaĩĩsya mwene, ndũkatatwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.1",
            "verseOrgIds": [
              "GAL.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GAL 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuan’yai mĩio ene kwa ene, na ũu mũkeanĩsya mwĩao wa Klĩsto. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.2",
            "verseOrgIds": [
              "GAL.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GAL 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ ethĩwa mũndũ eĩtalĩlya kwĩthĩwa kĩndũ, nake ti kĩndũ, eĩkenga mwene. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.3",
            "verseOrgIds": [
              "GAL.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GAL 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.13.5"
              },
              "items": [
                {
                  "text": "2 Ako 13.5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ kĩla mũndũ aosye wĩa wake mwene, na nĩvo ĩndĩ wĩĩthĩwa na ũndũ wa kwĩkathĩĩa e we mwene, na ti kwĩelekan’ya na ũngĩ ũndũ wĩkaa. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.4",
            "verseOrgIds": [
              "GAL.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GAL 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.14.12"
              },
              "items": [
                {
                  "text": "Alo 14.12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa kwĩthĩwa kĩla mũndũ akakua mũio wake mwene.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.5",
            "verseOrgIds": [
              "GAL.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
