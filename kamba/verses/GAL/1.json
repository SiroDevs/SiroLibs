                "loc": "MAT.13.55"
              },
              "items": [
                {
                  "text": "Mt 13.55",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ ndyaamona atũmwa ala angĩ, ate o Yakovo mwana‐a‐inyia wa Mwĩaĩi. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.19",
            "verseOrgIds": [
              "GAL.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GAL 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ũvoo wa maũndũ ala ngũmũandĩkĩa, sisyai, mbee wa Ngai, ndiũneena ũvũngũ. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.20",
            "verseOrgIds": [
              "GAL.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GAL 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.9.30"
              },
              "items": [
                {
                  "text": "Meko 9.30",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩtina naendie nthĩ ya Silia na Silisia. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.21",
            "verseOrgIds": [
              "GAL.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GAL 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩvinda yĩu ndyeesĩkĩwe ũthyũ wakwa nĩ makanisa ma Yutia ala maĩ nthĩnĩ wa Klĩsto: ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.22",
            "verseOrgIds": [
              "GAL.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GAL 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "ĩndĩ meew’ĩte kũineenwa tũ, Ũla watũthĩnasya tene, yu nũtavanasya mũĩkiĩo ũla wanangaa tene; ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.23",
            "verseOrgIds": [
              "GAL.1.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
