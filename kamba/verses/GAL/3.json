          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwondũ wa ũu ĩla mĩao yatw’ikie mũmanyĩsya waitũ kũtũete kwa Klĩsto, nĩ kana tũtonye kũtalĩlwa ũlũngalu kwondũ wa mũĩkĩĩo. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.24",
            "verseOrgIds": [
              "GAL.3.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
