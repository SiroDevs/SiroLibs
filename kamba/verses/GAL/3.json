            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ethĩwa mwĩ ma Klĩsto, mwĩ ũsyao wa Avalaamu, na atiĩwa kwĩanana na watho.",
          "type": "text",
