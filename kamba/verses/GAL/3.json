              },
              "items": [
                {
                  "text": "Alo 8.17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ inyw’onthe mwĩ ana ma Ngai, kwondũ wa mũĩkĩĩo, nthĩnĩ wa Klĩsto Yesũ. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.26",
            "verseOrgIds": [
              "GAL.3.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
