                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ inyw’ĩ o ala mwavatisiwe kũlikw’a nthĩnĩ wa Klĩsto nĩmwĩvw’ĩkĩte Klĩsto. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.27",
            "verseOrgIds": [
              "GAL.3.27"
            ]
          }
        },
