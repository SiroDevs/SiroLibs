                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.12.13"
              },
              "items": [
                {
                  "text": "1 Ako 12.13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kũitonya kwĩthĩwa Mũyuti o na Mũkiliki, na kũitonya kwĩthĩwa mwove na ũte mwove, na kũitonya kwĩthĩwa mũndũ mũũme na mũndũ mũka; nũndũ inyw’onthe mwĩ ũmwe nthĩnĩ wa Klĩsto Yesũ. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.28",
            "verseOrgIds": [
              "GAL.3.28"
            ]
