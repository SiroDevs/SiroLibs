              },
              "items": [
                {
                  "text": "Alo 10.4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ yu, mũĩkĩĩo wooka, tũi ungu wa mũmanyĩsya ĩngĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.25",
            "verseOrgIds": [
              "GAL.3.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GAL 3:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
