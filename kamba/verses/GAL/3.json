              "items": [
                {
                  "text": "11.32",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ maandĩko nĩmavingĩĩte maũndũ onthe ungu wa naĩ, nĩ kana watho kwondũ wa mũĩkĩĩo nthĩnĩ wa Yesũ Klĩsto, ũtonye ũnengwa ala metĩkĩlaa.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.22",
