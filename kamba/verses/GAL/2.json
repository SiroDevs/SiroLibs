              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ithyĩ ala twĩ Ayuti kwa mũtuo witũ, na ti andũ athe ma Andũ‐ma‐mbaĩĩngi, ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.15",
            "verseOrgIds": [
              "GAL.2.15"
            ]
          }
        },
