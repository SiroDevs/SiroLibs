                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ĩndĩ twĩsĩ mũndũ ndatalĩlawa ũlũngalu kwondũ wa meko ma ĩla mĩao ĩndĩ nĩ kwondũ wa kũĩkĩĩa Yesũ Klĩsto, o naitũ nĩtwĩtĩkĩlĩte Klĩsto Yesũ, nĩ kana tũtalĩlwe ũlũngalu nũndũ wa kũmũĩkĩĩa Klĩsto, na ti kwa meko ma ĩla mĩao: nĩkwĩthĩwa kwondũ wa meko ma ĩla miao vai mwĩĩ ũtonya kũtalĩlwa ũlũngalu. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.16",
            "verseOrgIds": [
              "GAL.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GAL 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ ethĩwa, yĩla twamanthie kũtalwa kwĩthĩwa alũngalu nthĩnĩ wa Klĩsto, ithyĩ naitũ twonekie twĩ andũ athe, Klĩsto nĩ mũthũkũmi wa naĩ? Aiee, kũikethĩwe ũu. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.17",
            "verseOrgIds": [
              "GAL.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GAL 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ ethĩwa nĩngwaka ĩngĩ maũndũ asu ala naanangie, nĩngwĩyonan’ya kana nĩ mũvĩtan’ya. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.18",
            "verseOrgIds": [
              "GAL.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GAL 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.7.6"
              },
              "items": [
                {
                  "text": "Alo 7.6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ kwa nzĩa ya ĩla mĩao nĩnakwie kwa ĩla mĩao, nĩ kana nĩthĩwe thayũ kwa Ngai. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.19",
            "verseOrgIds": [
              "GAL.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GAL 2:20"
          },
          "items": [
