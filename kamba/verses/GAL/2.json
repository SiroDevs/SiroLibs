                "loc": "ACT.15.2"
              },
              "items": [
                {
                  "text": "Meko 15.2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ ĩtina wa myaka ĩkũmi na ina, nambatie ĩngĩ Yelusaleme nyie na Valanava, na Tito naĩ nake. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.1",
            "verseOrgIds": [
              "GAL.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GAL 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.2.6"
              },
              "items": [
                {
                  "text": "Aka 2.6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.2.9"
              },
              "items": [
                {
                  "text": "9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakwa nambatie nũndũ nĩnavuanĩw’e; na nĩnamonisye ũvoo mũseo ũla nĩtavanasya kwa Andũ‐ma‐mbaĩ‐ingĩ, ĩndĩ nĩnamatavisye ala maĩ na nguma me oka, nĩ kana kwa ũndũ o na wĩva ndikethĩwe ngĩsemba mana, kana nasembie mana. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.2",
            "verseOrgIds": [
              "GAL.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GAL 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.16.3"
              },
              "items": [
                {
                  "text": "Meko 16.3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ o na Tito ũla waĩ vamwe nakwa, nake aĩ Mũkiliki, ndaathing’ĩĩw’a kwaĩkwa: ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.3",
            "verseOrgIds": [
              "GAL.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GAL 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.15.1"
              },
              "items": [
                {
                  "text": "Meko 15.1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.15.24"
              },
              "items": [
                {
                  "text": "24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "na ũu nĩ kwondũ wa ana‐a‐asa ma ũvũngũ ala malikilw’e nthĩnĩ na kĩmbithĩ, ala mavotie na kĩmbithĩ mathiane kũthaw’a kwitũ kũla twĩ nakw’o nthĩnĩ wa Klĩsto Yesũ, nĩ kana matũtwae ũkombonĩ: ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.4",
            "verseOrgIds": [
              "GAL.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GAL 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.3.1"
              },
              "items": [
                {
                  "text": "Aka 3.1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "nao tũtyaamanenga ũthei ta kũmenyivĩsya, aiee, o na saa ũmwe; nĩ kana ũla w’o wa ũvoo mũseo wikale nenyu. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.5",
            "verseOrgIds": [
              "GAL.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GAL 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ kwa asu ala maĩ na nguma ya kwĩthĩwa nĩ anene (ũndũ mekalile, vai ũndũ kwakwa: Ngai ndendeeaw’a nĩ wũmbe wa mũndũ) — nao, nĩasya, ala maĩ na nguma matyaambongeleela ũndũ: ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.6",
            "verseOrgIds": [
              "GAL.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GAL 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.9.15"
              },
              "items": [
                {
                  "text": "Meko 9.15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.15.12"
              },
              "items": [
                {
                  "text": "15.12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.22.21"
              },
              "items": [
                {
                  "text": "22.21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ĩndĩ ngalĩ ĩla, ĩngĩ, yĩla moonie kana nĩwaiiwe kwakwa ũvoo mũseo nĩtavan’ye kwa ala mate aĩke, o ũndũ Vetelo waĩ na ũvoo mũseo aitavan’ya kwa ala aĩke ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.7",
            "verseOrgIds": [
              "GAL.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GAL 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "(nũndũ ũla wamũtonyethisye Vetelo kwĩthĩwa mũtũmwa kwa asu aĩke wandonyethisye nĩtw’ĩke mũtũmwa kwa Andũ‐ma‐mbaĩ‐ingĩ); ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.8",
            "verseOrgIds": [
              "GAL.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GAL 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.1.42"
              },
              "items": [
                {
                  "text": "Yoa 1.42",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "na yĩla mamanyie ũla mumo nanengiwe, Yakovo na Keva na Yoana, ala matalawa kwĩthĩwa nĩmo ituĩ, manengie nyie vamwe na Valanava moko ma aũme ma mũamba, nĩ kana ithyĩ tũthi kwa Andũ‐ma‐mbaĩ‐ingĩ, nao mathi kwa ala maĩkawa; ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.9",
            "verseOrgIds": [
              "GAL.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GAL 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.11.30"
              },
              "items": [
                {
                  "text": "Meko 11.30",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.12.25"
              },
              "items": [
                {
                  "text": "12.25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ĩndĩ no ũndũ ũmwe mendie nĩ kana tũmalilikane ala ngya; naw’o ũndũ ũsu naĩ na ũthangaau kũwĩka.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.10",
            "verseOrgIds": [
              "GAL.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GAL 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.10",
            "verseOrgIds": [
              "GAL.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GAL 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ yĩla Keva wokie Andiokia, nĩnamũkananĩsye twenene, nũndũ aĩ mũsilĩle kwĩthĩwa nĩ mũvĩtan’ya. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.11",
            "verseOrgIds": [
              "GAL.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GAL 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.11.3"
              },
              "items": [
                {
                  "text": "Meko 11.3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ mbee wa andũ amwe matanauma kwa Yakovo, aĩsaa lĩu na Andũ‐ma‐mbaĩ‐ingĩ; ĩndĩ yĩla mookie, atundua na eevathana nao, aimakĩa asu ala maĩkawa. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.12",
            "verseOrgIds": [
              "GAL.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GAL 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Ayuti ala angĩ meealyũlile vamwe nake; o na Valanava nĩwaiwe nĩ wangangan’yo woo. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.13",
            "verseOrgIds": [
              "GAL.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GAL 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ yila noonie kana maiendaa na mĩendele myaĩlu kwĩanana na ũla w’o wa ũvoo mũseo, namũtavĩsye Keva mbee wamo onthe, Ethĩwa we, wĩ Mũyuti, ũvikĩlaa maũndũ ma Andũ‐ma‐mbaĩ‐ingĩ, na ti ala ma Ayuti, kũilyĩ ata we kũingĩĩsya Andũ‐ma‐mbaĩ‐ingĩ kũvikĩlaa maũndũ ma Ayuti?",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.14",
            "verseOrgIds": [
              "GAL.2.14"
            ]
          }
        }
      ]
    },
