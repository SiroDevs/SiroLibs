                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.3.8"
              },
              "items": [
                {
                  "text": "3.8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩnĩsĩ vala ũtwĩe, navo nĩ vala ve kĩvĩla kya ũsumbĩ kya Satani: naku ũyĩkwete mũno syĩtwa yakwa, o na ndwaakaĩa mũĩkĩĩo wakwa, o na ĩvinda ya Andiva ngũsĩ yakwa yĩ kĩthito, ũla woaĩwe kwenyu, vala Satani ũtwĩe. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.13",
            "verseOrgIds": [
              "REV.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
