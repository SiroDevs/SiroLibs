                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mũandĩkĩe mũlaĩka wa ĩkanisa yĩla yĩ Thiatila atĩĩ:",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.18",
