            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩnĩsĩ ũnyamao waku, na ũkya waku (ĩndĩ wĩ mũthwii), na nĩnĩsĩ kũumana kwa asu meyĩtaa Ayuti, na ti w’o, ĩndĩ nĩ ĩsinakoke ya Satani. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.9",
            "verseOrgIds": [
              "REV.2.9"
            ]
          }
        },
