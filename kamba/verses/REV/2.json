              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maũndũ aa easya ũla wa mbee na ũla wa mũminũkĩlyo, ũla waĩ mũkw’ũ, na eethĩwa thayũ ĩngĩ: ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.8",
            "verseOrgIds": [
              "REV.2.8"
            ]
          }
        },
        {
