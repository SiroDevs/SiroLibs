              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.3.1"
              },
              "items": [
                {
                  "text": "Nzek 3.1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.22.31"
              },
              "items": [
                {
                  "text": "Lk 22.31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na neew’a wasya mũnene ĩtunĩ, ũkyasya,",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.10",
            "verseOrgIds": [
              "REV.12.10"
            ]
          }
        }
