              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.9.4"
              },
              "items": [
                {
                  "text": "Esek 9.4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.9.6"
              },
              "items": [
                {
                  "text": "6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "akyasya, Mũikathũkye nthĩ, kana ũkanga, kana mĩtĩ, kũvika twamba ũsyĩkĩa ngombo sya Ngai waitũ, ũsiĩlo itulyanĩ syasyo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.3",
            "verseOrgIds": [
              "REV.7.3"
            ]
          }
        },
        {
          "name": "verse",
