            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na neew’a ũtalo wa ala meekĩĩtwe ũsiĩlo, ngĩlĩ ĩana na mĩongo ĩna na inya, ala meekĩĩtwe ũsiĩlo kuma mbaĩnĩ syonthe sya ana ma Isilaeli:",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.4",
            "verseOrgIds": [
              "REV.7.4"
            ]
          }
        }
