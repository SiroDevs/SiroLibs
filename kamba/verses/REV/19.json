            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.10.17"
              },
              "items": [
                {
                  "text": "Kũt 10.17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
