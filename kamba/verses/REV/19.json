                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na noona mũlaĩka ũmwe aũngeme syũanĩ; na aneena na wasya mũnene, aitavya nyũnyi syonthe ila ilũlũkaa ĩtunĩ katĩ, Ũkai mũmbane vamwe mbokanĩ ĩla nene ya Ngai; ",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.17",
            "verseOrgIds": [
              "REV.19.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "REV 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "nĩ kana mũye nyama sya asumbĩ, na nyama sya anene ma asikalĩ ngili, na nyama sya andũ ala me na vinya, na nyama sya mbalasi na sya ala masyĩkalĩlaa, na nyama sya andũ onthe, ala mate ngombo na ngombo, anini na anene.",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.18",
            "verseOrgIds": [
              "REV.19.18"
            ]
          }
        }
      ]
    },
