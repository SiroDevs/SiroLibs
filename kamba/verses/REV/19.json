              "items": [
                {
                  "text": "Ũvu 16.16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na noona ĩla nyamũ, na asumbĩ ma nthĩ, na ita syoo, mombanĩte makwatye kaũ na ũla wĩkalĩle ĩla mbalasi, na ita syake. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.19",
            "verseOrgIds": [
              "REV.19.19"
            ]
          }
        },
        {
