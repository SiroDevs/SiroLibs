              "type": "tag",
              "attrs": {
                "loc": "REV.17.14"
              },
              "items": [
                {
                  "text": "Ũvu 17.14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.6.15"
              },
              "items": [
                {
                  "text": "1 Tim 6.15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ngũanĩ yake na nthũnũnĩ yake e na syĩtwa yĩandĩkĩtwe, MŨSUMBĨ WA ASUMBĨ NA MWĨAĨI WA EAĨI.",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.16",
            "verseOrgIds": [
              "REV.19.16"
            ]
          }
        }
      ]
    },
