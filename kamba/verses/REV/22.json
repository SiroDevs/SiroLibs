            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ambĩa, Ndũkaisiĩle ndeto sya wathani wa ĩvuku yĩĩ; nĩkwĩthĩwa ĩvinda nĩ ĩthengeeu. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.10",
            "verseOrgIds": [
              "REV.22.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 22:11"
          },
