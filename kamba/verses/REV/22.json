              },
              "items": [
                {
                  "text": "Nda 12.10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ũla ũte mũlũngalu, naendeeae na ũla ũte ũlũngalu: na ũla mũvuku, naendeeae na kũvukw’a: na ũla mũlũngalu, naendeeae na ũlũngalu: na ũla mũtheu, naendeeae na kũthew’a. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.11",
            "verseOrgIds": [
              "REV.22.11"
            ]
          }
        },
