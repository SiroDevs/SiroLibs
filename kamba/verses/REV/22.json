                  "text": "1 Ako 14.32",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ambĩa, Ndeto ii nĩ sya kĩthito na nĩ sya w’o: na Mwĩaĩi, Ngai wa maveva ma athani, atũma mũlaĩka wake asyon’ye ngombo syake maũndũ ala matatĩa kwĩthĩwa mĩtũkĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.6",
            "verseOrgIds": [
              "REV.22.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.3.11"
              },
              "items": [
                {
                  "text": "Ũvu 3.11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.1.3"
              },
              "items": [
                {
                  "text": "1.3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na sisya, nyie ngooka mĩtũkĩ. Nĩ mũathime ũla ũkwataa ndeto sya wathani wa ĩvuku yĩĩ.",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.7",
            "verseOrgIds": [
              "REV.22.7"
            ]
          }
        }
      ]
    },
