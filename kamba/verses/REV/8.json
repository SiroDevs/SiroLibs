              "items": [
                {
                  "text": "Ava 2.20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na akyũmbũa ũsiĩlo wa mũonza, kwakilya ki ĩtunĩ ĩvinda ya nyunzu ya saa. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.1",
            "verseOrgIds": [
              "REV.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.24.31"
              },
              "items": [
                {
                  "text": "Mt 24.31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na noona alaĩka mũonza ala maũngamaa mbee wa Ngai; nao manengwa masoo mũonza.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.2",
            "verseOrgIds": [
              "REV.8.2"
            ]
          }
        }
      ]
    },
    {
