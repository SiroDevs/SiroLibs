            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mũlaĩka wa kelĩ avuva soo, na kweethĩwa kĩndũ kĩilyĩ kĩĩma kĩnene kyakene mwaki kyekw’a ũkanganĩ: na kĩlungu kya katatũ kya ũkanga kyatw’ĩka nthakame; ",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.8",
            "verseOrgIds": [
              "REV.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "na nyamũ syakw’a, kĩlungu kya katatũ kya ila syaĩ ũkanganĩ, o ila syaĩ thayũ; na kĩlungu kya katatũ kya ngalawa kyaanangĩka.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.9",
            "verseOrgIds": [
              "REV.8.9"
            ]
          }
        }
      ]
