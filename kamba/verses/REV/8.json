              "items": [
                {
                  "text": "Esek 10.2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mũlaĩka oosa kĩtoeesya; na akyusũsya mwaki wa kĩthembeo, na akĩkya nthĩ: na ĩtina kweethĩwa itundumo, na mawasya, na motisi, na kĩtetemo kya nthĩ.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.5",
            "verseOrgIds": [
              "REV.8.5"
            ]
          }
        }
      ]
    },
