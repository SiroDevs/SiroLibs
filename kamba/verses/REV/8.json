                {
                  "text": "Nda 8.10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mũlaĩka wa katatũ avuva soo, na ndata nene yavalũka kuma ĩtunĩ, yakene ta ũmũĩ, nayo yavalũkĩla kĩlungu kya katatũ kya mbũsĩ, na nthongo sya manzĩ; ",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.10",
            "verseOrgIds": [
              "REV.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "na syĩtwa ya ndata ĩsu nĩ Avisintho: na kĩlungu kya katatũ kya manzĩ kyeekĩwa ũũ; na andũ aingĩ makw’a nĩ manzĩ asu, nĩkwĩthĩwa maĩ na ũũ mũno.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.11",
            "verseOrgIds": [
              "REV.8.11"
            ]
          }
        }
      ]
