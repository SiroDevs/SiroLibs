            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake ooka, na oosa yĩla ĩvuku kw’okonĩ kwa aũme kwa ũla wekalĩte kĩvĩlanĩ kya ũsumbĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.7",
            "verseOrgIds": [
              "REV.5.7"
            ]
          }
