            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "na ũmwe wa atumĩa ambĩa, Ndũkaĩe; sisya, Mũnyambũ ũla wa mbaĩ ya Yuta, Kĩtina kya Ndaviti, nũkĩlĩtye atonye kũvuũa yĩla ĩvuku na kumbũa mosiĩlo mũonza mayo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.5",
            "verseOrgIds": [
              "REV.5.5"
            ]
          }
        },
