                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.17.8"
              },
              "items": [
                {
                  "text": "17.8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na yĩla makethĩwa maminĩte ũkũsĩ woo, ĩla nyamũ yumaa ĩimanĩ yĩte kĩtulu ĩkakwatya kaũ nao, nayo ĩkamakĩlya vinya, na kũmoaa. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.7",
            "verseOrgIds": [
              "REV.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.1.10"
              },
              "items": [
                {
                  "text": "Isa 1.10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.13.34"
              },
              "items": [
                {
                  "text": "Lk 13.34",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na simba syoo ikeethĩwa nzĩanĩ ya ndũa ĩsu nene, ĩla yĩtawa Sotomo na Misili mĩneenelenĩ ya veva, navo nĩ vala Mwĩaĩi woo wambiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.8",
            "verseOrgIds": [
              "REV.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ala maumaa katĩ wa ngo sya andũ na mbaĩ na ithyomo na mĩthemba ya andũ makasisya simba syoo mĩthenya ĩtatũ na nyunzu, na maiketĩkĩla simba syoo syĩnzĩwe nthĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.9",
            "verseOrgIds": [
              "REV.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.105.38"
              },
              "items": [
                {
                  "text": "Sav 105.38",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ala matwĩe nthĩ makatana nũndũ woo, na kwĩw’a mũyo; na makatwaanĩa mĩthĩnzĩo ene kwa ene; nĩkwĩthĩwa athani asu elĩ nĩmanathĩnĩtye ala matwĩe nthĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.10",
            "verseOrgIds": [
              "REV.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.37.5"
              },
              "items": [
                {
                  "text": "Esek 37.5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.37.10"
              },
              "items": [
                {
                  "text": "10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.15.12"
              },
              "items": [
                {
                  "text": "Mwa 15.12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩtina wa mĩthenya ĩsu ĩtatũ na nyunzu veva wa thayũ kuma kwa Ngai wamalika nthĩnĩ, na maũngama na maũũ moo; na w’ĩa mũnene wamakwata ala mamasyaasya. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.11",
            "verseOrgIds": [
              "REV.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.2.11"
              },
              "items": [
                {
                  "text": "2 Asu 2.11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao meew’a wasya mũnene kuma ĩtunĩ ũkĩmea, Ambatai kũũ. Na mambata me ĩthweonĩ malika ĩtunĩ; na amaitha moo mamasyaĩĩsya. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.12",
            "verseOrgIds": [
              "REV.11.12"
            ]
          }
        },
