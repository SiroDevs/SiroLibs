                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asu me na ũkũmũ wa kũvinga ĩtu, mbua ndĩkaue mĩthenyanĩ ya wathani woo: na me na ũkũmũ ĩũlũ wa iw’ũ kwialyũla syĩthĩwe nthakame, na kũmĩkũna nthĩ na kĩla ũthĩn’yo, o ũndũ mekwanda. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.6",
            "verseOrgIds": [
              "REV.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 11:7"
          },
          "items": [
