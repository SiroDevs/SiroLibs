                  "text": "Mt 19.28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ũla ũkĩlasya, ngamũnenga kwĩkala vamwe nakwa kĩvĩlanĩ kyakwa kya ũsumbĩ, o ũndũ nakwa nakĩlilye, na kwĩkala vamwe na Asa wakwa kĩvĩlanĩ kyake kya ũsumbĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.21",
