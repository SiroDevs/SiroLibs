            "number": "16",
            "style": "v",
            "sid": "REV 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ nĩkwĩthĩwa wĩ kamulutĩla, o na ndwĩ mũvyũ na ndwĩ mũthithu, ngaũtwĩla wume kanyw’anĩ wakwa. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.16",
            "verseOrgIds": [
              "REV.3.16"
            ]
          }
        },
