            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sisya, nĩũngeme mũomonĩ na kũvingũsya: ethĩwa mũndũ o na wĩva akeew’a wasya wakwa na kũmbingũĩa mũomo, ngalika kwake, na ngaĩsanĩa nake, nake akaĩsanĩa nakwa. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.20",
            "verseOrgIds": [
              "REV.3.20"
            ]
          }
        },
        {
