            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ũla ũkĩlasya, o ta ũu akavw’ĩkwa ngũa nzaũ; na ndikananga nongi syĩtwa yake ĩvukunĩ ya thayũ, na ngayumbũla syĩtwa yake mbee wa Asa wakwa, na mbee wa alaĩka make. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.5",
            "verseOrgIds": [
              "REV.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ũla wĩ na kũtũ, nĩew’e ũndũ Veva ũnũũtavya makanisa.",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.6",
            "verseOrgIds": [
              "REV.3.6"
            ]
          }
        }
      ]
    },
