            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "na akauma akenge mbaĩ ila syĩ ikotonĩ inya sya nthĩ, Ngoki na Makoki, kũmomban’ya vamwe kaũnĩ: ũtalo wamo nĩ ta kĩthangathĩ kya ũkanganĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.8",
            "verseOrgIds": [
              "REV.20.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HAB.1.6"
              },
              "items": [
                {
                  "text": "Ava 1.6",
