            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na noona mũlaĩka aitheea kuma ĩtunĩ, e na ũvungũo wa yĩla ĩima yĩte kĩtulu na mũnyololo mũnene kw’okonĩ kwake. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.1",
            "verseOrgIds": [
              "REV.20.1"
            ]
          }
        },
        {
          "name": "verse",
