              "items": [
                {
                  "text": "1 Ako 6.2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na noona ivĩla sya ũsumbĩ, namo mekala ĩũlũ wasyo, na manengwa kũsila: na noona mathayũ ma ala matililwe mĩtwe kwondũ wa ũkũsĩ wa Yesũ, na ndeto ya Ngai, na ala mataathaitha ĩla nyamũ, kana mũvw’anano wayo, na ala mataaosa ũvano itulyanĩ syoo na mokonĩ moo; nao meethĩwa thayũ, na masumbĩka vamwe na Klĩsto myaka ngili. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.4",
            "verseOrgIds": [
              "REV.20.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.15.23"
              },
              "items": [
                {
                  "text": "1 Ako 15.23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TH.4.16"
              },
              "items": [
                {
                  "text": "1 Ath 4.16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akw’ũ ala matialile matyaaĩthĩwa thayũ mũvaka myaka ĩsu ngili ĩthele. Ũu nĩw’o ũthayũũkyo wa mbee. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.5",
            "verseOrgIds": [
              "REV.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.61.6"
              },
              "items": [
                {
                  "text": "Isa 61.6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.5.10"
              },
              "items": [
                {
                  "text": "Ũvu 5.10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩ mũathime na nĩ mũtheu ũla wĩ na kĩanda ũthayũũkyonĩ wa mbee: ĩũlũ wa asu kĩkw’ũ kya kelĩ kĩti na ũkũmũ; ĩndĩ makeethĩwa athembi ma Ngai ma Klĩsto, na makasumbĩka vamwe nake myaka ngili.",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.6",
            "verseOrgIds": [
              "REV.20.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
