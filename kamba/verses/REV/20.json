          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.3.1"
              },
              "items": [
                {
                  "text": "Mwa 3.1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.3.1"
              },
              "items": [
                {
                  "text": "Nzek 3.1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.9.1"
              },
              "items": [
                {
                  "text": "Ũvu 9.1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.12.9"
              },
              "items": [
                {
                  "text": "12.9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake akwata ũla mũkũnga, nzoka ngũũ, nayo nĩ Ndevili na nĩwe Satani, na amwova myaka ngili, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.2",
            "verseOrgIds": [
              "REV.20.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TH.2.9"
              },
              "items": [
                {
                  "text": "2 Ath 2.9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TH.2.10"
              },
              "items": [
                {
                  "text": "10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "na amwĩkya ĩimanĩ yĩte kĩtulu na ayĩvinga, na asyĩsiĩla ĩũlũ wake, nĩ kana ndakakenge mbaĩ ĩngĩ, mũvaka ĩla myaka ngili ĩthele: ĩtina wa ũu mũvaka athaw’e kavinda kanini.",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.3",
            "verseOrgIds": [
              "REV.20.3"
            ]
          }
        }
      ]
    },
