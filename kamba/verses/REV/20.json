                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na noona kĩvĩla kĩnene kyeũ kya ũsumbĩ, na ũla wĩkalĩte ĩũlũ wakyo, nthĩ na ĩtu syakĩa ũthyũ wake; na vaiaaoneka vandũ vasyo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.11",
            "verseOrgIds": [
              "REV.20.11"
            ]
          }
        },
        {
