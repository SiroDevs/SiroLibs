              "items": [
                {
                  "text": "Esek 38.22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.39.6"
              },
              "items": [
                {
                  "text": "39.6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao mambata ĩũlũ wa ũthanthau wa nthĩ, na mathyũlũlũka mwako wa maeema wa atheu, na ndũa ĩla yendetwe; na mwaki watheea kuma ĩtunĩ, na wamamina. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.9",
            "verseOrgIds": [
              "REV.20.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 20:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.19.24"
              },
              "items": [
                {
                  "text": "Mwa 19.24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.19.20"
              },
              "items": [
                {
                  "text": "Ũvu 19.20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ndevili ũla wamakengie ekw’a ĩianĩ ya mwaki na mũvĩlĩtĩ, nĩvo ve ĩla nyamũ na ũla mwathani wa ũvũngũ; namo makanyamaw’a mũthenya ya ũtukũ tene na tene.",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.10",
            "verseOrgIds": [
              "REV.20.10"
            ]
          }
        }
      ]
    },
