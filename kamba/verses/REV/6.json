                "loc": "ZEC.1.8"
              },
              "items": [
                {
                  "text": "Nzek 1.8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.6.1+ZEC.6.2+ZEC.6.3"
              },
              "items": [
                {
                  "text": "6.1–3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na noona, na sisya, mbalasi nzaũ, na ũla ũmĩtũlĩte aĩ na ũta; na anengwa ngovia ya ũsumbĩ: na aumaala aikĩlan’ya, na nĩ kana akĩlan’ye.",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.2",
            "verseOrgIds": [
              "REV.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
