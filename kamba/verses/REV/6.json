        },
        {
          "text": "Na noona Katena akyũmbũa ũmwe wa ala mosiĩlo mũonza, na neew’a kĩmwe kya ila syũmbe inya syĩ thayũ kĩkyasya na wasya ta wa kĩtundumo, Ũka. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.1",
            "verseOrgIds": [
              "REV.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 6:2"
          },
