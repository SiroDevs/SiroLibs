            "number": "4",
            "style": "v",
            "sid": "REV 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.4",
            "verseOrgIds": [
              "REV.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na oombũa ũsiĩlo wa katatũ, neew’a kyũmbe kya katatũ kĩla kĩ thayũ kĩkyasya Ũka. Na noona, na sisya, mbalasi nziũ; na ũla ũmĩtũlĩte aĩ na kĩthimi kw’okonĩ kwake. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.5",
            "verseOrgIds": [
              "REV.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na neew’a ta wasya katĩ wa ila syũmbe inya syĩ thayũ ũkyasya, Kĩvava kya nganũ nĩ silingi, na ivava itatũ sya mbaale nĩ silingi na mauta na mbinyu ndũkaithũkye.",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.6",
            "verseOrgIds": [
              "REV.6.6"
            ]
          }
        }
      ]
    },
