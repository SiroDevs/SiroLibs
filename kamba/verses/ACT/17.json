              "items": [
                {
                  "text": "Yel 23.23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "nĩ kana mamũmanthe Ngai, o na ethĩwa nĩmatonya ũmũmantha maimũvavata mamwone, o na kau nde kũasa na kĩla ũmwe waitũ: ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.27",
            "verseOrgIds": [
              "ACT.17.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 17:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "nũndũ twĩ thayũ, na nĩtũũthi, na twĩ na mwĩkalĩle witũ nthĩnĩ wake; o tondũ atili amwe menyu ma mbathi maisye,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.28",
            "verseOrgIds": [
              "ACT.17.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
