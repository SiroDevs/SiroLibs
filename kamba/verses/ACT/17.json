              "items": [
                {
                  "text": "1 Ako 12.2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ kwa kwĩthĩwa twĩ ũsyao wa Ngai, tũiaĩlwe nĩ ũtalĩlya kana Ũ‐Ngai ũvw’anene na thaavu, kana vetha, kana ĩvia, ila syasũvĩtwe na ũtũĩka na ũĩ wa mũndũ. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.29",
            "verseOrgIds": [
              "ACT.17.29"
            ]
          }
        },
        {
