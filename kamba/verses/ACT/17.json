          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na vaulo aũngama Aleovako katĩ, na asya,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.22",
            "verseOrgIds": [
              "ACT.17.22"
            ]
          }
        }
