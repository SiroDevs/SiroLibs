              "items": [
                {
                  "text": "Lk 24.27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ mavinda ma ũlea ũmanya, Ngai etw’a ta ũteona; ĩndĩ yu emeaĩa andũ onthe kũndũ kw’onthe maalyũle ngoo: ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.30",
            "verseOrgIds": [
              "ACT.17.30"
            ]
          }
        },
        {
