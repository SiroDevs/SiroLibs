              "items": [
                {
                  "text": "2 Tim 3.11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ kwooka Ayuti kw’o kuma Andiokia na Ikonio: na mamaingĩĩsya makomano, mamũkimanga Vaulo na mavia, na mamũkusya mamumya ndũanĩ, maitalĩlya kana nĩ mũkw’ũ. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.19",
            "verseOrgIds": [
              "ACT.14.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ amanyĩw’a maũngeme mamũthyũlũlũkĩte, ookĩla, na avota ndũanĩ: na ũnĩ ũsu aumaala vamwe na Valanava mathi Ndelive. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.20",
            "verseOrgIds": [
              "ACT.14.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.28.19"
              },
              "items": [
                {
                  "text": "Mt 28.19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na matavan’ya ũvoo mũseo ndũanĩ ĩsu, na matw’ikĩthya andũ aingĩ amanyĩw’a, maalũka Lisitela, na Ikonio, na Andiokia, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.21",
            "verseOrgIds": [
              "ACT.14.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 14:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.11.23"
              },
              "items": [
                {
                  "text": "Meko 11.23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TH.3.3"
              },
              "items": [
                {
                  "text": "1 Ath 3.3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.7.14"
              },
              "items": [
                {
                  "text": "Mt 7.14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "makĩlũlũmĩlya ngoo sya amanyĩw’a, makĩmataa mekalae ũla mũĩkĩĩonĩ, na maimon’ya kana tũitĩa kũvĩtĩla mathĩnanĩ maingĩ tũilika ũsumbĩnĩ wa Ngai. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.22",
            "verseOrgIds": [
              "ACT.14.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.13.3"
              },
              "items": [
                {
                  "text": "Meko 13.3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mamaiĩa atumĩa kĩla ĩkanisa, na mavoya Ngai mateũya, mamanengane kwa Mwĩaĩi ũla metĩkĩlĩte. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.23",
            "verseOrgIds": [
              "ACT.14.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 14:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mavĩtĩla Visitia, na mooka Vambilia. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.24",
            "verseOrgIds": [
              "ACT.14.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 14:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na maneena ĩla ndeto Velika, matheea Atalia; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.25",
            "verseOrgIds": [
              "ACT.14.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 14:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
