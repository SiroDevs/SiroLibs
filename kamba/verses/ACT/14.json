              },
              "items": [
                {
                  "text": "Meko 13.1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.13.2"
              },
              "items": [
                {
                  "text": "2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "na kuma vo mathi na ngalawa Andiokia, vala manenganĩwe mumonĩ wa Ngai kwondũ wa wĩa ũla meanĩsye. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.26",
            "verseOrgIds": [
              "ACT.14.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ACT 14:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.16.9"
              },
              "items": [
                {
                  "text": "1 Ako 16.9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.11.18"
              },
              "items": [
                {
                  "text": "Meko 11.18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao mavika, na moomban’ya ĩkanisa vamwe, mayĩtavya maũndũ onthe ala Ngai wĩkĩte namo, na ũndũ ũmavingũĩe Andũ‐ma‐mbaĩ‐ingĩ mũomo wa mũĩkĩĩo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.27",
            "verseOrgIds": [
              "ACT.14.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 14:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao mekala na amanyĩw’a ĩvinda ĩasa.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.28",
            "verseOrgIds": [
              "ACT.14.28"
            ]
