                {
                  "text": "Meko 20.7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mekalaa malũlũmĩle momanyĩsyonĩ ma atũmwa, na mũambanĩ, na kũtila kĩmũtũ, na mboya.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.42",
            "verseOrgIds": [
              "ACT.2.42"
            ]
          }
        }
      ]
    },
