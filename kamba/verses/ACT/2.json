          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "na mathoosya syĩndũ syoo ila maĩ nasyo, na maaana onthe, kĩla mũndũ o ũndũ waĩ na vata wĩana. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.45",
            "verseOrgIds": [
              "ACT.2.45"
            ]
          }
        },
