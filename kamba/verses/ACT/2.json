              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na w’ĩa wamũlika kĩla mũndũ: na momakyo maingĩ na syama nyingĩ syeekwa nĩ atũmwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.43",
            "verseOrgIds": [
              "ACT.2.43"
            ]
          }
        },
        {
