            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mĩthenya mingĩ yavĩta, Ayuti masaman’ya vamwe, mamũae: ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.23",
            "verseOrgIds": [
              "ACT.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
