            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.23.16"
              },
              "items": [
                {
                  "text": "Meko 23.16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ĩndĩ nzama yoo yamanyĩka nĩ Saulo. Nao mamwoveesya mbingĩlonĩ mũthenya na ũtukũ, kana matonye kũmũaa: ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.24",
            "verseOrgIds": [
              "ACT.9.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.11.32"
              },
              "items": [
                {
                  "text": "2 Ako 11.32",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.11.33"
              },
