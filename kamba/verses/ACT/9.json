              "items": [
                {
                  "text": "Meko 10.6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Vetelo ekala vo Yova mĩthenya mingĩ kwa mũndũ wetawa Simoni, mũseũvya wa ithuma.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.43",
