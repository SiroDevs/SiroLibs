                  "text": "33",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ĩndĩ amanyĩw’a mamwosa na ũtukũ na mamũtheelelya ũvainĩ e kĩkavũnĩ.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.25",
            "verseOrgIds": [
              "ACT.9.25"
            ]
          }
        }
      ]
