                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ana‐a‐asa, nĩkwaĩle ũla ũandĩko wĩanĩw’e, ũla Veva Mũtheu wambie ũneena na kanyw’a wa Ndaviti ũndũ wa Yutasi, ũla waĩ mũtongoi wa ala mamũkwatie Yesũ. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.16",
            "verseOrgIds": [
              "ACT.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩkwĩthiwa atalĩlanaw’a naitũ, na nĩwosie kĩanda kyake ũthũkũminĩ ũũ. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.17",
            "verseOrgIds": [
              "ACT.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 1:18"
          },
          "items": [
