              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.27.3+MAT.27.4+MAT.27.5+MAT.27.6+MAT.27.7+MAT.27.8+MAT.27.9+MAT.27.10"
              },
              "items": [
                {
                  "text": "Mt 27.3–10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Na ĩndĩ mũndũ ũsu athooie mũũnda na ĩtuvi ya ũthũku wake; na avalũka na ĩvu, aatũkanĩla katĩ, na maa make onthe metĩka. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.18",
            "verseOrgIds": [
              "ACT.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ũndũ ũsu wamanyĩkie nĩ onthe ala matwĩe Yelusaleme; na ũu watumie mũũnda ũsu wĩtwa kĩthyomonĩ kyoo Akelitama, na ũalyũlo wayo nĩ, Mũũnda wa nthakame.) ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.19",
            "verseOrgIds": [
              "ACT.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
