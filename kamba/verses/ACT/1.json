          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuma ũvatiso wa Yoana, kũvika mũthenya ũla wosiwe ĩũlũ kuma vala tũĩ, ethĩwe ngũsĩ ya kũthayũũka kwake, vamwe naitũ. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.22",
            "verseOrgIds": [
              "ACT.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na maia andũ elĩ, Yosevu wetawa Valisava, ũla waĩ na syĩtwa yĩngĩ Yusito, na Mathia. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.23",
            "verseOrgIds": [
              "ACT.1.23"
            ]
          }
        },
