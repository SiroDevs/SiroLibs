                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mavoya, maiasya, We, Mwĩaĩi, ũla wĩsĩ ngoo sya andũ onthe, twon’ye ũla ũnyuvĩte wa aa elĩ, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.24",
            "verseOrgIds": [
              "ACT.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "ose ũthũkũmi na ũtũme ũũ, ũla waumiwe nĩ Yutasi nĩ kana aende vandũ vake mwene. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.25",
            "verseOrgIds": [
              "ACT.1.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
