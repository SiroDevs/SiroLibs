        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.5",
            "verseOrgIds": [
              "ACT.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
