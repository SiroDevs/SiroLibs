            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ nĩkũandĩkĩtwe ĩvukunĩ ya Savuli,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.20",
            "verseOrgIds": [
