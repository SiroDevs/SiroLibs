                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwondũ wa ũu, nĩkwaĩle mũndũ ũmwe wa asu ala maatĩanĩe naitũ mĩthenya yonthe ĩla Mwĩaĩi Yesũ wavotaa na kuma katĩ waitũ, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.21",
            "verseOrgIds": [
              "ACT.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
