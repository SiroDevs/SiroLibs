              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ nĩtũkwenda kwĩw’a kuma kwaku ũndũ ũkwasya: nũndũ kĩthemba kyu nĩkĩsĩkĩwe kwitũ kana nĩkĩwetawa naĩ kũndũ kw’onthe.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.22",
            "verseOrgIds": [
              "ACT.28.22"
            ]
          }
        }
      ]
