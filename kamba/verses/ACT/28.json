              "ACT.28.16"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.27.3"
              },
              "items": [
                {
                  "text": "Meko 27.3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na twalika Lomi, ũla mũnene wa asikalĩ ĩana amanengane ovwa mokonĩ ma mũnene wa nguthu ya asũvĩi; ĩndĩ Vaulo nĩwanengiwe ũthei wa kwĩkala vandũ vake mwene vamwe na mũsikalĩ ũla wamũsũvĩaa.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.16",
            "verseOrgIds": [
              "ACT.28.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 28:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.16",
            "verseOrgIds": [
              "ACT.28.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
