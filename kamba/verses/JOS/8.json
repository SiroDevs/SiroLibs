              },
              "items": [
                {
                  "text": "Kũt 13.16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.28",
            "verseOrgIds": [
              "JOS.8.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JOS 8:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na amũsũsya mũsumbĩ wa Ai mũtĩnĩ kũvika wĩoo: na syũa yĩkĩthũa Yosua aumya mwĩao, na maumya kimba kyake mũtĩnĩ, na makĩkya ũlikĩlonĩ mbingĩlonĩ ya ndũa, na makyũmbĩĩa mbumbu nene ya mavia, kũvika mũnthĩ ũũ. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.29",
            "verseOrgIds": [
              "JOS.8.29"
            ]
          }
        },
