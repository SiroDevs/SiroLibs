              "JOS.8.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOS 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ala oveesya mookĩla mĩtũkĩ kuma vala maĩ, na o yĩla watambũũkisye kw’oko kwake masemba, na malika ndũanĩ, na mamĩkwata; na meekalaata na makwatya ndũa mwaki. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.19",
            "verseOrgIds": [
              "JOS.8.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOS 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na yĩla andũ ma Ai masyaisye ĩtina woo, moona, na, sisya, syũki ya ĩla ndũa yambata ĩtunĩ, na matyaĩ na vinya wa kũkũka kũũ o na kũũ: na andũ ala maĩ manakũka weũnĩ mamaalũkĩla ala mamaatĩĩe. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.20",
            "verseOrgIds": [
              "JOS.8.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOS 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na yĩla Yosua na Isilaeli onthe moonie kana ala oveesya nĩmakwata ndũa, na kana syũki ya ndũa nĩyambatĩte, meetulũla ĩngĩ; na mooaa andũ ma Ai. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.21",
            "verseOrgIds": [
              "JOS.8.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOS 8:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ala angĩ mamaumaalĩla kuma ndũanĩ; na kwondũ wa ũu maĩ katĩ wa Isilaeli, amwe ngalĩ ĩno, na amwe ngalĩ ĩya: namo mamakũna, mateũmatialya o na ũmwe e thayũ o na wa kũvonoka. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.22",
            "verseOrgIds": [
              "JOS.8.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOS 8:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mũsumbĩ wa Ai mamũkwata e thayũ, na mamũetee Yosua.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.23",
            "verseOrgIds": [
              "JOS.8.23"
            ]
          }
        }
      ]
    },
    {
