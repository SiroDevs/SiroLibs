      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.17",
            "verseOrgIds": [
              "JOS.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOS 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yeova amwĩa Yosua, Tambũũkya katumo kala ke kw’okonĩ kwaku kelekele Ai; nũndũ nĩngũmĩnengane kw’okonĩ kwaku. Na Yosua atambũũkya katumo kala kaĩ kw’okonĩ kwake kelekele ĩla ndũa. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.18",
            "verseOrgIds": [
              "JOS.8.18"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
