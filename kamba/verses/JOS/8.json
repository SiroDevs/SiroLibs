            "sid": "JOS 8:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ Yosua avĩvya Ai, na amĩtw’ĩkĩthya kĩvumbu tene na tene, no ĩaanzo, kũvika mũnthĩ ũũ. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.28",
            "verseOrgIds": [
              "JOS.8.28"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
