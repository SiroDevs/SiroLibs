          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na andĩka vo mavianĩ wumĩĩsyo wa mĩao ya Mose, ĩla waandĩkie, ana ma Isilaeli mene. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.32",
            "verseOrgIds": [
