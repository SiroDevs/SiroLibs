        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOS 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ vetha w’onthe, na thaavu, na mĩio ya ũthuku na ya kĩaa, nĩ ntheu kwa Yeova: ikaetwe vala vaiawa ũthwii va Yeova. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.19",
            "verseOrgIds": [
              "JOS.6.19"
            ]
          }
        },
