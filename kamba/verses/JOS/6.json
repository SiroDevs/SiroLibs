            "sid": "JOS 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ Yeliko yaĩ mbinge ki kwondũ wa ana ma Isilaeli: vatyaĩ waaumaala, na vatyaĩ waalika. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.1",
            "verseOrgIds": [
              "JOS.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yeova amwĩa Yosua, Sisya, nĩnĩnenganĩte Yeliko, na mũsumbĩ wayo, na ngũmbaũ nene, kw’okonĩ kwaku. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.2",
            "verseOrgIds": [
              "JOS.6.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
