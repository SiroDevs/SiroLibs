            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nenyu mũkathyũlũlũke ndũa, o andũ onthe ma kaũ, mũkĩthyũlũlũka ndũa ĩmwe. Wĩke ũu mĩthenya thanthatũ. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.3",
            "verseOrgIds": [
              "JOS.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na athembi mũonza makakue masoo mũonza ma mbya sya ndũũme me mbee wa yĩla ĩsandũkũ: na mũthenya wa mũonza mũkathyũlũlũke ĩla ndũa mathyũlũlũka mũonza, na athembi makavuve masoo. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.4",
            "verseOrgIds": [
              "JOS.6.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.10.8"
              },
              "items": [
                {
                  "text": "Mot 10.8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.7.16"
              },
              "items": [
                {
                  "text": "Asi 7.16",
                  "type": "text"
                }
              ]
            },
