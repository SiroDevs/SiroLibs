              "items": [
                {
                  "text": "Mot 32.20–28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.1.13",
            "verseOrgIds": [
              "JOS.1.13"
            ]
          }
        },
        {
          "name": "verse",
