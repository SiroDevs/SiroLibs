          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lilikanai ndeto ĩla Mose mũthũkũmi wa Yeova wamwĩaĩe, akĩmwĩa, Yeova Ngai wenyu nũmũnengaa kũthũmũa, na akamũnenga nthĩ ĩno. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.1.13",
            "verseOrgIds": [
              "JOS.1.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
