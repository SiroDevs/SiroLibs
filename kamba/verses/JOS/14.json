                {
                  "text": "Mot 14.24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.1.36"
              },
              "items": [
                {
                  "text": "Kũt 1.36",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.9",
            "verseOrgIds": [
              "JOS.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na yu, sisya, Yeova nũmbĩkalĩtye nĩ thayũ, o tondũ waneenie, myaka ĩno mĩongo ĩna na ĩtano, kuma ĩvinda yĩla Yeova watavisye Mose ndeto ĩno, o yĩla Isilaeli mangangaa weũnĩ: na yu, sisya, ũmũnthĩ nĩ wa myaka mĩongo nyanya na ĩtano. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.10",
            "verseOrgIds": [
              "JOS.14.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.14.30"
              },
              "items": [
                {
                  "text": "Mot 14.30",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.10",
            "verseOrgIds": [
              "JOS.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "O na yu nĩ na vinya ũmũnthĩ o tondũ naĩ naw’o mũthenya ũla Mose wandũmie: o tondũ vinya wakwa wailyĩ ĩvinda yĩu, now’o vinya wakwa ũilyĩ yu, kwondũ wa kaũ, na kwondũ wa kumaala na kũsyoka. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.11",
            "verseOrgIds": [
              "JOS.14.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
