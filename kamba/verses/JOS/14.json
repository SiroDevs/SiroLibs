                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.11",
            "verseOrgIds": [
              "JOS.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ kwondũ wa ũu nenga nthĩ ĩno yĩ iĩma, ĩla Yeova waneenie ũndũ wayo mũthenya ũsu; nũndũ we nĩweewie mũthenya ũsu kana Aanaki maĩ kw’o, na ndũa nene na mbiie: nokwĩthĩwa Yeova akeethĩwa vamwe nakwa, na ngamalũngya, o tondũ Yeova waneenie. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.12",
            "verseOrgIds": [
              "JOS.14.12"
            ]
          }
        },
