            "number": "9",
            "style": "v",
            "sid": "JOS 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Mose eevĩta mũthenya ũsu, akĩmbĩa, Vate ndĩi, nthĩ ĩla kũũ kwaku kũkinyangĩle ĩkeethĩwa ũtiĩwa waku na wa syana syaku tene na tene, nũndũ nũmũvikĩlĩte Yeova Ngai waku ki. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.9",
            "verseOrgIds": [
              "JOS.14.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
