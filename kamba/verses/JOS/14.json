          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naĩ wa myaka mĩongo ĩna yĩla Mose mũthũkũmi wa Yeova wandũmie kuma Katesi‐mbalinea nĩthiane ĩ nthĩ; na namũtũngĩa ũvoo o tondũ wailyĩ ngoonĩ yakwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.7",
            "verseOrgIds": [
              "JOS.14.7"
            ]
          }
        },
