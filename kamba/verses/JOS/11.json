                "loc": "DEU.20.1"
              },
              "items": [
                {
                  "text": "Kũt 20.1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.10.8"
              },
              "items": [
                {
                  "text": "Yos 10.8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.17.16+JOS.17.17+JOS.17.18"
              },
              "items": [
