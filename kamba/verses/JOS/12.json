        },
        {
          "text": "na asumbĩka kĩĩmanĩ kya Elimoni, na Saleka, na Mbasani yonthe, kũvika mũvakanĩ wa Angesuli na Amaaka na nyunzu ya Ngileati, mũvaka wa Sioni mũsumbĩ wa Esivoni. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.5",
            "verseOrgIds": [
              "JOS.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
