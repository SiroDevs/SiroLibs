              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.7",
            "verseOrgIds": [
              "JOS.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mamwĩa Yosua, Twĩ athũkũmi maku. Na Yosua amakũlya, Mwĩ aaũ? Na mumĩte va? ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.8",
            "verseOrgIds": [
              "JOS.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mamwĩa, Athũkũmi maku nĩmaumĩte nthĩ yĩ kũasa mũno kwondũ wa syĩtwa ya Yeova Ngai waku: nũndũ nĩtwĩw’ĩte nguma yake, na w’onthe ũla wekie Misili, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.9",
            "verseOrgIds": [
              "JOS.9.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
