        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "na w’onthe ũla wekie asumbĩ elĩ ma Aamoli, ala maĩ mũingo wa Yolotani, Sioni mũsumbĩ wa Esivoni, na Oku mũsumbĩ wa Mbasani, ũla waĩ Asetalothi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.10",
            "verseOrgIds": [
              "JOS.9.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
