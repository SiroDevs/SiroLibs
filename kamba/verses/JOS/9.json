              "items": [
                {
                  "text": "Kũt 20.15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.2.10"
              },
              "items": [
                {
                  "text": "Yos 2.10",
                  "type": "text"
                }
              ]
            },
