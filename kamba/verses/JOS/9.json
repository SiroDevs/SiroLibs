            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ana ma Isilaeli maenda kyalo, na mavika ndũa syoo mũthenya wa katatũ. Na ĩndĩ ndũa syoo syeetawa Ngiveoni na Kevila, na Mbeelothi, na Kiliathi‐yealimu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.17",
            "verseOrgIds": [
              "JOS.9.17"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
