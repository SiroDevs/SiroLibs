          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kweethĩwa mĩthenya ĩtatũ yathela ĩtina wa matianĩa ũtianĩo namo, nĩmeewie kana maĩ atũi moo, na kana matwĩe katĩ woo. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.16",
            "verseOrgIds": [
              "JOS.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 9:17"
          },
