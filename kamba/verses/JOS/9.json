              },
              "items": [
                {
                  "text": "Yos 18.25–28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.17",
            "verseOrgIds": [
              "JOS.9.17"
            ]
