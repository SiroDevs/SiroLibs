          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yosua amatũmana, na aneena namo, akĩmea, Mũtũkengete nĩkĩ, mũkĩtwĩa, Twĩ kũasa nenyu mũno; na kaĩ mũtwĩe katĩ waitũ? ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.22",
            "verseOrgIds": [
              "JOS.9.22"
            ]
          }
        },
        {
