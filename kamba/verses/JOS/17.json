              },
              "items": [
                {
                  "text": "Mot 27.6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.27.7"
              },
              "items": [
                {
                  "text": "7",
                  "type": "text"
                }
              ]
