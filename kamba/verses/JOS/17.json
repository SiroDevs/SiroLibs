            "sid": "JOS 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ ana ma Manase matyaatonya kũlũngya ala matwĩe ndũanĩ isu; ĩndĩ Akanaani meevinyĩlĩlya nthĩ ĩsu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.12",
            "verseOrgIds": [
              "JOS.17.12"
            ]
          }
        },
        {
