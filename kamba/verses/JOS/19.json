              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũlimano wa thanthatũ waumĩla wa ana ma Navitali, o kwondũ wa ana ma Navitali kũatĩĩa mĩvĩa yoo. ",
          "type": "text",
          "attrs": {
