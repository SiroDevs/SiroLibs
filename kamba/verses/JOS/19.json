          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ũsu nĩw’o ũtiĩwa wa mbaĩ ya ana ma Aseli kũatĩĩa mĩvĩa yoo, ndũa isu na mĩsyĩ yasyo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.31",
