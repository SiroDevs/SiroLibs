              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "o na Uma, na Aveki, na Leovu: ndũa mĩongo ĩlĩ na ilĩ na mĩsyĩ yasyo. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.30",
            "verseOrgIds": [
