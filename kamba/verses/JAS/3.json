          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JAS.2.18"
              },
              "items": [
                {
                  "text": "Yak 2.18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.2.12"
              },
              "items": [
                {
                  "text": "1 Vet 2.12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũũ wenyu mũĩ na wĩ na ũmanyi? Nĩonan’ye mawĩa make kwondũ wa mũendele wake mũseo nthĩnĩ wa ũuu wa ũĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.3.13",
            "verseOrgIds": [
              "JAS.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JAS 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.4.31"
              },
              "items": [
                {
                  "text": "Aev 4.31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ ethĩwa mwĩ na kĩwĩu kyai na ngananĩo ngoonĩ syenyu, mũikekathĩĩe na mũikanenee ũla w’o ũvũngũ. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.3.14",
            "verseOrgIds": [
              "JAS.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JAS 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JAS.1.5"
              },
              "items": [
                {
                  "text": "Yak 1.5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JAS.1.17"
              },
              "items": [
                {
                  "text": "17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ũsu ti ũĩ ũla ũtheeaa kuma ĩũlũ, ĩndĩ nĩ wa nthĩ, nĩ wa kĩ‐mũndũ, na nĩ wa ndaimoni. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.3.15",
            "verseOrgIds": [
              "JAS.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JAS 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ vala ve kĩwĩu na ngananĩo, nĩvo ve kĩthokoo na kĩla wĩa mũthũku. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.3.16",
            "verseOrgIds": [
              "JAS.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JAS 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.12.11"
              },
              "items": [
                {
                  "text": "Aevl 12.11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ ũĩ ũla wumaa ĩũlũ, mbee nĩ mũtheu, na ĩndĩ nĩ wa mũuo, nĩ mũuu, nĩwĩsũvĩkaa na ũvũthũ, wusũĩte tei na mosyao maseo, ũte na wendeesyo kana wangangan’yo. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.3.17",
            "verseOrgIds": [
              "JAS.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JAS 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.32.17"
              },
              "items": [
                {
                  "text": "Isa 32.17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.5.9"
              },
              "items": [
                {
                  "text": "Mt 5.9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ũsyao wa ũlũngalu nũvuĩawa nthĩnĩ wa mũuo nĩ ala maetae mũuo.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.3.18",
            "verseOrgIds": [
              "JAS.3.18"
            ]
          }
        }
      ]
