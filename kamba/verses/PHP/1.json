            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ ethĩwa kwĩkala thayũ mwĩĩnĩ,— ethĩwa ũu nĩw’o ũsyao wa wĩa wakwa, ndiũmanya ũla nĩnyuva. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.22",
