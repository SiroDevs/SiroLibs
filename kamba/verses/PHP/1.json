                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbivinyĩtwe nĩ maũndũ asu elĩ, nĩ na mea ma kũthi nĩthĩwe vamwe na Klĩsto; nũndũ ũu nĩ ũseo mũno mbee: ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.23",
            "verseOrgIds": [
              "PHP.1.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "PHP 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "ĩndĩ kwĩkala mwĩĩnĩ kwĩ vata mũno kwondũ wenyu. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.24",
            "verseOrgIds": [
              "PHP.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "PHP 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ngĩkwatya ũu, nĩnĩsĩ ngekala, ĩĩ, na ngekalan’ya nenyu inyw’onthe, kwondũ wa kũendeea kwenyu na ũtanu wenyu nthĩnĩ wa mũĩkĩĩo; ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.25",
            "verseOrgIds": [
              "PHP.1.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "PHP 1:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "nĩ kana kwĩtaĩa kwenyu kwingĩve nthĩnĩ wa Klĩsto Yesũ kwondũ wakwa kwĩthĩwa nenyu ĩngĩ.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.26",
            "verseOrgIds": [
              "PHP.1.26"
            ]
          }
        }
