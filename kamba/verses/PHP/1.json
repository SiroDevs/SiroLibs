              "items": [
                {
                  "text": "2 Ako 1.11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ nĩnĩsĩ kana ũndũ ũũ ũkangalyũkĩla kwĩthĩwa nĩ ũtangĩĩo wakwa, ũndũ wa kũvoya kwenyu na kũtethw’a nĩ Veva wa Yesũ Klĩsto, ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.19",
            "verseOrgIds": [
              "PHP.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PHP 1:20"
          },
          "items": [
