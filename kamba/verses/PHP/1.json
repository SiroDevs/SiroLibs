            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nata ĩndĩ? Ate o nzĩanĩ syonthe, ethĩwa nĩ nthĩnĩ wa wangangan’yo kana nĩ nthĩnĩ wa w’o, Klĩsto nũtavanaw’a; na kwondũ wa ũu nĩngũtana, ĩĩ, na ngatana. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.18",
            "verseOrgIds": [
              "PHP.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
