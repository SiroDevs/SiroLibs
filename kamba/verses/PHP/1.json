              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ kwakwa nyie kwĩkala thayũ no Klĩsto, na kũkw’a nĩ ũunĩko. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.21",
