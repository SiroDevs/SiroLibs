              },
              "items": [
                {
                  "text": "Yoa 15.8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " mũkyusũwa nĩ mosyao ma ũlũngalu, ala me kwondũ wa Yesũ Klĩsto, nĩ kana Ngai ataĩwe na akathwe.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.11",
            "verseOrgIds": [
              "PHP.1.11"
            ]
          }
        }
      ]
    },
    {
