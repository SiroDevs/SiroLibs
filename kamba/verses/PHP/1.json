          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.4.16"
              },
              "items": [
                {
                  "text": "1 Vet 4.16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwĩanana na kũsyaĩĩsya mũno na kwĩkwatya kwakwa, kana ũndũnĩ o na wĩva ndikasonokw’a, ĩndĩ na ũkũmbaũ w’onthe, ta mavinda onthe, no ta ũu yu Klĩsto akanenevw’a mwĩĩnĩ wakwa, ethĩwa nĩ kwĩkala na thayũ, kana nĩ kũkw’a.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.20",
            "verseOrgIds": [
              "PHP.1.20"
            ]
          }
        }
