              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "na mũikatĩsw’e nĩ amaitha ũndũnĩ o na wĩva; naw’o kwoo nĩ wonan’yo vyũ wa kwaa, ĩndĩ kwenyu nĩ wa ũtangĩĩo, naw’o wumĩte kwa Ngai; ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.28",
            "verseOrgIds": [
              "PHP.1.28"
            ]
          }
        },
        {
          "name": "verse",
