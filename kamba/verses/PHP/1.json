              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "ũũ nĩw’o nĩvoyaa, kana wendo wenyu wingĩve mũno mbee nthĩnĩ wa ũmanyi na ũĩ w’onthe; ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.9",
            "verseOrgIds": [
              "PHP.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PHP 1:10"
          },
          "items": [
