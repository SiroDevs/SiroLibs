                "loc": "1PE.5.7"
              },
              "items": [
                {
                  "text": "1 Vet 5.7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.145.18"
              },
              "items": [
                {
                  "text": "Sav 145.18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.14.27"
              },
              "items": [
                {
                  "text": "Yoa 14.27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũikemakĩe kwa ũndũ o na wĩva; ĩndĩ kĩla ũndũnĩ mavata menyu nĩmatavanw’e kwa Ngai na kũvoya na kwĩsũva vamwe na kũtũnga mũvea. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.6",
            "verseOrgIds": [
              "PHP.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PHP 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.3.15"
              },
              "items": [
                {
                  "text": "Ako 3.15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mũuo wa Ngai, ũla ũvĩtũkĩte ũmanyi w’onthe, ũkasũvĩaa ngoo syenyu na mosũanĩo menyu nthĩnĩ wa Klĩsto Yesũ.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.7",
            "verseOrgIds": [
              "PHP.4.7"
            ]
          }
        }
      ]
    },
    {
