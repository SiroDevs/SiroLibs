              "items": [
                {
                  "text": "2 Ako 13.11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tanaai nthĩnĩ wa Mwĩaĩi mavinda onthe: na ĩngĩ nĩngwasya Tanaai. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.4",
            "verseOrgIds": [
              "PHP.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PHP 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.10.37"
              },
              "items": [
                {
                  "text": "Aevl 10.37",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JAS.5.8"
              },
              "items": [
                {
                  "text": "Yak 5.8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JAS.5.9"
              },
              "items": [
                {
                  "text": "9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wũmĩĩsyo wenyu ũmanyĩke nĩ andũ onthe, Mwĩaĩi e vakuvĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.5",
            "verseOrgIds": [
              "PHP.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PHP 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.6.25+MAT.6.26+MAT.6.27+MAT.6.28+MAT.6.29+MAT.6.30+MAT.6.31+MAT.6.32+MAT.6.33+MAT.6.34"
              },
              "items": [
                {
                  "text": "Mt 6.25–34",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.4.2"
              },
              "items": [
                {
                  "text": "Ako 4.2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
