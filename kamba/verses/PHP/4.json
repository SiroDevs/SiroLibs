              },
              "items": [
                {
                  "text": "1 Ako 9.11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ti kwĩthĩwa nĩngũwenda ũla mũthĩnzĩo; ĩndĩ nĩngwenda ũsyao ũla wingĩvaa ũtalonĩ wenyu. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.17",
            "verseOrgIds": [
              "PHP.4.17"
            ]
          }
        },
        {
