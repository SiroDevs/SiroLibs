              "attrs": {
                "loc": "ROM.6.23"
              },
              "items": [
                {
                  "text": "Alo 6.23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwondũ wa ũu, nũndũ wa mũndũ ũmwe naĩ yalikile kũũ nthĩ, na kĩkw’ũ kwondũ wa naĩ; na kwa ũu kĩkw’ũ kyavikĩa andũ onthe, nĩkwĩthĩwa onthe nĩmeekie naĩ:— ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.12",
            "verseOrgIds": [
              "ROM.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ROM 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "nũndũ ĩla mĩao ĩtanoka naĩ yaĩ kũũ nthĩ; ĩndĩ naĩ ndĩtalawa mĩao ĩte vo. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.13",
            "verseOrgIds": [
              "ROM.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ROM 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.15.21"
              },
              "items": [
