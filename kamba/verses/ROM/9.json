                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa ũu amwĩw’ĩaa tei ũla ũkwenda kũmwĩw’ĩa, na ũla ũkwenda kũmya aiũmya.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.18",
