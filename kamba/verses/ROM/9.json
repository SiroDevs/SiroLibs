                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ĩndĩ Isilaeli, maatĩĩa mwĩao wa ũlũngalu, matyaavikĩa mwĩao ũsu. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.31",
            "verseOrgIds": [
