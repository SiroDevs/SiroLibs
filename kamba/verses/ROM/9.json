              },
              "items": [
                {
                  "text": "Kuma 9.16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ maandĩko memwĩa Valao, Kwondũ wa ũu nĩnakũũngamisye, nĩ kana nonan’ye vinya wakwa nthĩnĩ waku, na nĩ kana syĩtwa yakwa yĩtavanw’e nthĩ yonthe. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.17",
            "verseOrgIds": [
              "ROM.9.17"
            ]
          }
        },
        {
