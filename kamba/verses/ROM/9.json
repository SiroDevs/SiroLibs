                {
                  "text": "8.29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "nĩ kana amanyĩthan’ye wĩngĩ wa ndaĩa yake ĩũlũ wa mĩio ya tei, ĩla waseũvisye mbee yĩthĩwe ya ũtaĩo, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.23",
            "verseOrgIds": [
              "ROM.9.23"
            ]
          }
        },
        {
