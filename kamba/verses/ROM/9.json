              "items": [
                {
                  "text": "Isa 8.14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩ ũndũ wa kĩ? Nũndũ matyaamantha kwa kũĩkĩĩa, ĩndĩ kwa kwĩka. Nĩmalulutĩkilw’e nĩ yĩla ĩvia yĩlulutĩkasya; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.32",
            "verseOrgIds": [
              "ROM.9.32"
            ]
          }
        },
