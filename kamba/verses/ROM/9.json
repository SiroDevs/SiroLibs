        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.5",
            "verseOrgIds": [
              "ROM.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
