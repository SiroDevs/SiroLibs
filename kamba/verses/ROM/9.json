          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "nayo nĩ ithyi, ala watwĩtie, ti kuma kwa Ayuti oka, ĩndĩ kuma kwa Andũ‐ma‐mbaĩ‐ingĩ nao?",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.24",
            "verseOrgIds": [
              "ROM.9.24"
            ]
          }
        }
