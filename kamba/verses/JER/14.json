            "style": "v",
            "sid": "JER 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Matĩĩa ũya, ndikew’a kĩĩo kyoo; na mathemba nthembo ya kũvĩvw’a na nthembo ya mũtu, ndikasyĩtĩkĩla; ĩndĩ ngamamina na ũvyũ, na yũa, na mũimũ.",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.12",
            "verseOrgIds": [
              "JER.14.12"
            ]
          }
        }
      ]
    },
