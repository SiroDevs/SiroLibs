            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩvo naisye, Ai! Mwĩaĩi Yeova! Sisya, athani mamatavasya, Mũtikona ũvyũ, o na mũtikethĩwa na yũa; ĩndĩ ngamũnengae mũuo wa w’o vandũ vaa. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.13",
            "verseOrgIds": [
              "JER.14.13"
            ]
          }
        },
