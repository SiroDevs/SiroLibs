            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.2",
            "verseOrgIds": [
              "JER.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na anene moo me ndaĩa matũma ala anini moo maende manzĩnĩ: mavika ithimanĩ, na mailea kwona manzĩ; nĩmasyokaa na ikuu syo syĩ nthei; nĩmasonokaa na kũthokoana, na kũvw’ĩka mĩtwe yoo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.3",
            "verseOrgIds": [
              "JER.14.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.15.30"
              },
              "items": [
                {
                  "text": "2 Sam 15.30",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.3",
            "verseOrgIds": [
              "JER.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aĩmi nĩmasonokaa na kũvw’ĩka mĩtwe yoo, nĩkwĩthĩwa nthĩ nĩ mbatũkangu, nũndũ kũtyeethĩawa mbua nthĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.4",
            "verseOrgIds": [
              "JER.14.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.3.3"
              },
              "items": [
                {
                  "text": "Yel 3.3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.4",
            "verseOrgIds": [
              "JER.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩĩ, o na ndaatai nĩsyaĩaa weũnĩ, na kũtia ĩswii yayo, nĩkwĩthĩwa vati nyeki. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.5",
            "verseOrgIds": [
              "JER.14.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.29.9"
              },
              "items": [
                {
                  "text": "Sav 29.9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.5",
            "verseOrgIds": [
              "JER.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mang’oi ma kĩthekanĩ maũngamaa kũndũ kũtũlu kũthei makĩvevaveva ta mbĩwa; metho mamo makĩseekea, nũndũ vati kya ũya. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.6",
            "verseOrgIds": [
              "JER.14.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
