              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndeto ya Yeova ĩla yamũkĩe Yelemia ũndũ wa mũnyao.",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.1",
            "verseOrgIds": [
              "JER.14.1"
            ]
          }
        }
      ]
    },
    {
