            "number": "7",
            "style": "v",
            "sid": "JER 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "O na ethĩwa mothũku maitũ nĩmeũtũkũsĩĩa, tethya wĩa kwondũ wa syĩtwa yaku, ame Yeova; nũndũ kũsyoka na ĩtina kwitũ nĩ kwingĩ; nĩtwakũvĩtanĩsye. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.7",
            "verseOrgIds": [
              "JER.14.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.25.11"
              },
              "items": [
                {
                  "text": "Sav 25.11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.7",
            "verseOrgIds": [
              "JER.14.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "We wĩkwatyo wa Isilaeli, Mũtangĩĩi wake ĩvinda ya thĩna, wĩĩthĩwa ta mũeni nthĩ nĩkĩ, na ta mũndũ wa kyalo ũla wathũkaa one vandũ va ũkoma ũtukũ? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.8",
            "verseOrgIds": [
              "JER.14.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.71.5"
              },
              "items": [
                {
                  "text": "Sav 71.5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.17.13"
              },
              "items": [
                {
                  "text": "Yel 17.13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.50.7"
              },
              "items": [
                {
                  "text": "50.7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.8",
            "verseOrgIds": [
              "JER.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wĩĩthĩwa ta mũndũ mũtelemu nĩkĩ, ta ngũmbaũ ĩla ĩtatonya kũtangĩĩa? Ĩndĩ, ame Yeova, wĩ katĩ waitũ, na ithyĩ nĩtũkwĩtanĩw’a na syĩtwa yaku; ndũkatũtie. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.9",
            "verseOrgIds": [
              "JER.14.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
