            "sid": "JER 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yeova ambĩa, Ndũkamavoyee andũ aa mone ũseo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.11",
            "verseOrgIds": [
              "JER.14.11"
            ]
          }
        },
