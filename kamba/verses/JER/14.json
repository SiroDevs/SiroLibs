              "type": "tag",
              "attrs": {
                "loc": "LAM.1.4"
              },
              "items": [
                {
                  "text": "Iĩo 1.4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LAM.2.8"
              },
              "items": [
                {
                  "text": "2.8",
                  "type": "text"
                }
              ]
