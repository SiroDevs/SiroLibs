        },
        {
          "text": "Ndeto ĩla mwathani Yelemia watavisye Mbaluku mwana wa Nelia yĩla waandĩkie ndeto ii ĩvukunĩ kuma kanyw’anĩ wa Yelemia mwaka wa kana wa kũsumbĩka kwa Yeoiakimu mwana wa Yosia, mũsumbĩ wa Yuta, ĩkĩmwĩa, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.45.1",
            "verseOrgIds": [
              "JER.45.1"
            ]
          }
        },
