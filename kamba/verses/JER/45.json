          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ũũ nĩw’o Yeova, Ngai wa Isilaeli, ũnũũkũtavya, we Mbaluku: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.45.2",
            "verseOrgIds": [
              "JER.45.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 45:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "We nĩwaisye, Woo nĩ wakwa yu! Nũndũ Yeova nĩwongeleele kwalw’a kĩmako; nĩ na mĩnoo ũndũ wa kũluma kwakwa, na ndikwona ũthũmũo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.45.3",
            "verseOrgIds": [
              "JER.45.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
