            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.17",
            "verseOrgIds": [
              "JER.35.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 35:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yelemia atavya nyũmba ya Alekavi, Ũũ nĩw’o Yeova wa nguthu, Ngai wa Isilaeli, ũnũkwasya: Nĩkwĩthĩwa nĩmweewie mwĩao wa Yonatavu ĩthe wenyu, na kũkwata mawĩaĩo make onthe, na kwĩka kwĩanana na w’onthe ũla wamwĩaĩe; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.18",
            "verseOrgIds": [
              "JER.35.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
