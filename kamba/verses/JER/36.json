          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩyose ĩvuku ĩkũnze, noiandĩka nthĩnĩ wayo ndeto syonthe ila nakũtavisye ngĩneenea Isilaeli, na Yuta, na mbaĩ syonthe, kuma mũthenya naneenie naku, kuma mĩthenya ya Yosia, o kũvika ũmũnthĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.2",
            "verseOrgIds": [
              "JER.36.2"
            ]
          }
        },
        {
