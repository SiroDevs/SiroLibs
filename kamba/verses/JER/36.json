            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.26",
            "verseOrgIds": [
              "JER.36.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 36:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩvo ĩndĩ ndeto ya Yeova yamũkĩe Yelemia, ĩtina wa mũsumbĩ kũvĩvya ĩvuku ĩkũnze, na ndeto ila Mbaluku waandĩkie syaumĩte kanyw’anĩ wa Yelemia, ĩkĩmwĩa, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.27",
            "verseOrgIds": [
              "JER.36.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JER 36:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Osa ingĩ ĩvuku yĩngĩ ĩkũnze, noiandĩka nthĩnĩ wayo ndeto syonthe sya mbee ila syaĩ ĩvukunĩ ĩkũnze ya mbee, yĩla Yeoiakimu mũsumbĩ wa Yuta wavĩvisye. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.28",
            "verseOrgIds": [
              "JER.36.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JER 36:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ũndũ wa Yeoiakimu mũsumbĩ wa Yuta ũkasya, Ũũ nĩw’o Yeova ũnũkwasya: Nĩwavĩvisye ĩvuku yĩu, ũkyasya, Nũndũ wa kĩ waandĩkie nthĩnĩ wayo, ũkyasya, Mũsumbĩ wa Mbaviloni ndatĩa kũka na kwananga nthĩ ĩno, na kũmina kw’o andũ na nyamũ? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.29",
            "verseOrgIds": [
              "JER.36.29"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.26.9"
              },
              "items": [
                {
                  "text": "Yel 26.9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.29",
            "verseOrgIds": [
              "JER.36.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JER 36:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwondũ wa ũu Yeova easya ũndũ wa Yeoiakimu mũsumbĩ wa Yuta: Ndakethĩwa na mũndũ wa kwĩkalĩla kĩvĩla kya ũsumbĩ kya Ndaviti; na kimba kyake kĩkekw’a nza mũthenya kwĩ kũvyũ, na ũtukũ kwĩ ĩmwe yĩkamĩtw’e nĩ mbevo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.30",
            "verseOrgIds": [
              "JER.36.30"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
