        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 30:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ, sisya, mĩthenya nĩyũkĩte, easya Yeova, ĩla ngamatũnga andũ makwa Isilaeli na Yuta maume kũtavwanĩ kwoo, easya ũu Yeova; na ngatuma masyoka nthĩ ĩla nanengie aaĩthe moo, na makamĩmesya. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.3",
            "verseOrgIds": [
              "JER.30.3"
            ]
          }
        },
