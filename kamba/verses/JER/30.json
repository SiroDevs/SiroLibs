          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "O na syana syoo ikethĩwa itilyĩ o ũndũ syailyĩ, na ũmbano woo ũkalũma mbee wakwa; na ngakũna onthe ala mamathĩnasya. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.20",
            "verseOrgIds": [
              "JER.30.20"
            ]
          }
        },
        {
