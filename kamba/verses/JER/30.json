          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ii nĩsyo ndeto ila Yeova waneenie ũndũ wa Isilaeli na ũndũ wa Yuta. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.4",
            "verseOrgIds": [
              "JER.30.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 30:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ ũũ nĩw’o Yeova ũnũkwasya: Nĩtwĩw’ĩte wasya wa kũtetemya, wa kwĩw’ĩthya w’ĩa, na ti wa mũuo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.5",
            "verseOrgIds": [
              "JER.30.5"
            ]
          }
        }
      ]
    },
