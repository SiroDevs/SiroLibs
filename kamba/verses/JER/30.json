              "type": "text"
            }
          ]
        },
        {
          "text": "Ndeto ĩla yamũkĩe Yelemia kuma kwa Yeova, ĩkyasya, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.1",
            "verseOrgIds": [
              "JER.30.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 30:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ũũ nĩw’o Yeova, Ngai wa Isilaeli, ũnũkwasya, akyasya, Andĩka ĩvukunĩ ndeto syonthe ila nakũtavisye. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.2",
            "verseOrgIds": [
              "JER.30.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
