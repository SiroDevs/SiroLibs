          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "ĩndĩ makathũkũma Yeova Ngai woo, na Ndaviti mũsumbĩ woo, ũla ngamokĩlĩlya. ",
          "type": "text",
          "attrs": {
