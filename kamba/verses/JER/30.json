              "items": [
                {
                  "text": "Ava 2.2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.2",
            "verseOrgIds": [
              "JER.30.2"
            ]
          }
