          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ ethĩwa mwĩasya, Tũtikekala nthĩ ĩno; mũtikew’e wasya wa Yeova Ngai wenyu, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.13",
            "verseOrgIds": [
              "JER.42.13"
            ]
          }
        },
        {
