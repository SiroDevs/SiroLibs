          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "kana Yeova Ngai waku atwon’ye nzĩa ĩla twaĩle kũthi nayo, na ũndũ ũla twaĩle kwĩka. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.3",
            "verseOrgIds": [
              "JER.42.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
