                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.14",
            "verseOrgIds": [
              "JER.42.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 42:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "yu kwondũ wa ũu ĩw’ai ndeto ya Yeova, inyw’ĩ ũtialo wa Yuta: Ũũ nĩw’o Yeova wa nguthu, Ngai wa Isilaeli, ũnũkwasya, Ethĩwa nĩ w’o mwĩelekelya mothyũ menyu kũlika Misili, na kũthi kwĩkala ũeni kw’o; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.15",
            "verseOrgIds": [
              "JER.42.15"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
