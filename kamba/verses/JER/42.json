              "items": [
                {
                  "text": "Alo 8.31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.11",
            "verseOrgIds": [
              "JER.42.11"
            ]
