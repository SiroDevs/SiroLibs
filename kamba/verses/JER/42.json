              },
              "items": [
                {
                  "text": "Yel 43.2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.1",
            "verseOrgIds": [
              "JER.42.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 42:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "na mamwĩa mwathani Yelemia, Nĩtũũkwĩsũva, wĩsũvano witũ wĩtĩkĩlwe mbee waku, naku tũvoyee kwa Yeova Ngai waku, o kwondũ wa ũtialo ũũ w’onthe (nũndũ nĩtũtialĩtw’e twĩ avũthũ twaĩ aingĩ, o tondũ metho maku matwene), ",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.2",
            "verseOrgIds": [
              "JER.42.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
