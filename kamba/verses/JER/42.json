            "number": "11",
            "style": "v",
            "sid": "JER 42:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũtikakĩe mũsumbĩ wa Mbaviloni, ũla mũmũkĩaa; mũikamũkĩe, easya ũu Yeova; nũndũ nĩ vamwe nenyu nĩmũtangĩĩe, na kũmũvonokya kuma kw’okonĩ kwake. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.11",
            "verseOrgIds": [
              "JER.42.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
