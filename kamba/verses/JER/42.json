          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "mũkyasya, Aiee: ĩndĩ tũkaenda nthĩ ya Misili, vala tũtakona kaũ, kana kwĩw’a wasya wa soo, kana kwaĩwa nĩ lĩu; na tũkekala kw’o: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.14",
            "verseOrgIds": [
              "JER.42.14"
            ]
          }
        },
