            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩvo ĩndĩ makavuteni onthe ma asikalĩ, na Yoanani mwana wa Kalea, na Yesania mwana wa Osaia, na andũ onthe kuma ũla mũnini kũvika ũla mũnene mbee, mathengeeie, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.1",
            "verseOrgIds": [
              "JER.42.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
