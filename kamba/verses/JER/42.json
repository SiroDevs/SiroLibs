          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 42:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ngamwon’ya tei, nĩ kana amwĩw’ĩe inyw’ĩ tei, na kũmũtũnga nthĩ yenyu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.12",
            "verseOrgIds": [
              "JER.42.12"
            ]
          }
        },
        {
