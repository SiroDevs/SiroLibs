                {
                  "text": "Nee 1.11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.12",
            "verseOrgIds": [
              "JER.42.12"
            ]
          }
        },
        {
