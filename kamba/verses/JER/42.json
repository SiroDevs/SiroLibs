              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.5",
            "verseOrgIds": [
              "JER.42.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 42:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ethĩwa nĩ nzeo, kana ethĩwa nĩ nthũku, tũkeew’a wasya wa Yeova Ngai waitũ, ũla tũũkũtũma kwake; nĩ kana kwĩthĩwe ũseo kwitũ, o yĩla twĩĩw’aa wasya wa Yeova Ngai waitũ. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.6",
            "verseOrgIds": [
              "JER.42.6"
            ]
          }
        },
        {
