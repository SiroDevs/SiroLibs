            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.12",
            "verseOrgIds": [
              "JER.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ umbũla ũthũku waku, kana nĩwamũvĩtanĩsye Yeova Ngai waku, na nĩwanyaĩĩkisye mĩendele yaku ũithi kwa aeni ĩtina wa kĩla mũtĩ mwĩũ na mũtyaaĩthukĩĩsya wasya wakwa, easya ũu Yeova. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.13",
            "verseOrgIds": [
              "JER.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Syokai, inyw’ĩ syana ila mwasyokie na ĩtina, easya ũu Yeova; nũndũ nĩ mũũme wenyu: na ngamwosa inyw’ĩ, ũmwe wa ndũa, na elĩ ma mũvĩa, na ngamũete Saioni ",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.14",
            "verseOrgIds": [
              "JER.3.14"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
