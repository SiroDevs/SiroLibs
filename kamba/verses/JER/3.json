              },
              "items": [
                {
                  "text": "Esek 16.51",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.16.52"
              },
              "items": [
                {
                  "text": "52",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.11",
            "verseOrgIds": [
              "JER.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enda, ũtavan’ye ndeto ii kwelekela ngalĩ ya ĩũlũ, ũiasya, Syoka, we Isilaeli ũla wasyokie na ĩtina, easya ũu Yeova; ndikakũsisya nĩ mũthatu; nũndũ nĩ wa tei, easya Yeova, ndikekala na ũthatu tene na tene. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.12",
            "verseOrgIds": [
              "JER.3.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
