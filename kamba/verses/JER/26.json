          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mũsumbĩ Yeoiakimu atũma andũ Misili, nao nĩ aa, Elinathani mwana wa Akivoli, na andũ amwe vamwe nake, na mathi Misili; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.22",
            "verseOrgIds": [
