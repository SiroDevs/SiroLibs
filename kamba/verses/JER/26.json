          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩvo ĩndĩ atumĩa amwe ma nthĩ mookĩlile na maneena na ĩkomano yonthe ya andũ, makyasya, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.17",
            "verseOrgIds": [
              "JER.26.17"
            ]
          }
        },
