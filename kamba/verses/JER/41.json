            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.10",
            "verseOrgIds": [
              "JER.41.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 41:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ yĩla Yoanani mwana wa Kalea, na makavuteni onthe ma asikalĩ ala maĩ nake, meewie ũthũku ũsu w’onthe ũla Isumaeli mwana wa Nethania wekie, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.11",
            "verseOrgIds": [
              "JER.41.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 41:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "nĩvo ĩndĩ moosie andũ onthe, na mathi kũkita na Isumaeli mwana wa Nethania, na mamwĩthĩa ũtee wa manzĩ maingĩ ala me Ngiveoni. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.12",
            "verseOrgIds": [
              "JER.41.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.2.13"
              },
              "items": [
                {
                  "text": "2 Sam 2.13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.12",
            "verseOrgIds": [
              "JER.41.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 41:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kweethĩwa atĩ yĩla andũ onthe ala maĩ na Isumaeli moonie Yoanani mwana wa Kalea, na makavuteni onthe ma asikalĩ ala maĩ nake, matana. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.13",
            "verseOrgIds": [
              "JER.41.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 41:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kwondũ wa ũu andũ onthe ala Isumaeli wamatwaie me atave kuma Misiva meethyũũa na masyoka, na mathi vala ve Yoanani mwana wa Kalea. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.14",
            "verseOrgIds": [
              "JER.41.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 41:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ Isumaeli mwana wa Nethania avonoka kuma mokonĩ ma Yoanani vamwe na andũ nyanya, na athi ananĩ ma Amimoni. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.15",
            "verseOrgIds": [
              "JER.41.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 41:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩvo ĩndĩ Yoanani mwana wa Kalea, na makavuteni onthe ma asikalĩ ala maĩ nake, moosie ũtialo w’onthe wa andũ ala wamaumĩtye kwa Isumaeli mwana wa Nethania, kuma Misiva, ĩtina wa kũaa Ngetalia mwana wa Aikamu, nao nĩ aa, andũ ma kaũ, na aka, na syana, na avakũe, ala wamaetete kuma Ngiveoni. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.16",
            "verseOrgIds": [
              "JER.41.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 41:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao maenda, na matũa Ngeluthi Kimiamu, ĩla yĩ vakuvĩ na Mbethileemu, maende kũlika Misili, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.17",
            "verseOrgIds": [
              "JER.41.17"
            ]
          }
        },
        {
