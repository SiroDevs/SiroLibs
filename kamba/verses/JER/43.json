                "loc": "JER.15.2"
              },
              "items": [
                {
                  "text": "Yel 15.2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.46.13"
              },
              "items": [
                {
                  "text": "46.13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.43.11",
            "verseOrgIds": [
              "JER.43.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 43:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ngakwatya mwaki nyũmba sya ngai sya Misili; nake akaivĩvya, na akaitava mũtavo: na akeevw’ĩka nthĩ ya Misili, o tondũ mũĩthi wĩvw’ĩkaa ngũa yake; na akauma kw’o na mũuo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.43.12",
            "verseOrgIds": [
              "JER.43.12"
            ]
          }
        },
        {
