            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.43.10",
            "verseOrgIds": [
              "JER.43.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 43:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na akooka na kũkũna nthĩ ya Misili; ala ma kĩkw’ũ, kĩkw’ũnĩ; na ala ma kũtavwa mũtavonĩ, na ala ma ũvyũ, ũvyũnĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.43.11",
            "verseOrgIds": [
              "JER.43.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
