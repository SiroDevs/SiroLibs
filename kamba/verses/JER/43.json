          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "O na akaitũlanga ituĩ sya Mbethisemesi, ĩla yĩ nthĩ ya Misili; na nyũmba sya ngai sya Misili akavĩvya na mwaki. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.43.13",
