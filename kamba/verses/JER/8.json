            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩvinda yĩu, easya Yeova, makavukũa na kumya mbũanĩ syamo, mavĩndĩ ma asumbĩ ma Yuta, na mavĩndĩ ma anene make me mbee ũsumbĩnĩ, na mavĩndĩ ma athembi, na mavĩndĩ ma athani; na mavĩndĩ ma andũ matwĩe Yelusaleme; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.1",
            "verseOrgIds": [
              "JER.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "na makamanĩkĩa syũa, na mwei, na mbee wa nguthu yonthe ya ĩtunĩ, ila mendete, na kwithũkũma, na kwiatĩĩa, na kwimantha, na kwĩthaitha: matikakolanw’a, kana kwĩnzĩwa nthĩ, makethĩwa ta vũũ ĩũlũ wa nthĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.2",
            "verseOrgIds": [
              "JER.8.2"
            ]
          }
        },
