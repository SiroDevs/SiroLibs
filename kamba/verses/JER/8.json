          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngetha nĩ mbĩtu, ĩvinda ya syũa nĩ ĩthelu, na ithyĩ tũtyaatangĩĩwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.20",
            "verseOrgIds": [
              "JER.8.20"
            ]
          }
        },
        {
