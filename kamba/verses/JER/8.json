            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.4",
            "verseOrgIds": [
              "JER.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ wa kĩ ĩndĩ andũ aa ma Yelusaleme nĩmasyokete na ĩtina, na kũsyoka na ĩtina kwoo nĩ kwa tene na tene? Nĩmalũmasya ũkengani, nĩmaleaa kũsyoka. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.5",
            "verseOrgIds": [
              "JER.8.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
