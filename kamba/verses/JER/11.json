              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.7",
            "verseOrgIds": [
              "JER.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ matyaaĩw’a, o na kũtea matũ moo, ĩndĩ nĩmaatĩĩe kĩla ũmwe ngũlũ sya ngoo yake nthũku: kwondũ wa ũu namaetee ndeto syonthe sya ũtianĩo ũũ, ila nameaĩe meke, ĩndĩ matyaasyĩka. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.8",
            "verseOrgIds": [
              "JER.11.8"
            ]
          }
        },
