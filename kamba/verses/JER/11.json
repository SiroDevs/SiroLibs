            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwondũ wa ũu Yeova easya atĩĩ, Sisya, ngaietee ũthũku, ũla itakatonya kũvonoka; na ikengaĩla, ĩndĩ ndikasyĩthukĩĩsya. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.11",
            "verseOrgIds": [
              "JER.11.11"
            ]
          }
        },
        {
