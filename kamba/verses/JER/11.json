          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ũmatavye, Ũũ nĩw’o Yeova, Ngai wa Isilaeli, ũnũkwasya: Naumanĩwe mũndũ ũla ũtethukĩĩasya ndeto sya ũtianĩo ũũ, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.3",
            "verseOrgIds": [
              "JER.11.3"
            ]
          }
        },
