              "type": "text"
            }
          ]
        },
        {
          "text": "Ndeto ĩla yamũkĩe Yelemia kuma kwa Yeova, ĩkyasya, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.1",
            "verseOrgIds": [
              "JER.11.1"
            ]
          }
        },
        {
