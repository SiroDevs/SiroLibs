            "number": "2",
            "style": "v",
            "sid": "JER 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩthukĩĩsyei ndeto sya ũtianĩo ũũ, ũneene na andũ ma Yuta, na ala matwĩe Yelusaleme; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.2",
            "verseOrgIds": [
              "JER.11.2"
            ]
          }
        },
        {
