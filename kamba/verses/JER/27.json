          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "nũndũ nĩmeũmwathanĩa ũvũngũ, mamumye kũasa na nthĩ yenyu, na nĩ kana nĩmũlũngye, mũkae. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.10",
            "verseOrgIds": [
              "JER.27.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 27:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ mbaĩ ĩla ĩkekĩa ngingo yayo ĩsokinĩ ya mũsumbĩ wa Mbaviloni, na kũmũthũkũma, mbaĩ ĩsu ngamĩeka ĩkalae nthĩ yoo ene, na makamĩnza, na kwĩkala kw’o, easya ũu Yeova.",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.11",
            "verseOrgIds": [
              "JER.27.11"
            ]
          }
