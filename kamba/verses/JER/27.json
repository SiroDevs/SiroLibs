        },
        {
          "text": "ĩĩ, ũũ nĩw’o Yeova wa nguthu, Ngai wa Isilaeli, ũnũkwasya, ũndũ wa mĩio ĩla ĩtialĩtw’e nyũmbanĩ ya Yeova, na nyũmbanĩ ya mũsumbĩ wa Yuta, na ku Yelusaleme: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.21",
            "verseOrgIds": [
              "JER.27.21"
            ]
          }
        },
