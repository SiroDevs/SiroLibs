            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wambĩlilyo wa kũsumbĩka kwa Yeoiakimu mwana wa Yosia, mũsumbĩ wa Yuta, ndeto ĩno yamũkĩa Yelemia kuma kwa Yeova, ĩkyasya, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.1",
            "verseOrgIds": [
              "JER.27.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 27:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ũũ nĩw’o Yeova ũnũũmbĩa: Ĩseũvĩsye tũmĩkwa na masoki, na kwĩkĩa ngingonĩ yaku; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.2",
            "verseOrgIds": [
              "JER.27.2"
            ]
          }
        },
        {
