          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ ethĩwa nĩ athani, na ethĩwa ndeto ya Yeova yĩ nao, mamwĩsũve Yeova wa nguthu yu, kana mĩio ĩla ĩtialĩtw’e nyũmbanĩ ya Yeova, na nyũmbanĩ ya mũsumbĩ wa Yuta, na ku Yelusaleme, ndĩkatwawe Mbaviloni. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.18",
            "verseOrgIds": [
              "JER.27.18"
            ]
          }
        },
        {
