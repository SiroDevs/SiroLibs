          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na yu nĩnĩnenganĩte nthĩ isu syonthe kw’okonĩ kwa Nevukatilesa mũsumbĩ wa Mbaviloni mũthũkũmi wakwa; o na nyamũ sya kĩtheka nĩnĩmũnengete imũthũkũme. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.6",
            "verseOrgIds": [
              "JER.27.6"
            ]
          }
        },
