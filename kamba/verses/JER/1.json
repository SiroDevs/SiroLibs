          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao makokita naku; ĩndĩ maikakũtonya: nũndũ nyie nĩ vamwe naku kũũvonokya, easya ũu Yeova. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.19",
