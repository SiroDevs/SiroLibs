            "sid": "JER 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "O na nĩyokie mĩthenya ya Yeoiakimu mwana wa Yosia, mũsumbĩ wa Yuta, kũvika mũminũkĩlyo wa mwaka wa ĩkũmi na ũmwe wa kũsumbĩka kwa Nzetekia, mwana wa Yosia, mũsumbĩ wa Yuta, kũvika kũtavwa kwa Yelusaleme mwei wa katano. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.3",
            "verseOrgIds": [
              "JER.1.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "2 Asu 23.34—24.6; 24.17—25.11.",
              "type": "text"
            }
          ]
        }
      ]
    },
