          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ Yeova ambĩa, Ndũkasye, Nyie nĩ kana; nũndũ ũkathi kwa o ũla nĩkũtũma, na o ũndũ nĩkwĩaĩa ũkaneena. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.7",
            "verseOrgIds": [
              "JER.1.7"
            ]
          }
        },
        {
          "name": "verse",
