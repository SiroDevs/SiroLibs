          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndũkakĩe nũndũ woo; nũndũ nĩ vamwe naku kũũvonokya, easya ũu Yeova. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.8",
