              },
              "items": [
                {
                  "text": "Amo 7.8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.11",
            "verseOrgIds": [
              "JER.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ Yeova ambĩa, Nĩwoona nesa: nũndũ nĩsyaĩĩsyaa ndeto yakwa nĩmĩanĩsye.",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.12",
