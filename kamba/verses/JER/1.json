              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ũla wokĩwe nĩ ndeto ya Yeova mĩthenyanĩ ya Yosia mwana wa Amoni, mũsumbĩ wa Yuta, mwaka wa ĩkũmi na ĩtatũ wa kũsumbĩka kwake. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.2",
            "verseOrgIds": [
              "JER.1.2"
            ]
          }
        },
        {
