          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "O ta ũu Ayuti onthe ala maĩ Moavi, na katĩ wa ana ma Amimoni, na Etomu, na nthĩ syonthe, meewie atĩ mũsumbĩ wa Mbaviloni nũtiĩte ũtialo wa Yuta, na kũmaiĩa Ngetalia mwana wa Aikamu, mwana wa Savani; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.11",
            "verseOrgIds": [
              "JER.40.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 40:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "nĩvo ĩndĩ Ayuti onthe masyokie kuma kũndũ kw’onthe kũla malũngĩlĩĩlw’e, na mamũkĩa Ngetalia, nthĩ ya Yuta, kũvika Misiva, na moomban’ya mbinyu na mosyao maingĩ ma ĩvinda ya syũa. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.12",
            "verseOrgIds": [
              "JER.40.12"
            ]
          }
        },
