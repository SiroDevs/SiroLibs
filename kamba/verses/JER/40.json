              },
              "items": [
                {
                  "text": "Yel 41.10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.14",
            "verseOrgIds": [
              "JER.40.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 40:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩvo ĩndĩ Yoanani mwana wa Kalea waneenie na Ngetalia na kĩmbithĩ ku Misiva, akĩmwĩa, Nĩngũkwĩsũva, ũnenge ũthei nĩende, na ngooaa Isumaeli mwana wa Nethania, na vai mũndũ ũkamanya: akakũaĩa kĩ, Ayuti onthe ala makũmbanĩe manyaĩĩkw’e, na ũtialo wa Yuta ũkyaa? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.15",
            "verseOrgIds": [
              "JER.40.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 40:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ Ngetalia mwana wa Aikamu amwĩa Yoanani mwana wa Kalea, Ndũkeke ũndũ ũsu; nũndũ nũũneena ũvũngũ ũndũ wa Isumaeli.",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.16",
            "verseOrgIds": [
              "JER.40.16"
            ]
          }
        }
