                {
                  "text": "2 Asu 25.2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.21.10"
              },
              "items": [
                {
                  "text": "Yel 21.10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.3",
            "verseOrgIds": [
              "JER.34.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 34:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ ĩw’a ndeto ya Yeova, we Nzetekia mũsumbĩ wa Yuta: Ũũ nĩw’o Yeova ũnũkwasya ũndũ waku, Ndũkoawa na ũvyũ; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.4",
            "verseOrgIds": [
              "JER.34.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
