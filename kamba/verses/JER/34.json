            "style": "v",
            "sid": "JER 34:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.7",
            "verseOrgIds": [
              "JER.34.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 34:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndeto ĩla yamũkĩe Yelemia kuma kwa Yeova, ĩtina wa mũsumbĩ Nzetekia kũtianĩa ũtianĩo na andũ onthe ala maĩ Yelusaleme, kũtavan’ya ũthasyo kwoo; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.8",
            "verseOrgIds": [
              "JER.34.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.21.2"
              },
              "items": [
                {
                  "text": "Kuma 21.2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.8",
            "verseOrgIds": [
              "JER.34.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 34:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "kana kĩla mũndũ nathasye mũthũkũmi wake mũndũ mũũme, na kĩla mũndũ mũthũkũmi wake mwĩĩtu, ethĩwa nĩ mũndũ mũũme Mũevelania kana mũndũ mũka Mũevelania; mũndũ ndakamũtw’ĩkĩthye ngombo, o Mũyuti mwana‐a‐ĩthe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.9",
            "verseOrgIds": [
              "JER.34.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
