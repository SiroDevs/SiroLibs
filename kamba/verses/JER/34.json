            "sid": "JER 34:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩvo ĩndĩ mwathani Yelemia wamũtavisye Nzetekia mũsumbĩ wa Yuta ndeto isu syonthe e Yelusaleme, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.6",
            "verseOrgIds": [
              "JER.34.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 34:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "yĩla ita sya mũsumbĩ wa Mbaviloni syokitaa na Yelusaleme, na ndũa syonthe sya Yuta ila syatialile, Lakisi na Aseka; nũndũ isu syĩ syoka nĩsyatialile syĩ ndũa mbiie katĩ wa ndũa sya Yuta.",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.7",
            "verseOrgIds": [
              "JER.34.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
