                {
                  "text": "Nee 5.8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.9",
            "verseOrgIds": [
              "JER.34.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 34:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na anene onthe me mbee ũsumbĩnĩ na andũ onthe meeka ũu, ala malikĩte ũtianĩonĩ, kana kĩla ũmwe nathasye mũthũkũmi wake mũndũ mũũme, na kĩla ũmwe mũthũkũmi wake mwĩĩtu, mũndũ o na wĩva ndakamatw’ĩkĩthye ngombo ĩngĩ; nĩmeewie na mamathasya: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.10",
            "verseOrgIds": [
              "JER.34.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 34:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "ĩndĩ ĩtina maalyũka, na matũnga athũkũmi na athũkũmi eĩtu, ala mamathaĩtye, na mamaete ũkombonĩ methĩwe athũkũmi na athũkũmi eĩtu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.11",
            "verseOrgIds": [
              "JER.34.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 34:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.11",
            "verseOrgIds": [
              "JER.34.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 34:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwondũ wa ũu ndeto ya Yeova yamũkia Yelemia kuma kwa Yeova, ĩkyasya, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.12",
            "verseOrgIds": [
              "JER.34.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 34:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ũũ nĩw’o Yeova, Ngai wa Isilaeli, ũnũkwasya: Nĩnatianĩe ũtianĩo na aaĩthe menyu mũthenya ũla namaumisye nthĩ ya Misili, kuma nyũmbanĩ ya ũkombo, ngyasya, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.13",
            "verseOrgIds": [
              "JER.34.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 34:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myaka mũonza yathela mwĩthaasya kĩla mũndũ mwana‐a‐ĩthe wake Mũevelania, ũla wathooiw’e kwaku, na nũkũthũkũmĩte myaka thanthatũ, ũkamũthasya aume kwaku: ĩndĩ aaĩthe menyu matyaambĩthukĩĩsya, kana kũtea matũ moo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.14",
            "verseOrgIds": [
              "JER.34.14"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.15.12"
              },
              "items": [
                {
                  "text": "Kũt 15.12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.14",
            "verseOrgIds": [
              "JER.34.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 34:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na yu nĩmweealyũlĩte na kwĩka ũla nonaa wĩ ũseo, ũndũ wa kũtavan’ya ũthasyo kĩla mũndũ kwa mũtũi wake; na nĩmwatianĩĩte ũtianĩo mbee wakwa nyũmbanĩ ĩla yĩtanĩaw’a na syĩtwa yakwa: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.15",
            "verseOrgIds": [
              "JER.34.15"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.23.3"
              },
              "items": [
                {
                  "text": "2 Asu 23.3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.15",
            "verseOrgIds": [
              "JER.34.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 34:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "ĩndĩ mwaalyũka na kũyĩuma syĩtwa yakwa, na mwatũnga kĩla mũndũ mũthũkũmi wake, na kĩla mũndũ mũthũkũmi wake mwĩĩtu, ala mwamathaĩtye maende o vala mekwenda; na mwamaete ũkombonĩ, methĩwe kwenyu athũkũmi na athũkũmi eĩtu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.16",
            "verseOrgIds": [
              "JER.34.16"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
