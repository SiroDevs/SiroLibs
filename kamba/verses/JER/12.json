              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "We nĩwamavandie, ĩĩ, nĩmatambũũkĩtye mĩi; nĩmekwĩana, ĩĩ, nĩmekũsyaa mosyao: we wĩ vakuvĩ na makanyw’a moo, na wĩ kũasa na ngoo syoo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.2",
            "verseOrgIds": [
              "JER.12.2"
            ]
          }
        },
