              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ we, ame Yeova, nũmbĩsĩ; nũmbonaa, na kũtata ngoo yakwa kana nĩkwelekele: makwate ta malondu ma kũthĩnzwa, ũmavathe ũndũ wa mũthenya wa kũawa. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.3",
            "verseOrgIds": [
              "JER.12.3"
            ]
          }
        },
