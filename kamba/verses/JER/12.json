              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aĩthi aingĩ nĩmaanangie mũũnda wakwa wa mĩsavivũ, na kũkinyanga kĩlungu kyakwa, na kũtw’ĩkĩthya kĩlungu kyakwa kĩseo weũ mũthei. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.10",
            "verseOrgIds": [
              "JER.12.10"
            ]
          }
        },
