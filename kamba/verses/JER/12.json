              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩndiĩte nyũmba yakwa, nĩnĩvetete ũtiĩwa wakwa; nĩnĩnenganĩte mwendwa wa ngoo yakwa kw’okonĩ kwa amaitha make. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.7",
            "verseOrgIds": [
              "JER.12.7"
            ]
          }
        },
