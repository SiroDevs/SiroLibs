            "number": "8",
            "style": "v",
            "sid": "JER 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ũtiĩwa wakwa nũtw’ĩkĩte kwakwa ta mũnyambũ mũtitũnĩ: nũmbũkĩlĩlye wasya wake; kwondũ wa ũu nĩnĩmũmenete. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.8",
            "verseOrgIds": [
              "JER.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ũtiĩwa wakwa ũilyĩ kwakwa ta nyũnyi yĩ makwele ĩla ĩsyĩmaa? Nyũnyi ila isyĩmaa nimũkiita ngalĩ syonthe? Endai, mũmban’ye nyamũ syonthe sya kĩthekanĩ, mwiete iye. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.9",
            "verseOrgIds": [
              "JER.12.9"
            ]
          }
        },
