          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ o na ana‐a‐au, na nyũmba ya au, o asu nĩmakwĩkĩte ũseleke; o mo nĩmakũĩĩĩte ĩtina waku: ndũkametĩkĩle, o na makũtavya ndeto nzeo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.6",
            "verseOrgIds": [
              "JER.12.6"
            ]
          }
        },
