            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.3",
            "verseOrgIds": [
              "JER.44.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 44:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ nĩnatũmie kwenyu athũkũmi makwa onthe athani, ngyũkĩla tene na ngĩmatũma, ngyasya, Ame, mũtikeke ũndũ ũũ wa ũthatyo ũla nĩmenaa. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.4",
            "verseOrgIds": [
              "JER.44.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.36.15"
              },
              "items": [
                {
                  "text": "2 Mav 36.15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.4",
            "verseOrgIds": [
              "JER.44.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 44:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ matyaaĩthukĩĩsya, kana kũtea matũ moo methyũũe na kũtia ũthũku woo, matikatoeesye ngai ingĩ ũvani. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.5",
            "verseOrgIds": [
              "JER.44.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 44:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwondũ wa ũu kũthilĩka kwakwa na ũthatu wakwa syoonoiw’e, na kwakana ndũanĩ sya Yuta na nzĩanĩ nene sya Yelusaleme; nasyo nĩ mbanangĩku na ikatw’ĩka maanzo, o ũndũ kũilyĩ ũmũnthĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.6",
            "verseOrgIds": [
              "JER.44.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.9.11"
              },
              "items": [
                {
                  "text": "Yel 9.11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.6",
            "verseOrgIds": [
              "JER.44.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 44:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yu kwondũ wa ũu Yeova Ngai wa nguthu, Ngai wa Isilaeli, easya: Nũndũ wa kĩ mũkwĩka mathayũ menyu ũthũku ũũ mũnene, kũveta kwenyu mũndũ mũũme na mũndũ mũka, kana na kaũkenge, maumw’e katĩ wa Yuta, mũikatiwe na mũndũ o na ũmwe; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.7",
            "verseOrgIds": [
              "JER.44.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.16.38"
              },
              "items": [
                {
                  "text": "Mot 16.38",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LAM.2.11"
              },
              "items": [
                {
                  "text": "Iĩo 2.11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.7",
            "verseOrgIds": [
              "JER.44.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 44:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwondũ wa ũnthatya na mawĩa ma moko menyu, mũkĩtoeesya ngai ingĩ ũvani nthĩ ya Misili, vala mwaendie kwĩkala ũeni; nĩ kana mũvetwe, na mwĩthĩwe kĩumo na ma kũvũthw’a katĩ wa mbaĩ syonthe sya nthĩ? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.8",
            "verseOrgIds": [
              "JER.44.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.1.16"
              },
              "items": [
                {
                  "text": "Yel 1.16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.42.18"
              },
              "items": [
                {
                  "text": "42.18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.8",
            "verseOrgIds": [
              "JER.44.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 44:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩmũlĩtwe nĩ ũthũku wa aaĩthe menyu, na ũthũku wa asumbĩ ma Yuta, na ũthũku wa iveti syoo na ũthũku wenyu ene, na ũthũku wa iveti syenyu, ũla meekĩe nthĩ ya Yuta, na nzĩanĩ nene sya Yelusaleme? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.9",
            "verseOrgIds": [
              "JER.44.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
