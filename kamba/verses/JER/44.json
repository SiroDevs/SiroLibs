        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 44:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Matyaaĩnyivya kũvika mũnthĩ ũũ, o na matyaakĩa, kana kũendaa mĩaonĩ yakwa, kana myamũlonĩ yakwa, ĩla naiie mbee wenyu na mbee wa aaĩthe menyu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.10",
            "verseOrgIds": [
              "JER.44.10"
            ]
          }
        }
