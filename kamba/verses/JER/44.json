              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ũndũ wa ndeto ĩla ũneenete naitũ syĩtwanĩ ya Yeova, tũtikakwĩthukĩĩsya. ",
          "type": "text",
          "attrs": {
