              "items": [
                {
                  "text": "Aevl 4.14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ maũndũnĩ ala tũũneena ũndũ wa mbee nĩ atiĩ: Twĩ na mũthembi mũnene ũilyĩ ũu, ũla wekalile ngalĩ ya kw’oko kwa aũme kwa kĩvĩla kya ũsumbĩ kya ũla Ũnene matunĩ, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.1",
            "verseOrgIds": [
              "HEB.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HEB 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "mũthũkũmi wa vandũ vatheu, na wa ĩeema yĩla ya w’o, yĩla yaakiwe nĩ Mwĩaĩi, na ti mũndũ. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.2",
            "verseOrgIds": [
              "HEB.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HEB 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ kĩla mũthembi mũnene aiawa nĩ kana athembe mĩthĩnzĩo na nthembo ya kũtonywa: kwondũ wa ũu nĩkwaĩle kana mũthembi ũũ mũnene ethĩwe na kĩndũ kya ũthemba. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.3",
            "verseOrgIds": [
              "HEB.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HEB 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ kethĩwa e kũũ nthĩ, ndethĩwa e mũthembi nongi, nĩkwĩthĩwa kwĩ ala mathembaa mĩthĩnzĩo kwĩanana na ĩla mĩao; ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.4",
            "verseOrgIds": [
              "HEB.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HEB 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.2.17"
              },
              "items": [
                {
                  "text": "Ako 2.17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.25.40"
              },
              "items": [
                {
                  "text": "Kuma 25.40",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ala mathũkũmaa ngelekan’yo na kyuu kya syĩndũ sya ĩtunĩ, o tondũ Mose wataiwe nĩ Ngai weyũmbanĩtye kwaka yĩla ĩeema: nũndũ easya, Sisya kana ũseũvye syĩndũ syonthe o ta ngelekan’yo ĩla woonew’e kĩĩmanĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.5",
            "verseOrgIds": [
              "HEB.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HEB 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.7.22"
              },
              "items": [
                {
                  "text": "Aevl 7.22",
                  "type": "text"
                }
