              "items": [
                {
                  "text": "2 Ako 3.6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ yu nĩwosete ũthũkũmi ũla mũseo mbee, kwĩanana na ũndũ we nake nĩ mwĩw’anĩthya wa ũtianĩo mũseo mbee, ũla watwiwe ĩũlũ wa matho maseo mbee. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.6",
            "verseOrgIds": [
              "HEB.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HEB 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ kethĩwa ũtianĩo wa mbee, waĩ mwĩanĩu, vaiĩthĩwa na ũthei wa kũmantha ũngĩ wa kelĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.7",
            "verseOrgIds": [
              "HEB.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HEB 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ aimonea mavĩtyo, easya,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.8",
            "verseOrgIds": [
              "HEB.8.8"
            ]
