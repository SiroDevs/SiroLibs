                  "text": "Mwa 27.30–40",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ nĩmwĩsĩ kana o na ĩtina yĩla wendie kũtiĩwa ũla ũathimo, nĩwaleilwe; nũndũ ndaaona ũthei wa kwĩalyũla, o na kau nĩwomanthie mũno na methoi.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.17",
            "verseOrgIds": [
              "HEB.12.17"
            ]
          }
        }
