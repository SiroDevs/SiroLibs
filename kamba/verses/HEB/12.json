                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "tũkĩmũsisya Yesũ, mwambĩlĩlya na mwĩanisya wa mũĩkĩĩo witũ, ũla kwondũ wa ũtanu ũla waiiwe mbee wake oomĩĩsya ĩla ngelan’yo, aivũthya nthoni, na nĩwekalile nthĩ ngalĩ ya kw’oko kwa aũme kwa kĩvĩla kya ũsumbĩ kya Ngai.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.2",
            "verseOrgIds": [
              "HEB.12.2"
            ]
          }
        }
