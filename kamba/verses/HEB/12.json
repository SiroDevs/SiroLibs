            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.8.23"
              },
              "items": [
                {
                  "text": "Meko 8.23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "mũkĩsisya mũno mũndũ o na wĩva ndakatiale kũvikĩa ũla mumo wa Ngai; kĩtina kya ũũ kĩikathongooe na kũmũthĩn’ya, na kwondũ wakyo aingĩ kũvukw’a; ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.15",
            "verseOrgIds": [
              "HEB.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "HEB 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "kũikethĩwe kĩlaalai, kana ũla ũtamũkĩaa Ngai, ta Esau, ũla nũndũ wa kya ũya kĩmwe wathooisye ũtiĩwa wa ũkithathi wake. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.16",
            "verseOrgIds": [
              "HEB.12.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "HEB 12:17"
