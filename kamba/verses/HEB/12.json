                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "nũndũ matyaatonya kũmĩĩsya ũndũ weeaiwe, atĩĩ, Ethĩwa o na nyamũ ĩkakiita kĩĩma kyu, ĩkooawa na mavia; ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.20",
            "verseOrgIds": [
              "HEB.12.20"
            ]
          }
        },
        {
