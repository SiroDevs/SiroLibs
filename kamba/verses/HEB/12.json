            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũinamba kũkita kũvika kwĩtĩkya nthakame, mũkyũkita na naĩ: ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.4",
