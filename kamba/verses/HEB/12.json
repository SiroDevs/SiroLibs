                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ũndũ ũsu woonekie waĩ wa kwĩw’ĩthya w’ĩa mũno, o ũndũ Mose waisye, Nĩnalikwa nĩ w’ĩa mũno na kũtetema: ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.21",
            "verseOrgIds": [
              "HEB.12.21"
            ]
          }
        },
