                {
                  "text": "Mwa 2.17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ lĩu mũmũ nĩ wa andũ aima, ala, nũndũ wa kwĩmanyĩsya, ilĩko syoo nimanyĩĩtw’e kũvathũkan’ya ũseo na ũthũku.",
          "type": "text",
          "attrs": {
