              "items": [
                {
                  "text": "6.9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.12",
            "verseOrgIds": [
              "EXO.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
