        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.6",
            "verseOrgIds": [
              "EXO.33.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 33:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ Mose akothaa kũkua ĩeema na kũyamba ũtee wa mwako wa maeema, vaasa na mwako wa maeema; na ayĩta, Ĩeema ya kũmbanĩa. Na kweethĩwa, kana o mũndũ ũla wendaa ũndũ kwa Yeova aumaalaa akaenda yĩla ĩeemanĩ ya kũmbanĩa, yĩla yaĩ ũtee wa mwako wa maeema. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.7",
            "verseOrgIds": [
              "EXO.33.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.25.22"
              },
              "items": [
                {
                  "text": "Kuma 25.22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.29.42"
              },
              "items": [
                {
