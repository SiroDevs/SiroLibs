          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.13",
            "verseOrgIds": [
              "EXO.33.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 33:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake amwĩa, Nyie mwene ngathi naku, na ngakũnenga ũthũmũo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.14",
            "verseOrgIds": [
              "EXO.33.14"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
