            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 33:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Mose amwĩa Yeova, Sisya, ũmbĩĩte, Kua andũ aa: na ndũnamanyĩthya nũũ ũla wĩtũma vamwe nakwa. Ĩndĩ nũneenete, Nĩngwĩsĩ na syĩtwa yaku, na ĩngĩ nĩwonete ũseo methonĩ makwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.12",
            "verseOrgIds": [
              "EXO.33.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 33:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yu ĩndĩ, nĩngũkũvoya, ethĩwa nĩnonete ũseo methonĩ maku, mbon’ya yu mĩendele yaku, nĩkũmanye, nĩ kana none ũseo methonĩ maku: na sũanĩa kana mbaĩ ĩno nĩ andũ maku. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.13",
            "verseOrgIds": [
              "EXO.33.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
