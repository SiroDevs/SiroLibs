              "EXO.39.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "EXO 39:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Mose oona wĩa ũsu w’onthe, na sisya, mawĩkĩte; o tondũ Yeova weaĩte, ũu nĩw’o mekĩte: na Mose amaathima.",
