            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.1",
            "verseOrgIds": [
              "EXO.39.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 39:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na aseũvya yĩla evoti na ndii sya thaavu, na ila sya vuluu, na ila itilyĩ ta ndune, na ila ndune mũno, na katane nzeo mbokothe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.2",
            "verseOrgIds": [
              "EXO.39.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.28.6+EXO.28.7+EXO.28.8+EXO.28.9+EXO.28.10+EXO.28.11+EXO.28.12"
              },
              "items": [
                {
                  "text": "Kuma 28.6–12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.2",
            "verseOrgIds": [
              "EXO.39.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 39:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao mamanda thaavu ũsu wavũtha mũno, na mawatũanga watw’ĩka tũmĩkunzu, nĩ kana motuman’ye na ila sya vuluu, na ila itilyĩ ta ndune, na ila ndune mũno, na katane nzeo, wĩa wa mũtethya wa wĩa ũla mũĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.3",
            "verseOrgIds": [
              "EXO.39.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 39:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mayĩseũvĩsya ikwatũ sya ituonĩ, ikwatene: yaĩ ĩkwatan’ye mĩthyanĩ ĩlĩ yayo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.4",
            "verseOrgIds": [
              "EXO.39.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 39:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ũla mũsivi ũtũmĩtwe na ũĩ, ũla waĩ ĩũlũ wayo, ũla wa kũyova yĩlũme, waĩ wa kĩlungu kĩmwe nayo na ũtũmĩtwe ũndũ ũmwe nayo; wa ndii sya thaavu, na ila sya vuluu, na ila itilyĩ ta ndune, na ila ndune mũno, na katane nzeo mbokothe; o tondũ Yeova weaĩe Mose.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.5",
            "verseOrgIds": [
              "EXO.39.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 39:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.5",
            "verseOrgIds": [
              "EXO.39.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 39:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na maseuvya tũla tũvila twa nzumalati, tũlũmanĩthw’e iĩndĩnĩ sya thaavu, mavanĩtwe na movano me ngomenĩ ya kũsiĩla, kwĩanana na masyĩtwa ma ana ma Isilaeli. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.6",
            "verseOrgIds": [
              "EXO.39.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 39:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na amekĩa ikwatũnĩ sya ituonĩ sya yĩla evoti, methĩwe tũvila twa ũlilikan’yo kwondũ wa ana ma Isilaeli; o tondũ Yeova weaĩe Mose.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.7",
            "verseOrgIds": [
              "EXO.39.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 39:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.7",
            "verseOrgIds": [
              "EXO.39.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 39:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na aseũvya kala kakalo ka kĩthũi, wĩa wa mũtethya wa wĩa ũla mũĩ, o ta wĩa wa yĩla evoti; ka ndii sya thaavu, na ila sya vuluu, na ila itilyĩ ta ndune, na ila ndune mũno, na katane nzeo mbokothe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.8",
            "verseOrgIds": [
              "EXO.39.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.28.15+EXO.28.16+EXO.28.17+EXO.28.18+EXO.28.19+EXO.28.20+EXO.28.21+EXO.28.22+EXO.28.23+EXO.28.24+EXO.28.25+EXO.28.26+EXO.28.27+EXO.28.28"
              },
              "items": [
                {
                  "text": "Kuma 28.15–28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.8",
            "verseOrgIds": [
              "EXO.39.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 39:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Keethĩwa keanene ngalĩ inya; maseũvya kala kakalo ka kĩthũi makĩkatulanĩla: ũasa wako waĩ ĩkwata yĩmwe ya kĩtaa, na ũthanthau wako ĩkwata yĩmwe ya kĩtaa, ke katulanĩle. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.9",
            "verseOrgIds": [
              "EXO.39.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 39:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na meekĩa mĩsoa ĩna ya tũvila nthĩnĩ wako. Mũsoa wa mbee waĩ wa salitũ, na tovasi, na alimasi ndune; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.10",
            "verseOrgIds": [
              "EXO.39.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 39:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "na mũsoa wa kelĩ, sumalati, na savili, na salitonyi; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.11",
            "verseOrgIds": [
              "EXO.39.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 39:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "na mũsoa wa katatũ, samawi, na yasimu, na amethusito; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.12",
            "verseOrgIds": [
              "EXO.39.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 39:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "na mũsoa wa kana, nzumalati ntheu, na nzumalati, na yasivi: tũlũmanĩthw’a na thaavu iĩndĩnĩ syatw’o. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.13",
            "verseOrgIds": [
              "EXO.39.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 39:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na tũvila tũu twaĩ kwĩanana na masyĩtwa ma ana ma Isilaeli, ĩkũmi na elĩ, o kwĩanana na masyĩtwa moo; ta movano me ngomenĩ ya kũsiĩla, kĩla mũndũ kwĩanana na syĩtwa yake, kwondũ wa ila mbaĩ ĩkũmi na ilĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.14",
            "verseOrgIds": [
              "EXO.39.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 39:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na maseũvya mĩnyoo ĩtilyĩ tũkanda kakalonĩ ka kĩthũi ĩũlũ, ya thaavu mũtheu wĩ mũvĩnde. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.15",
            "verseOrgIds": [
              "EXO.39.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 39:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na maseũvya iĩndĩ ilĩ sya thaavu, na ngome ilĩ sya thaavu, na meekĩa ngome isu ilĩ mĩthyanĩ ilĩ ya kala kakalo ka kĩthũi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.16",
            "verseOrgIds": [
              "EXO.39.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 39:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na meekĩa minyoo ĩsu ĩlĩ mĩvĩnde ya thaavu nthĩnĩ wa ngome ilĩ mĩthyanĩ ya kakalo ka kĩthũi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.17",
            "verseOrgIds": [
              "EXO.39.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 39:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mĩthya ĩla ĩngĩ ĩlĩ ya mĩnyoo ĩsu ĩlĩ mĩvĩnde meekĩa ĩĩndĩnĩ isu ilĩ, na mamĩkolelya ila ikwatũnĩ isu sya ituonĩ sya evoti, ngalĩ ya mbee yayo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.18",
            "verseOrgIds": [
              "EXO.39.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 39:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na matua ngome ilĩ sya thaavu, na makolelya mĩthyanĩ ĩlĩ ya kakalo ka kĩthũi, ũteenĩ wako, ũla welekele ngalĩ ya nthĩnĩ ya evoti. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.19",
            "verseOrgIds": [
              "EXO.39.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 39:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na matua ngome ilĩ sya thaavu, na makolelya ikwatũnĩ isu ilĩ sya ituonĩ sya evoti ungu, ngali ya mbee yayo, vakuvĩ na vala vakwatanĩlw’e vayo ĩũlũ wa ũla mũsivi, wa evoti ũtumĩtwe na ũĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.20",
            "verseOrgIds": [
              "EXO.39.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 39:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na malũman’ya kakalo ka kĩthũi na ngome syako ngomenĩ sya evoti na ũlii wa vuluu, nĩ kana kethĩwe ĩũlũ wa ũla mũsivi wa evoti ũtumĩtwe na ũĩ, na nĩ kana kakalo ka kĩthũi kaikathaw’e yĩla evotinĩ; o tondũ Yeova weaĩe Mose.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.21",
            "verseOrgIds": [
              "EXO.39.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 39:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.21",
            "verseOrgIds": [
              "EXO.39.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 39:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na aseũvya ĩla ngũa ndasa ya evoti ya ngũa ndume, yonthe ya vuluu; ",
