              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "yi na ĩima ya kũlikya mũtwe ya ĩla ngũa ndasa nthĩnĩ wayo katĩ, yĩilyĩ ĩima yĩkĩwe kakotinĩ ka kaũ, yĩ na ũtaami wĩlingĩle ĩimanĩ yayo, nĩ kana ndĩkatembũke. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.23",
            "verseOrgIds": [
              "EXO.39.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 39:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na motiivonĩ ma ĩla ngũa ndasa maseũvya makũngũmanga ma ndii sya vuluu, na ila itilyĩ ta ndune, na ila ndune mũno, na katane mbokothe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.24",
            "verseOrgIds": [
              "EXO.39.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 39:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na maseũvya tũtilili twa thaavu mũtheu, na meekĩa tũtilili tũu katĩ wa makũngũmanga motiivonĩ ma ĩla ngũa ndasa twĩlingĩlĩte, katĩ wa ala makũngũmanga; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.25",
            "verseOrgIds": [
              "EXO.39.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 39:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "o katilili na ĩkũngũmanga, katilili na ĩkũngũmanga, motiivonĩ ma ĩla ngũa ndasa twĩlingĩlĩte, kwondũ wa kũthũkũmaa ekĩe; o tondũ Yeova weaĩe Mose.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.26",
            "verseOrgIds": [
              "EXO.39.26"
            ]
          }
        }
      ]
