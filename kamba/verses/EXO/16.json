            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Mose amea, Mũndũ o na wĩva ndakaitialye kũvika kĩoko. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.19",
            "verseOrgIds": [
              "EXO.16.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ matyaamwĩthukĩĩsya Mose; ĩndĩ amwe moo maitialya kũvika kĩoko, na syaya iinyu na syanyunga naĩ: na Mose amathilĩkĩa mũno.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.20",
            "verseOrgIds": [
              "EXO.16.20"
            ]
          }
        }
      ]
    },
