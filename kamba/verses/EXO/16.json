              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "O tondũ Yeova wamwĩaĩe Mose, Aluni awiie o ta ũu mbee wa Ĩsandũkũ ya Ũkũsĩ, ũsũvĩwe. ",
          "type": "text",
          "attrs": {
