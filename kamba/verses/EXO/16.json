              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kweethĩwa wĩoo, ngwae syaumĩla syavw’ĩka mwako wa maeema: na kĩoko ĩmwe yathyũlũlũka mwako wa maeema. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.13",
            "verseOrgIds": [
              "EXO.16.13"
            ]
          }
        },
