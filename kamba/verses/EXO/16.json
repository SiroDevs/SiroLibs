          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ũũ nĩ ũla Yeova wĩaĩte, Kolan’yai kwĩanana na ũndũ kĩla mũndũ ũĩsaa; mũkose kya ĩmisi kĩla mũndũ, kwĩanana na ũtalo wa andũ menyu, kĩla mũndũ kwondũ wa asu me ĩeemanĩ kwake. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.16",
            "verseOrgIds": [
              "EXO.16.16"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
