                "loc": "PSA.78.10"
              },
              "items": [
                {
                  "text": "Sav 78.10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.28",
            "verseOrgIds": [
              "EXO.16.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 16:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sisya, nĩkwĩthĩwa Yeova nũmũnengete savato, kwondũ wa ũu nũmũnengae mũthenya wa thanthatũ ĩmũtũ sya mĩthenya ĩlĩ; ĩkalai kĩla mũndũ vandũ vake, mũndũ o na wĩva ndakaumaale kwake mũthenya wa mũonza. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.29",
            "verseOrgIds": [
              "EXO.16.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 16:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kwondũ wa ũu andũ mathũmũa mũthenya wa mũonza.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.30",
            "verseOrgIds": [
              "EXO.16.30"
            ]
          }
        }
      ]
