            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩmwe yĩla yaĩ nthĩ yatw’ĩka, sisya, kw’onthe weũnĩ kwaĩ kĩndũ kĩnini kĩlinge kĩ nthĩ, kĩnini ta ĩmwe yĩkamĩtw’e nĩ mbevo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.14",
            "verseOrgIds": [
              "EXO.16.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na yĩla ana ma Isilaeli makyonie, makũlan’ya ene kwa ene, Nĩ kyaũ? Nũndũ matyaamanya nĩ kyaũ. Na Mose amea, Nĩ imũtũ ila Yeova ũmũnengete mũye. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.15",
            "verseOrgIds": [
              "EXO.16.15"
            ]
          }
        },
        {
