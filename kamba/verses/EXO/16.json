              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na maenda kyalo kuma Elimu, na ũmbano w’onthe wa ana ma Isilaeli wavika weũnĩ wa Sini, ũla wĩ katĩ wa Elimu na Sinai, mũthenya wa ĩkũmi na ĩtano wa mwei wa kelĩ ĩtina wa mauma nthĩ ya Misili. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.1",
            "verseOrgIds": [
              "EXO.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ũmbano w’onthe wa ana ma Isilaeli wamanyungunyĩĩsya Mose na Aluni weũnĩ: ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.2",
            "verseOrgIds": [
              "EXO.16.2"
            ]
          }
        },
