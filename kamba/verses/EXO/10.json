          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Indo sitũ nasyo tũkathi nasyo; kũti ĩvũngũ yĩmwe yĩkatiwa ĩtina; nũndũ kuma nthĩnĩ wasyo mũvaka twose tuthũkũme Yeova Ngai waitũ; na tũtyĩsĩ mũvaka no twavika vo, ila twaĩle kũthũkũma Yeova nasyo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.26",
            "verseOrgIds": [
              "EXO.10.26"
            ]
          }
        },
        {
