              },
              "items": [
                {
                  "text": "34.27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.3",
            "verseOrgIds": [
              "EXO.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana, ethĩwa nũũlea kũlekya andũ makwa mathĩ, sĩsya, ũnĩ ngaete ngie ilike mĩvakanĩ yaku: ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.4",
            "verseOrgIds": [
              "EXO.10.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.30.27"
              },
              "items": [
                {
                  "text": "Nth 30.27",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.9.3"
              },
              "items": [
                {
                  "text": "Ũvu 9.3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.4",
            "verseOrgIds": [
              "EXO.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "na ikavw’ĩka ĩũlũ wa nthĩ, o ũndũ mũndũ ũtatonya kũmyona nthĩ: na ikaya kĩla kĩtiele kya kĩla kĩthonokete, kĩla kyamũtialĩle mbuanĩ ya mavia, na ikaya kĩla mũtĩ ũla ũmeaa kwondũ wenyu kĩsesinĩ: ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.5",
            "verseOrgIds": [
              "EXO.10.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.9.32"
              },
              "items": [
                {
                  "text": "Kuma 9.32",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.5",
            "verseOrgIds": [
              "EXO.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "na nyũmba syaku, na nyũmba sya athũkũmi maku onthe, na nyũmba sya Amisili onthe ĩkausũwa nĩsyo; o tondũ aaĩthe maku, o na aũmae maku mataaona, kuma mũthenya mambĩlĩlya kũsyawa kũũ nthĩ kũvika ũmũnthĩ. Na eethyũũa, na auma kwa Valao. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.6",
            "verseOrgIds": [
              "EXO.10.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOL.2.9"
              },
              "items": [
                {
                  "text": "Yoe 2.9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.6",
            "verseOrgIds": [
              "EXO.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na athũkũmi ma Valao mamũkũlya, Mũndũ ũũ akekala e mũtei kwitũ kũvika ĩndĩĩ? Lekya andũ mathi, mathũkũme Yeova Ngai woo: ndũnamba kũmanya kana Misili nĩ mbanangĩku? ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.7",
            "verseOrgIds": [
              "EXO.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Mose na Aluni matũngwa kwa Valao ĩngĩ: na amea, Endai, mũthũkũme Yeova Ngai wenyu: ĩndĩ ala methĩ naaũ? ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.8",
            "verseOrgIds": [
              "EXO.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Mose amwĩa, Tũkaenda na syana sitũ na akũũ maitũ; na tũkaenda na ana maitũ na eĩtu maitũ, na ndĩthya sitũ sya mbũi na malondu na ndĩthya sitũ sya ng’ombe; nĩkwĩthĩwa no mũvaka twĩthĩwe na mboka kwondũ wa Yeova. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.9",
            "verseOrgIds": [
              "EXO.10.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.5.1"
              },
              "items": [
                {
                  "text": "Kuma 5.1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.9",
            "verseOrgIds": [
              "EXO.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na amea, Yeova ethĩwe nenyu ĩndĩ, o tondũ ngũmũlekya mũthi na syana nini syenyu: sisyai; nũndũ kwĩ ũthũku mũsũanĩĩte. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.10",
            "verseOrgIds": [
              "EXO.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiw’o: endai yu, inyw’ĩ andũ aima, mũthũkũme Yeova; nũndũ ũu nĩ ũla mũkwenda. Na malũngw’a kuma kwa Valao.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.11",
            "verseOrgIds": [
              "EXO.10.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.11",
            "verseOrgIds": [
              "EXO.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yeova amwĩa Mose, Tambũũkya kw’oko kwaku ĩũlũ wa nthĩ ya Misili, nĩ kana ngie syũke syambate nthĩ ya Misili, na kũya nyũnyi syonthe sya nthĩ, o syonthe ila itialĩtw’e nĩ mbua ya mavia. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.12",
            "verseOrgIds": [
              "EXO.10.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.9.22"
              },
              "items": [
                {
                  "text": "Kuma 9.22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.10.5"
              },
              "items": [
                {
                  "text": "10.5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.12",
            "verseOrgIds": [
              "EXO.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Mose atambũũkya ndata yake ĩũlũ wa nthĩ ya Misili, na Yeova aete kĩuutani kyumĩte wumĩlonĩ wa syũa ĩũlũ wa nthĩ mũthenya ũsu w’onthe, na ũtukũ w’onthe; na kwakya, kĩuutani kĩla kyumite wumiloni wa syũa kyaete ngie. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.13",
            "verseOrgIds": [
              "EXO.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ila ngie syambata ĩũlũ wa nthĩ yonthe ya Misili, na syekala mĩvakanĩ yonthe ya Misili; syaĩ mbai mũno; kũtyaaoneka ĩngĩ ngie itilyĩ ta isu, o na kũtikethĩwa ĩngĩ tasyo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.14",
            "verseOrgIds": [
              "EXO.10.14"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
