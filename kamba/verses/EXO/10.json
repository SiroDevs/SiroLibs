              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Mose, amwĩa, Nĩwaneena nesa; ndikona ũthyũ waku ĩngĩ nongi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.29",
