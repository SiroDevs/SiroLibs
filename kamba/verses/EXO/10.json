            "number": "3",
            "style": "v",
            "sid": "EXO 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Mose na Aluni malika kwa Valao, na mamwĩa, Ũũ nĩw’o Yeova, Ngaĩ wa Aevelania, ũnũkwasya, Wĩlea kwĩnyivya mbee wakwa kũvika ĩndĩĩ? Lekya andũ makwa mathi, manthũkũme. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.3",
            "verseOrgIds": [
              "EXO.10.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
