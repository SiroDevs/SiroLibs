          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "na nĩ kana ũtonye kũneena mwana waku akĩw’a, o na mwĩsũkũũu, maũndũ ala nĩkĩte Misili, na syama syakwa ila nĩkĩte katĩ woo: nĩ kana mũmanye ninyie Yeova. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.2",
            "verseOrgIds": [
              "EXO.10.2"
            ]
          }
        },
