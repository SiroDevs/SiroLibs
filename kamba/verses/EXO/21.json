          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ethĩwa ũkathooa ngombo, Mũevelania, ĩkũthũkũme myaka thanthatũ: na wa mũonza ĩkauma yĩ nthasye mana. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.2",
            "verseOrgIds": [
              "EXO.21.2"
            ]
          }
        },
        {
