            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yeova aneena na Mose na Aluni, akyasya, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.8",
            "verseOrgIds": [
              "EXO.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yĩla Valao wĩneena nenyu, akĩmwĩa, Onan’yai kyama kwondũ wenyu: nĩvo ĩndĩ wĩmwĩa Aluni, Osa ndata yaku, nokĩkya nthĩ mbee wa Valao ĩtw’ĩke nzoka. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.9",
            "verseOrgIds": [
              "EXO.7.9"
            ]
          }
        },
        {
