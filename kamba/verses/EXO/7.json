              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ mekya kĩla mũndũ ndata yake nthĩ, nasyo syatw’ĩka nzoka: ĩndĩ ĩla ndata ya Aluni yamelya ndata syoo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.12",
            "verseOrgIds": [
              "EXO.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ngoo ya Valao yoomwa, na ndaamethukĩĩsya; o tondũ Yeova ũneenete. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.13",
