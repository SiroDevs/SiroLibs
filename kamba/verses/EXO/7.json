              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yeova amwĩa Mose, Sisya, nĩkũtw’ĩkĩthĩtye ta Ngai kwa Valao; na Aluni, mwana‐a‐mwenyu, akeethĩwa mwathani waku. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.1",
            "verseOrgIds": [
              "EXO.7.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.4.16"
              },
              "items": [
                {
                  "text": "Kuma 4.16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.1",
            "verseOrgIds": [
              "EXO.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ũkaneene onthe ala ngũkwĩaĩa; na Aluni, mwana‐a‐mwenyu, akaneena na Valao, nĩ kana alekye ana ma Isilaeli maume nthĩ yake. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.2",
            "verseOrgIds": [
              "EXO.7.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
