              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yeova amwĩa Mose, Ngoo ya Valao nĩ nyũmũ, nũleete kũlekya andũ mathi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.14",
            "verseOrgIds": [
              "EXO.7.14"
            ]
          }
        },
        {
          "name": "verse",
