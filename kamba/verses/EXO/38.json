              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na aseũvya syambo sya ituĩ isu kuma ila sekeli ngili ĩmwe na maana mũonza na mĩongo mũonza na itano, na avw’ĩka ila ngovia syasyo, na aseũvya mĩkunzu ũndũ wasyo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.28",
            "verseOrgIds": [
              "EXO.38.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
