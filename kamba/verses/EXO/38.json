          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ũsu nĩw’o ũtalo wa isamũ sya wĩkalo, o wĩkalo ũsu wa ũkũsĩ, o ũndũ syatalilwe, kwĩanana na mwĩao wa Mose, ũndũ wa ũthũkũmi wa Alivai, nĩ Ithamali, mwana wa mũthembi Aluni. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.21",
            "verseOrgIds": [
              "EXO.38.21"
            ]
          }
        },
