              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Mbesaleli, mwana wa Ulĩ, mwana wa Uulu, wa mbaĩ va Yuta, aseũvya syonthe ila Yeova wamwĩaĩe Mose. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.22",
            "verseOrgIds": [
              "EXO.38.22"
            ]
          }
        },
        {
