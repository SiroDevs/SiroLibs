          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na talendi isu ĩana sya vetha syaĩ kwondũ wa kũtua iĩndĩ sya vala vandũ vatheu, na iĩndĩ isu sya ũla tũtũ; iĩndĩ ĩana kuma ila talendi ĩana, talendi ĩmwe kwondũ wa kĩla kĩĩndĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.27",
            "verseOrgIds": [
              "EXO.38.27"
            ]
          }
        },
