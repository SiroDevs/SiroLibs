          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yeova aneena na Mose, akĩmwĩa, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.11",
            "verseOrgIds": [
              "EXO.30.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 30:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yĩla ũũtala ũtalo wa ana ma Isilaeli, kwĩanana na ala matalawa katĩ woo, nĩvo ĩndĩ makanengane mbovosya kwa Yeova kĩla mũndũ mũũme kwondũ wa thayũ wake, o yĩla ũũmatala; nĩ kana kũtikethĩwe ũthĩn’yo katĩ woo, yĩla ũũmatala. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.12",
            "verseOrgIds": [
              "EXO.30.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
