        {
          "text": "Na ĩngĩ ũkaseũvye kĩndũ kya kũthambĩaa kya ũthuku, na ĩtina yakyo ya ũthuku, kĩla kya ũthambĩaa. Na ũkakie katĩ wa ĩeema ya kũmbanĩa na kĩthembeo, na ũkekĩe manzĩ nthĩnĩ wakyo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.18",
            "verseOrgIds": [
              "EXO.30.18"
            ]
          }
        },
