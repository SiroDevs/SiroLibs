                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.26.2"
              },
              "items": [
                {
                  "text": "26.2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.12",
            "verseOrgIds": [
              "EXO.30.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 30:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kĩla makanengane nĩ kĩĩ, o kĩla ũmwe ũla wĩvĩtũkaa e mũtale athi kũla kwĩ asu atale: nyunzu ya sekeli kwĩanana na sekeli ya vala vandũ vatheu (ĩla sekeli nĩ ngela mĩongo ĩlĩ), nyunzu ya sekeli kwondũ wa nthembo kwa Yeova. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.13",
            "verseOrgIds": [
              "EXO.30.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
