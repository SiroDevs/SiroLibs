              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.7",
            "verseOrgIds": [
              "EXO.30.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 30:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na yĩla Aluni ũnũũkwatya mataa wĩoo, akotoeeasye, wĩthĩwe ũvani wa kũtoeeasya ĩvinda yonthe vala ve Yeova mosyaanĩonĩ menyu onthe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.8",
            "verseOrgIds": [
              "EXO.30.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 30:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũtikatoeesye ũvani wa mũthemba ũngĩ ĩũlũ wakyo, o na nthembo ya kũvĩvw’a, o na nthembo ya mũtu; na mũtikete nthembo ya kũnyuwa ĩũlũ wakyo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.9",
            "verseOrgIds": [
              "EXO.30.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.10.1"
              },
              "items": [
                {
                  "text": "Ali 10.1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.9",
            "verseOrgIds": [
              "EXO.30.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 30:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Aluni akaumĩsye nthembo ya wĩw’anĩthyo mbyanĩ syakyo ĩvinda yĩmwe mwaka: na nthakame ya ĩla nthembo kwondũ wa naĩ ya kwĩw’anĩthya akaumye nthembo ya wĩw’anĩthyo kwondũ wakyo o ĩvinda yĩmwe mwaka mosyaanĩonĩ menyu onthe: nĩ kĩtheu mũno vyũ kwa Yeova. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.10",
            "verseOrgIds": [
              "EXO.30.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
