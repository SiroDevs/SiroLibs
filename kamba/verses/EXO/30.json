            "number": "14",
            "style": "v",
            "sid": "EXO 30:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "O ũla wĩvĩtũkaa e mũtale athi kũla kwĩ asu atale, ma myaka mĩongo ĩlĩ na mbee, akaumya nthembo kwa Yeova. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.14",
            "verseOrgIds": [
              "EXO.30.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 30:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Athwii matikaumye kũvĩtũkya, na ala ngya matikaumye nini kwĩ ĩla nyunzu ya sekeli, yĩla maumasya ĩla nthembo kwa Yeova, nĩ kana mwone wĩw’anĩthyo kwondũ wa mathayũ menyu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.15",
            "verseOrgIds": [
              "EXO.30.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 30:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ũkaumye mbesa sya wĩw’anĩthyo kuma kwa ana ma Isilaeli, na kwitw’ĩĩa kwondũ wa ũthũkũmi wa yĩla ĩeema ya kũmbanĩa; nĩ kana ikethĩwe ũlilikan’yo kwa ana ma Isilaeli vala ve Yeova, sya wĩw’anĩthyo kwondũ wa mathayũ menyu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.16",
            "verseOrgIds": [
              "EXO.30.16"
            ]
          }
        },
