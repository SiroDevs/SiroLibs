                "loc": "EXO.10.9"
              },
              "items": [
                {
                  "text": "Kuma 10.9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.1",
            "verseOrgIds": [
              "EXO.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Valao asya, Yeova nũũ, nĩthukĩĩsye wasya wake nĩlekya Isilaeli mathi? Ndimwĩsĩ Yeova, o na ndikalekya Isilaeli mathi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.2",
            "verseOrgIds": [
              "EXO.5.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
