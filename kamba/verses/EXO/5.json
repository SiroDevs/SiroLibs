                "loc": "2KI.18.35"
              },
              "items": [
                {
                  "text": "2 Asu 18.35",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.21.15"
              },
              "items": [
                {
                  "text": "Yovu 21.15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.2",
            "verseOrgIds": [
              "EXO.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mamwĩa, Ngai wa Aevelania nũnakomanie naitũ: nĩtũũkwĩsũva, ũtũlekye tũthi weũnĩ kyalo kya mĩthenya ĩtatũ, tũthembee Yeova, Ngai waitũ, ndakese kũtũvalũkĩlya mũimũ, kana ũvyũ. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.3",
            "verseOrgIds": [
              "EXO.5.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.3.18"
              },
              "items": [
                {
                  "text": "Kuma 3.18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.3",
            "verseOrgIds": [
              "EXO.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mũsumbĩ wa Misili amea, Nĩ ũndũ wa kĩ inyw’ĩ, Mose na Aluni, mũũtuma andũ matia mawĩa moo? Endai mũsyokee mĩio yenyu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.4",
            "verseOrgIds": [
              "EXO.5.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.1.11"
              },
              "items": [
                {
                  "text": "Kuma 1.11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.4",
            "verseOrgIds": [
              "EXO.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Valao amea, Sisya, andũ ma nthĩ yu nĩ aingĩ, na nĩmũũtuma mathũmũia mĩio yoo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.5",
            "verseOrgIds": [
              "EXO.5.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.1.7"
              },
              "items": [
                {
                  "text": "Kuma 1.7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.1.9"
              },
              "items": [
                {
                  "text": "9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.5",
            "verseOrgIds": [
              "EXO.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mũthenya o ũsu Valao ameaĩa aũngamĩi ma andũ, na anene moo, akĩmea, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.6",
            "verseOrgIds": [
              "EXO.5.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.3.7"
              },
              "items": [
                {
                  "text": "Kuma 3.7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.5.14"
              },
              "items": [
                {
                  "text": "5.14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.5.15"
              },
              "items": [
                {
                  "text": "15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.6",
            "verseOrgIds": [
              "EXO.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũikanenge andũ ũa ĩngĩ ta tene, wa kũmba mavali: nĩmaende memanthĩe ũa mo ene. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.7",
            "verseOrgIds": [
              "EXO.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ũtalo wa mavali, ala mombaa tene, manengei o w’o; mũtikanyivye o na vanini: nĩkwĩthĩwa nĩ atulu; kwondũ wa ũu nimeũlonzan’ya, na kwasya, Tũendei tũmũthembee Ngai waitũ. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.8",
            "verseOrgIds": [
              "EXO.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Andũ nĩmanengwe wĩa wĩ vinya mbee, motethye; na matikethukĩĩsye ndeto sya ũvũngũ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.9",
            "verseOrgIds": [
              "EXO.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.9",
            "verseOrgIds": [
              "EXO.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na aũngamĩi ma andũ, na anene moo, maumaala, na maneena na andũ, makĩmea, Ũũ nĩw’o Valao ũnũkwasya, Ndimũnenga ũa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.10",
            "verseOrgIds": [
              "EXO.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Endai inyw’ĩ, mũkemanthĩe ũa o vala mũtonya kũwona; nũndũ wĩa wenyu o na wĩva ndũkaoleka. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.11",
            "verseOrgIds": [
              "EXO.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwondũ wa ũu andũ manyaĩĩkwa nthĩ yonthe ya Misili mamanthe mavuthĩ vandũ va ũla ũa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.12",
            "verseOrgIds": [
              "EXO.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na aũngamĩi mamakalaata mũno, makĩmea, Ianĩsyai mawĩa menyu, mawĩa ma kĩla mũthenya, o ta yĩla ũa waĩ vo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.13",
            "verseOrgIds": [
              "EXO.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na anene ma ana ma Isilaeli, ala aũngamĩi ma Valao mamaiĩte, makũnwa, makĩwa, Nĩ ũndũ wa kĩ muineanĩsya wĩa wenyu wa kũmba mavali ĩoo, o na ũmũnthĩ, ta tene?",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.14",
            "verseOrgIds": [
              "EXO.5.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.14",
            "verseOrgIds": [
              "EXO.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩvo ĩndĩ anene ma ana ma Isilaeli mathi manũĩĩa Valao, makĩmũkũlya, Wĩĩka na athũkũmi maku ũu nĩkĩ? ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.15",
            "verseOrgIds": [
              "EXO.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ithyĩ athũkũmi maku tũtinengawe ũa, nao metwĩa, Ũmbai mavali: na, sisya, athũkũmi maku nĩtũkũnawa; ĩndĩ ĩvĩtyo yĩ kwa andũ maku mwene. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.16",
            "verseOrgIds": [
              "EXO.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ amea, Mwĩ atulu, mwĩ atulu: kwondũ wa ũu mwĩasya, Tũendei tũmũthembee Yeova. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.17",
            "verseOrgIds": [
              "EXO.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Endai yu ĩndĩ, mũtethye wĩa; nĩkwĩthĩwa mũikanengwa ũa, ĩndĩ mũkeanĩsye ũla ũtalo wa mavali. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.18",
            "verseOrgIds": [
              "EXO.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na anene ma ana ma Isilaeli moona atĩ me ũndũnĩ ũthũku, yĩla matavĩw’e, Mũtikaole o na vanini mavali menyu, ũtalo wa kĩla mũthenya. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.19",
            "verseOrgIds": [
              "EXO.5.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na makyuma kwa Valao makomana na Mose na Aluni, ala maũngeme nzĩani: ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.20",
            "verseOrgIds": [
              "EXO.5.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "na mamea, Yeova amũsisye, na kũsila; nũndũ nĩmũtũnyungĩtye naĩ kũla kwĩ Valao, na kũla kwĩ athũkũmi make, kũmanenga ũvyũ mokonĩ moo matũae. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.21",
            "verseOrgIds": [
              "EXO.5.21"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
