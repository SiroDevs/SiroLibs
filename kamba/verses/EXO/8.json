          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Mose amwĩa Valao, Ĩnenevye ĩndĩ vala nĩĩ: nĩ ĩvinda yĩva nĩũvoyea, na athũkũmi maku, na andũ maku, nĩ kana syoa syanangwe kuma kwaku na nyũmbanĩ syaku, na ikĩkala ũsĩnĩ wĩ w’oka? ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.9",
            "verseOrgIds": [
              "EXO.8.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
