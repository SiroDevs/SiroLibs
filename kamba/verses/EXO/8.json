              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tũkaenda weũnĩ kyalo kya mĩthenya ĩtatũ, na tũkĩthembea Yeova Ngai waitũ, o tondũ wĩtwĩaĩa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.27",
            "verseOrgIds": [
              "EXO.8.27"
            ]
          }
        },
        {
