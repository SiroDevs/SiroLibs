              "JHN.18.15"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.20.3"
              },
              "items": [
                {
                  "text": "Yoa 20.3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.21.20"
              },
              "items": [
                {
                  "text": "21.20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.3.1"
              },
              "items": [
                {
                  "text": "Meko 3.1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Simoni Vetelo amũatĩĩe Yesũ, e na mũmanyĩw’a ũngĩ. Na mũmanyĩw’a ũsu nĩwesĩkĩwe nĩ mũthembi mũnene, na avota vamwe na Yesũ nza kwa mũthembi mũnene; ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.15",
            "verseOrgIds": [
              "JHN.18.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JHN 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "ĩndĩ Vetelo aũngama mũomonĩ nza. Na ĩndĩ mũmanyĩw’a ũla ũngĩ, ũla wesikĩwe nĩ mũthembĩ mũnene, aumaala na aneena na mũsũvĩi wa mũomonĩ, na amũtwaa Vetelo nthĩnĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.16",
            "verseOrgIds": [
              "JHN.18.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JHN 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ mwĩĩtu ũla mũsũvĩi wa mũomonĩ amũkũlya Vetelo, O naku wĩ ũmwe wa amanyĩw’a ma mũndũ ũũ? Asya, Ndi ũmwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.17",
            "verseOrgIds": [
              "JHN.18.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JHN 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ngombo na makanga maũngamĩte, mavuvĩte mwaki wa makaa; nũndũ kwaĩ mbevo; na motaa mwaki: na Vetelo nake aĩ vamwe nao, aũngeme akyota mwaki.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.18",
            "verseOrgIds": [
              "JHN.18.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JHN 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.18",
            "verseOrgIds": [
              "JHN.18.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JHN 18:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ ũla mũthembi mũnene amũkũlya Yesũ ũndũ wa amanyĩw’a make, na ũndũ wa ũmanyĩsyo wake. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.19",
            "verseOrgIds": [
              "JHN.18.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JHN 18:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.7.14"
              },
              "items": [
                {
                  "text": "Yoa 7.14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.7.26"
              },
              "items": [
                {
                  "text": "26",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.10.27"
              },
              "items": [
                {
                  "text": "Mt 10.27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesũ amũsũngĩa, Nyie, nĩneenete ũtheinĩ na nthĩ; na namanyĩasya masinakokenĩ, na ĩkalũnĩ, kũla Ayuti onthe mombanĩaa; na ndyaaneena ndeto ya mbitha. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.20",
            "verseOrgIds": [
              "JHN.18.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JHN 18:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wĩngũlĩlya kĩ? Makũlye ala meewie, ũndũ naneenie namo: sisya, aa nimesĩ maũndũ ala naisye. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.21",
            "verseOrgIds": [
              "JHN.18.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JHN 18:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.19.3"
              },
              "items": [
                {
                  "text": "Yoa 19.3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.23.2"
              },
              "items": [
                {
                  "text": "Meko 23.2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na aneena ũu, ũmwe wa makanga aũngamĩte ũtee amũmandũla Yesũ, akyasya, Wĩmũsũngĩa mũthembi mũnene ũu? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.22",
            "verseOrgIds": [
              "JHN.18.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JHN 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesũ amũsũngĩa, Ethĩwa nĩnaneena naĩ, kũsĩĩa naĩ ĩsu: ĩndĩ ethĩwa nĩnaneena nesa, wĩngũnĩa kĩ? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.23",
            "verseOrgIds": [
              "JHN.18.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JHN 18:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ Anasi amũtwaa e mwove kwa ũla mũthembi mũnene, Kaiava.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.24",
            "verseOrgIds": [
              "JHN.18.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JHN 18:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.24",
            "verseOrgIds": [
              "JHN.18.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JHN 18:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Samoni Vetelo aũngeme aiota mwaki. Na ĩndĩ mamwĩa, Naku wĩ ũmwe wa amanyĩw’a make? Akaĩa, asya, Ndi ũmwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.25",
            "verseOrgIds": [
              "JHN.18.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JHN 18:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na imwe ya ngombo sya mũthembi mũnene, ya mbaĩ ya ĩla yatililwe kũtũ nĩ Vetelo, yasya. Ndinakwona wĩ nake mũũndanĩ? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.26",
            "verseOrgIds": [
              "JHN.18.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JHN 18:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ Vetelo akaĩa ĩngĩ: na kavinda o kaũ nzamba yasya.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.27",
            "verseOrgIds": [
              "JHN.18.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JHN 18:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.27",
            "verseOrgIds": [
              "JHN.18.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JHN 18:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ mamumaalya Yesũ kwa Kaiava mamũtwaa kĩsilĩlonĩ: na kwaĩ masangya; ĩndĩ mo ene maiaavota kĩsilĩloni, maikavukw’e nĩ kana maye vasaka. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.28",
            "verseOrgIds": [
              "JHN.18.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JHN 18:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Vilato aumaala nza kũla mai, na amakũlya, Mũmũvinganĩĩsye mũndũ ũũ kyaũ? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.29",
            "verseOrgIds": [
              "JHN.18.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JHN 18:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mamũsũngĩa, mamwĩa, Kethĩwa mũndũ ũũ ti mwĩk wa naĩ, tũiĩthĩwa twamũete kwaku. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.30",
            "verseOrgIds": [
              "JHN.18.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JHN 18:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.19.6"
              },
              "items": [
                {
                  "text": "Yoa 19.6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.19.7"
              },
              "items": [
                {
                  "text": "7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.18.15"
              },
              "items": [
                {
                  "text": "Meko 18.15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vilato amatavya, Mwosei inyw’ĩ, mũkamũsilĩle kwĩanana na mĩao yenyu. Na Ayuti mamwĩa, Ndwosana na ĩla mĩao thyĩ kũaa mũndũ: ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.31",
            "verseOrgIds": [
              "JHN.18.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JHN 18:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.12.32"
              },
              "items": [
                {
                  "text": "Yoa 12.32",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.12.33"
              },
              "items": [
                {
                  "text": "33",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.20.19"
              },
              "items": [
                {
                  "text": "Mt 20.19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "nĩ kana ndeto ya Yesũ yĩanĩw’e. Ĩla waneenie, aionan’ya kĩkw’ũ kĩla wĩkw’a.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.32",
            "verseOrgIds": [
              "JHN.18.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JHN 18:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.32",
            "verseOrgIds": [
              "JHN.18.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JHN 18:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ Vilato avota ĩngĩ kĩsilĩlonĩ, na amwĩta Yesũ na amũkũlya. We nue Mũsumbi wa Ayuti? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.33",
            "verseOrgIds": [
              "JHN.18.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JHN 18:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.16.13"
              },
              "items": [
                {
                  "text": "Mt 16.13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesũ asũngĩa, akyasya. Wĩneena ũu ũndũ waku kana nũtavitw’e nĩ andũ angĩ ũndũ wakwa? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.34",
            "verseOrgIds": [
              "JHN.18.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JHN 18:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.1.11"
              },
              "items": [
                {
                  "text": "Yoa 1.11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.21.39"
              },
              "items": [
                {
                  "text": "Mt 21.39",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vilato amũkũlya, Nyie nĩ Mũyuti? Mbaĩ yaku na athembi anene nĩmo makũete kwakwa: wĩkĩte ata? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.35",
            "verseOrgIds": [
              "JHN.18.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JHN 18:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesũ asũngĩa, Ũsumbi wakwa tĩ wa nthĩ ĩno, kethĩwa ũsumbĩ wakwa nĩ wa nthi ĩno, makanga makwa methĩwa makyũkita, nĩ kana ndikanenganwe kwa Ayuti: ĩndĩ yu ũsumbĩ wakwa ti wa kũũ. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.36",
            "verseOrgIds": [
              "JHN.18.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JHN 18:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.6.13"
              },
              "items": [
                {
                  "text": "1 Tim 6.13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.8.47"
              },
              "items": [
                {
                  "text": "Yoa 8.47",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.10.27"
              },
              "items": [
                {
                  "text": "10.27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ Vilato amwĩa, Ĩndĩ, we, ko wĩ mũsumbĩ? Yesũ amũsũngĩa, We nũũneena kana nĩ mũsumbĩ. Nyie nasyaiwe kwondũ wa ũu, na ĩngĩ nĩ kwondũ wa ũu nokie kũũ nthĩ, ni kana ndw’ĩke ngũsĩ ya ũla w’o. Kĩla mũndũ wĩ ngalĩ ya ũla w’o nĩwĩw’aa wasya wakwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.37",
            "verseOrgIds": [
              "JHN.18.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JHN 18:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vilato amũkũlya W’o nĩ kyaũ?",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.38",
            "verseOrgIds": [
              "JHN.18.38"
            ]
          }
        }
      ]
    }
