            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.13.19"
              },
              "items": [
                {
                  "text": "Yoa 13.19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na yu namũtavya ũtanamba kwĩkĩka, nĩ kana wekĩka, mwĩĩtĩkĩla. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.29",
            "verseOrgIds": [
              "JHN.14.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JHN 14:30"
          },
          "items": [
