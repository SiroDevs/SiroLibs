            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ethĩwa nĩmũmbendete, mũkakwataa mĩao yakwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.15",
            "verseOrgIds": [
