        },
        {
          "text": "Nakwa ngamũvoya Asa, nake akamũnenga Mũtetheesya ũngĩ, ethĩwe nenyu mavinda onthe, ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.16",
            "verseOrgIds": [
              "JHN.14.16"
            ]
          }
        },
