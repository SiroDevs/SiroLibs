                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kuma yu ndikaneena nenyu mũno, nũndũ mũnene wa nthĩ nũnũkũka: na nde na ũndũ nthĩnĩ wakwa; ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.30",
            "verseOrgIds": [
              "JHN.14.30"
            ]
          }
        },
