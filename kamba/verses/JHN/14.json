              "items": [
                {
                  "text": "Lk 24.52",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimweewie ũndũ namwĩie, Nĩngũthi, na ngooka vala mũĩ. Kethĩwa nĩmwambendie, mwĩthĩwa mwatana, nũndũ nĩngũthi kwa Asa: nũndũ Asa nĩ mũnene kwĩ nyie. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.28",
            "verseOrgIds": [
              "JHN.14.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JHN 14:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
