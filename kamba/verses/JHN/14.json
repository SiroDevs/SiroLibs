            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.6.16"
              },
              "items": [
                {
                  "text": "2 Ako 6.16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesũ asũngĩa na amwĩa, Ethĩwa mũndũ nũmbendaa, akakwataa ndeto yakwa: na Asa wakwa akamwenda, naitũ tũkooka vala ũĩ, tũtũae kwake. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.23",
            "verseOrgIds": [
              "JHN.14.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JHN 14:24"
          },
          "items": [
