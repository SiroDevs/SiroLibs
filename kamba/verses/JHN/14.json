          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.7.16"
              },
              "items": [
                {
                  "text": "Yoa 7.16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.2.5"
              },
              "items": [
                {
                  "text": "1 Yoa 2.5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ũla ũtambendaa ndakwataa ndeto syakwa; na ndeto ĩla mũkwĩw’a ti yakwa, ĩndĩ nĩ ya Asa ũla wandũmie.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.24",
            "verseOrgIds": [
              "JHN.14.24"
            ]
          }
        }
