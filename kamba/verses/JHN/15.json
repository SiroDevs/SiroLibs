            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ũla ũmenaa nyie amenaa Asa wakwa nake. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.23",
            "verseOrgIds": [
              "JHN.15.23"
