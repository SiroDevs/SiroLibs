            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kethĩwa ndyĩkĩte katĩ woo mawĩa ala mataaĩkwa nĩ mũndũ ũngĩ, maĩĩthĩwa na naĩ: ĩndĩ nĩmambonete na nĩmamenete vamwe na Asa wakwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.24",
            "verseOrgIds": [
              "JHN.15.24"
            ]
          }
        },
