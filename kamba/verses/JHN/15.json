                  "text": "Lk 6.22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kethĩwa mwĩ ma nthĩ, nthĩ ĩthĩwa ĩkyenda ala mayo: ĩndĩ nũndũ mũti ma nthĩ, ĩndĩ namũnyuvie kuma kwa ala ma nthĩ, kwondũ wa ũu nthĩ nĩnĩũmũmena. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.19",
            "verseOrgIds": [
              "JHN.15.19"
            ]
          }
        },
        {
          "name": "verse",
