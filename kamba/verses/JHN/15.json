                  "text": "Mt 10.24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lilikanai ndeto ĩla namũtavisye, ngombo ti nene kwĩ vwana wayo. Ethĩwa nĩmanthĩnisye, o nenyu makamũthĩn’ya; ethĩwa nĩmakwatie ndeto yakwa, yenyu nayo makamĩkwata. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.20",
            "verseOrgIds": [
              "JHN.15.20"
            ]
          }
        },
