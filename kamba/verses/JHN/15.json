              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ maũndũ aa onthe nĩmakamwĩka nũndũ wa syĩtwa yakwa, nũndũ maimwĩsĩ ũla wandũmie. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.21",
            "verseOrgIds": [
