          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kethĩwa ndyaaũka na nganeena namo, maiĩthĩwa na naĩ: ĩndĩ yu maitonya kwĩmila kwondũ wa naĩ yoo. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.22",
            "verseOrgIds": [
              "JHN.15.22"
            ]
          }
        },
