            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.7.7"
              },
              "items": [
                {
                  "text": "Yoa 7.7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.3.13"
              },
              "items": [
                {
                  "text": "1 Yoa 3.13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ethĩwa nthĩ nĩnĩũmũmena, nĩmwĩsĩ kana nĩyamenie nyie ĩtanamba kũmũmena inyw’ĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.18",
            "verseOrgIds": [
              "JHN.15.18"
            ]
          }
        },
        {
