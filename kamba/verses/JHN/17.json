                "loc": "JHN.11.41"
              },
              "items": [
                {
                  "text": "Yoa 11.41",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.13.1"
              },
              "items": [
                {
                  "text": "13.1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maũndũ asu Yesũ aneena; na ang’elelya metho make ĩtunĩ, na asya, Asa, saa nĩ mũviku; taĩa Mwana waku, nĩ kana ũ Mwana akũtaĩe; ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.1",
            "verseOrgIds": [
              "JHN.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JHN 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.11.27"
              },
              "items": [
                {
                  "text": "Mt 11.27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "o ũndũ wamũnengie ũkũmũ wa kwĩaĩa andũ onthe, nĩ kana onthe ala wamũnengĩe, amanenge thayũ ũtathela. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.2",
            "verseOrgIds": [
              "JHN.17.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JHN 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.5.20"
              },
              "items": [
                {
                  "text": "1 Yoa 5.20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TH.1.9"
              },
              "items": [
                {
                  "text": "1 Ath 1.9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na thayũ ũtathela nĩw’o ũũ, nĩ kana makũmanye we Ngai ũla wa w’o weka, na ũla wamũtũmie, nake nĩ Yesũ Klĩsto. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.3",
            "verseOrgIds": [
              "JHN.17.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JHN 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.4.34"
              },
              "items": [
                {
                  "text": "Yoa 4.34",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninĩkũtaĩĩte kũũ nthĩ, nũndũ nĩnĩminĩte kwĩka wĩa ũla wanengie nĩke. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.4",
            "verseOrgIds": [
              "JHN.17.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JHN 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.1.1"
              },
              "items": [
                {
                  "text": "Yoa 1.1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.17.24"
              },
              "items": [
                {
                  "text": "17.24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.2.6"
              },
              "items": [
                {
                  "text": "Avi 2.6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na yu, Asa, ndaĩĩthya vamwe naku, na ũtaĩo ũla naĩ naw’o vamwe naku nthĩ ĩtanamba ũtw’ĩkĩthw’a. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.5",
            "verseOrgIds": [
              "JHN.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JHN 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.17.9"
              },
              "items": [
                {
                  "text": "Yoa 17.9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.6.9"
              },
              "items": [
                {
                  "text": "Mt 6.9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩnamaumĩlĩlye syĩtwa yaku andũ ala wanengie kuma kwa ala ma nthĩ: maĩ maku, naku wanenga mo; na nĩmakwatiend to yaku. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.6",
            "verseOrgIds": [
              "JHN.17.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JHN 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na yu nĩmesĩ kana maũndũ onthe ala wanengie maumaa kwaku: ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.7",
            "verseOrgIds": [
              "JHN.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JHN 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.16.30"
              },
              "items": [
                {
                  "text": "Yoa 16.30",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "nũndũ ndeto ila wanengie nĩnĩmanengete; na nĩmasyosie, na nĩmamanyie w’o kana naumie kwakũ, na meetĩkĩla, aĩ, nue wandũmie. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.8",
            "verseOrgIds": [
              "JHN.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JHN 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.6.37"
              },
              "items": [
                {
                  "text": "Yoa 6.37",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.6.44"
              },
              "items": [
                {
                  "text": "44",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩngũmavoyea: ndiũmĩvoyea nthĩ, ĩndĩ nĩ ala wanengie; nũndũ nĩ maku: ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.9",
            "verseOrgIds": [
              "JHN.17.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JHN 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.16.15"
              },
              "items": [
                {
                  "text": "Yoa 16.15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.15.31"
              },
              "items": [
                {
                  "text": "Lk 15.31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "na syĩndũ syonthe ila syakwa nĩ syaku, na ila syaku nĩ syakwa: nakwa nĩndaĩawa nthĩnĩ wasyo. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.10",
            "verseOrgIds": [
              "JHN.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.10.30"
              },
              "items": [
                {
                  "text": "Yoa 10.30",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.6.13"
              },
              "items": [
                {
                  "text": "Mt 6.13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ndi kũũ nthĩ ĩngĩ, ĩndĩ aa me kũũ nthĩ, na nĩngũka kwaku. Asa Mũtheu, masũvĩe syĩtwanĩ yaku yĩla wanengie, nĩ kana methĩwe me ũmwe, o taitũ. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.11",
            "verseOrgIds": [
              "JHN.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JHN 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.6.39"
              },
              "items": [
                {
                  "text": "Yoa 6.39",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.41.9"
              },
              "items": [
                {
                  "text": "Sav 41.9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.109.8"
              },
              "items": [
                {
                  "text": "109.8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TH.2.3"
              },
              "items": [
                {
                  "text": "2 Ath 2.3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩvinda yĩla naĩ vamwe nao, nĩnamasũvĩaa syĩtwanĩ yaku yĩla wanengie: na nĩnamasyaĩĩasya, na vai ũmwe waaa ate o ũla mwana wa wanangĩko; nĩ kana maandĩko meanĩw’e. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.12",
            "verseOrgIds": [
              "JHN.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JHN 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.15.11"
              },
              "items": [
                {
                  "text": "Yoa 15.11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na yu nĩngũka kwaku; na maũndũ aa nĩneena kũu nthĩ, nĩ kana methĩwe na ũtanu wakwa wusũe, nthĩnĩ wamo. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.13",
            "verseOrgIds": [
              "JHN.17.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JHN 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.15.19"
              },
              "items": [
                {
                  "text": "Yoa 15.19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩnĩmanengete ndeto yaku; na nthĩ nĩyamamenie, nũndũ mo ti ma nthĩ, o ũndũ nyie ndi wa nthĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.14",
            "verseOrgIds": [
              "JHN.17.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JHN 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TH.3.3"
              },
              "items": [
                {
                  "text": "2 Ath 3.3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.5.18"
              },
              "items": [
                {
                  "text": "1 Yoa 5.18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.6.13"
              },
              "items": [
                {
                  "text": "Mt 6.13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.22.32"
              },
              "items": [
                {
                  "text": "Lk 22.32",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndiũvoya nĩ kana ũmaumye kũũ nthĩ, ĩndĩ nĩ kana ũmasũvĩe kwa ũsu mũthũku. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.15",
            "verseOrgIds": [
              "JHN.17.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JHN 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namo ti ma nthĩ, o ũndũ nyie ndi wa nthĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.16",
            "verseOrgIds": [
              "JHN.17.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JHN 17:17"
          },
          "items": [
            {
              "text": "17",
