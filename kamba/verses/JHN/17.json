              "items": [
                {
                  "text": "Yoa 6.63",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mavahe methĩwe atheu nthĩnĩ wa ũla w’o: ndeto yaku nĩyo w’o. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.17",
            "verseOrgIds": [
              "JHN.17.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JHN 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tondũ wandũmie kũũ nthĩ, o ta ũu nakwa nĩnamatũmie kũũ nthĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.18",
            "verseOrgIds": [
              "JHN.17.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JHN 17:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.10.10"
              },
              "items": [
                {
                  "text": "Aevl 10.10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kwondũ wamo nĩngwĩvatha, nĩ kana namo mavathanw’e methĩwe atheu nthĩnĩ wa ũla w’o. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.19",
            "verseOrgIds": [
              "JHN.17.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JHN 17:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.17.9"
              },
              "items": [
                {
                  "text": "Yoa 17.9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "O na ti asu oka ngũvoyea, ĩndĩ nĩmavoyea ala makambĩtĩkĩla nũndũ wa ndeto yoo; ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.20",
            "verseOrgIds": [
              "JHN.17.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JHN 17:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.3.28"
              },
              "items": [
                {
                  "text": "Aka 3.28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "nĩ kana onthe methĩwe me ũmwe; o ũndũ we, Asa, wĩ nthĩnĩ wakwa, nakwa nĩ nthĩnĩ waku, kana namo methĩwe me nthĩnĩ waitũ: nĩ kana nthĩ yĩtĩkĩle kana nĩwandũmie. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.21",
            "verseOrgIds": [
              "JHN.17.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JHN 17:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.4.32"
              },
              "items": [
                {
                  "text": "Meko 4.32",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ũtaĩo ũla wanengie nĩnĩmanengete w’o; nĩ kana methĩwe me ũmwe, o ũndũ ithyĩ twĩ ũmwe; ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.22",
            "verseOrgIds": [
              "JHN.17.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JHN 17:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.6.17"
              },
              "items": [
                {
                  "text": "1 Ako 6.17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.2.20"
              },
              "items": [
                {
                  "text": "Ako 2.20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "nyie nthĩnĩ woo, naku nthĩnĩ wakwa, kana methĩwe eanĩu nthĩnĩ wa ũmwe; nĩ kana nthĩ ĩmanye, aĩ, nĩwandũmie, na nĩwamendie o ũndũ wambendie. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.23",
            "verseOrgIds": [
              "JHN.17.23"
            ]
          }
        },
