            "sid": "2CH 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩvo ĩndĩ Solomoni wombanisye atumĩa ma Isilaeli, na atongoi onthe ma i mbaĩ, anene ma nyũmba sya aaĩthe ma ana ma Isilaeli, ku Yelusaleme, mambatye ĩsandũkũ ya ũtianĩo ya Yeova kumya ndũanĩ ya Ndaviti, nayo nĩ Saioni. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.2",
            "verseOrgIds": [
              "2CH.5.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
