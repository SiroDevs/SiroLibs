                "loc": "1KI.8.1+1KI.8.2+1KI.8.3+1KI.8.4+1KI.8.5+1KI.8.6+1KI.8.7+1KI.8.8+1KI.8.9"
              },
              "items": [
                {
                  "text": "1 Asu 8.1–9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
