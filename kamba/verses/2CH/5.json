            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.2",
            "verseOrgIds": [
              "2CH.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na andũ onthe ma Isilaeli moombana kwa mũsumbĩ mbokanĩ, ĩla yaĩ mwei wa mũonza. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.3",
            "verseOrgIds": [
              "2CH.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na atumĩa onthe ma Isilaeli mooka: na Alivai moosa ĩsandũkũ; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.4",
            "verseOrgIds": [
              "2CH.5.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.1.50"
              },
              "items": [
                {
                  "text": "Mot 1.50",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.8.3"
              },
              "items": [
                {
                  "text": "1 Asu 8.3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.4",
            "verseOrgIds": [
              "2CH.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "na mambatya ĩsandũkũ, na ĩeema ya kũmbanĩa, na mĩio yonthe mĩtheu ĩla yaĩ Ĩeemanĩ; ĩsu athembi Alivai mamyambatya. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.5",
            "verseOrgIds": [
              "2CH.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mũsumbĩ Solomoni na ũmbano w’onthe wa Isilaeli, ũla woombanĩte kwake waĩ mbee wa ĩsandũkũ, makĩthemba malondu na ng’ombe, ila itaĩ italĩka kana kũtalwa nũndũ wa kwingĩva. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.6",
            "verseOrgIds": [
              "2CH.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na athembi malikya ĩsandũkũ ya ũtianĩo ya Yeova nthĩnĩ vandũ vayo, nthĩnĩ wa vala vandũ va ũneenea va nyũmba, kũvika vala vandũ vatheu mbee, o ungu wa nthwau sya akeluvi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.7",
            "verseOrgIds": [
              "2CH.5.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.11.19"
              },
              "items": [
                {
                  "text": "Ũvu 11.19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.8.8"
              },
              "items": [
                {
                  "text": "1 Asu 8.8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.7",
            "verseOrgIds": [
              "2CH.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ akeluvi matambũũkĩtye nthwau syoo ĩũlũ wa vala vandũ va ĩsandũkũ, na akeluvĩ mayĩvw’ĩkĩte ĩsandũkũ ĩũlũ o na mĩtĩ yayo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.8",
            "verseOrgIds": [
              "2CH.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩ mĩtĩ yaĩ mĩasa ũndũ mĩthya ya mĩtĩ nĩyenekee kuma ĩsandũkũnĩ vu mbee wa vala vandũ va ũneenea; ĩndĩ ndĩaaoneka ũtee: na nĩvo ĩĩ kũvika ũmũnthĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.9",
            "verseOrgIds": [
              "2CH.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kũtyaĩ kĩndũ ĩsandũkũnĩ ate o ala masengea elĩ ala Mose wamekĩie ku Olevu, yĩla Yeova watianĩe ũtianĩo na ana ma Isilaeli, yĩla maumie nthĩ ya Misili. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.10",
            "verseOrgIds": [
              "2CH.5.10"
            ]
          }
        },
        {
