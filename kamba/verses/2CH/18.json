              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ Yeosavati aĩ na ũthwii na ndaĩa mbingĩ mũno; na atuma ndũũ ya kũtwaanĩa na Aavu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.1",
            "verseOrgIds": [
              "2CH.18.1"
            ]
          }
        },
        {
