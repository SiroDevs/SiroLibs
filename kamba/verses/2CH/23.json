              },
              "items": [
                {
                  "text": "Kũt 13.9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.17",
            "verseOrgIds": [
              "2CH.23.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yeoiata aia anene ma nyũmba ya Yeova kw’okonĩ kwa athembi Alivai, ala Ndaviti waiĩte nyũmbanĩ ya Yeova, mathembae nthembo sya kũvĩvw’a sya Yeova, o tondũ kũandĩkĩtwe mĩaonĩ ya Mose, makĩtana na kwĩna, kwĩanana na ũtw’ĩo wa Ndaviti. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.18",
            "verseOrgIds": [
              "2CH.23.18"
            ]
          }
        },
