            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ Aviya akoma na aaĩthe make, na mamũthika ndũanĩ ya Ndaviti; na Asa mwana wake asumbĩka vandũ vake. Mĩthenyanĩ yake nthĩ yaĩ na mũuo myaka ĩkũmi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.1",
            "verseOrgIds": [
              "2CH.14.1"
            ]
          }
        },
        {
          "name": "note",
