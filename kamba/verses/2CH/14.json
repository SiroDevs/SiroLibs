                "loc": "2CH.13.3"
              },
              "items": [
                {
                  "text": "2 Mav 13.3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
