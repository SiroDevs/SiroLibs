          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Asa eekaa ũla Yeova Ngai wake wonaa wĩ ũseo na ũlũngalu: ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.2",
            "verseOrgIds": [
              "2CH.14.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.15.11"
              },
              "items": [
                {
                  "text": "1 Asu 15.11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.2",
            "verseOrgIds": [
              "2CH.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "nũndũ nĩwavetie ithembeo ngeni, na kũla kũndũ kũtũlu, na atũlanga ituĩ, na atemanga Aselimu ĩvalũke, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.3",
            "verseOrgIds": [
              "2CH.14.3"
            ]
          }
        },
        {
