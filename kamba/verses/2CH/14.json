                {
                  "text": "Kuma 34.13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.15.13"
              },
              "items": [
                {
                  "text": "1 Asu 15.13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.15.14"
              },
              "items": [
                {
                  "text": "14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.15.17"
              },
              "items": [
                {
                  "text": "2 Mav 15.17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.3",
            "verseOrgIds": [
              "2CH.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "na eeaĩa Yuta mamanthe Yeova, Ngai wa aaĩthe moo, na kwĩkaa mĩao na myamũlo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.4",
            "verseOrgIds": [
              "2CH.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na aveta ndũanĩ syonthe sya Yuta kũla kũndũ kũtũlu na mĩvw’anano ya syũa: na ũsumbĩ waĩ na mũuo mbee wake. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.5",
            "verseOrgIds": [
              "2CH.14.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.26.30"
              },
              "items": [
                {
                  "text": "Ali 26.30",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.34.4"
              },
              "items": [
                {
                  "text": "2 Mav 34.4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.34.7"
              },
              "items": [
