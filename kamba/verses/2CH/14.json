          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.11",
            "verseOrgIds": [
              "2CH.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwondũ wa ũu Yeova akũnĩa Aethiovia mbee wa Asa, na mbee wa Yuta; na Aethiovia makũka. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.12",
            "verseOrgIds": [
              "2CH.14.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.13.15"
              },
              "items": [
                {
                  "text": "2 Mav 13.15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.12",
            "verseOrgIds": [
              "2CH.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Asa na andũ ala maĩ nake mamakũa kũvika Ngelali: na kwavalũkile Aethiovia aingĩ ũndũ mataatonya kwĩtethya; nũndũ nĩmaanangiwe nĩ Yeova, na nguthu yake; na matwaa mũtavo mwingĩ mũno. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.13",
            "verseOrgIds": [
              "2CH.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na makũna ndũa syonthe ila syathyũlũlũkĩte Ngelali; nũndũ w’ĩa waumĩte kwa Yeova nĩwamokĩe: na maananga ndũa syonthe; nũndũ kwaĩ mũtavo mwingĩ nthĩnĩ wasyo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.14",
            "verseOrgIds": [
              "2CH.14.14"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
