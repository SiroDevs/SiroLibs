          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ambĩlĩlya kwaka mũthenya wa kelĩ wa mwei wa kelĩ, mwaka wa kana wa kũsumbĩka kwake. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.2",
            "verseOrgIds": [
              "2CH.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ ĩno nĩyo myambĩlĩlyo ĩla Solomoni wakwatisye kwondũ wa kwaka nyũmba ya Ngai. Ũasa ũitalwa mĩkono kwĩanana na kĩthimi kya mbee waĩ mĩkono mĩongo thanthatũ, na ũthanthau, mĩkono mĩongo ĩlĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.3",
            "verseOrgIds": [
              "2CH.3.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.6.2"
              },
              "items": [
                {
                  "text": "1 Asu 6.2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.6.3"
              },
              "items": [
                {
                  "text": "3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.3",
            "verseOrgIds": [
              "2CH.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na valasya wa ĩ nyũmba, ũasa waw’o, kwĩanana na ũthanthau wa nyũmba, waĩ mĩkono mĩongo ĩlĩ, na ũtũlu mĩkono ĩana na mĩongo ĩlĩ; na oovw’ĩka nthĩnĩ thaavu mũtheu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.4",
            "verseOrgIds": [
              "2CH.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na nyũmba ĩla nene amĩseũvya nthĩnĩ na mbwaũ sya mĩtĩ ya mĩsonovali, ila wavw’ĩkie thaavu mũtheu, na aseũvĩĩsya ĩũlũ waw’o mĩtende na mĩnyololo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.5",
            "verseOrgIds": [
              "2CH.3.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.6.17"
              },
              "items": [
                {
                  "text": "1 Asu 6.17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.6.29"
              },
              "items": [
                {
                  "text": "29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.6.32"
              },
              "items": [
                {
                  "text": "32",
                  "type": "text"
                }
              ]
