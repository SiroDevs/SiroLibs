            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ethĩwa ngavinga matu matikausye mbua, kana ethĩwa ngeeaĩa ngie syanange nthĩ, kana ethĩwa ngaete mũimũ andũnĩ makwa; ",
          "type": "text",
