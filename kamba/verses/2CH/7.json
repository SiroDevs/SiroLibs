            "number": "12",
            "style": "v",
            "sid": "2CH 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yeova amumĩlĩla Solomoni ũtukũ, na amwĩa, Nĩnĩw’ĩte kũvoya kwaku, na nĩnĩnyũvie vandũ vaa vethĩwe nyũmba yakwa ya kũthembeaa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.12",
            "verseOrgIds": [
              "2CH.7.12"
            ]
          }
        },
        {
