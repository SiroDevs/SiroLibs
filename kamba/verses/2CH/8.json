          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ wĩa w’onthe wa Solomoni waseũviw’e kuma mũthenya wa wambĩlĩlyo wa nyũmba ya Yeova, o na kũvika yathela. Na ĩndĩ nyũmba ya Yeova yathela.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.16",
            "verseOrgIds": [
              "2CH.8.16"
            ]
          }
        }
      ]
