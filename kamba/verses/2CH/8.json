          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩvo ĩndĩ Solomoni wamũthembee Yeova nthembo sya kũvĩvw’a kĩthembeonĩ kya Yeova, kĩla wakĩte ngalĩ ya mbee ya valasya, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.12",
            "verseOrgIds": [
              "2CH.8.12"
            ]
          }
        },
