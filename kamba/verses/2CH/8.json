              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kweethĩwa ĩtina wa myaka mĩongo ĩlĩ yathela, ĩla Solomoni wakaa nyũmba ya Yeova, na nyũmba yake mwene, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.1",
            "verseOrgIds": [
              "2CH.8.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
