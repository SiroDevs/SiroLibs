          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ Solomoni atheea kuma vala vandũ vatũlu vaĩ Ngiveoni, kuma ngalĩ ya mbee ya ĩeema ya kũmbanĩa, kũvika Yelusaleme; na asumbĩka Isilaeli.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.13",
            "verseOrgIds": [
              "2CH.1.13"
            ]
          }
        }
