            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Solomoni mwana wa Ndaviti ongeleka vinya ũsumbĩnĩ wake, na Yeova Ngai wake aĩ vamwe nake, na amũnenevya mũno. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.1",
            "verseOrgIds": [
              "2CH.1.1"
            ]
          }
        },
        {
