        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Solomoni ambata kw’o kĩthembeonĩ kya ũthuku vala ve Yeova, kĩla kyaĩ ĩeemanĩ ya kũmbanĩa, na athemba nthembo ngili sya kũvĩvw’a ĩũlũ wakyo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.6",
            "verseOrgIds": [
              "2CH.1.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
