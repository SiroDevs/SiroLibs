                {
                  "text": "1 Asu 15.7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.11.20"
              },
              "items": [
                {
                  "text": "2 Mav 11.20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.2",
            "verseOrgIds": [
              "2CH.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Aviya akwatya kaũ na ita sya andũ ngũmbaũ sya kaũ, o andũ anyuve ngili maana ana: na Yelovoamu ataũsya ita okite nake e na andũ anyuve ngili maana nyanya, ala maĩ ngũmbaũ nene. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.3",
            "verseOrgIds": [
              "2CH.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Aviya aũngama kĩĩmanĩ kya Nzemalaimu, kĩla kĩ nthĩ yĩ iĩma ya Evalaimu, na asya, Mbĩthukĩĩsya, we Yelovoamu na Isilaeli onthe: ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.4",
            "verseOrgIds": [
              "2CH.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "mũtyaĩle kũmanya kana Yeova, Ngai wa Isilaeli, anengie Ndaviti asumbĩke Isilaeli tene na tene, o we, na ana make aitianĩa ũtianĩo wa mũnyũ? ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.5",
            "verseOrgIds": [
              "2CH.13.5"
            ]
          }
        },
