          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asumbĩka myaka ĩtatũ Yelusaleme: na syĩtwa ya inyia wake eetawa Mikaia mwĩĩtu wa Ulieli wa mũsyĩ wa Ngivea. Na kwaĩ kaũ katĩ wa Aviya na Yelovoamu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.2",
            "verseOrgIds": [
              "2CH.13.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
