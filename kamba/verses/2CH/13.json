        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kwoombanĩa kwake andũ mate kĩĩĩ, andũ athe, ala meeyĩkĩie ene vinya mokite na Leovoamu mwana wa Solomoni, yĩla Leovoamu waĩ wa mũika na waĩ na ngoo mbololo, na ndaatonya kũmasiĩĩa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.7",
            "verseOrgIds": [
              "2CH.13.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.20.1"
              },
              "items": [
                {
                  "text": "2 Sam 20.1",
