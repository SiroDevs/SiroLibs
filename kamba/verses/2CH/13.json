              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.9",
            "verseOrgIds": [
              "2CH.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ ngalĩ ĩ yaitũ, Yeova nĩ Ngai waitũ, na ithyĩ tũtyaamũtia; na twĩ na athembi ala mathũkũmaa Yeova, ana ma Aluni, na Alivai wĩanĩ woo: ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.10",
            "verseOrgIds": [
              "2CH.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "na mamũvĩvĩasya Yeova kĩla kĩoko na kĩla wĩoo nthembo sya kũvĩvw’a na ũvani ũla ũnyungaa nesa: o na imũtũ ila siĩawa Yeova maia nesa ĩũlũ wa mesa ntheu; na kĩndũ kya thaavu kĩla kĩkĩawa mataa vamwe na mataa makyo, makanae kĩla wĩoo: nũndũ nĩtũsũvĩaa wĩaĩo wa Yeova Ngai waitũ; ĩndĩ inyw’ĩ nĩmũmũtiĩte. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.11",
            "verseOrgIds": [
              "2CH.13.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
