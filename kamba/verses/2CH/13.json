              "attrs": {
                "loc": "2CH.15.8"
              },
              "items": [
                {
                  "text": "2 Mav 15.8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.19",
            "verseOrgIds": [
              "2CH.13.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "O na Yelovoamu ndaasyoka kwĩthĩwa na vinya ĩngĩ mĩthenyanĩ ya Aviya: na Yeova amũkũna, na akw’a. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.20",
            "verseOrgIds": [
              "2CH.13.20"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
