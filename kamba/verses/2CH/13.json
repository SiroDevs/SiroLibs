        },
        {
          "text": "Mwaka wa ĩkũmi na nyanya wa kũsumbĩka kwa Yelovoamu Aviya ambĩlĩlya kũsumbĩka Yuta. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.1",
