              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ Yelovoamu mwana wa Nevati, mũthũkũmi wa Solomoni mwana wa Ndaviti, ookĩla, na amũng’endea mwĩaĩi wake ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.6",
            "verseOrgIds": [
              "2CH.13.6"
            ]
          }
        },
        {
