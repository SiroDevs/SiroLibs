              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yu ĩndĩ nganũ na mbaale, mauta na mbinyu, ila mwĩaĩi wakwa ũwetete, natwaĩe athũkũmi make: ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.2.15",
            "verseOrgIds": [
              "2CH.2.15"
            ]
          }
        },
        {
