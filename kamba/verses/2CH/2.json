        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "O na ndetee mĩtĩ ya mĩkũũ, na ya mĩsonovali, na ya mĩsandali, kuma Levanoni; nũndũ nĩnĩsĩ athũkũmi maku nĩmesĩ kũtema mĩtĩ Levanoni. Na, sisya, athũkũmi makwa makeethĩwa na athũkũmi maku, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.2.8",
            "verseOrgIds": [
              "2CH.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "nĩ kana manzeũvĩsye mĩtĩ mingĩ mũno; nũndũ nyũmba ĩla nĩkilĩlye kwaka ĩkeethĩwa nene na ya ũseng’ya. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.2.9",
            "verseOrgIds": [
              "2CH.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na, sisya, nganenga athũkũmi maku, atemi ma mĩtĩ, ithimi ngili mĩongo ĩlĩ sya nganũ mbũe, na ithimi ngili mĩongo ĩlĩ sya mbaale, na vathi ngili mĩongo ĩlĩ sya mbinyu, na vathi ngili mĩongo ĩlĩ sya mauta.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.2.10",
            "verseOrgIds": [
              "2CH.2.10"
            ]
          }
        }
      ]
