                "loc": "1CH.22.15"
              },
              "items": [
                {
                  "text": "1 Mav 22.15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
