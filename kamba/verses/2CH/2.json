            }
          ]
        },
        {
          "text": "Na yu nĩnatũma mũndũ ndũĩka, wĩ na ũmanyi, wa ĩthe wakwa Ulamu, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.2.13",
