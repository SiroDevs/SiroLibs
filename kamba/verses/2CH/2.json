              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ nũũ ũtonya kũmwakĩa nyũmba, nũndũ ĩtu, na ĩtu yĩla yĩ ĩũlũ wa matu yĩtitonya kũmwĩanĩa? Nyie nĩ ũũ ĩndĩ, aĩ nĩmwakĩe nyũmba, ate o kũmũtoeeasya ũvani? ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.2.6",
            "verseOrgIds": [
              "2CH.2.6"
            ]
          }
        },
