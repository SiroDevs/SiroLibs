        {
          "text": "Na ĩndĩ Solomoni asũanĩa kwaka nyũmba kwondũ wa syĩtwa ya Yeova, na nyũmba kwondũ wa ũsumbĩ wake. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.2.1",
            "verseOrgIds": [
              "2CH.2.1"
            ]
