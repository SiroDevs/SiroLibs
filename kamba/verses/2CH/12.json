                {
                  "text": "2 Mav 11.2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.15.2"
              },
              "items": [
                {
                  "text": "15.2",
                  "type": "text"
                }
              ]
