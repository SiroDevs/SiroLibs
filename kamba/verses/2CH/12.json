                {
                  "text": "Kuma 9.27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.6",
            "verseOrgIds": [
              "2CH.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na yĩla Yeova wonie kana nĩmeenyivya, ndeto ya Yeova yamũkĩa Semaia, ĩkyasya, Nĩmenyivĩtye: ndimananga; ĩndĩ ngamanenga kovonoko kanini, na ũthilĩku wakwa ndwĩonow’a ĩũlũ wa Yelusaleme na kw’oko kwa Sisaki. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.7",
            "verseOrgIds": [
              "2CH.12.7"
            ]
          }
        },
