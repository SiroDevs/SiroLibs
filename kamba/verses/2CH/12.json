          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na eeka ũla waĩ ũthũku, nĩkwĩthĩwa ndaaelekelya ngoo yake amũmanthe Yeova.",
          "type": "text",
          "attrs": {
