            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sisya, ti ũndũ wa Yeova wa nguthu ngo sya andũ syĩthĩnĩa wĩa ũvĩvw’e nĩ mwaki, na mbaĩ ikĩnosya mana? ",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.13",
            "verseOrgIds": [
              "HAB.2.13"
            ]
          }
        },
