          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yeova anzũngĩa, na ambĩa, Andĩka woni masengeanĩ, wumĩlye nesa, nĩ kana ũla ũsomaa atonye kũsemba. ",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.2",
            "verseOrgIds": [
              "HAB.2.2"
            ]
          }
        },
