                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " mugume mugwereire; abaishiki ba Shiilo ku baraabe nibaza kuzina, mugurukye omu misiri y'emizaabibu, buri muntu ayekwatire omukazi omuri abo baishiki ba Shiilo; bwanyima mugarukye omu nsi ya Benyamiini. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.21.21",
            "verseOrgIds": [
              "JDG.21.21"
            ]
          }
        },
        {
