            "number": "22",
            "style": "v",
            "sid": "JDG 21:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baishebo nari banyaanyabo ku baraije kututonganaho, nitwija kubagira tuti: Mubatuhe ahabw'embabazi, ahabw'okuba buri muntu tituramunyagiire mukazi omu rugamba; kandi naimwe timurababahaire; kuri niimwe mwababahaire, mukaagizire orubanja. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.21.22",
            "verseOrgIds": [
              "JDG.21.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
