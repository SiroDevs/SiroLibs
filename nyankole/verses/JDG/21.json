                  "text": "Heb 13:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ku bwaseesire, abantu baimuka kare, baayombekayo eitambiro, baahonga ebitambo by'okwotsya n'empongano z'okusiima ahabw'obusingye. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.21.4",
            "verseOrgIds": [
              "JDG.21.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JDG 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.5.23"
              },
              "items": [
                {
                  "text": "Bar 5:23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.11.7"
              },
              "items": [
                {
                  "text": "1 Sam 11:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abaisraeli baabuuza bati: Omu nganda za Israeli otaizire mu iteeraniro ahari MUKAMA n'oha? Ahakuba bakaba barahiire endahiro ehamire aha muntu weena oriba ataizire Mizipa ahari MUKAMA, nibagira bati: Buzimazima aryaitwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.21.5",
            "verseOrgIds": [
              "JDG.21.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JDG 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaisraeli baayefuuza ahabw'Ababenyamiini beene waabo, nibagira bati: Eri izooba hariho oruganda orucwirwe omuri Israeli. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.21.6",
            "verseOrgIds": [
              "JDG.21.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbwenu tugire tuta okusherurira abaahonokireho abakazi, ku turaabe twarahiire ngu tituribahingira bahara baitu?",
          "type": "text",
          "attrs": {
            "verseId": "JDG.21.7",
            "verseOrgIds": [
              "JDG.21.7"
            ]
          }
        }
      ]
    },
