          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JDG 21:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baaragiira Ababenyamiini bati: Mwirooko muze omu misiri y'emizaabibu, ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.21.20",
            "verseOrgIds": [
              "JDG.21.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JDG 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
