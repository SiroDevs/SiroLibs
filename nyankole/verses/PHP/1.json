              "type": "text"
            }
          ]
        },
        {
          "text": "Ahabw'okwetegyereza ekyo, nimmanya ngu niinyija kugumaho, ntuure naimwe mwena, mubone kweyongyera omumaisho omu kwikiriza kandi n'okukushemerererwamu, ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.25",
            "verseOrgIds": [
              "PHP.1.25"
            ]
