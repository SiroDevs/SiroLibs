              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi mutarikutiinisibwa bazigu omu kigambo kyona; ekyo n'akamanyiso k'okuhwerekyerera aharibo akarikumanywa, kwonka ahariimwe n'ak'okujunwa kwanyu akarikuruga ahari Ruhanga. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.28",
            "verseOrgIds": [
