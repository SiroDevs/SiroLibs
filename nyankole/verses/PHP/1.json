              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "okwehimbisa kwanyu kubone kukanya omuri Kristo Yesu ahabwangye, ku ndiba naagarukire owaanyu. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.26",
            "verseOrgIds": [
              "PHP.1.26"
            ]
          }
        },
