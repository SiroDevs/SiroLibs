              "type": "text"
            }
          ]
        },
        {
          "text": " Ku baayeyetsire abanyabwengye, baahinduka ebifa-mutima; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.22",
            "verseOrgIds": [
