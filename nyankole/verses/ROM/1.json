                "loc": "1CO.6.9"
              },
              "items": [
                {
                  "text": "1 Kor 6:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kandi n'abashaija nabo baareka kukorera abakazi eby'obuhangwa, baabugumwamu okurigira okubi, abashaija baakora eby'obuhemu aha bandi bashaija, baihurwa omu mibiri yaabo ebishemereire obuhabe bwabo.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.27",
            "verseOrgIds": [
              "ROM.1.27"
            ]
          }
        }
      ]
