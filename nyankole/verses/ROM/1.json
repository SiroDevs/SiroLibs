          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi nk'oku baayangire kumanya Ruhanga omu mitima yaabo, Ruhanga nikyo yaabarekyeire kugira emitima etarikusiimwa, n'okukora ebitashemeire; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.28",
            "verseOrgIds": [
              "ROM.1.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ROM 1:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "baijuriire kimwe okutahikiirira kwona, obubi, omururu, n'okwangana; baijwire n'eihari, obwitsi, n'entongane, obugobya, n'eitima; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.29",
            "verseOrgIds": [
              "ROM.1.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ROM 1:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'abantu abahwihwitsa, n'abagambuura nibabeiha, abanga Ruhanga, abanyamaryo, abeemanya, abeekuza, abeecwera ebibi, abagomera abaabazaire, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.30",
            "verseOrgIds": [
              "ROM.1.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ROM 1:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "abateetegyereza, abaita endagaano, abatakunda bantu, abatasaasira. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.31",
            "verseOrgIds": [
              "ROM.1.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ROM 1:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo, n'obu bamanya orubanja oru Ruhanga acwera abakora nk'ebyo, ngu bashemereire kufa, tibabikora kwonka, kandi basiima n'ababikora.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.32",
