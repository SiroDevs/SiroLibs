            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.1.15"
              },
              "items": [
                {
                  "text": "Gal 1:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nyowe Paulo, omuhuuku wa Yesu Kristo, nkeetwa kuba entumwa, naashoroorerwa engiri ya Ruhanga, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.1",
            "verseOrgIds": [
              "ROM.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ROM 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ei yaaraganiise ira omu kanwa ka baanabi be omu Byahandiikirwe ebirikweta; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.2",
            "verseOrgIds": [
              "ROM.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ROM 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.22.42"
              },
              "items": [
                {
                  "text": "Mat 22:42",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " engiri egyo niyo emanyisa eby'Omwana we owaazairwe omuri baijukuru ba Daudi omu mubiri, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.3",
            "verseOrgIds": [
              "ROM.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ROM 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.13.33"
              },
              "items": [
                {
                  "text": "Byak 13:33",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kandi akaoorekwa n'amaani ku ari Omwana wa Ruhanga ahabw'okuzooka omu bafu, nk'oku Omwoyo Orikwera yaaragwire, Ogwo niwe Yesu Kristo Mukama waitu. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.4",
            "verseOrgIds": [
              "ROM.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ROM 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.2.7"
              },
              "items": [
                {
                  "text": "Gal 2:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.2.9"
              },
              "items": [
                {
                  "text": "9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Niwe yaatuhaisize embabazi n'okuba entumwa ez'okureetera ab'omu mahanga goona okworobera owkeikiriza ahabw'eiziina rye; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.5",
            "verseOrgIds": [
              "ROM.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ROM 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi naimwe muri omuri abo abaayetsirwe kuba aba Yesu Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.6",
            "verseOrgIds": [
              "ROM.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ROM 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbwenu iwme ab'omuri Rooma, abarikukundwa Ruhanga, kandi abaayetsirwe kuba abarikwera, naabahandiikira. Nimbendeza embabazi n'obusingye ebirikuruga ahari Ruhanga Tataitwe, na Mukama waitu Yesu Kristo.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.7",
            "verseOrgIds": [
              "ROM.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ROM 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.7",
            "verseOrgIds": [
              "ROM.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ROM 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okubanza ninsiima Ruhanga wangye omuri Yesu Kristo ahabwanyu mwena, ahabw'okuba okwikiriza kwanyu nikugambwa omu nsi zoona. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.8",
            "verseOrgIds": [
              "ROM.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ROM 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.1.16"
              },
              "items": [
                {
                  "text": "Efe 1:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ruhanga, ou mpeereza omu mutima gwangye omu ngiri n'Omwana we, niwe kareebi wangye orikuhamya ku mbaijuka obutoosha omu kushaba kwangye, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.9",
            "verseOrgIds": [
              "ROM.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ROM 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.15.23"
              },
              "items": [
                {
                  "text": "Rom 15:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ngu, ku kiraabe nikibaasika hati ahabw'okukunda kwa Ruhanga, aha muheru gwa byona aikirize kundeeta n'obusingye, ampitsye owaanyu, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.10",
            "verseOrgIds": [
              "ROM.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ROM 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "ahakuba mbainiire orushusho ngu mbone kubaha omugisha gw'Omwoyo, gubagumye; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.11",
            "verseOrgIds": [
              "ROM.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ROM 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "nikwo kugira ngu tugumyane, nyowe ngumibwe okwikiriza kwanyu, naimwe okwangye. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.12",
            "verseOrgIds": [
              "ROM.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ROM 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "B'eishe-emwe, niinyenda ku mumanya ngu kaingi nkenda kwija owaanyu, ngu ndeebe n'omuriimwe ebyana, nk'oku naabireebire omu Banyamahanga abandi; kwonka hariho ebyanzibiire n'okuhitsya hati. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.13",
            "verseOrgIds": [
              "ROM.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ROM 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abagriika n'ab'amahanga agandi, abanyabwengye n'abatabwine, mbaineho eibanja; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.14",
            "verseOrgIds": [
              "ROM.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ROM 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'ahabw'ekyo nyowe ahabwangye ninkunda munonga kubabuurira engiri naimwe ab'omuri Rooma. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.15",
            "verseOrgIds": [
              "ROM.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ROM 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.1.18"
              },
              "items": [
                {
                  "text": "1 Kor 1:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.1.24"
              },
              "items": [
                {
                  "text": "24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ahakuba engiri terikunkwatsa nshoni, ahabw'okuba nigo maani ga Ruhanga, agahaisa orikwikiriza weena okujunwa, okubandiza aha Bayudaaya, kandi n'aha Bagriika. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.16",
            "verseOrgIds": [
              "ROM.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ROM 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HAB.2.4"
              },
              "items": [
                {
                  "text": "Hab 2:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ahakuba omu ngiri egyo okuhikiirira okurikuruga ahari Ruhanga nimwo kushuuruurirwa okuheebwa ahabw'okwikiriza, kukagumizamu omu kwikiriza, nk'oku kyahandiikirwe ngu: Ohikiriire aryaba ohuriire ahabw'okwikiriza.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.17",
            "verseOrgIds": [
              "ROM.1.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
