                "loc": "EPH.1.11"
              },
              "items": [
                {
                  "text": "Efe 1:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nitumanya ngu, aha barikukunda Ruhanga, bakeetwa nk'enaama ye oku eri, byona ebibabaho bikwatanisiza hamwe kubareetera oburungi. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.28",
            "verseOrgIds": [
              "ROM.8.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ROM 8:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.1.18"
              },
              "items": [
                {
                  "text": "Kol 1:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ahakuba abu yaamanyire ira, nibo yaashoroire batakabaireho kushushanisibwa n'Omwana we, ngu abone kuba omujigaijo omu b'eishe-emwe baingi. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.29",
            "verseOrgIds": [
              "ROM.8.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ROM 8:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu yaashoroire batakabaireho, nibo yaayetsire; n'abu yaayetsire, nibo yaihireho orubanja; kandi n'abu yaihireho orubanja, nibo yaahaire ekitiinisa.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.30",
            "verseOrgIds": [
              "ROM.8.30"
            ]
          }
        }
      ]
