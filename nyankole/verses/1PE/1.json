                {
                  "text": "Yak 1:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nyowe Petero, entumwa ya Yesu Kristo, naabahandiikira imwe abaanyagirwe, mukataataanira omuri Ponto, Galatia, Kapadokia, Asia na Bitunia, ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.1",
            "verseOrgIds": [
              "1PE.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1PE 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.12.24"
              },
              "items": [
                {
                  "text": "Heb 12:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " abaatoorainwe Ruhanga Isheboona, nk'oku yaabamanyire ira, mukeezibwa Omwoyo, ngu mworobere Yesu Kristo, kandi ngu mumiisiirwe eshagama ye. Embabazi n'obusingye bikanye omuriimwe.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.2",
            "verseOrgIds": [
              "1PE.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1PE 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.2",
            "verseOrgIds": [
              "1PE.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1PE 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ruhanga, Ishe wa Mukama waitu Yesu Kristo, asiimwe! Ahabw'embabazi ze nyingi akatuzaara obwa kabiri ngu tugire amatsiko agatahwaho ahabw'okuzooka omu bafu kwa Yesu Kristo; ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.3",
            "verseOrgIds": [
              "1PE.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1PE 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngu tutungye obuhunguzi obutarikubaasa kuhwerekyerera, obutarikusiisikara, kandi obutarikuhunduuka, obwababiikiirwe omu iguru, ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.4",
            "verseOrgIds": [
              "1PE.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1PE 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.2.5"
              },
              "items": [
                {
                  "text": "1 Kor 2:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " imwe abarindwa amaani ga Ruhanga ahabw'okwikiriza, murindiirwe okujunwa okurishuuruurwa aha kiro ky'aha mperu. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.5",
            "verseOrgIds": [
              "1PE.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1PE 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.12.11"
              },
              "items": [
                {
                  "text": "Heb 12:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JAS.1.2"
              },
              "items": [
                {
                  "text": "Yak 1:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ebyo nimubishemerererwa, n'obu muraabe hati mushemereire kumara akaanya kakye nimushaasha ahabw'okugyezibwa okw'emiringo mingi, ku kiraabe nikyetengwa, ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.6",
            "verseOrgIds": [
              "1PE.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1PE 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.17.3"
              },
              "items": [
                {
                  "text": "Enf 17:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.4.12"
              },
              "items": [
                {
                  "text": "1 Pet 4:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ngu okwikiriza kwanyu kuhamibwe ku kuri okw'amazima, kandi ku kurikukiza ezaabu obuguzi bwingi (mumanye ngu ezaabu, n'obu eraabe eri erikuhwaho, ehamibwa yaagyezibwa omu muriro) kandi okugyezibwa kw'okwikiriza kwanyu kubareetere okusiimwa n'ekitiinisa n'okuhimbusibwa aha kushuuruurwa kwa Yesu Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.7",
            "verseOrgIds": [
              "1PE.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1PE 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.20.29"
              },
              "items": [
                {
                  "text": "Yoh 20:29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ogwo mumukunda, mutakamureebaga; kandi n'obu muraabe mutarikumureeba hati, nimumwikiriza, mumushemerererwa n'okwesiima okutarikubaasa kushoboororwa okwine ekitiinisa kingi, ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.8",
            "verseOrgIds": [
              "1PE.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1PE 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "nimuheebwa okujunwa kw'amagara gaanyu, nk'ebihembo by'okwikiriza kwanyu.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.9",
            "verseOrgIds": [
              "1PE.1.9"
            ]
          }
        }
      ]
    },
