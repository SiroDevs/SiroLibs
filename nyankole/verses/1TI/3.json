                "loc": "1CO.5.9"
              },
              "items": [
                {
                  "text": "1 Kor 5:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
