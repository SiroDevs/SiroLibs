                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " MUKAMA ku yaabaire ari haihi kutwara Eliya omu iguru n'omuyaga gw'akasooroora, Eliya na Elisa bakaba bari omu muhanda nibaruga Gilugaali. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.1",
