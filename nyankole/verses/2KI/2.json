          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'ahabw'ekyo ago maizi gaashemera okwiha obwo n'okuhitsya eri izooba, nk'ekigambo eki Elisa yaagambire oku kyabaire kiri.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.22",
