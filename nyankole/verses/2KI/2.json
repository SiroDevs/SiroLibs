              "2KI.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "RUT.1.15"
              },
              "items": [
                {
                  "text": "Rus 1:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "RUT.1.16"
              },
              "items": [
                {
                  "text": "16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Eliya yaagira Elisa ati: Ninkweshengyereza, guma aha; ahakuba MUKAMA yantuma Beseeli. Kwonka Elisa yaagira ati: Nindahira MUKAMA, kandi ninkurahira, tindikwija kukurugaho. Batyo baashuuma, baaza Beseeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.2",
            "verseOrgIds": [
              "2KI.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.4.1"
              },
              "items": [
                {
                  "text": "2 Bag 4:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.4.38"
              },
              "items": [
                {
                  "text": "38",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abaana ba baanabi, abaabaire bari Beseeli, baashohora, baashanga Elisa, baamugira bati: Noomanya ku eri izooba MUKAMA arikwija kutwara mukama waawe, akamukwihaho? Onu ati: Eego ninkimanya; kwonka, nimwetsize.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.3",
            "verseOrgIds": [
              "2KI.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
