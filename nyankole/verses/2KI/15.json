              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbwenu endiijo mirimo ya Peeka n'ebi yaakozire byona bikahandiikwa omu kitabo ky'eby'omu busingye bw'abagabe ba Israeli. ",
          "type": "text",
          "attrs": {
