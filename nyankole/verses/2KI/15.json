                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yaakora ebirikwangwa MUKAMA, tiyaareka bibi bya Yeroboamu mwene Nebati, ebi yaasiisiise Israeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.24",
            "verseOrgIds": [
              "2KI.15.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 15:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima Peeka mwene Remalia, omukru w'engabo ze, yaamugiira omu naama, yaamwitira Samaria omu kigo ky'omu kikaari ky'omugabe. Ku yaaherize kumwita, yaategyeka omu mwanya gwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.25",
            "verseOrgIds": [
              "2KI.15.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbwenu endiijo mirimo ya Pekahia n'ebi yaakozire byona, bikahandiikwa omu kitabo ky'eby'omu busingye bw'abagabe ba Israeli.",
          "type": "text",
          "attrs": {
