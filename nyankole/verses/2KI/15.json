          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu mwaka gwa kabiri ogw'omu busingye bwa Peeka mwene Remalia omugabe wa Israeli Yosamu mwene Uziya omugabe wa Yuda akatandika kutegyeka. ",
          "type": "text",
