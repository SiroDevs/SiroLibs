                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mbwenu endiijo mirimo ya Manaase, n'ebi yaakozire byona, n'ekibi eki yaakozire, tibihandiikirwe omu kitabo ky'eby'omu busingye bw'abagabe ba Yuda? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.17",
            "verseOrgIds": [
