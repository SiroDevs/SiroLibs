            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yaakora ebirikwangwa MUKAMA nka Manaase ishe. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.20",
            "verseOrgIds": [
              "2KI.21.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
