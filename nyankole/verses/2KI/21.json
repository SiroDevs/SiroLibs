              },
              "items": [
                {
                  "text": "2 Bus 33:20-25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Manaase yaagwejegyera, yaashanga baishenkuru, yaaziikwa omu musiri gw'aha nju ye, ogwa Uzza; Amoni omutabani yaategyeka omu mwanya gwe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.18",
            "verseOrgIds": [
              "2KI.21.18"
            ]
          }
        }
