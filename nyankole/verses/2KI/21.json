              "items": [
                {
                  "text": "2 Sam 7:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kandi Abaisraeli ku barita omutima aha kworobera ebi naabaragiire byona, n'ebi omwiru wangye Musa yaabaragiire, tindigaruka kubazengyereza kubaiha omu nsi ei naahaire baishenkurubo. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.8",
            "verseOrgIds": [
              "2KI.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonka tibaahurira, kandi Manaase yaababeihabeiha kukora ebibi ebirikukira obubi ebi amahanga gaakozire, agu MUKAMA yaacwekyerereize omu maisho g'Abaisraeli.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.9",
            "verseOrgIds": [
              "2KI.21.9"
