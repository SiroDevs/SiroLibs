          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amoni akaba aine emyaka makumi abiri n'ebiri, obu yaatandika kutegyeka, yaategyekyera emyaka ebiri omuri Yerusaalemu, Nyina akaba naayetwa Meshulemeesi, muhara wa Haruzi owa Yotiba. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.19",
            "verseOrgIds": [
              "2KI.21.19"
            ]
          }
        },
