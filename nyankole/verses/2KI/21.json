                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka yaakora ebirikwangwa MUKAMA, naatooreza emicwe erikunugwa ey'abanyamahanga, abu MUKAMA yaabingire omu maisho g'Abaisraeli; ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.2",
            "verseOrgIds": [
              "2KI.21.2"
            ]
          }
