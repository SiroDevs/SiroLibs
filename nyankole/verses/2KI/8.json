            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima yaahurura na Yoramu mwene Ahabu kurwanisa Hazaeli omugabe wa Siria omuri Ramosi-gileadi. Abasiria baahutaarizayo Yoramu. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.28",
