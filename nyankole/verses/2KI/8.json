              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.24",
            "verseOrgIds": [
              "2KI.8.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 8:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu mwaka gwa ikumi n'ebiri ogw'omu busingye bwa Yoramu mwene Ahabu omugabe wa Israeli, Ahazia mwene Yerohaamu omugabe wa Yuda akatandika kutegyeka. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.25",
            "verseOrgIds": [
              "2KI.8.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 8:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahazia akaba ahikize emyaka makumi abiri n'ebiri, obu yaatandika kutegyeka. Yaategyekyera omwaka gumwe omuri Yerusaalemu; kandi eiziina rya nyina akaba ari Atalia, mwijukuru wa Omuri omugabe wa Israeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.26",
            "verseOrgIds": [
              "2KI.8.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 8:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawe yaagyendera omu mitwarize y'ab'enju ya Ahabu, yaakora ebirikwangwa MUKAMA, nk'ab'enju ya Ahabu oku baakozire; ahabw'okuba akaba ari mukwe w'ab'enju ya Ahabu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.27",
            "verseOrgIds": [
              "2KI.8.27"
            ]
          }
        }
      ]
    },
