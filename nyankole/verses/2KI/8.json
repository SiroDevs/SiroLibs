              },
              "items": [
                {
                  "text": "Hag 1:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi Elisa akaba agambiire omukazi, ou yaazoire omwana we ati: Imuka ogyende, iwe n'ab'eka yaawe, oshuhuukire ahu orikubaasa hoona; ahabw'okuba MUKAMA aragiire enjara kuteera, kandi neija kumara omu nsi emyaka mushanju. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.1",
            "verseOrgIds": [
              "2KI.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukazi yaimuka, yaakora nk'oku omushaija wa Ruhanga yaamugambiire; yaagyenda n'ab'eka ye, yaashuhuukira omu nsi y'Abafilistia okumara emyaka mushanju. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.2",
            "verseOrgIds": [
              "2KI.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emyaka mushanju ku yaahweire, ogwo mukazi yaagaruka naaruga omu nsi y'Abafilistia, yaaza owa omugabe kumwetongyeza ahabw'enju ye n'obutaka bwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.3",
            "verseOrgIds": [
              "2KI.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.4.12"
              },
              "items": [
                {
                  "text": "2 Bag 4:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi obwo omugabe akaba naagaaniira na Gehazi omuheereza w'omushaija wa Ruhanga, naagira ati: nteekyerereza ebikuru byona ebi Elisa yaakozire. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.4",
            "verseOrgIds": [
              "2KI.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.4.35"
              },
              "items": [
                {
                  "text": "2 Bag 4:35",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ku yaabaire naakiteekyerereza omugabe oku Elisa yaahimbwire ofiire, omukazi ou yaahimbwire omutabani, yaija yaayetongyeza omugabe ahabw'enju ye n'obutaka bwe. Gehazi yaagira ati: Mukama wangye omugabe, ogu niwe mukazi n'ogu niwe mutabani ou Elisa yaahimbwire. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.5",
            "verseOrgIds": [
              "2KI.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi omugabe ku yaabuurize ogwo mukazi, nawe yaabimushobororera. Atyo omugabe yaamukwatsa omwe aha batware be, yaamugira ati: Omugarurire ebye byona, n'ebyayezire omu misiri ye okwiha obu yaaruga omuri egi nsi n'okuhitsya hati.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.6",
            "verseOrgIds": [
              "2KI.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.6",
            "verseOrgIds": [
              "2KI.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 8:7"
          },
          "items": [
            {
              "text": "7",
