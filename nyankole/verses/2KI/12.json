                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.29.9"
              },
              "items": [
                {
                  "text": "1 Bus 29:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yoasi yaagambira abanyamurwa ati: Empiiha zoona ez'ebintu ebishoroirwe ezireetsirwe omu nju ya MUKAMA, n'empiiha z'abantu boona, nk'oku buri muntu arikucwerwa, kandi n'empiiha ezi omuntu weena arikwesiimira kureeta omu nju ya MUKAMA aihire aha mutima, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.4",
            "verseOrgIds": [
              "2KI.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "abanyamurwa bazitware, buri omwe aziihe ahari mugyenzi we, bazihunduuze enju, ahi esiisikaire hoona. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.5",
            "verseOrgIds": [
              "2KI.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonka okuhitsya omu mwaka gwa makumi ashatu ogw'omu busingye bwa Yoasi, abanyamurwa bakaba bataine ki baahundwize kyona ahari egyo nju. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.6",
            "verseOrgIds": [
              "2KI.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikyo omugabe Yoasi yaatumiire Yehoyaada omunyamurwa n'abandi banyamurwa, akababuuza ati: Ahabw'enki mutarikuhunduuza enju? Mbwenu murekyere ahao kwiha empiiha ahari bagyenzi baanyu, kureka muziheyo ahabw'okuhunduuza enju. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.7",
            "verseOrgIds": [
              "2KI.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batyo abanyamurwa baikiriza kutagaruka kwiha empiiha aha bantu, n'obu kwakuba okuhunduuza enju.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.8",
            "verseOrgIds": [
              "2KI.12.8"
            ]
          }
        }
      ]
    },
