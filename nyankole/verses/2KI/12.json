                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.21.1"
              },
              "items": [
                {
                  "text": "Luk 21:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima Yehoyaada omunyamurwa yaareeta eshanduukye, yaafumura ekifundikizo kyayo, yaagita haihi n'eitambiro aha rubaju rwa buryo omuntu yaaba naataaha omu nju ya MUKAMA; kandi abanyamurwa abaabaire barinda eirembo baaguma nibatamu empiiha zoona ezaabaire nizireetwa omu nju ya MUKAMA. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.9",
            "verseOrgIds": [
              "2KI.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku baabaire bareeba empiiha zaaba nyingi omuri egyo shanduukye, omuhandiiki w'omugabe n'omunyamurwa omukuru baija, bazibara, bazikoma omu nshaho, zoona ezi bashanga omu nju ya MUKAMA. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.10",
            "verseOrgIds": [
              "2KI.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima ezo mpiiha ezi babazire baziha abakozi abarikureeberera enju ya MUKAMA; nabo baziha ababaizi n'abombeki abarikukora egyo nju, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.11",
            "verseOrgIds": [
              "2KI.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.22.5"
              },
              "items": [
                {
                  "text": "2 Bag 22:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.22.6"
              },
              "items": [
                {
                  "text": "6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " n'abarikwombekyesa amabaare, n'abarikugashara; ezindi bazihayo kugura embaaho n'amabaare agabaizire eby'okuhunduuza enju ya MUKAMA, n'ahabw'ebindi byona ebirikwetengwa kuhunduuza egyo nju. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.12",
            "verseOrgIds": [
              "2KI.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.7.50"
              },
              "items": [
                {
                  "text": "1 Bag 7:50",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.24.14"
              },
              "items": [
                {
                  "text": "2 Bus 24:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka ezo mpiiha ezi baabaire bareeta omu nju ya MUKAMA tibarazikoreise bikopo by'efeeza, nari makansi z'entambi, nari enyabya, nari amakondere, n'obu byakuba ebindi bintu by'ezaabu nari eby'efeeza, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.13",
            "verseOrgIds": [
              "2KI.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "kureka zo bakaba baziha abakozi abarikuzikoresa enju ya MUKAMA. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.14",
            "verseOrgIds": [
              "2KI.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.22.7"
              },
              "items": [
                {
                  "text": "2 Bag 22:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi abo bashaija abu baabaire baha empiiha z'okwihura abakozi, bakaba batababuuza oku zikoresiibwe, ahabw'okuba bakaba bazikoresa n'obwesigwa. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.15",
            "verseOrgIds": [
              "2KI.12.15"
            ]
          }
        },
        {
