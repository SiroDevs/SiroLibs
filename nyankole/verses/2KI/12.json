        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu mwaka gwa mushanju ogw'omu busingye bwa Yehu, Yoasi akatandika kutegyeka, yaategyekyera omuri Yerusaalemu emyaka makumi ana. Eiziina rya nyina akaba ari Zibia owa Beeri-sheba. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.1",
            "verseOrgIds": [
              "2KI.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoasi yaakora ebirikusiimwa MUKAMA ebiro byona ebi yaamazire naahaburwa Yehoyaada omunyamurwa. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.2",
            "verseOrgIds": [
              "2KI.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.15.14"
              },
              "items": [
                {
                  "text": "1 Bag 15:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.22.43"
              },
              "items": [
                {
                  "text": "22:43",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.14.4"
              },
              "items": [
                {
                  "text": "2 Bag 14:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.15.35"
              },
              "items": [
                {
                  "text": "15:35",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka emyanya mikuru ey'okuramizamu teraihirweho, kureka abantu bakagumizamu nibgitambiramu ebitambo, kandi nibootereramu obubaane.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.3",
            "verseOrgIds": [
              "2KI.12.3"
            ]
          }
        }
      ]
    },
