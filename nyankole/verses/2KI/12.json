            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.18.19"
              },
              "items": [
                {
                  "text": "Kub 18:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Empiiha z'empongano z'okwihaho orubanja, n'ez'empongano z'ekibi zikaba zitareetwa mu nju ya MUKAMA; zikaba ziba ez'abanyamurwa.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.16",
            "verseOrgIds": [
              "2KI.12.16"
            ]
          }
        }
