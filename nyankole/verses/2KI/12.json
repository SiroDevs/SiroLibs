              },
              "items": [
                {
                  "text": "Kur 35:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.22.4+2KI.22.5+2KI.22.6"
              },
              "items": [
