              },
              "items": [
                {
                  "text": "20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka abaana b'abo baitsi abaitsire ishe tiyaabaita, nk'oku kyahandiikirwe omu kitabo ky'ebiragiro bya Musa, eki MUKAMA yaaragiriiremu ati: Baishe b'abaana batariitwa nibaturwa abaana baabo; kandi n'abaana batariitwa nibaturwa baishebo; kureka omuntu weena aryaitwa ahabw'ekibi kye.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.6",
            "verseOrgIds": [
              "2KI.14.6"
            ]
          }
        }
      ]
