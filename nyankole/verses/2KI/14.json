                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omu mwaka gwa kabiri ogw'omu busingye bwa Yehoashi mwene Yehoahazi omugabe wa Israeli, Amazia mwene Yoasi omugabe wa Yuda akatandika kutegyeka.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.1",
