              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " N'ekya buzima oteire Abanyaedomu waabasingura, omutima gwawe gwakureetera eigundu. Yehimbise ahabw'ekitiinisa kyawe, kwonka ogume omuka; ahabw'enki nootaara akabi, ngu ofe na Yuda?",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.10",
            "verseOrgIds": [
              "2KI.14.10"
            ]
