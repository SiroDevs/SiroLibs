                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mbwenu endiijo mirimo ya Yehoashi, n'ebi yaakozire n'eby'amaani ge, n'oku yaarwaine na Amazia omugabe wa Yuda, tibihandiikirwe omu kitabo ky'eby'omu busingye bw'abagabe ba Israeli? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.15",
            "verseOrgIds": [
              "2KI.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehoashi yaagwejegyera, yaashanga baishenkuru, yaaziikwa omuri Samaria hamwe n'abagabe ba Israeli. Bwanyima Yeroboamu omutabani yaategyeka omu mwanya gwe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.16",
            "verseOrgIds": [
              "2KI.14.16"
            ]
          }
        }
      ]
    },
    {
