                "loc": "2KI.12.21"
              },
              "items": [
                {
                  "text": "2 Bag 12:21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.13.10"
              },
              "items": [
                {
                  "text": "13:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.1",
            "verseOrgIds": [
              "2KI.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaatandika kutegyeka aine emyaka makumi abiri n'etaano, yaamara emyaka makumi abiri na mwenda ari aha ngoma omuri Yerusaalemu. Eiziina rya nyina akaba ari Yehoadaani owa Yerusaalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.2",
            "verseOrgIds": [
              "2KI.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaakora ebirikusiimwa MUKAMA, kwonka tiyaaba nka ishenkuru Daudi; kureka yaakora nk'ebi Yoasi ishe yaakozire byona. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.3",
            "verseOrgIds": [
              "2KI.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.12.3"
              },
              "items": [
                {
                  "text": "2 Bag 12:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka emyanya mikuru ey'okuramizamu tiyaihwaho; abantu baaguma nibagitambiramu ebitambo, kandi nibagyotereramu obubaane. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.4",
            "verseOrgIds": [
              "2KI.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.12.20"
              },
              "items": [
                {
                  "text": "2 Bag 12:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima ku yaaherize kuhama omu bugabe bwe, yaita abashaija be abaitsire ishe ari aha ngoma. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.5",
            "verseOrgIds": [
              "2KI.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.24.16"
              },
              "items": [
                {
                  "text": "Bir 24:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.31.30"
              },
              "items": [
                {
                  "text": "Yer 31:30",
