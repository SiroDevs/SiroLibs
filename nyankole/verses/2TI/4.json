                "loc": "PHP.2.17"
              },
              "items": [
                {
                  "text": "Fil 2:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ahakuba na mbwenu nyowe ndi haihi kutambwa nk'empongano y'eby'okunywa eshukwa aha itambiro, kandi obunaku bwangye bw'okuruga omu nsi bwiriire haihi. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.6",
            "verseOrgIds": [
              "2TI.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2TI 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.6.12"
              },
              "items": [
                {
                  "text": "1 Tim 6:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.3.14"
              },
              "items": [
                {
                  "text": "Fil 3:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ndwaine okurwana okurungi, mperize orugyendo rwangye, ndinzire okwikiriza. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.7",
            "verseOrgIds": [
              "2TI.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2TI 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.5.4"
              },
              "items": [
                {
                  "text": "1 Pet 5:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ekitsigaire mbiikiirwe ekirunga ky'okuhikiiria, eki Mukama omucwi w'emanja ohikiriire arimpa aha kiro ekyo, kandi tiinye nyenka, kureka na boona abarikukunda okugaruka kwe.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.8",
            "verseOrgIds": [
              "2TI.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
