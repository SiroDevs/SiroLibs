        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.12",
            "verseOrgIds": [
              "JOB.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eizooba rimwe abatabani na bahara be bakaba nibarya nibanywera viinyo omu nju ya mukuru waabo; ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.13",
            "verseOrgIds": [
              "JOB.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "entumwa yaija ahari Yobu, yaamubikira eti: Enimi zaaba nizihinga, n'endogoya niziriira aha rubaju rwazo; ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.14",
            "verseOrgIds": [
              "JOB.1.14"
            ]
          }
        },
        {
