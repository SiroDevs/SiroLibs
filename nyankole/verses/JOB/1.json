              "items": [
                {
                  "text": "1 Bag 10:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.6.19"
              },
              "items": [
                {
                  "text": "Yob 6:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ahonaaho aba Sabeya baazeeshukamu, baazinyaga, n'abariisa baazo baabaitsa rurara; niinye nyenka owaahonokaho, nkaija kubikubikira. ",
