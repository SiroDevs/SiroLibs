              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka we yaamugarukamu ati: Noogamba nk'omukazi omushema. Noogira ngu turyaheebwa ebirungi byonka omu mikono ya Ruhanga, tituriheebwa n'ebibi? Omuri ebyo byona Yobu taracumwire na rurimi rwe.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.2.10",
            "verseOrgIds": [
              "JOB.2.10"
            ]
          }
        }
