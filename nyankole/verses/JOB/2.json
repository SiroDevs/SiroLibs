              "items": [
                {
                  "text": "Yob 42:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yobu yaayesherurira orugusyo rw'okweyaguza, yaashutama omu iju. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.2.8",
            "verseOrgIds": [
              "JOB.2.8"
            ]
          }
        },
