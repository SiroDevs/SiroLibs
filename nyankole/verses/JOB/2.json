            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima omukazi we yaamugira ati: Beitu na hati okuhamiire aha kuhikiirira kwawe? Yehakane Ruhanga, ofe. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.2.9",
            "verseOrgIds": [
              "JOB.2.9"
            ]
          }
        },
