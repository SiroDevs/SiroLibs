            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Atyo Sitaane yaaruga omu maisho ga MUKAMA, yaarwaza Yobu ebihuute bibi, okuruga aha mara g'ebigyere okuhika aha kazingiro k'eishokye. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.2.7",
            "verseOrgIds": [
              "JOB.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
