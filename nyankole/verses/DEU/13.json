          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Murumuna waawe, omwana wa nyoko, nari mutabani waawe, nari muhara waawe, nari omukazi waawe ow'aha mukono, nari munywani waawe ow'aha mara, ku arikwosyosya omu mubonano naagira ati: Ija, tuze kuheereza baaruhanga abandi, abu otakamanyaga, n'obu baakuba baashwenkuru, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.6",
            "verseOrgIds": [
              "DEU.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "baaruhanga b'amahanga agabeehinguririize, agari haihi naimwe, nari agabari hare, okuruga aha muheru gw'ensi, okuhika aha gundi; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.7",
            "verseOrgIds": [
              "DEU.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
