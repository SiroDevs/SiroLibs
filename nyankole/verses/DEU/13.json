            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ku orihurira amakuru ahari rumwe aha ndembo zaawe, ezi MUKAMA Ruhanga waawe yaakuhaire kutuuramu, ngu, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.12",
            "verseOrgIds": [
              "DEU.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.6.15"
              },
              "items": [
                {
                  "text": "2 Kor 6:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.2.19"
              },
              "items": [
                {
                  "text": "1 Yoh 2:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " hariho abantu babi abarugire omuriimwe, bakoosyosya abatwire omu rurembo rwabo, nibagira bati: Ka tugyende tuheereze baaruhanga abandi, abu mutakamanyaga; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.13",
            "verseOrgIds": [
              "DEU.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "obibuuririze, obikuratirire, obicondooze; ku orishanga biri eby'amazima bitarikubanganisibwa, ku ekihagaro ekirikushusha kityo kikoreirwe omuriimwe, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.14",
            "verseOrgIds": [
              "DEU.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "otaribura kwitsa ab'omuri orwo rurembo rurara, okarucwekyerereza kimwe n'ebirimu byona hamwe n'amatungo gaamwo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.15",
            "verseOrgIds": [
              "DEU.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eminyago yaamwo yoona oryagirunda ahu emihanda erikuteeranira, oyotsye orwo rurembo n'eminyago yaamwo yoona, nk'oku bootsya ekitambo eky'okwokyeza kimwe ekitambiirwe MUKAMA Ruhanga waanyu; orwo rurembo ruryaguma ruri omutuumo ebiro byona; tiruryombekwa bundi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.16",
            "verseOrgIds": [
              "DEU.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
