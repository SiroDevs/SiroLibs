                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.14.15"
              },
              "items": [
                {
                  "text": "Yer 14:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.10.18+2KI.10.19+2KI.10.20+2KI.10.21+2KI.10.22+2KI.10.23+2KI.10.24+2KI.10.25+2KI.10.26+2KI.10.27+2KI.10.28"
              },
              "items": [
                {
                  "text": "2 Bag 10:18-28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi nabi ogwo, nari ogwo murootsi w'ebirooto, aryaitwa, ahabw'okubagambira eby'okugomera MUKAMA Ruhanga waanyu, owaabaihire omu nsi ya Misri, akabacungura omu nju y'obuhuuku, n'ahabw'okubateishura omuhanda ogu MUKAMA Ruhanga waanyu yaabaragiire kugyenderamu. Ku muritwaza mutyo, muryaiha ekibi omuriimwe.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.5",
            "verseOrgIds": [
              "DEU.13.5"
            ]
          }
        }
      ]
