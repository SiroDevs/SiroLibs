            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.7.1"
              },
              "items": [
                {
                  "text": "7:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Otarigira ekintu kyona eki waagumya omu ngaro ahari ebyo ebyashorooreirwe MUKAMA, abone kureka ekiniga kye kingi, akugirire embabazi n'esaasi, akukanyise, nk'oku yaaraganiise baashwenkuru naarahira; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.17",
            "verseOrgIds": [
              "DEU.13.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "ku origuma noohurira eiraka rya MUKAMA Ruhanga waawe, nookwata ebiragiro bye byona, ebi ndikukuragiira eri izooba, nookora ebirikusiimwa MUKAMA Ruhanga waawe.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.18",
            "verseOrgIds": [
              "DEU.13.18"
            ]
          }
        }
      ]
    }
