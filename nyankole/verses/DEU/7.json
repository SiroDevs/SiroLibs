          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kureka MUKAMA Ruhanga waawe aryagahayo omu maisho gaawe, agarabanisemu munonga, okuhitsya obu garihwerekyerera. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.23",
            "verseOrgIds": [
              "DEU.7.23"
            ]
          }
        },
