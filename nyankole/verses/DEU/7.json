          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA Ruhanga waawe aryabingamu ago mahanga, gakurugyeho mporampora; orekye kugamaraho ahonaaho, enyamaishwa z'omu ihamba zikakukanyaho, zikarengyesereza. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.22",
            "verseOrgIds": [
              "DEU.7.22"
            ]
          }
        },
        {
          "name": "verse",
