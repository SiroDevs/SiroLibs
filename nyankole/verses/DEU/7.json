            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " otarishwererana nabo, kuhingira muhara waawe mutabani waabo, nari mutabani waawe kumushwererera muhara waabo; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.3",
            "verseOrgIds": [
              "DEU.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "ahabw'okuba baryahindura mutabani waawe arekye kunkurata, kureka aheereze baaruhanga abandi; haza kireetere MUKAMA kukugirira ekiniga, n'okurahuka kukucwekyereza. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.4",
            "verseOrgIds": [
              "DEU.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonka oku nikwo muribatwaza; muryasheenya amatambiro gaabo, musheenyagure enyomyo zaabo z'amabaare ezi baayombekire, mutemagure Ashera zaabo, kandi mwotsye ebishushani byabo ebibaizire.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.5",
            "verseOrgIds": [
              "DEU.7.5"
            ]
          }
        }
      ]
