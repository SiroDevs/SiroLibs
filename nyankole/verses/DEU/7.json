          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "ebigyezo by'amaani ebi amaisho gaawe gaareebire, obumanyiso, eby'okutangaaza, n'omukono gw'amaani kandi ogubangire, ebi MUKAMA yaakwihiiseyo; nikwo MUKAMA Ruhanga waawe arigira amahanga goona agu orikutiina. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.19",
            "verseOrgIds": [
              "DEU.7.19"
            ]
          }
        },
        {
