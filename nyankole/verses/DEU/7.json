                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Otaribatiina, ahabw'okuba MUKAMA Ruhanga waawe ari omuriiwe, Ruhanga omukuru kandi orikutiinisa. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.21",
            "verseOrgIds": [
              "DEU.7.21"
            ]
