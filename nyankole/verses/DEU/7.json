              "items": [
                {
                  "text": "1 Pet 2:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omanye ngu ori eihanga eryereziibwe MUKAMA Ruhanga waawe; kandi MUKAMA Ruhanga waawe akakutoorana omu mahanga goona agari omu nsi, kuba eihanga eri yaayetooraniire. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.6",
            "verseOrgIds": [
              "DEU.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekyareeteire MUKAMA kubakunda n'okubatoorana, ti habw'okugira ngu mukaba muri eihanga eririkukira agandi obuhango; ahakuba mukaba muri eihanga eririkukira obukye omu gandi goona; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.7",
            "verseOrgIds": [
              "DEU.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.13.3"
              },
              "items": [
                {
                  "text": "Kur 13:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kureka akabatoorana ahabw'okubakunda, yaayenda ngu ahikiirize endahiro ei yaarahiire baashwenkuriimwe. Nikyo MUKAMA yaabaihiireyo n'omukono gw'amaani, akabacungura okubaiha omu nju y'obuhuuku n'omu mukono gwa Faraho omugabe wa Misri. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.8",
            "verseOrgIds": [
              "DEU.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 7:9"
          },
          "items": [
