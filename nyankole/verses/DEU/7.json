            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi MUKAMA Ruhanga waawe aryayohereza enwa, zibateere, okuhitsya obu abo, abariba batsigaireho babeesherekire, baricwekyererezibwa omu maisho gaawe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.20",
            "verseOrgIds": [
              "DEU.7.20"
            ]
          }
