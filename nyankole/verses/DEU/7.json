        },
        {
          "text": " otarigatiina, kureka oijukye ebi MUKAMA Ruhanga waawe yaakoreire Faraho na Misri yoona, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.18",
            "verseOrgIds": [
              "DEU.7.18"
            ]
          }
        },
        {
