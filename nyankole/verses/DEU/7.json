          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku origira omu mutima gwawe oti: Amahanga aga nigankiza amaani; nimbaasa nta kuganyaga? ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.17",
            "verseOrgIds": [
              "DEU.7.17"
            ]
          }
        },
