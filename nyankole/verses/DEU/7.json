          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima ahabw'okuhurira ebirikuragiirwa ebyo, n'okubirinda noobyorobera, MUKAMA Ruhanga waawe aryagumizamu ahitsye endagaano n'okukugirira embabazi, ebi yaaragaine na baashwenkuru; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.12",
            "verseOrgIds": [
              "DEU.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.1.3"
              },
              "items": [
                {
                  "text": "Zab 1:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.14.21"
              },
              "items": [
                {
                  "text": "Yoh 14:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kandi aryakukunda, akuhe omugisha, akukanyise; kandi aryaha omugisha abaana b'enda yaawe, n'ebyana by'eitaka ryawe, n'engano zaawe, na viinyo yaawe, n'amajuta gaawe g'emizeituuni, n'okukanya kw'ente zaawe n'okw'abaana b'obusyo bw'entaama zaawe omu nsi ei yaaragaine na baashwenkuru kukuha. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.13",
            "verseOrgIds": [
              "DEU.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oryaheebwa omugisha okukira agandi mahanga goona; tiharibaho mushaija nari omukazi oriba engumba omuriimwe, nari omu matungo gaanyu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.14",
            "verseOrgIds": [
              "DEU.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA aryakwihaho endwara zoona; kandi tarikurwaza ndwara mbi yoona aha ndwara za Misri, ezi murikumanya; kureka aryazirwaza boona abarikukwanga. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.15",
            "verseOrgIds": [
              "DEU.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.106.36"
              },
              "items": [
                {
                  "text": "Zab 106:36",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Oryacwekyereza amahanga goona, agu MUKAMA Ruhanga waawe arihayo ahariiwe; amaisho gaawe gatarigasaasira; kandi naimwe mutariheereza baaruhanga baabo, ahabw'okuba ekyo kiryababeera omutego.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.16",
            "verseOrgIds": [
              "DEU.7.16"
            ]
          }
        }
      ]
    },
