              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.10.3"
              },
              "items": [
                {
                  "text": "Rom 10:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ku turitaho omutima, twayorobera ebyo biragiro byona omu maisho ga MUKAMA Ruhanga waitu, nk'oku yaaturagiire, kiryatubarirwa kuba okuhikiirira.",
          "type": "text",
