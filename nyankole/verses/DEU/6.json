      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbwenu eki nikyo kyaragiirwe n'ebiragiro ebyatairweho n'ebyaragiirwe, ebi MUKAMA Ruhanga waanyu yandagiire kubeegyesa, ngu mubone kubyoroberera omu nsi ei murikwambukamu kukubuura; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.1",
            "verseOrgIds": [
              "DEU.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ECC.12.13"
              },
              "items": [
                {
                  "text": "Mub 12:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.3.1"
              },
              "items": [
                {
                  "text": "Enf 3:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.3.2"
              },
              "items": [
                {
                  "text": "2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " otiine MUKAMA Ruhanga waawe, oyorobere ebiragiro bye byona ebyatairweho, ebi ndikukuragiira, iwe na mutabani waawe na mwijukuru waawe, ebiro byona ebi orimara omu nsi, haza obone kuhangaara. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.2",
            "verseOrgIds": [
              "DEU.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'ahabw'ekyo, hurira, iwe Israeli, oteho omutima, obyorobere, obone kuba gye, n'okukanyira munonga omuri egyo nsi y'amate n'obwoki, nka MUKAMA Ruhanga wa baashwenkuru oku yaakuraganiise.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.3",
            "verseOrgIds": [
              "DEU.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
