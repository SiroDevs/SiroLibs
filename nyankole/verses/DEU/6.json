              "items": [
                {
                  "text": "1 Kor 10:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mutarigyeza MUKAMA Ruhanga waanyu, nk'oku mwamugyereize Maasa. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.16",
            "verseOrgIds": [
              "DEU.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mugume mwezirikye kworobera ebiragiro bya MUKAMA Ruhanga waanyu, n'ebi yaahamize, n'ebiragiro ebyatairweho ebi yaabaragiire. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.17",
            "verseOrgIds": [
              "DEU.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ogume okore ebihikire n'ebirungi omu maisho ga MUKAMA, obone kuba gye, oze omuri egyo nsi nungi ei MUKAMA yaarahiire kuha baashwenkuru, ogikubuure, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.18",
            "verseOrgIds": [
              "DEU.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "ahabw'okubinga abazigu baawe boona omu maisho gaawe, nk'oku yaagambire.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.19",
            "verseOrgIds": [
              "DEU.6.19"
            ]
          }
        }
      ]
    },
