            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka omuntu ku ariba naayanga mugyenzi we, yaamugwera, yaamugurukira, yaamuteera munonga, yaafa; bwanyima yaahungira omuri rumwe ahari ezo ndembo, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.11",
            "verseOrgIds": [
              "DEU.19.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "abakuru b'orurembo rwe baryatuma, bamwiheyo, bamuheyo aha muhoozi w'enzigu, aitwe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.12",
            "verseOrgIds": [
              "DEU.19.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.2.31"
              },
              "items": [
                {
                  "text": "1 Bag 2:31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Amaisho gaanyu gatarimusaasira, kureka muryaiha omuri Israeli eshagama y'otaine rubanja, mubone kuba gye.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.13",
            "verseOrgIds": [
              "DEU.19.13"
            ]
          }
        }
