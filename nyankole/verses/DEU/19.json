              "type": "text"
            }
          ]
        },
        {
          "text": " Mushinja omwe atariikirizibwa kushinja omuntu eki ashobize nari ekibi kyona eki akozire; kureka okushinja kwa baamushinja babiri nari bashatu nikwo kurihamya ekigambo kyona. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.15",
