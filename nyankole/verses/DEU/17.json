                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.19.17"
              },
              "items": [
                {
                  "text": "Bir 19:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ku haribaho orubanja rwakurema, yaaba rw'obwitani bw'emiringo etari emwe, nari orw'entongane, nari orw'endwano, ebi barikufa omu marembo gaanyu, bwanyima oryaimuka, oze omu mwanya ogu MUKAMA Ruhanga waawe ariba atooraine, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.8",
            "verseOrgIds": [
              "DEU.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "ohikye aha Baleevi abanyamurwa, n'aha muramuzi oriba ariho omu biro ebyo, obeebuuzeho, babone kukumanyisa oku orubanja rushemereire kucuubwa; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.9",
            "verseOrgIds": [
              "DEU.17.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "bwanyima oryatwaza nk'okucwa kwabo oku kuri, oku barikuhaburira omuri ogwo mwanya gu MUKAMA ariba atooraine, oteho omutima kukora byona ebi barikwegyesa. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.10",
            "verseOrgIds": [
              "DEU.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oryakora nk'ebi bariba bakuhabwire oku biri, kandi nk'okucwa oku bariba bakugambiire oku kuri; otariza aha rubaju rwa buryo nari orwa bumosho, okateishuka aha rubanja nk'oku bariba bakuhabwire. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.11",
            "verseOrgIds": [
              "DEU.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZR.10.8"
              },
              "items": [
                {
                  "text": "Ezr 10:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HOS.4.4"
              },
              "items": [
                {
                  "text": "Hos 4:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi omuntu origira amaryo, akanga kuhurira omunyamurwa, oriba naayemerera okwo omu maisho ga MUKAMA Ruhanga waanyu, nari omuramuzi, ogwo muntu aryaitwa, obone kwiha ekibi omuri Israeli. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.12",
            "verseOrgIds": [
              "DEU.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'abantu boona baryahurira, batiine, barekye kugaruka kugira amaryo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.13",
            "verseOrgIds": [
              "DEU.17.13"
            ]
          }
        }
      ]
    },
