      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CO 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paulo owaayetsirwe kuba entumwa ya Yesu Kristo, nk'oku Ruhanga yaakunzire, na Soseene ow'eishe-emwe, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.1",
            "verseOrgIds": [
              "1CO.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CO 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "twabahandiikira imwe ab'omu kansia ya Ruhanga eri Korinso, abaayeziibwe omuri Kristo Yesu, bakeetwa kuba abarikwera hamwe na boona abari hoonahoona abatakira eiziina rya Mukama waitu Yesu Kristo, Mukama waabo kandi owaitu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.2",
            "verseOrgIds": [
              "1CO.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CO 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nitubendeza embabazi n'obusingye ebirikuruga ahari Ruhanga Tataitwe na Mukama waitu Yesu Kristo.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.3",
            "verseOrgIds": [
              "1CO.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CO 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.3",
            "verseOrgIds": [
              "1CO.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CO 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obutoosha nsiima Ruhanga wangye ahabwanyu, nimmusiimira embabazi ze ezi mwahairwe omuri Kristo Yesu, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.4",
            "verseOrgIds": [
              "1CO.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CO 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "ahabw'okuba omu miringo yoona mukahinduka abatungi omuriwe, omuri byona ebi mugamba kandi n'ebi mumanya, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.5",
            "verseOrgIds": [
              "1CO.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CO 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "nk'okuhamya Kristo kwaitu oku kwahamiibwe omuriimwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.6",
            "verseOrgIds": [
              "1CO.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CO 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "TIT.2.13"
              },
              "items": [
                {
                  "text": "Tit 2:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " N'ahabw'ekyo tihariho kiconco kyona eky'Omwoyo eki mutaine, nimutegyereza okushuuruurwa kwa Mukama waitu Yesu Kristo; ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.7",
            "verseOrgIds": [
              "1CO.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CO 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.1.6"
              },
              "items": [
                {
                  "text": "Fil 1:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " niwe aribagumya okuhitsya aha muheru, mukashangwa mutaine ky'okuhanwa aha kiro kya Mukama waitu Yesu Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.8",
            "verseOrgIds": [
              "1CO.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CO 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.1.3"
              },
              "items": [
                {
                  "text": "1 Yoh 1:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ruhanga n'omwesigwa owaabeetsire kutaaha omu kukwatanisa hamwe n'Omwana we Yesu Kristo Mukama waitu.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.9",
            "verseOrgIds": [
              "1CO.1.9"
            ]
          }
        }
      ]
    },
    {
