              "items": [
                {
                  "text": "Rom 1:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ahakuba ekigambo ky'omusharaba aha barikuhwerekyerera n'obushema, kwonka ahariitwe abarikujunwa n'amaani ga Ruhanga; ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.18",
            "verseOrgIds": [
              "1CO.1.18"
            ]
          }
        },
        {
