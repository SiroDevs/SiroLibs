                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " B'eishe-emwe, mwetegyereze okwetwa kwanyu; abaine obwengye bw'ensi egi omuriimwe ti baingi, n'obu baakuba bakama, n'obu baakuba ab'ekitiinisa; ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.26",
            "verseOrgIds": [
              "1CO.1.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CO 1:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwonka Ruhanga katoorana abashema b'ensi ngu akwatse enshoni abanyabwengye; kandi Ruhanga akatoorana eitaine maani ngu akwatse enshoni ebiine amaani; ",
