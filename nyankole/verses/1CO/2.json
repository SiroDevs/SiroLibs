                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " B'eishe-emwe, obu naija owaanyu, tindaizire nimbagambira enaama ya Ruhanga nk'omugambi murungi nari omunyabwengye; ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.1",
            "verseOrgIds": [
              "1CO.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
