                {
                  "text": "Yer 33:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ekicweka kimwe kya ikumi ky'amasyo g'ente nari ag'entaama, buri nyamaishwa ya ikumi ahari ezo eziriba niziraba ahansi y'enkoni y'omuriisa, eryaba eyereziibwe MUKAMA. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.32",
            "verseOrgIds": [
              "LEV.27.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
