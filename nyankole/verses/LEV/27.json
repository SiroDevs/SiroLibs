                "loc": "JDG.11.31"
              },
              "items": [
                {
                  "text": "31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka tihariho kintu ekihairweyo kyona eki omuntu arihayo ahari MUKAMA, ahari byona ebi aine, yaaba muntu, nari enyamaishwa, nari ekibanja kye ky'empungurirano, ekiritundwa, nari ekiricungurwa; ekintu kyona ekihairweyo n'ekyeziibwe munonga ahabwa MUKAMA. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.28",
            "verseOrgIds": [
              "LEV.27.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 27:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hatarigira omuntu weena ohairweyo ahabw'okucwerwa abantu orubanja rw'okufa, owaacungurwa, kureka aitwe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.29",
            "verseOrgIds": [
              "LEV.27.29"
            ]
          }
        }
      ]
