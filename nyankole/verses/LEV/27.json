                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Aha bimezire omu itaka, yaaba myaka y'omu misiri, nari ebijuma by'emiti, ekicweka kimwe kya ikumi kyona ekyabyo n'ekya MUKAMA; n'ebyereziibwe MUKAMA. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.30",
            "verseOrgIds": [
              "LEV.27.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
