          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuntu ataryetegyereza kureeba yaaba eri nungi nari mbi, kandi atarigihingisa; kwonka ku arigihingisa, eyaahingwa n'eyaahingisibwa, zombi ziryaba ezirikwera; zitaricungurwa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.33",
            "verseOrgIds": [
              "LEV.27.33"
            ]
          }
        }
