              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka emijigaijo y'enyamaishwa, eshangwa eba eya MUKAMA, ahakuba n'emijigaijo, hatarigira omuntu owaagihayo; yaaba nte, yaaba ntaama, n'eya MUKAMA. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.26",
            "verseOrgIds": [
              "LEV.27.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 27:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku guriba guri ogw'enyamaishwa erikuzira, agucunguze obuguzi obu oricwa, ayongyereho ekicweka kyabwo kimwe kya kataano; nari ku eriba etacungwirwe, etundwe nk'obuguzi bwayo obu oricwa oku buri. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.27",
            "verseOrgIds": [
              "LEV.27.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 27:28"
          },
          "items": [
