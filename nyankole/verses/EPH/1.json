                "loc": "ROM.8.28"
              },
              "items": [
                {
                  "text": "Rom 8:28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omuriwe naitwe nimwo twahindukiire obuhunguzi, obu twatooranwa tutakabaireho, ahabw'okukunda kw'Ogwo ohikiiriza byona, nk'oku yaasiimire omu naama ye, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.11",
            "verseOrgIds": [
              "EPH.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EPH 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngu tube ab'okuhimbisisa ekitiinisa kye, itwe abaabandize kwesiga Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.12",
            "verseOrgIds": [
              "EPH.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EPH 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.4.30"
              },
              "items": [
                {
                  "text": "Efe 4:30",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi naimwe, ku mwaherize kuhurira ekigmbo ky'amazima, niyo ngiri y'okujunwa kwanyu, mukaikiriza Yesu, mwahamibwa omuriwe n'akamanyiso k'Omoyo Orikwera owaaraganisiibwe; ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.13",
            "verseOrgIds": [
              "EPH.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EPH 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "nigwo mukwato gw'obuhunguzi bwaitu, okuhitysa obu tuributunga, ekitiinisa kye kikasiimwa.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.14",
            "verseOrgIds": [
              "EPH.1.14"
            ]
          }
        }
      ]
    },
