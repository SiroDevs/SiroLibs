                "loc": "LUK.17.6"
              },
              "items": [
                {
                  "text": "Luk 17:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.17.20"
