                {
                  "text": "Yoh 12:12-16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi ku bairiire haihi na Yerusaalemu, baahika Besifaage na Besania aha kibungo kya Zeituuni; yaatuma abeegi be babiri, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.1",
            "verseOrgIds": [
              "MRK.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MRK 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "yaabagira ati: Mugyende omu kirorero ekibari omumaisho; ahonaaho ku muraataahemu, nimwija kushangamu omwana gw'endogoya gutsibikire, ogutakatembwahoga muntu; mugutsibure, mugundeetere. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.2",
            "verseOrgIds": [
              "MRK.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MRK 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuntu weena, ku araababuuze ati: Nimugutsiburira ki? imwe mugarukyemu muti, Mukama waitu naagwenda, kandi naija kugugarura juba. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.3",
            "verseOrgIds": [
              "MRK.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MRK 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batyo baagyenda, baashanga omwana gw'endogoya gutsibikire aha irembo aha rubaju rw'omuhanda; baagutsibura. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.4",
            "verseOrgIds": [
              "MRK.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MRK 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi bamwe aha baabaire beemereire aho, baababuza bati: Nimukora ki okutsibura omwana gw'endogoya? ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.5",
            "verseOrgIds": [
              "MRK.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MRK 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baabagarukamu nk'oku Yesu yaabagambira; baabareka. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.6",
            "verseOrgIds": [
              "MRK.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MRK 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baareetera Yesu omwana gw'endogoya, baagutaho ebijwaro byabo; Yesu yaagutembaho. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.7",
            "verseOrgIds": [
              "MRK.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MRK 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baingi baayarira ebijwaro byabo omu nguuto, abandi amababi agu baihire omu misiri. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.8",
            "verseOrgIds": [
              "MRK.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MRK 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.118.25"
              },
              "items": [
                {
                  "text": "Zab 118:25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.118.26"
              },
              "items": [
                {
                  "text": "26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abamushendekyereize bamwebembeire, n'abandi bamuri enyima, baayeshongora n'eiraka rihango bati: Hosana, Orikwija omu iziina rya Mukama asiimwe! ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.9",
            "verseOrgIds": [
              "MRK.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MRK 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obugabe oburikwija obwa tatenkuriitwe Daudi busiimwe! Hosana ahaiguru munonga!",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.10",
            "verseOrgIds": [
              "MRK.11.10"
            ]
          }
        }
      ]
    },
    {
