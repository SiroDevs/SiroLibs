                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.19.38+JHN.19.39+JHN.19.40+JHN.19.41+JHN.19.42"
              },
              "items": [
                {
                  "text": "Yoh 19:38-42",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omu mwabazyo, nk'oku ryabaire riri eizooba ry'Okweteguura, kandi riri eizooba eririkubandiza Sabato, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.42",
            "verseOrgIds": [
              "MRK.15.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "MRK 15:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosefu owa Arimasaaya, omuhanuuzi w'ekitiinisa omu ishengyero, kandi owaabaire atuura ategyereize obukama bwa Ruhanga, yaatiinuuka, yaataaha owa Pilaato, yaashaba omutumbi gwa Yesu. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.43",
            "verseOrgIds": [
              "MRK.15.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "MRK 15:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pilaato yaatangaarira oku yaarahuka kukaba; yaatuma kweta omukuru w'abaserukare, yaamubuuza ku araabe yaakabire. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.44",
            "verseOrgIds": [
              "MRK.15.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "MRK 15:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku yaahamiziibwe omukuru w'abaserukare ku yaaheza kukaba, yaikiriza kuha Yosefu omutumbi. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.45",
            "verseOrgIds": [
              "MRK.15.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "MRK 15:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosefu yaagura omwenda gwa bafuta, yaahanura omutumbi, yaaguzinga omu mwenda ogwo gwa bafuta, yaaguta omu kituuro, ekyatimbirwe omu rukiri; yaakumbagaza eibaare, yaarikingisa omuryango gw'ekituuro. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.46",
            "verseOrgIds": [
              "MRK.15.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "MRK 15:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi Mariamu Magadaleene na Mariamu nyina wa Yose baayetegyereza ahu omutumbi gwe gwateebwa.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.47",
            "verseOrgIds": [
              "MRK.15.47"
            ]
          }
        }
      ]
