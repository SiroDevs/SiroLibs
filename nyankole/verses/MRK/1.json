              "attrs": {
                "loc": "JHN.1.31+JHN.1.32+JHN.1.33+JHN.1.34"
              },
              "items": [
                {
                  "text": "Yoh 1:31-34",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omu buri ebyo Yesu akaruga Nazareesi ey'omuri Galilaaya, yaija, yaabatizibwa Yohaana omuri Yorudani. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.9",
            "verseOrgIds": [
              "MRK.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MRK 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahonaaho ku yaabaire naaruga omu maizi, yaareeba eiguru rikinguukire, n'Omwoyo naamushuumaho nk'enkombe, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.10",
            "verseOrgIds": [
              "MRK.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MRK 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.9.7"
              },
              "items": [
                {
                  "text": "Mak 9:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " n'eiraka ryayema omu iguru riti: Niiwe Mwana wangye ou nkunda, kandi ou nsehemerererwa munonga.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.11",
            "verseOrgIds": [
              "MRK.1.11"
            ]
          }
        }
