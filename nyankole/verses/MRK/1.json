                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ku yaabaire naaraba aha rubaju rw'enyanja ya Galilaaya, yaareeba Simooni na Anderea omurumuna nibatega obutimba omu nyanja, ahakuba bakaba bari abajubi. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.16",
            "verseOrgIds": [
              "MRK.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MRK 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu yaabagira ati: Mwije munkuratire, naanye ndyabahindura abajubi b'abantu. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.17",
            "verseOrgIds": [
              "MRK.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MRK 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahonaaho baatsigaho obutimba bwabo, baamukuratira. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.18",
            "verseOrgIds": [
              "MRK.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MRK 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku yairiire omumaisho hakye, yaareeba Yakobo mwene Zebedaayo na Yohaana omurumuna, abaabaire bari omu bwato, nibashumikanisa obutimba. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.19",
            "verseOrgIds": [
              "MRK.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MRK 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahonaaho yaabeeta; baatsiga ishebo Zebedaayo omu bwato hamwe n'abapakasi, baamukuratira.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.20",
            "verseOrgIds": [
              "MRK.1.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MRK 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
