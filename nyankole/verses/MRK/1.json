            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ahonaaho Omwoyo yaamutwara omu ihamba; ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.12",
            "verseOrgIds": [
              "MRK.1.12"
            ]
          }
        },
        {
          "name": "verse",
