          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "yaamarayo ebiro makumi ana, naayohibwa Sitaane; yaaguma hamwe n'enyamaishwa, baamaraika nibamuheereza.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.13",
            "verseOrgIds": [
