              "MRK.13.14"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.9.27"
              },
              "items": [
                {
                  "text": "Dan 9:27",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.12.4"
              },
              "items": [
                {
                  "text": "12:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.12.10"
              },
              "items": [
                {
                  "text": "10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka ku murireeba ekintu ekirikuzira ekirikuhwerekyereza kyemereziibwe ahu kitashemereire, (orikushoma ayetegyereze,) abo abariba bari Buyudaaya omu bunaku obwo bahungire aha nshozi; ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.14",
            "verseOrgIds": [
              "MRK.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MRK 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'ori aha mutwe gw'enju ataritemburuka, n'obu kuriba okutaahamu, ngu agire eki yaihamu; ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.15",
            "verseOrgIds": [
              "MRK.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MRK 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'oriba ari omu misiri atarigarukayo kwenda omwenda gwe. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.16",
            "verseOrgIds": [
              "MRK.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MRK 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abariba baine enda n'abarikwontsya omu biro ebyo baryakareeba! ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.17",
            "verseOrgIds": [
              "MRK.13.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MRK 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mushabe bitarihika mu biro by'embeho. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.18",
            "verseOrgIds": [
              "MRK.13.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MRK 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.12.1"
              },
              "items": [
                {
                  "text": "Dan 12:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOL.2.2"
              },
              "items": [
                {
                  "text": "Yoel 2:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ahabw'okuba ebiro ebyo biryaba eby'obusaasi obutakabahoga okwiha aha kuhangwa kw'ebintu ebi Ruhanga yaahangire n'okuhitsya hati, kandi tibiribaho. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.19",
            "verseOrgIds": [
              "MRK.13.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MRK 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuri Mukama ataracwire ha biro ebyo, tihaakurokokireho muntu weena; kwonka ahabw'entoore ezi yaatooraine akatuubya aha biro ebyo. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.20",
            "verseOrgIds": [
              "MRK.13.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MRK 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu biro ebyo omuntu weena ku aribagambira ati: Reeba, Kristo ari aha! nari shi, ari hariya! mutarimwikiriza; ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.21",
            "verseOrgIds": [
              "MRK.13.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MRK 13:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "ahakuba haryaimuka abarikweyeta Kristo na baanabi b'ebishuba, baryakora eby'okureeberaho n'eby'okutangaaza, babone kuhabisa n'entoore, kyaba nikibaasika. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.22",
            "verseOrgIds": [
              "MRK.13.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MRK 13:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonka imwe mwerinde; naabagambira byona bitakahikire.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.23",
            "verseOrgIds": [
              "MRK.13.23"
            ]
          }
        }
      ]
    },
