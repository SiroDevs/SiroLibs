          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.21.12+LUK.21.13+LUK.21.14+LUK.21.15+LUK.21.16+LUK.21.17"
              },
              "items": [
                {
                  "text": "Luk 21:12-17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.10.17+MAT.10.18+MAT.10.19+MAT.10.20+MAT.10.21+MAT.10.22"
              },
              "items": [
                {
                  "text": "Mat 10:17-22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka mwerinde; ahakuba baryabahayo omu mashengyero; muryateererwa omuri sinagogi; muryayemerera omu maisho g'abategyeki n'abagabe ahabwangye kuba baakareebi bangye omu maisho gaabo. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.9",
            "verseOrgIds": [
              "MRK.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MRK 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi engiri eshemereire kubanza kubuurirwa omu mahanga goona. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.10",
            "verseOrgIds": [
              "MRK.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MRK 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku bariba nibabatwara omu manja, baabahayo, mutaryeremeza omutima ahabw'ebi murigamba; ahakuba tiimwe muryegambisa kureka Omwoyo Orikwera. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.11",
            "verseOrgIds": [
              "MRK.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MRK 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MIC.7.6"
              },
              "items": [
                {
                  "text": "Mik 7:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mukuru w'omuntu aryahayo omurumuna kwitwa, na ishe w'omwana aryahayo omwana we, abaana baryagomera abazaire baabo, babaitise; ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.12",
            "verseOrgIds": [
              "MRK.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MRK 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi muryayangwa abantu boona nibabatura eiziina ryangye. Kwonka origumisiriza okuhitsya aha muheru, niwe arijunwa.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.13",
            "verseOrgIds": [
              "MRK.13.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
