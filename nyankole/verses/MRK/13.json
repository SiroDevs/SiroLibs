            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MRK 13:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.24",
            "verseOrgIds": [
              "MRK.13.24"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.13.10"
              },
              "items": [
                {
                  "text": "Isa 13:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi omu biro ebyo bwanyima y'obusaasi obwo, eizooba riryashwekwa omwirima, okwezi tikuryaka, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.24",
            "verseOrgIds": [
              "MRK.13.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MRK 13:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.34.4"
              },
              "items": [
                {
                  "text": "Isa 34:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " enyonyoozi ziryaragara okuruga omu iguru, n'eby'amaani eby'omu iguru biryatengyetsibwa. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.25",
            "verseOrgIds": [
              "MRK.13.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MRK 13:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.7.13"
              },
              "items": [
                {
                  "text": "Dan 7:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Obwo nibwo barireeba Omwana w'omuntu naizira omu bicu, aine amaani maingi n'ekitiinisa. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.26",
            "verseOrgIds": [
              "MRK.13.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MRK 13:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi aryatuma baamaraika be, ateerane entoore ze okuruga omu mbaju ina aha muheru gw'ensi, okuhika aha muheru gw'eiguru.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.27",
            "verseOrgIds": [
              "MRK.13.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MRK 13:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.27",
            "verseOrgIds": [
              "MRK.13.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MRK 13:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbwenu mwegyere aha mutiini nk'eky'okureeberaho; eitaagi ryagwo, ku ryoroba, ryatooka amababi, mumanya omwaka ku guri haihi. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.28",
            "verseOrgIds": [
              "MRK.13.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MRK 13:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikwo naimwe, ku murireeba ebyo byagyenda nibibaho, mumanye ku ari haihi, ku yaahikire n'aha rwigi. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.29",
            "verseOrgIds": [
              "MRK.13.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MRK 13:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buzimazima nibmagambira nti: Obusingye obu tiburihwaho okuhitsya obu ebi byona biribaho. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.30",
            "verseOrgIds": [
              "MRK.13.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MRK 13:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eiguru n'ensi biryahwaho, kwonka ebigambo byangye tibirihwaho.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.31",
            "verseOrgIds": [
              "MRK.13.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MRK 13:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.31",
            "verseOrgIds": [
              "MRK.13.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MRK 13:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonka eby'ekiro ekyo n'obunaku obwo tihaine orikubimanya, n'obu baakuba baamaraika ab'omu iguru, n'obu yaakuba Omwana, kureka Ishe wenka. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.32",
            "verseOrgIds": [
              "MRK.13.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MRK 13:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwerinde, mugume nimureeba, kandi mushabe, ahakuba timurikumanya ahu obunaku obwo burihikira. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.33",
            "verseOrgIds": [
              "MRK.13.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MRK 13:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.19.12"
              },
              "items": [
                {
                  "text": "Luk 19:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.25.14"
              },
              "items": [
                {
                  "text": "Mat 25:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nikishusha nk'omuntu orikwenda kuza omu nsi endiijo; yaaba naaruga omu ka ye, atsiga aragiire abahuuku be emirimo, buri omwe amuha ogwe, n'omurinzi okurinda eka. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.34",
            "verseOrgIds": [
              "MRK.13.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MRK 13:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'ahabw'ekyo mugume nimureeba, ahabw'okuba timurikumanya bunaku obu mukama w'eka ariiziramu, yaaba mu mwabazyo, nari omu itumbi, nari enkoko nizigamba, nari omu kasheeshe, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.35",
            "verseOrgIds": [
              "MRK.13.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MRK 13:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "atakaija kitaraariire, akashanga mugwejegyeire. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.36",
            "verseOrgIds": [
              "MRK.13.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MRK 13:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eki ndikubagambira imwe, nikyo ngambira boona, nti: Mugume nimureeba!",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.37",
            "verseOrgIds": [
              "MRK.13.37"
            ]
          }
        }
      ]
