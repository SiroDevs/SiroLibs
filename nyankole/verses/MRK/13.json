          "type": "text",
          "attrs": {
            "verseId": "MRK.13.13",
            "verseOrgIds": [
              "MRK.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
