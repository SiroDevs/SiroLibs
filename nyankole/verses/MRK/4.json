              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi yaagira ati: Mbwenu obukama bwa Ruhanga tukaabugyeranisa na ki? Nari tukaabushobooroza nfumu ki? ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.30",
            "verseOrgIds": [
              "MRK.4.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
