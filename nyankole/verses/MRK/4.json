          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi yaagira ati: Obukama bwa Ruhanga nibushusha nk'oku omuntu abiba embibo omu itaka; ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.26",
            "verseOrgIds": [
              "MRK.4.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MRK 4:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "akabyama kandi akaimuka nyomushana na nyekiro; embibo zikamera, zikakura, atamanyire oku zikuzire. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.27",
            "verseOrgIds": [
              "MRK.4.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MRK 4:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eitaka niryo rimeza ryonak; habanza akababi, hataho obushiisha, na bwanyima enjuma nkuru. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.28",
            "verseOrgIds": [
              "MRK.4.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MRK 4:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOL.3.13"
              },
              "items": [
                {
                  "text": "Yoel 3:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ku biheza kwera, ahonaaho areeta omusyo, abigyesha, ahakuba eigyesha rihikire.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.29",
            "verseOrgIds": [
              "MRK.4.29"
            ]
          }
        }
