          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibushusha nk'akajuma ka ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.31",
            "verseOrgIds": [
              "MRK.4.31"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "4:31",
              "type": "text"
            },
            {
              "text": "Sinaapi reeba Mat. 13:31.",
              "type": "text"
            }
          ]
        },
        {
          "text": "sinaapi. Ku kabibwa omu itaka, kaba kari kakye okukira embibo zoona eziri omu nsi; ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.31",
            "verseOrgIds": [
              "MRK.4.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MRK 4:32"
