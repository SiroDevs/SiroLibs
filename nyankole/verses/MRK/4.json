              },
              "items": [
                {
                  "text": "Dan 4:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.4.21"
              },
              "items": [
                {
                  "text": "21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kwonka ku kaheza kubibwa, kamera, kakura, karugamu ekiti kihango okukira ebindi byona, kagira amataagi mahango, kandi n'enyonyi z'omu mwanya zaarika omu mataagi gaako.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.32",
            "verseOrgIds": [
              "MRK.4.32"
            ]
          }
        }
