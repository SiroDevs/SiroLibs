                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.26.6"
              },
              "items": [
                {
                  "text": "26:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bahara baawe abari omu ishwa aryabaitsa rurara, akwombekyeho eby'okutemberaho, akuteeze abaine engabo zikwataine ez'okukingira emitwe yaabo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.8",
            "verseOrgIds": [
              "EZK.26.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 26:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Engo zaawe z'amabaare aryazibyaraho ebiti by'okuzihiguza, n'eminaara yaawe agisheenyese empango. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.9",
            "verseOrgIds": [
              "EZK.26.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 26:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahabw'embaraasi ze kuba nyingi ziryaimutsya omucuucu, gukushwekye; ku ariba naaraba omu marembo gaawe, nk'oku bataaha omu rurembo, oru engo zaarwo zisheenyirwe, engo zaawe ziryatengyetsibwa endigito y'ab'aha mbaraasi n'ey'enziga z'ebigaari by'orugamba. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.10",
            "verseOrgIds": [
              "EZK.26.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emihanga yaawe yoona aryagiribatiiriza ebyara by'embaraasi ze; abantu baawe aryabaitsa rurara; kandi enyomyo zaawe z'amaani ziryagwa ahansi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.11",
            "verseOrgIds": [
              "EZK.26.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 26:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.27.12+EZK.27.13+EZK.27.14+EZK.27.15+EZK.27.16+EZK.27.17+EZK.27.18+EZK.27.19+EZK.27.20+EZK.27.21+EZK.27.22+EZK.27.23+EZK.27.24"
              },
              "items": [
                {
                  "text": "Ezk 27:12-24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Obutungi bwawe baryabunyaga, n'eby'obushuubuzi byawe bibe eminyago; baryakumbagaza engo zaawe z'amabaare, bacwekyereze amaju gaawe agarikushemeza; kandi amabaare gaawe n'embaaho zaawe n'eitaka ryawe bayrabinaga omu nyanja. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.12",
            "verseOrgIds": [
              "EZK.26.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 26:13"
