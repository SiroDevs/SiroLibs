              "items": [
                {
                  "text": "Kush 18:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ndyahunamya amaraka g'abarikweshongora ebyeshongoro byawe; n'enanga zaawe tizirihurirwa bundi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.13",
            "verseOrgIds": [
              "EZK.26.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 26:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndyakugira orukiri oruriho busha, obe embuga y'okwanikaho obutimba; kandi torigaruka kwombekwa bundi, ahabw'okuba nyowe MUKAMA niinye naakigamba; nikwo Mukama RUHANGA arikugira.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.14",
            "verseOrgIds": [
              "EZK.26.14"
            ]
          }
        }
      ]
    },
