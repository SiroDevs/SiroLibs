            }
          ]
        },
        {
          "text": " Omu waka gwa ikumi na gumwe, aha kiro ky'okubanza ky'okwezi, ekigambo kya MUKAMA kikanyijaho nikigira kiti: ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.1",
