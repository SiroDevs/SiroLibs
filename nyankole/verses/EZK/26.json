            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ahakuba oku nikwo Mukama RUHANGA arikugamba naagira ati: Iwe Tuuro, reeba, ndyakuteeza Nebukadeneeza omugabe wa Babulooni, omugabe w'abagabe, arugye aha bukiizi-bwa-bumosho, aine embaraasi n'ebigaari, n'ab'aha mbaraasi n'eihe ry'engabo nyingi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.7",
            "verseOrgIds": [
              "EZK.26.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 26:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.21.22"
              },
              "items": [
                {
                  "text": "Ezk 21:22",
