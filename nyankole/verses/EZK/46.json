              "attrs": {
                "loc": "DEU.23.23"
              },
              "items": [
                {
                  "text": "Bir 23:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi omugabe ku ariteekateeka kuhongyera MUKAMA empongano n'omutima gwekundiire, yaaba kitambo ky'okwotsya nari empongano z'okusiima ahabw'obusingye, aryaigurirwa eirembo eririkureeba oburugwa-izooba, ahongye ekitambo kye ky'okwotsya n'empongano ze z'okusiima ahabw'obusingye, nk'oku ashangwa atwaza aha izooba rya sabato. Bwanyima aryashohora; ku ariheza kushohora, eriembo rikingwe.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.12",
            "verseOrgIds": [
              "EZK.46.12"
            ]
          }
        }
