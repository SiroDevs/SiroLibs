              "items": [
                {
                  "text": "Bir 16:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka abantu b'obutoosha ab'omu nsi ku bariba nibaija omu maisho ga MUKAMA omu magyenyi agaatairweho, oritaahira omu irembo ry'aha bukiizi-bwa-bumosho aizire kuramya, aryashohohorera omu irembo ry'aha bukiizi-bwa-buryo; kandi oritaahira omu irembo ry'aha bukiizi-bwa-buryo, aryashohorera omu irembo ry'aha bukiizi-bwa-bumosho; tihariho n'omwe oriikirizibwa kugaruka omu irembo eri yaatahiramu, kureka omuntu weena aryashohora agumizemu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.9",
            "verseOrgIds": [
              "EZK.46.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 46:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku baritaahamu, omugabe aryataahamu nabo; kandi ku barishohora, nawe aryashohora.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.10",
            "verseOrgIds": [
              "EZK.46.10"
            ]
          }
        }
      ]
    },
