          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu biro by'amagyenyi n'omu biro bikuru ebyatairweho, empongano eryaguma ebi eefa emwe ahabwa buri nimi nto, na eefa emwe ahabwa buri mpaya y'entaama, n'ahabw'abaana b'entaama omuntu ahe esaano nyingi nk'oku arikubaasa, hamwe na hiini y'amajuta ahabwa buri eefa y'esaano. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.11",
            "verseOrgIds": [
              "EZK.46.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 46:12"
