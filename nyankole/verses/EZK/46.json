                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.45.19"
              },
              "items": [
                {
                  "text": "45:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omugabe aryaguma ataahire omu kisasi ky'eirembo eky'aheeru, ayemerere aha rubaju rw'ekiti kyaryo; abanyamurwa batambe ekitambo kye ky'okwotsya, bahongye empongano ze z'okusiima ahabw'obusingye, nawe aramize omu kisasi ky'eirembo; bwanyima ashohore, kwonka eirembo rirekye kukingwa okuhitsya omu mwabazyo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.2",
            "verseOrgIds": [
              "EZK.46.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 46:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.1.10"
              },
              "items": [
                {
                  "text": "Luk 1:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abantu b'omu nsi barayguma baramize ah'orikutaahira nooza omuri eryo irembo omu maisho ga MUKAMA ahari buri sabato n'ahari buri kuboneka kw'okwezi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.3",
            "verseOrgIds": [
              "EZK.46.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 46:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.45.17"
              },
              "items": [
                {
                  "text": "Ezk 45:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.28.9"
              },
              "items": [
                {
                  "text": "Kub 28:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.28.10"
              },
              "items": [
                {
                  "text": "10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ekitambo ky'okwotsya, eki omugabe ariguma naahongyera MUKAMA ahari sabato kiryaba abaana b'entaama mukaaga abataine kamogo, n'empaya y'entaama etaine kamogo; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.4",
            "verseOrgIds": [
              "EZK.46.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 46:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.45.24"
              },
              "items": [
                {
                  "text": "Ezk 45:24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.16.17"
              },
              "items": [
                {
                  "text": "Bir 16:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kandi empongano y'esaano erikuhongwa n'egyo mpaya y'entaama eryaba eefa emwe, n'esaano ey'okuhongwa n'abaana b'entaama ebe nyingi nk'oku arikubaasa, hamwe na hiini y'amajuta ahabwa buri eefa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.5",
            "verseOrgIds": [
              "EZK.46.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 46:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.45.18"
              },
              "items": [
                {
                  "text": "Ezk 45:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Aha izooba ry'okuboneka kw'okwezi aryaguma ahongye enimi nto etaine kamogo, n'abaana b'entaama mukaaga, n'empaya y'entaama etaine kamogo; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.6",
            "verseOrgIds": [
              "EZK.46.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 46:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi ahongye empongano y'esaano eefa emwe ahabwa buri nimi, eefa emwe ahabwa buri mpaya y'entaama, n'esaano nyingi ezi arikubaasa ahabw'abaana b'entaama, hamwe na hiini emwe y'amajuta ahabwa buri eefa y'esaano. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.7",
            "verseOrgIds": [
              "EZK.46.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 46:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omugabe ku ariba naataaha omuri hekalu, aryaguma arabe omu kisasi ky'eirembo; kandi n'omu kushohora, abe nimwo yaaraba.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.8",
            "verseOrgIds": [
              "EZK.46.8"
            ]
          }
        }
      ]
    },
