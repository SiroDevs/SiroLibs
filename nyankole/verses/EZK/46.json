            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.29.38+EXO.29.39+EXO.29.40"
              },
              "items": [
                {
                  "text": "Kur 29:38-40",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Buri izooba omugabe aryahongyera MUKAMA omwana gw'entaama oguhikize omwaka gumwe, ogutaine kamogo, kuba ekitambo ky'okwotsya; aryaguma aguhongye buri kasheeshe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.13",
            "verseOrgIds": [
              "EZK.46.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 46:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi aryahonga n'empongano y'esaano buri kasheeshe kimwe kya mukaaga kya eefa emwe, na kimwe kya kashatu kya hiini y'amajuta g'okworobya egyo saano, kuba empongano y'esaano ehongyeirwe MUKAMA; ekyo nikyo kiragiro ky'ekitambo ky'okwotsya ekiriguma nikitambwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.14",
            "verseOrgIds": [
              "EZK.46.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 46:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi okwo nikwo bariteebeekanisa omwana gw'entaama n'empongano y'esaano n'amajuta kuba ekitambo ky'okwotsya ekriguma nikitambwa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.15",
            "verseOrgIds": [
              "EZK.46.15"
            ]
          }
        }
      ]
