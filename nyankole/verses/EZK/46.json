          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "omuri ezo nshonda ina z'ekibuga hakaba hariho obubuga bukye, buri kamwe mikono makumi ana oburaingwa, n'obukiika mikono makumi ashatu, bwona buna nibwingaingana. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.22",
            "verseOrgIds": [
