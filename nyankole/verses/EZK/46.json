            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Oku nikwo Mukama RUHANGA arikugamba naagira ati: Omu biro mukaaga ebikorerwamu emirimo, eirembo ry'ekibuga ky'omunda eririkureeba oburugwa-izooba riryaguma rikingire; kwonka riryaigurwa aha izooba rya sabato n'aha izooba ry'okuboneka kw'okwezi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.1",
            "verseOrgIds": [
              "EZK.46.1"
            ]
          }
        },
