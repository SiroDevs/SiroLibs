            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi aryatebeekanisa empongano y'esaano, eefa emwe ahabwa buri nimi, eefa emwe ahabwa buri mpaya y'entaama, na hiini emwe y'amajuta ahabwa buri eefa. ",
          "type": "text",
          "attrs": {
