            }
          ]
        },
        {
          "text": "Abantu b'omu nsi boona baryaha omugabe wa Israeli egyo mpongano. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.16",
            "verseOrgIds": [
              "EZK.45.16"
            ]
