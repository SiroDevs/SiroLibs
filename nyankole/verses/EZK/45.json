            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 45:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aha rubaju rw'ekyo kicweka ekyaihirweho kuba ekyanga ekirikwera, muryahatooranira orurembo omwanya gwa mikono enkumi itaano obukiika, noburaingwa mikono obukimi n'enkumi itaano; guryaba ogw'enju ya Israeli yoona.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.6",
            "verseOrgIds": [
              "EZK.45.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
