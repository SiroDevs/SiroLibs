                "loc": "EZK.44.3"
              },
              "items": [
                {
                  "text": "Ezk 44:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi ekicweka ky'endi eky'omugabe kiryaba aha mbaju zombi ez'ekyanga ekirikwera, n'omwanya gw'orurembo, omu mbaju z'ekyo kyanga ekirikwera, n'ez'ogwo mwanya gw'orurembo, aha rubaju rw'oburengyerwa-izooba, nihainganisa oburaingwa n'eky'omugabo gw'oruganda rumwe, okuruga aha mwatano gw'ensi ogw'oburengyerwa-izooba okuhika aha gw'oburugwa-izooba. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.7",
            "verseOrgIds": [
              "EZK.45.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 45:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.22.27"
              },
              "items": [
                {
                  "text": "Ezk 22:27",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.46.18"
              },
              "items": [
                {
                  "text": "46:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.47.13"
              },
              "items": [
                {
                  "text": "47:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kiryaba omugabo gwe omuri Israeli. Kandi abagabe bangye tibarigaruka kwita kubi bantu bangye, kureka baryareka enju ya Israeli etungye ensi nk'enganda zaabo oku ziri.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.8",
            "verseOrgIds": [
              "EZK.45.8"
            ]
          }
        }
      ]
