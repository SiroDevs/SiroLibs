              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi oryatwaza otyo aha kiro kya mushanju eky'okwo kwezi ahabw'omuntu weena oshobize nari omushema; okwo nikwo muririhiirira hekalu.",
          "type": "text",
