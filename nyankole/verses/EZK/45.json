              },
              "items": [
                {
                  "text": "29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ku muribagana ensi kuba obuhunguzi bwanyu, muryaihiraho MUKAMA omugabo gw'ekicweka ky'ensi, kibe ekyanga ekirikwera, oburaingwa bwakyo mikono obukumi bubiri n'enkumi itaano, n'obukiika bwakyo mikono obukumi bubiri; ekyo kyanga kyona oku kiingana kibe ekirikwera. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.1",
            "verseOrgIds": [
              "EZK.45.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 45:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.42.16+EZK.42.17+EZK.42.18+EZK.42.19+EZK.42.20"
              },
              "items": [
                {
                  "text": "Ezk 42:16-20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.35.2"
              },
              "items": [
                {
                  "text": "Kub 35:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omuri ekyo kyanga ekibanja kya mikono magana ataano oburaingwa n'obukiika mikono magana ataano kiryaba obutaaho oburikwera bwehinguririzibwe akataajuure k'obukiika bwa mikono makumi ataano. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.2",
            "verseOrgIds": [
              "EZK.45.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 45:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.41.4"
              },
              "items": [
                {
                  "text": "Ezk 41:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi omuri ekyo kyanga ekirikwera ogyeremu ekicweka kya mikono obukumi bubiri n'enkumi itaano oburanigwa, n'obukiika mikono kakumi ahu Obutaaho oburikwera buryombekwa, nigwo Omwanya gurikwera munonga. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.3",
            "verseOrgIds": [
              "EZK.45.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 45:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.48.11"
              },
              "items": [
                {
                  "text": "Ezk 48:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ogwo mwanya guryaba ekicweka ky'ensi ekirikwera, kibe eky'abanyamurwa abaheereza omu Butaaho burikwera, kandi abahika MUKAMA kumuheereza; guryaba omwanya gw'okutamu Omwanya ogurikwera munonga. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.4",
            "verseOrgIds": [
              "EZK.45.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 45:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.48.13"
              },
              "items": [
                {
                  "text": "Ezk 48:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ekindi kicweka kya mikono obukumi bubiri n'enkumi itaano oburaingwa, n'obukiika mikono kakumi, kiryaba eky'Abaleevi, abaheerereza omuri hekalu, kibe ekyabo eky'okwombekamu endembo z'okutuuramu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.5",
            "verseOrgIds": [
              "EZK.45.5"
            ]
          }
        }
      ]
    },
    {
