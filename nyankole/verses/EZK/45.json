                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.22.3"
              },
              "items": [
                {
                  "text": "Yer 22:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Oku nikwo Mukama RUHANGA arikugamba naagira ati: Imwe banyiginya ba Israeli 'mwe, nimurekyere aho! Mwiheho omwaga n'okuhata; mukore eby'oburyo n'eby'okuhikiirira; murekyere aho kubinga abantu bangye omu bibanja byabo; nikwo Mukama RUHANGA arikugira. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.9",
            "verseOrgIds": [
              "EZK.45.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 45:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.19.36"
              },
              "items": [
                {
                  "text": "Lev 19:36",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mugire eminzaani ehikire, eefa ehikire, n'encuro ehikire. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.10",
            "verseOrgIds": [
              "EZK.45.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 45:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eefa n'encuro bibe eby'orugyero rumwe; encuro egiibwemu ekicweka kya ikumi kya homeri, na eefa nayo ekicweka kimwe kya ikumi kya homeri; homeri nayo ebi niyo yaaguma neeba eky'okurengyesa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.11",
            "verseOrgIds": [
              "EZK.45.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 45:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.30.13"
              },
              "items": [
                {
                  "text": "Kur 30:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Shekeli eryabamu geera makumi abiri; shekeli itaano zibe shekeli itaano buzima, shekeli ikumi zibe shekeli ikumi buzima, kandi miina yaanyu eingane shekeli makumi ataano.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.12",
            "verseOrgIds": [
              "EZK.45.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 45:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.12",
            "verseOrgIds": [
              "EZK.45.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 45:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Egi niyo mpongano ei muriguma nimuhonga; ekicweka kimwe kya mukaaga kya eefa y'engano ekiihirwe omuri buri homeri; na kimwe kya mukaaga kya eefa ya sayriri omuri buri homeri, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.13",
            "verseOrgIds": [
              "EZK.45.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 45:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'encuro y'amajuta eyaatairweho, kimwe kya ikumi ky'enjoga omuri buri kooru (kooru emwe erimu enjoga ikumi, nk'oku kiri omuri homeri emwe); ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.14",
            "verseOrgIds": [
              "EZK.45.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 45:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.1.4"
              },
              "items": [
                {
                  "text": "Lev 1:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kandi muhongye entaama emwe omuri buri busyo bw'entaama magana abiri. Emiryango ya Israeli yoona nikwo erihonga etyo, empongano y'esaano, ebitambo by'okwotsya, n'empongano z'okusiima ahabw'obusingye, kugirihiirira; nikwo Mukama RUHANGA arikugira. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.15",
            "verseOrgIds": [
              "EZK.45.15"
            ]
          }
        },
