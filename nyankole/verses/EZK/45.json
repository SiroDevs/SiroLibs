            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ahari ekyo kiro omugabe aryareeta enimi nto ahabwe n'ahabw'abantu b'omu nsi boona, kuba empongano y'ekibi. ",
          "type": "text",
          "attrs": {
