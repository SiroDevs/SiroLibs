                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi buri izooba omuri ebyo biro mushanju by'obugyenyi aryahongyera MUKAMA enimi mushanju n'empaya z'entaama mushanju ezitaine kamogo kuba ekitambo ky'okwotsya; kandi buri izooba ahongye empaya y'embuzi kuba empongano y'ebibi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.23",
            "verseOrgIds": [
              "EZK.45.23"
            ]
          }
        },
