            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima yangira ati: Mwana w'omuntu, aga magufa n'enju yoona eya Israeli. Reeba, nibagira bati: Amagufa gaitu goomire, titukiine matsiko; tubeereire kimwe encuubwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.11",
            "verseOrgIds": [
              "EZK.37.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
