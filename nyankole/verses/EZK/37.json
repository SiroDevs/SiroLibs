                "loc": "EZK.36.27"
              },
              "items": [
                {
                  "text": "Ezk 36:27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.36.28"
              },
              "items": [
                {
                  "text": "28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi ndyabatamu Omwoyo wangye, mube abahuriire, mbate omu nsi yaanyu y'obuzaarwa; haza obwo nibwo murimanya ku nyowe MUKAMA niinye naakigambire kandi nkakikora; nikwo MUKAMA arikugira.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.14",
            "verseOrgIds": [
              "EZK.37.14"
            ]
          }
        }
