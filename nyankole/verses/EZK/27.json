              "type": "text"
            }
          ]
        },
        {
          "text": " Aba Tarushiishi bakaba bashuubura naiwe ahabw'obutungi bwawe bwingi obw'emiringo yoona; bareeta efeeza, ebyoma, amabaati na risasi, babihingisa ebyawe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.12",
            "verseOrgIds": [
              "EZK.27.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 27:13"
          },
          "items": [
