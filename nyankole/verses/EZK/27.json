              "items": [
                {
                  "text": "Byak 12:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Aba Yuda n'ab'omu nsi ya Israeli bakaba bashuubura naiwe; eby'obushuubuzi byawe babihingisa engano, emizeituuni, emitiini, obwoki, amajuta n'emibazi y'okutamba obuhuta. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.17",
            "verseOrgIds": [
              "EZK.27.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 27:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba Damasiko bakaba bashuubura naiwe ahabw'ebintu byawe kuba bingi munonga, n'obutungi bwawe kuba bwingi kandi obw'emiringo yoona; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.18",
            "verseOrgIds": [
              "EZK.27.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 27:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.30.23"
              },
              "items": [
                {
                  "text": "Kur 30:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.30.24"
              },
              "items": [
                {
                  "text": "24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " eby'obushuubuzi byawe babihingisa viinyo ya Helebooni, ebyoya by'entaama ebirikwera, viinyo ya Uzali, ebyoma, kasiya na kaane. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.19",
            "verseOrgIds": [
              "EZK.27.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 27:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba Dedani bakaba bahingisa naiwe emyenda y'amatandiiko g'aha mbaraasi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.20",
            "verseOrgIds": [
              "EZK.27.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 27:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.60.7"
              },
              "items": [
                {
                  "text": "Isa 60:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abaharabu n'abanyiginya ba Kedari boona nibo waabiare okunda kuguraho abaana b'entaama, empaya z'entaama, n'embuzi; ezo nizo baabaire bahingisa naiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.21",
            "verseOrgIds": [
              "EZK.27.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 27:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.72.15"
              },
              "items": [
                {
                  "text": "Zab 72:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.60.6"
              },
              "items": [
                {
                  "text": "Isa 60:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abashuubuzi ba Sheeba na Raama bakaba bahsuubura naiwe; eby'obushuubuzi byawe bakaba babihingisa emigaju y'emiringo yoona n'obubaane bwona obw'obuguzi bwingi, n'ezaabu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.22",
            "verseOrgIds": [
              "EZK.27.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 27:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba Harani, Kaana, Edeni, Ashuri na Kilumaadi, bakaba bashuubura naiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.23",
            "verseOrgIds": [
              "EZK.27.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 27:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo bo bakaba bakureetera emyenda mirungi munonga, emyenda ya bururu n'ey'amabara gacwereraine, n'ebirago by'ehuuzi z'amabara ebikomesiibwe emigoye eyogosire; ebyo nibyo baabaire bakuguza. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.24",
            "verseOrgIds": [
              "EZK.27.24"
            ]
          }
        },
