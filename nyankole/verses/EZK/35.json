                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.48.35"
              },
              "items": [
                {
                  "text": "48:35",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ahabw'okugira oti: Amahanga ago gombi n'ensi ezo zombi biryaba ebyangye, tubikubuure (n'obu MUKAMA araabe yaabaire atwireyo); ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.35.10",
            "verseOrgIds": [
              "EZK.35.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 35:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.35.15"
              },
              "items": [
                {
                  "text": "Ezk 35:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " nikyo nyowe MUKAMA ndikwerahirira ningira nti: Ndyakutwaza nk'ekiniga n'eihari ebi waayorekire oku biri, ninkutura rwango ei waabagiriire, kandi ndyayemanyisa omuriimwe omu bunaku obu ndibacwereramu emanja. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.35.11",
            "verseOrgIds": [
              "EZK.35.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 35:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekirirugamu oryamanya ku nyowe MUKAMA naahuriire ebijumo byawe byona, ebi waajumire ebibungo bya Israeli noogira oti: Bihindwirwe amatongo, byatuheebwa kubirya. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.35.12",
            "verseOrgIds": [
              "EZK.35.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 35:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi mukanyekuzaho, orurimi rwanyu rwankanyisaho ebigambo, naabihurira. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.35.13",
            "verseOrgIds": [
              "EZK.35.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 35:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.65.13"
              },
              "items": [
                {
                  "text": "Isa 65:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.65.14"
              },
              "items": [
                {
                  "text": "14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Oku nikwo Mukama RUHANGA arikugamba naagira ati: Ndyakuhindura amatongo, ensi yoona ebone kwesiima. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.35.14",
            "verseOrgIds": [
              "EZK.35.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 35:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.36.5"
              },
              "items": [
                {
                  "text": "Ezk 36:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nk'oku waayesiimire ahabw'obuhunguzi bw'enju ya Israeli kuba amatongo, naiwe nikwo ndikugira, okaba amatongo. Iwe rushozi Seiri na Edomu yoona ahu erikugarukira, muryaba amatongo. Haza obwo nibwo barimanya ku ndi MUKAMA.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.35.15",
            "verseOrgIds": [
              "EZK.35.15"
            ]
          }
        }
      ]
