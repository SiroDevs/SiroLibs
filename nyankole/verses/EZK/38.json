                {
                  "text": "Isa 8:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yeteekateekye, kandi ogume oyeteekateekire, iwe n'amahe goona agahurwire kandi agakwehinguririize, obe omurinzi waago. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.7",
            "verseOrgIds": [
              "EZK.38.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
