                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.24.22"
              },
              "items": [
                {
                  "text": "Isa 24:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima y'ebiro bingi oryahuruzibwa; omu myaka ey'aha muheru oryahurura, oteere egyo nsi eyaabaire ecwekyereziibwe rurara, bwanyima ekagarurwa omu buteeka, ekatuurwamu abantu abataarwirwe omu mahanga maingi, bakaza omu bibungo bya Israeli ebyabaire biri amatongo; abo bantu bakaihwa omu mahanga, mbwenu batwire buhooro boona oku baingana. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.8",
            "verseOrgIds": [
              "EZK.38.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 38:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.28.2"
              },
              "items": [
                {
                  "text": "Isa 28:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.4.13"
              },
              "items": [
                {
                  "text": "Yer 4:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Oryainamuka, oije ori nk'eihunga; oryaba nk'ekicu ekishwekire ensi, iwe n'amahe gaawe goona n'amahanga maingi agariba gari hamwe naiwe.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.9",
            "verseOrgIds": [
              "EZK.38.9"
            ]
          }
        }
