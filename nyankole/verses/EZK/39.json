                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nimwija kurya enyama z'amamanzi, munywe eshagama y'abagabe b'omu nsi; murye enyama z'empaya z'entaama, ez'abaana baazo, ez'embuzi, n'ez'enimi zoona ez'ebishaju eza Bashani; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.18",
            "verseOrgIds": [
              "EZK.39.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 39:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "nimwija kurya ebishaju, okuhitsya obu muraigute, munywe eshagama okuhitsya obu muraasinde aha bugyenyi bw'ebitambo, obu ndikubatebeekanisiza. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.19",
            "verseOrgIds": [
              "EZK.39.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 39:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi nimwija kwigutira aha meeza yangye embaraasi n'abarikuzigyenderaho hamwe n'amamanzi n'abarwani b'emiringo yoona; nikwo Mukama RUHANGA arikugira.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.20",
            "verseOrgIds": [
              "EZK.39.20"
            ]
