                "loc": "PSA.76.3"
              },
              "items": [
                {
                  "text": "Zab 76:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ku orihikayo, ndyateera obuta bwawe oburi omu mukono gwawe gwa bumosho, mbukunagise, n'emyambi yaawe eri omu mukono gwawe gwa buryo ngigwise ahansi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.3",
            "verseOrgIds": [
              "EZK.39.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 39:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
