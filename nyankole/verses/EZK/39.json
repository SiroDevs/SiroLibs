                "loc": "EZK.32.4"
              },
              "items": [
                {
                  "text": "Ezk 32:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.38.21"
              },
              "items": [
                {
                  "text": "38:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Oryagwa aha bibungo bya Israeli, iwe n'amahe gaawe n'amahanga agu oriba oine, nkugaburire amahungu g'emiringo yoona n'enyamaishwa mbi, bikugaashe, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.4",
            "verseOrgIds": [
              "EZK.39.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 39:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "ogwe omu bwerere; ahabw'okuba niinye naakigamba; nikwo Mukama RUHANGA arikugira. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.5",
            "verseOrgIds": [
              "EZK.39.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
