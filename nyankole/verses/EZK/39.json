            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "AMO.1.4"
              },
              "items": [
                {
                  "text": "Amo 1:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi ndyayohereza omuriro, gwotsye Magoogi n'abantu abatwire buhooro omu birwa, bamanye ku ndi MUKAMA.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.6",
            "verseOrgIds": [
              "EZK.39.6"
            ]
          }
        }
