            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.46.9"
              },
              "items": [
                {
                  "text": "Zab 46:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Obwo abariba batwire omu ndembo za Israeli baryashohora, bahembe eby'okurwanisa, bisye, engabo enkye n'empango, amata n'emyambi, ebikoni n'amacumu, bamare emyaka mushanju nibabyotsya; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.9",
            "verseOrgIds": [
              "EZK.39.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 39:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.33.1"
              },
              "items": [
                {
                  "text": "Isa 33:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " tibaryetenga kusheenya omu ishwa, n'obu kwakuba okukonda ebiti omu kibira; ahabw'okuba baryahemba eby'okurwanisa byabo; baryatwara ebintu by'abaatwaire ebyabo, banyagye abaabanyagire; nikwo Mukama RUHANGA arikugira.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.10",
            "verseOrgIds": [
              "EZK.39.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
