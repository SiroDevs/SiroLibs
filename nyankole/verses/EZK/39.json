          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EZK 39:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "obwo nibwo barimanya ku ndi MUKAMA Ruhanga waabo, ahabw'okuba nkabareetera kutwarwa omu mahanga bari enkwatwa, bwanyima naabataaruura, naabagarura omu nsi yaabo ey'obuzaarwa. Tindigira n'omwe ou naatsiga omu mahanga obundi; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.28",
            "verseOrgIds": [
              "EZK.39.28"
            ]
          }
