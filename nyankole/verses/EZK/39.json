            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ku ndi heza kubaiha omu mahanga, naabagarura, naabataaruura omu nsi z'abazigu baabo, naayorekyera okwera kwangye omuribo omu maisho g'amahanga, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.27",
            "verseOrgIds": [
              "EZK.39.27"
            ]
          }
        },
        {
