            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima ndyamanyisa eiziina ryangye eririkwera omu bantu bangye Israeli; tindireka iziina ryangye kugaruka kujumwa; kandi amahanga garyamanya ku ndi MUKAMA Orikwera omuri Israeli. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.7",
            "verseOrgIds": [
              "EZK.39.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 39:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
