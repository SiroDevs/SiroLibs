          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batyo ab'enju ya Israeli baryamanya ku ndi MUKAMA Ruhanga waabo, okutandikira ahari eryo izooba n'okugumizamu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.22",
