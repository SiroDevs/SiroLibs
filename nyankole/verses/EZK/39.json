                "loc": "EZK.21.7"
              },
              "items": [
                {
                  "text": "Ezk 21:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Reeba, nibiija, kandi biryabaho; eryo niryo izooba eri naagambire; nikwo Mukama RUHANGA arikugira.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.8",
            "verseOrgIds": [
              "EZK.39.8"
            ]
          }
        }
      ]
