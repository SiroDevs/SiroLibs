            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ndyakuhindura, nkwebembeze, nkwihe omu bicweka by'aha muheru gw'obukiizi-bwa-bumohso, nkwinamure, nkuhitsye omu bibungo bya Israeli; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.2",
            "verseOrgIds": [
              "EZK.39.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 39:3"
          },
          "items": [
