                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ku bariba batwire buhooro bataine orikubatiinisa, baryayebwa enshoni zaabo ahabw'ebicumuro byona ebi bancumwireho. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.26",
