              "type": "text"
            }
          ]
        },
        {
          "text": "Paulo na Siluwaano na Timoseo twabahandiikira imwe ab'ekanisa y'Abatesalonika abari omuri Ruhanga Isheboona na Mukama waitu Yesu Kristo; ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.1.1",
            "verseOrgIds": [
              "2TH.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2TH 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "nitubendeza embabazi n'obusingye ebirikuruga ahari Ruhanga Tataitwe na Mukama waitu Yesu Kristo.",
          "type": "text",
          "attrs": {
            "verseId": "2TH.1.2",
            "verseOrgIds": [
              "2TH.1.2"
            ]
          }
        }
      ]
    },
