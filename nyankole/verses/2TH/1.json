                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kitushemereire kusiima Ruhanga obutoosha, ahabwanyu, B'eishe-emwe, nk'oku kishemereire, ahabw'okuba okwikiriza kwanyu nikweyongyera munonga, kandi n'okukunda kwa buri omwe omuriimwe oku murikukundana ni kwingi buzima. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.1.3",
            "verseOrgIds": [
              "2TH.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2TH 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.1.9"
              },
              "items": [
                {
                  "text": "Kush 1:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " N'ahabw'ekyo naitwe nitwehimbisa ahabwanyu omu makanisa ga Ruhanga, nitusiima okugumisiriza kwanyu n'okwikiriza kwanyu omu kuhiigwa n'omu kubonabona ebi mwemeire; ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.1.4",
            "verseOrgIds": [
              "2TH.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2TH 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TH.2.12"
              },
              "items": [
                {
                  "text": "1 Tes 2:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " (ebyo nibyoreka ku Ruhanga acwa emanja z'oburyo,) ngu mubone kuteekateekwa kuba abashemereire obukama bwa Ruhanga, obu murikubonabonera; ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.1.5",
            "verseOrgIds": [
              "2TH.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2TH 1:6"
          },
          "items": [
