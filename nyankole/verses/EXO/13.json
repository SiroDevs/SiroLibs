          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA yaagambira Musa ati: ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.1",
            "verseOrgIds": [
              "EXO.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.8.16"
              },
              "items": [
                {
                  "text": "Kub 8:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.18.15"
              },
              "items": [
                {
                  "text": "18:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.2.23"
              },
              "items": [
                {
                  "text": "Luk 2:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Munyereze emijigaijo yoona; ekiigura-nda kyona omu Baisareli, yaaba mu bantu nari omu matungo, n'ekyangye. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.2",
            "verseOrgIds": [
              "EXO.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa yaagambira abantu ati: Muryaguma mwijukye eizooba eri, eri mwarugiireho Misri, omu nju y'obuhuuku; ahakuba MUKAMA akabaiha omu mwanya ogwo n'omukono gw'amaani; hatarigira omugaati gwona ogutumbisiibwe ogwariibwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.3",
            "verseOrgIds": [
              "EXO.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.23.15"
              },
              "items": [
                {
                  "text": "Kur 23:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Eizooba eri ery'omu kwezi Abibu niryo mwaza kurugiramu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.4",
            "verseOrgIds": [
              "EXO.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi MUKAMA ku arikuhitsya omu nsi y'Abanyakanaani, n'Abahiiti n'Abaamori n'Abahiivi n'ey'Abayebusi, ensi ey'amate n'obwoki, ei yaagambiire baashwenkuru naarahira kugikuha, oryaguma oijukye kukora omugyenzo ogu omu kwezi oku. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.5",
            "verseOrgIds": [
              "EXO.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oryamara ebiro mushanju noorya emigaati etatumbisiibwe; kandi aha kiro kya mushanju haryabaho obugyenyi bw'ekiro kikuru kya MUKAMA. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.6",
            "verseOrgIds": [
              "EXO.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuri ebyo biro mushanju muryaguma nimurya emigaati etatumbisiibwe; mutarireebwa mwine omugaati gwona ogutumbisiibwe, n'obu kyakuba ekitumbisa kyona, omu nsi yaanyu yoona. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.7",
            "verseOrgIds": [
              "EXO.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ahari eryo izooba oryagambira omwana waawe oti: Eki ninkikora ahabw'eki MUKAMA yankoreire, obu naaruga omuri Misri. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.8",
            "verseOrgIds": [
              "EXO.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.6.8"
              },
              "items": [
                {
                  "text": "Bir 6:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.23.5"
              },
              "items": [
                {
                  "text": "Mat 23:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi kiryakubeera akamanyiso aha mukono gwawe, n'ekiijutsyo ahagati y'amaisho gaawe, ekiragiro kya MUKAMA kirekye kukuruga omu kanwa; ahakuba MUKAMA akakwiha omuri Misri n'omukono gw'amaani. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.9",
            "verseOrgIds": [
              "EXO.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'ahabw'ekyo oryaguma oijukye omugyenzo ogu omu bunaku bwagwo buri mwaka.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.10",
            "verseOrgIds": [
              "EXO.13.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.10",
            "verseOrgIds": [
              "EXO.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi MUKAMA ku arikuhitsya omu nsi ya Kanaani, yaagikuha, nk'oku yaaraganiise na baashwenkuru naarahira, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.11",
            "verseOrgIds": [
              "EXO.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "oryashoroorera MUKAMA ekiigura-nda kyona. Emijigaijo yoona ey'omu matungo gaawe, ekyetwa ekishaija kyona, kiryaba ekya MUKAMA. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.12",
            "verseOrgIds": [
              "EXO.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omujigaijo gwona ogw'endogoya oryagucunguza omwana gw'entaama; ku oriba otarikwenda kugucungura, oryaguhenda ebitsya; kandi emijigaijo yoona ey'abantu omu baana baawe oryagicungura.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.13",
            "verseOrgIds": [
              "EXO.13.13"
            ]
          }
        }
      ]
    },
