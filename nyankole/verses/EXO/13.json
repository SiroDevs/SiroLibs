              },
              "items": [
                {
                  "text": "21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi omwana waawe ku arikubuuza omu biro ebiriija naagira ati: Eki nikimanyisa ki? oryamugarukamu oti: MUKAMA akatwiha omuri Misri, omu nju y'obuhuuku, n'omukono gw'amaani; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.14",
            "verseOrgIds": [
              "EXO.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "ahakuba Faraho akaba agangaire, ayangire kuturekura, MUKAMA yaita emijigaijo yoona omu nsi ya Misri, ey'abantu n'ey'amatungo. Nikyo ntambirira MUKAMA ebiigura-nda byona, ebyetwa ebishaija; kwonka emijigaijo yoona omuri batabani bangye, nkagicungura. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.15",
            "verseOrgIds": [
              "EXO.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eki kiryaba akamanyiso aha mukono gwawe, n'ekiijutsyo aha buso bwawe; ahabw'okuba MUKAMA akatwiha omuri Misri n'omukono gw'amaani.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.16",
            "verseOrgIds": [
              "EXO.13.16"
            ]
          }
        }
      ]
