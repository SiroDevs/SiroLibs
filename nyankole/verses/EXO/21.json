          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "ku ariimuka, yaashotookyera aha kibango, owaamuteire atarigiibwaho orubanja, kureka arihe ebiro ebi amazire arwaire, kandi amuragurize okuhitsya obu arikira gye.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.19",
            "verseOrgIds": [
