              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.2.28+1KI.2.29+1KI.2.30+1KI.2.31+1KI.2.32+1KI.2.33+1KI.2.34"
              },
              "items": [
                {
                  "text": "1 Bag 2:28-34",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omuntu ku aritaahirira mutaahi we, yaamureebya, yaamwita nkana, omwihe aha itambiro ryangye, aitwe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.14",
            "verseOrgIds": [
              "EXO.21.14"
            ]
          }
        }
