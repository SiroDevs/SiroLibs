              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu ku baritongana, omwe yaateera mugyenzi we eibaare nari entomi, ataafa, kwonka yaaguma aha kishegu arwaire, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.18",
            "verseOrgIds": [
              "EXO.21.18"
            ]
          }
        },
        {
