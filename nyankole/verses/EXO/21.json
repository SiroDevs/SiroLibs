          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abashaija ku barirwana, baasaasa omukazi oine enda, enda yaarugamu, kwonka ataagira kundi oku yaaba, owaamusaasa aryariha iba w'ogwo mukazi, nk'oku arimurihisa; kandi aryariha, nk'oku abaramuzi barisiima. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.22",
            "verseOrgIds": [
              "EXO.21.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
