          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "okwotsya kuhoorerwe okundi, obuhuta buhoorerwe obundi, n'okuteerwa kuhoorerwe okundi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.25",
            "verseOrgIds": [
              "EXO.21.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 21:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuntu ku ariteera omuhuuku we nari omuzaana we, yaamwata eriisho, aryamurekura, arugye omu buhuuku ahabw'eryo riisho. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.26",
            "verseOrgIds": [
              "EXO.21.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 21:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ku ariteera omuhuuku we nari omuzaana we, yaamuhigura eriino, aryamurekura, arugye omu buhuuku ahabw'eryo riino.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.27",
            "verseOrgIds": [
              "EXO.21.27"
            ]
          }
        }
      ]
    },
    {
