          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuntu ku aritsiga ekiina kyashami, nari yaarima ekiina, ataakitinda, ente nari endogoya yaakigwamu, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.33",
            "verseOrgIds": [
              "EXO.21.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 21:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "mukama w'ekyo kiina aryagiriha, ahe mukama waayo empiiha, kandi omutumbi gwayo guryaba ogwa mukama w'ekiina.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.34",
            "verseOrgIds": [
              "EXO.21.34"
            ]
          }
        }
      ]
    },
