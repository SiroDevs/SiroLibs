              "items": [
                {
                  "text": "Mat 5:38",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " eriisho ririhwe erindi, eriino ririhwe erindi, ekiganja kirihwe ekindi, ekigyere kirihwe ekindi, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.24",
            "verseOrgIds": [
              "EXO.21.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
