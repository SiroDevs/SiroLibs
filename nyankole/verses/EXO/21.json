        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.35.11"
              },
              "items": [
                {
                  "text": "Kub 35:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.20.2"
              },
              "items": [
                {
                  "text": "Yos 20:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka omuntu ku ariita ondi atamugwereire, beitu kyaruga ahari Ruhanga kumugwa omu mikono, ndyakuteeraho omwanya, ogu ashemereire kuhungiramu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.13",
            "verseOrgIds": [
              "EXO.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 21:14"
          },
          "items": [
