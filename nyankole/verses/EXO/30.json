            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.16",
            "verseOrgIds": [
              "EXO.30.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 30:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi MUKAMA yaagambira Musa ati: ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.17",
            "verseOrgIds": [
              "EXO.30.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 30:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oryaheesha ekinaabiro omu miringa, n'ekibunu kyakyo obe nimwo waakiheesha, kibe eky'okunaabiramu; okite ahagati y'Eihema ry'okubugaabuganiramu n'eitambiro; kandi okitemu amaizi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.18",
            "verseOrgIds": [
              "EXO.30.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 30:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.52.11"
              },
              "items": [
                {
                  "text": "Isa 52:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.10.22"
              },
              "items": [
                {
                  "text": "Heb 10:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omwo nimwo Arooni n'abatabani bariguma nibanaabira engaro zaabo n'ebigyere byabo; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.19",
            "verseOrgIds": [
              "EXO.30.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 30:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "baaba nibaza kutaaha omu ihema ry'okubugaabuganiramu, bagume banaabe amaizi batakaafa, nari baaba nibaza aha itambiro okukora omurimo gwabo gw'okwotsya empongano ey'okwotsya omu muriro ey'okuhongyera MUKAMA; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.20",
            "verseOrgIds": [
              "EXO.30.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 30:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "banaabe engaro zaabo n'ebigyere byabo batakaafa; kibabeere ekiragiro ky'ebiro byona, we n'oruzaaro rwe omu busingye bwabo bwona.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.21",
            "verseOrgIds": [
              "EXO.30.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
