                "loc": "2TI.3.9"
              },
              "items": [
                {
                  "text": "9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abafumu nabo baateeraho kureeta enda n'oburogo bwabo, tibaabaasa; enda zaanyiga aha bantu n'aha matungo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.18",
            "verseOrgIds": [
              "EXO.8.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.6.3"
              },
              "items": [
                {
                  "text": "1 Sam 6:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.6.9"
              },
              "items": [
                {
                  "text": "9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.11.20"
              },
              "items": [
                {
                  "text": "Luk 11:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abo bafumu baagira Faraho bati: Mbwenu ho oru n'orukumu rwa Ruhanga. Omutima gwa Faraho gwagangaara, tiyaabahurira nk'oku MUKAMA yaagambire.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.19",
            "verseOrgIds": [
              "EXO.8.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.19",
            "verseOrgIds": [
              "EXO.8.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA yaagambira Musa ati: Ogurukye kare omu kasheeshe, oyemerere omu maisho ga Faraho, naija kuba naaza aha mugyera, omugire oti: Oku nikwo MUKAMA arikugamba naagira ati: Reka abantu bangye bagyende, bampeereze. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.20",
            "verseOrgIds": [
              "EXO.8.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku oraabe otabarekwire, niinyija kukuteeza emizinga y'eshohera, iwe n'abaheereza baawe n'abantu baawe, zitaahe n'omu maju gaawe; kandi n'amaju g'Abanyamisri nigaija kwijura n'emizinga y'eshohera, zishwekye n'omwanya ogubarimu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.21",
            "verseOrgIds": [
