            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.26",
            "verseOrgIds": [
              "ACT.11.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ACT 11:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu biro ebyo baanabi aba Yerusaalemu baija Antiokia. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.27",
            "verseOrgIds": [
              "ACT.11.27"
            ]
          }
        },
