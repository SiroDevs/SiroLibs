              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.5",
            "verseOrgIds": [
              "ACT.23.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.6",
            "verseOrgIds": [
              "ACT.23.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.4.2"
              },
              "items": [
                {
                  "text": "Byak 4:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Paulo ku yaayetegyereize ngu ekicweka ekimwe n'eky'Abasadukaayo, ekindi n'eky'Abafarisaayo, yaagamba n'eiraka rihango omu ishengyero ati: Beene waitu, ndi Omufarisaayo, kandi omwana w'Abafarisaayo; nincwerwa orubanja ababw'okuturwa amatsiko agu nyine aha kuzooka kw'abafu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.6",
            "verseOrgIds": [
              "ACT.23.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku yaaherize kugamba atyo, haabaho okutongana kw'Abafarisaayo n'Abasadukaayo; eishengyero ryayebaganisamu habiri. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.7",
            "verseOrgIds": [
              "ACT.23.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.22.23"
              },
              "items": [
                {
                  "text": "Mat 22:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ahakuba Abasadukaayo bagira ngu tihariho kuzooka, n'obu yaakuba maraika, n'obu gwakuba omuzimu; kwonka Abafarisaayo bo babiikiriza byona. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.8",
            "verseOrgIds": [
              "ACT.23.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haabaho okuyoogoorekana kwingi; abamwe ab'omu kigombe ky'abahandiiki b'Abafarisaayo baayemerera, baahakana nibagira bati: Tihariho kibi eki twareeba aha mushaija ogu. Shana omwoyo nari maraika akaaba amugambiire? ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.9",
            "verseOrgIds": [
              "ACT.23.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Empaka zaabo ku zaabire ez'amaani maingi munonga, omukuru w'engabo yaatiina ngu baaza kutaanyagura Paulo, nikwo kuragiira abaserukare kushuuma kumubaihamu n'amaani, n'okumureeta omu kigo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.10",
            "verseOrgIds": [
              "ACT.23.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
