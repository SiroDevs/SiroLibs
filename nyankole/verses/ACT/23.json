                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ku yaaherize kugishoma, yaabuuza eishaza eri yaarugiremu; ku yaamanyire ngu n'owa Kilikia, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.34",
            "verseOrgIds": [
              "ACT.23.34"
            ]
          }
        },
        {
