          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batyo abaserukare batwara Paulo, nk'oku baaragiirwe, baamuhitsya Antipatiri nyekiro. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.31",
            "verseOrgIds": [
              "ACT.23.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ACT 23:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ju bwaseesire, abaserukare baamutsigira ab'embaraasi kugumizamu nawe, bo baagaruka omu kigo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.32",
            "verseOrgIds": [
              "ACT.23.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ACT 23:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi abo, ku baahikire Kaisarea, baahereza Omutegyeki ebaruha, baamumurikira na Paulo, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.33",
            "verseOrgIds": [
              "ACT.23.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "ACT 23:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
