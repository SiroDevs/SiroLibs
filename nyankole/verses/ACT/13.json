              },
              "items": [
                {
                  "text": "13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ogwo ku yaamwihireho, yaayemeka Daudi kuba omugabe waabo, ou yaahamize, naagira ati: Mboine Daudi mutabani wa Yese, omuntu ori nk'omutima gwangye oku gurikwenda; aryakora byona ebi ndikukunda. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.22",
            "verseOrgIds": [
              "ACT.13.22"
            ]
          }
        },
