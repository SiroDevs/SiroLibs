              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.7.12"
              },
              "items": [
                {
                  "text": "2 Sam 7:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omu ruzaaro rw'omushaija ogwo, nimwo Ruhanga yaihiire Israeli Omujuni, Yesu, nk'oku yaaraganiise. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.23",
            "verseOrgIds": [
              "ACT.13.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 13:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu ogwo atakaizire, Yohaana kabuurira Abaisraeli boona okubatizibwa okw'okweteisa. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.24",
            "verseOrgIds": [
              "ACT.13.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 13:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.1.20"
              },
              "items": [
                {
                  "text": "Yoh 1:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi Yohaana ku yaabaire naamariiriza orugyendo rwe, yaagira ati: Nimugira ngu, mba oha? Nyowe tindi We. Kwonka hariho orikwija enyima yangye, ou ntashemereire kuyuzya enkaito ze.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.25",
            "verseOrgIds": [
              "ACT.13.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 13:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.25",
            "verseOrgIds": [
              "ACT.13.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 13:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "B'eishe-emwe, abaana b'oruganda rwa Abrahamu, n'abari omuriimwe abarikutiina Ruhanga, ekigambo ky'okujunwa oku niitwe kyatumirweho. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.26",
            "verseOrgIds": [
              "ACT.13.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ACT 13:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.3.17"
              },
              "items": [
                {
                  "text": "Byak 3:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mumanye ngu abaabaire batwire Yerusaalemu n'abategyeki baabo, ahabw'okutamumanya, n'obu kwakuba okushoborokyerwa ebyagambirwe baanabi, ebirikushomwa buri Sabato, bakabihikiiriza, obu baamusingisa orubanja. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.27",
            "verseOrgIds": [
              "ACT.13.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 13:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi n'obu baraabe baabuzire orubanja rw'okumwitsa, bakashaba Pilaato ngu aitwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.28",
            "verseOrgIds": [
              "ACT.13.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ACT 13:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku baaherize kuhikiiriza byona ebyamuhandiikirweho, baamuhanura aha muti, baamuziika omu kituuro. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.29",
            "verseOrgIds": [
              "ACT.13.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ACT 13:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonka Ruhanga yaamuzoora omu bafu; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.30",
            "verseOrgIds": [
              "ACT.13.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ACT 13:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "yaamara ebiro bingi naareebwa abo abaarugire nawe Galilaaya nibaza Yerusaalemu; nibo baakareebi abarikumuhamya hati omu bantu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.31",
            "verseOrgIds": [
              "ACT.13.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ACT 13:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naitwe tubareeteire ebigambo birungi eby'endagaano, ei Ruhanga yaaraganiise baatatenkuriitwe, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.32",
            "verseOrgIds": [
              "ACT.13.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ACT 13:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.2.7"
              },
              "items": [
                {
                  "text": "Zab 2:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kandi endagaano egyo akagihikiiriza ahariitwe, abaana baabo, obu yaazoora Yesu; nk'oku kyahandiikirwe omuri zaaburi eya kabiri ngu, Ori Omwana wangye, eri izooba naakuzaara. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.33",
            "verseOrgIds": [
              "ACT.13.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "ACT 13:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.55.3"
              },
              "items": [
                {
                  "text": "Isa 55:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nk'oku yaamuzoire omu bafu okutagaruka mu kujunda, akagira ati: Ndyabaha emigisha erikwera kandi etahwaho eya Daudi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.34",
            "verseOrgIds": [
              "ACT.13.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "ACT 13:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.16.10"
              },
              "items": [
                {
                  "text": "Zab 16:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi akagambira n'omuri zaburi endiijo ati: Toriikiriza Orikwera waawe kujunda. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.35",
            "verseOrgIds": [
              "ACT.13.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "ACT 13:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimumanya Daudi ku yaaherize kuhikiiriza enaama ya Ruhanga omu biro bye, yaagwejegyera, yaaziikwa na baishenkuru, yaajunda; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.36",
            "verseOrgIds": [
              "ACT.13.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "ACT 13:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwonka Ogwo ou Ruhanga yaazoire tarajunzire.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.37",
            "verseOrgIds": [
              "ACT.13.37"
            ]
          }
        }
      ]
    },
