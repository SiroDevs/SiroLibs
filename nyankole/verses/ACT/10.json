                "loc": "1SA.16.7"
              },
              "items": [
                {
                  "text": "1 Sam 16:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Petero yaatandika kugamba, naagira ati: Buzimazima naayetegyereza ku Ruhanga atashoroora mu bantu; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.34",
            "verseOrgIds": [
              "ACT.10.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "ACT 10:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.9.31"
              },
              "items": [
                {
                  "text": "Yoh 9:31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kureka omu mahanga goona orikumutiina, akakora eby'okuhikiirira, ogwo niwe arikusiimwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.35",
            "verseOrgIds": [
              "ACT.10.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "ACT 10:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NAM.1.15"
              },
              "items": [
                {
                  "text": "Nah 1:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ekigambo ky'engiri y'obusingye obu tuhairwe ahabwa Yesu Kristo, (niwe Mukama wa boona,) Ruhanga akakyoherereza Abaisraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.36",
            "verseOrgIds": [
              "ACT.10.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "ACT 10:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekigambo ekyo naimwe nimukimanya, nikyo kyagambirwe omuri Buyudaaya yoona, okutandikira Galilaaya, bwanyima y'okubuurira kwa Yohaana okw'okubatiza; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.37",
            "verseOrgIds": [
              "ACT.10.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "ACT 10:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.61.1"
              },
              "items": [
                {
                  "text": "Isa 61:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " nikigamba ebya Yesu owa Nazareesi, oku Ruhanga yaamushukireho Omwoyo Orikwera n'amaani, akagyendagyenda naakora ebirungi, naakiza boona abaabaire nibaitwa kubi Sitaane; ahabw'okuba Ruhanga akaba ari hamwe nawe. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.38",
            "verseOrgIds": [
              "ACT.10.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "ACT 10:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naitwe turi baakareebi by'ebyo byona ebi yaakozire omu nsi y'Abayudaaya n'omuri Yerusaalemu. Yesu ogwo bakamwita, bamuhanikire aha muti; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.39",
            "verseOrgIds": [
              "ACT.10.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "ACT 10:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwonka Ruhanga yaamuzoora aha kiro kya kashatu yaamworeka butunu, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.40",
            "verseOrgIds": [
              "ACT.10.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "ACT 10:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "ti mu bantu boona, kureka ahari baakareebi, abaatoorainwe Ruhanga ira, nibo itwe abaariire kandi abaanyweire nawe aherize kuzooka omu bafu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.41",
            "verseOrgIds": [
              "ACT.10.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "ACT 10:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.14.9"
              },
              "items": [
                {
                  "text": "Rom 14:9",
                  "type": "text"
                }
