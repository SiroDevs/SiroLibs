                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.27.1"
              },
              "items": [
                {
                  "text": "Byak 27:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omuri Kaisarea hakaba harimu omushaija orikwetwa Koruneelio, omukuru w'abaserukare b'omu mutwe ogurikwetwa Italiano; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.1",
            "verseOrgIds": [
              "ACT.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "akaba ari omunyadiini, orikutiina Ruhanga hamwe n'ab'omu ka ye boona, owaabaire ahwera abooro n'ebintu bye bingi, kandi naashaba Ruhanga obutoosha. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.2",
            "verseOrgIds": [
              "ACT.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eizooba rimwe aha shaaha nk'eya mwenda akareeba maraika wa Ruhanga omu kworekwa naija ah'ari, yaamugira ati: Koruneelio. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.3",
            "verseOrgIds": [
              "ACT.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "We yaamuhanga amaisho aine obwoba, yaamubuuza ati: N'enki, Mukama wangye? Yaamugarukamu ati: Okushaba kwawe n'obuhwezi bwawe bitembire okuba ekiijutsyo ahari Ruhanga. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.4",
            "verseOrgIds": [
              "ACT.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbwenu tuma abashaija Yoopa, beeteyo omuntu Simooni orikwetwa Petero, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.5",
            "verseOrgIds": [
              "ACT.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "orikuraara owa Simooni omuhazi w'empu, enju ye eri aha rubaju rw'enyanja. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.6",
            "verseOrgIds": [
              "ACT.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maraika owaabarize nawe ku yaagyenzire, Koruneelio yaatuma abambari be babiri, n'omuserukare omunyadiini w'omuri abo abaabaire bamuheereza obutoosha; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.7",
            "verseOrgIds": [
              "ACT.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "ku yaaherize kubateekyerereza byona, yaabatuma Yoopa.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.8",
            "verseOrgIds": [
              "ACT.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.8",
            "verseOrgIds": [
              "ACT.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu kasheeshe, abo abaatumirwe ku baabaire bahika haihi na tauni egyo, bakiri omu rugyendo rwabo, Petero yaatembas aha utwe gw'enju kushaba aha shaaha nk'eya muakaga; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.9",
            "verseOrgIds": [
              "ACT.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "yaagira enjara, yaayenda kurya; ku baabaire nibaihura, yaaba nk'orikuroota; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.10",
            "verseOrgIds": [
              "ACT.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "yaareeba eiguru rikinguukire, n'ekintu ekirikushusha nk'omwenda muhango munonga, ogukwatsirwe aha nshonda ina, nikishuuma ahansi, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.11",
            "verseOrgIds": [
              "ACT.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "kirimu enganda zoona z'enyamaishwa n'ebirikugyendesa enda n'ebirikuguruka omu mwanya. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.12",
            "verseOrgIds": [
              "ACT.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaahurira eiraka nirimugira riti: Petero, imuka, oite orye. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.13",
            "verseOrgIds": [
              "ACT.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.4.14"
              },
              "items": [
                {
                  "text": "Ezk 4:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.11.1+LEV.11.2+LEV.11.3+LEV.11.4+LEV.11.5+LEV.11.6+LEV.11.7+LEV.11.8+LEV.11.9+LEV.11.10+LEV.11.11+LEV.11.12+LEV.11.13+LEV.11.14+LEV.11.15+LEV.11.16+LEV.11.17+LEV.11.18+LEV.11.19+LEV.11.20+LEV.11.21+LEV.11.22+LEV.11.23+LEV.11.24+LEV.11.25+LEV.11.26+LEV.11.27+LEV.11.28+LEV.11.29+LEV.11.30+LEV.11.31+LEV.11.32+LEV.11.33+LEV.11.34+LEV.11.35+LEV.11.36+LEV.11.37+LEV.11.38+LEV.11.39+LEV.11.40+LEV.11.41+LEV.11.42+LEV.11.43+LEV.11.44+LEV.11.45+LEV.11.46+LEV.11.47"
              },
              "items": [
                {
                  "text": "Lev 11:1-47",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka Petero yaagira ati: Ngaaha, Mukama wangye; ahabw'okuba tinkaryaga kintu kyona ekirikuzira nari ekitashemeire. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.14",
            "verseOrgIds": [
              "ACT.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.15.11"
              },
              "items": [
                {
                  "text": "Mat 15:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Eiraka ryagaruka ryamugambira obwa kabiri riti: Eki Ruhanga yashemeize, otarikihindura ekirikuzira. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.15",
            "verseOrgIds": [
              "ACT.10.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebyo byabaho bityo kashatu; ahonaaho ekintu ekyo kyagarurwa omu iguru.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.16",
            "verseOrgIds": [
              "ACT.10.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.16",
            "verseOrgIds": [
              "ACT.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Petero ku yaabaire arimbagiriirwe, akishobeirwe amakuru g'okworekwa okwo oku yaareeba, abashaija abo, abatumirwe Koruneelio, ku baaherize kuhabuza enju ya Simooni, baija, baayemerera aha irembo, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.17",
            "verseOrgIds": [
              "ACT.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "baayeta nibabuuza bati: Simooni orikwetwa Petero naaraara aha? ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.18",
            "verseOrgIds": [
              "ACT.10.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Petero ku yaabaire naakiteekateeka aha kworekwa, Omwoyo yaamugira ati: Reeba, abashaija bashatu nibakusherura; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.19",
            "verseOrgIds": [
              "ACT.10.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "imuka oshuume, ogyende nabo otarikubanganisa; ahakuba niinye naabatuma. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.20",
            "verseOrgIds": [
              "ACT.10.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Petero nikwo kushuuma, akabahika, akabagira ati: Niinye ou murikusherura. Muhuutsirwe ki? ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.21",
            "verseOrgIds": [
              "ACT.10.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 10:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baamugira bati: Koruneelio, omukuru w'abaserukare, omushaija ohikiriire, orikutiina Ruhanga, kandi orikusiimwa eihanga ry'Abayudaaya ryona, aragiirwe maraika orikwera kukweta kwija omu ka ye, ngu ahurire ebi oraamugambire. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.22",
            "verseOrgIds": [
              "ACT.10.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 10:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.11.12"
              },
              "items": [
                {
                  "text": "Byak 11:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yaabataasya omu nju, yaabaraaza. Ku bwaseesire, Petero yaimuka, yaagyenda nabo hamwe n'ab'eishe-emwe bamwe aba Yoopa.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.23",
            "verseOrgIds": [
              "ACT.10.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 10:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.23",
            "verseOrgIds": [
              "ACT.10.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 10:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aha kiro ekindi baataaha Kaisarea. Baashanga Koruneelio abategyereize n'abanywani be buzima. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.24",
            "verseOrgIds": [
              "ACT.10.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 10:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Petero ku yaabaire naakitaaha, Koruneelio yaamubugana, yaamugwa aha bigyere, yaamuramya. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.25",
            "verseOrgIds": [
              "ACT.10.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 10:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
