    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "ACT 10:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.43",
            "verseOrgIds": [
              "ACT.10.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "ACT 10:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Petero ku yaabaire naakigamba ebigambo ebyo, Omwoyo Orikwera yaashuuma ahari boona abaabaire nibahurira ekigambo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.44",
            "verseOrgIds": [
              "ACT.10.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "ACT 10:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaikiriize ab'omu bashazirwe, abaizire na Petero boona, baatangaara ahabw'Abanyamahanga nabo kushukwaho ekiconco ky'Omwoyo Orikwera. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.45",
            "verseOrgIds": [
              "ACT.10.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "ACT 10:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.19.6"
              },
              "items": [
                {
                  "text": "Byak 19:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ahakuba bakabahurira nibagamba “omu ndimi”, nibahimbisa Ruhanga. Petero nikwo kubuuza ati: ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.46",
            "verseOrgIds": [
              "ACT.10.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "ACT 10:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu aba abaaheebwa Omwoyo Orikwera nkaitwe, hariho orikubaasa kubaima amaizi ngu batabatizibwa? ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.47",
            "verseOrgIds": [
              "ACT.10.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "ACT 10:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaaragiira ngu babatizibwe omu iziina rya Yesu Kristo. Bwanyima baamweshengyereza kumarayo ebiro bikye.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.48",
            "verseOrgIds": [
              "ACT.10.48"
            ]
          }
        }
      ]
