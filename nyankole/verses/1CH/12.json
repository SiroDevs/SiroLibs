              },
              "items": [
                {
                  "text": "1 Bus 12:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ababenyamiini, abaine obuzaare na Saulo, bakaba bari enkumi ishatu, ahabw'okuba okuhitsya omu bunaku obwo abaingi omuribo bakaba bahamiire aha nju ya Saulo; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.29",
            "verseOrgIds": [
              "1CH.12.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CH 12:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaefuraimu abashaija b'amaani amamanzi, ba rugambwa omu maju ga baishenkurubo bari obukumi bubiri na magana munaana, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.30",
            "verseOrgIds": [
              "1CH.12.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CH 12:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
