                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Egi niyo mibaro y'emitwe y'engabo ezaashangire Daudi Heburooni, ziine eby'okurwanisa, kumukubuurira obugabe bwa Saulo, nk'ekigambo kya MUKAMA oku kyabaire kiri. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.23",
            "verseOrgIds": [
              "1CH.12.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 12:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abayuda abaabaire baine engabo n'amacumu, bakaba bari obukumi mukaaga na magana munaana abeeteekateekyeire orugamba; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.24",
            "verseOrgIds": [
              "1CH.12.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 12:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abasimeoni abashaija abarwani b'amaani omu rugamba bari enkumi mushanju na igana; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.25",
            "verseOrgIds": [
              "1CH.12.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CH 12:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaleevi enkumi ina na magana mukaaga; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.26",
            "verseOrgIds": [
              "1CH.12.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 12:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehoyaada owaabaire ari omwebembezi w'enju ya Arooni yaija n'engabo enkumi ishatu na magana mushanju; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.27",
            "verseOrgIds": [
              "1CH.12.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 12:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.8.17"
              },
              "items": [
                {
                  "text": "2 Sam 8:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.6.8"
              },
              "items": [
                {
                  "text": "1 Bus 6:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Zadoki omutsigazi w'amaani emanzi yaija n'abakuru b'engabo makumi abiri na babiri ab'enju ya ishe. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.28",
            "verseOrgIds": [
              "1CH.12.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CH 12:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.2.8"
              },
              "items": [
                {
                  "text": "2 Sam 2:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.2.9"
              },
              "items": [
                {
