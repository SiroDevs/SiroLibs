              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahakuba abantu bakaba baija ahari Daudi buri izooba kumuha emikono, okuhitsya obu baabaire eihe rihango, nk'eihe rya Ruhanga.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.22",
