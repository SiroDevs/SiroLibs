            "sid": "1CH 21:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu bunaku obwo Daudi ku yaareebire MUKAMA amugarukiiremu aha mbuga ya Orunaani Omuyebusi, yaatambirayo ebitambo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.28",
            "verseOrgIds": [
              "1CH.21.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CH 21:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.16.39"
              },
              "items": [
                {
                  "text": "1 Bus 16:39",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ahakuba Eihema rya MUKAMA, eri Musa yaakoreire omu ihamba, n'eitambiro ry'ebitambo by'okwotsya omu biro ebyo bikaba biri Gibeoni omu mwanya mukru gw'okuramizamu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.29",
            "verseOrgIds": [
              "1CH.21.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CH 21:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonka Daudi tiyaabaasa kuza omu maisho gaaryo kwehanuuza ahari Ruhanga, ahabw'okuba akaba atiinire rurara ya maraika wa MUKAMA.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.30",
