              "items": [
                {
                  "text": "1 Bus 28:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka ekigambo kya MUKAMA kyanyizira, nikigira kiti: Okasheesha eshagama nyingi, waarwana engamba nyingi; toryombekyera iziina ryangye nju, ahabw'okuba okasheesha eshagama nyingi omu maisho gangye. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.8",
            "verseOrgIds": [
              "1CH.22.8"
            ]
          }
        },
