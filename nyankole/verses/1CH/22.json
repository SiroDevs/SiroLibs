              "type": "text"
            }
          ]
        },
        {
          "text": " Yaagira Sulemaani ati: Mwana wangye, nkashangwa nkiine aha mutima kwombekyera eiziina rya MUKAMA Ruhanga wangye enju. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.7",
