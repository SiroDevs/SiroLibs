            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " n'ebiti by'emyereez ebitarikubarwa; ahabw'okuba Abasidoni n'Abatuuro bakareetera Daudi emyereezi mingi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.4",
            "verseOrgIds": [
              "1CH.22.4"
            ]
          }
        },
