        },
        {
          "text": "Bwanyima yaayeta omutabani Sulemaani, yaamwehanangiriza kwombekyera MUKAMA Ruhanga wa Israeli enju. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.6",
