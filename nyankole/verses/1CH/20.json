                "loc": "2SA.12.26"
              },
              "items": [
                {
                  "text": "2 Sam 12:26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omu kutandika kw'omwaka, omu bunaku obu abagabe baabaire bahururiramu, Yoabu akahurura, ayebembeireeihe, yaacwekyereza ensi y'Abaamoni, yaagyenda, yaagota Rabba; kwonka Daudi akaba ayetsigariire Yerusaalemu. Yoabu yaateera Rabba, yaagicwekyereza. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.1",
            "verseOrgIds": [
              "1CH.20.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.12.30"
              },
              "items": [
                {
                  "text": "2 Sam 12:30",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.12.31"
              },
              "items": [
                {
                  "text": "31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Daudi yaiha omugabe waabo ekirunga aha mutwe; yaashanga kiine oburemeezi bw'etalanta emwe y'ezaabu, kandi kikaba kirimu eibaare ry'obuguzi bwingi; baakita ha mutwe gwa Daudi. Kandi omuri orwo rurembo yaanyagamu eminyago mingi munonga. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.2",
            "verseOrgIds": [
              "1CH.20.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaihamu abantu abaabaire barimu, yaabashara n'empango; okwo nikwo Daudi yaagizire endembo zoona ez'Abaamoni. Bwanyima Daudi n'engabo zoona baagaruka Yerusaalemu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.3",
            "verseOrgIds": [
              "1CH.20.3"
            ]
          }
        }
      ]
    },
