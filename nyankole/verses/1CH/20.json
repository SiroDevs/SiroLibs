            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.21.18+2SA.21.19+2SA.21.20+2SA.21.21+2SA.21.22"
              },
              "items": [
                {
                  "text": "2 Sam 21:18-22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima y'ebyo haabaho orugamba n'Abafilistia Gezeri; omuri orwo rugamba Sibekai owa Husha yaita Sipai ow'omuri baijukuru b'ebikaaka; Abafilistia baacwa eishaija. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.4",
            "verseOrgIds": [
              "1CH.20.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haagaruka haabaho orugamba n'Abafilistia; Elihanani mwene Yairi yaitu Lahumi, murumuna wa Goliasi owa Gaasi, ou orubango rw'eicumu rye rwabaire nirwigangana empimbi ei barukiraho emyenda. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.5",
            "verseOrgIds": [
              "1CH.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi haagaruka haabaho orugamba Gaasi. Okwo hakaba hariyo omushaija muraingwa munonga, owaabaire aine enkumu mukaaga ahari buri ngaro, n'enkumu z'ebigyere mukaaga ahari buri kigyere, zoona makumi abiri na ina; nawe akaba ari ow'omuri baijukuru b'ebikaaka. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.6",
            "verseOrgIds": [
              "1CH.20.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.2.13"
              },
              "items": [
                {
                  "text": "1 Bus 2:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ku yaahigire Abaisraeli, Yonasaani mwene Shimei mukuru wa Daudi yaamwita. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.7",
            "verseOrgIds": [
              "1CH.20.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo boona bakaba bari baijukuru b'ebikaaka bya Gaasi; baitwa Daudi n'abashaija be.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.8",
            "verseOrgIds": [
              "1CH.20.8"
            ]
          }
        }
      ]
    }
