              },
              "items": [
                {
                  "text": "Bir 28:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " MUKAMA ow'amahe naagira ati: Ku muraayangye kuhurira, mwayanga kuta omutima aha kuhaisa eiziina ryangye ekitiinisa, niinyija kubooherereza omukyeeno, n'emigisha yaanyu ngikyeene; kandi buzimazima naaherize kugikyeena, ahabw'okuba mwangire kukita aha mutima. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.2",
            "verseOrgIds": [
              "MAL.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
