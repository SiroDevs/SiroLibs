            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mbwenu imwe banyamurwa 'mwe, ekiragiro eki n'ekyanyu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.1",
            "verseOrgIds": [
