                "loc": "MAL.3.9"
              },
              "items": [
                {
                  "text": "Mal 3:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.26.14"
              },
              "items": [
                {
                  "text": "Lev 26:14",
