          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAL 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.3.45"
              },
              "items": [
                {
                  "text": "Kub 3:45",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.25.12"
              },
              "items": [
                {
                  "text": "25:12",
                  "type": "text"
