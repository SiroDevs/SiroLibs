          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.29.14"
              },
              "items": [
                {
                  "text": "Kur 29:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
