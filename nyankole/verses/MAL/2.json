                "loc": "NAM.3.6"
              },
              "items": [
                {
                  "text": "Nah 3:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Reeba, ndyahana oruzaaro rwanyu, mbasiigye amasha g'empongano zaanyu ahamaisho, mbacwe omu maisho gangye. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.3",
            "verseOrgIds": [
              "MAL.2.3"
            ]
          }
        },
        {
