              "items": [
                {
                  "text": "Efe 4:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Twena titwine Tataitwe omwe? Ruhanga owaatuhangire t'omwe? Ahabw'enki buri muntu ti mwesigwa ahari mugyenzi we, nitushiisha endagaano ya baatatenkuriitwe? ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.10",
            "verseOrgIds": [
              "MAL.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAL 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZR.9.2"
              },
              "items": [
                {
                  "text": "Ezr 9:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yuda tabaire mwesigwa, kandi omuri Israeli na Yerusaalemu hakozirwemu ebirikunugwa; ahabw'okuba Yuda ahagaire Omwanya gwa MUKAMA ogurikwera, ogu arikukunda, yaashwera muhara wa ruhanga w'enduga-mahanga. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.11",
            "verseOrgIds": [
              "MAL.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAL 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuntu orikutwaza atyo, nkaabaasibwa ki MUKAMA amumariraho kimwe omuntu weena ow'okuhamya, ow'okugarukamu, nari ow'okuhongyera MUKAMA ow'amahe, omu mahema ga Yakobo!",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.12",
            "verseOrgIds": [
              "MAL.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
