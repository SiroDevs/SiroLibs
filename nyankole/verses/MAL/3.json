              "items": [
                {
                  "text": "Byak 7:51",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Okwiha omu biro bya baashwenkuriimwe mutuura nimuteishuka nimureka ebiragiro byangye, mutarikubyorobera. Mungarukire, naanye niinyija kubagarukira; nikwo MUKAMA ow'amahe arikugira. Kwonka nimugira muti: Tugarukye tuta? ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.7",
            "verseOrgIds": [
              "MAL.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAL 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.13.10"
              },
              "items": [
                {
                  "text": "Neh 13:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omuntu akaabaasa kwima Ruhanga ebye? Kwonka imwe nimuunyima ebyangye. Haza mugira muti: Nitukwima tuta? Nimuunyima ebicweka bya kimwe kya ikumi n'emitoijo. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.8",
            "verseOrgIds": [
              "MAL.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAL 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukyeenirwe omukyeeno, ahabw'okuba imwe eihanga ryona nimuunyima ebyangye. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.9",
            "verseOrgIds": [
              "MAL.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAL 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
