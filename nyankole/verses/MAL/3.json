                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Reeba, nintuma entumwa yangye kutebeekanisa omuhanda omu maisho gangye, kandi Mukama, ou murikusherura, aryaija omuri hekalu ye kitaraariire; n'entumwa y'endagaano ei murikushemerererwa, reeba neija; nikwo MUKAMA ow'amahe arikugira. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.1",
            "verseOrgIds": [
              "MAL.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAL 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.4.4"
              },
              "items": [
                {
                  "text": "Isa 4:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOL.2.11"
              },
              "items": [
                {
                  "text": "Yoel 2:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mbwenu n'oha oribaasa kwemera eizooba eri ariiziraho, kandi ku arireebwa, n'oha oribaasa kwemereraho? Ahabw'okuba ni nk'omuriro gw'omuheesi ogurikushemeza, kandi nka sabuuni y'omwozi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.2",
            "verseOrgIds": [
              "MAL.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAL 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.1.25"
              },
              "items": [
                {
                  "text": "Isa 1:25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.13.9"
              },
              "items": [
                {
                  "text": "Zek 13:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Aryashutama nk'orikushemeza efeeza akagimaramu enkamba, ashemeze Abaleevi, abagire nk'oku bamara enkamba omu zaabu n'efeeza, okuhitsya obu barihongyera MUKAMA empongano zihikire. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.3",
            "verseOrgIds": [
              "MAL.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAL 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.20.40"
              },
              "items": [
                {
                  "text": "Ezk 20:40",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Obo nibwo empongano za Yuda na Yerusaalemu zirishemeza MUKAMA, nk'oku zaabaire zimushemeza omu biro bya ira, omu myaka eyaahingwire.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.4",
            "verseOrgIds": [
              "MAL.3.4"
            ]
          }
        }
      ]
    },
