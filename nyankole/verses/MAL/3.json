                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima ndyabairira haihi kucwa orubanja; ndyaba mushinja orikurahuka kushinja abarogi, abashambani, abarikurahira ebishuba, abarikwima abakozi ebihembo byabo, abarikwita kuba abafaakazi n'efuuzi, abarikwita emanja z'abanyamahanga n'abatarikuntiina; nikwo MUKAMA ow'amahe arikugira. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.5",
            "verseOrgIds": [
              "MAL.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAL 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.102.27"
              },
              "items": [
                {
                  "text": "Zab 102:27",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LAM.3.22"
              },
              "items": [
                {
                  "text": "Tonz 3:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ahabw'okuba nyowe MUKAMA timpinduka; nikyo imwe beene Yakobo mutarikumarirwaho.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.6",
            "verseOrgIds": [
              "MAL.3.6"
            ]
          }
        }
      ]
