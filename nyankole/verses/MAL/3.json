          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.62.4"
              },
              "items": [
                {
                  "text": "Isa 62:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEP.3.19"
              },
              "items": [
                {
                  "text": "Zef 3:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi obwo amahanga goona garyabeeta abahiiriirwe, ahabw'okuba muryaba ensi y'okushemererwa; nikwo MUKAMA ow'amahe arikugira.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.12",
            "verseOrgIds": [
              "MAL.3.12"
            ]
          }
        }
      ]
