          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaakuratwa Benui, mwene Henadaadi, yaahunduuza ekindi kicweka, okuruga aha nju ya Azaria okuhika aha Keekubo. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.24",
