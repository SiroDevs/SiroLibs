              "type": "text"
            }
          ]
        },
        {
          "text": " Haataho Baruki mwene Zabai, yaahunduuza ekindi kicweka, okwiha aha Keekubo okuhika aha rwigi rw'enju ya Eliashibu omunyamurwa omukuru. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.20",
            "verseOrgIds": [
