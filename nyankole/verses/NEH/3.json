            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batabani ba Hasena baayombeka eirembo ry'eby'enyanja; baabyara enkingi zaaryo, baatamu enyigi zaaryo, ebyoma bayryo by'okurikingisa, n'empimbi zaaryo. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.3",
            "verseOrgIds": [
              "NEH.3.3"
            ]
          }
        },
        {
          "name": "verse",
