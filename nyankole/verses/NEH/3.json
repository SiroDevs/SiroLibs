                "loc": "EZR.8.33"
              },
              "items": [
                {
                  "text": "Ezr 8:33",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.3.21"
              },
              "items": [
                {
                  "text": "Neh 3:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
