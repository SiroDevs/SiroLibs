          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haataho Benyamiini na Hashubu, baahunduuza ahashungaine n'enju yaabo. Haataho Azaria mwene Maaseya, mwijukuru wa Anania, yaahunduuza aha rubaju rw'enju ye. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.23",
            "verseOrgIds": [
              "NEH.3.23"
            ]
          }
        },
        {
