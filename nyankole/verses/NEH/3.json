        },
        {
          "text": " Bwanyima Eliashibu omunyamurwa omukuru yaimuka na beene ishe abanyamurwa, baayombeka eirembo ry'entaama. Baarishoroora, baaritamu enyigi. Bwanyima baashoroora orugo okuhika aha munaara gwa Hamea, n'okuhika aha munaara gwa Hananeeli. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.1",
            "verseOrgIds": [
              "NEH.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NEH 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haakurataho aba Yeriko; nabo baakuratwa Zakuri mwene Imuri omu kwombeka.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.2",
            "verseOrgIds": [
              "NEH.3.2"
            ]
          }
        }
