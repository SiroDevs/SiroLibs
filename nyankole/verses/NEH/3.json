            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Haataho Meremoosi mwene Uriya, mwijukuru wa Hakozi, yaahunduuza ekindi kicweka, okwiha ahari orwo rwigi okuhika aha muheru gw'egyo nju. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.21",
            "verseOrgIds": [
              "NEH.3.21"
            ]
          }
        },
        {
