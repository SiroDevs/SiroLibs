              "NEH.2.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZR.8.32"
              },
              "items": [
                {
                  "text": "Ezr 8:32",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ntyo naaza Yerusaalemu, naamarayo ebiro bishatu. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.11",
            "verseOrgIds": [
              "NEH.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NEH 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima naimuka nyekiro n'abantu bakye; kandi tinaagambira muntu weena eki Ruhanga wangye antaire aha mutima kukorera Yerusaalemu. Kandi nkaba ntaine ndiijo mbaraasi kureka ei naagyendeireho. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.12",
            "verseOrgIds": [
              "NEH.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NEH 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.1.3"
              },
              "items": [
                {
                  "text": "Neh 1:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ekyo kiro naashohora, naaraba omu irembo ry'omu ruhanga, naahika aha iziba ry'Ekijoka, n'aha irembo ry'orubungo, naayetegyereza engo za Yerusaalemu, ezaabaire zisheenyukire, n'amarembo gaarwo agaabaire gacwekyereziibwe n'omuriro. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.13",
            "verseOrgIds": [
              "NEH.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NEH 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntyo naagumizamu naahika aha irembo ry'enshuro, n'aha kiyanja ky'omugabe, kwonka naabura ah'okurabya embaraasi ei naabaire ntembire. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.14",
            "verseOrgIds": [
              "NEH.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NEH 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima ekyo kiro nainamuka orwo ruhanga, naayetegyereza orwo rugo; bwanyima naakuba, naaraba omu irembo ry'oruhanga, naagarukayo. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.15",
            "verseOrgIds": [
              "NEH.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NEH 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi abategyeki tibaamanya i naaba ngiire, nari eki naaba ninkora; kandi nkaba ntakagambiire Bayudaaya, abanyamurwa, abakungu, abatware, nari abandi abaabaire bari ab'okukora omurimo.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.16",
            "verseOrgIds": [
              "NEH.2.16"
            ]
          }
        }
      ]
    },
