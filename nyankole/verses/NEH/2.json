              },
              "items": [
                {
                  "text": "Neh 4:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.6.1"
              },
              "items": [
                {
                  "text": "6:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.13.4"
              },
              "items": [
                {
                  "text": "13:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.13.28"
              },
              "items": [
                {
                  "text": "28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka Sanibalati Omuhoroni na Tobia omuhuuku Omuamoni, ku baahuriire ngu hariho oizire kukorera Abaisraeli ebirungi, kyabagwisa kubi mononga.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.10",
            "verseOrgIds": [
              "NEH.2.10"
            ]
          }
        }
      ]
    },
    {
