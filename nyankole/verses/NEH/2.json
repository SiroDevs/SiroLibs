        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.9",
            "verseOrgIds": [
              "NEH.2.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZR.8.22"
              },
              "items": [
                {
                  "text": "Ezr 8:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima naaza aha bamashaza ba seeri y'Omugyera, naabaha amabaruha g'omugabe. Kandi omugabe akaba ayohereize abakuru b'engabo n'ab'aha mbaraasi kunshagara. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.9",
            "verseOrgIds": [
              "NEH.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NEH 2:10"
          },
          "items": [
