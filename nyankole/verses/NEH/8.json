              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Baashanga bihandiikirwe omu Biragiro, ebi MUKAMA yaaragiire naaraba omuri Musa, ngu Abaisraeli baryaguma nibaraara omu nsiisira omu bugyenyi bw'okwezi kwa mushanju, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.14",
            "verseOrgIds": [
              "NEH.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
