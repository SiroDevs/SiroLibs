              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.16.16"
              },
              "items": [
                {
                  "text": "Bir 16:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kandi baryaguma babirangye, babibuzye omu ndembo zaabo zoona n'omuri Yerusaalemu, nibagira bati: Mwirooko muze omu bibungo, mureete amataagi g'emizeituuni, n'ag'emizeituuni ey'omu ishwa, n'ag'emikadasi, n'ag'emikindo, n'ag'ebiti by'amababi gashakambire, mukore ensiisira, nk'oku kyahandiikirwe. ",
