            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ezera yaasiima MUKAMA Ruhanga omukuru, n'abantu boona baikiriza nibaimutsya emikono yaabo, nibagira bati: Amiina, Amiina; bainika emitwe yaabo, baaramya MUKAMA bajuumaire ahansi. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.6",
            "verseOrgIds": [
              "NEH.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NEH 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.35.3"
              },
              "items": [
                {
                  "text": "2 Bus 35:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi Yeshua, Baani, Sherebia, Yamiina, Akubu, Shabetai, Hodia, Maaseya, Kelita, Azaria, Yozabaadi, Hanani, Pelaaya, Abaleevi, baahwera abantu kwetegyereza Ebiragiro; obwo abantu boona bari omu myanya yaabo.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.7",
            "verseOrgIds": [
              "NEH.8.7"
            ]
          }
        },
        {
