          "items": [
            {
              "text": "67",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima Zaakaria ishe yaijura Omwoyo Orikwera, yaahanuura naagira ati:",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.67",
            "verseOrgIds": [
              "LUK.1.67"
            ]
