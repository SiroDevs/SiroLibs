        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.66",
            "verseOrgIds": [
              "LUK.1.66"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "67",
