          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.3.10",
            "verseOrgIds": [
              "2PE.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2PE 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebyo byona ku biraabe biri eby'okuyaga bityo, mureebe oku mushemereire kuba abarikwera kandi abarikutiina Ruhanga omu mitwarize yaanyu, ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.3.11",
            "verseOrgIds": [
              "2PE.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2PE 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.34.4"
              },
              "items": [
                {
                  "text": "Isa 34:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " nimutegyereza ekiro kya Mukama, kandi nimukora eby'okukirahutsya; ahabw'ekyo kiro eiguru riryayokibwa rihweho, kandi eby'obuhangwa biryayagibwa omuriro mwingi. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.3.12",
            "verseOrgIds": [
              "2PE.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2PE 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.21.1"
              },
              "items": [
                {
                  "text": "Kush 21:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.21.27"
              },
              "items": [
                {
                  "text": "27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka itwe nitutegyereza eiguru eritsya n'ensi ensya ebituurwamu okuhikiirira, nk'oku yaaraganiise.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.3.13",
            "verseOrgIds": [
              "2PE.3.13"
            ]
          }
        }
