                "loc": "PSA.90.4"
              },
              "items": [
                {
                  "text": "Zab 90:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka, B'eishe-emwe, mutaryebwa ekigambo eki, ngu ekiro kimwe ahari Mukama ni nk'emyaka rukumi, kandi n'emyaka rukumi ni nk'ekiro kimwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.3.8",
            "verseOrgIds": [
              "2PE.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2PE 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.2.4"
              },
              "items": [
                {
                  "text": "1 Tim 2:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mukama tatuuzayo ki yaaraganiise, nk'abamwe oku barikuteekateeka, kureka agumisiriza ahabwanyu, atarikwenda muntu weena kuhwerekyerera, kureka naayenda ngu boona bahikye aha kweteisa. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.3.9",
            "verseOrgIds": [
              "2PE.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2PE 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TH.5.2"
              },
              "items": [
                {
                  "text": "1 Tes 5:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TH.5.3"
              },
              "items": [
                {
                  "text": "3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka ekiro kya Mukama kiryaija nk'omushuma; obwo eiguru riryarugaho n'okuhinda kuhango, n'ebintu by'obuhangwa biryayagibwa omuriro, kandi ensi n'ebigirimu biryayokibwa.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.3.10",
            "verseOrgIds": [
              "2PE.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
