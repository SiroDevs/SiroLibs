            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.3.13",
            "verseOrgIds": [
              "2PE.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2PE 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'ahabw'ekyo, abarikukundwa, nk'oku mutegyereize ebyo, mwezirikye abashangye mwine obusingye, mutaine ibara ribi n'obu kaakuba akamogo omu maisho ge. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.3.14",
            "verseOrgIds": [
              "2PE.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2PE 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.2.4"
              },
              "items": [
                {
                  "text": "Rom 2:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mumanye ngu okugumisiriza kwa Mukama waitu okwo nikwo kujunwa; nka mugyenzi waitu orikukundwa paulo oku yaabahandiikiire nk'obwengye obu yaahairwe oku buri, ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.3.15",
            "verseOrgIds": [
              "2PE.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2PE 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "naagamba atyo omu baruha ze zoona. Omuri ezo harimu ebigambo bimwe ebigumire kwetegyerezibwa, ebi abatarikwetegyereza n'abatahamire bakiikamya, nk'oku bagira ebyahandiikirwe ebindi, bakeereetaho okuhwerekyerera. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.3.16",
            "verseOrgIds": [
              "2PE.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2PE 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'ahabw'ekyo naimwe, abarikukundwa, nk'oku mushangirwe nimumanya ebyo, mwerinde mutahabisibwa obuhabe bw'abantu babi, mukaruga omu kuhama kwanyu. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.3.17",
            "verseOrgIds": [
              "2PE.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2PE 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kureka mukurire omu mbabazi za Mukama waitu kandi Omujuni Yesu Kristo, n'omu kumumanya. Aheebwe ekitiinisa hati n'ebiro byona. Amiina.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.3.18",
            "verseOrgIds": [
              "2PE.3.18"
            ]
          }
        }
      ]
    }
