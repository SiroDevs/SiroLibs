          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyowe Simooni Petero, omuhuuku kandi entumwa ya Yesu Kristo, naabahandiikira imwe, abaahairwe okwikiriza kw'obuguzi bwingi nk'okwaitu, omu kuhikiirira kwa Ruhanga waitu kandi Omujuni waitu Yesu Kristo; ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.1",
            "verseOrgIds": [
              "2PE.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2PE 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "embabazi n'obusingye byongyerwe omuriimwe omu kumanya Ruhanga na Yesu Mukama waitu.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.2",
            "verseOrgIds": [
              "2PE.1.2"
            ]
          }
        }
      ]
    },
    {
