              },
              "items": [
                {
                  "text": "Luk 3:23-38",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Okutondoora obukomooko bwa Yesu Kristo, Omwana wa Daudi, Omwana wa Abrahamu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.1",
            "verseOrgIds": [
              "MAT.1.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
