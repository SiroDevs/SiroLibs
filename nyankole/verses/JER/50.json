          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'ahabw'ekyo nimuhurire enaama ei MUKAMA acumire kurwanisa Babulooni, n'ebi amaririire kukora kurwansia ensi y'Abakaludaaya. Buzimazima abaana b'entaama zaabo baryakururwa batwarwe, n'eka yaabo eshoberwe munong aahabw'ebiribabaho. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.45",
            "verseOrgIds": [
              "JER.50.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
