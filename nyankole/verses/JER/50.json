                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Baryahabuza omuhanda ogurikuza Saayuuni, bataireyo amaisho, nibagira bati: Nimwije, twehitsye MUKAMA, turagaane nawe endagaano etarihwaho, kandi etaryeba.",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.5",
            "verseOrgIds": [
              "JER.50.5"
            ]
          }
        }
