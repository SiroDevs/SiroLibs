                "loc": "JER.49.26"
              },
              "items": [
                {
                  "text": "Yer 49:26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nikyo abatsigazi barigwera omu nteeraniro z'enguuto zaayo; kandi ahari eryo izooba abaserukare baayo boona baryacwekyerezibwa; nikwo MUKAMA arikugira.",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.30",
            "verseOrgIds": [
              "JER.50.30"
            ]
