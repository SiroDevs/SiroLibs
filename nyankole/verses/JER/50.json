              },
              "items": [
                {
                  "text": "Yer 25:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ahabw'okuba reeba, niinyija kwimutsya omutwe gw'amahanga mahango, ngaihe omu nsi y'aha bukiizi-bwa-bumosho, gateere Babulooni, bagitengyere orugamba, bakwatireyo abantu baayo, babatware. Emyambi yaabo ni nk'omurwani rugambwa otagaruka ngaro nsha. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.9",
            "verseOrgIds": [
              "JER.50.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 50:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
