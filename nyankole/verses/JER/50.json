          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ensi eryatetemesibwa obwaku bw'okukwatwa kwa Babulooni, eiraka ry'okuborooga kwayo rihuririrwe omu mahanga.",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.46",
