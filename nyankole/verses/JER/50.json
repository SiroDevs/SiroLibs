                {
                  "text": "Yer 25:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bukaludaaya eryanyagwa; abariginyaga boona baryahaaga; nikwo MUKAMA arikugira.",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.10",
            "verseOrgIds": [
              "JER.50.10"
            ]
          }
        }
