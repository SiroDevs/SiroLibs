                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Muhuruze abarasi boona, abananuuzi b'amata, bateere Babulooni. Mugyehinguririze ensiisira kugirwanisa; harekye kugira n'omwe owaacwa. Mugizimuurire ebirikwingana n'ebi yaakozire, mugigire nk'oku yaagizire kwona; ahabw'okuba ekagira amaryo, yaagaya MUKAMA, Orikwera wa Israeli. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.29",
            "verseOrgIds": [
              "JER.50.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JER 50:30"
          },
          "items": [
