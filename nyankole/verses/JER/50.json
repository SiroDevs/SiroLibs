            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nimuhurire eiraka ry'abarikuhunga, nibacwa kuruga omu nsi ya Babulooni, ngu babone kumanyisa omuri Saayuuni enzigu ei MUKAMA Ruhanga waitu arikuhoorera hekalu ye. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.28",
            "verseOrgIds": [
              "JER.50.28"
            ]
          }
        },
        {
