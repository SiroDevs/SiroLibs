              "type": "text"
            }
          ]
        },
        {
          "text": " Nimuhungye, murugye omuri Babulooni, murugye omu nsi y'Abakaludaaya, mube nk'empaya z'embuzi ezeebembeire obusyo; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.8",
            "verseOrgIds": [
              "JER.50.8"
            ]
          }
        },
