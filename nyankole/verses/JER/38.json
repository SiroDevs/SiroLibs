                "loc": "PSA.69.14"
              },
              "items": [
                {
                  "text": "Zab 69:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.56.3+ISA.56.4+ISA.56.5"
              },
              "items": [
                {
                  "text": "Isa 56:3-5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.8.27"
              },
              "items": [
                {
                  "text": "Byak 8:27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyiam Ebedi-meleki Omunyesiopia omukonwa, owaabaire ari omu nju y'omugabe, ku yaahuriire ngu banagire Yeremia omu kiziba obwo omugabe akaba ashutami omu irembo rya Benyamiini ",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.7",
            "verseOrgIds": [
              "JER.38.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 38:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "yaashohora, yaaruga omuri nyaruju, yaagira omugabe ati: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.8",
            "verseOrgIds": [
              "JER.38.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 38:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.11.22"
              },
              "items": [
                {
                  "text": "Yer 11:22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.14.18"
              },
              "items": [
                {
                  "text": "14:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.19.9"
              },
              "items": [
                {
                  "text": "19:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.37.21"
              },
              "items": [
                {
                  "text": "37:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nyakusinga Omugabe, abo bantu, omu bi bakozire Yeremia byona, bakozire kubi kumunaga omu kiziba; kandi naija kwitirwamu enjara, ahabw'okuba omu rurembo tihaakirimu mugaati gwona. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.9",
            "verseOrgIds": [
              "JER.38.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 38:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahonaaho omugabe yaaragiira Ebedi-meleki Omunyesiopia naamugira ati: Twara abashaija bashatu okuruga aha, mugyende mwihe nabi Yeremia omu kiziba atakafiire. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.10",
            "verseOrgIds": [
              "JER.38.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 38:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atyo Ebedi-meleki yaagyenda n'abo bashaija, yaataaha omuri nyaruju omu kishengye ekibiikwamu emyenda, baihamu obucancabari bw'emyenda n'ebijwaro bikuzire, yaabishuumisa emirunga omu kiziba, yaabiha Yeremia. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.11",
            "verseOrgIds": [
              "JER.38.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 38:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima Ebedi-meleki Omunyesiopia yaagira Yeremia ati: Ta obucancabari n'ebijwaro bikukuzire omu maahwa, orabyeho emirunga. Yeremia yaakora atyo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.12",
            "verseOrgIds": [
              "JER.38.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 38:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batyo baiha Yeremia omu kiziba n'emirunga, baamutuuhuurayo. Okuruga aho Yeremia yaaguma omu kibuga ky'abarinzi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.13",
            "verseOrgIds": [
              "JER.38.13"
            ]
          }
        }
      ]
    },
    {
