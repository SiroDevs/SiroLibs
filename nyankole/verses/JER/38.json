                "loc": "JER.32.2"
              },
              "items": [
                {
                  "text": "Yer 32:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Okuruga aho Yeremia yaaguma omu kibuga ky'abarinzi, okuhitsya aha izooba eri Yerusaalemu yaakwatiirweho.",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.28",
