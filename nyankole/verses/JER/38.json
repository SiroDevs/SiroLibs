                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.57.16"
              },
              "items": [
                {
                  "text": "Isa 57:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima omugabe Zedekia yaarahirira Yeremia omu mubonano naagira ati: Nindahira MUKAMA ohuriire owaatuhangire, tindikwija kukwita, n'obu kwakuba okukuhayo omu mikono y'abantu abarikwenda kukwita.",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.16",
            "verseOrgIds": [
              "JER.38.16"
            ]
          }
        }
      ]
    },
