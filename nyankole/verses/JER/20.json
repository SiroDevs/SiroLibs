              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi Pashuri omunyamurwa, mwene Imeri owaabaire ari omutegyeki mukuru omu nju ya MUKAMA, yaahurira Yeremia naahanuura ebigambo ebyo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.1",
            "verseOrgIds": [
              "JER.20.1"
            ]
