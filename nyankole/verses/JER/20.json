              "items": [
                {
                  "text": "Byak 16:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Pashuri ogwo yaateera nabi Yeremia, yaamuta omu nkomo ezaabaire ziri omu Irembo rya Benyamiini ery'eruguru ery'enju ya MUKAMA. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.2",
            "verseOrgIds": [
              "JER.20.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku bwaseesire, Pashuri yaiha Yeremia omu nkomo; Yeremia nikwo kumugira ati: MUKAMA tarikukweta Pashuri, kureka Magori-misabiibu, amakuru ngu “Ebirikutiinisa embaju zoona”. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.3",
            "verseOrgIds": [
              "JER.20.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.6.25"
              },
              "items": [
                {
                  "text": "Yer 6:25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ahabw'okuba oku nikwo MUKAMA arikugamba naagira ati: Reeba, ndyakugira ekirikutiinisa ahariiwe n'ahari bagyenzi baawe boona.",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.4",
            "verseOrgIds": [
              "JER.20.4"
            ]
