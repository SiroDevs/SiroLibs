          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.15.8"
              },
              "items": [
                {
                  "text": "Yos 15:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " muze omu ruhanga rwa mwene Hinoomu, aharikutaahirwa omu Irembo ry'Engusyo, orangireyo ebigambo ebi ndaakugambire, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.2",
            "verseOrgIds": [
              "JER.19.2"
            ]
          }
        },
        {
