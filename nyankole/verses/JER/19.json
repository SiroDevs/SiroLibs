                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Okwo nikwo ndigira ogu mwanya n'abagutwiremu, nkagira oru rurembo nka Tofeti; nikwo MUKAMA arikugira. ",
          "type": "text",
          "attrs": {
