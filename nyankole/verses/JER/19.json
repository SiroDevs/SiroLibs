                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ndyabariisa abaana baabo b'aboojo n'ab'abaishiki, buri muntu arye mutaahi we omu biro by'okugotwa n'eby'enaku, ezi abazigu baabo n'abaribahiiga baribareebesa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.9",
            "verseOrgIds": [
              "JER.19.9"
            ]
          }
        }
