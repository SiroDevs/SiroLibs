              "type": "text"
            }
          ]
        },
        {
          "text": " Oku nikwo MUKAMA arikugamba naagira ati: Irooko ogure orunywero aha mubumbi, otware bamwe aha bakuru b'eihanga, n'abandi aha banyamurwa abakuru, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.1",
            "verseOrgIds": [
              "JER.19.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
