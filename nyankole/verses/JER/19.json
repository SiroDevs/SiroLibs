                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " obagire oti: Oku nikwo MUKAMA ow'amahe arikugamba naagira ati: Oku nikwo ndyata aba bantu n'oru rurembo, nk'oku omunutu ayata enyungu y'omubumbi, ekarema kuhomeererwa. Abantu baryaziika omuri Tofeti ahabw'okubura ahandi hoona ah'okuziika. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.11",
            "verseOrgIds": [
              "JER.19.11"
            ]
          }
        },
