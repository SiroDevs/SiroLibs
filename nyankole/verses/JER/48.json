          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Heshibooni na Eleale nibataka; eiraka ry'okutaka kwabo nirihuririrwa Yahazi, okuruga Zoari okuhika Horonaimu na Egulaati-shelishiya. Ahabw'okuba amaizi ga Nimuriimu gatsigirweho. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.34",
            "verseOrgIds": [
              "JER.48.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JER 48:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ndyamariraho kimwe omuntu weena otambira ebitambo omu myanya mikuru ey'omuri Moabu, akooterera ruhanga we obubaane; nikwo MUKAMA arikugira. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.35",
            "verseOrgIds": [
              "JER.48.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JER 48:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikyo omutima gwangye gurikuboroogyerera Moabu nk'eiraka ry'esheegu; kandi gukaboroogyera gutyo abashaija ba kiriheresi; kandi nikyo eitungo eri baabaire baine rihwereireho.",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.36",
            "verseOrgIds": [
              "JER.48.36"
            ]
          }
        }
      ]
    },
