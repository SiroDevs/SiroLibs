                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Israeli okaba omushekyerera, omuzongoreza omutwe, obu waabaire omugambaho, nk'okwatiirwe omu bashuma.",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.27",
