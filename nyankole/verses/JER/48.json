                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Eihembe rya Moabu ricwirweho, n'omukono gwe guhendekire; nikwo MUKAMA arikugira. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.25",
            "verseOrgIds": [
              "JER.48.25"
            ]
