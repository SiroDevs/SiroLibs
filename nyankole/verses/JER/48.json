            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mumusinze, ayekuringye omu bitanaki bye, nawe ashekyererwe, ahabw'okuba ayekurize ahari MUKAMA. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.26",
            "verseOrgIds": [
