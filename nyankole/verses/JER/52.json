                "loc": "JER.1.3"
              },
              "items": [
                {
                  "text": "Yer 1:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.37.36"
              },
              "items": [
                {
                  "text": "Kut 37:36",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.25.8"
              },
              "items": [
                {
                  "text": "2 Bag 25:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima omu kwezi kwa kataano aha kiro kyakwo kya ikumi na mwenda, nigwo mwaka gwa Nebukadeneeza omugabe wa Babulooni ogwa ikumi na mwenda, Nebuzaradaani omukuru w'abarinzi, owaabaire ari omuheereza w'omugabe wa Babulooni, yaataaha omuri Yerusaalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.12",
            "verseOrgIds": [
              "JER.52.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 52:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaayotsya enju ya MUKAMA, na nyaruju y'omugabe, n'amaju ga Yerusaalemu goona; eyetwa enju mpango yoona yaagyotsya. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.13",
            "verseOrgIds": [
              "JER.52.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 52:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eihe ryona ery'Abakaludaaya, eri ogwo mukru w'abarinzi yaabaire aine, ryasheenya engo zoona ezaabaire zeehinguriririize Yerusaalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.14",
            "verseOrgIds": [
              "JER.52.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 52:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.37.13"
              },
              "items": [
                {
                  "text": "Yer 37:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi Nebuzaradaani ogwo, omukuru w'abarinzi, yaatwara bamwe aha barikukira abandi boona kuba abooro bari enkwatwa, n'ababaaire batsigaire omu rurembo, n'abaabaire beehongyeire omugabe wa Babulooni, hamwe n'abanyamyoga abaabaire batsigaire. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.15",
            "verseOrgIds": [
              "JER.52.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 52:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonka Nebuzaradaani ogwo omukuru w'abarinzi yaatsigamu abandi abarikukiza abandi obworo kuba ab'okurinda emizaabibu n'ab'okuhinga.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.16",
            "verseOrgIds": [
              "JER.52.16"
            ]
          }
        }
      ]
    },
