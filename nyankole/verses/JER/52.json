            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yehoyakiini omugabe wa Yuda ku yaabaire amazire emyaka makumi ashatu na mushanju ari omu bukwatwa, omu kwezi kwa ikumi n'abiri, aha kiro kyakwo ekya makumi abiri na bitaano, omu mwaka ogwo ogu Evili-merodaaki omugabe wa Babulooni yaatandikiiremu kutegyeka, yaiha Yehoyakiini omu kihome, yaamukuza; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.31",
            "verseOrgIds": [
              "JER.52.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JER 52:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "yaagamba gye nawe, yaamuha ekitebe ekirikukira eby'abandi bagabe abaabaire bari hamwe nawe Babulooni. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.32",
            "verseOrgIds": [
              "JER.52.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JER 52:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atyo Yehoyakiini yaajuura ebijwaro bye by'ekihome. Okuruga aho yaaguma naariira aha meeza y'omugabe ebiro byona ebi yaamazire. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.33",
            "verseOrgIds": [
              "JER.52.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JER 52:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi eby'okumutunga omugabe yaaguma naamuha omugabo ogutarikurugaho, nk'okwetenga kwe okwa buri izooba oku kwabaire kuri, ebiro byona ebi yaamazire okuhitsya obu yaafiire.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.34",
            "verseOrgIds": [
              "JER.52.34"
            ]
          }
