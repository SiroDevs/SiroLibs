            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ai bambe maawe, okanzaarira ki ndi omushaija w'empaka n'entongane aha b'omu nsi egi boona! Tihariho u ndagurize, kandi tihariho u ndeegurizeho; kwonka boona nibanjuma. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.10",
            "verseOrgIds": [
              "JER.15.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ai MUKAMA, nkaashemereire kujunwa, kuri ntarakweshengyereize kubakorera ebirungi, nari kukweshengyereza kubakiza abazigu omu biro by'enkau n'omu biro by'obusaasi! ",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.11",
            "verseOrgIds": [
              "JER.15.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.1.13"
              },
              "items": [
                {
                  "text": "Yer 1:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Hariho omuntu owaakubaasa kuhenda ekyoma, ekyoma ekirikuruga aha bukiizi-bwa-bumosho, akahenda n'omuringa?",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.12",
            "verseOrgIds": [
              "JER.15.12"
            ]
          }
        }
