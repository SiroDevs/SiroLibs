                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima MUKAMA yangira ati: N'obu Musa na Samueli baakuunyemerera omumaisho, omutima gwangye tigukaagaruka hari aba bantu. Obaanyihe omumaisho, bagyende! ",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.1",
            "verseOrgIds": [
              "JER.15.1"
            ]
          }
        },
