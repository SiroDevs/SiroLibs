                "loc": "EZK.5.12"
              },
              "items": [
                {
                  "text": "Ezk 5:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi ku baraakubuuze bati: Tuze hi? obagire oti: Oku nikwo MUKAMA arikugamba naagira ati:",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.2",
            "verseOrgIds": [
              "JER.15.2"
            ]
          }
        }
