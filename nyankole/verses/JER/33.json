              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.31.37"
              },
              "items": [
                {
                  "text": "37",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.8.22"
              },
              "items": [
                {
                  "text": "Kut 8:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Oku nikwo MUKAMA arikugamba naagira ati: Ku mwakuba nimubaasa kwita endagaano yangye, ei naaragaine na nyomushana na nyekiro birekye kubaho omu bunaku bwabyo, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.20",
            "verseOrgIds": [
              "JER.33.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 33:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.89.34"
              },
              "items": [
                {
                  "text": "Zab 89:34",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " n'endagaano ei naaragaine n'omwiru wangye Daudi ekaafa, abura omwana w'okuza aha ngoma kutegyeka, kandi n'ei naaragaine n'abaheereza bangye abanyamurwa, Abaleevi nayo efa. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.21",
            "verseOrgIds": [
              "JER.33.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 33:22"
          },
          "items": [
