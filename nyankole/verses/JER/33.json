              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.22.17"
              },
              "items": [
                {
                  "text": "Kut 22:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nk'oku eihe ry'omu iguru ritarikubaasa kubarwa, n'omusheenyi gw'aha nyaja gutarikubaasa kurengwa, nikwo naanye ndikanyisa oruzaaro rw'omwiru wangye Daudi, n'abanayamurwa Abaleevi abarikumpeereza.",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.22",
            "verseOrgIds": [
              "JER.33.22"
            ]
          }
        }
      ]
