              "type": "text"
            }
          ]
        },
        {
          "text": " Ahakuba oku nikwo MUKAMA arikugamba naagira ati: Daudi taribura muntu w'okushutama aha kitebe ky'obugabe bw'enju ya Israeli; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.17",
