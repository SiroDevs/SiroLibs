                  "text": "11:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omuri ebyo biro n'omuri obwo bunaku ndyamereza Daudi Eitaagi ry'okuhikiirira, kandi Itaagi ogwo aryahikiiriza emanja z'oburyo n'okuhikiirira omu nsi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.15",
            "verseOrgIds": [
