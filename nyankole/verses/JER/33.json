                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi ekigambo kya MUKAMA kyagaruka kyaija ahari Yeremia obwa kabiri, obu yaabaire akikingirainwe omu kibuga ky'abarinzi nikigira kiti: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.1",
            "verseOrgIds": [
              "JER.33.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 33:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.6.3"
              },
              "items": [
                {
                  "text": "Kur 6:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Oku nikwo MUKAMA arikugamba, owaahangire ensi, akagikora kugihamya, MUKAMA niryo iziina rye, naagira ati: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.2",
            "verseOrgIds": [
              "JER.33.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 33:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.29.12"
              },
              "items": [
                {
                  "text": "Yer 29:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.91.15"
              },
              "items": [
                {
                  "text": "Zab 91:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.48.6"
              },
              "items": [
                {
                  "text": "Isa 48:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Onyete, nkwetabe, nkugambire ebikuru eby'omubonano, ebi otakamanyaga. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.3",
            "verseOrgIds": [
              "JER.33.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 33:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.32.24"
              },
              "items": [
                {
                  "text": "Yer 32:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ahakuba oku nikwo MUKAMA, Ruhanga wa Israeli, arikugamba aha maju g'omuri oru rurembo, n'ahari zaanyaruju z'abagabe ba Yuda ezaasheenyirwe, ngu ebisheenyuka babone kubikumiiriza abarikutemba aha by'okutemberaho, n'abarikurwansia rurara, naagira ati: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.4",
            "verseOrgIds": [
              "JER.33.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 33:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.31.17"
              },
              "items": [
                {
                  "text": "Bir 31:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.31.18"
              },
              "items": [
                {
                  "text": "18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abakaludaaya nibaija kwija kurwana n'okwijuza ago maju emitumbi y'abantu, abu ndiita ngwirwe kubi, nyine ekiniga kingi; ahabw'okuba obubi bwabo bwona bundeeteire kwima oru rurembo amaisho. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.5",
            "verseOrgIds": [
              "JER.33.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 33:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.30.17"
              },
              "items": [
                {
                  "text": "Yer 30:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Reeba, ndyarureetera okuba gye, ndutambire, n'abantu baamwo mbakize, mboorekye obusingye bwingi n'amazima. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.6",
            "verseOrgIds": [
              "JER.33.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 33:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.24.6"
              },
              "items": [
                {
                  "text": "Yer 24:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.1.26"
              },
              "items": [
                {
                  "text": "Isa 1:26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ndyagarura aha buteeka Abayuda n'Abaisraeli abaatwairwe omu bukwatwa, ngarukye mbombekye, babe nk'oku baabaire bari okubanza. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.7",
            "verseOrgIds": [
              "JER.33.7"
            ]
          }
        },
        {
