                {
                  "text": "Isa 60:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi orurembo oru ruryambeera eiziina ry'okushemererwa, n'eky'okumpimbisisa, n'okumpaisa ekitiinisa omu maisho g'amahanga goona ag'omu nsi yoona, agarihurira ebirungi byona ebi ndikubakorera; kandi baryatiina, bateteme ahabw'ebirungi byona n'obusingye bwona obu nduhaire.",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.9",
            "verseOrgIds": [
              "JER.33.9"
            ]
