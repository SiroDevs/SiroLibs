                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omuri ebyo biro Yuda aryajunwa, Yerusaalemu etuure buhooro. Kandi eri niryo iziina eri eryetwa, MUKAMA Kuhikiirira kwaitu.",
          "type": "text",
          "attrs": {
