            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Baanabi baanyu, ababaire nibabahanuurira nibagira ngu omugabe wa Babulooni taribateera, n'obu kwakuba okurwanisa egi nsi, barahi? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.19",
            "verseOrgIds": [
              "JER.37.19"
            ]
          }
