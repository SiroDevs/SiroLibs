              "type": "text"
            }
          ]
        },
        {
          "text": " Yeremia ku yaagiire omu kihome, yaamara ebiro bingi omu kashengye kafunzire. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.16",
            "verseOrgIds": [
              "JER.37.16"
            ]
          }
        },
        {
          "name": "verse",
