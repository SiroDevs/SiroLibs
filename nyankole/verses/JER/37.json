              },
              "items": [
                {
                  "text": "Ezk 17:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Zedekia mwene Yosia, ou Nebukadeneeza omugabe wa Babulooni yaataire aha ngoma omu nsi ya Yuda, akategyeka omu mwanya gwa Konia mwnee Yehoyakimu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.1",
            "verseOrgIds": [
              "JER.37.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 37:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.36.12+2CH.36.13+2CH.36.14"
              },
              "items": [
                {
                  "text": "2 Bus 36:12-14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka we n'abagaragwa be n'abantu b'omuri egyo nsi, tihaine waahuriire ebigambo bya MUKAMA ebi yaagambire naaraba omuri nabi Yeremia.",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.2",
            "verseOrgIds": [
              "JER.37.2"
            ]
          }
        }
      ]
    },
    {
