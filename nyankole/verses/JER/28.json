              "items": [
                {
                  "text": "Bir 13:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nikyo MUKAMA arikugirira ati: Reeba, niinyija kukwiha omu nsi. Ogu mwaka noogufamu, ahabw'okuba ogambire eby'okugomera MUKAMA.",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.16",
