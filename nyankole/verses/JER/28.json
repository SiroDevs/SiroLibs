              "items": [
                {
                  "text": "23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi nabi Yeremia yaagira nabi Hanania ati: Hurira, iwe Hanania; MUKAMA takutumire, kandi oreeteire aba bantu kwesiga ebishuba. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.15",
            "verseOrgIds": [
              "JER.28.15"
            ]
          }
        },
        {
