              "attrs": {
                "loc": "EZK.13.22"
              },
              "items": [
                {
                  "text": "Ezk 13:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
