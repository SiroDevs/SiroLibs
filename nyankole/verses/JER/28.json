            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.11",
            "verseOrgIds": [
              "JER.28.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 28:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku haahingwireho ebiro, nabi Hanania aherize kuhenda emigamba eyaabaire eri aha bitsya bya nabi Yeremia, ekigambo kya MUKAMA kyaija ahari Yeremia nikigira kiti: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.12",
            "verseOrgIds": [
              "JER.28.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 28:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Irooko ogambire Hanania oti: Oku nikwo MUKAMA arikugamba naagira ati: Ohenzire emigamba y'ebiti, kwonka nyowe niinyija kukora ey'ebyoma omu mwanya gwayo; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.13",
            "verseOrgIds": [
              "JER.28.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 28:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.25.11"
              },
              "items": [
                {
                  "text": "Yer 25:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.28.48"
              },
              "items": [
                {
                  "text": "Bir 28:48",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ahakuba oku nikwo MUKAMA ow'amahe, Ruhanga wa Israeli, arikugamba naagira ati: Ntaire omugamba gw'ekyoma aha bitsya by'ago mahanga goona kuba abahuuku ba Nebukadeneeza omugabe wa Babulooni; kandi baryamuheereza, ahabw'okuba mmuhaire nangwa n'enyamaishwa z'omu ishwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.14",
            "verseOrgIds": [
              "JER.28.14"
            ]
          }
        },
        {
