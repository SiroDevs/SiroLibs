                "loc": "JOS.9.3"
              },
              "items": [
                {
                  "text": "Yos 9:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.21.17"
              },
              "items": [
                {
                  "text": "21:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omuri ogwo mwaka aha kutandika kw'obutegyeki bwa Zedekia omugabe wa Yuda, omu kwezi kwa kataano okw'omu mwaka gwa kana, Hanania mwene Azuuri, nabi ow'omuri Gibeoni, akangambirira omu nju ya MUKAMA omu maisho g'abanyamurwa n'abantu boona naagira ati: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.1",
            "verseOrgIds": [
              "JER.28.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 28:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.27.2"
              },
              "items": [
                {
                  "text": "Yer 27:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Oku nikwo MUKAMA ow'amahe, Ruhanga wa Israeli, arikugamba naagira ati: Mpenzire omugamba gw'obutegyeki bw'omugabe wa Babulooni. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.2",
            "verseOrgIds": [
              "JER.28.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 28:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emyaka ebiri etakahweire, ndyagarura omu mwanya ogu ebintu byona eby'enju ya MUKAMA, ebi Nebukadeneeza omugabe wa Babulooni yaihiremu, katwara Babulooni; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.3",
            "verseOrgIds": [
              "JER.28.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 28:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.22.10"
              },
              "items": [
                {
                  "text": "Yer 22:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kandi ndyagarura Yekonia mwene Yehoyakimu omugabe wa Yuda n'Abayuda boona abaagiire Babulooni bari enkwatwa; ahabw'okuba ndyahenda omugamba gw'obutegyeki bw'omugabe wa Babulooni.",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.4",
            "verseOrgIds": [
              "JER.28.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 28:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.4",
            "verseOrgIds": [
              "JER.28.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 28:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima nabi Yeremia yaagambirira nabi Hanania omu maisho g'abanyamurwa n'abantu boona abaabaire beemereire omu nju ya MUKAMA, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.5",
            "verseOrgIds": [
              "JER.28.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 28:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.1.36"
              },
              "items": [
                {
                  "text": "1 Bag 1:36",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " naagira ati: Amiina! Nkaabaasibwa ki MUKAMA akora atyo; kandi ahikiiriza ebi waahanuura, agarura omu mwanya ogu ebintu by'enju ya MUKAMA ebiri Babulooni, hamwe n'abatwairweyo boona bari enkwatwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.6",
            "verseOrgIds": [
              "JER.28.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 28:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonka hati hurira ekigambo eki ndikukugambira, iwe n'abantu boona. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.7",
            "verseOrgIds": [
              "JER.28.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 28:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.26.18"
              },
              "items": [
                {
                  "text": "Yer 26:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Baanabi aba ira abaatubandiize twembi bakahanuurira amahanga maingi n'obugabe bw'amaani, ku birihikwaho engamba, enjara n'orufu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.8",
            "verseOrgIds": [
              "JER.28.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 28:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.6.14"
              },
              "items": [
                {
                  "text": "Yer 6:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.18.22"
              },
              "items": [
                {
                  "text": "Bir 18:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka nabi orikuhanuura eby'obusingye, ekigambo kya nabi ogwo ku kiriba kwo, niho kirimanyirwa ngu buzimazima MUKAMA niwe yaamutumire.",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.9",
            "verseOrgIds": [
              "JER.28.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 28:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.9",
            "verseOrgIds": [
              "JER.28.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 28:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima nabi Hanania yaiha emigamba eyaabaire eri aha bitsya bya nabi Yeremia, yaagihenda, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.10",
            "verseOrgIds": [
              "JER.28.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 28:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.27.7"
              },
              "items": [
                {
                  "text": "Yer 27:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.22.11"
              },
              "items": [
                {
                  "text": "1 Bag 22:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kandi yaagambira omu maisho g'abantu boona ati: oku nikwo MUKAMA arikugamba naagira ati: Nikwo ndihenda ntyo omugamba gw'obutegyeki bwa Nebukadeneeza omugabe wa Babulooni, nkwagwiha aha bitsya by'amahanga goona, emyaka ebiri etakahweire. Kwonka nabi Yeremia yaayegyendera.",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.11",
            "verseOrgIds": [
              "JER.28.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
