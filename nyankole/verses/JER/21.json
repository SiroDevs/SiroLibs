              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niinyija kuteera eby'omuri oru rurembo, abantu n'amatungo, biitwe orufu rw'amaani. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.6",
