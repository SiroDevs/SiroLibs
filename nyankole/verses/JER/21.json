        {
          "text": " kandi nyowe nyerwanire naimwe mbabangiire omukono gw'amaani, mbagwereirwe kubi, mbainiire ekiniga kingi munonga. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.5",
