            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Oku nikwo MUKAMA Ruhanga wa Israeli arikugamba naagira ati: Reeba, niinyija kucwa busha eby'okurwanisa ebi mukwaitse kurwanisa omugabe wa Babulooni n'Abakaludaaya abari enyima y'orugo babagotsire, imwe mbagarure omu rurembo; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.4",
            "verseOrgIds": [
              "JER.21.4"
            ]
          }
        },
