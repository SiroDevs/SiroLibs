                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.23.36"
              },
              "items": [
                {
                  "text": "2 Bag 23:36",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omu kutandia kw'obutegyeki bwa Yehoyakimu mwene Yosia omugabe wa Yuda, ekigambo eki kikaruga ahari MUKAMA nikigira kti: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.1",
            "verseOrgIds": [
              "JER.26.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 26:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.19.14"
              },
              "items": [
                {
                  "text": "Yer 19:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.4.2"
              },
              "items": [
                {
                  "text": "Bir 4:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.3.10"
              },
              "items": [
                {
                  "text": "Ezk 3:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.20.27"
              },
              "items": [
                {
                  "text": "Byak 20:27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Oku nikwo MUKAMA arikugamba naagira ati: Irooko oyemerere omu kikaari ky'enju ya MUKAMA, ogambire ab'omu ndembo za Yuda zoona, abatuura nibaija kuramiza omu nju ya MUKAMA, ebigambo byona ebi ndikukuragiira kubagambira; otagira ekigambo na kimwe eki waatsigayo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.2",
            "verseOrgIds": [
              "JER.26.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 26:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.18.8"
              },
              "items": [
                {
                  "text": "Yer 18:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.36.3"
              },
              "items": [
                {
                  "text": "36:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Obundi bakaahurira, buri muntu ahinduka, aruga omu mitwairize ye embibi, naanye mbona kwegarukamu kureka akabi akau naaba niinyenda kubareetaho nimbatura ebibi ebi barikukora. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.3",
            "verseOrgIds": [
              "JER.26.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 26:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.26.14"
              },
              "items": [
                {
                  "text": "Lev 26:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi obagire oti: Oku nikwo MUKAMA arikugamba naagira ati: Ku muraayangye kumpurira kugyendera omu biragiro byangye ebi naataire omu maisho gaanyu, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.4",
            "verseOrgIds": [
              "JER.26.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 26:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.25.3"
              },
              "items": [
                {
                  "text": "Yer 25:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.25.4"
              },
              "items": [
                {
                  "text": "4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " n'okuta omutima aha bigambo by'abaheereza bangye baanabi, abu ntuura nimbatumaho, kwonka mutarikukyetaho, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.5",
            "verseOrgIds": [
              "JER.26.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 26:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.7.12"
              },
              "items": [
                {
                  "text": "Yer 7:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.24.9"
              },
              "items": [
                {
                  "text": "24:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " egi nju ndyagigira nka Shiilo, n'oru rurembo ndugire eky'okukyeenwa omu mahanga goona ag'omu nsi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.6",
            "verseOrgIds": [
              "JER.26.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
