        {
          "text": " Ndyaguma mbataireho amaisho kubagirira gye, mbagarure omuri egi nsi. Ndyabombeka, tindibasheenya; ndyababyara, tindibakuura. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.6",
            "verseOrgIds": [
              "JER.24.6"
            ]
          }
