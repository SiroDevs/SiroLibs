              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima ekigambo kya MUKAMA kyanyijaho nikigira kiti: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.4",
            "verseOrgIds": [
              "JER.24.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oku nikwo MUKAMA, Ruhanga wa Israeli, arikugamba naagira ati: Nk'oku egi mitiini eri mirungi, nikwo ndibara Abayuda abatwairwe bari enkwatwa kuba barungi, abu naabingire omu mwanya ogu, nkabatwara omu nsi y'Abakaludaaya. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.5",
            "verseOrgIds": [
              "JER.24.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
