                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Aba Kiryasi-yearimu baija, baatwara eshanduukye ya MUKAMA, baagiinamura, baagitaasya omu nju ya Abinadabu eyaabaire eri aha kabungo; bwanyima baashoroora omutabani Eleazaari okurinda egyo shanduukye ya MUKAMA.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.1",
            "verseOrgIds": [
              "1SA.7.1"
            ]
          }
        }
