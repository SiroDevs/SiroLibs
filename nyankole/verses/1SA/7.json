        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okwiha aha izooba eri eshanduukye ya MUKAMA yaataahiireho Kiryasi-yearimu, hakahinguraho omwanya muraingwa; ahakuba ogwo mwanya gwona gukahika emyaka makumi abiri. Ab'enju ya Israeli boona baatakira MUKAMA. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.2",
            "verseOrgIds": [
              "1SA.7.2"
            ]
          }
        },
        {
          "name": "verse",
