              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.13",
            "verseOrgIds": [
              "1SA.7.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.13.3"
              },
              "items": [
                {
                  "text": "1 Sam 13:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Okwo nikwo Abafilistia baacwirwe eishaija, batagarukye kurenga omwatano gw'Abaisraeli. Omu biro byona ebya Samueli omukono gwa MUKAMA gukaguma nigurwanisa Abafilistia. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.13",
            "verseOrgIds": [
              "1SA.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi endembo ezi Abafilistia baabaire banyagire Abaisraeli, zaabagarurirwa, okuruga Ekurooni n'okuhika Gaasi; Abaisraeli baiha ensi yaabo omu mikono y'Abafilistia; haabaho obusingye ahagati y'Abaisraeli n'Abaamori.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.14",
            "verseOrgIds": [
              "1SA.7.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.14",
            "verseOrgIds": [
              "1SA.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samueli yaaguma naacwera Abaisraeli emanja ebiro bye byona. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.15",
            "verseOrgIds": [
              "1SA.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi buri mwaka akaba arambura Beseeli, Gilugaali na Mizipa, naacwera Abaisraeli emanja omuri egyo myanya yoona; ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.16",
            "verseOrgIds": [
              "1SA.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "bwanyima agaruka Raama; ahakuba eka ye niyo yaabaire eri; okwo niyo yaabaire acwerera Abaisraeli emanja; kandi niyo yaayombekyeire MUKAMA eitambiro.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.17",
            "verseOrgIds": [
              "1SA.7.17"
            ]
          }
        }
      ]
    }
  ],
