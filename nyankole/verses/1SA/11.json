                "loc": "1SA.16.13"
              },
              "items": [
                {
                  "text": "16:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Saulo ku yaahuriire ebigambo ebyo, Omwoyo wa Ruhanga yaamwijaho n'amaani, yaagira ekiniga kingi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.11.6",
            "verseOrgIds": [
              "1SA.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.21.5"
              },
              "items": [
                {
                  "text": "Bar 21:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.14.14"
              },
              "items": [
                {
                  "text": "2 Bus 14:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.17.10"
              },
              "items": [
                {
                  "text": "17:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yaihayo ente ibiri, yaaziita, yaazitematemamu ebicweka, yaabiha entumwa kubitwara omuri Israeli yoona, yaazituma ati: Weena oraayangye kuhurura na Saulo na Samueli, okwo nikwo ente ze ziraatwazibwe. Okutiinisa kwa MUKAMA kwakwata abantu, baahururira kimwe nk'omuntu omwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.11.7",
            "verseOrgIds": [
              "1SA.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku yaabateeraniire Bezeki, yaababara, Abaisraeli baaba obusiriira bushatu, n'Abayuda baaba obukumi bushatu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.11.8",
            "verseOrgIds": [
              "1SA.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima baagambira entumwa ziri eziizire, bati: Mugambire aba Yabeshi-gileadi muti: Nyencakare akashana kaatagata, nimwija kuheebwa emikono. Ezo ntumwa zaagyenda, zaabigambira aba Yabeshi; baashemererwa. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.11.9",
            "verseOrgIds": [
              "1SA.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba Yabeshi nikwo kugambira Abaamoni bati: Nyencakare nitwija kubeehongyera, mutugire nk'oku murikwenda kwona. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.11.10",
            "verseOrgIds": [
              "1SA.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.31.11"
              },
              "items": [
                {
                  "text": "1 Sam 31:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.7.16"
              },
              "items": [
                {
                  "text": "Bar 7:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ku bwaseesire, Saulo yaabaganisa abantu omu mitwe eshatu, baayeshuka omu rusiisira rw'Abaamoni enkoko nizigamba, baabaita okuhitsya omu ihangwe; abaahonokireho baataataana, nangwa n'ababiri tibaaguma hamwe.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.11.11",
            "verseOrgIds": [
              "1SA.11.11"
            ]
          }
        }
      ]
    },
