              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima Hanna yaasiima naagira ati:",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.1",
            "verseOrgIds": [
              "1SA.2.1"
            ]
