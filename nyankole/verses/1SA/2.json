                {
                  "text": "Kur 28:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Niwe naatooraine omu nganda zoona eza Israeli kuba omunyamurwa wangye, okuza aha itambiro ryangye, okwotera obubaane, n'okujwara efodi omu maisho gangye. Kandi nkaha oruganda rwa sho empongano z'Abaisraeli zoona ez'ebitambo by'okwotsya omu muriro. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.28",
            "verseOrgIds": [
              "1SA.2.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
