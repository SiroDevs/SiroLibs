              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.32.15"
              },
              "items": [
                {
                  "text": "Bir 32:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
