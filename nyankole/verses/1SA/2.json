                  "text": "2 Sam 7:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naanye ndyayeimukiza omunyamurwa orikwesigwa, orikora nk'ebindi aha mutima n'omu biteekateeko oku biri. Ndyamwombekyera enju ehamire; kandi aryaheerereza omu maisho g'ou naashukireho amajuta ebiro byona. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.35",
            "verseOrgIds": [
              "1SA.2.35"
            ]
          }
