                "loc": "1SA.4.11"
              },
              "items": [
                {
                  "text": "1 Sam 4:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ako kagwe akarigwera batabani baawe bombi, Hofuni na Finehaasi, karyakubeera akamanyiso; bombi baryafa eizooba rimwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.34",
            "verseOrgIds": [
              "1SA.2.34"
            ]
          }
        },
