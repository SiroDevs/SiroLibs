                "loc": "JHN.12.40"
              },
              "items": [
                {
                  "text": "40",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omuntu ku arikushiisha ahari mugyenzi we, Ruhanga naamucwera orubanja; mbwenu omuntu ku arikushiisha ahari Ruhanga, n'oha orikubaasa kumweshengyerereza? Kwonka baayanga kuhurira ishebo, ahakuba MUKAMA akaba naayenda kubaita.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.25",
            "verseOrgIds": [
              "1SA.2.25"
            ]
          }
        }
      ]
