            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " bwanyima amaizi g'omu kiyanja ekya ira mwagatimbira eiziba ahagati y'engo zombi. Kwonka timwaijuka owaakozire ebyo, n'obu kwakuba okweta aha Waateekateekire ira ku bibaho.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.11",
