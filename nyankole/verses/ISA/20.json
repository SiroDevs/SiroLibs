              "items": [
                {
                  "text": "Isa 8:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " MUKAMA akagira ati: Nk'oku omwiru wangye Isaaya amazire emyaka eshatu naagyenda ajwaire busha kandi ataine nkaito, okubeera Misri na Esiopia akamanyiso n'eky'okutangaaza, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.20.3",
            "verseOrgIds": [
              "ISA.20.3"
            ]
          }
        },
        {
