                {
                  "text": "Mik 1:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " omu bunaku obwo MUKAMA akagambira Isaaya mwene Amozi, ati: Irooko, oyezirikuurure ebiguniya, ojuure enkaito. Nawe nikwo yaakozire, akagyenda ajwaire busha, kandi ataine nkaito. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.20.2",
            "verseOrgIds": [
              "ISA.20.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
