        {
          "text": " Bwanyima abo abaabaire bataire amatsiko ahari Esiopia, nibeehimbisiza ahari Misri, baryahahaaza emitima, bashoberwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.20.5",
