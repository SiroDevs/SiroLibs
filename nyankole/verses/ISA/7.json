              "items": [
                {
                  "text": "1 Bag 12:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Iwe n'abantu baawe n'enju ya sho, MUKAMA aryabareetaho ebiro ebitakabahoga okwiha obu Abaefuraimu baataana n'Abayuda, nikwo kuteerwa omugabe wa Asiria.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.17",
            "verseOrgIds": [
              "ISA.7.17"
            ]
          }
        }
      ]
