          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu bunaku obwo MUKAMA aryayetesa ekicurizo eshohera eziri omu bicweka by'obukomooko bw'emigyera ya Misri, n'enjoki z'omu nsi ya Asiria, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.18",
            "verseOrgIds": [
              "ISA.7.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "byona biije bijanjaare omu mpanga ezitatuurwamu n'omu nyanga z'amabaare n'omu bishaka by'amahwa byona n'omu mariisizo goona. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.19",
            "verseOrgIds": [
              "ISA.7.19"
            ]
          }
        },
