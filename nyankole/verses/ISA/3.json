              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "ebijwaro by'amagyenyi, emyenda, eminagiro, enshaho z'omu ngaro, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.22",
            "verseOrgIds": [
              "ISA.3.22"
            ]
          }
        },
