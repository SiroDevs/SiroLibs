            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ahakuba Tofeti ekateekateekwa okuruga ira, yaateekateekyerwa omugabe. Mbwenu MUKAMA agigizire mpango kandi ndaingwa, yaaba ekikoomi ky'omuriro gw'enku nyingi, kandi omwitsyo gwe, oguri nk'omugyera gw'obuganga bw'ekibiriiti, nigwo guhatweka.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.33",
            "verseOrgIds": [
