              },
              "items": [
                {
                  "text": "Isa 44:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Muryayeshongora ekyeshongoro nk'eki beeshongora nyekiro aha kiro ky'obugyenyi oburikwera; muryagira omuhimbo omu mutima nk'ogw'omuntu oine omukuri, orikuza aha rushozi rwa MUKAMA ahari Rukiri wa israeli. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.29",
            "verseOrgIds": [
              "ISA.30.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ISA 30:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.28.2"
              },
              "items": [
                {
                  "text": "Isa 28:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.29.6"
              },
              "items": [
                {
                  "text": "29:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi MUKAMA aryahuriza eiraka rye ry'ekitiinisa, ayorekyere okuteera kw'omukono gwe omu kiniga kye kingi n'omu kirimi ky'omuriro gurikurya busha, n'eshato, n'eihunga, n'orubaare. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.30",
            "verseOrgIds": [
              "ISA.30.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ISA 30:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaasiria emitima eryabahwa omunda ahabw'okutiina eiraka rya MUKAMA, ku aribateera n'enkoni ye. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.31",
            "verseOrgIds": [
              "ISA.30.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ISA 30:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.19.16"
              },
              "items": [
                {
                  "text": "Isa 19:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi ku bariba nibabateera enkoni ezi MUKAMA ariragiira kubateera, haryabaho okuteera amataari n'enanga; aryabarwanisa naatigita omukono gwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.32",
            "verseOrgIds": [
              "ISA.30.32"
            ]
          }
        },
        {
