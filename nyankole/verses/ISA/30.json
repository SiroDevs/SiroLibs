              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HOS.6.1"
              },
              "items": [
                {
                  "text": "Hos 6:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi aha izooba eri MUKAMA arishemberaho obuhuta bw'abantu be, akabakiza ebihonoka by'enkoni ze, okwaka kw'okwezi kuryaba nk'okujwa kw'eizooba, n'omushana gwaryo guryayeyongyera emirundi mushanju, gube nk'omushana gw'ebiro mushanju.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.26",
            "verseOrgIds": [
              "ISA.30.26"
            ]
          }
        }
      ]
    },
