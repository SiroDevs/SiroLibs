              "items": [
                {
                  "text": "Tonz 1:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi nkagaruka naareeba eby'okuhata byona ebirikukorerwa ahansi y'eizooba. Naareeba okurira okw'abarikuhatwa bataine kihuumuriza; obushoboorozi bwinwe abo abarikubaita kubi, kandi bataine w'okubahuumuriza. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.1",
            "verseOrgIds": [
              "ECC.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ECC 4:2"
          },
          "items": [
