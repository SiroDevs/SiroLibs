            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omutsigazi omworo ow'obwengye naakira omugabe okuzire omushema, otakyenda kuhaburwa; ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.13",
            "verseOrgIds": [
              "ECC.4.13"
            ]
          }
        },
