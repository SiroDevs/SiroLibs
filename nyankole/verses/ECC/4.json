                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.27.20"
              },
              "items": [
                {
                  "text": "Enf 27:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " omuntu otaine waabo, n'obu yaakuba omutabani, nari mwene ishe; kwonka okufa kubi kwe kutaine bugarukiro, kandi amaisho ge gatakahaagaga butungi, haza atakeebuuzaga ati: Beitu obu nfa kubi nti, mpendekyera ki ekinzibira kweshemeza? Ekyo nakyo ni busha n'emirabanamu mibi.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.8",
            "verseOrgIds": [
              "ECC.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
