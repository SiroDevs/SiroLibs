                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " n'obu yaakuba yaarugire omu kihome akaza aha ngoma, nari yaazairwe ari omworo omu ihanga rye. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.14",
            "verseOrgIds": [
              "ECC.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ECC 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkareeba abantu boona abahuriire abarikugyendagyenda ahansi y'eizooba, beemereire aha rubanju rw'ogwo mutsigazi owaabaire naazakuhungurira ogwo mugabe; ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.15",
            "verseOrgIds": [
              "ECC.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ECC 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "abantu abu yaabaire naategyeka bakaba bari baingi bataine bugarukiro. Kwonka abarikurataho tibarimushemerererwa. Buzimazima ekyo nakyo ni busha n'okwitanira omuyaga.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.16",
            "verseOrgIds": [
              "ECC.4.16"
            ]
