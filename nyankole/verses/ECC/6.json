            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.22.19"
              },
              "items": [
                {
                  "text": "Yer 22:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omuntu okuzaara abaana igana, akahangaara emyaka mingi, ebiro by'amagara ge bikakanya, kwonka omutima gwe gutahaagye birungi, akabura kiziika, ningira ngu omuntu ogwo naakirwa enda erugiremu; ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.3",
            "verseOrgIds": [
              "ECC.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ECC 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "ahakuba egyo nda erugamu etari kintu, eza omu mwirima, gushweka eiziina ryayo, ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.4",
            "verseOrgIds": [
              "ECC.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ECC 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi eba etakareebaga izooba n'obu kwakuba okumanya ekintu kyona; n'obu eraabe eba etyo, etunga obuhuumure okukira ogwo muntu. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.5",
            "verseOrgIds": [
              "ECC.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ECC 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'obu yaakuhangaara emyaka rukumi kabiri, atarikushemerererwa birungi, timurikumanya ngu byona biza omu mwanya gumwe?",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.6",
            "verseOrgIds": [
              "ECC.6.6"
            ]
          }
        }
      ]
    },
