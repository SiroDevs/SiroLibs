            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Hariho ekibi eki naareebire ahansi y'eizooba, kandi ekituura kiremereire abantu, ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.1",
            "verseOrgIds": [
              "ECC.6.1"
            ]
          }
        },
