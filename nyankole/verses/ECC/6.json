              "items": [
                {
                  "text": "Yob 14:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " N'oha owaakumanya ebishemereire kugirira omuntu omugasho akiriho ebiro byona eby'amagara ge agataine ku gari, agarikuhinguraho nk'ekicuucu? N'oha owaakugambira omuntu ebiribaho ahansi y'eizooba yaarugireho?",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.12",
            "verseOrgIds": [
              "ECC.6.12"
            ]
          }
        }
