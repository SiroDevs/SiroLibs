              "items": [
                {
                  "text": "Mub 3:22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ECC.8.13"
              },
              "items": [
                {
                  "text": "8:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
