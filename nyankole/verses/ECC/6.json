              "items": [
                {
                  "text": "1 Kor 10:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ekiriho kyona kikeetwa eiziina ira; oku omuntu ari hati kukamanywa ira, kandi tarikubaasa kuhakanisa Orikumukiza amaani. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.10",
            "verseOrgIds": [
              "ECC.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ECC 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebigambo ku byongyera kukanya, busha nayo ekanya; mbwenu ekyo omuntu kimwongyeraho ki? ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.11",
            "verseOrgIds": [
              "ECC.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ECC 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
