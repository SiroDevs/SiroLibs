              "items": [
                {
                  "text": "Enf 16:26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Okufa kubi kwona oku omuntu afa kubi, aba naahendekyera enda ye, kwonka tahaaga. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.7",
            "verseOrgIds": [
              "ECC.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ECC 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ECC.2.15"
              },
              "items": [
                {
                  "text": "Mub 2:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omunyabwengye naakiza ki omushema? Kandi omworo naakiza ki omuntu mukuru orikumanya kutwaza gye omu maisho g'abantu? ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.8",
            "verseOrgIds": [
              "ECC.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ECC 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okushemerererwa ebi orikureeba nikikira okugama noozengyereza omutima aha bi orikwetenga. Ekyo nakyo ni busha n'okwitanira omuyaga.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.9",
            "verseOrgIds": [
              "ECC.6.9"
            ]
          }
        }
      ]
    },
