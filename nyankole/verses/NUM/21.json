            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.11.19+JDG.11.20+JDG.11.21+JDG.11.22+JDG.11.23+JDG.11.24"
              },
              "items": [
                {
                  "text": "Bar 11:19-24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abaisraeli baatuma entumwa ahari Sihooni omugabe w'Abaamori, nibagira bati: ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.21",
            "verseOrgIds": [
              "NUM.21.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 21:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.20.17"
              },
              "items": [
                {
                  "text": "Kub 20:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ka turabe omu nsi yaawe; titurikwija kuraba omu misiri, n'obu kwakuba okuraba omu misiri y'emizaabibu; kandi titurikwija kunywa amaizi g'omu maziba, kureka nitwija kuraba omu nguuto y'omugabe okuhitsya obu turaarugire kimwe omu nsi yaawe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.22",
            "verseOrgIds": [
              "NUM.21.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 21:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sihooni tiyaikiriza Abaisraeli kuraba omu nsi ye, kureka yaahuruza engabo ze zoona, yaaza omu ihamba kubarwanisa; yaahika Yahazi, yaarwanirayo nabo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.23",
            "verseOrgIds": [
              "NUM.21.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 21:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.29.7"
              },
              "items": [
                {
                  "text": "Bir 29:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.135.10"
              },
              "items": [
                {
                  "text": "Zab 135:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.135.11"
              },
              "items": [
                {
                  "text": "11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "AMO.2.9"
              },
              "items": [
                {
                  "text": "Amo 2:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abaisraeli baamusinguza rurara, baakubuura ensi ye okutandikira ahari Arunooni okuhika Yaboki, aha mwatano gw'Abaamoni; ahabw'okuba omwatano gw'Abaamoni gukaba guri ogw'amaani. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.24",
            "verseOrgIds": [
              "NUM.21.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 21:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaisraeli baakwata ezo ndembo zoona, baatuura omuri ezo ndembo z'Abaamori, n'omuri Heshibooni n'omu birorero byayo byona. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.25",
            "verseOrgIds": [
              "NUM.21.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 21:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahakuba Heshibooni rukaba ruri orurembo rwa Sihooni omugabe w'Abaamori, owaarwaniise omugabe wa Moabu owa ira, akanyaga ensi ye yoona okuhitsya Arunooni. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.26",
            "verseOrgIds": [
              "NUM.21.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 21:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikyo abeeshongozi b'ebyeshongoro by'ebihimbano bagirira bati:",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.27",
            "verseOrgIds": [
              "NUM.21.27"
            ]
          }
        }
      ]
    },
