          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NUM 21:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa yaatuma ab'okutata Yazeri, baakwata ebirorero byayo, baabingamu Abaamori abaabaire batwiremu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.32",
            "verseOrgIds": [
              "NUM.21.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NUM 21:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baakuba, baatoora omuhanda ogurikuza Bashani; Ogi omugabe wa Bashani yaabahururira n'engabo ze zoona, yaarwanira nabo Edurei. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.33",
            "verseOrgIds": [
              "NUM.21.33"
            ]
          }
        },
        {
