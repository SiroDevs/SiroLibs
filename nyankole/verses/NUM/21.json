            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " MUKAMA yaagira Musa ati: Otamutiina; ahakuba mmuhaireyo omu mikono yaawe n'abantu be boona n'ensi ye; omugire nk'oku waagizire Sihooni omugabe w'Abaamori, owaabaire atwire Heshibooni. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.34",
            "verseOrgIds": [
              "NUM.21.34"
            ]
          }
        },
        {
