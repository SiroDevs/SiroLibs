                "loc": "ACT.13.39+ACT.13.40+ACT.13.41"
              },
              "items": [
                {
                  "text": "Byak 13:39-41",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.2.4"
              },
              "items": [
                {
                  "text": "Rom 2:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.2.5"
              },
              "items": [
                {
                  "text": "5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka omuntu oriba asiisikaire, akanga kweyeza, aryacuubwa, aihwe omu ihanga, ahabw'okuba aryaba asiisire Omwanya ogurikwera gwa MUKAMA; ahabw'okutamiisiirwaho maizi ag'okweza, aryaba akiri osiisikaire. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.20",
            "verseOrgIds": [
              "NUM.19.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 19:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekyo kiryababeera ekiragiro ekitarihwaho. Kandi orimiisiira ago maizi g'okweza, aryayozya ebijwaro bye; n'origakoraho aryaba osiisikaire okuhitsya omu mwabazyo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.21",
            "verseOrgIds": [
              "NUM.19.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 19:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ekintu kyona eki omuntu osiisikaire arikoraho kiryaba ekisiisikaire, n'omuntu orikikoraho aryaba osiisikaire okuhitsya omu mwabazyo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.22",
            "verseOrgIds": [
              "NUM.19.22"
            ]
          }
        }
      ]
