            }
          ]
        },
        {
          "text": "MUKAMA yaagira Musa ati: ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.23",
            "verseOrgIds": [
              "NUM.8.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 8:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebi ndikukugambira aha Baleevi n'ebi; baryatandika kutaaha omu buheereza bw'okukora omurimo gw'eby'Eihema ry'okubugaabuganiramu, bahikize emyaka makumi abiri n'etaano n'okukiraho; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.24",
            "verseOrgIds": [
              "NUM.8.24"
            ]
          }
        },
        {
