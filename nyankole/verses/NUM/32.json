        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.3.12"
              },
              "items": [
                {
                  "text": "Bir 3:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ensi ekagomoorerwa MUKAMA, bwanyima muryagaruka mutaine rubanja omu maisho ga MUKAMA n'omu maisho g'Abaisraeli; kandi ensi egi eryaba eyaanyu omu maisho ga MUKAMA. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.22",
            "verseOrgIds": [
              "NUM.32.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 32:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.44.16"
              },
              "items": [
                {
                  "text": "Kut 44:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.140.11"
              },
              "items": [
                {
                  "text": "Zab 140:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.13.21"
              },
              "items": [
                {
                  "text": "Enf 13:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka ku muriba mutakozire mutyo, muryaba mucumwire ahari MUKAMA; kandi mumanyire kimwe ngu ekibi kyanyu kiryabahindukana. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.23",
            "verseOrgIds": [
              "NUM.32.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 32:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbwenu mwombekyere abaana baanyu endembo, muzitirire entaama zaanyu, mukore ekyo eki mwagamba. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.24",
            "verseOrgIds": [
              "NUM.32.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 32:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abagaadi n'Abareubeeni baagira Musa bati: Itwe abairu baawe turyakora nk'oku waaturagiira, mukama waitu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.25",
            "verseOrgIds": [
              "NUM.32.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 32:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaana baitu n'abakazi baitu n'entaama zaitu, kandi n'ente zaitu zoona biryaguma omu ndembo za Gileadi; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.26",
            "verseOrgIds": [
              "NUM.32.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 32:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwonka itwe twena abairu baawe abaine eby'okurwanisa turyayambuka, tuhurure twebembeire MUKAMA, nk'oku waagamba, mukama waitu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.27",
            "verseOrgIds": [
              "NUM.32.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 32:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima ebyabo Musa yaabiragiira Eleazaari omunyamurwa na Yoshua mwene Nuuni n'abakuru b'amaju ga baishenkuru b'enganda z'Abaisraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.28",
            "verseOrgIds": [
              "NUM.32.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 32:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaabagira ati: Abagaadi n'Abareubeeni ku baryambuka Yorudani naimwe, beebembeire MUKAMA kuhurura, buri muntu aine eby'okurwanisa bye, ensi yaagomoorwa omu maisho gaanyu, bwanyima muryabaha ensi ya Gileadi ebe eyaabo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.29",
            "verseOrgIds": [
              "NUM.32.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 32:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonka ku bariba batambukire naimwe baine eby'okurwanisa, baryaheebwa naimwe obutaka omu nsi ya Kanaani. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.30",
            "verseOrgIds": [
              "NUM.32.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NUM 32:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abagaadi n'Abareubeeni baagarukamu nibagira bati: Oku MUKAMA yaaragiira abairu baawe, nikwo turikora. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.31",
            "verseOrgIds": [
              "NUM.32.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NUM 32:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Turyayambuka twine eby'okurwanisa, tuze omu nsi ya Kanaani twebembeire MUKAMA, obutaka bwaitu tugume nabwo seenu ya Yorudani.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.32",
            "verseOrgIds": [
              "NUM.32.32"
            ]
          }
        }
      ]
