        },
        {
          "text": " Omu kwezi kwa mushanju aha kiro ky'okubanza, mugume mugire okuteerana okurikwera; mutarikikoreraho omurimo gwona ogurikurusya. Eryo izooba riryaba eizooba eri muriguma nimuteereraho amakondere. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.1",
            "verseOrgIds": [
              "NUM.29.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 29:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi muryaguma nimurihongyeraho empongano y'okwotsya ey'ekisooroora ekirikushemeza MUKAMA, enimi y'ekimasha emwe, n'empaya y'entaama emwe, kandi n'empaya nto z'entaama mushanju ezihikize omwaka ezitaine kamogo, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.2",
            "verseOrgIds": [
              "NUM.29.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 29:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'empongano ez'okuhongwa nabyo z'esaano ejwangizemu amajuta, ebicweka bishatu bya ikumi ahabw'egyo nimi, n'ebicweka bibiri bya ikumi ahabw'egyo mpaya y'entaama, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.3",
            "verseOrgIds": [
              "NUM.29.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 29:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi n'ekicweka kimwe kya ikumi ahabwa buri mwana gw'entaama ahari ezo mushanju; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.4",
            "verseOrgIds": [
              "NUM.29.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 29:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi muhongye empaya y'embuzi kuba ekitambo ky'ekibi eky'okubarihiirira, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.5",
            "verseOrgIds": [
              "NUM.29.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 29:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "mutabariireho kitambo ky'okwotsya ekihongwa aha kuboneka kw'okwezi n'empongano y'esaano yaakyo, n'ekitambo ky'okwotsya eky'obutoosha n'empongano y'esaano yaakyo, n'ey'eby'okunywa yaakyo, nk'ekiragiro kyabyo oku kiri, kuba empongano y'ekisooroora kirungi, eyokiibwe omu muriro, erikuhongyerwa MUKAMA.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.6",
            "verseOrgIds": [
              "NUM.29.6"
            ]
          }
        }
      ]
    },
