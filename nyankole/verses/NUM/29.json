          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "obihongye n'empongano zaabyo ez'esaano y'obunono ejwangizemu amajuta, ebicweka bishatu bya ikumi ahabwa buri nimi ahari ezo ikumi na ishatu, n'ebicweka bibiri bya ikumi ahabwa buri mpaya ahari ezo zombi, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.14",
            "verseOrgIds": [
              "NUM.29.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
