            }
          ]
        },
        {
          "text": " Kandi muryahonga ebitambo by'okwotsya, empongano eyokiibwe omu muriro, ey'ekisooroora kirungi ahari MUKAMA; enimi z'ebimasha ikumi na ishatu, n'empaya z'entaama ibiri, kandi n'empaya nto z'entaama ikumi na ina, ezihikize omwaka; bibe ebitaine kamogo; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.13",
            "verseOrgIds": [
              "NUM.29.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
