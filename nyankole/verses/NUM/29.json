          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "kureka muhongyere MUKAMA empongano y'okwotsya ey'ekisooroora kirungi, enimi y'ekimasha emwe n'empaya y'entaama emwe, kandi n'empaya nto z'entaama mushanju, ezihikize omwaka; bibe ebitaine kamogo, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.8",
            "verseOrgIds": [
              "NUM.29.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
