          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi n'ekicweka kimwe kya ikumi ahabwa buri mwana gw'entaama ahari ezo mushanju; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.10",
            "verseOrgIds": [
              "NUM.29.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 29:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi muhongye empaya y'embuzi emwe kuba ekitambo ky'ekibi; mutabariiremu kitambo ky'okurihiirira ekibi, n'ekitambo ky'okwotsya eky'obutoosha, n'empongano yaakyo y'esaano, n'empongano zaabyo z'eby'okunywa.",
          "type": "text",
