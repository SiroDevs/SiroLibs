          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi n'ekicweka kimwe kya ikumi ahabwa buri mwana gw'entaama ahari ezo ikumi na ina; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.15",
            "verseOrgIds": [
              "NUM.29.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 29:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "muhongye n'empaya y'embuzi kuba ekitambo ky'ekibi, mutabariireho kitambo ky'okwotsya eky'obutoosha n'empongano yaakyo y'esaano n'ez'eby'okunywa.",
          "type": "text",
          "attrs": {
