          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'empongano z'esaano ez'okuhongwa nabyo, ez'esaano y'obunono ejwangizemu amajuta, ebicweka bishatu bya ikumi ahabw'egyo nimi, n'ebicweka bibiri bya ikumi ahabw'egyo mpaya y'entaama, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.9",
            "verseOrgIds": [
              "NUM.29.9"
            ]
          }
        },
        {
