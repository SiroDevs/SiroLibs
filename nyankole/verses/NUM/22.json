                "loc": "1CH.21.16"
              },
              "items": [
                {
                  "text": "1 Bus 21:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima MUKAMA yaahwezesa amaisho ga Balamu, yaareeba maraika wa MUKAMA ayemereire omu muhanda, aine rurara omu ngaro; yainama, yaajuumara. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.31",
            "verseOrgIds": [
              "NUM.22.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NUM 22:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
