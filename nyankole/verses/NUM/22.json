          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 22:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaisraeli baimutsya orugyendo, baateera orusiisira omu mpita za Moabu seeri ya Yorudani ahashungaine na Yeriko. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.1",
            "verseOrgIds": [
              "NUM.22.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.11.25"
              },
              "items": [
                {
                  "text": "Bar 11:25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Balaki mwene Zipori yaareeba byona ebi Abaisraeli baakozire Abaamori; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.2",
            "verseOrgIds": [
              "NUM.22.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.23.27"
              },
              "items": [
                {
                  "text": "Kur 23:27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abamoabu baatiina munonga Abaisraeli; ahakuba bakaba bari baingi munonga; emitima yaabahwa omunda ahabw'abo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.3",
            "verseOrgIds": [
              "NUM.22.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.31.8"
              },
              "items": [
                {
                  "text": "Kub 31:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abamoabu baagambira abakuru ba Midiani bati: Egi nyanja y'abantu neija kumaraho ebitwehinguririize byona, nk'oku ente emara obunyaatsi omu iriisizo. Kandi omu biro ebyo Balaki mwene Zipori niwe yaabaire ari omugabe wa Moabu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.4",
            "verseOrgIds": [
              "NUM.22.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.23.4"
              },
              "items": [
                {
                  "text": "Bir 23:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.13.22"
              },
              "items": [
                {
                  "text": "Yos 13:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yaatuma entumwa ahari Balamu mwene Beori, owaabaire atwire Pesori aha mugyera Furaati omu nsi y'abantu b'eihanga rye, kumweta, naagira ati: Hariho abantu barugire Misri; reeba, bashwekire ensi, batwire aharikureebana naitwe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.5",
            "verseOrgIds": [
              "NUM.22.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.27.29"
              },
              "items": [
                {
                  "text": "Kut 27:29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mbwenu ninkweshengyereza, ija onkyeenere aba bantu; ahabw'okuba nibankiza amaani; obundi nkaabaasa kubasingura, mbabingira kimwe omu nsi; ahakuba nimmanya ngu ou oshabira omugisha aguheebwa, kandi ou okyeena akyeenwa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.6",
            "verseOrgIds": [
              "NUM.22.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.6",
            "verseOrgIds": [
              "NUM.22.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.7",
            "verseOrgIds": [
              "NUM.22.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.23.8"
              },
              "items": [
                {
                  "text": "Kur 23:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MIC.3.11"
              },
              "items": [
                {
                  "text": "Mik 3:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abakuru ba Moabu n'Abamidiani baagyenda n'emikimbo omu ngaro; baahika ahari Balamu, baamugambira ebi Balaki abatumire. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.7",
            "verseOrgIds": [
              "NUM.22.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaabagira ati: Muraare aha eki kiro; niinyija kubagambira nk'oku MUKAMA arangambire. Abanyiginya ba Moabu baaraara owa Balamu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.8",
            "verseOrgIds": [
              "NUM.22.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ruhanga yaija ahari Balamu, yaamubuuza ati: Abo bashaija abari hamwe naiwe nibaahi? ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.9",
            "verseOrgIds": [
              "NUM.22.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balamu yaagarukamu Ruhanga ati: Balaki mwene Zipori omugabe wa Moabu antumireho ati: ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.10",
            "verseOrgIds": [
              "NUM.22.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Reeba, hariho abantu barugire Misri, baashweka ensi; mbwenu ija obankyeenere; obundi nkaabaasa kubarwanisa, mbabinga. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.11",
            "verseOrgIds": [
              "NUM.22.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.23.20"
              },
              "items": [
                {
                  "text": "Kub 23:20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.144.15"
              },
              "items": [
                {
                  "text": "Zab 144:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ruhanga yaagira Balamu ati: Otagyenda nabo, otarikyeena abo bantu, ahakuba bahairwe omugisha. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.12",
            "verseOrgIds": [
              "NUM.22.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balamu yaimuka omu kasheeshe, yaagambira abanyiginya ba Balaki ati: Mwirooko mugarukye owaanyu, ahabw'okuba MUKAMA taanyikiriize kugyenda naimwe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.13",
            "verseOrgIds": [
              "NUM.22.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanyiginya ba Moabu baimuka, baagaruka ahari Balaki, baamugira bati: Balamu ayangire kwija naitwe.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.14",
            "verseOrgIds": [
              "NUM.22.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.14",
            "verseOrgIds": [
              "NUM.22.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balaki yaagaruka yaatuma abandi banyiginya abarikukira bari obwingi n'ekitiinisa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.15",
            "verseOrgIds": [
              "NUM.22.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baija ahari Balamu, baamugira bati: Balaki mwene Zipori atutumire naagira ngu, hatagira ekyakuzibira kwija; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.16",
            "verseOrgIds": [
              "NUM.22.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 22:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.16.19"
              },
              "items": [
                {
                  "text": "Bir 16:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.4.8"
              },
              "items": [
                {
                  "text": "Mat 4:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.4.9"
              },
              "items": [
                {
                  "text": "9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ahakuba naija kukukuza, akuhindure omuntu w'ekitiinisa kingi; kandi ngu, eki orimugambira kyona, aryakikora; n'ahabw'ekyo ngu oije omukyeenere abo bantu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.17",
            "verseOrgIds": [
              "NUM.22.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 22:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.22.14"
              },
              "items": [
                {
                  "text": "1 Bag 22:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Balamu yaagarukamu abagaragwa ba Balaki ati: N'obu Balaki yaakumpa enju ye eijwire efeeza n'ezaabu, tinkaabaasa kuhingura aha kigambo kya MUKAMA Ruhanga wangye, kukicwaho nari okukyongyeraho. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.18",
            "verseOrgIds": [
              "NUM.22.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 22:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbwenu nimbeeshengyereza, naimwe muraare aha eki kiro, ndeebe eki MUKAMA araagarukye kungambira. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.19",
            "verseOrgIds": [
              "NUM.22.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 22:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ruhanga yaija ahari Balamu ekyo kiro, yaamugira ati: Aba bashaija ku baraabe baizire kukweta, imuka ogyende nabo; kwonka eki ndaakuragiire, obe nikyo waakora.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.20",
            "verseOrgIds": [
              "NUM.22.20"
            ]
          }
        }
      ]
    },
