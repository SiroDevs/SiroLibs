            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " MUKAMA yaagira Musa ati: Oryainamuka ahari oru rushozi rwa Abariimu, oreebe ensi ei mpaire Abaisraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.12",
            "verseOrgIds": [
              "NUM.27.12"
            ]
          }
        },
        {
