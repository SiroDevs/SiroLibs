                "loc": "EXO.18.15"
              },
              "items": [
                {
                  "text": "Kur 18:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.3.5"
              },
              "items": [
                {
                  "text": "Enf 3:5",
                  "type": "text"
                }
