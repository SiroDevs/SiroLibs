              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA yaagira Musa ati: ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.6",
            "verseOrgIds": [
              "NUM.27.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 27:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.36.2"
              },
              "items": [
                {
                  "text": "Kub 36:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ebi bahara ba Zelofehaadi barikufa n'eby'amazima; buzimazima otaribura kubaha obutaka omu b'omuryango gwa ishebo; obarekye bahungure obuhunguzi bwe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.7",
            "verseOrgIds": [
              "NUM.27.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 27:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ogambire Abaisraeli oti: Omuntu ku arifa, atatsigire mwana w'omwojo, muryareka obuhunguzi bwe bube obwa muhara we. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.8",
            "verseOrgIds": [
              "NUM.27.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 27:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku ariba atatsigire muhara, obuhunguzi mubuhe beene ishe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.9",
            "verseOrgIds": [
              "NUM.27.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 27:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku ariba ataine beene ishe, mubuhe baishento. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.10",
            "verseOrgIds": [
              "NUM.27.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 27:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonka ishe ku ariba ataine bakuru be nari abarumuna, obuhunguzi mubuhe omunyaruganda omuri haihi, abuhungure. Ekyo kibe ekiragiro ky'okucweraho emanja z'obuhunguzi omu Baisraeli, nk'oku MUKAMA yaaragiire Musa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.11",
            "verseOrgIds": [
              "NUM.27.11"
            ]
          }
        }
      ]
    },
