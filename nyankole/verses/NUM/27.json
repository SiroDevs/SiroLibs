            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Musa yaatwarira MUKAMA ebigambo byabo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.5",
            "verseOrgIds": [
              "NUM.27.5"
