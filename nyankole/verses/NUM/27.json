            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima haija bahara ba Zelofehaadi, mwene Heferi ya Gileadi, ya Makiri, ya Manaase ab'emiryango ya Manaase ab'emiryango ya Manaase mwene Yosefu; bahara be bakaba nibeetwa Maala, Noa, Hogula, Milika na Tiruza; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.1",
            "verseOrgIds": [
              "NUM.27.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 27:2"
          },
          "items": [
