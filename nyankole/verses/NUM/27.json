                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " MUKAMA yaagira Musa ati: Twara Yoshua mwene Nuuni, omuntu oine omwoyo, omuteho engaro; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.18",
            "verseOrgIds": [
              "NUM.27.18"
            ]
          }
        },
        {
