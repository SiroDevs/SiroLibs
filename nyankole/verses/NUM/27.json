                  "text": "Mat 9:36",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ow'okubeebembera nibashohora, kandi nibataaha, oraabashohoze, kandi akabataasya, eihanga rya MUKAMA rirekye kuba nk'entaama ezitaine muriisa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.17",
            "verseOrgIds": [
              "NUM.27.17"
            ]
          }
        },
        {
