                {
                  "text": "Bir 10:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ku oriheza kugireeba, naiwe oryafa, okurate abaanyu, nka Arooni mukuru waawe oku yaabakuratsire, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.13",
            "verseOrgIds": [
              "NUM.27.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
