            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.6.23"
              },
              "items": [
                {
                  "text": "Rom 6:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " baayemerera omu maisho ga Musa na Eleazaari omunyamurwa n'abeebembezi n'eihanga ryona aha muryango gw'Eihema ry'okubugaabuganiramu; baagira bati: ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.2",
            "verseOrgIds": [
              "NUM.27.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 27:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tataitwe akagwa omu ihamba; kandi akaba atari mu mutwe gw'abaayeteeraine kugomera MUKAMA omu kigombe kya Koora; akafeera omu bibi bye wenka, kandi akaba atazaire boojo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.3",
            "verseOrgIds": [
              "NUM.27.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 27:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'enki ekirikwihisa eiziina rya tataitwe omu b'omuryango gwe, ngu ahabw'okuba tarazaire mwojo? Otuhe obutaka omu b'oruganda rwa tataitwe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.4",
            "verseOrgIds": [
              "NUM.27.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 27:5"
          },
