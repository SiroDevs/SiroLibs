          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "bwanyima omwemereze omu maisho ga Eleazaari omunyamurwa n'omu g'eihanga ryona, omukwatsize omurimo omu maisho gaabo. ",
          "type": "text",
          "attrs": {
