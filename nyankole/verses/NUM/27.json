              "items": [
                {
                  "text": "Kub 20:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ahabw'okuba mukagomera ekiragiro kyangye omu ihamba rya Ziini, obu eihanga ryampakanisa, mukanga kumpaisa ekitiinisa omu maisho gaaryo aha maizi. Ago nigo maizi ga Meriba omuri Kadeshi omu ihamba rya Ziini. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.14",
            "verseOrgIds": [
              "NUM.27.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
