              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu ku baatandikire kukanya omu nsi, kandi baazaara abaishiki, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.1",
            "verseOrgIds": [
              "GEN.6.1"
            ]
          }
        },
        {
