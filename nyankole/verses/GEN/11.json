            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.24.2"
              },
              "items": [
                {
                  "text": "Yos 24:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Teera ku yaamazire emyaka makumi mushanju, yaazaara Abramu, na Nahori na Harani. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.26",
            "verseOrgIds": [
              "GEN.11.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 11:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oru nirwo ruzaaro rwa Teera. Teera akazaara Abramu na Nahori na Harani; Harani yaazaara Looti, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.27",
            "verseOrgIds": [
              "GEN.11.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Harani yaafa ishe akiriho, yaagwa Uri ey'aba Kaludaaya, omu nsi ei yaazaariirwemu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.28",
            "verseOrgIds": [
              "GEN.11.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 11:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
