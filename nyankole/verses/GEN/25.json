            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "25:30",
              "type": "text"
            },
            {
              "text": "Edomu amakuru ngu, Ekirikutukura.",
              "type": "text"
            }
          ]
        },
        {
          "text": "Edomu.) ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.30",
            "verseOrgIds": [
              "GEN.25.30"
            ]
          }
        },
        {
