              "type": "text"
            }
          ]
        },
        {
          "text": "Eizooba rimwe Yakobo akaba ateekire ekicumbe; Esau yaija naaruga kuhiiga, naakooza aine enjara. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.29",
