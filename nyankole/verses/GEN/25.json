              "items": [
                {
                  "text": "3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi Isaaka akaba naakunda Esau, ahabw'okuba akaba arya aha nyama z'enyamaishwa ezi yaabaire ahiiga; kwonka Rebeka akaba akunda Yakobo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.28",
            "verseOrgIds": [
              "GEN.25.28"
            ]
          }
        }
