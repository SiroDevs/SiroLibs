          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esau yaagira Yakobo ati: Mpa ekyo kicumbe ekirikutukura, ndyeho; ahakuba naaza kugwa enshazi. (Eiziina rye nikyo ryayeteirwe ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.30",
            "verseOrgIds": [
              "GEN.25.30"
            ]
          }
        },
        {
