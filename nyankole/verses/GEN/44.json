          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omanye ngu nyowe omwiru waawe niinye naayemerereire ogu mwana ahari taata, ningira nti: Ku ndiba ntamukugaruriire, ndyagiibwaho orubanja orutarindugaho. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.32",
            "verseOrgIds": [
              "GEN.44.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
