              "items": [
                {
                  "text": "Kur 32:32",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " N'ahabw'ekyo ninkweshengyereza, Mukama wangye, mbe niinye naaguma aha, mbe omuhuuku waawe, haza omwana ogu we ataahe na bakuru be. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.33",
            "verseOrgIds": [
              "GEN.44.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
