                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " N'ahabw'ekyo ku ndigaruka aha mwiru waawe taata, omwojo tutamwine, yaareeba tutaija nawe, aryafa, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.30",
            "verseOrgIds": [
              "GEN.44.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 44:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "ahabw'okuba amagara ge gakwaitswe ag'ogu mwana; kandi itwe abairu baawe turyaba tureeteire omwiru waawe tataitwe obujune bw'okumuhuhura, ogwo mugurusi ashuume okuzimu n'ezo nju. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.31",
            "verseOrgIds": [
              "GEN.44.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
