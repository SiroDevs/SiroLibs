                  "text": "Kut 42:36",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mbwenu ku muraanyiheho n'ogu, haagira ekyamubaho, nimwija kundeetera obujune bumpuhure, nshuume okuzimu nk'oku murikundeeba n'ezi nju. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.29",
            "verseOrgIds": [
              "GEN.44.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
