              "type": "text"
            }
          ]
        },
        {
          "text": "omwe akandugaho, naateekateeka nti: Buzima akataagataagurwa; kandi n'okuhitsya hati tinkamureebaga. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.28",
            "verseOrgIds": [
