    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 38:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu biro ebyo Yuda akaruga omuri beene ishe, yaashuuma, yaataaha ow'omuntu orikwetwa Hiira owa Adulaamu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.1",
            "verseOrgIds": [
              "GEN.38.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 38:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.2.3"
              },
              "items": [
                {
                  "text": "1 Bus 2:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yuda yaareebayo omwishiki w'Omunyakanaani orikwetwa Shua; yaamutwara, yaabyama nawe; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.2",
            "verseOrgIds": [
              "GEN.38.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 38:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.26.19"
              },
              "items": [
                {
                  "text": "Kub 26:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " yaagira enda, yaazaara omwana w'omwojo, yaamweta Eeri. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.3",
            "verseOrgIds": [
              "GEN.38.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 38:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaagaruka yaagira enda, yaazaara ondiijo mwojo, yaamweta Onani; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.4",
            "verseOrgIds": [
              "GEN.38.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 38:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi yaagaruka yaagira enda, yaazaara ondiijo mwojo, yaamweta Sheela; obwo akaba ari Keziba, obu omukazi we yaazaara ogwo mwana. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.5",
            "verseOrgIds": [
              "GEN.38.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 38:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yuda yaashwererera omutabani omukuru Eeri omukazi eiziina rye Tamari. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.6",
            "verseOrgIds": [
              "GEN.38.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 38:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonka Eeri omujigaijo gwa Yuda akaba mubi omu maisho ga MUKAMA, MUKAMA nikwo kumwita. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.7",
            "verseOrgIds": [
              "GEN.38.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 38:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.22.24"
              },
              "items": [
                {
                  "text": "Mat 22:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima Yuda yaagira Onani ati: Irooko otaahe omwa muka mukuru waawe, oraare nawe, omumuzaarireho omwana. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.8",
            "verseOrgIds": [
              "GEN.38.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 38:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.25.6"
              },
              "items": [
                {
                  "text": "Bir 25:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Onani yaamanya ngu omwana tarikwija kuba owe; n'ahabw'ekyo ku yaabyamire na muka mukuru we, yaasheesha ahansi, ngu atazaarira mukuru we. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.9",
            "verseOrgIds": [
              "GEN.38.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 38:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eki yaakozire kyaba kibi omu maisho ga Mukama; nawe yaamwita. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.10",
            "verseOrgIds": [
              "GEN.38.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 38:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima Yuda yaagambira Tamari omukaamwana ati: Guma ori omufaakazi omu ka ya sho, okuhitsya obu omwana wangye Sheela arikura; ahakuba akatiina ngu naija kufa nka bakuru be. Tamari nikwo kugyenda, akaguma omu ka ya ishe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.11",
            "verseOrgIds": [
              "GEN.38.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 38:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.11",
            "verseOrgIds": [
              "GEN.38.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 38:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima ku haahingwireho ebiro, muhara wa Shua, muka Yuda, yaafa. Yuda ku yaarugire omu rufu rw'omukazi we, yainamuka Timuna hamwe na mugyenzi we Hiira owa Adulaamu, baaza ei abariisa be baabaire nibasharira ebyoya by'entaama. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.12",
            "verseOrgIds": [
              "GEN.38.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 38:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baagira Tamari bati: Shozaara yainamuka, yaaza Timuna kusharisa entaama ze ebyoya. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.13",
            "verseOrgIds": [
              "GEN.38.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 38:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaajuura ebijwaro by'obufaakazi, yaayetwekyerera akenda ah'amaisho, ogundi yaagwehumbika, yaashutama omu irembo rya Enaimu, eriri aha muhanda ogurikuza Timuna; ahabw'okuba akareeba Sheela akuzire, haza tibamumuha kumuhungura. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.14",
            "verseOrgIds": [
              "GEN.38.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 38:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yuda ku yaamureebire, yaagira ngu ni maraaya; ahakuba akaba ayetwekyereire ah'amaisho. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.15",
            "verseOrgIds": [
              "GEN.38.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 38:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaakiikama aha rubaju rw'omuhanda ahu yaabaire ari, yaamugira ati: Ninkweshengyereza, ija tubyame hamwe; (kwonka akaba atamanyire ku ari omukaamwana). Onu ati: Nompa ki, ku oraabyame naanye? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.16",
            "verseOrgIds": [
              "GEN.38.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 38:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaagira ati: Niinyija kukutwekyera omwana gw'embuzi ogw'omu busyo bwangye. Onu ati: Noija kunkwatiriza ki, okuhitsya obu oraaguntwekyere? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.17",
            "verseOrgIds": [
              "GEN.38.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 38:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaagira ati: Nkukwatirize ki? Onu ati: Ontsigire empeta yaawe eriho akamanyiso, n'orukoba rwawe, n'egyo nkoni ei oine omu ngaro. Yaabimuha, yaabyama nawe, yaamutweka. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.18",
            "verseOrgIds": [
              "GEN.38.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 38:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukazi yaimuka, yaayegyendera, yaayeiha ako kenda ahamutwe, yaagaruka yaajwara ebijwaro bye by'obufaakazi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.19",
            "verseOrgIds": [
              "GEN.38.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 38:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yuda yaatweka munywani we Omunyadulaamu omwana gw'embuzi ngu omukazi amugarurire ebi amukwatiriize; kwonka tiyaamushangayo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.20",
            "verseOrgIds": [
              "GEN.38.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 38:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaabuuza abashaija b'omuri ogwo mwanya ati: Maraaya obaire ari Enaimu aha rubaju rw'omuhanda agiire hi? Banu bati: Tihariho maraaya obaire ari aha. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.21",
            "verseOrgIds": [
              "GEN.38.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 38:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaagaruka ahari Yuda, yaamugira ati: Tinaamushangayo; kandi abaayo bangira ngu, Habaire hatariyo maraaya. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.22",
            "verseOrgIds": [
              "GEN.38.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 38:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yuda yaagira ati: K'agume nabyo, turekye kuhemuka; ahakuba naakutweka omwana gw'embuzi, tiwaamushangayo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.23",
            "verseOrgIds": [
              "GEN.38.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 38:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.21.9"
              },
              "items": [
                {
                  "text": "Lev 21:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ku haahingwireho nk'ameezi ashatu, baagambira Yuda bati: Tamari mukaamwana waawe akeegira maraaya, mbwenu aine enda y'obushambani. Yuda yaagira ati: Mumushohoze, bamunagye omu muriro. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.24",
            "verseOrgIds": [
              "GEN.38.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 38:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku baamushohoize, yaatuma ahari ishezaara, naagira ati: Mukama w'ebintu ebi niwe yantwekire enda; kandi ati: Ninkweshengyereza, obyetegyereze, empeta eriho akamanyiso n'orukoba n'enkoni, omanye mukama waabyo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.25",
            "verseOrgIds": [
              "GEN.38.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 38:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yuda yaikiriza ku biri ebye, yaagira ati: We niwe ahikiriire okunkira, ahakuba tindamuhaire Sheela mutabani wangye. Tiyaagaruka kubyama nawe obundi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.26",
            "verseOrgIds": [
              "GEN.38.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 38:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.26",
            "verseOrgIds": [
              "GEN.38.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 38:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obunaku bwe bw'okuzaara ku bwahikire, yaareebeka aine enda y'empasha. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.27",
            "verseOrgIds": [
              "GEN.38.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 38:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku yaabaire naarumwa, omwe yaashohoza omukono, omuzaarisa yaagukwata, yaagukomaho akahuuzi akarikutukura, yaagira ati: Ogu niwe yaabanza kushohora. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.28",
            "verseOrgIds": [
              "GEN.38.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 38:29"
          },
          "items": [
            {
