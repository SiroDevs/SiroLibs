              "items": [
                {
                  "text": "Heb 2:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kandi ndyata obuzigu ahagati yaawe n'ogu mukazi, n'ahagati y'oruzaaro rwawe n'orwe; orwe ruryakuteera omutwe, naiwe oryaruteera ekitsintsiino. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.15",
            "verseOrgIds": [
              "GEN.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.2.15"
              },
              "items": [
                {
                  "text": "1 Tim 2:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yaakubuukana omukazi, yaamugira ati: Ndyakanyisa munonga obusaasi bwawe omu kuzaara; omu busaasi nimwo orizaarira abaana; n'okwetenga kwawe kuryaguma kube ahari baro; nawe aryakutegyeka. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.16",
            "verseOrgIds": [
              "GEN.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi yaagira Adamu ati: Ahabw'okuhurira eiraka ry'omukazi waawe, okarya aha muti ogu naakuzibiire kuryaho, eitaka ryakyeenwa ahabwawe; oryaguma oriihemu eby'okurya obihendekyeire ebiro byona eby'amagara gaawe; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.17",
            "verseOrgIds": [
              "GEN.3.17"
            ]
          }
        },
        {
