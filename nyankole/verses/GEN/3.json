                "loc": "REV.20.2"
              },
              "items": [
                {
                  "text": "Kush 20:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi enjoka ekaba eri enyabwengye okukira enyamaishwa zoona ezi MUKAMA Ruhanga yaahangire. Yaabuuza omukazi eti; N'eky'amazima, Ruhanga akagira ngu mutarirya aha muti gwona ogw'omuri eki kibanja? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.1",
            "verseOrgIds": [
              "GEN.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukazi yaagarukamu enjoka ati: Nitwikirizibwa kurya ebijuma by'emiti y'omu kibanja, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.2",
            "verseOrgIds": [
              "GEN.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "kureka ebijuma by'omuti oguri ahagati y'ekibanja; nibyo Ruhanga yaagizire ati: Mutaribirya, n'obu kwakuba okubikoraho, mutakaafa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.3",
            "verseOrgIds": [
              "GEN.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.11.3"
              },
              "items": [
                {
                  "text": "2 Kor 11:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Enjoka yaagambira omukazi eti: Okufa kwo, buzima timurifa; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.4",
            "verseOrgIds": [
              "GEN.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "ahabw'okuba Ruhanga naamanya ngu eizooba eri muriguryaho, amaisho gaanyu garyaiguka, naimwe mube nka Ruhanga, mumanye oburungi n'obubi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.5",
            "verseOrgIds": [
              "GEN.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.5.12+ROM.5.13+ROM.5.14+ROM.5.15+ROM.5.16+ROM.5.17+ROM.5.18+ROM.5.19"
              },
              "items": [
                {
                  "text": "Rom 5:12-19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omukazi ku yaareebire omuti guri murungi kurya, nigushemeza amaisho, kandi nigwetengwa ahabw'okuha omuntu obwengye, yaacwa aha bijuma byagwo, yaarya, yaahaho na iba, nawe yaarya. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.6",
            "verseOrgIds": [
              "GEN.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahonaaho amaisho gaabo bombi gaiguka, baamanya ku bajwaire busha, baayebaziirira amababi g'omutiini g'okwekingaho.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.7",
            "verseOrgIds": [
              "GEN.3.7"
            ]
          }
        }
      ]
    },
