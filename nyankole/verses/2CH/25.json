          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbwenu endiijo mirimo ya Amazia, okuruga aha kutandika okuhika aha muheru, tehandiikirwe omu kitabo ky'abagabe ba Yuda na Israeli? ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.26",
            "verseOrgIds": [
              "2CH.25.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 25:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okuruga omu bunaku obu yaarugiiremu ahari MUKAMA, bakamugirira enaama y'okumugomera omuri Yerusaalemu; yaahungira Lakishi; kwonak baamukuratsa abantu Lakishi, baamwitirayo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.27",
            "verseOrgIds": [
              "2CH.25.27"
            ]
          }
        },
        {
