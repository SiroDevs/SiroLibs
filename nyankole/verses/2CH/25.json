              },
              "items": [
                {
                  "text": "2 Bus 21:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yehoashi omugabe wa Israeli yaakwata Amazia omugabe wa Yuda, mwene Yoasi, mwijukuru wa Ahazia; yaamukwatira Beti-shemeshi, bwanyima yaamureeta Yerusaalemu, yaasheenya orugo rwayo rw'amabaare ekicweka kya mikono magana ana okuruga aha irembo rya Efuraimu okuhika aha irembo ry'aha keekubo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.23",
            "verseOrgIds": [
              "2CH.25.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 25:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi yaanyaga ezaabu n'efeeza zoona n'ebintu byona ebyashangirwe omu nju ya Ruhanga hawe na Obededomu; yaagaruka yaanyaga eby'omu mabiikiro g'eju y'omugabe, kandi yaabaihamu abantu, yaabagira omukwato; bwanyima yaagaruka Samaria.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.24",
            "verseOrgIds": [
              "2CH.25.24"
            ]
          }
        }
