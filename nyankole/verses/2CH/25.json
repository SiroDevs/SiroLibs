          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.5",
            "verseOrgIds": [
              "2CH.25.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.1.3"
              },
              "items": [
                {
                  "text": "Kub 1:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima Amazia yaateerana abashaija ba Yuda, yaabataho kutegyekwa abakuru b'engabo rukumi-rukumi n'aba igana-igana, nk'amaju ga baishenkurubo oku gaabaire gari, ahabwa Yuda na Benyamiini yoona. Yaateerana abahikize emyaka makumi abiri n'okukiraho, yaashanga bari obusiriira bushatu, abashaija entoore, abarikubaasa eby'engamba, bakamanya kurwanaisa amacumu n'engabo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.5",
            "verseOrgIds": [
              "2CH.25.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaagaruka yaagurira abashaja b'amaani amamanzi aba Israeli akasiriira kamwe n'etalanta z'efeeza igana. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.6",
            "verseOrgIds": [
              "2CH.25.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonka omushaija wa Ruhanga yaija ah'ari, yaamugira ati: Nyakusinga omugabe, otaikiriza eihe rya Israeli kuhurura naiwe, ahabw'okuba MUKAMA tari hamwe na Israeli, Abaefuraimu aba boona. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.7",
            "verseOrgIds": [
              "2CH.25.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.20.6"
              },
              "items": [
                {
                  "text": "2 Bus 20:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ku oraabe noogira ngu oine amaani g'okurwana, omanye ngu Ruhanga naija kukuteera ahansi omu maisho g'abazigu baawe; ahakuba Ruhanga aine obushoboorozi bw'okuhwera, nari obw'okutuura ahansi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.8",
            "verseOrgIds": [
              "2CH.25.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amazia yaagira ogwo mushaija wa Ruhanga ati: Mbwenu shi tugire tuta ezo talanta igana, ezi mpaire eihe rya Israeli? Omushaija wa Ruhanga yaamugarukamu ati: MUKAMA naabaasa kukuha nyingi munonga ezirikukira ezo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.9",
            "verseOrgIds": [
              "2CH.25.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima Amazia yaaragiira eihe, eryamwizireho niriruga Efuraimu, kugaruka omuka. Baagwerwa kubi munonga Abayuda, baagaruka omuka baine ekiniga kingi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.10",
            "verseOrgIds": [
              "2CH.25.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonka Amazia we yaaguma, yaahuruza abantu be, baaza omu ruhita rw'omwonyo, baita omu bashaija ba Seiri abantu kakumi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.11",
            "verseOrgIds": [
              "2CH.25.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi Abayuda baakwata abandi kakumi bahuriire, baabatwara aha mutwe gw'ekibaare kihango, baabatambika, baayetuura ahansi, baacwagacwagurika boona. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.12",
            "verseOrgIds": [
              "2CH.25.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 25:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonka abashaija b'eryo ihe, abu Amazia yaagarwireyo, akanga ku bahurura nawe, baateera endembo za Yuda okuruga Samaria okuhika Besi-horoni, baaziitamu abantu enkumi ishatu, baanyaga eminyago mingi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.13",
            "verseOrgIds": [
              "2CH.25.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
