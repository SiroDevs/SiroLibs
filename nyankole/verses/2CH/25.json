          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'ahabw'ekyo Yehoashi omugabe wa Israeli, yainamuka; we na Amazia omugabe wa Yuda baabugaabuganira Beti-shemeshi eya Yuda, baarwanirayo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.21",
            "verseOrgIds": [
              "2CH.25.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 25:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abayuda baabingwa Abaisraeli, buri muntu yaahungira omu ka ye. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.22",
            "verseOrgIds": [
              "2CH.25.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 25:23"
          },
          "items": [
