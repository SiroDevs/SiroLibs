                "loc": "2KI.14.1+2KI.14.2+2KI.14.3+2KI.14.4+2KI.14.5+2KI.14.6"
              },
              "items": [
                {
                  "text": "2 Bag 14:1-6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Amazia akaba aine emyaka makumi abiri n'etaano, obu yaatandika kutegyeka; yaategyekyera Yerusaalemu emyaka makumi abiri na mwenda. Nyina akaba naayetwa Yehoadaani, owa Yerusaalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.1",
            "verseOrgIds": [
              "2CH.25.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.25.14"
              },
              "items": [
                {
                  "text": "2 Bus 25:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yaakora ebirikusiimwa MUKAMA, kwonka ataine mutima guhikire. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.2",
            "verseOrgIds": [
              "2CH.25.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku yaaherize kuhamibwa ati omu omu bugabe bwe, yaita abaheereza be abaitsire omugabe ishe; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.3",
            "verseOrgIds": [
              "2CH.25.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.24.16"
              },
              "items": [
                {
                  "text": "Bir 24:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.31.30"
              },
              "items": [
                {
                  "text": "Yer 31:30",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.18.20"
              },
              "items": [
                {
                  "text": "Ezk 18:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kwonka tiyaita baana baabo, nk'oku kihandiikirwe omu kitabo kya Musa ey'ebiragiro, omu MUKAMA yaaragiriire ati: Baishe b'abaana batariitwa nibaturwa abaana baabo, kandi n'abaana batariitwa nibaturwa baishebo; kureka omuntu weena aryaitwa ahabw'ekibi kye.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.4",
            "verseOrgIds": [
              "2CH.25.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
