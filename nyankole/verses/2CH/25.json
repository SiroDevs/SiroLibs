              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Amazia mwene Yoasi omugabe wa Yuda akamara emyaka ikumi n'etaano bwanyima y'okufa kwa Yehoashi mwene Yehoahazi omugabe wa Israeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.25",
