                "loc": "1CH.23.30"
              },
              "items": [
                {
                  "text": "1 Bus 23:30",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.23.31"
              },
              "items": [
                {
                  "text": "31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima Hezekia yaabaganisa abanyamurwa n'Abaleevi omu bicweka, buri kicweka nk'omurimo gwakyo gw'okuheereza oku gwabaire guri, abanyamurwa n'Abaleevi okuguma nibatamba ebitambo by'okwotsya, okuhonga empongano z'okusiima ahabw'obusingye, okuheereza, okusiima n'okuhimbisiza omu marembo g'orusiisira rwa MUKAMA. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.2",
            "verseOrgIds": [
              "2CH.31.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 31:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.35.7"
              },
              "items": [
                {
                  "text": "2 Bus 35:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": "Kub 28:3—29:40.",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi omugabo ogu omugabe yaihire omu bintu bye kuguma naaha gukaba guri ogw'ebitambo by'okwotsya,–ebitambo by'okwotsya omu kasheeshe n'omu mwabazyo, ebya sabato, eby'okuboneka kw'ameezi n'eby'amagyenyi agaatairweho, nk'oku bihandiikirwe omu biragiro bya MUKAMA. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.3",
            "verseOrgIds": [
              "2CH.31.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 31:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.18.8+NUM.18.9+NUM.18.10+NUM.18.11+NUM.18.12+NUM.18.13+NUM.18.14+NUM.18.15+NUM.18.16+NUM.18.17+NUM.18.18+NUM.18.19+NUM.18.20+NUM.18.21+NUM.18.22+NUM.18.23+NUM.18.24"
              },
              "items": [
                {
                  "text": "Kub 18:8-24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yaagaruka yaaragiira abantu abaabaire batwire Yerusaalemu kuguma nibaha abanyamurwa n'Abaleevi emigabo ebashemereire, ngu nabo babone kwehayo omu biragiro bya MUKAMA. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.4",
            "verseOrgIds": [
              "2CH.31.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 31:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekiragiro ekyo ku kyaherize kiti kubuga, Abaisraeli baareeta emiganuro mingi munonga, engano, viinyo, amajuta, obwoki n'ebindi byona ebyarugire omu misiri; kandi baareeta ana kimwe kya ikumi ekya buri kintu, byaba bingi munonga. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.5",
            "verseOrgIds": [
              "2CH.31.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 31:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.27.30"
              },
              "items": [
                {
                  "text": "Lev 27:30",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.14.28"
              },
              "items": [
                {
                  "text": "Bir 14:28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abaisraeli n'Abayuda abaabaire batwire omu ndembo za Yuda nabo baareeta kimwe kya ikumi eky'ente n'entaama, n'ebintu ebyeziibwe, ebyabaire bishorooreirwe MUKAMA Ruhanga waabo, ebintu ebyo baabituuma emituumo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.6",
            "verseOrgIds": [
              "2CH.31.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 31:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu kwezi kwa kashatu nibwo baatandika kutuuma egyo mituumo, bakaheza omu kwezi kwa mushanju. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.7",
            "verseOrgIds": [
              "2CH.31.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 31:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hezekia n'abanyiginya ku baizire, baareeba egyo mituumo, baasiima MUKAMA n'abantu be Idraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.8",
            "verseOrgIds": [
              "2CH.31.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 31:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima Hezekia yaabuuza abanyamurwa n'Abaleevi eby'egyo mituumo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.9",
            "verseOrgIds": [
              "2CH.31.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 31:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAL.3.10"
              },
              "items": [
                {
                  "text": "Mal 3:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Azaria omunyamurwa omukuru, ow'omu nju ya Zadoki, yaamugarukamu ati: Obu abantu baatandika kureeta emitoijo omu nju ya MUKAMA, tukatandika obwo kurya n'okuhaaga, n'okushaazya bingi; ahabw'okuba MUKAMA akaha abantu be omugisha, nikyo ebi ebyashaagire bibeereire bingi biti.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.10",
            "verseOrgIds": [
              "2CH.31.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 31:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.10",
            "verseOrgIds": [
              "2CH.31.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 31:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima Hezekia yaaragiira ku bateguura ebishenye by'enju ya MUKAMA; baabiteguura. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.11",
            "verseOrgIds": [
              "2CH.31.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 31:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baatamu emitoijo, ebicweka bya kimwe kya ikumi, n'ebintu ebyashoroirwe n'obwesigwa. Omukuru waabo owaabaire naabareeberera akaba ari Konania Omuleevi, owa kabiri ari Shimei omurumuna; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.12",
            "verseOrgIds": [
              "2CH.31.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 31:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehieli, Azazia, Nahasi, Asaheeli, Yerimoosi, Yozabaadi, Elieli, Ismakia, Mahasi na Benaaya, nibo baabaire bari abareeberezi nibahwera Konania na Shimei omurumuna, nk'oku kyaragiirwe Hezekia omugabe na Azaria omukuru w'enju ya Ruhanga. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.13",
            "verseOrgIds": [
              "2CH.31.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 31:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi Koore mwene Imuna Omuleevi, omurinzi w'eirembo ry'oburugwa-izooba niwe yaabaire naategyeka emitoijo etoijeirwe Ruhanga n'omutima gwekundiire, naabaganisa ebintu ebibiikiirwe MUKAMA ahabw'empongano ezrikwera munonga. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.14",
            "verseOrgIds": [
              "2CH.31.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 31:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.21.9+JOS.21.10+JOS.21.11+JOS.21.12+JOS.21.13+JOS.21.14+JOS.21.15+JOS.21.16+JOS.21.17+JOS.21.18+JOS.21.19"
              },
              "items": [
                {
                  "text": "Yos 21:9-19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Edeni, Minyamiini, Yeshua, Shemaaya, Amaria na Shekania bakaba bari abeesigwa nibamuhwera omu ndembo z'abanyamurwa, kubaganisiza beene waabo emigabo, abakuru n'abato nibabainganisa, nk'oku ebicweka byabo byabaire biri, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.15",
            "verseOrgIds": [
              "2CH.31.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 31:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "otaireho abaabaire nibahandiikwa nk'oku oruzaaro rwabo rwabaire nirukuratana, abeetwa abashija okuru ga aha myaka eshatu n'okukiraho, boona abaabaire bataaha omu nju ya MUKAMA, nk'okwetenga kw'omurimo gwa buri izooba oku kwabaire kuri, ngu babone kukora omurimo gwabo, nk'oku embu zaabo zaabaire nizikuratana. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.16",
            "verseOrgIds": [
              "2CH.31.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 31:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.23.24+1CH.23.25+1CH.23.26+1CH.23.27"
              },
              "items": [
                {
                  "text": "1 Bus 23:24-27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abanyamurwa bakahandiikwa, nk'oku amaju ga baishenkurubo gaabaire gari; n'Abaleevi abaabaire baine emyaka makumi abiri n'okukiraho baahandiikwa omu bicweka byabo, nk'oku omurimo gwabo gwabaire guri. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.17",
            "verseOrgIds": [
              "2CH.31.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 31:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanyamurwa baahandiikwa n'abaana baabo abato boona n'abakazi baabo na batabani baabo na bahara baabo, okumarayo oruganda rwona; ahabw'okuba bakaba bari abeesigwa omu kwerinda kuguma bari abarikwera. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.18",
            "verseOrgIds": [
              "2CH.31.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 31:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.25.34"
              },
              "items": [
                {
                  "text": "Lev 25:34",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi ahabw'abanyamurwa beene Arooni, abaabaire batwire omu byaro ebyehinguririize endembo zaabo, omuri buri rurembo hakaba harimu abantu abagambirweho amaziina kuba ab'okugaburira oyetwa omushaija weena omu banyamurwa, n'omuntu weena ow'omu Baleevi owaahandiikirwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.19",
            "verseOrgIds": [
              "2CH.31.19"
            ]
          }
        },
        {
