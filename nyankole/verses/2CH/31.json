              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okwo nikwo Hezekia yaabitwarize omuri Yuda yoona, akakora ebirikusiimwa MUKAMA n'eby'oburyo kandi n'eby'obwesigwa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.20",
            "verseOrgIds": [
              "2CH.31.20"
            ]
