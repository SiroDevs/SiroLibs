            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.12.6"
              },
              "items": [
                {
                  "text": "Kur 12:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.12.18"
              },
              "items": [
                {
                  "text": "18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ahabw'okuba tibarabaasize kubutaho mu bunaku bwabwo ahabw'omubaro gw'abanyamurwa abeeyerize kutahika, kandi n'ahabw'abantu kushangwa batateeraniire Yerusaalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.3",
            "verseOrgIds": [
              "2CH.30.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 30:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Egyo naama yaasiimwa omugabe n'abantu boona. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.4",
            "verseOrgIds": [
              "2CH.30.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 30:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batyo baataho ekirangiriro, baakirangirira omuri Israeli yoona, okutandikira Beeri-sheba okuhika Daani, ngu abantu baije Yerusaalemu, bakorere MUKAMA, Ruhanga wa Israeli, obugyenyi bw'Okuhingurwaho; ahabw'okuba bakaba batakibukora bari baingi munonga, nk'oku kyabaire kihandiikirwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.5",
            "verseOrgIds": [
              "2CH.30.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 30:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
