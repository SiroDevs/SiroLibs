                "loc": "PSA.68.5"
              },
              "items": [
                {
                  "text": "Zab 68:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima abanyamurwa n'Abaleevi baimuka, baashabira abantu omugisha; eiraka ryabo ryahurirwa, kandi okushaba kwabo kwahika omu mwanya gwe ogurikwera ogu atuuramu omu iguru.",
          "type": "text",
          "attrs": {
