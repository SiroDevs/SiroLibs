            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Batyo baamatarisi baaraba omu nsi ya Efuraimu n'eya Manaase, nibaruga omu rurembo nibaza omu rundi, baahika n'omu nsi ya Zebuluuni; abaayo baabashekyerera munonga, baabateerera enaku. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.10",
            "verseOrgIds": [
              "2CH.30.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 30:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonka abamwe aha Baasheri n'Abamanaase n'Abazebuluuni baayoroba, baija Yerusaalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.11",
            "verseOrgIds": [
              "2CH.30.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 30:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.29.15"
              },
              "items": [
                {
                  "text": "2 Bus 29:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi n'omuri Yuda omukono gwa MUKAMA gwabaha kugira omutima gumwe, baayorobera ekiragiro ky'omugabe n'abanyiginya eki baaragiirwe ekigambo kya MUKAMA.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.12",
            "verseOrgIds": [
              "2CH.30.12"
            ]
          }
        }
