                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " N'ahabw'ekyo mbwenu mutagira ebitsya bigangaire nka baashwenkuriimwe, kureka mwehongyere MUKAMA, mutaahe omu Mwanya gwe ogurikwera, ogu yaayerize kuba ogurikwera ebiro byona, muheereze MUKAMA Ruhanga waanyu, ekiniga kye kingi kibone kubarugaho. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.8",
            "verseOrgIds": [
              "2CH.30.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
