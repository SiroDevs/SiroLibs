              "items": [
                {
                  "text": "Dan 9:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ahakuba ku muraagarukire MUKAMA, beene wanyu n'abaana baanyu nibaija kugirirwa embabazi abaabatwaire bari enkwatwa, bagarukye omu nsi egi. Ahabw'okuba MUKAMA Ruhanga waanyu agira embabazi n'esaasi; kandi ku muraamugarukire, tarikwija kubaima maisho.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.9",
            "verseOrgIds": [
              "2CH.30.9"
            ]
          }
        }
