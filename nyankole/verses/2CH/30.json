          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanyima Hezekia yaatuma aha Baisraeli n'aha Bayuda boona, kandi yaahandiikira Abaefuraimu n'Abamanaase ebaruha, kwija omu nju ya MUKAMA Yerusaalemu, kukorera MUKAMA Ruhanga wa Israeli obugyenyi bw'Okuhingurwaho. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.1",
            "verseOrgIds": [
              "2CH.30.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 30:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.9.10"
              },
              "items": [
                {
                  "text": "Kub 9:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.9.11"
              },
              "items": [
                {
                  "text": "11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ahabw'okuba omugabe n'abanyiginya be, n'abantu boona abaateeraniire Yerusaalemu bakaba bahanwire kutaho obugyenyi bw'Okuhingurwaho omu kwezi kwa kabiri, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.2",
            "verseOrgIds": [
              "2CH.30.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 30:3"
          },
          "items": [
            {
