                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.20.18"
              },
              "items": [
                {
                  "text": "Ezk 20:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mutaba nka baashwenkuriimwe nari beene waanyu, abaabaire bacumura ahari MUKAMA, Ruhanga wa baishenkurubo, kikamureetera kubahayo, bakahwerekyerera, nk'oku murikureeba. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.7",
            "verseOrgIds": [
              "2CH.30.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
