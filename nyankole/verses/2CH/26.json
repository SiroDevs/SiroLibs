            "verseId": "2CH.26.6",
            "verseOrgIds": [
              "2CH.26.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.14.29"
              },
              "items": [
                {
                  "text": "Isa 14:29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima yaahurura, yaaza kurwana n'Abafilistia, yaasheenya orugo rw'amabaare orwa Gaasi, orwa Yabune n'orwa Ashidoodi; yaayombeka endembo omu ishaza rya Ashidoodi n'aahandi omu nsi y'Abafilistia. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.6",
            "verseOrgIds": [
              "2CH.26.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 26:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi Ruhanga yaamuhwera omu kurwanisa Abafilistia n'Abaharabu, abaabaire batwire Gurubaali, n'Abameuni. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.7",
            "verseOrgIds": [
              "2CH.26.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 26:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaamoni baareetera Uziya emitoijo; kandi okurangaanwa kwe kwabuga, kwahika n'aha mwatano gwa Misri; ahakuba akaba ow'amaani munonga. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.8",
            "verseOrgIds": [
              "2CH.26.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 26:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi Uziya yaayombeka eminaara omuri Yerusaalemu aha Irembo ry'aha keekubo, aha Irembo ry'oruhanga, n'aha Keekubo, yaagihamya. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.9",
            "verseOrgIds": [
              "2CH.26.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 26:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaagaruka yaayombeka eminaara omu ihamba, yaatimba amaziba maingi, ahakuba akaba aine amasyo maingi omu mirambi n'omu mpita; kandi aine abahingi n'abasharizi b'emizaabibu omu bibungo n'omu byanga ebirikweza; ahabw'okuba akaba akunda munonga eby'okuhinga.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.10",
            "verseOrgIds": [
              "2CH.26.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 26:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.10",
            "verseOrgIds": [
              "2CH.26.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi Uziya akaba aine eihe ry'abaserukare, abahikire kuza aha rugamba, bari omu mitwe y'engabo, nk'oku omubaro gwabaire guri ogw'abaabazirwe Yeyeli omuhandiiki na Maaseya omutware, nibareebererwa Hanania, omwe aha bakuru b'engabo b'omugabe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.11",
            "verseOrgIds": [
              "2CH.26.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 26:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omubaro gwona ogw'abakuru b'amaju ga baishenkurubo, abashaija b'amaani amamanzi, gukaba guri enkumi ibiri na magana mukaaga. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.12",
            "verseOrgIds": [
              "2CH.26.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 26:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakaba nibategyeka eihe ry'abashaija obusiriira bushatu n'enkumi mushanju na magana ataano, abaabaire nibabaasa kurwanisa amaani maingi, bakahwera omugabe kumujuna abazigu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.13",
            "verseOrgIds": [
              "2CH.26.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 26:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi Uziya yaateekateekyera eihe ryona engabo, amacumu, enkofiira z'orugamba, ebizibaho by'ebyoma, amata n'amabaare g'enjungu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.14",
            "verseOrgIds": [
              "2CH.26.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 26:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuri Yerusaalemu yaakoreramu ebyoma, ebyagunzirwe abanyamyoga, eby'okuta aha minaara n'aha bwekubo bw'engo z'amabaare, okurasisa emyambi n'okurekyeza amabaare mahango. Okurangaanwa kwe kwabuga hoona; ahakuba akahwerwa okutakareebwaga, okuhitsya obu yaahamire. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.15",
            "verseOrgIds": [
              "2CH.26.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 26:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.12.1"
              },
              "items": [
                {
                  "text": "2 Bus 12:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.32.25"
              },
              "items": [
                {
                  "text": "32:25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.8.14"
              },
              "items": [
                {
                  "text": "Bir 8:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.32.15"
              },
              "items": [
                {
                  "text": "32:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka ku yaaherize kuhama, yaagira amaryo, gaamwita; ahakub aakacumura ahari MUKAMA Ruhanga we, yaataaha omuri hekalu ya MUKAMA kwoterera obubaane aha kyoterero kyabwo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.16",
            "verseOrgIds": [
              "2CH.26.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 26:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.6.10"
              },
              "items": [
                {
                  "text": "1 Bus 6:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka Azaria omunyamurwa yaataahamu amukuratiire, n'abanyamurwa ba MUKAMA makumi munaana, abashaija amamanzi; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.17",
            "verseOrgIds": [
              "2CH.26.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 26:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.16.40"
              },
              "items": [
                {
                  "text": "Kub 16:40",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.18.7"
              },
              "items": [
                {
                  "text": "18:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.30.7"
              },
              "items": [
                {
                  "text": "Kur 30:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.30.8"
              },
              "items": [
                {
                  "text": "8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " baamuzibira nibamugira bati: Ti murimo gwawe, Uziya, kwoterera MUKAMA obubaane, kureka n'ogw'abanyamurwa beene Aooni abashorooreirwe okwotera obubaane. Ruga omu Mwanya ogurikwera; ahakuba waacumura, kandi tikirikwija kukuhaisa kitiinisa ahari MUKAMA Ruhanga. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.18",
            "verseOrgIds": [
              "2CH.26.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 26:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.5.27"
              },
              "items": [
                {
                  "text": "2 Bag 5:27",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.12.10"
              },
              "items": [
                {
                  "text": "Kub 12:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Uziya yaagira ekiniga. Obwo akaba aine akooterero k'obubaane omu ngaro, naaza kubwotera; ku yaagiriire ati abanyamurwa ekiniga, ahonaaho ebibembe byamusheesha aha buso omu maisho g'abanyamurwa omu nju ya MUKAMA, ahu yaabaire ayemereire aha rubaju rw'ekyoterero ky'obubaane. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.19",
            "verseOrgIds": [
              "2CH.26.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 26:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azaria omunyamurwa omukuru n'abandi banyamurwa baoona ku baagiire kumwetegyereza bati, baashanga aine ebibembe aha buso. Baamutsindika n'amaani kumushohoza, kandi nawe yairuka, yaashohora, ahabw'okuba MUKAMA akaba amuteire. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.20",
            "verseOrgIds": [
              "2CH.26.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 26:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.15.5+1KI.15.6+1KI.15.7"
              },
              "items": [
                {
                  "text": "1 Bag 15:5-7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omugabe Uziya yaaguma ari omubembe okuhitsya aha izooba eri yaafeereireho; ahabw'okubemba yaaguma hangahari naaraara omu nganyo, ahabw'okuba akacuubwa omu nju ya MUKAMA. Bwanyima Yosamu omutabani yaaguma naareeberera ekikaari ky'omugabe, kandi naategyeka abantu b'omuri egyo nsi.",
