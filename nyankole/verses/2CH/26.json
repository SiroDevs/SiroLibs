        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 26:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abayuda boona baatwara Uziya, owaabaire aine emyaka ikumi na mukaaga, baamwemeka omu mwanya gwa ishe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.1",
            "verseOrgIds": [
              "2CH.26.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 26:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaayombeka Eloosi, yaagigarurira Abayuda, omugabe ishe aharize kugwejegyera kushanga baishenkuru. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.2",
            "verseOrgIds": [
              "2CH.26.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 26:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.15.2"
              },
              "items": [
                {
                  "text": "2 Bag 15:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.15.3"
              },
              "items": [
                {
                  "text": "3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Uziya akaba aine emyaka ikumi na mukaaga, obu yaatandiak kutegyeka, yaategyekyera Yerusaalemu emyaka makumi ataano n'ebiri. Nyina akaba naayetwa Yekolia owa Yerusaalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.3",
            "verseOrgIds": [
              "2CH.26.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 26:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaakora ebirikusiimwa MUKAMA, nk'ebi Amazia ishe yaakozire byona. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.4",
            "verseOrgIds": [
              "2CH.26.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 26:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu biro bya Zekaria, owaabaire naamwegyesa okutiina Ruhanga, akamariirira kusherura Ruhanga; kandi omwanya gwona ogu yaamazire naasherura MUKAMA, Ruhanga akamuha omugisha.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.5",
            "verseOrgIds": [
              "2CH.26.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 26:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.5",
            "verseOrgIds": [
              "2CH.26.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 26:6"
          },
          "items": [
            {
              "text": "6",
