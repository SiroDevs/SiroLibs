        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.6.23+1KI.6.24+1KI.6.25+1KI.6.26+1KI.6.27+1KI.6.28"
              },
              "items": [
                {
                  "text": "1 Bag 6:23-28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omu Mwanya ogurikwera munonga yaatamu ebishushani bya baakerubi ebi yaakozire omu mbaaho, yaabishweka ezaabu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.10",
            "verseOrgIds": [
              "2CH.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amapapa ga baakerubi bombi, goona hamwe gaaba mikono makumi abiri oburaingwa; eipapa ry'omwe erya mikono etaano ryahika aha kisiika ky'enju, kandi erindi ipapa, naryo rya mikono etaano, ryahika aha ipapa rya kerubi ondiijo; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.11",
            "verseOrgIds": [
              "2CH.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi eipapa rya kerubi ogwo owa kabiri rya mikono etaano ryahika aha kisiika ky'enju, n'erindi, naryo rya mikono etaano, ryahika aha ipapa rya mugyenzi we ow'okubanza. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.12",
            "verseOrgIds": [
              "2CH.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gatyo amapapa ga baakerubi abo gaaba mikono abiri oburaingwa. Ebishushani bya baakerubi bikaba byemereire, nibireeba ekishengye kya hekalu eky'ahagati. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.13",
            "verseOrgIds": [
              "2CH.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.26.31"
              },
              "items": [
                {
                  "text": "Kur 26:31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi yaakora omukingo omu myenda ya bururu, bujwa, karara na kitaani, yaagutarizamu ebishushani bya baakerubi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.14",
            "verseOrgIds": [
              "2CH.3.14"
            ]
          }
        }
      ]
