            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.6.16"
              },
              "items": [
                {
                  "text": "1 Bag 6:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi yaayombeka Aharikwera munonga; oburaingwa bwaho bwaingana n'obukiika bwa hekalu, bwaba mikono makumi abiri, kandi n'obuhango bwaho bwaba mikono makumi abiri; yaahashweka n'etalanta z'ezaabu eshemeziibwe magana mukaaga. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.8",
            "verseOrgIds": [
              "2CH.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.28.11"
              },
              "items": [
                {
                  "text": "1 Bus 28:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Oburemeezi bw'emisomaari bwaba shekeli z'ezaabu makumi ataano. Kandi ebishengye bya kaanyina-ibiri nabyo yaabishweka ezaabu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.9",
            "verseOrgIds": [
              "2CH.3.9"
            ]
          }
        }
      ]
    },
    {
