                "loc": "1KI.6.32"
              },
              "items": [
                {
                  "text": "32",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ekishengye kya hekalu eky'ahagati yaakishweka embaaho z'emiberooshi, nazo yaazishweka ezaabu eshemeziibwe, yaazisharuraho emikindo n'emikuuru. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.5",
            "verseOrgIds": [
              "2CH.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Egyo nju yaagihunda n'amabare g'obuguzi bwingi; egyo zaabu ekaba eri eya Paruvaimu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.6",
            "verseOrgIds": [
              "2CH.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atyo yaashweka egyo nju n'ezaabu, emitambiko yaayo, emiryango yaayo, ebisiika byayo n'enyigi zaayo; kandi ha bisiika byayo yaasharuraho ebishushani bya baakerubi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.7",
            "verseOrgIds": [
              "2CH.3.7"
            ]
          }
        }
      ]
    },
    {
