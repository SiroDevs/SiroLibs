                  "text": "21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yaataho abantu obukumi mushanju b'okwekorera, obukumi munaan b'okuhigura amabaare omu nshozi, n'enkumi ishatu na magana mukaaga b'okubareeberera. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.2.2",
            "verseOrgIds": [
              "2CH.2.2"
            ]
          }
        },
        {
