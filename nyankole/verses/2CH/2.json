            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.15.11"
              },
              "items": [
                {
                  "text": "Kur 15:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.86.8"
              },
              "items": [
                {
                  "text": "Zab 86:8",
