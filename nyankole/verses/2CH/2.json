            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Reeba, niinyenda kwombekyera eiziina rya MUKAMA Ruhanga wangye enju, n'okugimushoroorera, ngu mbone kugyotereramu obubaane oburikutaamirana omu maisho ge n'okuguma nimpongyeramu emigaati y'okumurikwa, n'okutambiramu ebitambo by'okwotsya obutoosha omu kasheeshe n'omu mwabazyo, ahari sabato, aha kuboneka kw'okwezi, n'aha magyenyi ga MUKAMA Ruhanga waitu agatairweho, nk'oku byaragiirwe Abaisraeli kuguma nibabikora ebiro byona. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.2.4",
            "verseOrgIds": [
              "2CH.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.16.25"
              },
              "items": [
                {
                  "text": "1 Bus 16:25",
