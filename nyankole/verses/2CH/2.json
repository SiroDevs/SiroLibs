          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.5.2+1KI.5.3+1KI.5.4+1KI.5.5+1KI.5.6+1KI.5.7+1KI.5.8+1KI.5.9+1KI.5.10+1KI.5.11"
              },
              "items": [
                {
                  "text": "1 Bag 5:2-11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi Sulemaani yaatuma ahari Hiraamu omugabe wa Tuuro, ati: Nk'oku waabaire ogirira tata Daudi, okamutwekyera emyereezi y'okweyombekyera enju y'okutaahamu, naanye obe nikwo wangirira.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.2.3",
            "verseOrgIds": [
              "2CH.2.3"
            ]
          }
        },
