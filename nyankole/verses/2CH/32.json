              "items": [
                {
                  "text": "Bir 8:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka omu bigambo by'entumwa z'abategyeki ba Babulooni, ezi baamutumireho kumubuuza eby'akamanyiso akaakozirwe omu nsi ye, Ruhanga akabimurekyera kumugyeza, ngu amanye ebiri omu mutima gwe byona.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.32.31",
            "verseOrgIds": [
              "2CH.32.31"
            ]
          }
        }
