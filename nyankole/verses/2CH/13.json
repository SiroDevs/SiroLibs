            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.2.4"
              },
              "items": [
                {
                  "text": "2 Bus 2:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Buri kasheeshe na buri mwabazyo bahongyera MUKAMA ebitambo by'okwotsya, bamwoterera obubaane bw'emigaju erikutaamirana, batebeekanisa emigaati ey'okumurikwa aha meeza y'ezaabu eshemeziibwe, kandi bareeberera ekikondo ky'amatabaaza ky'ezaabu, ngu amatabaaza gaakyo gabone kwaka buri mwabazyo; ahakuba itwe tukuratira ebi MUKAMA Ruhanga waitu yaaturagiire, kwonka imwe mumutsigireho. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.11",
            "verseOrgIds": [
              "2CH.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.10.9"
              },
              "items": [
                {
                  "text": "Kub 10:9",
