          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obwo Yeroboamu akaba ayohereize ab'okubagwera, ngu babateere nibabareetwa enyima; n'ahabw'ekyo engabo ze zikaba ziri omu maisho g'Abayuda, n'ab'okubagwera babari enyima. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.13",
            "verseOrgIds": [
              "2CH.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.14.11"
              },
              "items": [
                {
                  "text": "2 Bus 14:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abayuda ku baanagire amaisho, baashanga orugamba rubaturukire omumaisho n'enyima; baatakira MUKAMA, abanyamurwa baateera enzamba, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.14",
            "verseOrgIds": [
              "2CH.13.14"
            ]
          }
        },
