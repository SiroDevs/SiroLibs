                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Timushemereire kumanya ku MUKAMA Ruhanga wa Israeli yaahaire Daudi n'abatabani obugabe kutegyeka Israeli, naabaraganisa endagaano y'omwonyo? ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.5",
            "verseOrgIds": [
              "2CH.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.11.26"
              },
              "items": [
                {
                  "text": "1 Bag 11:26",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.12.19"
              },
              "items": [
                {
                  "text": "12:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.12.20"
              },
              "items": [
                {
                  "text": "20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " N'obu kiraabe kyabaire kityo, Yeroboamu mwene Nebati, omugaragwa wa Sulemaani mwene Daudi, akaimuka yaagomera mukama we; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.6",
            "verseOrgIds": [
              "2CH.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "abashaija bamwe abataine mugasho baija, baakwatanisa nawe, baahiga Rehoboamu mwene Sulemaani akiri muto, atakahamire, atarikubaasa kubazibira.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.7",
            "verseOrgIds": [
              "2CH.13.7"
            ]
          }
        }
      ]
    },
