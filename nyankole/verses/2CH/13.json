            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omu mwaka gwa ikumi na munaana ogw'omu busingye bw'omugabe Yeroboamu, Abiya akatandika kutegyeka Yuda. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.1",
            "verseOrgIds": [
              "2CH.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.15.7"
              },
              "items": [
                {
                  "text": "1 Bag 15:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yaategyekyera emyaka eshatu omuri Yerusaalemu. Nyina akaba naayetwa Mikaya, muhara wa Urieli owa Gibea.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.2",
            "verseOrgIds": [
              "2CH.13.2"
            ]
          }
        }
      ]
    },
    {
