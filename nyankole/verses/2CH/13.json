              },
              "items": [
                {
                  "text": "1 Bag 12:28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mbwenu nimuteekateeka ngu nimwija kuzibira obugabe bwa MUKAMA oburi omu mikono ya beene Daudi, ngu niho muri omutwe muhango munonga, kandi ngu niho mwine enyana z'ezaabu ezi Yeroboamu yaabaheesheire kuba baaruhanga baanyu? ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.8",
            "verseOrgIds": [
              "2CH.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.11.14"
              },
              "items": [
                {
                  "text": "2 Bus 11:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.11.15"
              },
              "items": [
                {
                  "text": "15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.5.7"
              },
              "items": [
                {
                  "text": "Yer 5:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Timurabingire abanyamurwa ba MUKAMA beene Arooni, n'Abaleevi, mukeeteeraho abandi nk'abantu b'agandi mahanga? Omuntu weena orikwija kweyeza, areetsire enimi y'ekimasha nari empaya z'entaama mushanju, ahinduka omunyamurwa w'abatari baaruhanga. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.9",
            "verseOrgIds": [
              "2CH.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonka itwe, MUKAMA niwe Ruhanga waitu, kandi titukamutsigahoga. Abanyamurwa abu twine, arikuheereza MUKAMA, ni batabani ba Arooni, kandi twine Abaleevi b'okubaheereza. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.10",
            "verseOrgIds": [
              "2CH.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
