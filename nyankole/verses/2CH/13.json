        },
        {
          "text": " Omu busingye wa Abiya Yeroboamu taragizire bu agaruka kugira amaani; bwanyima MUKAMA yaamurwaza, yaafa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.20",
