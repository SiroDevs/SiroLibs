          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abiya n'abantu be baabaitamu abantu baingi munonga; batyo Abaisraeli baafamu abashaija entoore obusiriira butaano. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.17",
