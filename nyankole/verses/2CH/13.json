                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.5.39"
              },
              "items": [
                {
                  "text": "Byak 5:39",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Reeba, Ruhanga ari hamwe naitwe, naatwebembera, kandi n'abanyamurwa be bari aha, baine enzamba z'okuhuruza ab'okubarwanisa. Imwe beene Israeli 'mwe, murekye kurwanisa MUKAMA Ruhanga wa baashwenkuriimwe; ahabw'okuba timurikubaasa kusingura.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.12",
            "verseOrgIds": [
              "2CH.13.12"
            ]
          }
        }
      ]
    },
