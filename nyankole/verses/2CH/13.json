            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abaisraeli baahunga Abayuda, Ruhanga yaabahayo omu mikono yaabo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.16",
            "verseOrgIds": [
              "2CH.13.16"
            ]
          }
