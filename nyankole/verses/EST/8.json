              "items": [
                {
                  "text": "18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omuri ezo baruha omugabe yaikiriza Abayudaaya b'omu ndembo zoona, ngu bateeranire hamwe, beerwaneho bahamire, babone kwita n'okucwekyereza n'okumaraho engabo zoona z'eihanga ryona nari ez'eishaza ryona, eziribateera, baite n'abaana baabo abato n'abakazi baabo, kandi banyagye ebintu byabo; ",
          "type": "text",
          "attrs": {
            "verseId": "EST.8.11",
            "verseOrgIds": [
              "EST.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EST 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi ngu ebyo byona bikorerwe aha izooba rimwe, aha kiro kya ikumi na bishatu omu kwezi kwa ikumi n'abiri okurikwetwa Adari, omu mashaza goona ag'omugabe Ahasuero; ",
          "type": "text",
          "attrs": {
            "verseId": "EST.8.12",
            "verseOrgIds": [
              "EST.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
