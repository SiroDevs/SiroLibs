            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EST.3.12"
              },
              "items": [
                {
                  "text": "3:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Batyo omu bunaku obwo, aha kiro kya makumi abiri na bishatu omu kwezi kwa kashatu okurikwetwa Sivani, abahandiiki b'omugabe baayetwa, baahandiika ebi Morodekai aragiire aha by'Abayudaaya byona, baabitwekyera abategyeki b'omugabe, n'abandi bategyeki, n'abanyiginya b'omu mashaza goona, oku gari igana na makumi abiri na mushanju, okuruga Buhindi okuhika Esiopia, buri ishaza ryona nk'emihandiikire yaaryo oku yaabaire eri, na buri ihanga omu rurimi rwaryo; baabihandiikira n'Abayudaaya omu mihandiikire yaabo n'omu rurimi rwabo. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.8.9",
            "verseOrgIds": [
              "EST.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EST 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EST.3.12"
              },
              "items": [
                {
                  "text": "Est 3:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EST.3.13"
              },
              "items": [
                {
                  "text": "13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ebyo byona Morodekai yaabihandiika omu iziina ry'omugabe, yaabihamisa akamanyiso k'empeta y'omugabe, ebaruha yaazikwatsa baamatarisi, abaabaire bagyendera aha mbaraasi ezirikwiruka munonga, ezaabaire zizaaziibwe omu masho g'omugabe, nizikora emirimo ye. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.8.10",
            "verseOrgIds": [
              "EST.8.10"
            ]
          }
        },
        {
