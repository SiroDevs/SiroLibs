              },
              "items": [
                {
                  "text": "Est 9:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima Esteeri yaagaruka yaagamba n'omugabe; yaamukwata amaguru, yaamweshengyereza naarira, ngu amareho enaama mbi ya Hamani Omuagagi, n'obwengye obu yaabaire acwire kucwekyereza Abayudaaya. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.8.3",
            "verseOrgIds": [
              "EST.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EST 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EST.4.11"
              },
              "items": [
                {
                  "text": "Est 4:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EST.5.2"
              },
              "items": [
                {
                  "text": "5:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omugabe yaimukiza Esteeri enkoni ye y'ezaabu, ",
          "type": "text",
          "attrs": {
            "verseId": "EST.8.4",
            "verseOrgIds": [
              "EST.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EST 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EST.3.13"
              },
              "items": [
                {
                  "text": "Est 3:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Esteeri yaimuka, yaayemerera omu maisho ge, yaagira ati: Omugabe ku araabe naakisiima akanshemerererwa, n'ebi ndaagambe bikamugwisa gye, kandi nkaba orikumushemeza, nimmweshengyereza, ku bahandiika ebaruha y'okuhindura busha ezi Hamani mwene Hamedasa Omuagagi yaahandiikire kucwekyereza Abayudaaya abari omu mashaza g'omugabe goona. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.8.5",
            "verseOrgIds": [
              "EST.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EST 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbwenu nimbaasa nta kugumisiririza akabai akarihika aha ihanga ryaitu? Nari shi nimbaasa nta kugumisiririza aokureeba beene waitu nibacwekyerezibwa? ",
          "type": "text",
          "attrs": {
            "verseId": "EST.8.6",
            "verseOrgIds": [
              "EST.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EST 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omugabe Ahasuero yaagarukamu omwigarire Esteeri na Morodekai Omuyudaaya ati: Reeba, mpaire Esteeri enju ya Hamani, kandi Hamani bamuhanikire aha kti nimmutura okubangira Abayudaaya omukono. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.8.7",
            "verseOrgIds": [
              "EST.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EST 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EST.1.19"
              },
              "items": [
                {
                  "text": "Est 1:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EST.3.12"
              },
              "items": [
                {
                  "text": "3:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " N'ahabw'ekyo naimwe muhandiikire Abayudaaya, nk'oku murikwenda, omu iziina ry'omugabe, muteho akamanyiso k'empeta ye; ahabw'okuba ekiragiro ekihandiikirwe omu iziina ry'omguabe, kikaamibwa akamanyiso k'empeta ye, tihariho muntu orikubaasa kukiihaho. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.8.8",
            "verseOrgIds": [
              "EST.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EST 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EST.1.1"
              },
              "items": [
                {
                  "text": "Est 1:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EST.1.22"
              },
              "items": [
                {
                  "text": "22",
                  "type": "text"
                }
              ]
