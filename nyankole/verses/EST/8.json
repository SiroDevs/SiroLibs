              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batyo baamatarisi baatemba embaraasi ezirikwiruka munonga, ezaabaire zikora emirimo y'omugabe, baashohora nibeehuuta, nibagyemwa ekiragiro ky'omugabe. Kandi ekyo kiragiro kyabugibwa omu rurembo Shushani. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.8.14",
            "verseOrgIds": [
              "EST.8.14"
            ]
          }
        },
