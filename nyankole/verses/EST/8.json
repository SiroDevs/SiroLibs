                {
                  "text": "4:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kandi ngu ebihandiikirwe omuri ezo baruha bibugibwe nk'ekiragiro omuri buri ishaza, kandi birangwe omu mahanga goona, nibimanyisa Abayudaaya ku bashemereire kweteekateeka kwerwanaho ahari eryo izooba, nibahoora abazigu baabo.",
          "type": "text",
          "attrs": {
            "verseId": "EST.8.13",
            "verseOrgIds": [
              "EST.8.13"
            ]
          }
        }
