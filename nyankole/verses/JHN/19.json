                "loc": "PSA.22.15"
              },
              "items": [
                {
                  "text": "Zab 22:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima Yesu, ku yaamanyire ngu byona byahwa, yaagira ati: Naagira eiriho! Ngu abone kuhikiiriza Ebyahandiikirwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.28",
            "verseOrgIds": [
              "JHN.19.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JHN 19:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.69.21"
              },
              "items": [
                {
                  "text": "Zab 69:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi hakaba haateekirweho enjoga eijwire viinyo erikushaarira; baagijabikamu ekyangu, baakita aha kibingo, baakimukwatira aha munwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.29",
            "verseOrgIds": [
              "JHN.19.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JHN 19:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu ku yaaherize kukiheebwa, yaagira ati: Kyahwa! Yainika omutwe gwe, yaahayo amagara ge.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.30",
            "verseOrgIds": [
              "JHN.19.30"
            ]
          }
        }
      ]
    },
    {
