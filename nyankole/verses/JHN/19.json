                  "text": "Luk 23:50-55",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima y'ebyo Yosefu owa Arimasaaya, owaabaire ari omwegi wa Yesu, kwonka omu mubonano ahabw'okutiina Abayudaaya, yaashaba Pilaato kumwikiriza kutwara omutumbi gwa Yesu; Pilaato yaamwikiriza. Atyo yaija, yaatwara omutumbi gwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.38",
            "verseOrgIds": [
              "JHN.19.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JHN 19:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.3.2"
              },
              "items": [
                {
                  "text": "Yoh 3:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Na Nikodemu, owaabandize kwija ahari Yesu nyekiro, nawe yaija, areetsire eby'omugaju ebirimu sumuruna n'enkaka, oburemeezi bwabyo nk'eraatiri igana. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.39",
            "verseOrgIds": [
              "JHN.19.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JHN 19:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baatwara omutumbi gwa Yesu, baaguzinga omu myenda ya kitaani ei baatairemu eby'emigaju, nk'emicwe y'Abayudaaya ey'okuziika oku yaabaire eri. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.40",
            "verseOrgIds": [
              "JHN.19.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JHN 19:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi omu mwanya ogu yaabaire abambirwemu hakaba harimu omusiri; n'omu musiri omwo hakaba harimu ekituuro kisya ekitakazikwamuga muntu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.41",
            "verseOrgIds": [
              "JHN.19.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JHN 19:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omwo nimwo baaziikire Yesu, ahabw'okuba rikaba riri eizooba ry'Okweteguura kw'Abayudaaya, kandi ekituuro ekyo kikaba kiri haihi.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.42",
            "verseOrgIds": [
              "JHN.19.42"
            ]
          }
        }
