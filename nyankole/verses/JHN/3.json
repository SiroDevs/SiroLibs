          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orugire omu iguru naakira boona; ow'ensi aba ari ow'ensi, kandi agamba eby'ensi. Orugire omu iguru naakira boona; ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.3.31",
            "verseOrgIds": [
              "JHN.3.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JHN 3:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "eki yaareebire n'eki yaahuriire, nibyo ahamya; kwonka tihariho muntu oikiriza ebi ahamya. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.3.32",
            "verseOrgIds": [
              "JHN.3.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JHN 3:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oikiriza eby'okuhamya kwe, aba ahamize eki, ngu Ruhanga n'Ow'amazima. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.3.33",
            "verseOrgIds": [
              "JHN.3.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JHN 3:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.1.33"
              },
              "items": [
                {
                  "text": "Yoh 1:33",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ou Ruhanga yaatumire agamba ebigambo bya Ruhanga; ahakuba Ruhanga ku aza kuha Omwoyo, tamurenga. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.3.34",
            "verseOrgIds": [
              "JHN.3.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JHN 3:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.5.20"
              },
              "items": [
                {
                  "text": "Yoh 5:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ishe akunda Omwana, kandi amurekuriire byona. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.3.35",
            "verseOrgIds": [
              "JHN.3.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JHN 3:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.5.12"
              },
              "items": [
                {
                  "text": "1 Yoh 5:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Orikwikiriza Omwana aine amagara agatahwaho; kwonka otarikworobera Mwana, taribona magara; kureka ekiniga kya Ruhanga kiguma ahariwe.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.3.36",
