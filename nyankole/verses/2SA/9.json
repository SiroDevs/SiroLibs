        },
        {
          "text": " Bwanyima Daudi yaabuuza ati: Ebyo haine owaatsigaireho omu nju ya Saulo, nkamukorera eby'embabazi ahabwa Yonasaani? ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.1",
            "verseOrgIds": [
              "2SA.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 9:2"
          },
          "items": [
