            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'ahabw'ekyo Abaisraeli boona baarereera kukuratira Daudi, baakuratira Sheeba mwene Bikuri; kwonka Abayuda, okuruga Yorudani okuhika Yerusaalemu baahamira aha mugabe waabo.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.2",
            "verseOrgIds": [
              "2SA.20.2"
            ]
          }
        }
      ]
    },
    {
