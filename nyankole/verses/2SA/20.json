                "loc": "2SA.16.22"
              },
              "items": [
                {
                  "text": "22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima omugabe Daudi yaataha omu nju ye omuri Yerusaalemu; yaatwara abakazi be b'ebinyanshunju, abu yaabaire atsigiire eka ye kugirinda, yaataba omu nju y'okurindirwamu, yaaguma naabaha eby'okubatunga, kwonka tiyaagaruka kubaraarira. Batyo baaguma nibarindwa okuhitsya obu baafiire, bari nk'abafaakazi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.3",
            "verseOrgIds": [
              "2SA.20.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
