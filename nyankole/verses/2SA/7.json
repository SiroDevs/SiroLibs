            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nikyo obeera mukuru, MUKAMA Ruhanga; ahakuba tihariho orikushushana naiwe, kandi tihariho Ruhanga ondiijo kureka Iwe, nk'ebi twahuriire byona oku biri. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.22",
            "verseOrgIds": [
              "2SA.7.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2SA 7:23"
          },
          "items": [
