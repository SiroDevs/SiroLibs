            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ndyaba ishe, nawe abe omwana wangye; ku aricumura, ndyamuhanisa enkoni z'abantu, babe nibo baamuteera; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.14",
