              "items": [
                {
                  "text": "Amo 9:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ndyatooranira abantu bangye Israeli omwanya, mbabyaremu, babone kugira obutaka bw'okutuuramu, obu batariihwamu bundi. Kandi abantu babi tibarigaruka kubaita kubi nk'obunyakare, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.10",
            "verseOrgIds": [
              "2SA.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 7:11"
