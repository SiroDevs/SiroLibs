              },
              "items": [
                {
                  "text": "Bar 2:11-16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.11.38"
              },
              "items": [
                {
                  "text": "1 Bag 11:38",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " obu naabaire ndagiira abaramuzi kutegyeka abantu bangye Israeli; kandi ndyakuha okuhuumura abazigu baawe boona. N'ekindi, MUKAMA naakugambira ku arikuhindura oruganda.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.11",
            "verseOrgIds": [
              "2SA.7.11"
            ]
          }
