            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Eki ndikugamba n'eki, ngu, Orikubiba nkye, aryagyesha bikye; kandi orikubiba nyingi, aryagyesha bingi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.9.6",
