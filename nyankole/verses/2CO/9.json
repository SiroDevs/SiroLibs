          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aha by'okuhwera abarikwera tindikureeba ki ndikubahandiikirira; ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.9.1",
            "verseOrgIds": [
              "2CO.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CO 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ahakuba nimmanya okukunda kwanyu, oku ndikweraata ahabwanyu omu Bamakedonia, ningira nti: Abaakaya bamazire omwaka beeteekateekire; kandi obweziriki bwanyu bwezirikiise baingi munonga aharibo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.9.2",
            "verseOrgIds": [
              "2CO.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CO 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonka nintuma ab'eishe-emwe abo ngu okwehimbisa kwaitu ahabwanyu omu kigambo ekyo kutaba kwa busha, kureka babashangye mweteekateekire, nk'oku naagambire; ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.9.3",
            "verseOrgIds": [
              "2CO.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CO 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "ahakuba tindikwenda itwe, (tutagizire imwe) kukwatwa nshoni z'ebyo ebi tubainemu matsiko, Abamakedonia bamwe batakaija naanye, bakashanga muteeteekateekire. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.9.4",
            "verseOrgIds": [
              "2CO.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CO 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikyo naateekateekyeire ngu kishemereire kweshengyereza ab'eishe-emwe abo kumbandiza okwo, ngu bateekateekye kare ekiconco kyanyu eki mwaraganiise, ira, ngu kishangwe kyatebeekanisiibwe, kiri eky'embabazi, kitari ky'okugyemwa.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.9.5",
            "verseOrgIds": [
              "2CO.9.5"
            ]
          }
        }
      ]
    },
    {
