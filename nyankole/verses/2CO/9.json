              "items": [
                {
                  "text": "1 Bus 29:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omuntu weena akore, nk'oku amaririire omu mutima gwe, atarikunyoomwa nari akugyemwa; ahakuba Ruhanga akunda efura. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.9.7",
            "verseOrgIds": [
              "2CO.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CO 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ruhanga naabaasa kubakanyisiza emigisha yoona, ngu imwe, ku muraatungye obutoosha ebirikubamara, mubone kugira bingi eby'okuhwera omurimo gwona omurungi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.9.8",
            "verseOrgIds": [
              "2CO.9.8"
            ]
          }
        },
