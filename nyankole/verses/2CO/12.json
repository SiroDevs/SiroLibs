    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CO 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kinshemereire kwehimbisa, n'obu kuraabe kutaine mugasho; kwonka niinyija kugamba eby'okworekwa n'ebi Mukama yanshuururiire. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.12.1",
            "verseOrgIds": [
              "2CO.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CO 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimmanya omuntu ow'omuri Kristo, owaakwatsire akatwarwa omu iguru rya kashatu, emyaka ikumi n'ena ehingwire; (yaaba yaabaire ari omu mubiri, nari atari mu mubiri, tindikukimanya; nikimanywa Ruhanga.) ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.12.2",
            "verseOrgIds": [
              "2CO.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CO 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi nimmanya ngu omuntu ogwo akakwatwa yaatwarwa omuri ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.12.3",
            "verseOrgIds": [
              "2CO.12.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "12:3",
              "type": "text"
            },
            {
              "text": "Paradiso: reeba Luk 23:43.",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paradiso, (yaaba yaabaire ari omu mubiri nari atari mu mubiri, tindikumanya; nikimanywa Ruhanga) ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.12.3",
            "verseOrgIds": [
              "2CO.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CO 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.23.43"
              },
              "items": [
                {
                  "text": "Luk 23:43",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.2.7"
              },
              "items": [
                {
                  "text": "Kush 2:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " yaahurira ebigambo ebitagambwa, ebi omuntu atashemereire kushohoza. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.12.4",
            "verseOrgIds": [
              "2CO.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CO 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka nyehimbise ahabw'omuntu ogwo; kwonka ahabwangye tindikwija kwehimbisa, kureka ahabw'obweremwa bwangye. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.12.5",
            "verseOrgIds": [
              "2CO.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CO 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku naakwenda kwehimbisa, tinkaaba mushema, ahakuba nkaaba ningamba amazima. Kwonka tinkikora, ngu hatagira omuntu owanteekateekaho okukira ebi arikundeebamu n'ebi arikumpuriraho. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.12.6",
            "verseOrgIds": [
              "2CO.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CO 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.2.6"
              },
              "items": [
                {
                  "text": "Yob 2:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi ngu ndekye kwehimbisa ahabw'okushuuruurirwa kwingi, okukira oku nshemereire, nkacumitwa eihwa omu mubiri, entumwa ya Sitaane ey'okunteera entomi, ngu ndekye kwehimbisa okukira oku nshemereire. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.12.7",
            "verseOrgIds": [
              "2CO.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CO 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.26.44"
              },
              "items": [
                {
                  "text": "Mat 26:44",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.3.26"
              },
              "items": [
                {
                  "text": "Bir 3:26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nkeeshengyereza Mukama kashatu ahabw'ekintu ekyo, ngu kindugyeho. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.12.8",
            "verseOrgIds": [
              "2CO.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CO 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yangarukamu ati: Embabazi zangye nizikumara, ahabw'okuba amaani gangye gahikiiririzibwa omu bweremwa. N'ahabw'ekyo niinyija kwehimbisa n'okuhsmererwa kwingi ahabw'obweremwa bwangye, ngu amaani ga Kristo gabone kungumaho. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.12.9",
            "verseOrgIds": [
              "2CO.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CO 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.4.13"
              },
              "items": [
                {
                  "text": "Fil 4:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mbwenu ahabwa Kristo ninshemererwa ahabw'obweremwa, omu kujumwa, n'omu bworo, omu kuhiigwa, n'omu busaasi; ahakuba ku mba omweremwa, nibwo ngira amaani.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.12.10",
            "verseOrgIds": [
              "2CO.12.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CO 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.12.10",
            "verseOrgIds": [
              "2CO.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CO 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbaire omushema, kwonka niimwe mwakingyemire; ahabw'okuba niimwe mwabaire mushemereire kumpimbisa. Mumanye ngu, n'obu ndaabe ntari kintu, ezo ntumwa nkuru munonga tiziine ki zankirize na kakye. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.12.11",
            "verseOrgIds": [
              "2CO.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CO 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buzimazima ebirikuhamya entumwa nkabikorera omuriimwe omu kugumisiriza kwingi, ninkora obumanyiso n'eby'okutangaaza n'eby'amaani. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.12.12",
            "verseOrgIds": [
              "2CO.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CO 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amakanisa agandi gakabakiza ki? kureka nyowe okutabarusya. Munsaasire ekishobyo ekyo!",
          "type": "text",
          "attrs": {
            "verseId": "2CO.12.13",
            "verseOrgIds": [
              "2CO.12.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CO 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.12.13",
            "verseOrgIds": [
              "2CO.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CO 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbwenu nyeteekateekire kwija owaanyu omurundi gwa kashatu; kwonka tindibarusya, ahakuba tindikwenda byanyu, kureka niimwe ndikwenda; nimumanya ngu abaana tibo bashemereire kubiikira abazire baabo, kureka abazaire nibo babiikira abaana. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.12.14",
            "verseOrgIds": [
              "2CO.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CO 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahabwangye ndyashemererwa munonga kuhayo ebyangye, kandi n'okwehayo nyeheyo ahabw'amagara gaanyu. Obu mbakunzire munonga, nibwo nkunzirwe kakye. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.12.15",
            "verseOrgIds": [
              "2CO.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CO 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imwe nimugira ngu okubarusya tindabaruhize; ngu kwonka nkabaitsa obwengye, naabagobeza. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.12.16",
            "verseOrgIds": [
              "2CO.12.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CO 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Beitu shi, omuri abo abu naabatumireho hariho oine eki yaabaanyihiireho? ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.12.17",
            "verseOrgIds": [
              "2CO.12.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CO 12:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.8.6"
              },
              "items": [
                {
                  "text": "2 Kor 8:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.8.16+2CO.8.17+2CO.8.18"
              },
              "items": [
                {
                  "text": "16-18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nkeeshengyereza Tito kwija owaanyu, naamutuma n'ow'eishe-emwe ogwo. Mbwenu Tito aine eki yaabaihireho? Tituratoire ekirari kimwe? ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.12.18",
            "verseOrgIds": [
              "2CO.12.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CO 12:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okuruga ira n'okuhitsya hati muteekateeka ngu nitwerwanaho ahariimwe? Mumanye ngu ebi tugamba tubigambira omuri Kristo omu maisho ga Ruhanga, kandi byona, abarikukundwa munonga, tubigamba ahabw'okubombeka. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.12.19",
            "verseOrgIds": [
              "2CO.12.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CO 12:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.4.6"
              },
              "items": [
                {
                  "text": "1 Kor 4:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka eki ndikutiina shana nikwo kwija, nkashanga mutari nk'oku ndikwenda, kandi naimwe mukandeeba ndi oku mutarikwenda; kandi shana mwine entongane, eihari, ekiniga, empaka, okugambuurana, okuhwihwitsa, okwekuza, n'omurabanamu; ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.12.20",
            "verseOrgIds": [
              "2CO.12.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CO 12:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi ngu, ku ndiija, Ruhanga wangye aryancureeza omu maisho gaanyu, naanye nsaasibwe baingi abaasiisire kare, bateeteise bihagaro n'obushambani n'okurigirana okubi, ebi baakozire.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.12.21",
            "verseOrgIds": [
              "2CO.12.21"
            ]
          }
        }
      ]
    }
  ],
