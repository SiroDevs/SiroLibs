              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " N'ahabw'ekyo, ku twaremirwe kugumisiriza, twasiima kutsigara twenka omuri Aseene, ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.1",
            "verseOrgIds": [
              "1TH.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1TH 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "twatuma ow'eishe-emwe Timoseo, omuheereza wa Ruhanga omu ngiri ya Kristo, kubagumya n'okubeezirikisa omu kwikiriza kwanyu, ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.2",
            "verseOrgIds": [
              "1TH.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1TH 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TH.1.4"
              },
              "items": [
                {
                  "text": "2 Tes 1:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ngu hatagira owaashoberwa ahabw'okubonabonesibwa okwo. Naimwe ahabwanyu nimumanya ku nikyo twateereirweho. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.3",
            "verseOrgIds": [
              "1TH.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1TH 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.14.22"
              },
              "items": [
                {
                  "text": "Byak 14:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ahakuba tukabamanyisa kare tukiri owaanyu, ku turi ab'okubonabonesibwa; kandi nikwo kyabaire, nk'oku murikumanya. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.4",
            "verseOrgIds": [
              "1TH.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1TH 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'ahabw'ekyo, ku naaremirwe kugumisiriza, naabatumaho kumanya okwikiriza kwanyu oku kuri, twine obwoba, ngu shana obundi omutegi akaaba yaabategire, naitwe okukora kwaitu kufa busha.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.5",
            "verseOrgIds": [
              "1TH.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
