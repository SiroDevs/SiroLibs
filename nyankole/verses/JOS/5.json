                "loc": "EXO.15.14"
              },
              "items": [
                {
                  "text": "Kur 15:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.10.5"
              },
              "items": [
                {
                  "text": "1 Bag 10:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abagabe b'Abaamori boona, abaabaire bari seeri ya Yorudani orubaju rw'oburengyerwa-izooba, n'abagabe b'Abanyakanaani boona, abaabaire batwire aha rubaju rw'enyanja, ku baahuriire ngu MUKAMA ayomize amaizi ga Yorudani omu maisho g'Abaisraeli, okuhitsya obu bambukire, emitima yaabahwa omunda, kandi tibaatsigarwamu mwoyo gwona ahabw'eihanga ry'Abaisraeli.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.1",
            "verseOrgIds": [
              "JOS.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.1",
            "verseOrgIds": [
              "JOS.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu bunaku obwo MUKAMA akagambira Yoshua ati: Mwebaijere emisyo omu mabaare, oshare Abaisraeli obwa kabiri. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.2",
            "verseOrgIds": [
              "JOS.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoshua yaabaija emisyo omu mabaare, yaasharira Abaisraeli aha mugongo Aralooti. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.3",
            "verseOrgIds": [
              "JOS.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.14.29"
              },
              "items": [
                {
                  "text": "Kub 14:29",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.26.64"
              },
              "items": [
                {
                  "text": "26:64",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi ekyareeteire Yoshua okubashara n'eki; abashaija boona abaarugire Misri bakaba baherize kugwa omu muhanda ogurikuraba omu ihamba, barimu abarwani boona abaarugire Misri. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.4",
            "verseOrgIds": [
              "JOS.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu boona abaarugire Misri bakaba bashazirwe; kwonka boona abu baazaariire omu ihamba bakiri omu muhanda baarugire Misri, bo bakaba batakashazirwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.5",
            "verseOrgIds": [
              "JOS.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.95.10"
              },
              "items": [
                {
                  "text": "Zab 95:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.3.11"
              },
              "items": [
                {
                  "text": "Heb 3:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ahakuba Abaisraeli bakamara emyaka makumi ana nibazengyerera omu ihamba, okuhitsya obu abashaija abarwani b'eihanga ryabo ryona baafiire bakahwaho ahabw'okutahurira iraka rya MUKAMA; kandi MUKAMA akaba yaabarahiire ku ataribaikiriza kureeba ensi ei yaaraganiise baishenkurubo kutuha, ensi ey'amate n'obwoki. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.6",
            "verseOrgIds": [
              "JOS.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'ahabw'ekyo abaana baabo abu MUKAMA yaagarwire omu mwanya gwabo, nibo Yoshua yaashazire; bakaba batashazirwe, ahabw'okuba tibarashazirwe bakiri omu muhanda. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.7",
            "verseOrgIds": [
              "JOS.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.34.25"
              },
              "items": [
                {
                  "text": "Kut 34:25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abashaija boona, ku baaherize kusharwa, baaguma omu myanya yaabo omu rusiisira, okuhitsya obu baakizire. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.8",
            "verseOrgIds": [
              "JOS.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.18.3"
              },
              "items": [
                {
                  "text": "Lev 18:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima MUKAMA yaagambira Yoshua ati: Eri izooba naabaihaho ekijumo eky'Abanyamisri. N'ahabw'ekyo omwanya ogwo gukeetwa Gilugaali n'okuhitsya hati.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.9",
            "verseOrgIds": [
              "JOS.5.9"
            ]
          }
        }
      ]
    },
    {
