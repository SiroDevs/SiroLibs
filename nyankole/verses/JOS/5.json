          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.12.6"
              },
              "items": [
                {
                  "text": "Kur 12:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.9.5"
              },
              "items": [
                {
                  "text": "Kub 9:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abaisraeli ku baabaire bakiri Gilugaali, baagira obugyenyi bw'okwijuka Okuhingurwaho aha kiro ky'okwezi ekya ikumi na bina omu mwabazyo omu mpita za Yeriko. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.10",
            "verseOrgIds": [
              "JOS.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu kasheeshe akaakuratiire Okuhingurwaho aha izooba eryo baarya aha by'okurya by'egyo nsi, emigaati etatumbisiibwe n'ebicoori bikarangire. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.11",
            "verseOrgIds": [
              "JOS.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku baaherize kurya eby'okurya by'egyo nsi, omu kasheeshe akandi emaanu tiyaaboneka; kandi Abaisraeli tibaagaruka kugitunga, kureka baaguma nibarya eby'okurya by'ensi ya Kanaani ogwo mwaka.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.12",
            "verseOrgIds": [
              "JOS.5.12"
            ]
          }
        }
      ]
    },
