                "loc": "NUM.35.6+NUM.35.7+NUM.35.8+NUM.35.9+NUM.35.10+NUM.35.11+NUM.35.12+NUM.35.13+NUM.35.14"
              },
              "items": [
                {
                  "text": "Kub 35:6-14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.4.41+DEU.4.42+DEU.4.43"
              },
              "items": [
                {
                  "text": "Bir 4:41-43",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Gambira Abaisraeli oti: Mwetooranire endembo z'okuhungiramu, ezi naaragiire Musa kubagambira, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.2",
            "verseOrgIds": [
              "JOS.20.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngu oriita omuntu weena atamwitsire nkana, nari atakimanyire ahungireyo; ziryaba obuhungiro bwanyu bw'okuhungiramu omuhoozi w'enzigu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.3",
            "verseOrgIds": [
              "JOS.20.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "RUT.4.1"
              },
              "items": [
                {
                  "text": "Rus 4:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "RUT.4.2"
              },
              "items": [
                {
                  "text": "2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omuntu ogwo aryahungira omuri rumwe aha ndembo ezo; ku arihikayo, ayemerere aha irembo ry'orwo rurembo, agambire abakuru baarwo eki akozire; nabo baryamutaasya omu rurembo, bamuhe omwanya, atuure nabo. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.4",
            "verseOrgIds": [
              "JOS.20.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuhoozi ku arimukuratayo, batarimumuha kumuhoora, ahabw'okuba taraitsire mutaahi we nkana, kandi akashangwa atarikwangana nawe. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.5",
            "verseOrgIds": [
              "JOS.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aryaguma omuri orwo rurembo, okuhitsya obu aryemerera omu maisho g'omutwe gw'abantu kucwerwa orubanja, kandi hoona tarirugamu, okuhitsya obu omunyamurwa omukuru, oriba ariho omu bunaku obwo, arifa; bwanyima ogwo mwitsi nibwo arigaruka owaabo omu ka ye, omu rurembo oru yaacwiremu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.6",
            "verseOrgIds": [
              "JOS.20.6"
            ]
          }
        }
      ]
    },
