                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.6.67+1CH.6.68+1CH.6.69+1CH.6.70+1CH.6.71+1CH.6.72+1CH.6.73+1CH.6.74+1CH.6.75+1CH.6.76"
              },
              "items": [
                {
                  "text": "1 Bus 6:67-76",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Okuruga aho baayetooranira Kedeshi omuri Galilaaya omu nsi y'ebibungo eya Nafutaali, na Shekemu omu nsi y'ebibungo eya Efuraimu, na Kiryasi-araba, niyo Heburooni omu nsi y'ebibungo eya Yuda. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.7",
            "verseOrgIds": [
              "JOS.20.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi seeri ya Yorudani aha rubaju rw'oburugwa-izooba bwa Yeriko, baatooranayo Bezeeri aha murambi gw'omu ihamba omu kyanga ky'oruganda rwa Reubeeni, na Ramosi omuri Gileadi omu kyanga ky'oruganda rwa Gaadi, na Golani omuri Bashani omu kyanga ky'oruganda rwa Manaase. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.8",
            "verseOrgIds": [
              "JOS.20.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.35.15"
              },
              "items": [
                {
                  "text": "Kub 35:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ezo nizo ndembo ezaatooraniirwe Abaisraeli boona n'abanyamahanga abaabaire babashuhuukiiremu, ngu omuntu weena oraite omuntu, atamwitsire nkana, ahungireyo, arekye kwitwa omuhoozi w'enzigu, okuhitsya obu aryemerera omu maisho g'omutwe gw'abantu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.9",
            "verseOrgIds": [
              "JOS.20.9"
            ]
          }
        }
      ]
