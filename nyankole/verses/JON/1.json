            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ekigambo kya MUKAMA kikaija ahari Yona mwene Amitai, nikigira kiti: ",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.1",
            "verseOrgIds": [
              "JON.1.1"
            ]
          }
        },
