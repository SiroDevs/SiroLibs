        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.4.17"
              },
              "items": [
                {
                  "text": "Efe 4:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " N'ahabw'ekyo, nk'oku mwayakiire Kristo Yesu Mukama, mube nikwo mwagyendera mutyo omuriwe, ",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.6",
            "verseOrgIds": [
              "COL.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "COL 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.3.17"
              },
              "items": [
                {
                  "text": "Efe 3:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.2.22"
              },
              "items": [
                {
                  "text": "2:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " mutsimbire emizi omuriwe, mwombekirwe omuriwe, kandi muhamiibwe omu kwikiriza, nk'oku mwayegyesiibwe, kandi muhingurane omu kusiima. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.7",
            "verseOrgIds": [
              "COL.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "COL 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwerinde, hatagira omuntu owaabanyagisa obwengye bw'abantu n'oburyarya obutaine mugasho, omu kukuratira emigyenzo y'abantu, n'okukuratira eby'okubanza eby'omu nsi egi, okutakuratira Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.8",
            "verseOrgIds": [
              "COL.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "COL 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.1.14"
              },
              "items": [
                {
                  "text": "Yoh 1:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.1.16"
              },
              "items": [
                {
                  "text": "16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ahakuba omuriwe harimu Obwaruhanga bwona obureeberwa omu mubiri gwe; ",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.9",
            "verseOrgIds": [
              "COL.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "COL 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi naimwe mwine amagara agahikire omuriwe, niwe Mutwe gw'obutegyeki bwona n'obushoboorozi bwona. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.10",
            "verseOrgIds": [
              "COL.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "COL 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.2.29"
              },
              "items": [
                {
                  "text": "Rom 2:29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi omuriwe mukasharwa okusharwa okutari kw'abantu, obu mwajuura omubiri gw'obuntu omu kusharwa kwa Kristo; ",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.11",
            "verseOrgIds": [
              "COL.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "COL 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.6.4"
              },
              "items": [
                {
                  "text": "Rom 6:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kandi mukaziikwa nawe omu kubatizibwa, oku mwazookyeiremu nawe ahabw'okwikiriza okukora kwa Ruhanga owaamuzoire omu bafu. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.12",
            "verseOrgIds": [
              "COL.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "COL 2:13"
          },
          "items": [
