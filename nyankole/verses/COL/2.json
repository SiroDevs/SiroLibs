                  "text": "Rom 14:1-12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " N'ahabw'ekyo hatarigira omuntu owaabacwera orubanja ahabw'eby'okurya nari eby'okunywa, nari eby'obugyenyi, nari eby'okuboneka kw'okwezi, nari sabato. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.16",
            "verseOrgIds": [
              "COL.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "COL 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.10.1"
              },
              "items": [
                {
                  "text": "Heb 10:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ebyo n'ekishushani ky'ebiriija, kwonka amazima gaabyo gari omuri Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.17",
            "verseOrgIds": [
              "COL.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "COL 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hatarigira owaanyaga ebihembo byanyu ahabw'okubendeza okwecwendeeka nk'okwe n'okuramya baamaraika, ayegamiire ebi ayorekirwe, naayehimbisiza aha bwengye bwe bw'obuntu obutaine mugasho; ",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.18",
            "verseOrgIds": [
              "COL.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
