            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.4.15"
              },
              "items": [
                {
                  "text": "Efe 4:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.4.16"
              },
              "items": [
                {
                  "text": "16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " haza atahamiire ha Mutwe, omu omubiri gwona guriisibwa, gukahamibwa hamwe emitsi y'engingo zaagwo, kandi gukakura omu kukura okurikuruga ahari Ruhanga.",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.19",
            "verseOrgIds": [
              "COL.2.19"
            ]
          }
        }
      ]
