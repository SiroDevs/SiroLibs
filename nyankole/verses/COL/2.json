              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.2.1"
              },
              "items": [
                {
                  "text": "Efe 2:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.2.5"
              },
              "items": [
                {
                  "text": "5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naimwe, abaabaire bafeereire omu by'okushiisha byanyu n'omu kutasharwa kw'emibiri yaanyu, Ruhanga kabahindura abahuriire hamwe nawe, ku yaaherize kutusaasira eby'okushiisha byaitu byona, ",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.13",
            "verseOrgIds": [
              "COL.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "COL 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.2.14"
              },
              "items": [
                {
                  "text": "Efe 2:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.2.15"
              },
              "items": [
                {
                  "text": "15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " yaaragaza ebihandiikirwe aha rupapura, ebyabaire nibitwomesereza nibiturega, yaarwihaho, yaarubamba aha musharaba; ",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.14",
            "verseOrgIds": [
              "COL.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "COL 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi ku yaaherize kujuura eby'obutegyeki n'obushoboorozi, yaabihemura butunu, yaabisinguza ogwo musharaba.",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.15",
            "verseOrgIds": [
              "COL.2.15"
            ]
          }
        }
      ]
    },
