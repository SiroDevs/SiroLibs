              "REV.3.17"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.4.8"
              },
              "items": [
                {
                  "text": "1 Kor 4:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Noogira oti: Ndi omutungi, ntungire bingi, tiinyine ki nkyenire; kunu torikumanya ku ori enshoberwa, ow'okusaasirwa, omworo, empumi kandi ojwaire busha. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.17",
            "verseOrgIds": [
              "REV.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "REV 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.1.7"
              },
              "items": [
                {
                  "text": "1 Pet 1:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " N'ahabw'ekyo ninkuhabura ku onguraho ezaabu eshemeziibwe omu muriro obone kuba omutungi, n'ebijwaro ebirikwera obone kujwara, orekye kukwatwa enshoni ahabw'okureebwa ojwaire busha, ogure n'omubazi gw'okuta omu maisho, obone kuhweza. ",
          "type": "text",
          "attrs": {
