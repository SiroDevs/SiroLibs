          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atyo owaabaire ashutami aha kicu yaanaga omuhoro gwe aha nsi, ensi yaashaaruurwa. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.16",
            "verseOrgIds": [
              "REV.14.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "REV 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maraika ondiijo yaaruga omuri hekalu ey'omu iguru, kandi nawe aine omuhoro gw'obwogi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.17",
            "verseOrgIds": [
              "REV.14.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "REV 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na maraika ondiijo, oine obushoboorozi aha muriro, yaaruga ha aitambiro, yaagamba n'eiraka rihango, naagira ogwo owaabaire aine omuhoro gw'obwogi ati: Kiika omuhoro gwawe gw'obwogi, ogucwise ebijuma by'omuzaabibu gw'ensi; ahakuba bihiisiize kimwe. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.18",
            "verseOrgIds": [
              "REV.14.18"
            ]
          }
        },
        {
          "name": "verse",
