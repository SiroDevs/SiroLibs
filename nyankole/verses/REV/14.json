          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.34.9"
              },
              "items": [
                {
                  "text": "Isa 34:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.34.10"
              },
              "items": [
                {
                  "text": "10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omwika gw'okubonabonesibwa kwabo gucumbuuka ebiro n'ebiro; abo abaramya enyamaishwa n'ekishushani kyayo, n'omuntu weena oteebwaho akamanyiso k'eiziina ryayo tibahuumura nyomushana na nyekiro. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.11",
            "verseOrgIds": [
              "REV.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
