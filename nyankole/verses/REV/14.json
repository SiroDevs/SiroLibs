              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Maraika ondiijo owa kashatu yaakurataho, naagamba n'eiraka rihango ati: omuntu weena, orikuramya enyamaishwa n'ekishushani kyayo, akateebwa akamanyiso kaayo aha buso bwe nari aha mukono gwe, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.9",
            "verseOrgIds": [
              "REV.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
