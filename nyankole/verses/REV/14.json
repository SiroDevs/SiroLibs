            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi naahurira eiraka eririkuruga omu iguru niringira riti: Handiika. Okwiha hati baine omugisha abafu abafeera omuri Mukama; eego, nikwo Omwoyo arikugira, ngu babone kuhuumurira kimwe emirabanamu yaabo; ahakuba ebi baakozire bigyenda nabo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.13",
            "verseOrgIds": [
              "REV.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 14:14"
