                {
                  "text": "Kush 12:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Aho niho okugumiriza kw'abarikwera kumanyirwa, aboorobera ebiragiro bya Ruhanga, bakaikiriza Yesu.",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.12",
            "verseOrgIds": [
              "REV.14.12"
            ]
