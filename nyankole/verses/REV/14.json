              "items": [
                {
                  "text": "Kush 18:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Haakurataho maraika owa kabiri, naagira ati: Orurembo orukuru Babulooni rugwire, rugwire, orwanyweisize amahanga goona amarwa g'ekiniga ky'obushambani bwarwo.",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.8",
            "verseOrgIds": [
              "REV.14.8"
            ]
