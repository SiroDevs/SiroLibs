                {
                  "text": "Ezk 38:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ogwo nawe aryanywa aha amarwa g'ekiniga kya Ruhanga, agaashukirwe omu kikopo ky'okubiihirwa kwe agatafungwire, kandi aryabonabonesibwa n'omuriro n'obuganga bw'ekibiriiti omu maisho ga baamaraika abarikwera n'omu maisho g'Omwana gw'entaama. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.10",
            "verseOrgIds": [
              "REV.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 14:11"
