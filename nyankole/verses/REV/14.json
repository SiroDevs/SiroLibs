                {
                  "text": "41",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima ku naimukize amaisho, naareeba ekicu kirikwera, kandi aha kicu ekyo hashutamiho orikushusha Omwana w'omuntu ajwaire ekirunga ky'ezaabu aha mutwe, kandi omu ngaro ze ainemu omuhoro gw'obwogi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.14",
            "verseOrgIds": [
              "REV.14.14"
            ]
          }
        },
        {
          "name": "verse",
