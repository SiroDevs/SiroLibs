                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.3.12"
              },
              "items": [
                {
                  "text": "3:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ku naimukize amaisho, naareeba Omwana gw'entaama ayemereire aha rushozi Saayuuni hamwe n'abantu akasiriira n'obukumi buna n'enkumi ina, aha buso bwabo hahandiikirweho eiziina rye n'eiziina rya Ishe. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.1",
            "verseOrgIds": [
              "REV.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naahurira eiraka eririkuhoorera nk'amaizi maingi kandi nk'eiraka ery'okuhinda kuhango niriruga omu iguru; kandi eiraka eryo eri naahuriire rikaba riri nk'ery'enanga ezirikuteerwa abateezi baazo; ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.2",
            "verseOrgIds": [
              "REV.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.98.1"
              },
              "items": [
                {
                  "text": "Zab 98:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.5.9"
              },
              "items": [
                {
                  "text": "Kush 5:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " nibeeshongorera ekyeshongoro kisya omu maisho g'ekitebe ky'obukama n'omu maisho g'ebihangirwe ebiine amagara ebina n'ag'abo bakuru. Kandi tihariho owaabaasize kwega ekyeshongoro ekyo, kureka abo akasiriira n'obukumi buna n'enkumi ina, abaacungwirwe okuruga omu nsi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.3",
            "verseOrgIds": [
              "REV.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.11.2"
              },
              "items": [
                {
                  "text": "2 Kor 11:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abo nibo abatareesiisire na bakazi, ahakuba bakaba nibabyerinda; kandi abo nibo bakuratira Omwana gw'entaama ei aza yoona. Abo bakacungurwa omu bantu okuba omuganuro ahari Ruhanga n'aha Mwana gw'entaama; ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.4",
            "verseOrgIds": [
              "REV.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEP.3.13"
              },
              "items": [
                {
                  "text": "Zef 3:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kandi omu kanwa kaabo hakaba hatabamu bishuba, ahakuba bakaba batagira kamogo.",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.5",
            "verseOrgIds": [
              "REV.14.5"
            ]
          }
        }
