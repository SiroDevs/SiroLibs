                {
                  "text": "Kush 8:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi naareeba ondiijo maraika naagyendera ahaiguru hagati omu mwanya, aine engiri ey'ebiro n'ebiro okubuurira abatuura omu nsi amahanga goona n'enganda zoona n'endimi n'abantu; ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.6",
            "verseOrgIds": [
              "REV.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "yaagamba n'eiraka rihango ati: Mutiine Ruhanga, mumuhe ekitiinisa, ahakuba obunaku bwe bw'okucweramu orubanja buhikire; muramye Ogwo owaahangire eiguru n'ensi n'enyanja n'enshuro z'amaizi.",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.7",
            "verseOrgIds": [
              "REV.14.7"
            ]
          }
        }
      ]
