                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.2.9"
              },
              "items": [
                {
                  "text": "Zek 2:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima abariba bari hare baryaija, bahwere omu by'okwombeka hekalu ya MUKAMA; haza obwo muryamanya ku MUKAMA ow'amahe niwe abantumireho. Kandi ku murita omutima aha kworobera eiraka rya MUKAMA Ruhanga waanyu, ebyo biryabaho.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.6.15",
            "verseOrgIds": [
              "ZEC.6.15"
            ]
          }
        }
