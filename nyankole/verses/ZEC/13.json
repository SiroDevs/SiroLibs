            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.13.1+DEU.13.2+DEU.13.3+DEU.13.4+DEU.13.5+DEU.13.6+DEU.13.7+DEU.13.8+DEU.13.9+DEU.13.10+DEU.13.11"
              },
              "items": [
                {
                  "text": "Bir 13:1-11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ku harigira owaagaruka kuba nabi, ishe na nyina abaamuzaire baryamugira bati: Tori w'okugumaho; ahabw'okuba noohanuura ebishuba omu iziina rya MUKAMA; kandi ishe na nyina abaamuzaire, ku ariba naahanuura, baryamuteera eicumu, rimwogyemu. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.13.3",
            "verseOrgIds": [
              "ZEC.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ZEC 13:4"
          },
          "items": [
