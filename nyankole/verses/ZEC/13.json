              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.1.8"
              },
              "items": [
                {
                  "text": "2 Bag 1:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MIC.3.7"
              },
              "items": [
                {
                  "text": "Mik 3:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Eryo izooba buri nabi, ku ariba naahanuura, aryakwatwa enshoni ahabw'ebi ayorekirwe; tarijwara kijwaro ky'ebyoya kubeiha abantu, ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.13.4",
            "verseOrgIds": [
              "ZEC.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ZEC 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "AMO.7.14"
              },
              "items": [
                {
                  "text": "Amo 7:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kureka aryagira ati: Tindi nabi, ndi omuhingi; ahabw'okuba okwiha omu buto bwangye eitaka rituura riri eitungo ryangye. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.13.5",
            "verseOrgIds": [
              "ZEC.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ZEC 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ku harigira owaamubuuza ati: Obwo buhuta bw'omu ngaro zaawe bukaruga hi? aryagarukamu ati: obuhuta obu nkabuhutaarizibwa omu nju ya banywani bangye.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.13.6",
            "verseOrgIds": [
              "ZEC.13.6"
            ]
          }
        }
