            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " MUKAMA ow'amahe naagira ati: Eryo izooba ndyamariraho kimwe omu nsi amaziina g'ebishushani ebirikuramibwa, birekye kwijukwa obundi; kandi ndyaiha omu nsi baanabi n'omwoyo ogutashemeire. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.13.2",
            "verseOrgIds": [
              "ZEC.13.2"
            ]
          }
        },
        {
