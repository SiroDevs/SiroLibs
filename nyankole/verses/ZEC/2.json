              "type": "text"
            }
          ]
        },
        {
          "text": " Iwe Saayuuni, yeshongore, oshemererwe; ahakuba reeba, niinyija, kandi ndyatuura omuriiwe ahagati; nikwo MUKAMA arikugira. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.2.10",
            "verseOrgIds": [
              "ZEC.2.10"
            ]
          }
        },
