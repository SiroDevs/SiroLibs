            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " yangira ati: Reeba, ndyagatigitira omukono, ngubangire, gahindukye eminyago y'abaabaire nibagaheereza. Haza obwo muryamanya ku MUKAMA ow'amahe niwe antumire. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.2.9",
            "verseOrgIds": [
              "ZEC.2.9"
            ]
          }
        },
