                  "text": "Isa 2:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Eryo izooba amahanga maingi garyayehongyera MUKAMA, babe abantu bangye; ndyaguma omuriiwe ahagati. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.2.11",
            "verseOrgIds": [
              "ZEC.2.11"
            ]
          }
        },
