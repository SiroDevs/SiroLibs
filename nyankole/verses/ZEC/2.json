            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " MUKAMA naagira ati: Yeimwe! Yeimwe! Nimuhungye, murugye omu nsi y'obukiizi-bwa-bumohso, ahabw'okuba niinyija kubataaruura, mbaihe ei emiyaga ena y'omu iguru ereetwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.2.6",
            "verseOrgIds": [
              "ZEC.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ZEC 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imwe batuuzi ba Babulooni 'mwe, nimuhungire Saayuuni; ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.2.7",
            "verseOrgIds": [
              "ZEC.2.7"
            ]
          }
        },
