                {
                  "text": "Bir 32:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Haza obwo oryamanya ku MUKAMA ow'amahe akuntumireho. Bwanyima MUKAMA aryahungura Yuda ebe omugabo gwe omu nsi erikwera, agarukye atoorane Yuda.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.2.12",
