                "loc": "DEU.32.10"
              },
              "items": [
                {
                  "text": "Bir 32:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.12.14"
              },
              "items": [
                {
                  "text": "Yer 12:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ahakuba MUKAMA ow'amahe ku yaaherize kuntuma aha mahanga agaabaire nigabanyaga, kumuhaisa ekitiinisa, (ahabw'okuba obakoraho aba akozire aha mboni y'eriisho rye) ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.2.8",
            "verseOrgIds": [
              "ZEC.2.8"
            ]
          }
        },
