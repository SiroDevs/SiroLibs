          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekyo nikyo kiriba ekifubiro kya Misri n'eky'amahanga goona agatainamuka kwijuka bugyenyi bw'ensiisira.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.19",
