            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TH.3.13"
              },
              "items": [
                {
                  "text": "1 Tes 3:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi muryahunga, murabe omu ruhanga rw'ahagati y'ebibungo byangye; ahabw'okuba orwo ruhanga rw'omu bibungo ruryahika Azeli; mutyo muhungye, nk'oku mwahungire omutsitsa ogwabaireho omu busingye bwa Uziya omugabe wa Yuda. Bwanyima MUKAMA Ruhanga waawe arayija hamwe n'abarikwera be boona.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.5",
            "verseOrgIds": [
              "ZEC.14.5"
            ]
          }
        }
      ]
    },
