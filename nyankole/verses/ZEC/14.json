                  "text": "Zek 12:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " nangwa na Yuda eryarwanisa Yerusaalemu. Knadi obutungi bw'amahanga goona agagyehinguriririize buryateeranirwa hamwe, ezaabu, efeeza n'ebijwaro bingi munonga. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.14",
            "verseOrgIds": [
              "ZEC.14.14"
            ]
          }
        },
        {
