          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ZEC 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ekibonaboneso nk'ekyo kiryahika aha mbaraasi, enyumbu, engamira, endogoya n'ahari ibara nyamaishwa eriba eri omu nsiisira zaabo.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.15",
