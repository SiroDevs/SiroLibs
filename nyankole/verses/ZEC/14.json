          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.13.16"
              },
              "items": [
                {
                  "text": "Isa 13:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LAM.5.11"
              },
              "items": [
                {
                  "text": "Tonz 5:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOL.3.2"
              },
              "items": [
                {
                  "text": "Yoel 3:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.21.24"
              },
              "items": [
                {
                  "text": "Luk 21:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ahakuba ndyateeranira hamwe amahanga goona, gateere Yerusaalemu, kandi orurembo ruryakwatwa, amaju ganyagwe, n'abakazi bahambwe. Ekicweka ky'ab'omu rurembo kiryatwarwa omu bukwatwa, kwonka abarirokokaho tibarimarwamu. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.2",
            "verseOrgIds": [
              "ZEC.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ZEC 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obwo MUKAMA aryahurura, arwane n'ago mahanga, nk'oku arwana aha izooba ry'orugamba. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.3",
            "verseOrgIds": [
              "ZEC.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ZEC 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.11.23"
              },
              "items": [
                {
                  "text": "Ezk 11:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Eryo izooba aryayemerera aha kibungo kya Zeituuni ekishungaine na Yerusaalemu aha rubaju rw'oburugwa-izooba; bwanyima ekyo kibungo kya Zeituuni kiryashatukamu kabiri okuruga aha rubaju rw'oburugwa-izooba, hagire oruhanga ruhango munonga, ekicweka kimw eky'ekyo kibungo kigwe aha rubaju rw'obukiizi-bwa-bumohso, n'ekindi aha rw'obukiizi-bwa-buryo. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.4",
            "verseOrgIds": [
              "ZEC.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ZEC 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "AMO.1.1"
              },
              "items": [
                {
                  "text": "Amo 1:1",
