            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi oruganda rwona orw'omu nsi, ku ruriba rutainamukire Yerusaalemu kuramya Omugabe, MUKAMA ow'amahe, owaabo teriguubwa njura. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.17",
            "verseOrgIds": [
              "ZEC.14.17"
            ]
          }
        },
