            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kureka riryaba eizooba rimwe eririkumanywa MUKAMA; tiburiba nyomushana, kandi tiburiba nyekiro, ahakuba n'omu mwabazyo omushana guryajwa.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.7",
