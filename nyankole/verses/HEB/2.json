              },
              "items": [
                {
                  "text": "Isa 41:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ahakuba nitumanyira kimwe ngu baamaraika tibo ahwera, kureka baijukuru ba Abrahamu. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.16",
            "verseOrgIds": [
              "HEB.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "HEB 2:17"
          },
          "items": [
            {
