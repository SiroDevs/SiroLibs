              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahakuba baamaraika ti bo Ruhanga yaahaire kutegyeka ensi eribaho, ei turikugambaho. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.5",
            "verseOrgIds": [
              "HEB.2.5"
            ]
          }
        },
