              "type": "text"
            }
          ]
        },
        {
          "text": "Nikyo tushemerereire kuta omutima aha bi twahuriire, ngu tutahaba tukabirugaho. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.1",
            "verseOrgIds": [
              "HEB.2.1"
            ]
          }
        },
