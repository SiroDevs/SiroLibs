              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.12.25"
              },
              "items": [
                {
                  "text": "Heb 12:25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " itwe turyakira tuta, ku turiba tuteetaire ha kujunwa okukuru okurikwingana kuti? Okujunwa okwo kukabanza kugambwa Mukama, twakuhamizibwa abaamuhuriire; ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.3",
            "verseOrgIds": [
              "HEB.2.3"
            ]
          }
        },
        {
          "name": "verse",
