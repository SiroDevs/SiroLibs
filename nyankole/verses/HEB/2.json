              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi hariho owaahamize ahandi ati:",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.6",
            "verseOrgIds": [
              "HEB.2.6"
