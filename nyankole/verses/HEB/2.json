                {
                  "text": "Heb 4:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ahabw'okuba We, nk'oku yaabonabonesiibwe atyo, kandi akoohibwa, naabaasa kuhwera abarikwohibwa.",
          "type": "text",
          "attrs": {
