                "loc": "ACT.7.53"
              },
              "items": [
                {
                  "text": "53",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mbwenu ekigambo ekyagambirwe baamaraika, ku kiraabe kyahamire, kandi n'okushiisha kwona n'okutahurira kwona ku biraabe byahairwe ekifubiro ekibishemereire, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.2",
            "verseOrgIds": [
              "HEB.2.2"
            ]
          }
        },
        {
