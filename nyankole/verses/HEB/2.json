            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.16.18"
              },
              "items": [
                {
                  "text": "Mak 16:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.16.20"
              },
              "items": [
                {
                  "text": "20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kandi na Ruhanga yaakuhamya n'obumanyiso n'eby'okutangaaza n'eby'amahano by'emiringo mingi n'ebiconco by'Omwoyo Orikwera, ebi Ruhanga yaagabire nk'oku yaasiimire.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.4",
            "verseOrgIds": [
              "HEB.2.4"
            ]
          }
        }
      ]
    },
