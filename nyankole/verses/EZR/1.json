              "items": [
                {
                  "text": "Fil 2:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ahonaaho abakuru b'amaju ga baishenkuru b'Abayuda n'ab'Ababenyamiini baimuka n'abanyamurwa n'Abaleevi, hamwe na'abandi boona, abu Ruhanga yaakozire aha mutima kwinamuka kuza kwombeka enju ya MUKAMA ey'omuri Yerusaalemu; ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.5",
            "verseOrgIds": [
              "EZR.1.5"
            ]
          }
        },
