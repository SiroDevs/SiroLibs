                "loc": "EXO.12.35"
              },
              "items": [
                {
                  "text": "Kur 12:35",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.12.36"
              },
              "items": [
                {
                  "text": "36",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kandi abaabaire batwire nabo baabatwera ebintu by'efeeza, n'ezaabu n'ebindi bintu n'amatungo, n'ebintu by'obuguzi bwingi, otabariireho ebindi byona ebi baatoizire n'omutima gwekundiire. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.6",
            "verseOrgIds": [
              "EZR.1.6"
            ]
          }
        },
