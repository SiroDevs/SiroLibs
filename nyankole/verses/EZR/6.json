                {
                  "text": "7:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abakuru b'Abayudaaya baayombeka, byagyenda gye ahabw'okuhanuura kwa nabi Hagai na Zekaria mwene Ido. Baayombeka, baaheza ahabw'okuragiirwa Ruhanga wa Israeli, kandi n'ahabw'ekiragiro ekyatairweho Kuuro na Dario na Aruta-gizakiseesi omugabe wa Perisi; ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.14",
            "verseOrgIds": [
              "EZR.6.14"
            ]
          }
        },
        {
