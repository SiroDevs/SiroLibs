              "items": [
                {
                  "text": "Est 3:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " egyo nju yaahwa aha kiro kya kashatu ky'okwezi kwa Adari, omu mwaka gwa mukaaga ogw'omu busingye bw'omugabe Dario.",
          "type": "text",
          "attrs": {
