                "loc": "ZEC.1.1"
              },
              "items": [
                {
                  "text": "Zek 1:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima baanabi Hagai na Zekaria mwene Ido baahanuurira Abayudaaya abaabaire bari Yuda na Yerusaalemu omu iziina rya Ruhanga wa Israeli. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.1",
            "verseOrgIds": [
              "EZR.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZR 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZR.3.2"
              },
              "items": [
                {
                  "text": "Ezr 3:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZR.6.14"
              },
              "items": [
                {
                  "text": "6:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ahonaaho Zerubabeeli mwwene Shealutieli na Yeshua mwene Yozadaaki baimuka, baatandika kugaruka kwombeka enju ya Ruhanga ey'omuri Yerusaalemu, nibahwerwa baanabi ba Ruhanga abo, abaabaire bari hamwe nabo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.2",
            "verseOrgIds": [
              "EZR.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZR 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZR.4.12"
              },
              "items": [
                {
                  "text": "Ezr 4:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZR.6.6"
              },
              "items": [
                {
                  "text": "6:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZR.6.13"
              },
              "items": [
                {
                  "text": "13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omu biro ebyo Tatenai omutegyeki w'ensi egyo eya seeri y'Omugyera na Shesari-bozenai na bagyenzi baabo baabashanga ahu baabaire bari, baababuuza bati: N'oha obaragiire kwombeka enju egi n'okuheza oru rugo rw'amabaare? ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.3",
            "verseOrgIds": [
              "EZR.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZR 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baagaruka baababuuza bati: Abarikwombeka egi nju amaziina gaabo nibaahi? ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.4",
            "verseOrgIds": [
              "EZR.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZR 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.33.18"
              },
              "items": [
                {
                  "text": "Zab 33:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwonka eriisho rya Ruhanga waabo ryaguma aha bategyeki b'Abayudaaya, tibaabazibira kwombeka, batakamanyise Dario, nwe akabagarukamu aha kigambo ekyo.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.5",
            "verseOrgIds": [
              "EZR.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
