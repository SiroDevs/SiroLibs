                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwanyima Sheshebazaari ogwo yaija, yaataho emisingi y'enju ya Ruhanga omuri Yerusaalemu; mbwenu okwiha obwo n'okuhitsya hati neekyombekwa, tekahweire. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.16",
            "verseOrgIds": [
              "EZR.5.16"
            ]
          }
        },
