                "loc": "GEN.28.11+GEN.28.12+GEN.28.13+GEN.28.14+GEN.28.15+GEN.28.16+GEN.28.17"
              },
              "items": [
                {
                  "text": "Gen 28:11-17",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 35:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.1",
            "verseOrgIds": [
              "GEN.35.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 35:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myoyo Yakobo ŵalisalile liŵasa lyakwe ni ŵandu wosope ŵiŵaliji nawo kuti, “Mjase milungu ja ŵandu",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.2",
            "verseOrgIds": [
              "GEN.35.2"
            ]
          }
        },
        {
          "text": " ŵa mitundu jine jimli najo. Mliswejesye, nipo m'wale yakuwala yecape. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.2",
            "verseOrgIds": [
              "GEN.35.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 35:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uweji citutyoce akuno kwawula ku Beteli, kwele kutingataŵe malo gakupelecela mbopesi kwa Mlungu juŵangamucisye une mu ndaŵi ja yisawusyo yangu. Jwalakwejo ni Mlungu juŵaliji ni une kulikose kunaliji.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.3",
            "verseOrgIds": [
              "GEN.35.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 35:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myoyo, ŵanace ŵakwe ŵapelece kwa Yakobo milungu josope ja ŵandu ŵa mitundu jine",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.4",
            "verseOrgIds": [
              "GEN.35.4"
            ]
          }
        },
        {
          "text": " jiŵakwete, kwisa soni ndolo siŵawalaga m'mapikanilo gawo. Yindu yosopeyo Yakobo ŵayisilile pasi pa citela ca mtundu, ciŵandika ni musi wa Shekemu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.4",
            "verseOrgIds": [
              "GEN.35.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 35:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.4",
            "verseOrgIds": [
              "GEN.35.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 35:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa ndaŵi jele Yakobo ni ŵanace ŵakwe ŵatyokaga, Mlungu ŵatendesye ŵandu wosope ŵa misinda jakusyungulila kola woga, myoyo nganiŵakuya. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.5",
            "verseOrgIds": [
              "GEN.35.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 35:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobo pamo ni ŵandu ŵiŵaliji nawo ŵala ŵayice ku Lusi, malo gagakumanyika soni ni lina lyakuti Beteli, mcilambo ca Kenani ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.6",
            "verseOrgIds": [
              "GEN.35.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 35:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵataŵile malo gakupelecela mbopesi kweleko, ni malogo ŵagapele lina lyakuti Mlungu jwa ku Beteli, Ligongo pa gele malogo Mlungu ni kuŵalilosisye kwa Yakobo pa ndaŵi jiŵamtilaga mkulugwawo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.7",
            "verseOrgIds": [
              "GEN.35.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 35:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Debola jwamasengo jwamkongwe jwa Labeka ŵawilile pelepo nipo ŵamsicile pasi pa citela ca mtundu, ku mwela kwa Beteli. Myoyo ŵacipele citela cila lina lyakuti “Citela ca Malilo.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.8",
            "verseOrgIds": [
              "GEN.35.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 35:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.8",
            "verseOrgIds": [
              "GEN.35.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 35:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobo ali awusile ku Mesopotamiya kula, Mlungu ŵamwonecele soni ni ŵampele upile. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.9",
            "verseOrgIds": [
              "GEN.35.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 35:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mlungu ni ŵatite, “Lina lyenu lili Yakobo, nambo kutandila lelo lina lyenu tiliŵe Isalaeli.” Myoyo ŵatandite kolanjidwa ni lina lyeleli.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.10",
            "verseOrgIds": [
              "GEN.35.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.32.28"
              },
              "items": [
                {
                  "text": "Gen 32:28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.10",
            "verseOrgIds": [
              "GEN.35.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 35:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nipo Mlungu ŵatite kwa Yakobo, “Une ndili Mlungu Jwamaciligosope, Mkole ŵanace ŵajinji. Mitundu jakulekanganalekangana tijicikopoka mwenumwe. M'mwejo timciŵa nangolo jwa ayimwene.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.11",
            "verseOrgIds": [
              "GEN.35.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.17.4+GEN.17.5+GEN.17.6+GEN.17.7+GEN.17.8"
              },
              "items": [
                {
                  "text": "Gen 17:4-8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.11",
            "verseOrgIds": [
              "GEN.35.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 35:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cilambo cinacipelece kwa Abulahamu",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.12",
            "verseOrgIds": [
              "GEN.35.12"
            ]
          }
        },
        {
          "text": " ni Isaki tinacipelece kwa m'mwejo, nambo soni tinjicipeleka kwa yisukulu yenu ŵitacipagwa pasogolo penu.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.12",
            "verseOrgIds": [
              "GEN.35.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 35:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mlungu ŵatyosile ni kumleka Yakobo pa malo giŵaŵecetelaga najo gala. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.13",
            "verseOrgIds": [
              "GEN.35.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 35:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobo ni ŵajigele liganga ni kuliŵika pelepo kuti liŵe cikumbukumbu. Ni ŵatasile mbopesi ja cakumwa pegangapo. Ŵalikonjile soni liganga lila mawuta.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.14",
            "verseOrgIds": [
              "GEN.35.14"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.28.18+GEN.28.19"
              },
              "items": [
                {
                  "text": "Gen 28:18-19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.14",
            "verseOrgIds": [
              "GEN.35.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 35:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobo ŵagapele lina lyakuti Beteli malo gaŵaŵecetene ni Mlungu gala.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.15",
            "verseOrgIds": [
              "GEN.35.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ciwa ca Lakelo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 35:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.15",
            "verseOrgIds": [
              "GEN.35.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 35:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myoyo Yakobo ni liŵasa lyakwe lyosope ŵatyosile ku Beteli, nambo mkanayice ku Efulati ndaŵi jakuti Lakelo akole mwanace jakwanile, nambo kuŵeleka kwakwe kwamsawisye mnope. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.16",
            "verseOrgIds": [
              "GEN.35.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 35:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yisawusyo yili yiyice pakusakala mnope, jwamkongwe jwakamucisya pa kuŵeleka ŵatite kwa Lakelo, “Mkajogopa, pakuŵa sambano timkole mwanace jwine jwamlume.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.17",
            "verseOrgIds": [
              "GEN.35.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 35:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo Lakelo ŵaliji mkuwa, mkanamalicice, ŵampele mwanace jula lina lyakwe Beni Oni.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.18",
            "verseOrgIds": [
              "GEN.35.18"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "35:18",
              "type": "text"
            },
            {
              "text": "Beni Oni:",
              "type": "text"
            },
            {
              "text": "Linali ligopolela kuti, “Mwanace jwa m'yipwetesi.”",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nambo Yakobo ŵampele mwanace jula lina lyakwe Benjamini.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.18",
            "verseOrgIds": [
              "GEN.35.18"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "35:18",
              "type": "text"
            },
            {
              "text": "Benjamini:",
              "type": "text"
            },
            {
              "text": "Linali ligopolela kuti, “Mwanace jwamjaliwe.”",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 35:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.18",
            "verseOrgIds": [
              "GEN.35.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 35:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakelo piŵawile ŵamsicile mwilembe mungulugulu litala lyakuja ku Efulati, kwele sambano kukuŵilanjidwa lina lyakuti Betelehemu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.19",
            "verseOrgIds": [
              "GEN.35.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 35:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nipo Yakobo ŵaŵisile liganga lya cikumbukumbu, pacanya pa lilembe lya Lakelo. Ligangalyo lili ciŵela pa malopo mpaka lelo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.20",
            "verseOrgIds": [
              "GEN.35.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 35:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
