      },
      "items": [
        {
          "text": "Mlungu akumpa upile Yakobo ku Beteli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 35:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myoyo Mlungu ŵamsalile Yakobo",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.1",
            "verseOrgIds": [
              "GEN.35.1"
            ]
          }
        },
        {
          "text": " kuti, “Nyakukani citemacitema, mjawule ku Beteli, mkatameje kweleko. Mkataŵe kweleko malo gakupelecela mbopesi kwa une, Mlungu jwenu junamwonecele pa ndaŵi jimwatilaga Esawu akulu ŵenu.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.1",
            "verseOrgIds": [
              "GEN.35.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
