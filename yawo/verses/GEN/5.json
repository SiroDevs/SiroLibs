            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ali apali Seti, Adamu ŵatemi yaka yine soni 800. Ni ŵakwete ŵanace ŵane soni ŵacalume ni ŵacakongwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.4",
