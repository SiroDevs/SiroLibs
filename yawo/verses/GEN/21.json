              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.29",
            "verseOrgIds": [
              "GEN.21.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 21:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abulahamu ni ŵajanjile kuti, “Ŵalakwe apocele ngondolo msano ni siŵilisi, ligongo pakutenda myoyo ni kuti ŵalakwe akwiticisya kuti cisima celeci nawukwile une.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.30",
            "verseOrgIds": [
              "GEN.21.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 21:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myoyo malo gala ŵagapele lina lyakuti Belesheba ligongo kweleko ŵandu ŵaŵili ŵala ŵapangene cilanga.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.31",
            "verseOrgIds": [
              "GEN.21.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 21:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.31",
            "verseOrgIds": [
              "GEN.21.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 21:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ali atesile cilanga celeci ku Belesheba kula, Abimeleki pamo ni Fikoli jwamkulungwa jwa asilikali ŵakwe ŵa ngondo, ŵanyakwice kuwujila kumangwawo, ku cilambo ca Afilisiti. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.32",
            "verseOrgIds": [
              "GEN.21.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 21:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abulahamu ŵapandile citela ca ukwesu ku Belesheba kula, nipo papopo soni ŵalambile AMBUJE Mlungu Ŵandaŵi syosope. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.33",
            "verseOrgIds": [
              "GEN.21.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "GEN 21:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nipo Abulahamu ŵatemi mcilambo ca Afilisiti kwa masiku gamajinji.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.34",
            "verseOrgIds": [
              "GEN.21.34"
            ]
          }
        }
      ]
