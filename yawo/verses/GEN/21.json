          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sambano ŵalakwe alumbile pameso pa Mlungu kuti ngasalambusya une, kapena ŵanace ŵangu, kapena soni yisukulu yangu. Une ndemi jwakulupicika kwa ŵalakwe, nombe nawo aŵice cilanga cakuti taciŵa ŵakulupicika kwa une, mcilambo cele cakuja kutamaco.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.23",
            "verseOrgIds": [
              "GEN.21.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 21:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abulahamu ni ŵatite, “Ngulumbila.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.24",
            "verseOrgIds": [
              "GEN.21.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
