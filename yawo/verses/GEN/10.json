    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yisukulu ya Nowa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aŵa ni ŵanace ŵacalume ŵa Nowa: Shemu, Hamu ni Yafeti. Ŵanace ŵatatu ŵa Nowa ŵeleŵa ŵakwete nombe nawo ŵanace ŵawo, cili cimasile cikumba ca mesi cila.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.1",
            "verseOrgIds": [
              "GEN.10.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.1",
            "verseOrgIds": [
              "GEN.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵanace ŵacalume ŵa Yafeti ŵaliji Gomeli, Magogi, Madayi, Yafani, Tubali, Mesheki ni Tilasi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.2",
            "verseOrgIds": [
              "GEN.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵanace ŵacalume ŵa Gomeli ŵaliji Ashikenasi, Lifati ni Togama. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.3",
            "verseOrgIds": [
              "GEN.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵanace ŵacalume ŵa Yafani ŵaliji, Elisha, Talishishi, Saipulasi, ni Dodanimu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.4",
            "verseOrgIds": [
              "GEN.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jemanjaji ni ŵiŵaliji acinangolo ŵa ŵandu wosope ŵiŵatamaga mungulugulu nyasa ni pa yilumba ya m'Nyasa ja Mediteleniyani. Aŵa ni ŵanace ŵa Yafeti. Mitundu jawo jaliji jakulekanganalekangana, nipo ŵaliji mkutama myilambo yakulekanganalekangana. Nipo mtundu uliwose ŵaŵecetaga ciŵeceto cakwe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.5",
            "verseOrgIds": [
              "GEN.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.5",
            "verseOrgIds": [
              "GEN.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵanace ŵacalume ŵa Hamu ŵaliji, Kushi, Iguputo, Libiya ni Kenani. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.6",
            "verseOrgIds": [
              "GEN.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵanace ŵacalume ŵa Kushi ŵaliji Seba, Hafila, Sabita, Lama ni Sabiteka. Ŵanace ŵacalume ŵa Lama ŵaliji Siba ni Dedani. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.7",
            "verseOrgIds": [
              "GEN.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kushi ŵakwete soni mwanace jwamlume lina lyakwe Nimulodi, juŵaliji mundu jwa ngondo jwandanda jwamacili pa cilambo capasi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.8",
            "verseOrgIds": [
              "GEN.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwalakweju ŵaliji jwakusakula nyama jwamacili pameso pa AMBUJE. Ni ligongo lyakwe ŵandu akusaŵeceta citagu",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.9",
            "verseOrgIds": [
              "GEN.10.9"
            ]
          }
        },
        {
          "text": " cakuti, “M'mwejo mli jwakusakula nyama jwamacili pameso pa AMBUJE, mpela Nimulodi.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.9",
            "verseOrgIds": [
              "GEN.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pandanda ucimwene wakwe wapwatikaga Babiloni, Eleki, ni Akadi jijili ku mcilambo ca Babiloniya. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.10",
            "verseOrgIds": [
              "GEN.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwalakweju ŵatyosile kweleko nipo ŵajawile ku cilambo ca Asiliya kuŵataŵile misinda ja Ninefe, Lehoboti Ili, Kala, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.11",
            "verseOrgIds": [
              "GEN.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "ni msinda wa Leseni wele uli pasikati pa msinda wa Ninefe ni msinda wawukulungwa wa Kala.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.12",
            "verseOrgIds": [
              "GEN.10.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.12",
            "verseOrgIds": [
              "GEN.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iguputo ŵaliji nangolo jwa ŵandu ŵa ku Lidiya, Anamimu, Lehabu, Nafutuhimu, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.13",
            "verseOrgIds": [
              "GEN.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Patilusimu, Kasiluhimu ni Kilete, jemanjaji ŵaliji acinangolo ŵa Afilisiti. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.14",
            "verseOrgIds": [
              "GEN.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenani ŵaŵelece mwanace jwakwe jwandanda lina lyakwe Sidoni, ni ŵaŵelece soni jwine lina lyakwe Heti. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.15",
            "verseOrgIds": [
              "GEN.10.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenani ŵaliji soni nangolo jwa ŵandu ŵa mtundu wa Ayebusi, Aamoli, Agiligashi, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.16",
            "verseOrgIds": [
              "GEN.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahifi, Aaliki, Asini, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.17",
            "verseOrgIds": [
              "GEN.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alifadi, Asemali ni mtundu wa Ahamati. Msogolo mwakwe mtundu wa Akenani wabalalikangene posepose, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.18",
            "verseOrgIds": [
              "GEN.10.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "mpaka ku malile ga Kenani. Malilego gatandilile ku Sidoni kwinjililaga ku Gelali mpaka ku Gasa ni kwinjilila soni ku Sodomu, Gomola, Adima ni Seboyimu mpaka ku Lasha. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.19",
            "verseOrgIds": [
              "GEN.10.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jemanjaji ni ŵaliji ŵanace ŵa Hamu, nipo ŵatamaga m'yilambo yakulekanganalekangana, mpela mwa mitundu jawo. Mtundu uliwose ŵaŵecetaga ciŵeceto cakwe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.20",
            "verseOrgIds": [
              "GEN.10.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.20",
            "verseOrgIds": [
              "GEN.10.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shemu mkulugwe jwa Yafeti ŵaliji nangolo jwa ŵanace wosope ŵakupagwa mwa Eba. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.21",
            "verseOrgIds": [
              "GEN.10.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 10:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵanace ŵacalume ŵa Shemu ŵaliji Elamu, Ashuli, Alipakisadi, Ludi ni Alamu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.22",
            "verseOrgIds": [
              "GEN.10.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 10:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵanace ŵacalume ŵa Alamu ŵaliji Usi, Huli, Getele ni Mesheki. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.23",
            "verseOrgIds": [
              "GEN.10.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 10:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alipakisadi ŵaliji mtatigwe jwa Shela, nipo Shela ŵaliji mtatigwe jwa Eba. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.24",
            "verseOrgIds": [
              "GEN.10.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 10:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eba ŵakwete ŵanace ŵaŵili ŵacalume, jwine lina lyakwe ŵaliji Pelegi, ligongo mu ndaŵi ja umi wakwe ŵandu wosope ŵa pa cilambo capasi ŵagaŵikene ligongo lyakulekangana yiŵeceto ni ŵatemi m'yilambo yakulekangana. Mwanace jwakwe jwine ŵaliji lina lyakwe Yokitani. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.25",
            "verseOrgIds": [
              "GEN.10.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 10:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yokitani ŵaliji nangolo jwa ŵandu ŵa mtundu wa Alimodadi, Shelefi, Hasamafeti, Yela, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.26",
            "verseOrgIds": [
              "GEN.10.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 10:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hadolamu, Usali, Dikila, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.27",
            "verseOrgIds": [
              "GEN.10.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 10:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obala, Abimayele, Sheba, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.28",
            "verseOrgIds": [
              "GEN.10.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 10:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ofili, Hafila ni Yobabu. Wosopeŵa nangolo jwawo ŵaliji Yokitani. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.29",
            "verseOrgIds": [
              "GEN.10.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 10:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cilambo cawo ciŵatamaga catandilile ku Mesha kwinjililaga ku Sefa cilambo ca matumbi ca kungopoko lyuŵa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.30",
            "verseOrgIds": [
              "GEN.10.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 10:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
