          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yili yipite ayi yinduyi, Abulahamu ŵapikene kuti Milika ŵaŵelecele Naholi mpwawo ŵanace msano ni ŵatatu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.20",
            "verseOrgIds": [
              "GEN.22.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 22:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanace jwandanda lina lyakwe ŵaliji Usi, mpwakwe jwa Usi jwaliji Busi. Ni ŵapali soni Kemuele baba ŵawo Alamu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.21",
            "verseOrgIds": [
              "GEN.22.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 22:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kesedi, Haso, Pilidashi, Yidilafu ni Betuwelo, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.22",
            "verseOrgIds": [
              "GEN.22.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 22:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Betuwelo ŵaliji baba ŵawo Labeka. Milika ŵamŵelecele Naholi, mpwawo Abulahamu ŵanace msano ni ŵatatu ŵeleŵa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.23",
            "verseOrgIds": [
              "GEN.22.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 22:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo soni ŵamkwawo ŵanondi lina lyakwe Lewuma, ŵamŵelecele Naholi ŵanace aŵa: Teba, Gahamu, Tahashi, ni Maaka.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.24",
            "verseOrgIds": [
              "GEN.22.24"
            ]
          }
