              },
              "items": [
                {
                  "text": "Gen 23:3-20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.30",
            "verseOrgIds": [
              "GEN.49.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 49:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwelemo ni muŵamsicile Abulahamu ni Sala ŵamkwawo, Isaki ni Labeka ŵamkwawo, mwelemo soni ni munasicile Leya ŵamkwangu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.31",
            "verseOrgIds": [
              "GEN.49.31"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.25.9+GEN.25.10"
              },
              "items": [
                {
                  "text": "Gen 25:9-10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.35.29"
              },
              "items": [
                {
                  "text": "35:29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.31",
            "verseOrgIds": [
              "GEN.49.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 49:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgunda pamo ni mbanga jili mu mgunda yasumidwe kutyocela kwa Ahiti.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.32",
            "verseOrgIds": [
              "GEN.49.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 49:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobo piŵamasile kuŵeceta yosopeyi, ŵagonile pacindanda pala ni kuwa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.33",
            "verseOrgIds": [
              "GEN.49.33"
            ]
          }
        },
