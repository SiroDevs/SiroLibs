                "loc": "1CO.11.7"
              },
              "items": [
                {
                  "text": "1 Akoli 11:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.26",
            "verseOrgIds": [
              "GEN.1.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 1:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myoyo Mlungu ŵapanganyisye ŵandu mciwanicisyo cakwe. Ŵapanganyisye jwine jwamlume ni jwine jwamkongwe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.27",
            "verseOrgIds": [
              "GEN.1.27"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
