          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yisukulu ya Yakobo yiŵapite nayo ku Iguputo yaliji 66, ngaŵalanjila aciŵamkwawo ŵa ŵanace ŵawo ŵacalume. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.26",
            "verseOrgIds": [
              "GEN.46.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 46:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosefe ŵakwete ŵanace ŵaŵili ku Iguputo peko. Pamo ŵandu wosope mwiŵasa lya Yakobo mu Iguputo ŵaliji 70.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.27",
            "verseOrgIds": [
              "GEN.46.27"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
