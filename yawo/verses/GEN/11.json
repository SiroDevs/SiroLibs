          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa ndaŵi jele Alipakisadi ŵaliji ni yaka 35, ŵakwete mwanace jwamlume lina lyakwe Shela. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.12",
            "verseOrgIds": [
              "GEN.11.12"
            ]
