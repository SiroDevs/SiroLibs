        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.30",
            "verseOrgIds": [
              "GEN.11.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 11:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tela ŵamjigele Abulamu mwanagwawo ni Loti cisukulu cawo, juŵaliji mwanace jwa Halani, ni Salayi mkwegwe gwawo, ŵamkwawo Abulamu. Ŵanyakwice ulendo kutyoka mu msinda wa Ulu, wa ku cilambo ca Babiloniya kuja ku cilambo ca Kenani. Nambo piŵayice ku Halani, ŵagambile kutamilicika kukoko. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.31",
            "verseOrgIds": [
              "GEN.11.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 11:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nipo Tela ŵawilile ku Halani kukoko ali ŵa yaka 205.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.32",
            "verseOrgIds": [
              "GEN.11.32"
            ]
          }
        }
      ]
