          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pandaŵi aji lijoka lyaliji lyakalamuka mnope kuyipunda yinyama yosope yiŵayipanganyisye AMBUJE",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.1",
            "verseOrgIds": [
              "GEN.3.1"
            ]
          }
        },
        {
          "text": " Mlungu. Lijoka lyamwusisye jwamkongwe kuti, “Ana yakuwona kuti Mlungu ŵatite mkasimlya cisogosi ca yitela yiliyose mu mgunda muno?”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.1",
            "verseOrgIds": [
              "GEN.3.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
