          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwitakamo timucimela tutela twa miŵa ni twa matungwisa, soni timcilya yakumela ya mwitinji. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.18",
            "verseOrgIds": [
              "GEN.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkwenela kukamula masengo mnope mpaka kukoposya citukuta, kuti litaka limpe yakulya mpaka pa timciwujila kwitaka kumwatyocele. Nampanganyisye kutyocela kwitaka, kwitaka kukoko timciwujila.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.19",
            "verseOrgIds": [
              "GEN.3.19"
            ]
          }
        }
      ]
    },
