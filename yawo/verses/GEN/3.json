          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adamu ni ŵampele ŵamkwawo lina lyakuti Hawa, ligongo lyakuti jwelejo ŵaliji mama jwa ŵandu wosope. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.20",
            "verseOrgIds": [
              "GEN.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "AMBUJE Mlungu ŵapanganyisye yakuwala ya Adamu ni ŵamkwawo kutyocela ku mapende ga nyama, ni ŵawecice jemanjajo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.21",
            "verseOrgIds": [
              "GEN.3.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Adamu ni Hawa akutoposyedwa mu mgunda",
          "type": "text"
        }
      ]
    },
