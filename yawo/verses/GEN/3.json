          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myoyo AMBUJE Mlungu ŵamtyosisye mundujo mu mgunda wa Edeni mula, kuti akalimeje mwitaka lilyolyo liŵampanganyicisyelyo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.23",
            "verseOrgIds": [
              "GEN.3.23"
            ]
          }
        },
        {
          "name": "verse",
