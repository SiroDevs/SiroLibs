                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.20.2"
              },
              "items": [
                {
                  "text": "20:2",
                  "type": "text"
                }
              ]
            }
          ]
        }
