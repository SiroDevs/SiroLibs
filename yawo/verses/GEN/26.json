              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esawu piŵaliji ni yaka 40 ŵalombele Yuditi jwamkongwe jwa Beeli jwa mtundu wa Cihiti. Ŵalombele soni Basemati jwamkongwe jwa Eloni jwa mtundu wa Cihiti. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.34",
            "verseOrgIds": [
              "GEN.26.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
