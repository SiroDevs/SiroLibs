    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Isaki ŵajile kutama ku Gelali",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 26:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndaŵi jelejo kwagwile sala mpela jijagwile mu ndaŵi ja Abulahamu",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.1",
            "verseOrgIds": [
              "GEN.26.1"
            ]
          }
        },
        {
          "text": " nipo Isaki ŵajile ku Gelali kwa Mwenye Abimeleki jwa Afilisiti. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.1",
            "verseOrgIds": [
              "GEN.26.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 26:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "AMBUJE",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.2",
            "verseOrgIds": [
              "GEN.26.2"
            ]
          }
        },
        {
          "text": " ŵamwonecele Isaki ni kumsalila kuti, “Mkasimjawula ku Iguputo, mtame mcilambo citinamsalile kuti mtamemo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.2",
            "verseOrgIds": [
              "GEN.26.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 26:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mtame nawo mcilambo celeci, nipo une tinjiŵa namwe, soni tinjimpa upile, pakuŵa tinjipeleka kwa yisukulu yenu yilambo yosopeyi, nipo tinjilocesya kuti tiyitendece yosope yinatite mcilanga cinalumbilile baba ŵenu Abulahamu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.3",
            "verseOrgIds": [
              "GEN.26.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.22.16+GEN.22.17+GEN.22.18"
              },
              "items": [
                {
                  "text": "Gen 22:16-18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.3",
            "verseOrgIds": [
              "GEN.26.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 26:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tinjimpa yisukulu yejinji mpela ndondwa sya kwinani nipo tinjiyipa yisukulu yenu yilambo yosopeyi. Mitundu josope ja pa cilambo capasi tijicipata upile kupitila mwa yisukulu yenu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.4",
            "verseOrgIds": [
              "GEN.26.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 26:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tinjimpa upile ligongo Abulahamu ŵambikanile une, ni ŵagakuyiye malamusi ni majiganyo gangu.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.5",
            "verseOrgIds": [
              "GEN.26.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 26:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.5",
            "verseOrgIds": [
              "GEN.26.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 26:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myoyo Isaki ŵatemi ku Gelali. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.6",
            "verseOrgIds": [
              "GEN.26.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 26:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵandu ŵakweleko piŵamwusisye ya Labeka ŵamkwakwe, jwalakwe ŵajanjile kuti ali mlumbugwe. Jwalakwe ŵajogwepe kusala kuti ali ŵamkwangu. Ŵajogopaga kuti ŵandu ŵala ni mkaŵa kumwulaga, ni kumlomba Labeka, ligongo ŵaliji ŵakusalala mnope.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.7",
            "verseOrgIds": [
              "GEN.26.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.12.13"
              },
              "items": [
                {
                  "text": "Gen 12:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.20.2"
              },
              "items": [
                {
                  "text": "20:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.7",
            "verseOrgIds": [
              "GEN.26.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 26:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ali atemi kweleko ndaŵi jajilewu, Mwenye Abimeleki jwa Afilisiti ŵalingwile pewindo kulola kusa, ni ŵam'weni Isaki ali amkumbatile Labeka. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.8",
            "verseOrgIds": [
              "GEN.26.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 26:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nipo Abimeleki ŵamtumile mundu kuja kukumŵilanga Isaki. Nipo ŵatite, “Nditu ŵakongwe ŵala ali ŵamkwenu. Ligongo cici mwatite ali mlumbugwenu?” Isaki ni ŵajanjile kuti, “Natite myoyo ligongo najogwepe kumbulaga une ligongo lya jwamkongweju.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.9",
            "verseOrgIds": [
              "GEN.26.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 26:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.9",
            "verseOrgIds": [
              "GEN.26.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 26:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abimeleki ni ŵatite, “Mtesile yindu yeleyi ligongo cici? Jumo jwa ŵandu ŵangu angakombolece kwawusya ulombela ŵamkwenu ni mkatutendesye uwe kuŵa ŵakulemwa.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.10",
            "verseOrgIds": [
              "GEN.26.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myoyo Abimeleki ŵakalamwisye ŵandu wosope kuti, “Mundu jwalijose jutamsawusye mundu aju kapena ŵamkwakwe taciwulajidwa.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.11",
            "verseOrgIds": [
              "GEN.26.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.11",
            "verseOrgIds": [
              "GEN.26.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 26:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaki ŵalimile mcilambo mula, nipo ŵagowele yindu yejinji, ligongo AMBUJE ŵampele upile. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.12",
            "verseOrgIds": [
              "GEN.26.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 26:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaki ŵasicile, nipo cipanje cakwe caliji mkutupilatupilape mpakana ŵayikene kuwa ali mundu jwakusicila mnope. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.13",
            "verseOrgIds": [
              "GEN.26.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 26:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwalakwe ŵakwete ngondolo, ng'ombe ni ŵamasengo ŵajinji mwakuti Afilisiti ŵamtendele litima. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.14",
            "verseOrgIds": [
              "GEN.26.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 26:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndaŵi jeleji Afilisiti ŵaliji ali asilile yisima yosope yiŵasosile ŵamasengo ŵa Abulahamu baba ŵawo Isaki, Abulahamuwo piŵaliji ŵacijumi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.15",
            "verseOrgIds": [
              "GEN.26.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 26:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.15",
            "verseOrgIds": [
              "GEN.26.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 26:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nipo Abimeleki ŵatite kwa Isaki, “Tyokani akuno, pakuŵa m'mwejo sambano mli ŵamacili kutupunda uwe.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.16",
            "verseOrgIds": [
              "GEN.26.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 26:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myoyo Isaki ŵatyosile ni kuja kutaŵa matenti m'Ciŵata ca Gelali ni ŵaliji mkutama kweleko. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.17",
            "verseOrgIds": [
              "GEN.26.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 26:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaki ŵayiwukwile soni Isima yiŵasosile Abulahamu ali ŵacijumi pakuŵa Afilisiti ŵayisilile piŵawile Abulahamuwo. Isaki ŵayipele mena gagogo giŵayipele baba ŵawo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.18",
            "verseOrgIds": [
              "GEN.26.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 26:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.18",
            "verseOrgIds": [
              "GEN.26.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 26:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo ŵamasengo ŵa Isaki piŵasosile cisima mciŵata ni kugasimana mesi, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.19",
            "verseOrgIds": [
              "GEN.26.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 26:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵakucinga yilangwa ŵa ku Gelali ni ŵakucinga yilangwa ŵa Isaki ŵatandite kangana acitiji, “Mesiga gali getu.” Myoyo Isaki ŵacipele cisima cila lina lyakwe Kukangana, ligongo ŵandu ŵakangene najo ligongo lya cisima.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.20",
            "verseOrgIds": [
              "GEN.26.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 26:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.20",
            "verseOrgIds": [
              "GEN.26.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 26:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵamasengo ŵa Isaki ŵasosile cisima cine, pelepo soni ŵandu ŵala ŵakanganile nawo, myoyo Isaki ŵacipele cisimaco lina lyakwe “Uŵengani.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.21",
            "verseOrgIds": [
              "GEN.26.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 26:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaki ŵatyosile kweleko, ni ŵajile kusola cisima cine. Pacisima aci paliji pangali kukangana, myoyo Isaki ŵacipele cisimaco lina lyakuti “Mtendele”. Pakuti Isaki ŵatite, “Sambano AMBUJE atupele mtendele mcilambo, nipo uweji tusicile akuno.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.22",
            "verseOrgIds": [
              "GEN.26.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 26:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.22",
            "verseOrgIds": [
              "GEN.26.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 26:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutyoka apa, ŵajile ku Belesheba ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.23",
            "verseOrgIds": [
              "GEN.26.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 26:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cilo ca lisiku lilyolyo, AMBUJE ŵamwonecele Isaki ni kumsalila kuti, “Une ndili Mlungu jwa Abulahamu baba ŵenu, mkajogopa pakuŵa une ndili namwe, tinjimpa upile nipo tinjimpa yisukulu yejinji ligongo lya jwakutumicila jwangu Abulahamu.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.24",
            "verseOrgIds": [
              "GEN.26.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 26:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myoyo Isaki ŵataŵile malo gakupelecela mbopesi ni ŵamlumbile AMBUJE ni ŵataŵile soni tenti jawo pelepo. Ŵamasengo ŵa Isaki ŵasosile soni cisima.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.25",
            "verseOrgIds": [
              "GEN.26.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Cilanga ca Isaki ni Abimeleki",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 26:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.25",
            "verseOrgIds": [
              "GEN.26.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 26:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaneko Abimeleki pamo ni Ahusati nduna jakwe ni Fikoli jwamkulungwa jwa asilikali ŵakwe, ŵapite kukumlola Isaki kutyocela ku Gelali.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.26",
            "verseOrgIds": [
              "GEN.26.26"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.21.22"
              },
              "items": [
                {
                  "text": "Gen 21:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.26",
            "verseOrgIds": [
              "GEN.26.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 26:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaki ŵawusisye jemanjajo kuti, “Myice akuno ligongo cici jemanja wakuti mkisimumbenga mpaka mwandopwesye kumangwenu?”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.27",
            "verseOrgIds": [
              "GEN.26.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 26:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.27",
            "verseOrgIds": [
              "GEN.26.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 26:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni ŵamjanjile kuti, “Uwe tuyiweni kuti AMBUJE ali namwe ni tukusaka kuti paŵe cilanga",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.28",
            "verseOrgIds": [
              "GEN.26.28"
            ]
          }
        },
        {
          "text": " cilikati ca m'mwejo ni uwe, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.28",
            "verseOrgIds": [
              "GEN.26.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 26:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "cakuti m'mwejo ngasimtutendela uwe yakusakala yiliyose mpela mumkanitumtendela m'mwejo cindu cakusala cilicose. Uwe twamtendele yindu yambonepe nambo soni twamkundile kuti mtyoce mcilambo cetu mwamtendele. Sambano yili yaciwonecele kuti AMBUJE ampe upile m'mwejo.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.29",
            "verseOrgIds": [
              "GEN.26.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 26:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myoyo Isaki ŵalinganyisye cindimba ni ŵalile ni kumwa pamo ni ŵandu ŵala. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.30",
            "verseOrgIds": [
              "GEN.26.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 26:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵajimwice kundaŵindaŵipe nipo ŵaŵisile cilanga ni ŵalumbile ŵana ŵaŵili. Kaneko Isaki ŵapecesye ŵandu ŵala, nipo ŵapite mu mtendele.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.31",
            "verseOrgIds": [
              "GEN.26.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 26:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.31",
            "verseOrgIds": [
              "GEN.26.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 26:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lisiku lilyolyo, ŵamasengo ŵa Isaki ŵayice kukumsalila yacisima ciŵasosile, “Ŵatite tugapatile mesi.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.32",
            "verseOrgIds": [
              "GEN.26.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 26:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaki ŵacipele cisimaco lina lyakuti Shiba. Lina lya msinda wa Belesheba lyawumile pa lina lya cisima celeci.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.33",
            "verseOrgIds": [
              "GEN.26.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aciŵamkwakwe Esawu ŵa mtundu wa Cihiti",
          "type": "text"
        }
      ]
    },
