              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵatyosile ku Iguputo kuwujila ku Kenani kuŵaliji baba ŵawo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.25",
            "verseOrgIds": [
              "GEN.45.25"
            ]
          }
        },
        {
          "name": "verse",
