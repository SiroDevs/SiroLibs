          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo piŵamsalile maloŵe gosope gakutyocela kwa Yosefe, nipo piŵayiweni yigeleta yila yiŵatumisye Yosefe kuti takwele, ŵatandite kulupilila. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.27",
            "verseOrgIds": [
