              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni ŵasalile baba ŵawo ŵala kuti, “Yosefe ali cijumi,” nipo “Jwalakwe ni jwali jwakulamula jwa cilambo cosope ca Iguputo.” Yakobo ŵaliji ŵakutenguka nipo nganakulupilila.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.26",
            "verseOrgIds": [
              "GEN.45.26"
            ]
          }
        }
      ]
