          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobo ŵatemi mcilambo ca Iguputo yaka 17, myoyo, yaka yakupagwa kwawo yaŵikene 147. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.28",
            "verseOrgIds": [
