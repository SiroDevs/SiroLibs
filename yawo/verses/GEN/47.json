              "type": "text"
            }
          ]
        },
        {
          "text": "Aisalaeli ŵala ŵatemi mcilambo ca Iguputo ku Gosheni ku ŵasicile ni kola soni ŵanace ŵajinji. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.27",
            "verseOrgIds": [
              "GEN.47.27"
            ]
          }
        },
        {
