          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nombe Ila jwa ku msida wa Yaili jwaliji jwa kutaga mbopesi jwa Daudi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.26",
            "verseOrgIds": [
