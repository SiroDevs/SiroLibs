        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2SA 20:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yagambile kutendekwa kuti kweleko kwapali mundu jwine jwa ndamo syacabe lina lyakwe Sheba, mwanace jwa Bikili jwa lukosyo lwa Benjamini. Jwelejo jwagombile lipenga, ni jwatite, “Um'we ŵangali cetu mu ucimwene wa Daudi,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.1",
            "verseOrgIds": [
              "2SA.20.1"
            ]
          }
        },
        {
          "text": " soni nganitukola kandu mwa mwanace jwa Yese; Jemanja Aisalaeli, jwalijose ajawuleje ku nyumba jakwe!”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.1",
            "verseOrgIds": [
              "2SA.20.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
