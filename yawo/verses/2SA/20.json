                "loc": "1KI.12.16"
              },
              "items": [
                {
                  "text": "1 Ayi 12:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.10.16"
              },
              "items": [
                {
                  "text": "2 Mbi 10:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.1",
            "verseOrgIds": [
              "2SA.20.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pelepo Aisalaeli wosope ŵalesile kumkuya Daudi, ni ŵatandite kumkuya Sheba, mwanace jwa Bikili. Nambo ŵandu ŵa ku Yuda ŵalijipe panyuma pa mwenye jwawo, kutandila ku Yolodani mpaka ku Yelusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.2",
            "verseOrgIds": [
              "2SA.20.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.2",
            "verseOrgIds": [
              "2SA.20.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi piŵayice ku nyumba jawo ku Yelusalemu, ŵajigele aciŵamkwawo likumi ŵele ŵiŵalesile kuti aloleleje musi, ni ŵawugalile m'nyumba ni ŵaŵisile londa jwakwalondela. Ŵapaga yakulya, nambo Daudi nginajinjilaga m'nyumba sya aciŵamkwawosyo. Ŵawugalile m'nyumbamo mpaka lisiku lya kuwa kwawo, ni ŵaliji mpela acakongwe ŵamasije.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.3",
            "verseOrgIds": [
              "2SA.20.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.16.22"
              },
              "items": [
                {
                  "text": "2 Sam 16:22",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.3",
            "verseOrgIds": [
              "2SA.20.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenye ŵatumile Amasa kuti, “Mumbilanjile ŵandu wosope ŵa ku Yuda, mkayice nawo mkinigamale masiku gatatu.” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.4",
            "verseOrgIds": [
              "2SA.20.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwakuti Amasa ŵapite kukwasonganganya Ayuda, nambo ŵakokweŵe ni ŵapelengenye masiku. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.5",
            "verseOrgIds": [
              "2SA.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pelepo Daudi ŵasalile Abishayi kuti, “Sheba, mwanace jwa Bikili, tacitusawusya kwejinji kupunda Abisalomu. Mjigale ŵa ngondo ŵangu mumkuye Shebajo ligongo tacipata misinda jandenje syakulimba ni kutusawusyaga uwe.” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.6",
            "verseOrgIds": [
              "2SA.20.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myoyo Abishayi jula ni ŵa ngondo ŵa Yowabu, ni Akeleti, ni ŵa Apeleti, ni ŵamacili wosope ŵakopwece mu Yelusalemu kumkuya Sheba, mwanace jwa Bikili. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.7",
            "verseOrgIds": [
              "2SA.20.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndaŵi jiŵayice ku liganga lyekulungwa lilyaliji ku Gibiyoni, Amasa ŵayice kukuwonegana najo. Nambo Yowabu ŵawete malaja ga ngondo, pacanya pa malajago papali lamba mciwunu mwawo, juŵataŵilaga upanga m'malo mwakwe. Upangawo ni wagwile piŵajendaga. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.8",
            "verseOrgIds": [
              "2SA.20.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yowabu ŵawusisye Amasa kuti, “Ana kwambone mlongo mjangu?” Pelepo Yowabujo ŵamkamwile ndewu Amasa jula ni mkono wakwe wamlyo kuti amkumbatile kulosya kumpocela ni makono gaŵili. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.9",
            "verseOrgIds": [
              "2SA.20.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 20:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo Amasa nginawuwona upanga ŵaliji mwigasa lya Yowabu. Papopo Yowabu ŵamtutile Amasa pa lutumbo kampepe basi, mpaka matumbo gakwe gawulutwice, ni ŵawile papopo. Sambano Yowabu ni Abishayi mlongo mjawo ŵamkuyisye Sheba mwanace jwa Bikili. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.10",
            "verseOrgIds": [
              "2SA.20.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 20:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jumo mwa ŵa ngondo ŵa Yowabu jwajimi pambali pa mtembo wa Amasa ni jwatite, “Jwalijose jwali panyuma pa Yowabu ni Daudi, amlece amkuye Yowabu.” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.11",
            "verseOrgIds": [
              "2SA.20.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 20:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mosopemo Amasa ali agonile pa msewu mwitanda lya miasi jakwe. Ni jwalijose juŵayikaga, jwajimaga ali alolite. Pelepo mundu jwa Yowabu jula ŵayiweni kuti ŵandu akwima, ŵamnyakwile Amasa jula, kumtyosya mu msewumo ni ŵamŵisile kwitinji ni kumwunicila cakuwala. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.12",
            "verseOrgIds": [
              "2SA.20.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 20:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Piŵamtyosisye pa msewupo, ŵandu wosope ŵamkuyisye Yowabu, kuti amkuye Sheba mwanace jwa Bikili. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.13",
            "verseOrgIds": [
              "2SA.20.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 20:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sheba jwapitile mu upande wa ngosyo syosope sya Isalaeli ni ŵajile kuyika ku Abele Beti Maka, nipo wosope ŵa mwiŵele lya Bikili ŵasongene ni ŵamkuyisye jwalakwejo mu msindamo. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.14",
            "verseOrgIds": [
              "2SA.20.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 20:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni ŵandu ŵiŵaliji ni Yowabu ŵayice, ni ŵasyungulile yitando ya ŵa ngondo, Shebajo jwa kwa Abele Beti Maka. Pelepo ŵawunjile msindawo matuto ga ngondo, ni gagundile luŵalalo. Myoyo ni ŵagumulaga lipupa kuti aligwisye. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.15",
            "verseOrgIds": [
              "2SA.20.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 20:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni jwamkongwe jwine jwalunda jwatandite kuŵilanga mu msindamo kuti, “Apikane! Apikane! Ŵasalile Yowabu ayice akuno kuti mbecete nawo.” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.16",
            "verseOrgIds": [
              "2SA.20.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 20:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yowabu ŵayice pakuŵandika ni jwamkongwejo, nipo jwalakwejo jwawusisye kuti, “Ana ŵalakwe ni Yowabu?” Yowabu ŵajanjile kuti, “Ni une jwene.” Jwamkongwe jwatite, “Pepani baba, ambikanile maloŵe gangu.” Yowabu ŵajanjile kuti, “Elo, ngupikana.”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.17",
            "verseOrgIds": [
              "2SA.20.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 20:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.17",
            "verseOrgIds": [
              "2SA.20.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 20:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pelepo jwamkongwe jula jwatite, “Paja ŵandu kalakala ŵatiji, ‘Akaŵende lunda kwa Abele.’ Ngani syawo syamalaga myoyo. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.18",
            "verseOrgIds": [
              "2SA.20.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 20:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwe ni ŵandu ŵa mtendele ni ŵakulupicika mcilambo ca Aisalaeli. Ana ligongo cici akuti asalasye yindu ya AMBUJE?”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.19",
            "verseOrgIds": [
              "2SA.20.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 20:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.19",
            "verseOrgIds": [
              "2SA.20.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 20:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yowabu ŵajanjile kuti, “Iyayi, une ngangusosa kose konanga msinda awuno. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.20",
            "verseOrgIds": [
              "2SA.20.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 20:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yitukusosa ngaŵa yele. Nambo mundu jwine jwa cilambo ca ku matumbi ga Efelemu, lina lwakwe Sheba mwanace jwa Bikili, ŵajimucile Mwenye Daudi. Mumpelece jwele pejo ni msindawu tinawulece.” Jwamkongwe jula ŵamsalile Yowabu kuti, “Titwaponyele mtwe ŵakwe mwinani mwa lipupamu.” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.21",
            "verseOrgIds": [
              "2SA.20.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 20:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaneko jwamkongwe jwalundajo jwapite kwa ŵandu, ni ŵasimbile nganijo. Mwamti ŵanduwo ŵakatile mtwe wa Sheba, mwanace jwa Bikili ni ŵaponyele Yowabu. Pelepo Yowabu ŵagombile lipenga, ni ŵa ngondo ŵakwe ŵatyosile mu msindamo, jwalijose ulendo kumangwakwe, Yowabu ni ŵawujilile ku Yelusalemu kwa mwenye.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.22",
            "verseOrgIds": [
              "2SA.20.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nduna sya Daudi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
