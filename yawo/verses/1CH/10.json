          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "m'malo mwakuŵenda kwa AMBUJE. Myoyo AMBUJE ŵamwuleje Saulo ni kupeleka ucimwenewo kwa Daudi",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.14",
            "verseOrgIds": [
              "1CH.10.14"
            ]
          }
        },
        {
          "text": " mwanace jwa Yese.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.14",
