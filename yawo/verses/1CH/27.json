          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenye Daudi nganiŵaŵalanjila kumo ŵandu ŵamkanakwanila yaka 20 yakupagwa, ligongo lya cilanga",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.23",
            "verseOrgIds": [
              "1CH.27.23"
            ]
          }
        },
        {
          "text": " ciŵatesile kala AMBUJE",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.23",
            "verseOrgIds": [
              "1CH.27.23"
            ]
          }
        },
        {
          "text": " cakuti Aisalaeli tacitupa mpela ndondwa sya kwinani.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.23",
            "verseOrgIds": [
              "1CH.27.23"
            ]
          }
