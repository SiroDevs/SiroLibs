              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awu uli mndandanda ŵa acimlongola ŵa maŵasa ga Aisalaeli, ŵakulamulila ŵa ngondo, pampepe ni nduna syakumtumicila mwenye. Jemanjaji ŵacenganaga mwesi ni mwesi, caka cilicose. Likuga lililyose lyakwete ŵandu ŵakwanila 24,000.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.1",
            "verseOrgIds": [
              "1CH.27.1"
            ]
          }
        }
      ]
    },
