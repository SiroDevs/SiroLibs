          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sakaliya mwanace jwa Meshelemiya ŵaliji jumo jwa ŵakulondela ku Nyumba ja AMBUJE.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.21",
