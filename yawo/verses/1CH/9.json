    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ŵandu ŵaŵawusile kutyocela ku ukapolo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵandu wosope ŵa ku cilambo ca Isalaeli ŵalembedwe mena gawo, malinga ni maŵasa gawo nipo ngani syawo silembedwe mu Buku ja Ayimwene ŵa ku Isalaeli.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.1",
            "verseOrgIds": [
              "1CH.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵandu ŵa ku cilambo ca Yuda ŵajigalidwe ukapolo kwawula ku Babiloni",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.1",
            "verseOrgIds": [
              "1CH.9.1"
            ]
          }
        },
        {
          "text": " ligongo lya ulemwa",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.1",
            "verseOrgIds": [
              "1CH.9.1"
            ]
          }
        },
        {
          "text": " wawo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.1",
            "verseOrgIds": [
              "1CH.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵandu ŵaŵatandite kuwujila ku misinda ja kumangwawo ŵaliji ŵandu wamba, kaneko ŵambopesi, Alefi ni ŵakutumicila ku Nyumba ja AMBUJE.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.2",
            "verseOrgIds": [
              "1CH.9.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZR.2.27"
              },
              "items": [
                {
                  "text": "Esa 2:27",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.7.73"
              },
              "items": [
                {
                  "text": "Neh 7:73",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.2",
            "verseOrgIds": [
              "1CH.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵandu ŵakutyocela ku ngosyo sya Yuda, Benjamini, Efelemu ni Manase ŵajile kutama ku Yelusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.3",
            "verseOrgIds": [
              "1CH.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.3",
            "verseOrgIds": [
              "1CH.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gapali maŵasa gakwana 690 ga lukosyo lwa Yuda gigatamaga ku Yelusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.4+1CH.9.5+1CH.9.6",
            "verseOrgIds": [
              "1CH.9.4",
              "1CH.9.5",
              "1CH.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wosopeŵa ŵaliji yisukulu ya Yuda yakupagwa kwa ŵanace ŵawo ŵatatu ŵala Pelesi, Shela ni Sela. Acimlongola ŵawo ŵaliji Utayi, Asayiya ni Yeuweli. Utayi ŵaliji mwanace jwa Amihudi soni cisukulu ca Omuli, Imuli, Bani ni Pelesi. Asayiya ŵaliji mwanace jwa Sela nipo Yeuweli ŵaliji mwanace jwa Sela.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.4+1CH.9.5+1CH.9.6",
            "verseOrgIds": [
              "1CH.9.4",
              "1CH.9.5",
              "1CH.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.4+1CH.9.5+1CH.9.6",
            "verseOrgIds": [
              "1CH.9.4",
              "1CH.9.5",
              "1CH.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵapali soni acimlongola ŵa maŵasa ŵakwanila 956 ŵakutyocela ku lukosyo lwa Benjamini ŵaŵatamaga mu msinda wa Yelusalemu. Ŵandu ŵakuyicisyaŵa, ŵa lukosyo lwa Benjamini ŵatamaga mu msinda wa Yelusalemu: Salu mwanace jwa Meshulamu, ŵaliji mwanace jwa Hodafiya, cisukulu ca Hasenuwa; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.7",
            "verseOrgIds": [
              "1CH.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibiniya mwanace jwa Yelohamu, Ela mwanace jwa Usi, cisukulu ca Mikili, Meshulamu mwanace jwa Shefatiya, ŵaliji mwanace jwa Leuwele cisukulu ca Ibineya.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.8",
            "verseOrgIds": [
              "1CH.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.8",
            "verseOrgIds": [
              "1CH.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gapali maŵasa 956 ga lukosyo lwelelu lulwatamaga ku Yelusalemu. Ŵandu wosope ŵele mena gawo galembedwe ŵaliji acimlongola ŵa maŵasa.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.9",
            "verseOrgIds": [
              "1CH.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ŵakutaga mbopesi ŵaŵatamaga mu Yelusalemu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.9",
            "verseOrgIds": [
              "1CH.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵakutaga mbopesi ŵakuyicisyaŵa ŵatamaga mu Yelusalemu: Yedaya, Yehoiyalibu, Yakini. Asaliya mwanace jwa Hilikiya, jwaliji jwamkulungwa jwakulolela Nyumba ja AMBUJE, acinangolo ŵakwe ŵaliji Meshulamu, Sadoki, Melayoti ni Ahitubi. Adayiya mwanace jwa Yelohamu, acinangolo ŵakwe ŵaliji Pasha ni Malikiya. Maasayi mwanace jwa Adiyele, acinangolo ŵakwe ŵaliji Yasele, Meshulamu, Meshilemiti ni Imeli.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.10+1CH.9.11+1CH.9.12",
            "verseOrgIds": [
              "1CH.9.10",
              "1CH.9.11",
              "1CH.9.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.10+1CH.9.11+1CH.9.12",
            "verseOrgIds": [
              "1CH.9.10",
              "1CH.9.11",
              "1CH.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵakutaga mbopesi ŵele ŵaliji acimlongola ŵa maŵasa ŵakwanile 1,760. Jemanjaji ŵaliji ŵakumanyilila kukamula masengo cenene m'Nyumba ja AMBUJE.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.13",
            "verseOrgIds": [
              "1CH.9.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Alefi ŵaŵatamaga mu Yelusalemu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
