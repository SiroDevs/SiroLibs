              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.6+1CH.8.7",
            "verseOrgIds": [
              "1CH.8.6",
              "1CH.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shahalayimu ŵalesile acakongwe ŵawo ŵaŵili ŵala, Hushimu ni Baala. Kaneko piŵajile kutama ku Mowabu, ŵalombile Hodeshi nipo ŵakwete ŵanace msano ni jumo, mena gawo galiji Yobabu, Sibiya, Mesha, Malikamu, Yeusi, Sakiya ni Milima. Ŵanace ŵawo wosope ŵaliji acimlongola ŵa maŵasa.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.8+1CH.8.9+1CH.8.10",
            "verseOrgIds": [
              "1CH.8.8",
              "1CH.8.9",
              "1CH.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
