          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Beliya ni Shema ŵaliji acimlongola ŵa maŵasa gagatamaga mu msinda wa Aiyaloni. Jemanjaji ŵatopwesye ŵandu ŵaŵatamaga mu msinda wa Gati. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.13",
            "verseOrgIds": [
              "1CH.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
