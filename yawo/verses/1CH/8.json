          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵanace ŵa Ulamu ŵaliji asilikali ŵamacili, ŵakupakombola kuputa ngondo ni mawukunje. Ŵakwete ŵanace ŵacalume ni yisukulu 150. Wosopeŵa ŵaliji ŵa lukosyo lwa Benjamini.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.40",
            "verseOrgIds": [
              "1CH.8.40"
            ]
          }
        }
