          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asele ŵakwete ŵanace msano ni jumo, mena gawo galiji Asilikamu, Bokelu, Ishimaeli, Sheyaliya, Obadiya ni Hanani. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.38",
            "verseOrgIds": [
              "1CH.8.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1CH 8:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asele alongo ajawo ŵa Esheki ŵakwete ŵanace ŵatatu, mena gawo galiji Ulamu, Yeushi ni Elifeleti.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.39",
            "verseOrgIds": [
              "1CH.8.39"
            ]
          }
        }
      ]
