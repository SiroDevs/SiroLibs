          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵanace ŵa Ehudi ŵaliji Namani, Ahiya ni Gela. Jemanjaji ŵaliji acinangolo ŵa maŵasa gele gatamaga mu msinda wa Geba, nambo kaneko ŵatyosisye mcilamboco ni ŵapite kutama mu msinda ŵa Manahati. Gela babagwe Usa ni Ahihudi ŵalongolele jemanjajo pa ulendo uŵatyokagawo.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.6+1CH.8.7",
            "verseOrgIds": [
              "1CH.8.6",
              "1CH.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
