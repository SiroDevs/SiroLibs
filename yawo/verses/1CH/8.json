            "sid": "1CH 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elipali ŵakwete ŵanace ŵatatu mena gawo galiji Eba, Mishamu ni Shemedi. Shemedi ŵaŵataŵile misinda ja Ono ni Lodi pampepe ni misi jakusyungulila misijo.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.12",
            "verseOrgIds": [
              "1CH.8.12"
            ]
          }
        }
