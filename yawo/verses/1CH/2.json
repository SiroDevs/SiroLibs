        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yelamele mwanace jwamkulungwa jwa Hesiloni ŵakwete ŵanace msano. Lamu ŵaliji jwandanda kupagwa, kaneko Buna, Oleni, Osemu ni Ahiya. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.25",
            "verseOrgIds": [
              "1CH.2.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CH 2:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yelamele ŵakwete jwamkongwe jwine lina lyakwe Atala juŵaŵelece najo mwanace lina lyakwe Onamu. Lamu ŵakwete ŵanace ŵatatu nipo mena gawo galiji Maasi, Yamini ni Ekeli. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.26+1CH.2.27",
            "verseOrgIds": [
              "1CH.2.26",
              "1CH.2.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 2:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onamu ŵakwete ŵanace ŵaŵili, mena gawo galiji Shamayi ni Yada, soni Shamayi ŵakwete ŵanace ŵaŵili, mena gawo galiji Nadabu ni Abishuli.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.28",
            "verseOrgIds": [
              "1CH.2.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 2:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.28",
            "verseOrgIds": [
              "1CH.2.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CH 2:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abishuli ŵalombele ŵakongwe ŵakolanjidwaga lina lyakuti Abihayilo nipo ŵakwete ŵanace ŵaŵili mena, gawo galiji Ahibani ni Molidi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.29",
            "verseOrgIds": [
              "1CH.2.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CH 2:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abishuli mlongo mjakwe jwa Nadabu ŵakwete ŵanace ŵaŵili mena gawo galiji Seledi ni Apayimu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.30",
            "verseOrgIds": [
              "1CH.2.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CH 2:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanace jwa Apayimu ŵaliji Ishi, juŵaliji babagwe Sheshani, nipo Sheshani ŵaliji babagwe Ahilayi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.31",
            "verseOrgIds": [
              "1CH.2.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CH 2:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.31",
            "verseOrgIds": [
              "1CH.2.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1CH 2:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yada mlongo mjakwe jwa Shamayi ŵakwete ŵanace ŵaŵili mena gawo galiji Yetelo ni Yonatani, nambo Yetele ŵawile mkanaŵelece. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.32",
            "verseOrgIds": [
              "1CH.2.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1CH 2:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yonatani ŵakwete ŵanace ŵaŵili mena gawo galiji Peleti ni Sasa. Ŵanace ŵeleŵa ŵaliji yisukulu ya Yelamele.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.33",
            "verseOrgIds": [
              "1CH.2.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1CH 2:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.33",
            "verseOrgIds": [
              "1CH.2.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1CH 2:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sheshani nganakola ŵanace ŵacalume nambo ŵacakongwepe. Myoyo ŵamkundile mwanace jumo jwamkongwe kuti alombedwe ni Yala, jwamasengo jwakwe jwa ku Iguputo. Myoyo ŵakwete mwanace, lina lyakwe Atayi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.34+1CH.2.35",
            "verseOrgIds": [
              "1CH.2.34",
              "1CH.2.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1CH 2:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aga gali mena ga ŵandu ŵa mwiŵasa kutandilila pa Atayi mpaka pa Elishama: Atayi ŵaliji babagwe Natani, nipo Sabadi ŵaliji cisukulu ca Atayi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.36",
            "verseOrgIds": [
              "1CH.2.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1CH 2:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sabadi ŵaliji babagwe Efilali nipo Efilali ŵaliji babagwe Obedi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.37",
            "verseOrgIds": [
              "1CH.2.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1CH 2:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obedi ŵaliji babagwe Yehu, nipo Asaliya ŵaliji cisukulu ca Obedi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.38",
            "verseOrgIds": [
              "1CH.2.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1CH 2:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asaliya ŵaliji babagwe Helesi, nipo Eliyasa ŵaliji cisukulu ca Asaliya. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.39",
            "verseOrgIds": [
              "1CH.2.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1CH 2:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eliyasi ŵaliji babagwe Sisimayi nipo Shalumu ŵaliji cisukulu ca Eliyasa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.40",
            "verseOrgIds": [
              "1CH.2.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1CH 2:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shalumu ŵaliji babagwe Yekamiya, nipo Elishama ŵaliji cisukulu ca Shalumu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.41",
            "verseOrgIds": [
              "1CH.2.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yisukulu yine ya Kalebu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1CH 2:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.41",
            "verseOrgIds": [
              "1CH.2.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1CH 2:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanace jwamlume jwa Kalebu juŵaliji mpwakwe Yelamele jwaliji Mesha. Sifi ŵaliji mwanace jwa Mesha, nipo Malesha ŵaliji babagwe Hebuloni. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.42",
            "verseOrgIds": [
              "1CH.2.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "1CH 2:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hebuloni ŵakwete ŵanace mcece, mena gawo galiji Kola, Tapuwa, Lekemu ni Shema. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.43",
            "verseOrgIds": [
              "1CH.2.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "1CH 2:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lahamu ŵaliji mwanace jwa Shema nipo Yokeyamu ŵaliji cisukulu ca Shema. Shamayi ŵaliji mwanace jwa Lekemu mkulugwe jwa Shema. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.44",
            "verseOrgIds": [
              "1CH.2.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "1CH 2:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanace jwa Shamayi ŵaliji Maoni, nipo Beti Suli ŵaliji cisukulu ca Shamayi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.45",
            "verseOrgIds": [
              "1CH.2.45"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "1CH 2:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.45",
            "verseOrgIds": [
              "1CH.2.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "1CH 2:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kalebu ŵakwete jwamkongwe jwamasengo lina lyakwe Efa nipo ŵaŵelece najo ŵanace ŵatatu mena gawo galiji, Halani, Mosa ni Gasesi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.46",
            "verseOrgIds": [
              "1CH.2.46"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "1CH 2:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.46",
            "verseOrgIds": [
              "1CH.2.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "1CH 2:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵanace ŵa Yadayi ŵaliji, Legemu, Yotamu, Geshani, Peleti, Efa ni Shafi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.47",
            "verseOrgIds": [
              "1CH.2.47"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "1CH 2:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.47",
            "verseOrgIds": [
              "1CH.2.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "1CH 2:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kalebu ŵakwete jwamkongwe jwine jwamasengo, lina lyakwe Maaka nipo ŵamŵelecele ŵanace ŵaŵili, mena gawo galiji Shebala ni Tilihana. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.48",
            "verseOrgIds": [
              "1CH.2.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "1CH 2:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaneko Maaka ŵakwete ŵanace ŵaŵili, mena gawo Shafi, juŵataŵile misinda ja Madimana, ni Shefa ŵaŵataŵile misinda ja Makibena ni Gibeya. Kupwatika pelepa Kalebu ŵakwete mwanace jwamkongwe lina lyakwe Akisa.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.49",
            "verseOrgIds": [
              "1CH.2.49"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "1CH 2:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.49",
            "verseOrgIds": [
              "1CH.2.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "1CH 2:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mena gakuyicisyaga galiji ga yisukulu ya Kalebu: Ŵanace ŵa Huli mwanace jwandanda kupagwa jwa Kalebu ni ŵamkwakwe Efulati ŵaliji aŵa: Shobali, juŵataŵile msinda wa Kiliyati Yelimu, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.50",
            "verseOrgIds": [
              "1CH.2.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "1CH 2:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
