            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.5",
            "verseOrgIds": [
              "1CH.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Japali soni ngondo jine ku Gati, kweleko kwaliji kwana mundu jwine jwamlewu, jwakwimbala jwa yala msano ni cimo ku ligasa lililyose, soni ŵakwete yala msano ni cimo ku lusajo lulilose. Mundujo ŵaliji jumo jwa yisukulu ya Lefayimu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.6",
            "verseOrgIds": [
              "1CH.20.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundujo ŵanyosisye Aisalaeli nipo Yonatani mwanace jwa Shimeya mlongo mjakwe jwa Daudi, ŵamwuleje mundujo.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.7",
            "verseOrgIds": [
              "1CH.20.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.7",
            "verseOrgIds": [
              "1CH.20.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi pampepe ni asilikali ŵakwe ŵa ngondo ŵawuleje ŵandu ŵatatuŵa ŵa ku Gati, ŵele ŵaŵaliji yisukulu ya Lefayimu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.8",
            "verseOrgIds": [
              "1CH.20.8"
            ]
          }
        }
      ]
    }
