          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myoyo Daudi",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.1",
            "verseOrgIds": [
              "1CH.22.1"
            ]
          }
        },
        {
          "text": " ŵatite, “Apano ni pitacitaŵila Nyumba ja AMBUJE",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.1",
            "verseOrgIds": [
              "1CH.22.1"
            ]
          }
        },
        {
          "text": " nambo soni apano tigaciŵa malo gakupelecela mbopesi syakutinisya syele Aisalaeli tacipelekaga.”",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.1",
            "verseOrgIds": [
              "1CH.22.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Daudi akuliŵicila cile kutaŵa Nyumba ja AMBUJE",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 22:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.1",
            "verseOrgIds": [
              "1CH.22.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenye Daudi ŵalamwile kuti ŵasonganye ŵandu wosope ŵa cilendo ŵele ŵaŵaliji mcilambo ca Isalaeli. Ŵasagwile ŵandu ŵane ŵakuti asepe maganga gakutaŵila Nyumba ja AMBUJE. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.2",
            "verseOrgIds": [
              "1CH.22.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi ŵapelece yisyano yejinji yakupanganyicisya misomali jakukomela matanga ni yisyano yakutaŵila matanga ga matabwa, nambo soni ŵapelece bulonsi jwamjinji jwakuti pangali mundu jwa kakombwele ku mpima. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.3",
            "verseOrgIds": [
              "1CH.22.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵapelece soni matabwa gamajinji ga yitela ya mkungusa, ligongo ŵandu ŵa ku Sidoni ni ku Taya ŵayice nayo yitela yejinji ya mikungusa kwa Daudi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.4",
            "verseOrgIds": [
              "1CH.22.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi ŵatite kuti, “Mwanangu Solomoni nganakule, soni ngakumanyilila cilicose. Nyumba jele jitacitaŵa tijiciŵa jakusalala, ni jakupikanika pa cilambo cosope, ni soni ŵandu wosope akwenela kujitendela ulemu. Ali ni ligongo lyakwe une ngwenela kusosa cilepe yida yakutaŵila nyumbaji.” Myoyo Daudi ŵapatile cilepe yida yejinji mkanawe.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.5",
            "verseOrgIds": [
              "1CH.22.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.5",
            "verseOrgIds": [
              "1CH.22.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵamŵilasile Solomoni mwanace jwakwe jwamlume, ni ŵamsalile kuti ŵataŵile nyumba AMBUJE, Mlungu jwa Aisalaeli. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.6",
            "verseOrgIds": [
              "1CH.22.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi ŵamsalile Solomoni kuti, “Mwanangu, nasakaga kutaŵa Nyumba ja AMBUJE ni ligongo lyakusaka kwacimbicisya AMBUJE Mlungu jwangu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.7",
            "verseOrgIds": [
              "1CH.22.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.7.1+2SA.7.2+2SA.7.3+2SA.7.4+2SA.7.5+2SA.7.6+2SA.7.7+2SA.7.8+2SA.7.9+2SA.7.10+2SA.7.11+2SA.7.12+2SA.7.13+2SA.7.14+2SA.7.15+2SA.7.16"
              },
              "items": [
                {
                  "text": "2 Sam 7:1-16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.17.1+1CH.17.2+1CH.17.3+1CH.17.4+1CH.17.5+1CH.17.6+1CH.17.7+1CH.17.8+1CH.17.9+1CH.17.10+1CH.17.11+1CH.17.12+1CH.17.13+1CH.17.14"
              },
              "items": [
                {
                  "text": "1 Mbi 17:1-14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.7",
            "verseOrgIds": [
              "1CH.22.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo AMBUJE ŵasalile kuti, M'mwejo mwawuleje ŵandu ŵajinji nambo soni mwaputile ngondo syejinji. Ligongo lya yindu yeleyi, m'mwejo nganimŵa ŵakuti mundaŵile une nyumba. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.8",
            "verseOrgIds": [
              "1CH.22.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "‘Timcikola mwanace jwamlume jwele tacilamulila ŵandu mwa mtendele, ligongo une tinjimpa mtendele sikati ja amagongo ŵakwe wosope. Lina lyakwe tiliciŵa Solomoni, ligongo kupitila mu ndaŵi jitacilamulilaga tinjipeleka bata ni mtendele ku cilambo ca Isalaeli. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.9",
            "verseOrgIds": [
              "1CH.22.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵelewo tacindaŵila une nyumba jakutamamo. Ŵelewo taciŵa mwanangu, nipo une tinjiŵa babagwe. Ucimwene wakwe tiwucilamulila cilambo ca Isalaeli mpaka ku ndaŵi syangamala.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.10",
            "verseOrgIds": [
              "1CH.22.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.10",
            "verseOrgIds": [
              "1CH.22.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi ŵapitilisye kuŵeceta kuti, “Sambano mwanangu, AMBUJE Mlungu jwenu aŵe namwe, nipo jwalakwe asunje cilanga",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.11",
            "verseOrgIds": [
              "1CH.22.11"
            ]
          }
        },
        {
          "text": " cakwe kuti timpakombole kwataŵila AMBUJE nyumba. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.11",
            "verseOrgIds": [
              "1CH.22.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Soni AMBUJE ampe m'mwejo lunda ni umanyilisi kuti timŵe ŵakupakombola kulolela cilambo ca Isalaeli ni kusunga Malamusi ga AMBUJE, Mlungu jwenu ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.12",
            "verseOrgIds": [
              "1CH.22.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naga mkugapikanila malamusi gosope gele AMBUJE ŵamlamwile Mose",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.13",
            "verseOrgIds": [
              "1CH.22.13"
            ]
          }
        },
        {
          "text": " kuti ŵasalile Aisalaeli yindu tiyicimjendela cenene. Mŵe ŵamacili, ŵakulimba mtima, mkatendaga woga.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.13",
            "verseOrgIds": [
              "1CH.22.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.1.6+JOS.1.7+JOS.1.8+JOS.1.9"
              },
              "items": [
                {
                  "text": "Yos 1:6-9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.13",
            "verseOrgIds": [
              "1CH.22.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwakulajilila mbelece ku Nyumba ja AMBUJE matani 3,400 ga golidi,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.14",
            "verseOrgIds": [
              "1CH.22.14"
            ]
          }
        },
        {
          "text": " matani 34,000 ga silifa,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.14",
            "verseOrgIds": [
              "1CH.22.14"
            ]
          }
        },
        {
          "text": " bulonsi ni yisyano yangamanyika usito wakwe, pakuŵa yatupile mnope, kuti yikamule masengo pakutaŵa Nyumba ja AMBUJE. Konjecesya pa yeleyi mbelece soni matabwa ni maganga, nambo mkwenela konjecesya pa yeleyi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.14",
            "verseOrgIds": [
              "1CH.22.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkwete ŵamasengo ŵajinji. Pana acalume ŵatakamule masengo gakusepa maganga, makalipentala ni ŵakutaŵa majumba, ni ŵandu ŵane ŵakulekanganalekangana ŵakumanyilila kukamulisya masengo ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.15",
            "verseOrgIds": [
              "1CH.22.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "golidi, silifa ni yisyano. Sambano mtande masengo, nipo AMBUJE aŵe namwe.”",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.16",
            "verseOrgIds": [
              "1CH.22.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.16",
            "verseOrgIds": [
              "1CH.22.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 22:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi ŵalamwile acimlongola wosope ŵa ku Isalaeli kuti akamusyane kukamula masengo ni Solomoni, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.17",
            "verseOrgIds": [
              "1CH.22.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 22:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "ŵatite, “AMBUJE Mlungu jwenu ali ni jemanja nipo ampele mtendele pa cilambo cosope. Ŵangundile une kuti napunde pa ngondo ŵandu wosope ŵaŵatamaga mcilambo acino, nipo sambano ŵandu wosopeŵa ali pasi pa jemanja ni pasi pa AMBUJE. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.18",
            "verseOrgIds": [
              "1CH.22.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 22:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sambano mwatumicile AMBUJE Mlungu jwenu ni mtima wenu wosope ni umi wenu wosope. Mtandeje kutaŵa Nyumba ja AMBUJE, kuti mŵicemo Libokosi lya Cilanga ca AMBUJE ni yida yesope yakusosekwa kukamulisya masengo pakwalambila AMBUJE.”",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.19",
            "verseOrgIds": [
              "1CH.22.19"
            ]
          }
        }
      ]
    }
