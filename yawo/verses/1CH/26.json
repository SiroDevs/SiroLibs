                {
                  "text": "2 Sam 6:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.13.14"
              },
              "items": [
                {
                  "text": "1 Mbi 13:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.4",
            "verseOrgIds": [
              "1CH.26.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 26:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amiyele, Isakala ni Puletayi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.5",
            "verseOrgIds": [
              "1CH.26.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 26:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.5",
            "verseOrgIds": [
              "1CH.26.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 26:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanace jwamlume jwa Obedi Edomu ŵaliji Shemaya ŵele ŵaŵakwete ŵanace msano ŵacalume mena gawo galiji Otini, Lefayele, Obedi, Elisabadi, Elihu ni Semakaya. Wosopeŵa ŵaliji acimlongola ŵakupikanika.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.6+1CH.26.7",
            "verseOrgIds": [
              "1CH.26.6",
              "1CH.26.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 26:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.6+1CH.26.7",
            "verseOrgIds": [
              "1CH.26.6",
              "1CH.26.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 26:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutyocela ku liŵasa lya Obedi Edomu, ŵasagwile ŵandu 62, wosopeŵa ŵaliji ŵakumanyilila masengo.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.8",
            "verseOrgIds": [
              "1CH.26.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 26:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.8",
            "verseOrgIds": [
              "1CH.26.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 26:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutyocela ku liŵasa lya Meshelemiya, ŵasagwile ŵandu 18 ŵakumanyilila masengo.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.9",
            "verseOrgIds": [
              "1CH.26.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 26:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.9",
            "verseOrgIds": [
              "1CH.26.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 26:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutyocela ku liŵasa lya Melali, ŵamsagwile Hosa jwele juŵakwete ŵanace mcece aŵa: Simili (mwanace jweleju nganaŵa jwandanda kupagwa atamose kuti ŵasagulidwe kuti aŵe mlongola), ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.10",
            "verseOrgIds": [
              "1CH.26.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwaŵili ŵaliji Hilikiya, jwatatu ŵaliji Tebaliya nipo jwamcece waliji Sakaliya. Ŵapali ŵandu 13 mwiŵasa lya Hosa ŵele ŵaŵaliji alonda ŵa ku Nyumba ja AMBUJE.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.11",
            "verseOrgIds": [
              "1CH.26.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.11",
            "verseOrgIds": [
              "1CH.26.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 26:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alonda ŵa ku Nyumba ja AMBUJE ŵaŵisile m'makuga pakukuya maŵasa gawo, ŵapele soni masengo gawo gakutumicila mpela muŵatendele acalongo acimjawo ŵane ŵa ci Lefi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.12",
            "verseOrgIds": [
              "1CH.26.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 26:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵalondwele cisango pasikati pa maŵasa gosope ga mwana ni gekulungwa ni cakulinga cakuti asimane ŵandu ŵatakaŵe acilonda pa yipata ya ku Nyumba ja AMBUJE. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.13",
            "verseOrgIds": [
              "1CH.26.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 26:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shelemiya ŵasagulidwe kuti alondeleje cipata ca kungopoko lyuŵa. Sakaliya mwanace jwakwe jwamlume juŵaliji namkwingwi jwalunda lwambone ŵasagulidwe kuti alondeleje cipata ca kumpoto. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.14",
            "verseOrgIds": [
              "1CH.26.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 26:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obedi Edomu ŵasagulidwe kuti alondeleje cipata ca kum'mwela nipo ŵanace ŵakwe ŵacalume ŵasagulidwe kuti alondeleje nyumba jakusunjila katundu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.15",
            "verseOrgIds": [
              "1CH.26.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 26:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shupimu ni Hosa ŵasagulidwe kuti alondeleje cipata ca kungapilo lyuŵa ni Cipata ca Shaleketi pa msewu wakwela kungapilo lyuŵa. Masengo ga alonda gaŵaga gakucenganacengana. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.16",
            "verseOrgIds": [
              "1CH.26.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 26:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku cipata ca kungopoko lyuŵa kwaŵaga alonda msano ni jumo lyuŵa lililyose. Ku cipata ca kumpoto kwaŵaga alonda mcece lyuŵa lililyose, nipo cipata ca kum'mwela kwaŵaga alonda mcece lyuŵa lililyose ni alonda ŵaŵili ŵaŵili ku nyumba jakusunjila katundu, ŵaŵili mcipinda cilicose. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.17",
            "verseOrgIds": [
              "1CH.26.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 26:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku luŵala lwa kungapilo lyuŵa ŵapali alonda mcece, ni alonda ŵaŵili ku msewu, nipo alonda ŵane ŵaŵili ku luŵala lusyesyenelo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.18",
            "verseOrgIds": [
              "1CH.26.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 26:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jemanjaji ni ŵaŵaliji mu likuga lya alonda ŵa pa yipata, ŵakutyocela ku maŵasa ga Kola ni Melali.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.19",
            "verseOrgIds": [
              "1CH.26.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Masengo gane ga ku Nyumba ja AMBUJE",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 26:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.19",
            "verseOrgIds": [
              "1CH.26.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 26:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwa Alefi ŵane, Ahiya ŵaliji ŵakulolela cipanje ca ku Nyumba ja AMBUJE, ni yipinda yakusunjila yindu yakupelecedwa kwa Mlungu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.20",
            "verseOrgIds": [
              "1CH.26.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 26:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ladani, jumo jwa ŵanace ŵa Geleshoni, ŵakwete ŵanace ŵakwe ŵacalume ŵa ŵaŵaga acimlongola ŵa maŵasa, mnope liŵasa lya Yehiyele. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.21",
            "verseOrgIds": [
              "1CH.26.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 26:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Setamu ni Yoweli ŵaliji ŵanace ŵa Ladani ŵele ŵaŵaliji ŵakulolela yipanje ya ku Nyumba ja AMBUJE. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.22",
            "verseOrgIds": [
              "1CH.26.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 26:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alonda ŵane ŵa ku malo kwakusunjila yipanje ŵaliji ŵa m'maŵasa ga Amulamu, Isala, Hebuloni ni Usiyele.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.23",
            "verseOrgIds": [
              "1CH.26.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 26:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.23",
            "verseOrgIds": [
              "1CH.26.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 26:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shebuyele mwanace Geleshomu ŵa liŵasa lya Mose",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.24",
            "verseOrgIds": [
              "1CH.26.24"
            ]
          }
        },
        {
          "text": " ŵaliji jwamkulungwa jwakulolela yipanje ya ku Nyumba ja AMBUJE. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.24",
            "verseOrgIds": [
              "1CH.26.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 26:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Acalongo acimjakwe ŵa Geleshomu ŵakupagwa kwa Eliyesa ŵaliji Lehabiya ŵele ŵaŵaliji babagwe Yeshaya, Yolamu, Sikili nipo soni Shelomiti. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.25",
            "verseOrgIds": [
              "1CH.26.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CH 26:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shelomiti ni acalongo acimjakwe ŵaliji ŵakusunga mituka jeswela jele Mwenye Daudi",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.26",
            "verseOrgIds": [
              "1CH.26.26"
            ]
          }
        },
        {
          "text": " ŵajipelece kwa Mlungu, pamo ni acimlongola ŵa maŵasa ni acimlongola ŵa makuga ga ngondo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.26",
            "verseOrgIds": [
              "1CH.26.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 26:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵajigele yine mwa yindu yiŵasumwile ku ngondo ni kuyipeleka kwa AMBUJE kuti yikamule masengo m'Nyumba ja AMBUJE. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.27",
            "verseOrgIds": [
              "1CH.26.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 26:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shelomiti pampepe ni acalongo acimjakwe, ŵaliji ŵakusamalila mituka josope jijapelecedwe kuti jikamule masengo m'Nyumba ja AMBUJE, kupwatikapo soni mituka jiŵayice najo ŵakulocesya aŵa: Samuele, Mwenye Saulo, Abinele mwanace jwa Nele, ni Yowabu mwanace jwa Seluya.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.28",
            "verseOrgIds": [
              "1CH.26.28"
            ]
          }
        }
      ]
    },
