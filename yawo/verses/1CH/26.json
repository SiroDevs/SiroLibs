          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwa yisukulu ya Isala, Kenaniya ni ŵanace ŵakwe ŵacalume ŵasagulidwe kuti akamuleje masengo ga kulolela yindu, mpela gakulembela ni soni kulamula magambo.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.29",
            "verseOrgIds": [
              "1CH.26.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
