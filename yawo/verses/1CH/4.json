          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.12",
            "verseOrgIds": [
              "1CH.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenasi ŵakwete ŵanace ŵaŵili ŵacalume, nipo mena gawo galiji Otiniyele ni Selaya. Nombe najo Otiniyele ŵakwete ŵanace ŵaŵili nipo mena gawo galiji Hatati ni Mewonotayi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.13",
            "verseOrgIds": [
              "1CH.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mewonotayi ŵaliji babagwe Ofula. Selaya ŵaliji babagwe Yowabu, juŵaliji nangolo jwa ŵandu ŵakukolanjidwa Agehalisimu. Ŵanduŵa ŵakolasile lina lyeleli ligongo ŵaliji ŵandu ŵakumanyilila masengo ga yala.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.14",
            "verseOrgIds": [
              "1CH.4.14"
            ]
          }
        }
      ]
    },
    {
