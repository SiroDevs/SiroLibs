              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kalebu mwanace jwa Yefune ŵakwete ŵanace ŵatatu nipo mena gawo galiji Ilu, Ela ni Naamu. Nipo Ela ŵaliji babagwe Kenasi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.15",
            "verseOrgIds": [
