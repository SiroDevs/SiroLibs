          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehalele ŵakwete ŵanace mcece nipo mena gawo galiji Sifi, Sifa, Tiliya ni Asaleli.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.16",
