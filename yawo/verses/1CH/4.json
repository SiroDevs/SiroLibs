          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hodiya ŵalombele alumbu ŵawo Nahamu, nipo ŵanagwawo ni ŵiŵamŵelece Keyila jwa lukosyo lwa Galimiti ni Eshitemowa ŵa lukosyo lwa Maakati.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.19",
