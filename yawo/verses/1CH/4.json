          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.33",
            "verseOrgIds": [
              "1CH.4.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1CH 4:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵandu ŵakuyicisyaŵa ŵaliji acimlongola ŵa maŵasa gawo:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.34+1CH.4.35+1CH.4.36+1CH.4.37+1CH.4.38",
            "verseOrgIds": [
              "1CH.4.34",
              "1CH.4.35",
              "1CH.4.36",
              "1CH.4.37",
              "1CH.4.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1CH 4:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵandu ŵakolanjidweŵa ŵaliji acimlongola m'maŵasa gawo, nipo maŵasa ga acinangolo ŵawo gapitilisye kutupa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.34+1CH.4.35+1CH.4.36+1CH.4.37+1CH.4.38",
            "verseOrgIds": [
              "1CH.4.34",
              "1CH.4.35",
              "1CH.4.36",
              "1CH.4.37",
              "1CH.4.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1CH 4:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa ligongo lyeleli ŵapite kusa kwa musi wa Gelali, ca kungapilo lyuŵa kwa ciŵata kusosasosa manyasi gakulicisya yilangwa yawo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.39",
            "verseOrgIds": [
              "1CH.4.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1CH 4:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kweleko ŵacisimene cilambo ca cajila, cakulicisya yilangwa yawo, cilamboco caliji cekulungwa ca bata ni mtendele. Ŵandu ŵaŵatamaga kala kweleko ŵaliji Aahamu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.40",
            "verseOrgIds": [
              "1CH.4.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1CH 4:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.40",
            "verseOrgIds": [
              "1CH.4.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1CH 4:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundaŵi ja Mwenye Hesekiya jwa cilambo ca Yuda, ŵandu ŵalembedwe mena gawoŵa ŵapite ku Gelali nipo ŵajonasile matenti ni masakasa ga ŵandu ŵaŵatamaga kweleko. Ŵakamwile ŵandu ni kwatoposya nipo jemanjajo ŵatamilicice kweleko ligongo gapali manyasi gejinji gakulicisya ngondolo syawo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.41",
            "verseOrgIds": [
              "1CH.4.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1CH 4:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Simiyoni pampepe ni ŵandu ŵane ŵakwanila 500 ŵapite kutama Kwitumbi lya Seyili mwakulongoleledwa ni ŵanace ŵa Ishi, Pelatiya, Neyaliya, Lefayiya ni Usiyele. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.42",
            "verseOrgIds": [
              "1CH.4.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "1CH 4:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kweleko ŵawuleje ŵandu ŵaŵasigele ŵa mtundu wa ci Amaleki, nipo jemanjajo akutama kweleko mpaka lelo jino.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.43",
            "verseOrgIds": [
              "1CH.4.43"
            ]
          }
        }
      ]
    }
