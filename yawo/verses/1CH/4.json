          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵanace ŵa Shela, juŵaliji jumo jwa ŵanace ŵa Yuda, ŵaliji Ele babagwe Leka, Laada babagwe Malesha ni ŵandu ŵa maŵasa ga kupanganya nguwo sya bafuta ku Beti Ashibeya, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.21",
            "verseOrgIds": [
              "1CH.4.21"
            ]
          }
        },
