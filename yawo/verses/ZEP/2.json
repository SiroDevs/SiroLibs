              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jemanja mtundu wangali soni, mwujile ku ndamo syenu ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.1",
            "verseOrgIds": [
              "ZEP.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ZEP 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "mkanimjigalidwe mpela matimba gakuwululuka ni mbungo, soni ukali wakogoya wa AMBUJE mkiniwumyicilile jemanja, mkaniliyice lisiku litacilosya lutumbilo lwakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.2",
            "verseOrgIds": [
              "ZEP.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ZEP 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwasosejesoseje AMBUJE, jemanja ŵakulinandiya, jemanja ŵimkusapikanila malamusi gakwe. Mtendeje yayili yakulungama, ni kulinandiya mwacimsyene pameso pa AMBUJE. Mwine mwakwe timcikulupuka pa lisiku lya lutumbilo lwa AMBUJE.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.3",
            "verseOrgIds": [
              "ZEP.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Conasiko ca yilambo yakuŵandikana ni Isalaeli",
          "type": "text"
        }
      ]
    },
