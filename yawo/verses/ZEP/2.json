            "sid": "ZEP 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "AMBUJE tacajogoya jemanjajo mnope. Tacijonanga milungu josope ja pa cilambo capasi, myoyo mitundu josope tijicalambila AMBUJE, mtundu uliwose ku cilambo cakumangwakwe.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.11",
