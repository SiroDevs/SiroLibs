        },
        {
          "text": "Pangali jwalijose jutacisigala mu msinda wa Gasa, soni Ashikeloni taciŵa masame. Ŵandu ŵa ku Ashidodi tacitopoledwa musi mwacisisimucisya, soni ŵandu ŵa ku Ekiloni tacitopoledwa mu msinda mwawo.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.4",
            "verseOrgIds": [
              "ZEP.2.4"
            ]
          }
        },
