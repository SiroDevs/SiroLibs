            "sid": "HEB 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwamkulungwa jwa ŵakutaga mbopesi",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.1",
            "verseOrgIds": [
              "HEB.5.1"
            ]
          }
        },
        {
          "text": " jwalijose ŵasagulidwaga pasikati pa ŵandu, ni kumŵika kuti ŵajimilileje ŵandu pameso pa Mlungu, kuti apeleceje mituka ni mbopesi ligongo lya ulemwa.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.1",
            "verseOrgIds": [
              "HEB.5.1"
            ]
          }
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.1",
            "verseOrgIds": [
              "HEB.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HEB 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti jwamkulungwa jwa ŵakutaga mbopesi msyene akwete yakulepetala yejinji, ni kuti mpaka akombole kwatendela canasa ŵele ŵakulemwa ligongo lyangamanyilila ni kusokonesya. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.2",
            "verseOrgIds": [
              "HEB.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HEB 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti ali jwakulepetala msyene, akwenela kupeleka mbopesi ligongo lya ulemwa wakwe ni soni ulemwa wa ŵandu ŵane.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.3",
            "verseOrgIds": [
              "HEB.5.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.9.7"
              },
              "items": [
                {
                  "text": "Lef 9:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.3",
            "verseOrgIds": [
              "HEB.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HEB 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pangali mundu jwakulijigalila jika ucimbicimbi wakuŵa jwamkulungwa jwa ŵakutaga mbopesi, nambo akusatenda kuŵilanjidwa ni Mlungu, mpela muŵatendele Aloni",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.4",
            "verseOrgIds": [
              "HEB.5.4"
            ]
          }
        },
        {
          "text": " pakuŵilanjidwa.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.4",
            "verseOrgIds": [
              "HEB.5.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
