          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myoyo soni Klistu",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.5",
            "verseOrgIds": [
              "HEB.5.5"
            ]
          }
        },
        {
          "text": " nganalijigalila jika ucimbicimbi wakuŵa jwamkulungwa jwa ŵakutaga mbopesi. M'malo mwakwe Mlungu ŵatite kwa Jwalakwe,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.5",
            "verseOrgIds": [
              "HEB.5.5"
            ]
          }
        },
        {
