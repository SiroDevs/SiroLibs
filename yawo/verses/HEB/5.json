          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa ndaŵi jiŵaliji pa cilambo capasi cino, Yesu",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.7",
            "verseOrgIds": [
              "HEB.5.7"
            ]
          }
        },
        {
          "text": " ŵaŵendile ni kupopela mwakugumila ni kulila misosi kwa Mlungu jwele juŵajenele kumkulupusya ku ciwa. Pakuti Yesu ŵaliji ŵakulinandiya ni kulipeleka, Mlungu ŵagapikene mapopelo gakwe.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.7",
            "verseOrgIds": [
              "HEB.5.7"
            ]
          }
        },
        {
