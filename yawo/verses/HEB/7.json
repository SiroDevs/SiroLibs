        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.22",
            "verseOrgIds": [
              "HEB.7.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "HEB 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kulekangana kwine ni kwakuti ŵakutaga mbopesi ŵakala ŵala ŵaliji ŵajinji, ligongo ŵaliji mkuwa ni kulepela kupitilisya kamula masengo gawo. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.23",
            "verseOrgIds": [
              "HEB.7.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "HEB 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo Yesu jwangali mbesi, myoyo masengo gakwe gakutaga mbopesi gali gangali mbesi. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.24",
            "verseOrgIds": [
              "HEB.7.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "HEB 7:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni ligongo lyakwe ndaŵi syosope akukombola kwakulupusya ŵandu ŵele ŵakuŵandicila kwa Mlungu kupitila mwa Jwalakwe, pakuti Jwalakwejo akwete umi ndaŵi syosope kuti ŵapopeleleje jemanjajo kwa Mlungu.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.25",
            "verseOrgIds": [
              "HEB.7.25"
            ]
          }
        }
      ]
    },
    {
