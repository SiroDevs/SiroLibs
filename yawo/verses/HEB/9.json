        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HEB 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cipindaci caliji ni malo gakupelecela mbopesi ga golidi",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.4",
            "verseOrgIds": [
              "HEB.9.4"
            ]
          }
        },
        {
          "text": " gakututumicisya ubani",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.4",
            "verseOrgIds": [
              "HEB.9.4"
            ]
          }
        },
        {
          "text": " ni Libokosi lya Cilanga lilyawunicilidwe ni golidi soni mkati mwakwe mwaliji mgawo wa golidi wele mkati mwakwe mwaliji mana, ni simbo ja Aloni",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.4",
            "verseOrgIds": [
              "HEB.9.4"
            ]
          }
        },
        {
          "text": " jele jijasipwice maluŵa. Mwaliji soni maganga gaŵili gigalembedwe maloŵe ga cilanga.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.4",
            "verseOrgIds": [
              "HEB.9.4"
            ]
          }
        },
