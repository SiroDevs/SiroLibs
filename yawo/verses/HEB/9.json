              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nipo pasyeto pa likatani lyaŵili paliji cipinda cakolanjidwa Cipinda Ceswela Mnope.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.3",
            "verseOrgIds": [
              "HEB.9.3"
            ]
