        {
          "text": "Cilanga",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.1",
            "verseOrgIds": [
              "HEB.9.1"
            ]
          }
        },
        {
          "text": " candanda cila cakwete malamusi gakusala ya kulambila ni malo soni gakulambilila gakutaŵidwa ni ŵandu. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.1",
            "verseOrgIds": [
              "HEB.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
