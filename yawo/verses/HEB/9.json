              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.14",
            "verseOrgIds": [
              "HEB.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "HEB 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni ligongo lyakwe Klistu ali namangoswe jwa malangano ga sambano, kuti ŵiŵaŵilasile Mlungu, apocele upile wangamala wele Mlungujo ŵatendele cilanga. Ayi yakombolece ligongo lya ciwa ca Klistu, cele cacikusakulupusya ŵandu ku ulemwa uŵatesile ali Mcilanga candanda cila.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.15",
            "verseOrgIds": [
              "HEB.9.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "HEB 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.15",
            "verseOrgIds": [
              "HEB.9.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "HEB 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naga mundu alembile cilanga cakwalecela ŵane cipanje, pakusosekwa kusimicisya kuti jwakulemba cilangajo awile kwene. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.16",
            "verseOrgIds": [
              "HEB.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "HEB 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paja cilanga cikusaŵa cangali masengo naga mkulemba ali cijumi. Cikusaŵa ca macili naga mkulembajo ali awile. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.17",
            "verseOrgIds": [
              "HEB.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "HEB 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni ligongo lyakwe atamose cilanga candanda cila nganicitendekwa pangasulusya miasi. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.18",
            "verseOrgIds": [
              "HEB.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "HEB 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pandanda, Mose",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.19",
            "verseOrgIds": [
              "HEB.9.19"
            ]
          }
        },
        {
          "text": " ŵasalile ŵandu malamusi gosope, pakuya Malamusi gele giŵampele Mlungu jwalakwe. Panyuma pakwe ŵajigele miasi ja ŵanace ŵa ng'ombe ŵa mikambako ni mbusi ni ŵawanganyisye ni mesi, ni ŵamisile pa buku ja Malamusi ni pa ŵandu wosope. Ŵatesile yeleyi ni liwupulu lina lyakwe hisope,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.19",
            "verseOrgIds": [
              "HEB.9.19"
            ]
          }
        },
        {
          "text": " soni ni manyunya ga ngondolo syecejewu.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.19",
            "verseOrgIds": [
              "HEB.9.19"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.24.6+EXO.24.7+EXO.24.8"
              },
              "items": [
                {
                  "text": "Eks 24:6-8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.19",
            "verseOrgIds": [
              "HEB.9.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "HEB 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndaŵi jiŵatendaga yeleyi ŵatite, “Aji ni miasi jakusimicisya cilanga cele calamwile Mlungu kuti mcisunjeje.” ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.20",
            "verseOrgIds": [
              "HEB.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "HEB 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose soni ŵamisile miasi pa citenti ni pa yida yosope yakamulila masengo pa mapopelo.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.21",
            "verseOrgIds": [
              "HEB.9.21"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.8.15"
              },
              "items": [
                {
                  "text": "Lef 8:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.21",
            "verseOrgIds": [
              "HEB.9.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "HEB 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malinga ni Malamusi yindu yosope yikusaŵa yeswela ni miasi, nipo ulemwa ngawukusakululucikwa naga nganasulusya miasi.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.22",
            "verseOrgIds": [
              "HEB.9.22"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.17.1"
              },
              "items": [
                {
                  "text": "Lef 17:1",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mbopesi ja Klistu jikusatyosya ulemwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "HEB 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.22",
            "verseOrgIds": [
              "HEB.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "HEB 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yindu yeleyo, yiyikulandana ni yindu ya kwinani yisyesyene, yikwenela kuti ayiswejesye mwalitala lyelelyo. Nambo yindu ya kwinani yikusosekwa mbopesi ja mbone mnope. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.23",
            "verseOrgIds": [
              "HEB.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "HEB 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paja Klistu nganajinjila ku Malo Gamaswela gakutaŵidwa ni ŵandu, malo gagamba kulandanicisya Malo gasyesyene Gamaswela ga Kwinani. Jwalakwe ŵapite Kwinani kweneko, kuti akawonecele pameso pa Mlungu ligongo lyetuwe. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.24",
            "verseOrgIds": [
              "HEB.9.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "HEB 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwamkulungwa jwa ŵakutaga mbopesi wosope ŵajinjilaga Cipinda Ceswela caka cilicose ali ajigele miasi ja nyama. Nambo Klistu nganajinjila kwinani kuti akalipeleceje mbopesi kaŵilikaŵili, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.25",
            "verseOrgIds": [
              "HEB.9.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "HEB 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "yikaŵe myoyo ni kuti akajenele kulaga ndaŵi ni katema kutandila ndaŵi jicapanganyidwe cilambo capasi. Nambo mpela muyiŵelemu, awonece kampepe basi kumbesi kwa ndaŵi jakumalisya, kuti atyosye ulemwa pakulipeleka msyene jika mbopesi. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.26",
            "verseOrgIds": [
              "HEB.9.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "HEB 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundu jwalijose akwenela kuwa kampepe basi, panyuma pakwe ni kulamulidwa ni Mlungu. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.27",
            "verseOrgIds": [
              "HEB.9.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "HEB 9:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myoyopeyo Klistu ŵapelecedwe mbopesi kampepe basi, kuti atwicile ni kutyosya ulemwa wa ŵandu ŵajinji. Taciwoneka soni kaŵili, ngaŵa kuti taciyika kutyosya soni ulemwa wetu iyayi, nambo kuti tiŵakulupusye ŵandu ŵele ŵakumjembecela.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.28",
            "verseOrgIds": [
              "HEB.9.28"
            ]
          }
        },
