        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.13",
            "verseOrgIds": [
              "HEB.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HEB 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti yeleyi yili yisyesyene, nambi yeleyi yikombolece uli ni miasi ja Klistu! Mwa Msimu wandaŵi syosope Jwalakwe ŵalipelece mpela mbopesi jangalemala kwa Mlungu. Ni kuti miasi jwakwe tijiciswejesya mitima jetu pakujitocesya masengo gangapindulisya umi, kuti tumtumicileje Mlungu jwa umi.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.14",
            "verseOrgIds": [
              "HEB.9.14"
            ]
          }
        }
      ]
    },
