              },
              "items": [
                {
                  "text": "Yes 35:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.12",
            "verseOrgIds": [
              "HEB.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HEB 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mjendeje m'matala gakongoka, kuti ngongolo syelemale sikagwedemuka, nambo kuti sipole.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.13",
            "verseOrgIds": [
              "HEB.12.13"
            ]
          }
        },
