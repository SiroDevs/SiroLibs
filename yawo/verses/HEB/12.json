          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "ni lisegwe lya lipenga, nipo soni kupikanika kwa maloŵe. Piŵapikene ŵandu maloŵego, ŵaŵendile kuti akagapikana soni maloŵe gane, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.19",
            "verseOrgIds": [
              "HEB.12.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "HEB 12:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "ligongo nganajiticisya lilamusi lila lyakuti, “Atamose cinyama cose naga cigamba kwaya litumbilyo, ciwulajidwe ni maganga.”",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.20",
            "verseOrgIds": [
              "HEB.12.20"
            ]
          }
        },
