          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo jemanja myice Kwitumbi lya Siyoni",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.22",
            "verseOrgIds": [
              "HEB.12.22"
            ]
          }
        },
        {
          "text": " ni msinda wa Mlungu jwacijumi, ku Yelusalemu jwakwinani, mwele mugali malayika",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.22",
            "verseOrgIds": [
              "HEB.12.22"
            ]
          }
        },
        {
          "text": " gangaŵalanjika. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.22",
            "verseOrgIds": [
