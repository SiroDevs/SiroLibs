                "loc": "JOB.5.17"
              },
              "items": [
                {
                  "text": "Yob 5:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.3.11+PRO.3.12"
              },
              "items": [
                {
                  "text": "Mis 3:11-12",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
