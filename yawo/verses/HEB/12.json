            "sid": "HEB 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paja mkumanyilila kuti, panyuma pakwe ŵasacile kupocela upile wa babagwe, nambo yalepelece, ligongo nganakombola kupitikusya yiŵatesile, atamose kuti ŵawusosaga ukulungwa wakwewo misosi jili mbwee ni kulila.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.17",
            "verseOrgIds": [
              "HEB.12.17"
            ]
          }
        },
        {
