          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkalamuce sambano kuti kasimkana kumpikanila jwele jwakuŵeceta namwe. Ŵandu ŵiŵakanile kumpikanila Mose jwele juŵatetele pasi pano, nganakulupuka kose ku cilango. Nambi sambano uwe, tucikulupuka uli naga ngatukumpikanila kose jwakuŵeceta kutyocela kwinani?",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.25",
            "verseOrgIds": [
              "HEB.12.25"
            ]
          }
        },
