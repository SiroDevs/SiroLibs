                "loc": "PSA.95.7+PSA.95.8+PSA.95.9+PSA.95.10+PSA.95.11"
              },
              "items": [
                {
                  "text": "Mas 95:7-11",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HEB 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.3.11",
            "verseOrgIds": [
              "HEB.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HEB 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Acalongo acimjangu, mkalamuce kuti pakapagwa jwine jwalijose jwa jemanja jwa mtima wakusakala ni wangakulupilila wakulekanganya ni Mlungu jwa umi. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.3.12",
            "verseOrgIds": [
              "HEB.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HEB 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo camnopemnope mlimbisyaneje mtima jwine ni mjakwe lisiku lililyose kuti jwine jwa jemanja akusajigalwa ni ulemwa",
          "type": "text",
          "attrs": {
            "verseId": "HEB.3.13",
            "verseOrgIds": [
              "HEB.3.13"
            ]
          }
        },
        {
          "text": " ni kuŵa jwangapikanila Mlungu, mpela mugakuŵecetela maloŵe ga Mlungu kuti “Lelo” myoyo soni malemba gakutusalila uwe. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.3.13",
            "verseOrgIds": [
              "HEB.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HEB 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuŵa uwe tutendekwe kuŵa ŵakwe ŵa Klistu, naga tukukamulisya mnope mpaka pambesi kulimba mtima kwele kutwakwete pandanda kula.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.3.14",
            "verseOrgIds": [
              "HEB.3.14"
            ]
          }
        }
      ]
    },
