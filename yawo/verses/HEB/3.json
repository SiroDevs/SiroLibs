              },
              "items": [
                {
                  "text": "Mas 95:7-8",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "HEB 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.3.15",
            "verseOrgIds": [
              "HEB.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "HEB 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ana ŵandu ŵapi ŵiŵapikene maloŵe ga Mlungu ni kumjimucila? Ŵandu ŵakwe ni ŵele Mose ŵalongolele ni kwakoposya mcilambo ca Iguputo.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.3.16",
            "verseOrgIds": [
              "HEB.3.16"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.14.1+NUM.14.2+NUM.14.3+NUM.14.4+NUM.14.5+NUM.14.6+NUM.14.7+NUM.14.8+NUM.14.9+NUM.14.10+NUM.14.11+NUM.14.12+NUM.14.13+NUM.14.14+NUM.14.15+NUM.14.16+NUM.14.17+NUM.14.18+NUM.14.19+NUM.14.20+NUM.14.21+NUM.14.22+NUM.14.23+NUM.14.24+NUM.14.25+NUM.14.26+NUM.14.27+NUM.14.28+NUM.14.29+NUM.14.30+NUM.14.31+NUM.14.32+NUM.14.33+NUM.14.34+NUM.14.35"
              },
              "items": [
                {
                  "text": "Num 14:1-35",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.3.16",
            "verseOrgIds": [
              "HEB.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "HEB 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambi ŵani ŵele Mlungu ŵiŵatumbilile kwa yaka makumi mcece? Ŵandu ŵakwe ni ŵele ŵiŵalemwisye ŵala, mitembo jawo jijasigalile mcipululu mula. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.3.17",
            "verseOrgIds": [
              "HEB.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "HEB 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ana Mlungu ŵaŵecetaga ya ŵani katema kiŵatite kuti, “Ngulumbila kuti jemanjaji ngasajinjila mcilambo cele cinatiga nape kuti akapumulileje?” Paja ŵaŵecetaga ya ŵandu ŵele ŵiŵamjimucile ŵala. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.3.18",
            "verseOrgIds": [
              "HEB.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "HEB 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myoyo tukuyiwona kuti ŵanduwo ŵalepele kwinjila ligongo lya kungakulupicika kwawo.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.3.19",
            "verseOrgIds": [
              "HEB.3.19"
            ]
          }
        }
      ]
    }
