    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu ali jwamkulungwa kupunda Mose",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HEB 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Acalongo acimjangu, ŵamli ŵaswela mtima ni kuŵilanjidwa ni Mlungu. Mganicisye cenene ya Yesu,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.3.1",
            "verseOrgIds": [
              "HEB.3.1"
            ]
          }
        },
        {
          "text": " juŵamtumisye Mlungu kuŵa jwamkulungwa jwa ŵakutaga mbopesi",
          "type": "text",
          "attrs": {
            "verseId": "HEB.3.1",
            "verseOrgIds": [
              "HEB.3.1"
            ]
          }
        },
        {
          "text": " jwa cikulupi cele citukweteci. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.3.1",
            "verseOrgIds": [
              "HEB.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HEB 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuŵa Jwalakwe ŵaliji jwakulupicika kwa Mlungu, ŵele ŵiŵamsagwile Jwalakwe kuti agatende masengo gelega, mpela muŵaŵelele Mose",
          "type": "text",
          "attrs": {
            "verseId": "HEB.3.2",
            "verseOrgIds": [
              "HEB.3.2"
            ]
          }
        },
        {
          "text": " kuŵa ŵakulupicika ni masengo gakwe m'nyumba ja Mlungu.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.3.2",
            "verseOrgIds": [
              "HEB.3.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.12.7"
              },
              "items": [
                {
                  "text": "Num 12:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.3.2",
            "verseOrgIds": [
              "HEB.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HEB 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundu jwataŵile nyumba akusapocela ucimbicimbi wekulungwa kupunda nyumba jisyenejo. Myoyopeyo Yesu akwenela kupocela lumbili lwakumpunda Mose. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.3.3",
            "verseOrgIds": [
              "HEB.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HEB 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyumba jilijose jikusataŵidwa ni mundu jwamtijwamti, nambo ŵiŵapanganyisye yosope ni Mlungu. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.3.4",
            "verseOrgIds": [
              "HEB.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HEB 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose ŵaliji ŵakulupicika m'nyumba ja Mlungu mpela jwamasengo, kuti atendele umboni yindu yitaciŵeceta Mlungu pasogolo pakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.3.5",
            "verseOrgIds": [
              "HEB.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HEB 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo Klistu",
          "type": "text",
          "attrs": {
            "verseId": "HEB.3.6",
            "verseOrgIds": [
              "HEB.3.6"
            ]
          }
        },
        {
          "text": " ali jwakulupicika mpela mwanace jwakulamulila m'nyumba ja Mlungu. Nyumbajo tuli uweji, naga tukupitilisya kulimba mtima ni kulupilila yele yitukwembecela pasogolo pano.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.3.6",
            "verseOrgIds": [
              "HEB.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ya kupumula kwa ŵandu ŵa Mlungu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HEB 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.3.6",
            "verseOrgIds": [
              "HEB.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HEB 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni ligongo lyakwe sambano jino, Msimu Ŵaswela akuti,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.3.7",
            "verseOrgIds": [
              "HEB.3.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
