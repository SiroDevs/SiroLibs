            "style": "v",
            "sid": "HEB 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.6",
            "verseOrgIds": [
              "HEB.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HEB 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cilanga candanda cila cikaŵe cambone mnope mkanipasosekwa soni cine m'malo mwakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.7",
            "verseOrgIds": [
              "HEB.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HEB 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo Mlungu ŵajamwice ŵandu ŵakwe ligongo ŵasimene ni ulemwa",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.8",
            "verseOrgIds": [
              "HEB.8.8"
            ]
          }
        },
        {
          "text": " acitiji,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.8",
            "verseOrgIds": [
              "HEB.8.8"
            ]
          }
        },
