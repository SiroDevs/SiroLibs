              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mlungu ŵajimwisye Ambuje ŵetu Yesu ku ŵawe, jwele jwali Jwamkulungwa Jwakucinga ngondolo, ligongo lya ciwa cakusimicisya cilanga",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.20",
            "verseOrgIds": [
              "HEB.13.20"
            ]
          }
        },
        {
          "text": " cangali pambesi. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.20",
            "verseOrgIds": [
              "HEB.13.20"
            ]
          }
        },
