          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mlungujo ampe yambone yosope yimkuyisoŵa jemanja kuti mtendeje yele yakuyisaka Jwalakwe. Nipo mwa Yesu Klistu ayitende mwetuwe yele yikumsangalasya, Klistujo aŵe ni ucimbicimbi ŵangali pambesi. Ami.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.21",
            "verseOrgIds": [
              "HEB.13.21"
            ]
          }
        }
