          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanace jwa Mlungu akupunda malayika,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.4",
            "verseOrgIds": [
              "HEB.1.4"
            ]
          }
        },
        {
          "text": " mpela mwele lina lyele Mlungu ŵampele likusapunda lina lya malayika. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.4",
            "verseOrgIds": [
              "HEB.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HEB 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwamti Mlungu nganaŵeceteje kwa malayika gakwe kuti,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.5",
            "verseOrgIds": [
              "HEB.1.5"
            ]
          }
        },
