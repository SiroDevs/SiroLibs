        "style": "s1"
      },
      "items": [
        {
          "text": "Maloŵe ga Mlungu kupitila mwa Mwanagwe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
