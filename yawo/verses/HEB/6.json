                "loc": "LEV.16.2"
              },
              "items": [
                {
                  "text": "Lef 16:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.6.19",
            "verseOrgIds": [
              "HEB.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "HEB 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu",
          "type": "text",
          "attrs": {
            "verseId": "HEB.6.20",
            "verseOrgIds": [
              "HEB.6.20"
            ]
          }
        },
        {
          "text": " ŵatulongolele kala ni kwinjila ligongo lya uwe. Jwalakwe jwaliji jwamkulungwa jwa ŵakutaga mbopesi mpaka kalakala, mpela Melikisedeki.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.6.20",
            "verseOrgIds": [
              "HEB.6.20"
            ]
          }
        },
