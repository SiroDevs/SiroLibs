          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cilicose cele cicimtendeje, mcitendeje ni mtima wosope, mpela kuti mkwatendela Ambuje, ngaŵa ŵandu iyayi. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.23",
            "verseOrgIds": [
              "COL.3.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "COL 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkumbucile kuti Ambuje tacimpa mbote jele jiŵasunjile ŵandu ŵakwe. Pakuti Klistu ni Ambuje ŵimkwatumicilawo. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.24",
            "verseOrgIds": [
              "COL.3.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "COL 3:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo mundu juŵatesile yangalumbana, tiyicimwujila msyene, ligongo Mlungu jwangali lusagu pakuŵeceta magambo.",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.25",
            "verseOrgIds": [
              "COL.3.25"
            ]
          }
