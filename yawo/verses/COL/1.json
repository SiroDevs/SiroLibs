    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "COL 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cikalataci cikutyocela kwa une Paulo, ndumetume",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.1",
            "verseOrgIds": [
              "COL.1.1"
            ]
          }
        },
        {
          "text": " jwa Klistu",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.1",
            "verseOrgIds": [
              "COL.1.1"
            ]
          }
        },
        {
          "text": " Yesu",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.1",
            "verseOrgIds": [
              "COL.1.1"
            ]
          }
        },
        {
          "text": " mwa lisosa lya Mlungu, nipo soni cikutyocela kwa mlongo mjetu Timoteo.",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.1",
            "verseOrgIds": [
              "COL.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "COL 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.1",
            "verseOrgIds": [
              "COL.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "COL 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tukumlembela jemanja ŵandu ŵa Mlungu ŵakutama ku Kolose, acalongo acimjetu ŵakulupilila mwa Klistu.",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.2",
            "verseOrgIds": [
              "COL.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "COL 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mlungu Atati ŵetu ampe umbone mtima ni mtendele.",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.2",
            "verseOrgIds": [
              "COL.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lipopelo lyakutogolela",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "COL 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.2",
            "verseOrgIds": [
              "COL.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "COL 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakusatupopelela uwe ndaŵi syosope, tukusamtogolelaga Mlungu, Atati ŵa Ambuje ŵetu Yesu Klistu. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.3",
            "verseOrgIds": [
              "COL.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "COL 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwe tupikene ya cikulupi cenu mwa Klistu Yesu ni cinonyelo cenu kwa ŵandu wosope ŵa Mlungu. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.4",
            "verseOrgIds": [
              "COL.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "COL 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndaŵi jimwapocele utenga usyesyene ni Ngani Syambone",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.5",
            "verseOrgIds": [
              "COL.1.5"
            ]
          }
        },
        {
          "text": " kandanda, jemanja mwapikene ya cembeceyo cele cicaŵecetedwe. Myoyo cikulupi ni cinonyelo cenu cigonile pa cembeceyo cele cimkulindilila cele camsunjile cenene kwinani. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.5",
            "verseOrgIds": [
              "COL.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "COL 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngani Syambonesi sikuŵeleka yisogosi soni ni kuwanda pa cilambo cosope capasi, mpela musyatendele Ngani Syambonesyo pasikati penu kutandila lisiku limwapikene ni kupikanicisya ya umbone mtima wa Mlungu. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.6",
            "verseOrgIds": [
              "COL.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "COL 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwalijiganyisye yeleyi kutyocela kwa Epafula, jwakutumicila mjetu jwakunonyelwa. Jwalakwe jula akumkamulila masengo Klistu mwakulupicika m'malo mwetuwe.",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.7",
            "verseOrgIds": [
              "COL.1.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.4.12"
              },
              "items": [
                {
                  "text": "Akolo 4:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHM.1.23"
              },
              "items": [
                {
                  "text": "Fil 23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.7",
            "verseOrgIds": [
              "COL.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "COL 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwalakweju ni juŵatusalile ya cinonyelo cele Msimu Ŵaswela ŵaŵisile mwenumwe.",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.8",
            "verseOrgIds": [
              "COL.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "COL 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.8",
            "verseOrgIds": [
              "COL.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "COL 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni ligongo lyakwe, kutandila lisiku litwapikene yeleyi, nganituleka kumpopelela jemanja. Tukumŵenda Mlungu kuti amgumbasye ni lunda soni umanyilisi yele Msimu Ŵaswela akusapeleka kuti mpikanicisye yosope yele Jwalakwe akusaka. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.9",
            "verseOrgIds": [
              "COL.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "COL 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pelepo timcikombola kwenda m'matala gele Ambuje akugasaka, nipo timcitenda yindu yakwasangalasya Ambujewo. Nipo umi wenu ucilosya yisogosi yambone yakulekanganalekangana nipo soni timciŵa mli mkonjecesya lunda lwenu lwa kum'manyilila Mlungu. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.10",
            "verseOrgIds": [
              "COL.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "COL 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tukupopela soni kuti Mlungu amlimbisye ni macili gakwe ga lumbili, kuti mpilileje yosope ni mtima wakuŵeŵa ni wakusangalala. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.11",
            "verseOrgIds": [
              "COL.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "COL 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nipo soni kwatogolela Atati, ŵajenelesye kuti mpocele nawo upile wele wakwasunjila ŵandu ŵakwe mu ucimwene wa mwilanguka. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.12",
            "verseOrgIds": [
              "COL.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "COL 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵatukulupwisye ku macili gacipi, ni ŵatujinjisye mu Ucimwene wa Mwanagwawo jwakunonyelwa. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.13",
            "verseOrgIds": [
              "COL.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "COL 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwa Jwalakwe Mlungu ŵatuwombwele niko kuti ŵatukululucile ulemwa",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.14",
            "verseOrgIds": [
              "COL.1.14"
            ]
          }
        },
        {
          "text": " wetu.",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.14",
            "verseOrgIds": [
              "COL.1.14"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.1.7"
              },
              "items": [
                {
                  "text": "Aef 1:7",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ya ndamo ni masengo ga Klistu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "COL 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.14",
            "verseOrgIds": [
              "COL.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "COL 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Klistu ni citusitusi ca Mlungu jwangawonekajo. Jwalakwe ni mwanace jwandanda kupagwa, jwamkulungwa jwakulamulila yiwumbe yosope. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.15",
            "verseOrgIds": [
              "COL.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "COL 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kupitila mwa Jwalakwe mwa Jwalakweju Mlungu ŵapanganyisye yindu yosope ya kwinani ni pa cilambo pano, yakuwoneka ni yangawoneka, atamose yitengu ya ucimwene, kapena ma ucimwene, kapena maulamusi. Mlungu ŵapanganyisye yindu yosope kupitila mwa Jwalakwe, nipo yosopeyo yili ya Jwalakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.16",
            "verseOrgIds": [
              "COL.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "COL 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Klistu ŵapali mkaniyipagwe yindu yosope, ni mwa Jwalakwe yindu yosope yalumbikene pampepe. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.17",
            "verseOrgIds": [
              "COL.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "COL 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwalakwejo ali mtwe wa cilu cakwe, wele wawuli mpingo.",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.18",
            "verseOrgIds": [
              "COL.1.18"
            ]
          }
        },
        {
          "text": " Jwele jwali jwakupeleka umi ku cilu, soni ali jwandanda kupagwa, jwele juŵajimwice ku ŵawe, kuti pa yosope Jwalakwe aŵe jwakupunda mnope.",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.18",
            "verseOrgIds": [
              "COL.1.18"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.1.22+EPH.1.23"
              },
              "items": [
                {
                  "text": "Aef 1:22-23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.18",
            "verseOrgIds": [
              "COL.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "COL 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Camnonyelesye Mlungu kuti Umlungu wakwe wosope uŵemo mwa Klistu. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.19",
            "verseOrgIds": [
              "COL.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "COL 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kupitila mwa Jwalakwe Mlungu ŵasacile kwilanya yindu yosope ya kwinani ni ya pasi pano ni Jwalakwe msyene. Mlungu ŵapelece mtendele pa cilambo capasi ni kwinani kupitila mu ciwa ca Mwanace jwakwe pa msalaba.",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.20",
            "verseOrgIds": [
              "COL.1.20"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.2.16"
              },
              "items": [
                {
                  "text": "Aef 2:16",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "COL 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.20",
            "verseOrgIds": [
              "COL.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "COL 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kala jemanja mwaliji kwakutalikangana ni Mlungu, nipo mwaŵenganaga najo ligongo lya nganisyo syenu ni masengo genu gakusakala. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.21",
            "verseOrgIds": [
              "COL.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "COL 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo sambano, kupitila mu ciwa ca Mwanace jwakwe, Mlungu ŵamkamulenye ni Jwalakwe msyene. Ŵatesile yeleyi kuti pameso pakwe mŵe ŵakuwoneka mli ŵaswela mtima, ŵangali kandu kapena ulemwa uliwose. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.22",
            "verseOrgIds": [
              "COL.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "COL 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo sambano mtameje mwakutamilicika pa yilimbilimbi ya cikulupi cenu, soni kuŵa ŵangatenganyika pa cembeceyo cikutyocela ku Ngani Syambone syele simwasipikene. Ngani Syambonesi silalicikwe kwa ŵandu ŵa pa cilambo cosope capasi, nipo Mlungu ni jwele juŵambele une Paulo, masengo gakuti nasilalicile.",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.23",
            "verseOrgIds": [
              "COL.1.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ya mwele Paulo muŵatumicililaga Mpingo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "COL 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.23",
            "verseOrgIds": [
              "COL.1.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "COL 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sambano ngusangalala ni yipwetesi yangu yinayiweni ligongo lya jemanja, pakusimana ni yipwetesiyo, ngumalisya mcilu mwangu yipwetesi yiyasigele ya Klistu m'malo mwa mcilu cakwe, wawuli mpingo. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.24",
            "verseOrgIds": [
              "COL.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "COL 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nipo une ndili jwakutumicila jwa mpingowu, pakuti Mlungu ni juŵambele masengo gakuti namlalicile kusyesyene maloŵe gakwe, ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.25",
            "verseOrgIds": [
              "COL.1.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "COL 1:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "gele gagali gamtemela gagasisice citandilile mipago josope, nambo sambano gamanyice kwa ŵandu ŵa Mlungu. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.26",
            "verseOrgIds": [
              "COL.1.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "COL 1:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cakulinga ca Mlungu ni cakwamanyisya ŵandu umbone wakwe wa mtemelawo ni lumbili lwakwe pasikati pa ŵandu ŵa mitundu jine.",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.27",
            "verseOrgIds": [
              "COL.1.27"
            ]
          }
        },
        {
          "text": " Mtemelawo ni wakuti Klistu ali mwa jemanja, nipo Jwalakwe akusampa cembeceyo ca kupocela lumbili lwa Mlungu. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.27",
            "verseOrgIds": [
              "COL.1.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "COL 1:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Klistu ni jwele jwatukumlalicila. Tukusamtetela ni kumjiganya mundu jwalijose ni umanyilisi wosope wutukwete. Pakuti tukusaka kuti mundu jwalijose aŵe jwamkomangale mwa Klistu. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.28",
            "verseOrgIds": [
              "COL.1.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "COL 1:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakusaka kuti yeleyi yitendekwe une ngukamuladi masengo mnope ni macili gele gakumba Klistu nipo gakamula masengo mwa une.",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.29",
            "verseOrgIds": [
              "COL.1.29"
            ]
          }
        }
      ]
    }
