          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akuti soni moni Yesu,",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.11",
            "verseOrgIds": [
              "COL.4.11"
            ]
          }
        },
        {
          "text": " jwakolanjidwa Yusito. Mwa ŵandu ŵa Ciyuda apali ŵandu ŵatatu ŵele ŵakungamucisya masengo ga Ucimwene wa Mlungu,",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.11",
            "verseOrgIds": [
              "COL.4.11"
            ]
          }
        },
        {
          "text": " nipo ŵaliji mkungamucisya mnope.",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.11",
            "verseOrgIds": [
              "COL.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
