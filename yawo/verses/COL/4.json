            "sid": "COL 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Acambuje, mtameje nawo cenene soni ni mwakulungamicika ŵakutumicila ŵenu, m'manyilile kuti jemanja soni mkwete Ambuje ŵenu kwinani.",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.1",
            "verseOrgIds": [
              "COL.4.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.6.9"
              },
              "items": [
                {
                  "text": "Aef 6:9",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Paulo akwasalila ŵakulupilila ŵa ku Kolose yakwenela kutenda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
