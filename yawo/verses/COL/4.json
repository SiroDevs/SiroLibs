          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngani syangu syosope tamsalile Tukiko mjetu jwakunonyelwa ni jwakutumicila jwakulupicika, nipo soni jwamasengo mjetu mwa Ambuje.",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.7",
            "verseOrgIds": [
              "COL.4.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
