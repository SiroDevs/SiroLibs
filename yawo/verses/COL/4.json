          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alisitaliko, mkayidi mjangu akumpa moni, Maliko",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.10",
            "verseOrgIds": [
              "COL.4.10"
            ]
          }
        },
        {
          "text": " nombe najo soni akumpa moni, mswani gwawo Banaba. Ya Maliko mwapocele kala maloŵe gakuti pitaciyikapo, cimwapocele cenene.",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.10",
            "verseOrgIds": [
              "COL.4.10"
            ]
          }
        },
        {
