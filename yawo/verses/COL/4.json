          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni ligongo lyakwe ngumtumisya jwalakwe kwa jemanja kuti am'manyisye ya mwele mwatuŵelele, nipo kuti tamlimbisye mitima. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.8",
            "verseOrgIds": [
              "COL.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "COL 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngumtuma pampepe ni Onesimo, mlongo mjetu jwakulupicika ni jwakunonyelwa jwele jwali jumo jwa jemanja. Jemanjajo tacimsalila yosope ya kunokuno.",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.9",
            "verseOrgIds": [
              "COL.4.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
