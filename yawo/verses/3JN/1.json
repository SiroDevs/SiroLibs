                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Cikalataci cikutyocela kwa une jwamkulungwane.",
          "type": "text",
          "attrs": {
            "verseId": "3JN.1.1",
            "verseOrgIds": [
              "3JN.1.1"
            ]
          }
        }
