              "EXO.31.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 31:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "AMBUJE piŵamasile kuŵeceta ni Mose Petumbi lya Sinayi lila, ŵampele Mosejo maganga gaŵili ga umboni, gele Mlungu msyene ŵaliji ali alembile kala.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.18",
            "verseOrgIds": [
              "EXO.31.18"
            ]
          }
        }
