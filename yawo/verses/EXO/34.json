            "number": "23",
            "style": "v",
            "sid": "EXO 34:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ŵandu ŵacalume wosope awoneceleje pameso pa une, AMBUJE, Mlungu jwa Aisalaeli, katatu pa caka. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.23",
            "verseOrgIds": [
              "EXO.34.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 34:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tingajitoposye mitundu jine ja ŵandu ndaŵi jimkwika jemanja mcilamboco, ni kugakusya malile ga cilambo cenu. Pangali jutacisaka kusumula cilambo cenuco pa gele masiku gatatu ga pa caka, gakwawula kuja kulilosya pameso pa une AMBUJE Mlungu jwenu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.24",
            "verseOrgIds": [
              "EXO.34.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
