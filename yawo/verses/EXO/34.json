          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mkatendeje cindimba ca mikate jangali cakusasaŵilisya mpela munamlamulile. Mkalyeje mikate jangali cakusasaŵilisyajo pa ndaŵi jakwe kwa masiku msano ni gaŵili, m'mwesi ŵa Abibu,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.18",
            "verseOrgIds": [
              "EXO.34.18"
            ]
          }
        },
        {
          "text": " ligongo pa wele mwesi ŵa Abibu ni wumwakopwece jemanja mcilambo cila ca Iguputo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.18",
            "verseOrgIds": [
              "EXO.34.18"
            ]
          }
        },
