            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 34:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ndaŵi jimkupeleka miasi ja mbopesi kwa une, mkajipeleka pampepe ni mikate jana cakusasaŵilisya. Mbali jilijose ja nyama jijawulajidwile cindimba ca Pasaka,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.25",
            "verseOrgIds": [
              "EXO.34.25"
            ]
          }
        },
        {
          "text": " mkajisunga mpaka kundaŵi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.25",
            "verseOrgIds": [
              "EXO.34.25"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
