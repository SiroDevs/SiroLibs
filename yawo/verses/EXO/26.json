          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkaŵice ciwuniko cila, pacanya pa Libokosi lya Cilanga ca AMBUJE, ku Cipinda Ceswela Mnopeco. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.34",
            "verseOrgIds": [
              "EXO.26.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 26:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkatamice tebulo jila, kusa kwa nguwo jakuciga. Mkaŵice cakuŵika nyali, cakumwela kwa citentico, mwakulolegana ni tebulo, jitimkaŵice ca kumpoto.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.35",
            "verseOrgIds": [
              "EXO.26.35"
            ]
          }
        }
      ]
    },
