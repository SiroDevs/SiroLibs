          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mkaŵice pa mlango wakwinjilila mu citentimo, nguwo jakuciga ja mtundu wa buluwu, wa papo ni wecejewu, ni nguwo ja bafuta jwakutililika mnope, jeluce ni jepete cenene. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.36",
            "verseOrgIds": [
              "EXO.26.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "EXO 26:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkapanganye njalamila msano sya yitela ya akesha, pakoleka jele nguwo jakuciga pa mlango. Mkasipace golidi, yakoloŵecela yakwe yikaŵe soni ya golidi, mkapanganye yakwimicila pasi pa njalamila syelesi, msano sya ni kopa ca kopa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.37",
            "verseOrgIds": [
              "EXO.26.37"
            ]
          }
        }
