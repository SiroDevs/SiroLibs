            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.25",
            "verseOrgIds": [
              "EXO.29.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 29:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mkajigale cidali ca ngondolo jamkambako, jitacijiwulaga pa msyungu wa kwaŵika pajika Aloni, timcinyakulile cidalico kwinani, kulosya kuti nyamajo mjipelece kwa une. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.26",
            "verseOrgIds": [
              "EXO.29.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 29:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Timjinyakulile kwinani ni kujiŵika pajika, cidali ni ciga cakujigala jwakutaga mbopesi, ca ngondolo jitacijiwulaga pa msyungu wa kwaŵika pajika Aloni ni ŵanace ŵakwe ŵacalume. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.27",
            "verseOrgIds": [
              "EXO.29.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 29:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa yindu yitacipeleka mbopesi ŵanace ŵa Aisalaeli, ŵacalume ndaŵi syosope. Tacipocela ligongo taciŵa ŵakutaga mbopesi, ni taciŵa ŵakupocela yakupeleka ya mkamulano ya Aisalaeli, pakuŵa tiyiciŵa mtuka wa Aisalaeli kwa une AMBUJE.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.28",
            "verseOrgIds": [
              "EXO.29.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 29:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.28",
            "verseOrgIds": [
              "EXO.29.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 29:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Yakuwala ya umbopesi ya Aloni, tiyiciŵa ya ŵanace ŵakwe ŵacalume, jwalakwe ali awile, kuti ŵanacewo tawale pa ndaŵi jakwaŵika pajika ni kwapa masengo gakutaga mbopesi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.29",
            "verseOrgIds": [
              "EXO.29.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 29:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanace jwamlume jwa Aloni jwakwinjila m'malo mwakwe kuŵa jwakutaga mbopesi, jutacijinjila mu citenti cakusimanilana ni AMBUJE cakusimanilana kuja kutumicila kumalo gamaswela, taciwala yakuwala yeleyi masiku msano ni gaŵili.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.30",
            "verseOrgIds": [
              "EXO.29.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 29:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.30",
            "verseOrgIds": [
              "EXO.29.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 29:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Timkajigale ngondolo jamkambako, jitimciwulaga pa msyungu wa kwajinjisya Aloni ni ŵanace ŵakwe ŵacalume, kuŵa ŵakutaga mbopesi, mkajitelece nyama jakwe kumalo gamaswela. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.31",
            "verseOrgIds": [
              "EXO.29.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 29:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aloni ni ŵanace ŵakwe ŵacalume akalye nyama ja ngondolo jamkambakojo, pamo ni mikate ja mlukalala jila, ali pa mlango wa citenti cakusimanilana. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.32",
            "verseOrgIds": [
              "EXO.29.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 29:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akalye soni yindu yosope yitakayipelece kwa une AMBUJE, pa msyungu wa kupesya ulemwa, pakwajinjisya ni kwaŵika pajika kuŵa ŵakutaga mbopesi. Ŵakutaga mbopesipe ni ŵakwenela kulya ligongo yinduyo yili yeswela. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.33",
            "verseOrgIds": [
              "EXO.29.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 29:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo naga nyama ja pa msyungu, wa kwajinjisya Aloni ni ŵanace ŵakwe, kuŵa ŵakutaga mbopesi, kapena mikate jikusigala mpaka kundaŵi, mkayijoce. Akaja kulya yeleyo ligongo yili yeswela.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.34",
            "verseOrgIds": [
              "EXO.29.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 29:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.34",
            "verseOrgIds": [
              "EXO.29.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 29:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mkawilisye kutenda msyungu wakwaŵika pajika Aloni ni ŵanace ŵakwe ŵacalume, kwa masiku msano ni gaŵili, mkatende yosope mpela munamlamulile, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.35",
            "verseOrgIds": [
              "EXO.29.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "EXO 29:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "lisiku lili lyose mkapeleceje ng'ombe jamkambako, kuŵa mbopesi jakuŵenda kwa AMBUJE kululucila kwa ulemwa. Soni mkagaswejesye malo gakupelecela mbopesi, pakupeleka mbopesi jakupesya ulemwa. Timkagapakasye mawuta, kuti gakaŵe malo gamaswela. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.36",
            "verseOrgIds": [
              "EXO.29.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "EXO 29:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkapelece mbopesi ja kuswejesya malo gakupelecela mbopesi, kwa masiku msano ni gaŵili, mkaliŵice pajika. Ni malo gakupelecela mbopesigo tigaciŵa malo gamaswela mnope. Cindu cacilicose cakwaya malo gakupelecela mbopesigo, ticiciŵa ceswela.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.37",
            "verseOrgIds": [
              "EXO.29.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mbopesi sya lisiku ni lisiku",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "EXO 29:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.37",
            "verseOrgIds": [
              "EXO.29.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "EXO 29:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Sambano ayi yinduyi ni yitimkapeleceje pa malo gakupelecela mbopesi: mkapeleceje ŵanace ŵangondolo ŵaŵili ŵa caka cimo, ndaŵi syosope, lisiku lili lyose. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.38",
            "verseOrgIds": [
              "EXO.29.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "EXO 29:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanace jwangondolo jumo mumpeleceje kundaŵi ni jwine ligulo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.39",
            "verseOrgIds": [
              "EXO.29.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "EXO 29:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pampepe ni ngondolo jandanda jila, mkapelece utandi wakutililika cenene wa tiligu wakwanila kilogalamu jimo, wewanganye ni mawuta gambone gakwanila lita jimo, ni soni finyo wakwanila lita jimo kuti uŵe mbopesi ja yakumwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.40",
            "verseOrgIds": [
              "EXO.29.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "EXO 29:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanace jwangondolo jwinejo mkampelece ndaŵi jegulo. Mkapelece soni yakupeleka ya yakulya ni yakumwa, mpela yakundaŵi yila, pampepe ni ngondolojo, kuti jikaŵe mbopesi jakoca pa moto, jakupeleka liwungo lyambone kwa une AMBUJE. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.41",
            "verseOrgIds": [
              "EXO.29.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "EXO 29:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakupeleka yakoca yeleyi tiyiciŵa yili mkupelecedwa ndaŵi syosope, pa mipago jenu josope. Timkayipelece pameso pa une AMBUJE, pa mlango wa citenti cakusimanilana ni AMBUJE cakusimanilana. Ligongo pelepo tinjiŵa ndili mkusimana ni kuŵecetana ni m'mwejo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.42",
            "verseOrgIds": [
              "EXO.29.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "EXO 29:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kweleko tinjisimana nawo soni Aisalaeli, malo gelego tigaciŵa gamaswela ligongo lyakumelemenda kwa lilanguka lyangu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.43",
            "verseOrgIds": [
              "EXO.29.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "EXO 29:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tinjiciswejesya citenti cakusimanilana ni AMBUJE cakusimanilana, pampepe ni malo gakupelecela mbopesi, ni soni tinjaŵika pajika Aloni ni ŵanace ŵakwe ŵacalume, kuti akaŵe ŵakutaga mbopesi ŵakundumicila une. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.44",
            "verseOrgIds": [
              "EXO.29.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "EXO 29:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tinjitama pasikati pa Aisalaeli, ni tinjiŵa Mlungu jwawo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.45",
            "verseOrgIds": [
              "EXO.29.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "EXO 29:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tacimanyilila kuti une ndili AMBUJE Mlungu jwawo, junakopwesye ku cilambo ca ku Iguputo kuti ngatame pasikati pawo. Une ndili AMBUJE Mlungu jwawo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.46",
            "verseOrgIds": [
              "EXO.29.46"
            ]
          }
        }
      ]
    }
