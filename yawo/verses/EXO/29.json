              "items": [
                {
                  "text": "Afil 4:18",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 29:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.18",
            "verseOrgIds": [
              "EXO.29.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 29:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mkajigale ngondolo jamkambako jine jila, Aloni ni ŵanace ŵakwe ŵacalume akasajice magasa gawo pa mtwe pa ngondolojo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.19",
            "verseOrgIds": [
              "EXO.29.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 29:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkajiwulaje ngondolojo, mkajigale miasi jakwe ni kujipaka pa lusonga lwepikanilo, lya mkono wamlyo wa Aloni, ni pa songa sya mapikanilo ga mkono wamlyo, wa ŵanace ŵakwe ŵacalume. Mkapace soni miasi pa yikongo yawo yamkono wamlyo, ni pa yikongo ya sajo syawo sya mkono wamlyo, miasi jakusigalajo mkajimise pa malo gakupelecela mbopesi, kusyungulila mbali syakwe syosope. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.20",
            "verseOrgIds": [
              "EXO.29.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 29:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkajigale miasi jakusigalila pa malo gakupelecela mbopesi, ni mawuta gane gakupakasya, mkamisile Aloni ni yakuwala yawo. Mkamisile soni ŵanace ŵawo ŵacalume pampepe ni yakuwala yawo. Aloni ni ŵanace ŵawo ŵacalume taciwa ŵaswela pampepe ni yakuwala yawo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.21",
            "verseOrgIds": [
              "EXO.29.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 29:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.21",
            "verseOrgIds": [
              "EXO.29.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 29:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mkajigale mawuta ga ngondolo jamkambako jila, mcila wakwe wa mawuta, ni mawuta gali pacanya pa matumbo, mawuta gali ku matoga, ni mbyo siŵili, pamo ni mawuta gali pacanya pakwe, ni ciga ca ku mkono wamlyo, ligongo ngondolo jamkambako jeleji, tijikaŵe mbopesi ja msyungu wa kwaŵicila pajika Aloni ni ŵanace ŵakwe ŵacalume. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.22",
            "verseOrgIds": [
              "EXO.29.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 29:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkapwatice pa nyamajo, mkate umo wangali cakusasaŵilisya, keke jimo jewanganye ni mawuta, mkate umo wakuwoneka mpela bisiketi, kutyocela mlukalala lwa mikate jangali cakusasaŵilisya, yitiyiciŵa pameso pa une AMBUJE. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.23",
            "verseOrgIds": [
              "EXO.29.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 29:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkayiŵice yakulya yosopeyi m'myala mwa Aloni ni mwa ŵanace ŵakwe ŵacalume, jemanjajo taciyinyakulila kwinani, kulosya kuti ayipelece kwa une. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.24",
            "verseOrgIds": [
              "EXO.29.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 29:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Timciyityosya yosopeyo m'myala mwawo, kuja kuyijoca pa malo gakupelecela mbopesi, kupwatika pa mbopesi jakoca jila, kuti tijiŵe mbopesi jakutinisya, jakupeleka pa moto kwa une AMBUJE, ja liwungo lyambone.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.25",
            "verseOrgIds": [
              "EXO.29.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
