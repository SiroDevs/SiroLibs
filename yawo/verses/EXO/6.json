          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa lisiku liŵaŵecete AMBUJE kwa Mose mcilambo ca Iguputo, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.28",
            "verseOrgIds": [
              "EXO.6.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 6:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "ŵatite, “Une ndili AMBUJE. Mkasalile Mwenye jwa ku Iguputo yindu yosope yitinamsalile m'mwejo.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.29",
            "verseOrgIds": [
              "EXO.6.29"
            ]
          }
        }
      ]
    },
