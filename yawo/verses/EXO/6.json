              "EXO.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mlungu ŵamsalile Mose kuti, “Une ndili AMBUJE.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.2",
            "verseOrgIds": [
              "EXO.6.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.17.1"
              },
              "items": [
                {
                  "text": "Gen 17:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.28.3"
              },
              "items": [
                {
                  "text": "28:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.35.11"
              },
              "items": [
                {
                  "text": "35:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.3.13+EXO.3.14+EXO.3.15"
              },
              "items": [
                {
                  "text": "Eks 3:13-15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.2",
            "verseOrgIds": [
              "EXO.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawonecele Abulahamu,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.3",
            "verseOrgIds": [
              "EXO.6.3"
            ]
          }
        },
        {
          "text": " Isaki, ni Yakobo,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.3",
            "verseOrgIds": [
              "EXO.6.3"
            ]
          }
        },
        {
          "text": " mpela Mlungu Jwamaciligosope, nambo nganinamanyisya jemanjajo lina lyangu lyakuti AMBUJE. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.3",
            "verseOrgIds": [
              "EXO.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Soni naŵisile cilanga",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.4",
            "verseOrgIds": [
              "EXO.6.4"
            ]
          }
        },
        {
          "text": " ni jemanjajo, ca kwapa cilambo ca Kenani, cilambo ciŵatemi ali acalendo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.4",
            "verseOrgIds": [
              "EXO.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Soni nakupikene kudandawula kwa Aisalaeli, ŵele Aiguputo akwasunga mwa ukapolo, ni une ngumbucile cilanga cangu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.5",
            "verseOrgIds": [
              "EXO.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa lyele ligongoli m'mweji mkasalile Aisalaeli kuti, ‘Une ndili AMBUJE. Tinakulupusye myisawusyo ya ku Iguputo, tinakoposye mu ukapolo wa masengo gakupweteka gele gakumcisya kuti mgakamule. Tinakulupusye ni mkono wangu wetambasukule, ni pakutenda masengo gangu gamacili. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.6",
            "verseOrgIds": [
              "EXO.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Timciŵa ŵandu ŵangu, Uneji tinjiŵa AMBUJE Mlungu jwenu. Ticimanyilila kuti une ndili AMBUJE, Mlungu jwenu, junamkulupwisye ku masengo gakupweteka gele gaŵamcisyaga Aiguputo kuti mgakamule. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.7",
            "verseOrgIds": [
              "EXO.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tingamjinjisye ku cilambo cinalumbilile kuti tinjicipeleka kwa Abulahamu, Isaki ni Yakobo. Tinjicipeleka cilambo celeco kwa jemanja kuti ciŵe cenucenupe. Une ndili AMBUJE.’ ” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.8",
            "verseOrgIds": [
              "EXO.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose ŵasalile Aisalaeli gele maloŵega, nambo jemanjajo nginampikanila Mose, ligongo lyakuti ŵamasile kwasa mtima, pakutama mu ukapolo wa ngalwe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.9",
            "verseOrgIds": [
              "EXO.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.9",
            "verseOrgIds": [
              "EXO.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sambano AMBUJE ŵamsalile Mose kuti, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.10",
            "verseOrgIds": [
              "EXO.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mjawule mkamsalile Mwenye jwa ku Iguputo, kuti ŵakunde Aisalaeli kutyoka mcilambo cakwe.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.11",
            "verseOrgIds": [
              "EXO.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.11",
            "verseOrgIds": [
              "EXO.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo Mose ŵasalile AMBUJE kuti, “Atamose Aisalaeli acimsyenewo ngakumbikanila une, sambano Mwenye jwa ku Iguputo tikakombolece uli kumbikanila uneji? Paja unetu jwangapakombola kuŵeceta cenene.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.12",
            "verseOrgIds": [
              "EXO.6.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.12",
            "verseOrgIds": [
              "EXO.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo AMBUJE ŵalamwile Mose ni Aloni,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.13",
            "verseOrgIds": [
              "EXO.6.13"
            ]
          }
        },
        {
          "text": " kuti, “Mwasalile Aisalaeli ni Mwenye jwa ku Iguputo, kuti une namlamwile jemanja kuti mwalongolele Aisalaeli kukopoka cilambo ca Iguputo.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.13",
            "verseOrgIds": [
              "EXO.6.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mbili ja maŵasa ga Mose ni Aloni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.13",
            "verseOrgIds": [
              "EXO.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵanace mcece ŵa Lubeni, mwanace jwandanda kupagwa jwa Isalaeli, ŵaliji aŵa: Hanoki, Palu, Hesiloni ni Kalimi. Ŵeleŵa ni ŵaŵaliji ŵa mwiŵasa lya Lubeni. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.14",
            "verseOrgIds": [
              "EXO.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵanace msano ni jumo ŵacalume ŵa Simiyoni ŵaliji aŵa: Yemuele, Yamini, Ohadi, Yakini, Sohali ni Shaulo mwanace jwamlume juŵaŵelecele mwa jwamkongwe jwa ku Kenani. Ŵeleŵa ni ŵaŵaliji ŵa mwiŵasa lya Simiyoni. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.15",
            "verseOrgIds": [
              "EXO.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aga ni mena gatatu ga ŵanace ŵacalume ŵa Lefi pampepe ni yisukulu yakwe: Geleshoni, Kohati ni Melali. Lefi ŵatemi yaka 137 ali cijumi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.16",
            "verseOrgIds": [
              "EXO.6.16"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.3.17+NUM.3.18+NUM.3.19+NUM.3.20"
              },
              "items": [
                {
                  "text": "Num 3:17-20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.26.57+NUM.26.58"
              },
              "items": [
                {
                  "text": "26:57-58",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.6.16+1CH.6.17+1CH.6.18+1CH.6.19"
              },
              "items": [
                {
                  "text": "1 Mbi 6:16-19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.16",
            "verseOrgIds": [
              "EXO.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵanace ŵaŵili ŵacalume ŵa Geleshoni ŵaliji aŵa: Libini ni Shimeyi, pampepe ni maŵasa gawo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.17",
            "verseOrgIds": [
              "EXO.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵanace mcece ŵacalume ŵa Kohati ŵaliji: Amulamu, Isala, Hebuloni ni Usiyele. Kohati ŵatemi yaka 133 ali cijumi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.18",
            "verseOrgIds": [
              "EXO.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵanace ŵaŵili ŵacalume ŵa Melali ŵaliji: Mali ni Mushi. Gelega ni maŵasa ga Lefi pampepe ni yisukulu yawo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.19",
            "verseOrgIds": [
              "EXO.6.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.19",
            "verseOrgIds": [
              "EXO.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amulamu ŵalombele alumbuwawo baba ŵawo, lina lyawo lyaliji Yokibedi, ni Yokibedijo ŵaŵelece ŵanace ŵaŵili ŵacalume Aloni ni Mose. Amulamu ŵatemi yaka 137 ali cijumi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.20",
            "verseOrgIds": [
              "EXO.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
