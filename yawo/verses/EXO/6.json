          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.22",
            "verseOrgIds": [
              "EXO.6.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aloni ŵalombele Elisheba, mwanace jwamkongwe jwa Aminadabu, mlumbugwe ŵaliji Nashoni. Elisheba ŵaŵelece ŵanace mcece, Nadabu, Abihu, Eliyesa ni Itamala. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.23",
            "verseOrgIds": [
              "EXO.6.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 6:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵanace ŵatatu ŵacalume ŵa Kola ŵaliji: Asili, Elikana ni Abiyasafu. Ŵeleŵa ni ŵaŵaliji ŵa mwiŵasa lya Kola. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.24",
            "verseOrgIds": [
              "EXO.6.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 6:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eliyesa, mwanace jwamlume jwa Aloni ŵalombele jumo jwa ŵanace ŵacakongwe ŵa Putiyele, jwalakwejo ŵamŵelecele mwanace jumpepe jwamlume lina lyakwe Finihasi. Jemanjaji ni ŵaliji ŵakulongolela ŵa maŵasa ga Lefi mpela mwa mitundu jawo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.25",
            "verseOrgIds": [
              "EXO.6.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
