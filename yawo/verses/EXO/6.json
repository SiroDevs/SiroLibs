              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo AMBUJE",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.1",
            "verseOrgIds": [
              "EXO.6.1"
            ]
          }
        },
        {
          "text": " ŵamsalile Mose",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.1",
            "verseOrgIds": [
              "EXO.6.1"
            ]
          }
        },
        {
          "text": " kuti, “Sambano timlole yitinamtende Mwenye jwa ku Iguputo. Tinamcisye jwalakwe kuti ŵakoposye ŵandu ŵangu mcilambo mwakwe. Tinamcisye kuti ŵatoposye jemanjajo mcilambo mwakwe.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.1",
            "verseOrgIds": [
              "EXO.6.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mlungu akumŵilanga Mose",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
