              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.29",
            "verseOrgIds": [
              "EXO.6.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 6:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo Mose ŵajanjile AMBUJE kuti, “Ŵalakwe akumanyilila kuti paja une jwangapakombola kuŵeceta, nambi Mwenye jwa ku Iguputojo takambikane uli uneji?”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.30",
            "verseOrgIds": [
              "EXO.6.30"
            ]
          }
