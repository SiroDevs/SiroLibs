            "sid": "EXO 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵanace ŵatatu ŵacalume ŵa Isala ŵaliji: Kola, Nefegi ni Sikili. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.21",
            "verseOrgIds": [
              "EXO.6.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵanace ŵatatu ŵacalume ŵa Usiyele ŵaliji: Mishaele, Elisafani ni Sitili.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.22",
            "verseOrgIds": [
              "EXO.6.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
