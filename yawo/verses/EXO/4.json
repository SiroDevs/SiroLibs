                "loc": "EXO.12.29"
              },
              "items": [
                {
                  "text": "Eks 12:29",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.23",
            "verseOrgIds": [
              "EXO.4.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 4:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Panyuma pakwe AMBUJE ŵasimene najo Mose petala pa malo ga cigono, ni ŵasakaga kumwulaga. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.24",
            "verseOrgIds": [
              "EXO.4.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 4:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sipola ŵamkwawo Mose ŵajigele liganga lyakutema, ni ŵamwumbesye mwanagwawo, ni ŵasikwayiye sajo",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.25",
            "verseOrgIds": [
              "EXO.4.25"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "4:25",
              "type": "text"
            },
            {
              "text": "Sajo:",
              "type": "text"
            },
            {
              "text": "Liloŵeli lili lyakupipilisya m'malo mwakakolasile makonope ga mundu.",
              "type": "text"
            }
          ]
        },
        {
          "text": " sya Mose ni lipende lya kuwumbala",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.25",
            "verseOrgIds": [
              "EXO.4.25"
            ]
          }
        },
        {
          "text": " kwakwe. Ligongo lya kuwumbala kwa mwanacejo, Sipola ŵatite kwa Mose, “M'mwejo mli ŵamkwangu ŵakuwomboledwa ni miasi kwa une!” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.25",
            "verseOrgIds": [
              "EXO.4.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 4:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myoyo AMBUJE ŵamlesile Mose ngamwulaga. Ni ligongo lyakwe Sipola ŵatite, “M'mwejo mli ŵamkwangu ŵakuwomboledwa ni miasi,” ligongo lya msyungu wa kuwumbalawo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.26",
            "verseOrgIds": [
              "EXO.4.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
