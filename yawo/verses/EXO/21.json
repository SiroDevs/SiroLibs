          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Naga mundu akuwukula lisimbo, kapena akusola lisimbo ni akulileka lyangawunicila, sambano ng'ombe kapena bulu jikugwila mwelemo, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.33",
            "verseOrgIds": [
              "EXO.21.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 21:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "msyene lisimbolyo akwenela kulipila ligongo lya cinyamaco, akwenela kulipila mbiya kwa msyene cinyamaco, nambo nyama jewejo ajigale jiŵe jakwe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.34",
            "verseOrgIds": [
              "EXO.21.34"
            ]
          }
        }
      ]
    },
