          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo naga mundu akuliŵicila cile, kumwulaga mjakwe mwa melepe mwa litala lya cinyengo, akwenela kuwulajidwa nditu, atamose ali atilile ku malo gangu gakupelecela mbopesi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.14",
            "verseOrgIds": [
              "EXO.21.14"
            ]
          }
        }
