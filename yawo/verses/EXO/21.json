              "EXO.21.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 21:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mundu naga akumputa kapolo jwamlume kapena jwamkongwe pa liso, ni kulitusula lisolyo, kapolojo amlece kuti aŵe jwamgopoledwe, ligongo lya liso lyakwe lijonasicelo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.26",
            "verseOrgIds": [
              "EXO.21.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 21:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naga akumputa ni kumkuwula lino kapolo jwamlume kapena jwamkongwe, kapolojo amgopole kuti aŵe mlukosyo ligongo lya lino lyakwe lijasicelyo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.27",
            "verseOrgIds": [
              "EXO.21.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yakwenela kutenda ŵakwete yinyama yakulanga",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 21:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.27",
            "verseOrgIds": [
              "EXO.21.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 21:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Naga ng'ombe jikumgunda mundu jwamlume kapena jwamkongwe ni misengo jakwe, ajiwulaje pa kujisoma ni maganga, nyama jakwe akalya. Nambo msyene ng'ombe akakola magambo gali gose. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.28",
            "verseOrgIds": [
              "EXO.21.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 21:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo naga ndamo ja ng'ombejo jaliji jagunda ŵandu, ni msyene ng'ombe ŵamgombelesye, nambo nganajitaŵa, naga ng'ombejo jikumgunda mundu jwamlume kapena jwamkongwe, ajiwulaje pakujisoma maganga. Soni msyene ng'ombe awulajidwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.29",
            "verseOrgIds": [
              "EXO.21.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 21:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo naga msyene ng'ombejo akumkunda kuti aliwombole, akwenela kulipila cilicose citamlamule, kuti awukulupusye umi wakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.30",
            "verseOrgIds": [
              "EXO.21.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 21:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naga ng'ombe jikumgunda mwanace jwamlume kapena jwamkongwe ni misengo jakwe, lilamusi lyakwe ni lilyolyo basi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.31",
            "verseOrgIds": [
              "EXO.21.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 21:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naga ng'ombe jikumgunda kapolo jwamlume kapena jwamkongwe, msyene ng'ombe amlipile msyene acikapolo, mbiya sya silifa",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.32",
            "verseOrgIds": [
              "EXO.21.32"
            ]
          }
        },
        {
          "text": " makumi gatatu, ni ng'ombejo ajiwulaje pakujisoma ni maganga.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.32",
            "verseOrgIds": [
              "EXO.21.32"
            ]
          }
        }
      ]
    },
