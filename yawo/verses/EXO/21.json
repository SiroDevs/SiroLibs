        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 21:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ndaŵi jakumenyana acalume, ni ŵamo ŵacalumewo akwatuta ŵakongwe ŵana cilu, ni ŵakongwewo akwasanga ciluco, nambo pangali kuwulala kwine soni, ŵalume ŵamwulesye ŵakongwewo, akwenela kulipila mtengo uliwose wutalamule ŵamkwawo, mwakwiticisyana ni acakulungwa ŵakulamula panganya. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.22",
            "verseOrgIds": [
              "EXO.21.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 21:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo naga ŵakongwewo awulele, kulipila kwakwe tikuciŵa: umi kulipila umi, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.23",
            "verseOrgIds": [
              "EXO.21.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 21:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "liso kulipila liso, lino kulipila lino, mkono kulipila mkono, lusajo kulipila lusajo,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.24",
            "verseOrgIds": [
              "EXO.21.24"
            ]
          }
        },
