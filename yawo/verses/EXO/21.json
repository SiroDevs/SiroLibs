          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mundu jwalijose jwakumputa mjakwe mpaka kumwulaga, nombe najo awulajidwe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.12",
            "verseOrgIds": [
              "EXO.21.12"
