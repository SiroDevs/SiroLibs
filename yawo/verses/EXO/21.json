        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 21:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Naga ng'ombe ja mundu jwine jikuwulaga ng'ombe ja mjakwe, ŵandu ŵaŵiliwo ajisumisye ng'ombe ja umijo, ni kugaŵana mbiya syakwe. Agaŵane soni nyama ja ng'ombe jakuwajo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.35",
            "verseOrgIds": [
              "EXO.21.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "EXO 21:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo naga yikumanyika kuti jaliji ndamo ja ng'ombejo kugunda ŵandu, ni msyenejo nganajitaŵaga, msyene ng'ombejo akwenela kupeleka ng'ombe ja cijumi kwa msyene ng'ombe jakuwajo. Ni ng'ombe jakuwajo ajijigale jiŵe jakwe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.36",
            "verseOrgIds": [
              "EXO.21.36"
            ]
          }
        }
