          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo naga atesile mwa ngosi, kwakuti nganaganicisya yakumwulaga mjakwejo, nambo yitendekwe mwakusaka kwawo Mlungu, tinjimlosya malo gakuti atilile jwalakwejo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.13",
            "verseOrgIds": [
              "EXO.21.13"
            ]
          }
        },
        {
