          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Naga mundu akumputa kapolo jwakwe jwamlume kapena jwamkongwe ni simbo, ni kapolojo akuwila papopo, mundujo akwenela kuwulajidwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.20",
            "verseOrgIds": [
              "EXO.21.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo naga kapolojo akuŵa ciŵela umi kwa lisiku lya mtundu kapena kwa masiku gaŵili, ambujegwewo akawulajidwa, ligongo kapolojo ali cipanje cakwe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.21",
            "verseOrgIds": [
              "EXO.21.21"
            ]
          }
        }
      ]
    },
    {
