              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mkakokoŵa kumba yakupeleka kutyocela ku yagowola yenu yejinji, soni kutyocela pa finyo jwenu jwejinji mjusunjile m'migolo jenu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.29",
            "verseOrgIds": [
              "EXO.22.29"
            ]
          }
        }
