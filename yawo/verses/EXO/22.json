          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mumbe une ŵanace ŵenu ŵacalume ŵandanda kupagwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.29",
            "verseOrgIds": [
              "EXO.22.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 22:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mtende soni myoyo ni ŵanace ŵandanda kupagwa ŵa ng'ombe syenu ni ngondolo syenu. Mwanace jwandanda kupagwajo taciŵa ni mamagwe masiku msano ni gaŵili, ni mumpelece kwa une pa lisiku lya msano ni gatatu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.30",
            "verseOrgIds": [
              "EXO.22.30"
            ]
          }
        }
      ]
    },
