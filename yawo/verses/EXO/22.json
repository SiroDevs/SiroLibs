          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "pakuŵa cakuliwunicila cakwe cili cicoco peco, soni cili cakulicenjela pa cilu cakwe. Nambi takaliwunicile cici? Tinjikupikana kulila kwakwe, naga akundilila une kuti namkamucisye, tinjimjanga pakuŵa une ndili jwa canasa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.27",
            "verseOrgIds": [
              "EXO.22.27"
            ]
          }
        }
      ]
