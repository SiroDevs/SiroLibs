          ]
        },
        {
          "text": "“Mkasimumlagasya mlendo kapena kumtamika mwa ukapolo, pakuŵa jemanja soni mwaliji acalendo mcilambo ca Iguputo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.21",
