        },
        {
          "text": "“Jwalijose jwakutaga mbopesi kwa milungu jine, ngaŵaga kwa AMBUJE",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.20",
            "verseOrgIds": [
              "EXO.22.20"
            ]
          }
        },
        {
