              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naga mkujigala cakuwala ca mundu mpela cikole, kuti mpaka talipile, mumwucisye lisiku mkanilikapile,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.26",
            "verseOrgIds": [
