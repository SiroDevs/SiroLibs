          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndaŵi syosope pakwinjila mu citenti cakusimanilana ni AMBUJE, kapena kuŵandicila ku malo gakupelecela mbopesi ŵaliji mkusukusula, mpela mwele AMBUJE ŵamlamulile Mose. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.32",
            "verseOrgIds": [
              "EXO.40.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 40:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵataŵile luŵala kusyungulila luŵala losope liŵataŵile citenti cakusimanilana ni AMBUJE cila ni malo gakupelecela mbopesi. Ŵaŵisile nguwo syakuciga pa cipata cakwinjila ku luŵalako. Myoyo Mose ŵamalisisye masengo gosopego.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.33",
            "verseOrgIds": [
              "EXO.40.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Liwunde lya pacanya pa citenti cakusimanilana ni AMBUJE",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
