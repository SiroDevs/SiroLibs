    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Akutaŵa citenti ni kucipeleka kwa Mlungu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 40:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "AMBUJE",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.1",
            "verseOrgIds": [
              "EXO.40.1"
            ]
          }
        },
        {
          "text": " ŵamsalile Mose",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.1",
            "verseOrgIds": [
              "EXO.40.1"
            ]
          }
        },
        {
          "text": " kuti, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.1",
            "verseOrgIds": [
              "EXO.40.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 40:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Pa lisiku lyandanda lya mwesi wandanda, mkataŵe citenti cakusimanilana ni AMBUJE. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.2",
            "verseOrgIds": [
              "EXO.40.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 40:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkaliŵice Libokosi lya Cilanga ca AMBUJE",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.3",
            "verseOrgIds": [
              "EXO.40.3"
            ]
          }
        },
        {
          "text": " mugali maganga ga malamusimo, mkalicije libokosilyo ni nguwosyo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.3",
            "verseOrgIds": [
              "EXO.40.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 40:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkaŵice soni mwelemo tebulo, ni mkaŵice penani pa tebulojo yida yakwe, mkaŵice cakuŵika nyali ni nyali syakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.4",
            "verseOrgIds": [
              "EXO.40.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 40:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkaŵice malo gakututumicisya ubani",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.5",
            "verseOrgIds": [
              "EXO.40.5"
            ]
          }
        },
        {
          "text": " ga golidi,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.5",
            "verseOrgIds": [
              "EXO.40.5"
            ]
          }
        },
        {
          "text": " pasogolo pa Libokosi lya Cilanga ca AMBUJE. Mkawugale pa mlango wa citenti ni nguwo syakuciga. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.5",
            "verseOrgIds": [
              "EXO.40.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 40:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkatamice malo gakupelecela mbopesi sya koca, pasogolo pa citenti cakusimanilana. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.6",
            "verseOrgIds": [
              "EXO.40.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 40:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkaŵice libeseni lyakunaŵila pasikati pa citenti cakusimanilana, ni malo gakupelecela mbopesi, mkataje mesi mwibesenimo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.7",
            "verseOrgIds": [
              "EXO.40.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 40:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkapanganye luŵala kusyungulila luŵala lwa citentico, ni mkakolece nguwo syakuciga pa cipata cakwinjilila ku luŵalako. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.8",
            "verseOrgIds": [
              "EXO.40.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 40:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Panyuma pakwe mkajigale mawuta gakupakasya gala, ni mkacipakasye citentico, ni yindu yosope yili mwelemo. Mkayiŵice pajika yindu yosopeyo kuti yikaŵe yeswela. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.9",
            "verseOrgIds": [
              "EXO.40.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 40:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkapakasye soni mawuta malo gakupelecela mbopesi sya koca, pamo ni yida yakwe yosope. Mkagaŵice pajika malo gakupelecela mbopesigo kuti gakaŵe malo gamaswela, malogo tigakaŵe malo gamaswela kwakupunda mnope. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.10",
            "verseOrgIds": [
              "EXO.40.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 40:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkapakasye mawuta libeseni lyakunaŵila, pampepe ni cipaka cakwe ca kutamicila, mkaliŵice pajika, kuti likaŵe lyeswela. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.11",
            "verseOrgIds": [
              "EXO.40.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 40:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Panyuma pakwe mkajigale Aloni",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.12",
            "verseOrgIds": [
              "EXO.40.12"
            ]
          }
        },
        {
          "text": " ni ŵanace ŵakwe ŵacalume ni kwika nawo ku citenti cakusimanilana, pakusaka kuti jemanjajo akaliswejesye, akajoje wosopewo kweleko. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.12",
            "verseOrgIds": [
              "EXO.40.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 40:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkawece Aloni yakuwala yapajika yeswela, mkapakasye mawuta, ni mkaŵice pajika kuti akaŵe jwakutaga mbopesi jwakundumicila une. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.13",
            "verseOrgIds": [
              "EXO.40.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 40:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Panyuma pakwe akayice ŵanace ŵakwe ŵacalume ni mkawece mwinjilo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.14",
            "verseOrgIds": [
              "EXO.40.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 40:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkapakasye mawuta ŵanacewo, mpela yimwatite pa kwapakasya baba ŵawo, kuti akaŵe ŵakutaga mbopesi ŵakundumicila une. Kwapakasya kwa mawuta kweleku tikucatendesya kuti aŵe ŵakutaga mbopesi ŵangu pa mipago jawo josope.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.15",
            "verseOrgIds": [
              "EXO.40.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 40:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.15",
            "verseOrgIds": [
              "EXO.40.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 40:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose ŵayitesile yosope mpela mwele AMBUJE ŵamlamulile kuti ayitende. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.16",
            "verseOrgIds": [
              "EXO.40.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 40:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myoyo pa lisiku lyandanda, lya mwesi wandanda, wa mcaka caŵili, citenti ca AMBUJE cataŵidwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.17",
            "verseOrgIds": [
              "EXO.40.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 40:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakutaŵa Mose citentico, ŵalongwele kutamika ya kwimicila yakwe pasi, ŵajimice mafelemu mu yakwimicilayo, ŵalumbikenye ni mitwalo jakwe, ŵajimice njalamila syakwe sila. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.18",
            "verseOrgIds": [
              "EXO.40.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 40:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pacanya pa yitelayo ŵayiwunicile ni nguwo sya kupanganyicisya tenti sila. Mpela mwele AMBUJE ŵamlamulile Mose. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.19",
            "verseOrgIds": [
              "EXO.40.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 40:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵagaŵisile maganga ga malamusi likumi gala mwibokosi lya Cilanga ca AMBUJE, ŵaswecile mbiko syakunyakulila sila mu mbali mwa libokosi, ŵaŵisile ciwuniko pacanya pakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.20",
            "verseOrgIds": [
              "EXO.40.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 40:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵaliŵisile libokosilyo mu citenti ca AMBUJE, ŵaŵisile nguwo syakuciga libokosilyo. Ŵalicijile Libokosi lya Cilanga ca AMBUJE ni nguwo mpela mwele AMBUJE ŵamlamulile Mose. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.21",
            "verseOrgIds": [
              "EXO.40.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 40:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵajiŵisile tebulo mu citenti mula, cakumpoto kwa citenti, kusa kwa nguwo jakucijila jila, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.22",
            "verseOrgIds": [
              "EXO.40.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 40:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "penani pa tebulopo ŵaŵisile mikate mpela AMBUJE ŵamlamulile Mose. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.23",
            "verseOrgIds": [
              "EXO.40.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 40:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu citenti cakusimanilana ŵaŵisile cakuŵika nyali mwakulolegana ni tebulo, ca kum'mwela kwa malo gamaswela. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.24",
            "verseOrgIds": [
              "EXO.40.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 40:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa cakuŵika nyalico ŵaŵisile nyali, kuti siŵe pameso pawo AMBUJE, mpela mwele AMBUJEWO ŵamlamulile Mose. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.25",
            "verseOrgIds": [
              "EXO.40.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 40:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu citenti cakusimanilanaco ŵaŵisile malo gakupelecela mbopesi ga golidi, pasogolo pa nguwo jakuciga. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.26",
            "verseOrgIds": [
              "EXO.40.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 40:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵagatutumicisye ubani wa liwungo lyambone malogo, mpela mwele AMBUJE ŵamlamulile Mose. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.27",
            "verseOrgIds": [
              "EXO.40.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 40:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa mlango wakwinjila kumalo gamaswela ŵaŵisile nguwo jakuciga. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.28",
            "verseOrgIds": [
              "EXO.40.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 40:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵaŵisile malo gakupelecela mbopesi sya koca pa mlango wa citenti cakusimanilana. Ŵatasile mbopesi sya koca, ni mbopesi sya yakulya, mpela mwele AMBUJE ŵamlamulile Mose. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.29",
            "verseOrgIds": [
              "EXO.40.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 40:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵaŵisile libeseni lya kunaŵila lila pasikati pa citenti cakusimanilana ni malo gakupelecela mbopesi gala, ni ŵatasile mesi ga kunaŵila, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.30",
            "verseOrgIds": [
              "EXO.40.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 40:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "gele Mose, Aloni ni ŵanace ŵakwe ŵacalume, ŵaliji mkunaŵa m'myala mwawo ni kucapa sajo syawo. ",
          "type": "text",
          "attrs": {
