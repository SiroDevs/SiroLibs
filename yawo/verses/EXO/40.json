              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Liwunde lyaciwunicile citenti cakusimanilana cila, cagumbele ni lumbili lwawo AMBUJE.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.34",
            "verseOrgIds": [
              "EXO.40.34"
