    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Manase mwenye jwa ku Yuda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 21:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Manase ŵajinjile ucimwene wa ku Yuda ali ŵa yaka 12. Nipo ŵalamulile kwa yaka 25 ku Yelusalemu. Mamagwe ŵaliji Hefisiba. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.1",
            "verseOrgIds": [
              "2KI.21.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwalakweju ŵatesile yindu yakusakala pameso pa AMBUJE,",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.2",
            "verseOrgIds": [
              "2KI.21.2"
            ]
          }
        },
        {
          "text": " ŵakuyisye misyungu jakusakala ja ŵandu ŵa mitundu jine,",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.2",
            "verseOrgIds": [
              "2KI.21.2"
            ]
          }
        },
        {
          "text": " jiŵajitopwele AMBUJE piŵayikaga Aisalaeli mcilambomo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.2",
            "verseOrgIds": [
              "2KI.21.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.15.4"
              },
              "items": [
                {
                  "text": "Yel 15:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.2",
            "verseOrgIds": [
              "2KI.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwalakwe ŵataŵile soni malo gakulambila milungu ja cilendo, giŵajonasile babagwe Hesekiya ku matumbi. Ŵataŵile malo gakupelecela mbopesi milungu ja Baala,",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.3",
            "verseOrgIds": [
              "2KI.21.3"
            ]
          }
        },
        {
          "text": " ni ŵapanganyisye milungu jagumba ja milungu ja jikongwe ja Ashela, mpela muŵatendelaga Ahabu mwenye jwa ku Isalaeli. Manase ŵaliji soni mkusilambila ndondwa sya kwinani. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.3",
            "verseOrgIds": [
              "2KI.21.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵataŵile malo gakupelecela mbopesi milungu ja cilendo m'Nyumba ja AMBUJE, yiŵasasile AMBUJEWO kuti, “Ku Yelusalemu ni kutakalambileje uneji.”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.4",
            "verseOrgIds": [
              "2KI.21.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.7.13"
              },
              "items": [
                {
                  "text": "2 Sam 7:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.4",
            "verseOrgIds": [
              "2KI.21.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwalakwe peju ŵasitaŵile ndondwa sya kwinani malo gakupelecela mbopesi, mkati mwa maluŵala gaŵili ga Nyumba ja AMBUJE. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.5",
            "verseOrgIds": [
              "2KI.21.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpaka panyuma pakwe jwalakwe peju, ŵamtasile mpela mbopesi jakutinisya mwanace jwakwe jwamlume. Ŵaliji mkutenda yindu yamatipwi ni ya usaŵi. Ŵaliji mkulondola yisango, kuweweta ya majini, ni kujikulupilila misimu. Jwalakwe ŵayitesile yindu yakusakala yejinji yele yiyatumbilisye AMBUJE. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.6",
            "verseOrgIds": [
              "2KI.21.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵaŵisile m'Nyumba ja AMBUJE citusitusi ca mlungu jwa cilendo jwakolanjidwa Ashela. Nyumba jele AMBUJE ŵaliji ali amsalile Daudi",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.7",
            "verseOrgIds": [
              "2KI.21.7"
            ]
          }
        },
        {
          "text": " ni Solomoni kuti, “Mu msinda wa Yelusalemu muno, m'Nyumba ja AMBUJE aji, ni mwele namusagwile pasikati pa yilambo yosope ya ngosyo 12 sya ŵandu ŵa ku Isalaeli, kuti alambileje une mpaka yaka yosope.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.7",
            "verseOrgIds": [
              "2KI.21.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.9.3+1KI.9.4+1KI.9.5"
              },
              "items": [
                {
                  "text": "1 Ayi 9:3-5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.7.12+2CH.7.13+2CH.7.14+2CH.7.15+2CH.7.16+2CH.7.17+2CH.7.18"
              },
              "items": [
                {
                  "text": "2 Mbi 7:12-18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.7",
            "verseOrgIds": [
              "2KI.21.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naga ŵandu ŵa ku Isalaeli tatendeje yindu yosope pakukuya malamusi gangu, ni soni pakupikanila malamusi giŵapele Mose",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.8",
            "verseOrgIds": [
              "2KI.21.8"
            ]
          }
        },
        {
          "text": " jwakutumicila jwangu, nipo une ngasingunda kwatyosya ŵandu ŵa ku Isalaeli mcilambo cinacipelece kwa acinangolo ŵawo.” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.8",
            "verseOrgIds": [
              "2KI.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo ŵandu ŵa ku cilambo ca Yuda nganiŵapikanila AMBUJE, ligongo Manase ŵasokonesye ni kwalemwekasya ŵanduwo mnope, kwapunda ŵandu ŵa mitundu jine ŵele AMBUJE ŵajonasile pa ndaŵi jiŵayikaga ŵandu ŵa ku Isalaeli mcilambomo. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.9",
            "verseOrgIds": [
              "2KI.21.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni ligongo lyakwe AMBUJE ŵaŵecete kupitila mwa ŵakulocesya ŵakwe kuti, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.10",
            "verseOrgIds": [
              "2KI.21.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ligongo lyakuti Mwenye Manase atesile yindu yakusakala yekulungwa, kuyipunda yakulemwa yosope yiŵayitesile ŵandu ŵa mtundu wa Aamoli, jwalakweju mkinapagwe, soni ligongo lyakuti jwalakweju ŵalemwekasisye Ayuda ni milungu ja cilendo jakwejo, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.11",
            "verseOrgIds": [
              "2KI.21.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "ni ligongo lyakwe une AMBUJE, Mlungu jwa Aisalaeli ngusala kuti, timbelece yisawusyo yekulungwa ku Yelusalemu ni ku Yuda, yakuti jwalijose jutaciyipikana yisawusyoyo, tacipukunya mtwe wakwe ni kutenda woga. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.12",
            "verseOrgIds": [
              "2KI.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Timbelece cilango pa msinda wa Yelusalemu, mpela munapelecele cilango ku Samaliya pamo ni Ahabu mwenye jwa ku Isalaeli ni yisukulu yakwe. Myoyo tinawucape msinda wa Yelusalemu pakwatyosya ŵandu ŵakwe wosope, mpela mwele mundu mwakusacapila mundu mbale jakwe ni kujipukuta cenene, ali amasile kujipukuta akusajiwunicila pasi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.13",
            "verseOrgIds": [
              "2KI.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵandu ŵatacisigala mcilambomo tinjatyosya ni kwapeleka m'magasa mwa amagongo ŵawo kuti ŵapunde pa ngondo ni kwasumula cilambo cawo. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.14",
            "verseOrgIds": [
              "2KI.21.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tinayitende yeleyi kwa ŵandu ŵangu ligongo jemanjaji aŵele ali mkundemwecesya ni kundumbilisya, kutandila lisiku liŵakopwece acinangolo ŵawo ku Iguputo mpaka lelo jino.”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.15",
            "verseOrgIds": [
              "2KI.21.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.15",
            "verseOrgIds": [
              "2KI.21.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Soni Manase ŵawuleje ŵandu ŵajinji ŵangalemwa, mpaka miasi ja ŵandu ŵakuwawo jajendelele m'misewu ja mu m'msinda wa Yelusalemu. Yele yinduyi yiŵatesile Manaseju yajonjecesye pa ya kusakala yiŵalongolele ŵandu ŵa Ciyuda kulambila milungu ja cilendo, pakutenda Myoyo ŵalemwecesye AMBUJE.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.16",
            "verseOrgIds": [
              "2KI.21.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.16",
            "verseOrgIds": [
              "2KI.21.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yindu yine yiŵayitesile Manase, kupwatika ulemwa",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.17",
            "verseOrgIds": [
              "2KI.21.17"
            ]
          }
        },
        {
          "text": " wuŵatesile jwalakwejo, yosopeyo yilembedwe m'buku ja Mbili ja Ayimwene ŵa ku Yuda. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.17",
            "verseOrgIds": [
              "2KI.21.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 21:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myoyo Manase ŵawile, ni ŵamsicile mwilembe mu mgunda wa Usa, wele ŵaliji mwakuŵandikana ni nyumba ja ucimwene, nipo Amoni mwanace jwakwe ŵajinjile ucimwene m'malo mwakwe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.18",
            "verseOrgIds": [
              "2KI.21.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mwenye Amoni jwa ku Yuda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 21:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.18",
            "verseOrgIds": [
              "2KI.21.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amoni ŵajinjile ucimwene wa cilambo ca Yuda, ali ŵa yaka 22, nipo ŵalamulile kwa yaka yiŵilipe ku Yelusalemu. Mamagwe ŵaliji Meshulemeti, mwanace jwamkongwe jwa Halusi jwa ku Yotiba. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.19",
            "verseOrgIds": [
              "2KI.21.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 21:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwalakwe ŵalemwecesye AMBUJE, mpela muŵatendele Manase babagwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.20",
            "verseOrgIds": [
              "2KI.21.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵalasisye yindu yosope yiŵatendaga baba ŵawo, ŵaliji mkujipopela ni kujitumicila milungu ja cilendo jiŵajitumicilaga baba ŵawo jila. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.21",
            "verseOrgIds": [
              "2KI.21.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 21:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwalakwe ŵaliji mkwakana AMBUJE, Mlungu jwa acinangolo ŵakwe, ni soni nganagapikanila Malamusi ga AMBUJE.",
          "type": "text",
