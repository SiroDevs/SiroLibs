          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "AMBUJE ŵamkamucisye Yelobowamu kuyisumula soni yilambo yele yiyaliji kala m'myala mwa Aisalaeli, ligongo ŵakuweni kulaga kwa ŵandu ŵa ku Isalaeli kuti kwaliji kwakukulungwa mnope, nipo paliji pangali mundu jwalijose juŵasigele jwakakamucisye. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.26",
            "verseOrgIds": [
              "2KI.14.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 14:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo AMBUJE nganasala kuti taciwutyosya ucimwene wa ŵa Isalaeli pa cilambo capasi ngwamba. Myoyo ŵamkamucisye Mwenye Yelobowamu jwaŵili, kuti ŵakulupwisye ŵandu ŵa ku Isalaeli.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.27",
            "verseOrgIds": [
              "2KI.14.27"
            ]
          }
        }
      ]
    },
