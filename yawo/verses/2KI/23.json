                "loc": "1KI.12.33"
              },
              "items": [
                {
                  "text": "1 Ayi 12:33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.15",
            "verseOrgIds": [
              "2KI.23.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ali amasile kutenda yindu yeleyi, Yosiya ŵalolite aku nakuku ni ŵagaweni malembe petumbi, ŵatumisye ŵandu kuti akawukule mawupa m'malembemo, ni ŵagajocile mawupago pa malo gakupelecela mbopesi, pakutenda myoyo ŵagajonasile malo gakupelecela mbopesigo kuti akasagatendela soni masengo, ŵayitesile yeleyi mpela mwele mu ŵaŵecetele jwakulocesya",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.16",
            "verseOrgIds": [
              "2KI.23.16"
            ]
          }
        },
        {
          "text": " jwa Mlungu kalakala, pa ndaŵi jele Mwenye Yelobowamu ŵaliji ali ajimi mungulugulu malo gakupelecela mbopesi, kutenda cindimba. Mwenye Yosiya ŵalolite soni aku nakuku ni ŵaliweni lilembe line lya jwakulocesya, juŵalocesye yele yinduyi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.16",
            "verseOrgIds": [
              "2KI.23.16"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
