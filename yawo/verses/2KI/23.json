                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.12",
            "verseOrgIds": [
              "2KI.23.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaneko mwenye ŵagumwile soni malo gakupelecela mbopesi gaŵataŵile Mwenye Solomoni ca kungopoko lyuŵa kwa msinda wa Yelusalemu, kum'mwela kwa Litumbi lya Olifi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.13",
            "verseOrgIds": [
              "2KI.23.13"
            ]
          }
        },
        {
          "text": " Ŵataŵile malo gakupelecela mbopesigo kuti atajileje mbopesi kwa milungu ja cilendo jakunyalaya, mpela Ashitoleti mlungu jwamkongwe jwa ku Sidoni, Kemoshi mlungu jwa ku Mowabu, ni Moleki mlungu jwa ku Amoni.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.13",
            "verseOrgIds": [
              "2KI.23.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.11.7"
              },
              "items": [
                {
                  "text": "1 Ayi 11:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.13",
            "verseOrgIds": [
              "2KI.23.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵagumwile soni yipilala ya maganga, ni kwikatanya yitela yacimanyisyo ca mlungu jwakolanjidwa Ashela, nipo pa malo piyaliji yida yeleyi ŵaŵisile mawupa ga ŵandu ŵakuwa.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.14",
            "verseOrgIds": [
              "2KI.23.14"
            ]
          }
        }
