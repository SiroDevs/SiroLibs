        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Akumgopola Yehoiyakini mu ukayidi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 25:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.26",
            "verseOrgIds": [
              "2KI.25.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 25:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehoiyakini ŵaliji mu ukayidi kwa yaka 37. Nipo Efili Melodaki, mwanace jwa Nebukadinesa, ŵajinjile ucimwene wa ku Babiloniya. Mcaka cakwe candanda cakulamulila cilambo ca Babiloniya, pa lisiku lya 27 lya mwesi wa 12, ŵalosisye mtima wa canasa kwa Yehoiyakini mwenye jwa ku Yuda, ni ŵamgopwele mu ukayidi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.27",
            "verseOrgIds": [
              "2KI.25.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2KI 25:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵamtendele yindu yambone, nipo ŵamkwesisye kwapunda ayimwene wosope, ŵaŵaliji nawo ku Babiloniyako. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.28",
            "verseOrgIds": [
              "2KI.25.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2KI 25:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵamkundile Yehoiyakini kuwula yakuwala ya ukayidi, ni kulya pa tebulo ja mwenye masiku gosope ga umi wakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.29",
            "verseOrgIds": [
              "2KI.25.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2KI 25:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenye jwa ku Babiloniyajo, ŵampaga Yehoiyakini lisiku lililyose lya umi wakwe, mbiya syakusuma yindu yiliyose yiŵayisakaga.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.30",
            "verseOrgIds": [
              "2KI.25.30"
            ]
          }
        }
      ]
