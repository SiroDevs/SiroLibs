          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.14",
            "verseOrgIds": [
              "2KI.24.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 24:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebukadinesa ŵamjigele Yehoiyakini kuja najo ku Babiloni mu ukayidi, pamo ni mamagwe, ŵamkwakwe, nduna syakwe, ni soni ŵandu ŵakupikanika ŵa mcilambomo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.15",
            "verseOrgIds": [
              "2KI.24.15"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.17.12"
              },
              "items": [
                {
                  "text": "Esek 17:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.15",
            "verseOrgIds": [
              "2KI.24.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 24:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwalakwe ŵakamwile soni asilikali ŵa ngondo ŵakwanila 7,000 kwajawusya ku Babiloniya, ni amisili ŵakumanyilila kupanganya yindu yakulekanganalekangana ŵakwanila 1,000, ni mundu jwalijose juŵam'weni kuti ŵaliji jwakwenela kuja kuputa ngondo, wosopewo ŵajigele mu ukayidi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.16",
            "verseOrgIds": [
              "2KI.24.16"
            ]
          }
        }
      ]
    },
    {
