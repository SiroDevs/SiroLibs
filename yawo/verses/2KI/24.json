            "sid": "2KI 24:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa ndaŵi ja ucimwene wa Yehoiyakimu, Nebukadinesa mwenye jwa ku Babiloniya ŵayice kuputa ngondo ku cilambo ca Yuda, nipo kwa yaka yitatu Yehoiyakimu ŵaliji mkutumicila Nebukadinesa. Nambo panyuma pakwe Yehoiyakimujo ŵamjimucile Nebukadinesa.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.1",
            "verseOrgIds": [
              "2KI.24.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
