            "number": "17",
            "style": "v",
            "sid": "2KI 24:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaneko mwenye jwa ku Babiloni ŵajinjisye akwelume ŵa Yehoiyakini, lina lyawo Mataniya, kuŵa mwenye jwa ku Yuda m'malo mwakwe. Nipo ŵampele Mataniyajo lina lya sambano lyakuti, Sedekiya.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.17",
            "verseOrgIds": [
              "2KI.24.17"
            ]
          }
        },
        {
