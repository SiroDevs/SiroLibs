        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.12",
            "verseOrgIds": [
              "2KI.24.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 24:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "nipo Nebukadinesajo ŵajigele cipanje cosope ca m'Nyumba ja AMBUJE, pamo ni cipanje cosope ca ku nyumba ja ucimwene. Ŵayijonasile yida yosope ya golidi",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.13",
            "verseOrgIds": [
              "2KI.24.13"
            ]
          }
        },
        {
          "text": " ya ku Nyumba ja AMBUJE, yele yiŵayipanganyisye Solomoni mwenye jwa ku Isalaeli. Yeleyi yatendekwe mpela mwele muŵalocesye AMBUJE kala. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.13",
            "verseOrgIds": [
              "2KI.24.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 24:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵajigele soni mu ukayidi acakulungwa ŵa asilikali ŵa ngondo, nduna syosope sya boma, ni amisili ŵakumanyilila masengo gakulekanganalekangana, ŵa mu msinda wa Yelusalemu. Ŵandu wosope ŵakwanile 10,000. Nganasigala mundu jwalijose akaŵe ŵandu ŵakulaga mnope ŵa mcilambo ca Yuda.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.14",
            "verseOrgIds": [
              "2KI.24.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
