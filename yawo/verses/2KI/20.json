              "2KI.20.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 20:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵanace ŵenu ŵane ŵacalume ŵakuliŵelecela mwacisyene, tacijigalwa nipo takaŵe ŵakutumicila ku nyumba ja mwenye jwa ku Babiloniya, nambotu ali alongwele kwacela.”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.18",
            "verseOrgIds": [
              "2KI.20.18"
            ]
          }
        },
        {
