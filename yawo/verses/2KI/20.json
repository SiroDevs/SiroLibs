              "2KI.20.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 20:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myoyo Hesekiya ŵamsalile Yesaya kuti, “Maloŵe gaŵecete AMBUJE gali gambone.” Pakuŵeceta gele maloŵego, Hesekiya ŵaliji mganisya mu mtima mwakwe kuti, “Yeleyo yangali kandu, nabola upagwe mtendele ni bata masiku gosope ga umi wangu.”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.19",
            "verseOrgIds": [
              "2KI.20.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kumala kwa ucimwene wa Hesekiya",
          "type": "text"
