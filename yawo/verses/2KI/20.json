    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ulwele wa Hesekiya ni kupola kwakwe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 20:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gele masikugo Hesekiya ŵalwasile kwakogoya, nipo ŵasigalile panandi kuwa. Jwakulocesya",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.1",
            "verseOrgIds": [
              "2KI.20.1"
            ]
          }
        },
        {
          "text": " Yesaya mwanace jwa Amosi, ŵajawile kuja kumsonda, ni ŵamsalile kuti, “AMBUJE",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.1",
            "verseOrgIds": [
              "2KI.20.1"
            ]
          }
        },
        {
          "text": " akumsalila kuti, myikolosye yindu yenu cenene, pakuŵa ngampola cilwele cenuci, mliŵicile cile kuwa.”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.1",
            "verseOrgIds": [
              "2KI.20.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 20:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.1",
            "verseOrgIds": [
              "2KI.20.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndaŵi jijojo Hesekiya ŵagalawice kulola kwipupa, ni ŵatandite kupopela kwa AMBUJE kuti, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.2",
            "verseOrgIds": [
              "2KI.20.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ŵalakwe AMBUJE akumbucile kuti naliji mkwatumicila ŵalakwe mwakulupicika ni mwakulipeleka. Naliji mkutenda yindu yiŵasakaga ŵalakwe kuti une nayitende ndaŵi syosope.” Ali amasile kupopelako, Hesekiya ŵatandite kulila mwakupwetekwa mtima.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.3",
            "verseOrgIds": [
              "2KI.20.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.3",
            "verseOrgIds": [
              "2KI.20.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesaya ni ŵatyosile kwaleka mwenye ŵala, nambo mkinakopoce pa luŵala lwa pasikati pa nyumba ja ucimwene, AMBUJE ŵamsalile kuti, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.4",
            "verseOrgIds": [
              "2KI.20.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ujilani, mkasalile Hesekiya, mwenye jwa ŵandu ŵangu, maloŵe aga, Une ndili AMBUJE, Mlungu jwa nangolo jwenu Daudi,",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.5",
            "verseOrgIds": [
              "2KI.20.5"
            ]
          }
        },
        {
          "text": " nalipikene lipopelo lyenu, ni najiweni misosi jenu. Cambone, une tinamposye ku cilwele cenuci. Nipo mtondo timpakombole kwawula ku Nyumba ja AMBUJE kuja kupopela. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.5",
            "verseOrgIds": [
              "2KI.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tinamjonjecesye yaka likumi kwisa msano pa umi wenu. Tinamkulupusye m'mwejo pamo ni msindawu m'magasa ga mwenye jwa ku Asiliya. Tinawutetele ni kuwucenjela wele msindawu ligongo lya une namsyene ni ligongo lya cilanga",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.6",
            "verseOrgIds": [
              "2KI.20.6"
            ]
          }
        },
        {
          "text": " cinapangene ni Daudi jwakutumicila jwangu.”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.6",
            "verseOrgIds": [
              "2KI.20.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.6",
            "verseOrgIds": [
              "2KI.20.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesaya ŵasalile ŵamasengo ŵa mwenye kuti, “Mkupe likoko lya nguju ni mlipace likokolyo pa cisumbukute ca mwenye, kuti apole.” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.7",
            "verseOrgIds": [
              "2KI.20.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenye Hesekiya ŵamwusisye Yesaya jula kuti, “Ana ticipagwe cilocesyo camtuli cakulosya kuti une kweli AMBUJE tambosye, ni kuti une tinapakombole kwawula ku Nyumba ja AMBUJE mtondo uno kuja kupopela?” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.8",
            "verseOrgIds": [
              "2KI.20.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesaya ŵajanjile kuti, “AMBUJE tampe m'mwejo cilocesyo cakusimicisya kuti AMBUJEWO takwanilisye cilanga cawo. M'mwejo kuti mkulupilile kuti yeleyi tiyitendekwe, ana timsace kuti ciwilili cikwele makwelelo likumi kuja msogolo kapena kuti ciwililico ciwujile munyuma makwelelo likumi?” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.9",
            "verseOrgIds": [
              "2KI.20.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 20:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hesekiya ŵajanjile kuti, “Cili cindu cangasawusya kucitenda ciwilili kuti cijawule msogolo makwelelo likumi. Nambo kuti une ngulupilile yeleyi, acitende ciwililico ciwujile munyuma makwelelo likumi.” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.10",
            "verseOrgIds": [
              "2KI.20.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 20:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesaya ŵapopesile, nipo AMBUJE ŵaciwucisye ciwililico munyuma makwelelo likumi, pa makwelelo giŵataŵile Mwenye Ahasi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.11",
            "verseOrgIds": [
              "2KI.20.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ŵamitenga ŵakutyocela ku Babiloniya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 20:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.11",
            "verseOrgIds": [
              "2KI.20.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 20:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndaŵi jilajila mwenye jwa ku Babiloniya, Melodaki Baladani, mwanace jwa Baladani, piŵapikene kuti Mwenye Hesekiya akulwala ŵatumile ŵamitenga, ŵapele mituka ni cikalata kuti akapelece kwa Mwenye Hesekiyawo. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.12",
            "verseOrgIds": [
              "2KI.20.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 20:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hesekiya ŵapocele ŵanduwo, ni ŵalosisye cipanje cakwe cosope, mpela silifa,",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.13",
            "verseOrgIds": [
              "2KI.20.13"
            ]
          }
        },
        {
          "text": " golidi,",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.13",
            "verseOrgIds": [
              "2KI.20.13"
            ]
          }
        },
        {
          "text": " yindu yakununjila yakutaga mu yakulya, mawuta gakununjila ga mtengo wawukulungwa mnope, yida yosope ya ngondo, ni ŵalosisye soni yindu yosope yiŵayisungaga m'majumba ga kusunjila cipanje cakwe. Paliji pangali yindu yiliyose yaliji m'majumba mwakwe, ni yindu yosope yaliji mcilambo mwakwe, yamkiniŵalosya ŵele ŵanduwo. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.13",
            "verseOrgIds": [
              "2KI.20.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 20:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwakulocesya Yesaya ŵajawile kwa Mwenye Hesekiya, ni ŵamwusisye kuti, “Ana ŵandu ŵeleŵa akutyocela kwapi, soni ayicile cici akuno?” Mwenye Hesekiya ŵajanjile kuti, “Ŵandu ŵeleŵa atyocele kucilambo cakutalika, ca ku Babiloniya.” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.14",
            "verseOrgIds": [
              "2KI.20.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 20:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesaya ŵamwusisye soni kuti, “Ana mwalosisye cici ŵanduŵa m'nyumba jenu ja ucimwene?” Hesekiya ŵajanjile kuti, “Ayiweni yindu yangu yosope ya m'nyumba mwangu. Pangali cindu cilicose cimkanaciwona m'majumba mwakusunjila cipanje.”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.15",
            "verseOrgIds": [
              "2KI.20.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 20:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.15",
            "verseOrgIds": [
              "2KI.20.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 20:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndaŵi jijojo Yesaya ŵamsalile Mwenye Hesekiya kuti, “AMBUJE akusala kuti, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.16",
            "verseOrgIds": [
              "2KI.20.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 20:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "tijiyikane ndaŵi jele yindu yosope ya m'majumba mwenu ni yindu yosope yiŵasunjile acinangolo ŵenu mpaka lelo, tacimsumula kwawula nayo ku Babiloniya. Ngasipasigala kandu kalikose.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.17",
            "verseOrgIds": [
              "2KI.20.17"
            ]
          }
        },
        {
