              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myoyo masengo gane giŵatesile Yeholamu galembedwe m'buku ja Mbili ja Ayimwene ŵa ku Yuda. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.23",
            "verseOrgIds": [
              "2KI.8.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2KI 8:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeholamu ŵawile nipo ŵamsicile ku malembe ku ŵagonile acinangolo ŵakwe mu msinda wa Daudi. Myoyo Ahasiya juŵaliji mwanagwe, ŵajinjile ucimwene m'malo mwakwe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.24",
            "verseOrgIds": [
              "2KI.8.24"
            ]
          }
        }
      ]
    },
    {
