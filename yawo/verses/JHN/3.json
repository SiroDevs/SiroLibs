          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yohane",
          "type": "text",
          "attrs": {
            "verseId": "JHN.3.23",
            "verseOrgIds": [
              "JHN.3.23"
            ]
          }
        },
        {
          "text": " nombe najo ŵabatisyaga mu Ainoni, ngaŵa kwakutalikangana ni ku Salimu, ligongo gapali mesi gamajinji mu gele malogo. Ŵandu ŵaliji mkwawula kwa Yohane ni ŵabatisyaga. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.3.23",
            "verseOrgIds": [
              "JHN.3.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JHN 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Pelepa ni kuti Yohane ŵaliji mkanaponyedwe mu ukayidi.)",
          "type": "text",
          "attrs": {
            "verseId": "JHN.3.24",
            "verseOrgIds": [
              "JHN.3.24"
            ]
          }
        },
        {
