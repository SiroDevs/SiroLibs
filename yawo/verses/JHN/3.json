              "items": [
                {
                  "text": "Mat 11:27",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.10.22"
              },
              "items": [
                {
                  "text": "Luk 10:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.3.35",
            "verseOrgIds": [
              "JHN.3.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JHN 3:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwalijose jwakukulupilila mwa Mwanace akwete umi wangamala, jwalijose jwangampikanila Mwanace ngasakola umi, nambo Mlungu tacapa yisawusyo mpaka kalakala.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.3.36",
            "verseOrgIds": [
              "JHN.3.36"
            ]
          }
        }
