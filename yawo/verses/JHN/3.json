              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.3.21",
            "verseOrgIds": [
              "JHN.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JHN 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Panyuma pa yeleyi, Yesu ni ŵakulijiganya",
          "type": "text",
          "attrs": {
            "verseId": "JHN.3.22",
            "verseOrgIds": [
              "JHN.3.22"
            ]
          }
        },
        {
          "text": " ŵakwe ŵajawile ku upande wa Yudeya, kuŵatemi ni jemanjajo ndaŵi panandi soni ŵabatisye.",
          "type": "text",
