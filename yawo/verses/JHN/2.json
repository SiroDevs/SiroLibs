          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Acakulungwa ŵa Ciyuda ŵamwusisye ciwusyo cakuti, “Ana cici cakusimonjesya campaka apanganye ni kutulosya uwe kuti wawo akuŵajilwa kutenda yeleyi?”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.18",
            "verseOrgIds": [
              "JHN.2.18"
            ]
          }
        }
      ]
