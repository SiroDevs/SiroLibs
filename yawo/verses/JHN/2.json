          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jemanjajo ŵamwusisye kuti, “Tacijitaŵa soni pa masiku gatatupe basi? Jamasiletu yaka 46 ali mkutaŵa jele Nyumba ja AMBUJEJI!”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.20",
            "verseOrgIds": [
              "JHN.2.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JHN 2:20"
          },
          "items": [
