              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.22",
            "verseOrgIds": [
              "JHN.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JHN 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Piŵaliji Yesu m'Yelusalemu pa ndaŵi ja cindimba ca Pasaka, ŵandu ŵajinji ŵakulupilile mwa jwalakwe piŵayiweni yakusimonjesya yiŵayipanganyisye. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.23",
            "verseOrgIds": [
              "JHN.2.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JHN 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo Yesu nganasosa kuti ŵanduwo akole macili pa jwalakwe ligongo ŵamanyilile wosope mitima jawo. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.24",
            "verseOrgIds": [
              "JHN.2.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JHN 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paliji pangasosekwa soni kuti jwine amsalile ya ŵanduwo, ligongo ŵamanyilile msyene kalape yiyaliji m'mitima mwawo.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.25",
            "verseOrgIds": [
              "JHN.2.25"
            ]
          }
        }
