          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jemanja mwajigele silifa",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.5",
            "verseOrgIds": [
              "JOL.3.5"
            ]
          }
        },
        {
          "text": " ni golidi",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.5",
            "verseOrgIds": [
              "JOL.3.5"
            ]
          }
        },
        {
          "text": " jwangu ni yindu yangu yine ya mtengo wapenani, kwawula nayo ku nyumba ja milungu jine. ",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.5",
            "verseOrgIds": [
              "JOL.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOL 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwasumisye ŵandu ŵa ku Yuda ni ku Yelusalemu kwa Agiliki,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.6",
            "verseOrgIds": [
              "JOL.3.6"
            ]
          }
        },
        {
          "text": " kuti mjawule nawo kwakutalika ni malile ga cilambo cawo. ",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.6",
            "verseOrgIds": [
              "JOL.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOL 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo tinjajimusya kuti atyoce kumalo kwawo kumwasumisye jemanjajo. Kaneko tinjiwucisya yitendo yenu yosope pa mtwe penu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.7",
            "verseOrgIds": [
              "JOL.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOL 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tinjasumisya ŵanace ŵenu ŵacalume ni ŵacakongwe kwa ŵandu ŵa ku Yuda, nipo jemanjajo tacasumisya kwa Aseba, mtundu wa ŵandu ŵakutama kwakutalika ŵala. AMBUJE aŵecete myoyo.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.8",
            "verseOrgIds": [
              "JOL.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mlungu tacipeleka upile kwa ŵandu ŵakwe",
          "type": "text"
        }
      ]
    }
