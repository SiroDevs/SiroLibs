              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.6",
            "verseOrgIds": [
              "DEU.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "“AMBUJE pakumsagula ni kumnonyela jemanja, nganatendela kuti mwaliji ŵandu ŵajinji kwapunda ŵandu ŵane, iyayi, jemanja mwaliji ŵandu ŵa lukosyo lwalunondi pasikati pa ngosyo sine sya pacilambo capasi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.7",
            "verseOrgIds": [
              "DEU.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo AMBUJE ŵamnonyele jemanja soni ŵasacile kucisunga cilanga",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.8",
            "verseOrgIds": [
              "DEU.7.8"
            ]
          }
        },
        {
          "text": " ciŵalangene ni acinangolo ŵenu. Ni ligongo lyakwe ŵamkulupwisye ni macili gawo gamakulungwa, ŵamtyosisye mu ukapolo ŵa Mwenye jwa ku Iguputo, ni kumtenda kuŵa ŵa mtendele. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.8",
            "verseOrgIds": [
              "DEU.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myoyo mkumbucileje kuti, AMBUJE Mlungu jwenu ni jwali Mlungu jika basi, soni ali Mlungu jwakulupicika. Jwalakwe tacisunga cilanga cakwe, soni tacilosya canasa cakwe cangamala kwa ŵandu ŵa mipingo jejinji, ŵakumnonyela jwalakwe ni kugapikanila malamusi gakwe.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.9",
            "verseOrgIds": [
              "DEU.7.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.20.5+EXO.20.6"
              },
              "items": [
                {
                  "text": "Eks 20:5-6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.34.6+EXO.34.7"
              },
              "items": [
                {
                  "text": "34:6-7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.14.18"
              },
              "items": [
                {
                  "text": "Num 14:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.5.9+DEU.5.10"
              },
              "items": [
                {
                  "text": "Det 5:9-10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.9",
            "verseOrgIds": [
              "DEU.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo kwa wosope ŵakuŵengana ni jwalakwe, tacapa cilango. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.10",
            "verseOrgIds": [
              "DEU.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myoyo sambano, mpikanileje yosope yimlijiganyisye soni mpikanileje malamusi gosope ganimpele lelo jinoga.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.11",
            "verseOrgIds": [
              "DEU.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jwakugapikanila Malamusi ga AMBUJE Mlungu akupata upile",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.11",
            "verseOrgIds": [
              "DEU.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Naga mkugapikanila ni kugakuya mwakulupicika malamusi gosope gimgapikenega, AMBUJE Mlungu jwenu, tapitilisye kucisunga cilanga cakwe ciŵapangene ni jemanja. Soni tapitilisye kumnonyela mpela muŵalumbilile ni acinangolo ŵenu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.12",
            "verseOrgIds": [
              "DEU.7.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.11.13+DEU.11.14+DEU.11.15+DEU.11.16+DEU.11.17"
              },
              "items": [
                {
                  "text": "Det 11:13-17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.12",
            "verseOrgIds": [
              "DEU.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tacimnonyela ni kumpa upile kuti timŵelece ŵanace ŵajinji. Tacipeleka upile ku migunda jenu, kuti timkole yakulya, finyo, ni mawuta ga olifi",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.13",
            "verseOrgIds": [
              "DEU.7.13"
            ]
          }
        },
        {
          "text": " gamajinji. Tacimpa soni upile wakola yilangwa yejinji. Tacimpa yindu yosopeyi patimkajinjile mcilambo ciŵatesile cilanga kwa acinangolo ŵenu, kuti tacicipeleka cilambo celeci kwa jemanja. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.13",
            "verseOrgIds": [
              "DEU.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pangali ŵandu ŵa pacilambo capasi ŵatacikola upile mpela jemanja. Pangali mundu jutaciŵa jwangaŵeleka pasikati penu, atamose yilangwa yenu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.14",
            "verseOrgIds": [
              "DEU.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "AMBUJE tacimcinjilicisya ku yilwele yakogoya yimwayiweni ku Iguputo yila, yimyicilile soni jemanja, nambo ambuje taciyipeleka yilweleyo kwa amagongo ŵenu wosope. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.15",
            "verseOrgIds": [
              "DEU.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkasijonanje ngosyo syosope sya ŵandu, sitakasipelece AMBUJE kwa jemanja, mwangasitendela canasa. Mkaja kujigalika pakujilambila milungu jawo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.16",
            "verseOrgIds": [
              "DEU.7.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.16",
            "verseOrgIds": [
              "DEU.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mwine timkaŵe mli mkuliwusya m'mitima jenu mcitiji, ana ŵandu ŵa ngosyo syelesi citwajonanje uli, pakuŵa ali ŵandu ŵamacili kutupunda uweji? ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.17",
            "verseOrgIds": [
              "DEU.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkaja kwajogopa jemanjajo, mkumbucile yele AMBUJE Mlungu jwenu, yiŵamtesile Mwenye jwa ku Iguputo, pamo ni ŵandu ŵakwe wosope. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.18",
            "verseOrgIds": [
              "DEU.7.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkumbucile yindu yakogoya yimwayiweni ni meso genu. Mwayiweni yindu yakusimonjeka ni yindu yayikulungwa ya macili. Yiŵayitesile AMBUJE Mlungu jwenu kuti amkulupusye jemanja. Jwalakwe tacajonanga ŵandu wosope ŵamkwajogopa sambano jinoŵa, tacajonanga mpela muŵajonasile Aiguputo ŵala. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.19",
            "verseOrgIds": [
              "DEU.7.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵane tacilinga kutila ni kuja kuŵa m'malo gakusisika, nambo AMBUJE Mlungu jwenu tacajonanga ŵandu wosopewo ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.20",
            "verseOrgIds": [
              "DEU.7.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkajogopa ŵandu ŵeleŵa, pakuŵa AMBUJE mlungu jwenu ali ni jemanja. Jwalakweju ali Mlungu jwamkulungwa jwakwenela kumjogopa. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.21",
            "verseOrgIds": [
              "DEU.7.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwalakwe takasitoposye ngosyo sya ŵandu ŵeleŵa panandipanandi, patimkajinjileje jemanja mcilambomo. Nambo ngaja kwajonanga ŵandu wosope ŵa mcilambomo ndaŵi jimo, ligongo naga mkuja kutenda myoyo, yinyama yamwitinji tiyikaŵe yejinji, nipo tiyikamsawusye jemanja. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.22",
            "verseOrgIds": [
              "DEU.7.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DEU 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "AMBUJE takapelece amagongo ŵenu m'magasa mwenu, takasokonesye mpaka timkamale kwawulaga wosope ŵene. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.23",
            "verseOrgIds": [
              "DEU.7.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tacapeleka acayimwene ŵawo wosope m'magasa genu. Timkawulaje wosope ni pangali mundu jutacakumbucila soni. Pangali mundu jwalijose jutacimlekasya, timcawulaga ŵandu wosopewo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.24",
            "verseOrgIds": [
              "DEU.7.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DEU 7:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkajijoce milungu jawo ni moto. Mkaja kumbila silifa",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.25",
            "verseOrgIds": [
              "DEU.7.25"
            ]
          }
        },
        {
          "text": " ni golidi",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.25",
            "verseOrgIds": [
              "DEU.7.25"
            ]
          }
        },
        {
          "text": " juŵapanganyicisye milungu jawojo. Mkaja kutanjila pa kujigala yindu yeleyo, ligongo yikusiyanyalaya AMBUJE Mlungu jwenu, yindu yakwayana ni milungu jine. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.25",
            "verseOrgIds": [
              "DEU.7.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DEU 7:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkaja kwinjila nayo m'majumba mwenu yindu yeleyo, kogopela ni mkaŵa likungu lya jemanjajo kumyicila jemanja. Mkaŵengane najo milungu jawojo, ligongo AMBUJE ŵajilwesile.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.26",
            "verseOrgIds": [
              "DEU.7.26"
            ]
          }
        }
      ]
    }
