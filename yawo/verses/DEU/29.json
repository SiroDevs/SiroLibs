        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.28",
            "verseOrgIds": [
              "DEU.29.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DEU 29:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nambotu pana yindu yine yimkanatujuwulila AMBUJE Mlungu jwetu, nambo atujuwulile malamusi gawo, myoyo uweji ni yisukulu yetu tukwenela kugapikanila gele malamusiga kwa yaka yosope.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.29",
            "verseOrgIds": [
              "DEU.29.29"
            ]
          }
        }
