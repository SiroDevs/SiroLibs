              "type": "text"
            }
          ]
        },
        {
          "text": "Myoyo Mose ŵagalembile maloŵe ga nyimbo lisiku lilyolyo, ni ŵajiganyisye Aisalaeli.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.22",
