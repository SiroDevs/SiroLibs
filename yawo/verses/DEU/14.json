          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Jemanja mli ŵanace ŵa AMBUJE",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.1",
            "verseOrgIds": [
              "DEU.14.1"
            ]
          }
        },
        {
          "text": " Mlungu jwenu. Pa ndaŵi jimkulila malilo, conde mkasimlikataga pa cilu kapena kumyola umbo sya pawusyo penu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.1",
            "verseOrgIds": [
              "DEU.14.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
