          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "“ ‘Alwesece mundu jwalijose jwangacimbicisya babagwe kapena mamagwe.’",
          "type": "text",
          "attrs": {
