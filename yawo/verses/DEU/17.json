              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.6",
            "verseOrgIds": [
              "DEU.17.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakumwulaga jwalakwejo, sitande mbonisyo kumsoma maganga. Panyuma pakwe ŵandu wosope amsome maganga mundujo. Pakutenda myoyo timcityosya cindu cakusakalaco pasikati penu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.7",
            "verseOrgIds": [
              "DEU.17.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
