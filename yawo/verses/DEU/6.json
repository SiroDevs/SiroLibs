            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.15",
            "verseOrgIds": [
              "DEU.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mkasimwatanda AMBUJE Mlungu jwenu, mpela mumwatendele ku Masa kula.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.16",
            "verseOrgIds": [
              "DEU.6.16"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.17.1+EXO.17.2+EXO.17.3+EXO.17.4+EXO.17.5+EXO.17.6+EXO.17.7"
              },
              "items": [
                {
                  "text": "Eks 17:1-7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.4.7"
              },
              "items": [
                {
                  "text": "Mat 4:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.4.12"
              },
              "items": [
                {
                  "text": "Luk 4:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.16",
            "verseOrgIds": [
              "DEU.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mlolecesye kuti mkugasunga cenene malamusi gosope gampele AMBUJE. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.17",
            "verseOrgIds": [
              "DEU.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mtendeje yele peyo yakumsalila AMBUJE kuti ayi ni yindu yambone ni yakulungamika, ni yindu yosope tiyicimjendela cenene. Timcipocela cilambo cambone ca cajila, cele ciŵatesile cilanga AMBUJE kuti tacicipeleka kwa acinangolo ŵenu, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.18",
            "verseOrgIds": [
              "DEU.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "nipo jemanja timcatoposya amagongo ŵenu, mpela muŵaŵecetele AMBUJE.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.19",
            "verseOrgIds": [
              "DEU.6.19"
            ]
          }
        }
