              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "AMBUJE",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.1",
            "verseOrgIds": [
              "LEV.11.1"
            ]
          }
        },
        {
          "text": " ŵasalile Mose",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.1",
            "verseOrgIds": [
              "LEV.11.1"
            ]
          }
        },
        {
          "text": " ni Aloni",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.1",
            "verseOrgIds": [
              "LEV.11.1"
            ]
          }
        },
        {
          "text": " kuti, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.1",
            "verseOrgIds": [
              "LEV.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ŵasalile Aisalaeli kuti yinyama yakwenela kulya, pasikati pa nyama syosope sya pacilambo ca pasi ni asi: ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.2",
            "verseOrgIds": [
              "LEV.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yinyama syosope yayiwete sajo syegaŵanice, ni syakulukula yakulya yetawunetawune kuti sitawune soni kaŵili, komboleka kulya syelesyo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.3",
            "verseOrgIds": [
              "LEV.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo akalya nyama asi: ngamila,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.4+LEV.11.5+LEV.11.6",
            "verseOrgIds": [
              "LEV.11.4",
              "LEV.11.5",
              "LEV.11.6"
            ]
          }
        },
        {
          "text": " njecele, kapena kalunga. Syelesi sili nyama syakunyalaya kwa jemanja, ligongo lyakuti atamose sikusalukula yakulya yetawunetawune kuti sitawune soni kaŵili, nambo sajo syakwe syangagaŵanika. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.4+LEV.11.5+LEV.11.6",
            "verseOrgIds": [
              "LEV.11.4",
              "LEV.11.5",
              "LEV.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akalya maguluŵe. Gelega gali gakunyalaya kwa jemanja, gakwete sajo syegaŵanice, nambo gangalukula yakulya yetawunetawune kuti gatawune soni kaŵili. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.7",
            "verseOrgIds": [
              "LEV.11.7"
            ]
          }
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.7",
            "verseOrgIds": [
              "LEV.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akalya nyama syelesi, soni naga sikuwa akasikwaya. Nyama syelesi sili syakunyalaya kwa jemanja.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.8",
            "verseOrgIds": [
              "LEV.11.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.8",
            "verseOrgIds": [
              "LEV.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya umi ya m'mesi yakwenela kulya ni ayi: Yosope ya m'mesi yayikwete yipyepye ni maŵamba, atamose yiŵe ya m'nyasa kapena ya mu lusulo, yeleyo mlyeje. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.9",
            "verseOrgIds": [
              "LEV.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo ya umi yosope ya m'nyasa kapena ya mu lusulo yangali yipyepye ni maŵamba, tuyilombo tosope twa m'mesi ni ya umi yosope yakusimanikwa mwelemo, jemanja mkalya yeleyo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.10",
            "verseOrgIds": [
              "LEV.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeleyo kwa jemanja yiŵeje yakunyalaya. Mkalya yeleyo kapena kuyikwaya yili yiwile. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.11",
            "verseOrgIds": [
              "LEV.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkalya cindu cilicose ca m'mesi ca umi, cangali yipyepye ni maŵamba, yeleyi yili yakunyalaya kwa jemanja.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.12",
            "verseOrgIds": [
              "LEV.11.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.12",
            "verseOrgIds": [
              "LEV.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Soni yijuni yangaŵajila kulya jemanja ni ayi: cimbanga, litumbusi, nyanga, namweŵe, ni yitotola ya mitundu josope, makungulu ga mitundu josope, mbuni, nalumbapala, ni mikokoko ja mitundu josope, namame, mbipe, ni linjici, liloya, cingwititi, masekwe, kakoŵa, kongwe jwa mitundu josope, ni ligolegole.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.13+LEV.11.14+LEV.11.15+LEV.11.16+LEV.11.17+LEV.11.18+LEV.11.19",
            "verseOrgIds": [
              "LEV.11.13",
              "LEV.11.14",
              "LEV.11.15",
              "LEV.11.16",
              "LEV.11.17",
              "LEV.11.18",
              "LEV.11.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.13+LEV.11.14+LEV.11.15+LEV.11.16+LEV.11.17+LEV.11.18+LEV.11.19",
            "verseOrgIds": [
              "LEV.11.13",
              "LEV.11.14",
              "LEV.11.15",
              "LEV.11.16",
              "LEV.11.17",
              "LEV.11.18",
              "LEV.11.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tuyilombo tosope twana mapapiko twaguluka, tuli twakunyalaya kwa jemanja. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.20",
            "verseOrgIds": [
              "LEV.11.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo pasikati pa tuyilombo twatukwete mapapikoto, mlyeje twele tukwete ngongolo sya kusumbila petaka. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.21",
            "verseOrgIds": [
              "LEV.11.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myoyo pa tuyilombo tweleto, komboleka kulya ayi: sombe sya mitundu josope, acigombamtiko ŵa mitundu josope, njelele sya mitundu josope, ni yitete ya mitundu josope. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.22",
            "verseOrgIds": [
              "LEV.11.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo tuyilombo twine tosope twaŵanaŵana, twatukwete mapapiko, twakwenda cakwaŵa, tweleto tuli twakunyalaya kwa jemanja.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.23",
            "verseOrgIds": [
              "LEV.11.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.23",
            "verseOrgIds": [
              "LEV.11.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 11:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundu jwalijose jwakujikwaya nyama jewe ja mtundu welewu, taciŵa jwamsakale mpaka lyuŵa kukapila. Nyama jilijose jajikwete yikotwa yangagaŵikana, nyama jangalukula yakulya yetawunetawune kuti jitawune soni kaŵili, ni nyama ja ngongolo mcece nambo jana yikalaŵesa kusajo kwakwe. Jwalijose jwakunyakula ciŵalo ca nyama jakuwajo ja mtundu welewujo, acape yakuwala yakwe, nambo taŵepe jwamsakale mpaka lyuŵa kukapila. Ligongo yeleyi yili yakunyalaya kwa jemanja.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.24+LEV.11.25+LEV.11.26+LEV.11.27+LEV.11.28",
            "verseOrgIds": [
              "LEV.11.24",
              "LEV.11.25",
              "LEV.11.26",
              "LEV.11.27",
              "LEV.11.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 11:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.24+LEV.11.25+LEV.11.26+LEV.11.27+LEV.11.28",
            "verseOrgIds": [
              "LEV.11.24",
              "LEV.11.25",
              "LEV.11.26",
              "LEV.11.27",
              "LEV.11.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 11:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sambano yinyama yakwaŵa yele yili yakunyalaya kwa jemanja ni ayi: nyenga, uko, mapuku, ni acipulundwe ŵacakulungwakulungwa ŵa mitundu josope, ligondwa, sakata, namkwakwa, jusu, likwakwala, nampopo, ndamamlango, sato ni nalwiyi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.29+LEV.11.30",
            "verseOrgIds": [
              "LEV.11.29",
              "LEV.11.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 11:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeleyi yili yindu yakunyalaya kwa jemanja pasikati pa yinyama yakwaŵa yosope. Mundu jwakuyikwaya yeleyi yili yiwile, taciŵa jwamsakale mpaka lyuŵa kukapila. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.31",
            "verseOrgIds": [
              "LEV.11.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 11:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naga nyama syelesi sikugwila pa cindu cilicose sili siwile, cinduco ticiciŵa cakunyalaya, kanga ticiŵe ca citela, kanga cakuwala, kanga lipende, kanga cisaka, kapena cida cilicose cakukamulila masengo galigose. Cinduco aciloŵece m'mesi, nambo ticiciŵa cakunyalayape mpaka lyuŵa kukapila. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.32",
            "verseOrgIds": [
              "LEV.11.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LEV 11:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naga cilicose ca yeleyi cikugwila mciŵiga cakugumba ni litaka, yosope yayili mkati mwakwe tiyiŵe ya usakwa, soni ciŵigaco acikase. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.33",
            "verseOrgIds": [
              "LEV.11.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LEV 11:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naga mesi ga mciŵigamo akutaga pa cakulya cilicose, cakulyaco ticiciŵa ca usakwa. Cakumwa cilicose cakumwa mu mpika wa mtundu welewo ticiciŵa ca usakwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.34",
            "verseOrgIds": [
              "LEV.11.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LEV 11:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cindu cilicose cacigwilile ciŵalo ca nyama jewe, cinduco cili ca usakwa, kanga cinduco cili mbaula jakugumba ni litaka kapena ufuni, yosopeyo ayikasanye, pakuŵa yosopeyo yili ya usakwa kwa jemanja. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.35",
            "verseOrgIds": [
              "LEV.11.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LEV 11:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo uliŵa kapena cisima ca mesi tiyiciŵa yambone, nambo jwalijose jwakutyosya nyama jewejo taciŵa jwamsakale. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.36",
            "verseOrgIds": [
              "LEV.11.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LEV 11:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naga ciŵalo cilicose ca nyama jewe, cikugwila pa mbeju jakuti ŵandu apande, mbeju jelejo jiŵejepe jambone. ",
          "type": "text",
          "attrs": {
