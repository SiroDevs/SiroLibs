          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuti mlekanganyeje pasikati pa yakunyalaya ni yanganyalaya, soni ni pasikati pa ya umi yele yimkwenela kulya ni ya umi yingamkwenela kulya.",
          "type": "text",
          "attrs": {
