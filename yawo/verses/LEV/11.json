              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuŵa Une ndili AMBUJE, ŵinamkopwesye ku cilambo ca Iguputo kuti m'mbe Mlungu jwenu. Myoyo mtameje ŵaswela, pakuŵa Une ndili jwamswela.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.45",
            "verseOrgIds": [
              "LEV.11.45"
            ]
          }
        }
