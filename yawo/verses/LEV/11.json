              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lyeleli ni lilamusi lyakusala ya yinyama, yijuni, ca umi cilicose cakwenda m'mesi, ni cindu cilicose cakwaŵa pasi, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.46",
            "verseOrgIds": [
              "LEV.11.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
