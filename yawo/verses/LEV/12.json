          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo naga nganakola mwanace jwangondolo, ajigale ngunda siŵili kapena mawunda gangunda gaŵili, jimo jiŵe ja mbopesi jakutinisya, soni jinejo jiŵe jakutaga mbopesi jakwaŵenda AMBUJE kululucila ulemwa. Ni jwamkongwejo tatendekwe kuŵa jwamswela.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.12.8",
            "verseOrgIds": [
              "LEV.12.8"
            ]
          }
        },
