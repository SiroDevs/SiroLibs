                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.16.3+DEU.16.4+DEU.16.5+DEU.16.6+DEU.16.7+DEU.16.8"
              },
              "items": [
                {
                  "text": "Det 16:3-8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.6",
            "verseOrgIds": [
              "LEV.23.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa lisiku lyandanda lya masiku msano ni gaŵili, msonganeje ni kutenda mapopelo, soni mkakamula masengo genu ga lisiku ni lisiku. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.7",
            "verseOrgIds": [
              "LEV.23.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpelece mbopesi syenu sya yakulya kwa AMBUJE kwa masiku msano ni gaŵili. Pa lisiku lya msano ni gaŵili msonganeje soni kutenda mapopelo, nambo mkakamula masengo genu ga lisiku ni lisiku.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.8",
            "verseOrgIds": [
              "LEV.23.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.8",
            "verseOrgIds": [
              "LEV.23.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Patimkajinjile mcilambo citingampe une AMBUJE, ni ndaŵi jitimkagowole yakulya m'migunda jenu, mkayice ni mtambala wa yakulya yakomala pandanda kwa jwakutaga mbopesi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.9+LEV.23.10",
            "verseOrgIds": [
              "LEV.23.9",
              "LEV.23.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwalakwejo tacipeleka mpela mtuka wapadela kwa AMBUJE, pakuwuyuya mtambalawo myala mwakwe. Kuti AMBUJEWO ampocele jemanja. Jwakutaga mbopesijo tawupelece mtambalawo namalape Sabato, kundaŵi kwakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.11",
            "verseOrgIds": [
              "LEV.23.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa lisiku limkupeleka mtambala wa yakulya yakomala pandandayo, mpelece soni mbopesi jakutinisya kwa AMBUJE, ja ngondolo jamkambako ja caka cimo jangalemala. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.12",
            "verseOrgIds": [
              "LEV.23.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpelece soni mbopesi ja utandi pampepe ni ngondolojo, wakwanila makilogalamu gaŵili, wewanganye ni mawuta ga olifi",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.13",
            "verseOrgIds": [
              "LEV.23.13"
            ]
          }
        },
        {
          "text": " kuti jiŵe mbopesi ja yakulya. Liwungo lya mbopesi jeleji lili lyakwanonyela AMBUJE. Mpelece soni pamo ni yakupeleka yineyo, mbopesi ja yakumwa ya finyo, wakwanila lita jimo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.13",
            "verseOrgIds": [
              "LEV.23.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkalya tiligu jwasambanoju jwamjumu kapena jwamŵisi, kapena mkate, mkanilikwane lisiku lyakupeleka mbopesi jeleji, kwa Mlungu. Lyeleli lili lilamusi lya mpaka kalakala kwa yisukulu yenu yosope.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.14",
            "verseOrgIds": [
              "LEV.23.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Cindimba ca yagowola",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.14",
            "verseOrgIds": [
              "LEV.23.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mŵalanje milungu msano ni jiŵili, kutyocela kundaŵi kwakwe kwakumala kwa Sabato jele jimwapelece mtambala wa yakulya, ya m'migunda yandanda kukomala yila kwa AMBUJE.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.15",
            "verseOrgIds": [
              "LEV.23.15"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.23.16"
              },
              "items": [
                {
                  "text": "Eks 23:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.34.22"
              },
              "items": [
                {
                  "text": "34:22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.16.9+DEU.16.10+DEU.16.11+DEU.16.12"
              },
              "items": [
                {
                  "text": "Det 16:9-12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.15",
            "verseOrgIds": [
              "LEV.23.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa lisiku lya 50, panyuma pa Sabato ja msano ni kaŵili, mpelece soni mbopesi ja tiligu jwa sambano kwa AMBUJE. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.16",
            "verseOrgIds": [
              "LEV.23.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Liŵasa lililyose lijigale mikate jiŵili ni kujipeleka kwa AMBUJE mpela mbopesi ja padela. Mkate uliwose taciwupanganya ni utandi wewanganye ni cakusasaŵilisya wakwanila makilogalamu gaŵili. Nipo tacijipeleka mikatejo mpela mtuka wandanda wa yagowola ya tiligu, yakupeleka kwa AMBUJE. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.17",
            "verseOrgIds": [
              "LEV.23.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamo ni mikatejo likuga lya ŵandu lipelece ŵanace ŵangondolo msano ni ŵaŵili ŵa caka cimope, mwanace jwa ng'ombe jamkambako, ni ngondolo siŵili sya mkambako, syosopesi siŵe syangalemala. Syelesi siŵe mbopesi syakutinisya syakupeleka kwa AMBUJE, pamo ni mbopesi sya utandi ni sya yakumwa. Liwungo lya yakupeleka yeleyi likuŵa lyakwanonyelesya AMBUJE. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.18",
            "verseOrgIds": [
              "LEV.23.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 23:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpelece soni mbusi jamkambako jimo mpela mbopesi jakwaŵenda AMBUJE kululucila ulemwa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.19",
            "verseOrgIds": [
              "LEV.23.19"
            ]
          }
        },
        {
          "text": " Ni ŵanace ŵaŵili ŵangondolo sya mkambako, ŵa caka cimope, kuti aŵe mbopesi ja mkamulano.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.19",
            "verseOrgIds": [
              "LEV.23.19"
            ]
          }
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.19",
            "verseOrgIds": [
              "LEV.23.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 23:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwakutaga mbopesi tacipeleka mikate jakupeleka mtuka wa yagowola yandanda ya tiligu jila, pamo ni ŵanace ŵaŵili ŵangondolo sya mkambako mpela mbopesi ja padela. Yeleyi yili mbopesi jeswela jakupeleka kwa AMBUJE, jakasajigala ŵakutaga mbopesi kuti yiŵe yawo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.20",
            "verseOrgIds": [
              "LEV.23.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 23:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myoyo pa lyele lisikuli msonganeje pamo ni kutenda mapopelo, soni mkakamula masengo ga lisiku ni lisiku. Lyeleli liŵe lilamusi lya mpaka kalakala kwa jemanja mpakana yisukulu yenu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.21",
            "verseOrgIds": [
              "LEV.23.21"
            ]
          }
        }
      ]
    },
