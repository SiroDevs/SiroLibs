        {
          "text": "AMBUJE",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.1",
            "verseOrgIds": [
              "LEV.23.1"
            ]
          }
        },
        {
          "text": " ŵasalile Mose",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.1",
            "verseOrgIds": [
              "LEV.23.1"
            ]
          }
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.1",
            "verseOrgIds": [
              "LEV.23.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "malamusi gakumsalila jwalakwejo ya masiku gele Aisalaeli akwenela kusongana ni kutenda cindimba cakwalambila AMBUJE. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.2",
            "verseOrgIds": [
              "LEV.23.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkwete masiku msano ni limo gakukamula masengo genu, nambo mkaliŵalila kuti pa lisiku lya msano ni gaŵili, lisiku sabato, lili lisiku lyakupumula.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.3",
            "verseOrgIds": [
              "LEV.23.3"
            ]
          }
        },
        {
          "text": " Pa lyele lisikuli mkakamula masengo, nambo msongane kutenda mapopelo. Lisiku lyakupumula lili lyawo AMBUJE, mkalisunjeje kulikose kutimkatame.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.3",
            "verseOrgIds": [
              "LEV.23.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
