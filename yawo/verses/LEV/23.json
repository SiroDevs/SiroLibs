              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cindimba ca Pasaka",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.5",
            "verseOrgIds": [
              "LEV.23.5"
            ]
          }
        },
        {
          "text": " cikutanda ndaŵi jegulo, pa lisiku lya 14 lya mwesi wakutanda.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.5",
            "verseOrgIds": [
              "LEV.23.5"
            ]
          }
        },
        {
