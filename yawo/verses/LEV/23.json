                {
                  "text": "Eks 12:1-13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.16.1+DEU.16.2"
              },
              "items": [
                {
                  "text": "Det 16:1-2",
