        },
        {
          "text": "Nambo jwakutaga mbopesijo ali alolecesye, nakulola kuti liŵala lya cimbulukuku likuwoneka mwakusimasika ali acapile cakuwalaco, msyene cakuwalaco apapule liŵala lili pacakuwala cakupanganyidwa ni litonji kapena lipende. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.56",
            "verseOrgIds": [
              "LEV.13.56"
            ]
          }
        },
        {
