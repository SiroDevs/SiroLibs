          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "pelepo nikuti jwakulwalajo ali jwamsakale, Jwakutaga mbopesi akwenela kwenesya kuti ali jwamsakale, akwete ulwele wawukulungwa wa pa mtwe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.44",
            "verseOrgIds": [
