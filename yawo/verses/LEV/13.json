        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LEV 13:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo naga palulasipo pakuŵa pana liŵala lyeswela mwakucejela, welewo uli ulwele wawukulungwa wa pa cilu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.42",
