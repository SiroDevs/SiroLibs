          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "jwakutaga mbopesijo alamule kuti acicape cakuwalaco, ni aciŵice soni pambali kwa masiku msano ni gaŵili gane. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.54",
            "verseOrgIds": [
              "LEV.13.54"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
