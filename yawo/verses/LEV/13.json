          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo naga liŵangalyo lili pa malo pamo, nganilijendelecela pa cilu, soni likusimasika, lyelelyo lili litusa lya liŵangalyo, jwakutaga mbopesi ajenesye kuti ali cenene, ali mundu jwangasakala. Pakuŵa liŵasi lya liŵangalyo lili lya moto cabe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.28",
            "verseOrgIds": [
              "LEV.13.28"
            ]
          }
        }
      ]
    },
    {
