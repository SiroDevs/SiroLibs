          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwakutaga mbopesijo acilolecesye soni cakuwala cecape cila, naga liŵala lya cimbulukuku cila lili ciŵela lya cisamba kapena lyecejewu, atamose kuti nganilijendelela pa cakuwala, celeco cili ciŵela cesakale. Msyene cakuwalaco acijoce, pangaganicisya yakuti liŵala lya cimbulukuku lili cakumeso, kapena kunyuma kwa cakuwalaco. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.55",
            "verseOrgIds": [
              "LEV.13.55"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "56",
            "style": "v",
