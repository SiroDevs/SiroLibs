          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "kapena nguwo jakupanganyidwa ni litonji kapena ni manyunya, soni lipende kapena cindu cilicose cakupanganyidwa ni lipende, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.48",
            "verseOrgIds": [
              "LEV.13.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "LEV 13:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "naga cimbulukukuco cikuwoneka ca mtundu wacisamba kapena wecejewu pa cakuwalaco, msyene cakuwalaco akacilosye kwa jwakutaga mbopesi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.49",
            "verseOrgIds": [
              "LEV.13.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "LEV 13:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwakutaga mbopesi acilolecesye cakuwala cicikwete cimbulukukuco. Aciŵice pambali kwa masiku msano ni gaŵili. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.50",
            "verseOrgIds": [
              "LEV.13.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "LEV 13:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa lisiku lya msano ni gaŵili acilolecesye soni cakuwalaco, naga cimbulukukuco cijenele pa cakuwala, kapena pa lipende lyakutendela masengo ga mtundu uliwose, liŵaliŵisile pa mbali lila, celeco cili cimbulukuku cakogoya, soni cakuwalaco cili cesakale. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.51",
            "verseOrgIds": [
              "LEV.13.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "LEV 13:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwakutaga mbopesijo acijoce cakuwalaco, ligongo mtundu wa cele cimbulukukuco, ukwenela kuwujonanga pakuwujoca ni moto.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.52",
            "verseOrgIds": [
              "LEV.13.52"
            ]
          }
        }
      ]
    },
