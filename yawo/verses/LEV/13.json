          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naga cakuwala cakupanganyidwa ni manyunya kapena ni litonji cikwete cimbulukuku, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.47",
            "verseOrgIds": [
              "LEV.13.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
