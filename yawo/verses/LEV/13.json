          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myoyo jwakutaga mbopesi amlolecesye jwakulwalajo, naga liŵala lyakuyimbalyo likuŵa lyeswela mwakucejela pa lulasipo, mpela mwele mugakusawonecela matana pa cilu, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.43",
            "verseOrgIds": [
              "LEV.13.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
