                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.17.14"
              },
              "items": [
                {
                  "text": "17:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.2",
            "verseOrgIds": [
              "LEV.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "jwakutaga mbopesijo akopoce kusa kwa masakasa, ni amlolecesye jwakulwalajo. Naga jwakulwalajo akumwona kuti aposile, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.3",
            "verseOrgIds": [
              "LEV.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "jwakutaga mbopesijo ŵalamule ŵandu kuti, akamjigalile jwakulwala jwakuti amswejesyejo yindu ayi: yijuni ya umi yiŵili, yele ŵa Yuda akukundidwa kulya, lunyambi lwa citela ca mkungusa, kaguwo kecejewu ni liwupulu lya katela ka hisope.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.4",
            "verseOrgIds": [
              "LEV.14.4"
            ]
          }
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.4",
            "verseOrgIds": [
              "LEV.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwakutaga mbopesijo ŵalamule ŵanduwo kuti cijuni cimo aciwulajile mu mbale ja litaka, muli mwana mesi ganatekape pa cisima. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.5",
            "verseOrgIds": [
              "LEV.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwakutaga mbopesi ajigale cijuni cine cila pamo ni lujambi lwa citela ca mkungusa cila, kaguwo kecejewu kala ni liwupulu lya katela ka hisope kala. Yosopeyo pamo ni cijuni ca umico, ayicuye m'miasi ja cijuni ciŵaciwulajile mu mbale ja litaka jila muli mwana mesi ganatekape pa cisima gala ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.6",
            "verseOrgIds": [
              "LEV.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwakutaga mbopesi ajimise m'miasi kasano ni kaŵili pa cilu ca mundu jwaposile ulwele wa pa cilu, jwakusosa kumswejesyajo. Ni papopo ajenesye kuti jwakulwalajo ali jwamswela, ni acigulucisye kwitinji cijuni ca umico. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.7",
            "verseOrgIds": [
              "LEV.14.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwakulwala jwaposile jwamswejesyejo, acape yakuwala yakwe, amyole umbo syakwe syosope, soni ajoje cilu cakwe, ali atesile myoyo taciŵa mundu jwamswela, jwangali cakusakala. Ali amasile yosopeyi ajawule kugali masakasa, nambo aŵe kusa kwa tenti jakwe kwa masiku msano ni gaŵili. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.8",
            "verseOrgIds": [
              "LEV.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa lisiku lya msano ni gaŵililyo, amyole umbo mtwe wakwe wosope. Amyole soni ndewu pamo ni ngwimbi syakwe, ni umbo sine syosope sili pa cilu pakwe. Panyuma pakwe acape yakuwala yakwe, soni ajoje, ali amasile yosopeyi taciŵa mundu jwamswela, mundu jwangali cakusakala.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.9",
            "verseOrgIds": [
              "LEV.14.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.9",
            "verseOrgIds": [
              "LEV.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa masiku msano ni gatatu, jwakulwalajo ajigale ŵanace ŵamkambako ŵaŵili ŵangondolo ŵangalemala, ni mwanace jwangondolo jumo jwa mkolo, jwangalemala, jwa caka cimo, ni mbopesi ja utandi wambone wa makilogalamu gatatu, wewanganye ni mawuta ga olifi,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.10",
            "verseOrgIds": [
              "LEV.14.10"
            ]
          }
        },
        {
          "text": " soni ni mawuta ga olifi gakukwanila mbali jimo ja matika gatatu ga lita jimo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.10",
            "verseOrgIds": [
              "LEV.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwakutaga mbopesi jutamswejesye jwakulwalajo, amjimice mundu jwakuti amswejesyejo pameso pa AMBUJE, pa mlango wa citenti cakusimanilana, pamo ni mbopesi syakwe syosope. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.11",
            "verseOrgIds": [
              "LEV.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwakutaga mbopesi ajigale mwanace jwangondolo jumo jamkambako, pamo ni mawuta ga olifi gakukwanila mbali jimo ja matika gatatu ga lita jimo, ni kuyipeleka mbopesi jakulipila magambo. Tayipelece kuti yiŵe mtuka wa padela, ali mkuyuya makono gakwe, kuti yiŵe mbopesi jakupeleka pameso pa AMBUJE. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.12",
            "verseOrgIds": [
              "LEV.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanace jwangondolojo amwulajile pa malo gamaswela, gele gakusawulajila nyama syakutaga mbopesi jakwaŵenda AMBUJE kululucila ulemwa",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.13",
            "verseOrgIds": [
              "LEV.14.13"
            ]
          }
        },
        {
          "text": " ni mbopesi syakutinisya. Atendeje yeleyi ligongo mbopesi jakulipila magambo jili jakwe jwakutaga mbopesi, mpela mujikuŵela mbopesi jakwaŵenda AMBUJE kululucila ulemwa. Yakupelekayo yili yeswela mnope. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.13",
            "verseOrgIds": [
              "LEV.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwakutaga mbopesijo akoŵe miasi ja ngondolo ja mbopesi jakulipila magambojo, ni kugapaka pa songa ja lipikanilo lya ku mkono wamlyo wa mundu jwakuti amswejesyejo. Agapace soni pacikongo ca ku mkono wamlyo, ni pacikongo ca lusajo lwa mkono wamlyo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.14",
            "verseOrgIds": [
              "LEV.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwakutaga mbopesi ajigale mawuta ga olifi panandi, ni kugataga mwigasa lyakwe lya kumciji, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.15",
            "verseOrgIds": [
              "LEV.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "soni aloŵece cala cakwe ca mkono wamlyo m'mawuta gali mwigasa lya mkono wakumcijiwo, ni kugamisa kasano ni kaŵili pameso pa AMBUJE. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.16",
            "verseOrgIds": [
              "LEV.14.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mawuta gakusigala mwigasa lya jwakutaga mbopesijo, agapace m'malo mosope muŵapacile miasi mula: pa songa ja lipikanilo lya ku mkono wamlyo wa mundu jwakuti amswejesye jula, soni pa cikongo ca ku mkono wamlyo pamo ni cikongo ca lusajo lwa ku mkono wamlyo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.17",
            "verseOrgIds": [
              "LEV.14.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mawuta gakusigala mwigasa lyakwe, agapace pa mtwe pa mundu jwakuti amswejesyejo, pakutenda myoyo ni kuti amtendele mundujo msyungu wakumswejesya. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.18",
            "verseOrgIds": [
              "LEV.14.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwakutaga mbopesi apelece soni mbopesi jine jakwaŵenda AMBUJE kululucila ulemwa, ni kutenda msyungu wakumswejesya mundu jwakulwala jula. Panyuma pakwe jwakutaga mbopesijo awulaje nyama jakupelecela mbopesi jakutinisya, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.19",
            "verseOrgIds": [
              "LEV.14.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "pambesi ali amasile kusinga nyamajo, pa malo gakupelecela mbopesi pamo ni mbopesi ja utandi. Pakutenda myoyo nikuti jwakutaga mbopesi atesile msyungu wakwaŵenda AMBUJE kumkululucila ulemwa mundu jwakulwalajo, pelepo jwakulwalajo taciŵa jwamswela.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.20",
            "verseOrgIds": [
              "LEV.14.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.20",
            "verseOrgIds": [
              "LEV.14.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo naga mundu jwakulwalajo ali jwakulaga, soni cipanje cakwe cili camnono, ajigale mwanace jumope jwangondolo jamkambako, kuti apelece mbopesi jakulipa magambo. Ajipelece kuti jiŵe mtuka wa padela, ali mkuyuya makono gakwe. Apelece soni kilogalamu jimo ja utandi wambone, wewanganye ni mawuta ga olifi, kuti yiŵe mbopesi ja utandi, soni ni mawuta ga olifi gakukwanila jimo ja matika gatatu ga lita jimo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.21",
            "verseOrgIds": [
              "LEV.14.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 14:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apelece soni njuŵa siŵili kapena mawunda ga ngunda gaŵili. Jimo jiŵe ja mbopesi jakwaŵenda AMBUJE kululucila ulemwa, jinejo jiŵe ja mbopesi jakutinisya. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.22",
            "verseOrgIds": [
              "LEV.14.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa masiku msano ni gatatu yosopeyo ayice nayo kwa jwakutaga mbopesi, pa mlango wa citenti cakusimanilana pameso pawo AMBUJE, kuti mundujo aswejesedwe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.23",
            "verseOrgIds": [
              "LEV.14.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 14:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwakutaga mbopesi ajigale mwanace jwangondolo ni mawuta ga olifi gala, ni ayipelece kuti yiŵe mtuka wa padela, ali mkuyuya makono gakwe, kuti jiŵe mbopesi jakulipa magambo, jakupeleka pameso pawo AMBUJE. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.24",
            "verseOrgIds": [
              "LEV.14.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 14:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ajiwulaje ngondolojo ni akoŵe miasi jakwe ni kujipaka pa songa ja lipikanilo lya ku mkono wamlyo wa mundu jwakuti amswejesyejo, ni pa cikongo ca ku mkono wamlyo, pamo ni cikongo ca lusajo lwa ku mkono wamlyo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.25",
            "verseOrgIds": [
              "LEV.14.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 14:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaneko jwakutaga mbopesi apungulile mawuta panandi mwigasa lyakwe lya kumciji, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.26",
            "verseOrgIds": [
              "LEV.14.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 14:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "agamise mawutago kasano ni kaŵili, ni cala ca ku mkono wamlyo pameso pa AMBUJE. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.27",
            "verseOrgIds": [
              "LEV.14.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 14:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apace mawuta gagogo m'malo mosope muwapacile miasi mula: pa songa ja lipikanilo lya ku mkono wamlyo wa mundu jwakuti amswejesye jula, soni agapace pa cikongo ca ku mkono wamlyo, pamo ni cikongo ca lusajo lwa ku mkono wamlyo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.28",
            "verseOrgIds": [
              "LEV.14.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 14:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mawuta gakusigala gali mwigasa lya jwakutaga mbopesi agapace pa mtwe pa mundu jwakuti amswejesyejo, pakutenda myoyo ni kuti amtendele mundujo msyungu wa kumswejesya. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.29",
            "verseOrgIds": [
              "LEV.14.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 14:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Panyuma pakwe apelece mpela mwapatile, njuŵa siŵili kapena mawunda ga ngunda gaŵili. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.30",
            "verseOrgIds": [
              "LEV.14.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 14:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asipelece siŵilisyo kuti jimo jiŵe ja kupeleka mbopesi jakwaŵenda AMBUJE kululucila ulemwa, jinejo jiŵe jakutaga mbopesi jakutinisya, pamo ni mbopesi ja utandi. Pakutenda myoyo nikuti jwakutaga mbopesijo atesile msyungu wa kwaŵenda AMBUJE, kumkululucila ulemwa mundu jwamswejesyejo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.31",
            "verseOrgIds": [
              "LEV.14.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 14:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ali ni lilamusi lya mundu jwakwete ulwele wawukulungwa pa cilu pakwe, nambo nganakola yakupeleka yakukwanila pa msyungu wa kuswejesya.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.32",
            "verseOrgIds": [
              "LEV.14.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Cimbulukuku ca m'nyumba",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 14:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.32",
            "verseOrgIds": [
              "LEV.14.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LEV 14:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "AMBUJE ŵamsalile Mose ni Aloni",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.33",
            "verseOrgIds": [
              "LEV.14.33"
            ]
          }
        },
        {
          "text": " kuti, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.33",
            "verseOrgIds": [
              "LEV.14.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LEV 14:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "patimkajinjile mcilambo ca Kenani, cilambo cingumpa kuti ciŵe cenu, naga mundu akuyiwona kuti une mbisile cimbulukuku pa nyumba jakwe, msyene nyumbajo akajawule kwa jwakutaga mbopesi, ni kumsalila kuti ngujiwona nyumba jangu kuti mpela jana cilwele. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.34+LEV.14.35",
            "verseOrgIds": [
              "LEV.14.34",
              "LEV.14.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LEV 14:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwakutaga mbopesijo alamule kuti akakoposye yindu yosope m'nyumbamo, mkananajawule kuja kujilola nyumbajo, kogopela nimkaŵa kuja kupwatikanya nyumba ni katundujo kuti yili yakusakala. Jwakutaga mbopesijo ajinjile m'nyumbamo kuti ajilole. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.36",
            "verseOrgIds": [
              "LEV.14.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LEV 14:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Acilolecesye cimbulukukuco. Naga cimbulukukuco cili mwipupa lya nyumba, soni cikuwoneka ni maŵala ga cisamba kapena gecejewu, ni naga cijinjile mpaka mkati mwa lipupa, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.37",
            "verseOrgIds": [
              "LEV.14.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LEV 14:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "jwakutaga mbopesi akopoce m'nyumbamo ni kwima pa mlango, ni ajiwugale nyumbajo kwa masiku msano ni gaŵili. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.38",
            "verseOrgIds": [
              "LEV.14.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LEV 14:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa lisiku lya msano ni kaŵili jwakutaga mbopesijo ayice soni kukujilola nyumbajo. Naga akuciwona kuti cimbulukukuco cijenele m'mapupa ga nyumbajo, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.39",
            "verseOrgIds": [
              "LEV.14.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LEV 14:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "alamule kuti atyosye maganga gakwete cimbulukukugo, ni akagajase kucitutu kusa kwa msinda. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.40",
            "verseOrgIds": [
              "LEV.14.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "LEV 14:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵasalile ŵandu kuti apalapate mapupa gosope mkati mwa nyumbajo, ni litaka lyapalapatilelyo akalijase kucitutu kusa kwa msinda. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.41",
            "verseOrgIds": [
              "LEV.14.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LEV 14:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myoyo ŵanduwo ajigale maganga gane ni kugajinjisya m'malo mwa maganga gaŵatyosisye gala, ni msyene nyumbajo ajigale litaka line ni kujisyasyajila nyumbajo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.42",
            "verseOrgIds": [
              "LEV.14.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LEV 14:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.42",
            "verseOrgIds": [
              "LEV.14.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LEV 14:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naga cimbulukukuco cikuwoneka soni ali atyosisye kala maganga gala, ni ali apalapatile ni kusyasyajila soni, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.43",
            "verseOrgIds": [
              "LEV.14.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "LEV 14:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "jwakutaga mbopesi ajawule soni kuja kujilola nyumbajo. Naga cimbulukuku cijenele soni m'nyumbamo, ni kuti cimbulukuku cacijenele m'nyumbamo cili cakogoya. Soni nyumbajo jili jesakale. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.44",
            "verseOrgIds": [
              "LEV.14.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "LEV 14:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ajigumule nyumbajo, maganga gakwe, yitela yakwe pamo ni litaka liŵasyasyajile nyumbajo, akayijase kucitutu kusa kwa msindawo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.45",
            "verseOrgIds": [
              "LEV.14.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "LEV 14:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundu jwajinjile m'nyumbamo, jwakutaga mbopesi ali ajiwugele, taŵe mundu jwamsakale mpaka ligulo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.46",
            "verseOrgIds": [
              "LEV.14.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "LEV 14:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundu jwagonile kapena kulila yakulya m'nyumbamo, acape yakuwala yakwe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.47",
            "verseOrgIds": [
              "LEV.14.47"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "LEV 14:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.47",
            "verseOrgIds": [
              "LEV.14.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "LEV 14:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo naga jwakutaga mbopesi ali ayice kujilolecesya nyumbajo, ni akusimana kuti cimbulukukuco nganicijendelecela, nyumbajo ali asyasyajile kala, jwakutaga mbopesijo ajenesye kuti nyumbajo jili jangasakala, jili cenene. Pakuŵa cimbulukuku mwangali. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.48",
            "verseOrgIds": [
              "LEV.14.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "LEV 14:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyumbajo ajiswejesye, msyene nyumbajo ajigale tujuni tuŵili, lujambi lwa citela ca mkungusa, ni kaguwo kecejewu ni liwupulu lwa katela ka hisope. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.49",
            "verseOrgIds": [
              "LEV.14.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "LEV 14:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwakutaga mbopesijo akawulajile kajuni kamo mu mbale ja litaka, muli mwana mesi ganatekape mcisima. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.50",
            "verseOrgIds": [
              "LEV.14.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "LEV 14:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ajigale lujambi lwa citela ca mkungusa, liwupulu lwa katela ka hisope, kaguwo kecejewu, pamo ni kajuni ka umi kala, ayicuye yosopeyi m'miasi ja kajuni kakawuleje kala, ni m'mesi ganatekape mcisima gala, ni ajimisile nyumbajo kasano ni kaŵili. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.51",
            "verseOrgIds": [
              "LEV.14.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "LEV 14:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ali atesile yeleyo ni kuti jwakutaga mbopesijo ajiswejesye nyumbajo, ni miasi ja cijuni, mesi ga mcisima ganatekape, cijuni ca umico, lujambi lwa citela ca mkungusa, liwupulu lwa katela ka hisope, soni ni kaguwo kecejewu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.52",
            "verseOrgIds": [
              "LEV.14.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "LEV 14:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cijuni ca umico acigulucisye kusa kwa msinda kuti cijawule kwitinji. Pelepo ni kuti jwakutaga mbopesi atesile msyungu wakujiswejesya nyumbajo, ni tijiŵe jeswela.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.53",
            "verseOrgIds": [
              "LEV.14.53"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
