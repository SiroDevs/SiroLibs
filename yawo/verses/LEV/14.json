          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.53",
            "verseOrgIds": [
              "LEV.14.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "LEV 14:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gelega ni malamusi ga cilwele cilicose cacikulungwa ca pa cilu, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.54",
            "verseOrgIds": [
              "LEV.14.54"
            ]
          }
        },
        {
