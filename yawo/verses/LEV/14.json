                "loc": "MRK.1.44"
              },
              "items": [
                {
                  "text": "Mak 1:44",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.5.14"
              },
              "items": [
                {
                  "text": "Luk 5:14",
