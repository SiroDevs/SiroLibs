              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundu jwamlume akagona ni mundu jwamlume mjakwe mpela mwakugonela ni mundu jwamkongwe. Cindu celeci cili cakunyalaya.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.22",
            "verseOrgIds": [
              "LEV.18.22"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
