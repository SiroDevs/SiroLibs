            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkagona ni ŵakongwe ŵakulwala ulwele wawo wacikongwe, ligongo ali ŵasakale.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.19",
