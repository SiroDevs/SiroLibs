            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkagona ni mundu jwalijose jwamlombele, ni mkaŵa kuŵa mundu jwamsakale.",
          "type": "text",
          "attrs": {
