        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 18:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaneko AMBUJE ŵaŵecete ni une acitiji kuti, “Mgapikanile malamusi gangu gakulekasya kukuya yindu yakunyalaya yele yiŵayitendaga ŵandu ŵiŵatamaga mcilambo, jemanja mkanimyice. Myoyo mkalisakasya pakutenda yindu ya mtundu welewo. Une AMBUJE Mlungu jwenu.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.30",
            "verseOrgIds": [
              "LEV.18.30"
            ]
          }
        }
      ]
