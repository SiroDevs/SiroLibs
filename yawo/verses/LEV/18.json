                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.22",
            "verseOrgIds": [
              "LEV.18.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundu jwamlume kapena jwamkongwe akagona ni cinyama, pakuŵa kutenda cindu ca mtundu welewo kuli kulemwa kwakukulungwa mnope.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.23",
            "verseOrgIds": [
