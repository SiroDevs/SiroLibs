        },
        {
          "text": "Mkasimumpeleka mwanace jwenu jwalijose kuti ampelece mbopesi pa ndaŵi ja mapopelo ga mlungu jwakolanjidwa Moleki, ni mkaŵa kulisakasya lina lya AMBUJE Mlungu jwenu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.21",
            "verseOrgIds": [
              "LEV.18.21"
            ]
          }
