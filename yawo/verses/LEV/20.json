                "loc": "LEV.18.15"
              },
              "items": [
                {
                  "text": "Lef 18:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.12",
            "verseOrgIds": [
              "LEV.20.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
