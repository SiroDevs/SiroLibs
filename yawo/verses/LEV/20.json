          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundu jwakugona ni ŵamkwawo babagwe, ni kuti ŵanyosisye ni kwawula babagwewo, wosopewo akwenela kuwulajidwa. Soni jemanjajo aliwulajisye acimsyene.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.11",
            "verseOrgIds": [
              "LEV.20.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
