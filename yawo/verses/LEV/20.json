              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "AMBUJE ŵapelece malamusi gakuyicisyaga gakuti: Mundu jwalijose jwakwalwesa babagwe ni mamagwe akwenela kuwulajidwa. Jwalakwejo aliwulajisye msyene.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.9",
            "verseOrgIds": [
              "LEV.20.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
