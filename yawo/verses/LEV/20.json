              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naga mundu akutenda cikululu ni jwamkongwe jwamsyene, jwamlumejo pamo ni jwamkongwejo awulajidwe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.10",
