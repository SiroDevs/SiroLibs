          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naga mundu akugona ni mundu jwamlume mjakwe mpela jwamkongwe, wosopewo atesile cindu cawusakwa, wosopewo akwenela kuwulajidwa. Jemanjaji aliwulajisye acimsyene.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.13",
            "verseOrgIds": [
              "LEV.20.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
