          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naga mundu jwamlume akugona ni alumbu ŵawo babagwe, kapena alongo ajawo mamagwe, akwenela kupocela cilango ŵana ŵaŵili, ligongo lyakutenda yindu yakusakala mnope.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.19",
            "verseOrgIds": [
              "LEV.20.19"
            ]
          }
        },
        {
          "name": "note",
