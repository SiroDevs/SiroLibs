            "number": "18",
            "style": "v",
            "sid": "LEV 20:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naga mundu jwamlume akugona ni jwamkongwe jwakulwala ulwele wakwe wacikongwe, ŵatyosye ŵana ŵaŵili pasikati pa ŵandu, ligongo ali ŵasakale.",
