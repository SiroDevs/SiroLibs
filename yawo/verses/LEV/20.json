              },
              "items": [
                {
                  "text": "Lef 18:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.13",
            "verseOrgIds": [
              "LEV.20.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 20:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naga mundu akulombela jwamkongwe, soni nakulombela mamagwe jwamkongwejo, kutenda myoyo kuli kulemwa kwakukulungwa mnope. Akwenela kwajoca moto ŵandu wosopewo. Kuti cindu cakutesya soni ca mtundu welewo cikatendekwa soni pasikati penu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.14",
            "verseOrgIds": [
              "LEV.20.14"
            ]
          }
        },
        {
          "name": "note",
