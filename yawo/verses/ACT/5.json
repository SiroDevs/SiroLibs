                "loc": "MAT.27.25"
              },
              "items": [
                {
                  "text": "Mat 27:25",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 5:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.28",
            "verseOrgIds": [
              "ACT.5.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ACT 5:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo Petulo ni ŵandumetume ŵane ŵajanjile kuti, “Tukwenela kumpikanila Mlungu kupunda kupikanila mundu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.29",
            "verseOrgIds": [
              "ACT.5.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ACT 5:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mlungu juŵamlambilaga acinangolo ŵetu ŵamjimwisye Yesu ku ŵawe, jwele jemanja mwamwuleje pakumkomela pa msalaba. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.30",
            "verseOrgIds": [
              "ACT.5.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ACT 5:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mlungu ŵamkwesisye jwelejo ku mkono ŵakwe wamlyo kuti aŵe jwakulongolela soni Mkulupusyo. Ŵatesile yeleyi kwapa Aisalaeli upile wakupitikuka mtima kuti ulemwa",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.31",
            "verseOrgIds": [
              "ACT.5.31"
            ]
          }
        },
        {
          "text": " wawo akululucidwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.31",
            "verseOrgIds": [
              "ACT.5.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ACT 5:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwe tuli mboni sya yindu yeleyi, nipo soni Msimu Ŵaswela ŵele Mlungu ŵapelece kwa ŵandu ŵiŵampikanilaga jwalakwejo.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.32",
            "verseOrgIds": [
              "ACT.5.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ACT 5:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.32",
            "verseOrgIds": [
              "ACT.5.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ACT 5:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Piŵapikene yeleyi ŵanganyawo, ŵatumbile mnope ni ŵasosaga kwawulaga ŵandumetume ŵala. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.33",
            "verseOrgIds": [
              "ACT.5.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "ACT 5:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo jwine mwa jemanjajo, Mfalisi",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.34",
            "verseOrgIds": [
              "ACT.5.34"
            ]
          }
        },
        {
          "text": " lina lyakwe Gamaliele,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.34",
            "verseOrgIds": [
              "ACT.5.34"
            ]
          }
        },
        {
          "text": " mwalimu jwa Malamusi jwele ŵandu wosope ŵamcimbicisyaga, ŵajimi mu nganyamo. Ni ŵalamwile kuti ŵandumetumewo ajawule kaje kusa. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.34",
            "verseOrgIds": [
              "ACT.5.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "ACT 5:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nipo ŵasalile ŵanganyawo kuti, “Aisalaeli acimjangu, mkalamuce ni yele yimkuti mwatende ŵandu aŵa. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.35",
            "verseOrgIds": [
              "ACT.5.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "ACT 5:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pajatu ngaŵa kalakala mnope mundu jwine lina lyakwe Teudasi ŵawonecele kwa ŵandu nikulimanyisyaga, nipo ŵandu ŵajinji ŵakwana mpela 400 ŵamkuyisye. Jwalakwe ŵawulajidwe nipo ŵandu wosope ŵiŵamkuyaga ŵapwilingene niyamalile pelepo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.36",
            "verseOrgIds": [
              "ACT.5.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "ACT 5:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaneka ndaŵi ja kalembela, jwayice soni jwine lina lyakwe Yudasi jwa ku Galileya, ŵandu ŵajinji ŵamjiticisye ni kumkuya, nombe najo jwawulajidwe nipo wosope ŵiŵamkuyaga ŵapwilingene soni. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.37",
            "verseOrgIds": [
              "ACT.5.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "ACT 5:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni ligongo lyakwe pa ngani jeleji ngumsalila sambano kuti, mwalece ŵanduŵa kuti ajawuleje. Naga yakuganisya jemanjaji pampepe ni yakutendayi yili yakutyocela kwa ŵandu, tiyicimala jika. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.38",
            "verseOrgIds": [
              "ACT.5.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "ACT 5:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo naga yilikutyocela kwa Mlungu, jemanja ngamyikombola kose kuyilekasya, mwine mwakwe timsimanikwe kuti mkulimbana ni Mlungu.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.39",
            "verseOrgIds": [
              "ACT.5.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "ACT 5:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.39",
            "verseOrgIds": [
              "ACT.5.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "ACT 5:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵanganyawo ŵajiticisye yiŵaŵecete Gamaliele yila, ni ŵaŵilasile ŵandumetumewo. Ŵaputile, ni ŵalekasisye kuti akasaŵeceta soni mu lina lya Yesu, nipo ŵakundile kuti ajawuleje. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.40",
            "verseOrgIds": [
              "ACT.5.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "ACT 5:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵandumetumewo ŵatyosile ku nganyako ali mkusangalala kuti Mlungu ŵatesile aŵe ŵakwenela kunyosyedwa kwa ligongo lya lina lya Yesu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.41",
            "verseOrgIds": [
              "ACT.5.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "ACT 5:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nipo lisiku lililyose ŵaliji mkwiganya ni kulalicila m'Nyumba ja AMBUJE ni m'majumba ga ŵandu Ngani Syambone",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.42",
            "verseOrgIds": [
              "ACT.5.42"
            ]
          }
        },
        {
          "text": " syakuti Yesu Klistu ni Mkulupusyo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.42",
            "verseOrgIds": [
              "ACT.5.42"
            ]
          }
        }
      ]
    }
