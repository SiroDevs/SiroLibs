          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paulo ŵatemi kweleko kwa yaka yiŵili yamtundu m'nyumba jakwasima jila. Nipo ŵaliji mkwapocela cenene wosope ŵiŵaliji mkwisa kukumlola. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.30",
            "verseOrgIds": [
              "ACT.28.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ACT 28:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵalalicile ya Ucimwene wa Mlungu ni kwiganya ya Ambuje Yesu Klistu",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.31",
            "verseOrgIds": [
              "ACT.28.31"
            ]
          }
        },
        {
          "text": " pakulanguka pangajogopa jwine kumlekasya.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.31",
            "verseOrgIds": [
              "ACT.28.31"
            ]
          }
        }
      ]
