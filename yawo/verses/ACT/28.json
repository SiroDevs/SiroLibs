{
  "id": "ACT.28",
  "number": "28",
  "bookId": "ACT",
  "reference": "Mase 28",
  "verseCount": 31,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "28",
        "style": "c",
        "sid": "ACT 28"
      },
      "items": [
        {
          "text": "28",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Paulo pa cilumba ca Melita",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 28:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pitwakulupwice myoyo, twapikene kuti cilumbaco lina lyakwe Melita. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.1",
            "verseOrgIds": [
              "ACT.28.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 28:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵandu ŵakwe ŵaliji ŵambone mnope. Ŵatupocele cenene, ni ŵatukolecesye moto kuti tujote ligongo kwatandite kugwa ula nipo kwasisimaga. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.2",
            "verseOrgIds": [
              "ACT.28.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 28:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paulo ŵanyakwile litenje lya sasu nipo piŵaŵikaga pa moto lijoka lyakopwece mwitenjemo ligongo lya mtukuta ŵa motowo nipo lyamlumile ni kanilila pa mkono wakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.3",
            "verseOrgIds": [
              "ACT.28.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 28:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵandu ŵala piŵaliweni lijoka lili kulele pa mkono wa Paulo ŵasalilene kuti, “Mundu aju ali jwa kuwulaga ŵandu, soni atamose akulupwice m'nyasa nambo sambano tawe.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.4",
            "verseOrgIds": [
              "ACT.28.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 28:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo Paulo ŵalipukwinye lijokalyo mpaka lyagwilile pa moto nipo jwalakwe nganawulala kose amta panandi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.5",
            "verseOrgIds": [
              "ACT.28.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 28:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵandu ŵala ŵajembecelaga kuti mkono wa Paulo tiwuyimbe kapena kuti tagwe mwacisisimucisya ni kuwa. Nambo ŵajembecele ndaŵi jajilewu, nipo piŵaweni kuti pangali cindu cilicose ca cilendo catendecekwe, ni ŵasindile nganisyo syawo acitiji, “Jweleju ali jumo jwa milungu.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.6",
            "verseOrgIds": [
              "ACT.28.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 28:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.6",
            "verseOrgIds": [
              "ACT.28.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 28:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuŵandikana ni malopo paliji pana migunda ja Pabuliyo, jwamkulungwa jwa pa cilumbapo. Jwalakwejo ŵatupocele cenene ni ŵatusamalile kwa masiku gatatu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.7",
            "verseOrgIds": [
              "ACT.28.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 28:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babagwe Pabuliyo ŵaliji cigonele ligongo lyakulwala ciwawasa ni kuwugula m'matumbo mwa miasi. Paulo ŵajinjile muŵaliji babagwe Pabuliyo ni ŵapopesile, ni ŵamsajice magasa ni kumposya. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.8",
            "verseOrgIds": [
              "ACT.28.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 28:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Piyatendekwe yeleyi, ŵandu wosope ŵaŵaliji mkulwala pa cilumbapo ŵayice nipo Paulo ŵaposisye. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.9",
            "verseOrgIds": [
              "ACT.28.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 28:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵandu ŵala ŵatupele mituka jejinji, nipo pitwatyokaga ni combo pa ulendo wetu ŵatupele yosope yakusosekwa pa ulendowo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.10",
            "verseOrgIds": [
              "ACT.28.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kutyoka ku Melita kwawula ku Loma",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 28:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.10",
            "verseOrgIds": [
              "ACT.28.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 28:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pijamasile miesi jitatu, twajesile mcombo cakutyocela ku Alekisandiliya cicatemi pa cilumba ndaŵi jakusisima. Nipo cakolanjidwaga kuti, “Milungu Jamaŵila.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.11",
            "verseOrgIds": [
              "ACT.28.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 28:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Twayice mu msinda wa Silakusi, ni twatemi kweleko masiku gatatu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.12",
            "verseOrgIds": [
              "ACT.28.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 28:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutyocela kweleko twajesile ni twayice mu msinda wa Legiyamu. Kundaŵi kwakwe mbungo ja mwela jatandite kupuga, nipo pakumala masiku gaŵili twayice ku Puteoli. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.13",
            "verseOrgIds": [
              "ACT.28.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 28:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kweleko twasimene acimjetu ŵakulupilila Ambuje ni ŵatuŵendile kuti tutame nawo kwa masiku msano kwisa gaŵili. Kaneko twayice ku Loma. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.14",
            "verseOrgIds": [
              "ACT.28.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 28:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Acimjetu ŵakulupilila Ambuje ŵa kweleko piŵapikene ngani syetu, ŵayice kutucingamila mpaka ku luŵala lwa Apiyo soni ku Nyumba sitatu sya acalendo. Paulo piŵayiweni yeleyi, ŵatogolele Mlungu ni ŵalimbile mtima.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.15",
            "verseOrgIds": [
              "ACT.28.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Paulo ŵalalicile Ayuda ku Loma",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 28:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.15",
            "verseOrgIds": [
              "ACT.28.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 28:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pitwayice mu msinda wa Loma, Paulo ŵamkundile kutama pajika ni msilikali jwakumlondela. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.16",
            "verseOrgIds": [
              "ACT.28.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 28:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pigamasile masiku gatatu, Paulo ŵaŵilasile acakulungwa ŵa Ayuda",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.17",
            "verseOrgIds": [
              "ACT.28.17"
            ]
          }
        },
        {
          "text": " ŵa kweleko. Piŵayice ŵasalile kuti, “Acalongo acimjangu, une ndili akuno mpela mkayidi jwakutyocela ku Yelusalemu. Atamose nganindenda yakulemwa kwa mtundu wangu, kapena misyungu ja acinangolo",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.17",
            "verseOrgIds": [
              "ACT.28.17"
            ]
          }
        },
        {
          "text": " ŵetu, nambotu ŵandaŵile ni kumbeleka kwa Aloma.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.17",
            "verseOrgIds": [
              "ACT.28.17"
            ]
          }
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.17",
            "verseOrgIds": [
              "ACT.28.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 28:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Piŵamasile kumbusya une, Alomawo ŵasacile kungopola, ligongo nganasimana ni magambo gakwenela kuti mbulajidwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.18",
            "verseOrgIds": [
              "ACT.28.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 28:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo piŵakanile Ayuda, nalimbicile kuŵenda kuti magambo gangu takalamule Mwenye jwa ku Loma",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.19",
            "verseOrgIds": [
              "ACT.28.19"
            ]
          }
        },
        {
          "text": " kuno. Ngaŵa kuti ngwete kandu kakwaŵecetela ŵandu ŵa mtundu wangu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.19",
            "verseOrgIds": [
              "ACT.28.19"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.25.11"
              },
              "items": [
                {
                  "text": "Mase 25:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.19",
            "verseOrgIds": [
              "ACT.28.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 28:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni ligongo lyakwe namŵilasile kuti mbecete namwe. Pakuti ndaŵidwe ni unyolowu ligongo lyakulupilila cindu cele Aisalaeli akwembecela.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.20",
            "verseOrgIds": [
              "ACT.28.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 28:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.20",
            "verseOrgIds": [
              "ACT.28.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 28:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jemanjajo ŵamjanjile Paulo kuti, “Uwe nganitupoceleje yikalata kutyocela ku Yudeya yakuŵeceta yenumwe, soni pangali jwine jwa acalongo acimjetu juŵayice akuno kutusalila ngani syakusakala syenumwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.21",
            "verseOrgIds": [
              "ACT.28.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 28:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo tukusaka mtusalile nganisyo syenu, ligongo tukumanyilila kuti palipose ŵandu akusisyana ni mpingo",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.22",
            "verseOrgIds": [
              "ACT.28.22"
            ]
          }
        },
        {
          "text": " wenuwu.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.22",
            "verseOrgIds": [
              "ACT.28.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 28:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.22",
            "verseOrgIds": [
              "ACT.28.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 28:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pelepo ŵapangene ni Paulo lisiku, nipo ŵandu ŵajinji ŵayice ku nyumba kwele Paulo ŵatamaga. Kutandila kundaŵi mpaka ligulo, Paulo ŵaliji mkwasalila ya Ucimwene wa Mlungu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.23",
            "verseOrgIds": [
              "ACT.28.23"
            ]
          }
        },
        {
          "text": " Nipo ŵasakaga kuti amkulupilile Yesu,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.23",
            "verseOrgIds": [
              "ACT.28.23"
            ]
          }
        },
        {
          "text": " pakwasalila Malamusi ga Mose",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.23",
            "verseOrgIds": [
              "ACT.28.23"
            ]
          }
        },
        {
          "text": " nambo soni ya m'mabuku ga ŵakulocesya. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.23",
            "verseOrgIds": [
              "ACT.28.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 28:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵane ŵakulupilile ni yiŵaŵeceteyo, nambo soni ŵane nganakulupilila. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.24",
            "verseOrgIds": [
              "ACT.28.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 28:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nganakamulana acimsyene pewo ni ŵatandite kutyoka pelepo piŵaŵecete Paulo maloŵe aga: “Msimu Ŵaswela ŵaŵecete yakuwona piŵasalile acinangolo ŵenu mwa jwakulocesya",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.25",
            "verseOrgIds": [
              "ACT.28.25"
            ]
          }
        },
        {
          "text": " Yesaya kuti, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.25",
            "verseOrgIds": [
              "ACT.28.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 28:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "‘Mjawule ni mkasalile ŵandu aŵa kuti,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.26",
            "verseOrgIds": [
              "ACT.28.26"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.6.9+ISA.6.10"
              },
              "items": [
                {
                  "text": "Yes 6:9-10",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ACT 28:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.27",
            "verseOrgIds": [
              "ACT.28.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 28:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paulo ŵasalile soni kuti, “M'manyilile sambano kuti, Mlungu akutumisya cikulupusyo kwa ŵandu ŵa mitundu jine.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.28",
            "verseOrgIds": [
              "ACT.28.28"
            ]
          }
        },
        {
          "text": " Jemanjajo tacipikana.” [",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.28",
            "verseOrgIds": [
              "ACT.28.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ACT 28:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Piŵaŵecete Paulo maloŵe gelega, Ayuda ŵala ŵatyosile ali mkukangana mnope.]",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.29",
            "verseOrgIds": [
              "ACT.28.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
