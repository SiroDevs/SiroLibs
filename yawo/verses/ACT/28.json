        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.29",
            "verseOrgIds": [
              "ACT.28.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
