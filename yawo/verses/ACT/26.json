                "loc": "ISA.42.6"
              },
              "items": [
                {
                  "text": "Yes 42:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.49.6"
              },
              "items": [
                {
                  "text": "49:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
