              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.23",
            "verseOrgIds": [
              "ACT.26.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 26:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paulo piŵaliji mkulicenjela, Fesito",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.24",
            "verseOrgIds": [
              "ACT.26.24"
            ]
          }
        },
        {
          "text": " ŵamkalipile acitiji, “Paulo, ana mtandite masoka! Kulijiganya kwenu kukumtendekasya masoka.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.24",
            "verseOrgIds": [
              "ACT.26.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 26:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.24",
            "verseOrgIds": [
              "ACT.26.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 26:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paulo ŵanjanjile kuti, “Une nganimba jwa masoka, Ŵalakwe Ŵakucimbicikwa! Yinguŵecetayi yili yakuwona soni ya lunda. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.25",
            "verseOrgIds": [
              "ACT.26.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 26:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenye Agilipa, akumanyilila yosopeyi ni ligongo lyakwe nguŵeceta pameso pawo mwagopoka. Ngukulupilila kuti pangali kandu kangakukamanyilila pa yeleyi, pakuŵa nganiyitendekwa mwakusisika. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.26",
            "verseOrgIds": [
              "ACT.26.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ACT 26:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenye Agilipa, ana akusakulupilila maloŵe ga ŵakulocesya? Ngumanyilila kuti akusakulupilila.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.27",
            "verseOrgIds": [
              "ACT.26.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ACT 26:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.27",
            "verseOrgIds": [
              "ACT.26.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 26:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apo Agilipa ŵatite kwa Paulo kuti, “Ana mkuganisya kuti mpaka mumbitikusye kuŵa mklistu kwa kandaŵi kakaka?”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.28",
            "verseOrgIds": [
              "ACT.26.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 26:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.28",
            "verseOrgIds": [
              "ACT.26.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ACT 26:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paulo ŵatite, “Atamose kwa kandaŵi kakanandi kapena ndaŵi jejinji, lipopelo lyangu kwa Mlungu ni lyakuti ŵalakwe ni wosope ŵene ŵakumbikana uneji lelo jino, kuti aŵe mumbelele uneji kutyosya unyolo pewu.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.29",
            "verseOrgIds": [
              "ACT.26.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ACT 26:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.29",
            "verseOrgIds": [
              "ACT.26.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ACT 26:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Papopo Mwenye Agilipa, bwanamkubwa,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.30",
            "verseOrgIds": [
              "ACT.26.30"
            ]
          }
        },
        {
          "text": " Belenise ni wosope ŵiŵaliji nawo ŵajimi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.30",
            "verseOrgIds": [
              "ACT.26.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ACT 26:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Piŵatyosilepo ŵasalilene kuti, “Munduju pangali cindu catesile cakwenela kuwulajidwa kapena kutaŵidwa.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.31",
            "verseOrgIds": [
              "ACT.26.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ACT 26:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nipo Agilipa ŵatite kwa Fesito, “Munduju tukamgopwele, akaŵe kuti nganaŵenda kuti Mwenye jwa ku Loma",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.32",
            "verseOrgIds": [
              "ACT.26.32"
            ]
          }
        },
        {
          "text": " talamule magambo gakwe.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.32",
            "verseOrgIds": [
              "ACT.26.32"
            ]
          }
        }
      ]
    }
