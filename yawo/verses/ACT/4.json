          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵandumetume ŵaliji mkutenda umboni mwamacili mnope kuti Ambuje Yesu ŵajimwice ku ŵawe, nombe Mlungu ŵaliji mkwapa upile wosope mwakwanila. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.33",
            "verseOrgIds": [
              "ACT.4.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "ACT 4:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paliji pangali mundu juŵaliji mkusoŵa kandu pasikati pawo, ligongo wosope ŵele ŵiŵakwete migunda pane nyumba ŵaliji mkuyisumisya, mbiya syakwesyo ŵapelekaga kwa ŵandumetume. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.34",
            "verseOrgIds": [
              "ACT.4.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "ACT 4:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nipo mbiyasyo ŵaliji mkwagaŵila ŵandu malingana ni kusoŵa kwawo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.35",
            "verseOrgIds": [
              "ACT.4.35"
            ]
          }
        }
      ]
