              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Likuga lya ŵakulupilila ŵala ŵaliji ni mtima umo, nganapagwa mundu juŵatiga kuti, yingwete yosope yili yanguyangupe, nambo jwalijose ŵaliji mkupeleka yakwe yosope kuti yiŵe ya wosope.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.32",
            "verseOrgIds": [
              "ACT.4.32"
            ]
          }
        },
        {
