              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paliji pana mundu jwine lina lyakwe Yosefe, jwa lukosyo lwa Lefi, jwakutyocela ku Saipulasi, jwele ŵandumetume ŵala ŵampele lina lyakuti Banaba, gopolela kwakwe “Jwakulimbisya mtima.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.36",
            "verseOrgIds": [
              "ACT.4.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
