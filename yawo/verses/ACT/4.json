          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nombe najo ŵasumisye mgunda wakwe, ni ŵajigele mbiya syakwe kuja kusipeleka kwa ŵandumetume.",
          "type": "text",
          "attrs": {
