          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵasumile mgunda ni mbiya siŵapatile pakutenda yangalumbana yila. Kweleko Yudasi ŵagwile cakulosya mtwe wakwe pasi, ni ŵawulice lutumbo, matumbo gakwe gosope gakusucile pasi.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.18",
            "verseOrgIds": [
              "ACT.1.18"
            ]
          }
        },
        {
          "name": "note",
