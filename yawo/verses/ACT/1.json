              "items": [
                {
                  "text": "Mat 27:3-8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.18",
            "verseOrgIds": [
              "ACT.1.18"
            ]
          }
        },
        {
          "name": "verse",
