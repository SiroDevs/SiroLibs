              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Sambano pakusosekwa jwine aŵe pampepe ni uwe kuti aŵe mboni jakuti Ambuje Yesu ŵajimwice ku ŵawe.",
          "type": "text",
          "attrs": {
