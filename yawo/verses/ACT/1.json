          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeleyi yapikanice kwa ŵandu wosope ŵakutama ku Yelusalemu, mwakuti mgundawo ŵaŵilanjidwaga m'ciŵeceto cawo kuti Akeledama, kugopolela kwakwe ni kuti “Mgunda wa miasi.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.19",
            "verseOrgIds": [
              "ACT.1.19"
            ]
          }
        }
      ]
