              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaneko ŵapitile ku Pisidiya nipo ŵayice ku Pamfiliya. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.24",
            "verseOrgIds": [
