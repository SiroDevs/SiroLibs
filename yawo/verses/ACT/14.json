          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutyocela kweleko ŵajesile mcombo kuwujila ku Antiokeya, kwele kuŵapelece jemanjajo kwa Mlungu kuti ŵape upile pa masengo gele sambano ŵaliji ali amalisisye.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.26",
