    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ya ku Aefeso",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 19:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apolo piŵaliji ku Kolinto, Paulo ŵajesile mu upande wa matumbi mcilambomo mpaka ŵayice ku Aefeso. Kweleko ŵasimene ŵane, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.1",
            "verseOrgIds": [
              "ACT.19.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "nipo ŵawusisye kuti, “Ana mwapocele Msimu Ŵaswela pa ndaŵi jimwakulupililejo?”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.2",
            "verseOrgIds": [
              "ACT.19.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jemanjajo ŵatite, “Atamose kupikana, nganitupikaneje kuti kwana Msimu Ŵaswela.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.2",
            "verseOrgIds": [
              "ACT.19.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.2",
            "verseOrgIds": [
              "ACT.19.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paulo ŵawusisye kuti, “Nambi mwapocele ubatiso wa mtunduci?” Jemanjajo ŵajanjile kuti, “Ubatiso wa Yohane.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.3",
            "verseOrgIds": [
              "ACT.19.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.3",
            "verseOrgIds": [
              "ACT.19.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paulo ŵatite kuti, “Yohane ŵabatisyaga ŵandu ŵiŵapitikwice mtima, nambo jwalakwe jwasalilaga ŵanduwo kuti amkulupilile jwine jwakwisa panyuma pakwe, jwelejo ni Yesu.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.4",
            "verseOrgIds": [
              "ACT.19.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
