        {
          "text": "Masiku gelego ŵayice ŵakulocesya ku Antiokeya kutyocela ku Yelusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.27",
            "verseOrgIds": [
              "ACT.11.27"
            ]
          }
        },
