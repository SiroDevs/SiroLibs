{
  "id": "ACT.11",
  "number": "11",
  "bookId": "ACT",
  "reference": "Mase 11",
  "verseCount": 30,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "11",
        "style": "c",
        "sid": "ACT 11"
      },
      "items": [
        {
          "text": "11",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Petulo akuwusalila mpingo wa ku Yelusalemu ngani sisyatendekwe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵandumetume pamo ni acimjawo ŵele ŵiŵaliji ku Yudeya, ŵapikene kuti ŵandu ŵa mitundu jine",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.1",
            "verseOrgIds": [
              "ACT.11.1"
            ]
          }
        },
        {
          "text": " apocele maloŵe ga Mlungu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.1",
            "verseOrgIds": [
              "ACT.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sambano Petulo",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.2",
            "verseOrgIds": [
              "ACT.11.2"
            ]
          }
        },
        {
          "text": " piŵayice ku Yelusalemu, ŵandu ŵane ŵiŵanonyelaga ya kuwumbala",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.2",
            "verseOrgIds": [
              "ACT.11.2"
            ]
          }
        },
        {
          "text": " ŵatandite kumnyosya Petulo acitiji, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.2",
            "verseOrgIds": [
              "ACT.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Wawo ŵajinjile m'nyumba sya ŵandu ŵangawumbala mpakana kulya nawo pamo.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.3",
            "verseOrgIds": [
              "ACT.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo Petulo ŵatandite kwasalila yosope muyaŵelele kutyocela pandanda pasyesyene acitiji:",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.4",
            "verseOrgIds": [
              "ACT.11.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.4",
            "verseOrgIds": [
              "ACT.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Une napopelaga mu msinda wa Yopa, natesile mpela komoka, kaneko naciweni cindu cili mkutuluka camti mpela nguwo jajikulungwa jajitaŵe songa mcece kutyocela kwinani, ni jayice pinaliji unepo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.5",
            "verseOrgIds": [
              "ACT.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndili mkucilolecesya celeco, nayiweni yinyama yakulanjidwa ni yamwitinji nipo soni yakwaŵa ni yijuni ya mwinani. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.6",
            "verseOrgIds": [
              "ACT.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nipo napikene maloŵe gakuti, ‘Petulo, mjimuce mwulaje mlye.’ ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.7",
            "verseOrgIds": [
              "ACT.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo natite, ‘Iyayi Ambuje, une nganindyeje wamba cindu cangaswejesya kapena cangalumbana.’ ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.8",
            "verseOrgIds": [
              "ACT.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo maloŵe gakutyocela kwinani gala gatite soni kuti, ‘Yele Mlungu yayiswejesye, mkayitenda yangalumbana.’ ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.9",
            "verseOrgIds": [
              "ACT.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeleyi yambonecele katatu, nipo yosopeyo yanyakulidwe kwawula kwinani. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.10",
            "verseOrgIds": [
              "ACT.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndaŵi jijojo ŵayice ŵandu ŵatatu ŵele ŵiŵatumile kwika ku nyumba kwele kunatamaga. Ŵanduwo ŵatyocele ku Kaisaleya. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.11",
            "verseOrgIds": [
              "ACT.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Msimu Ŵaswela ŵaliji ali asalile kuti njawule kweleko pangalolela kose mtundu wawo, nipo najawile nawo. Acimjangu msano ni jumo nombe nawo ŵambecesye une, nipo wosopewe twajinjile m'nyumba ja Koneliyo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.12",
            "verseOrgIds": [
              "ACT.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwalakwe jwatusalile yijwatite pakuliwona lilayika lili lijimi m'nyumba mwakwe ni kumsalila kuti, ‘Mwatume ŵandu ku Yopa kuti akamŵilanje Simoni",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.13",
            "verseOrgIds": [
              "ACT.11.13"
            ]
          }
        },
        {
          "text": " Petulo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.13",
            "verseOrgIds": [
              "ACT.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tamsalile maloŵe gaticimkulupusya pamo ni wosope ŵa mwiŵasa mwenu.’ ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.14",
            "verseOrgIds": [
              "ACT.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pinatandite kuŵeceta, Msimu Ŵaswela ŵayicilile jemanjajo mpela yiŵatite pakutuyicilila uwe pandanda pala. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.15",
            "verseOrgIds": [
              "ACT.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nipo nakumbucile maloŵe giŵaŵecete Ambuje gala kuti, ‘Yohane ŵabatisyaga ni mesi, nambo jemanja timcibatisidwa ni Msimu Ŵaswela.’",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.16",
            "verseOrgIds": [
              "ACT.11.16"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.1.5"
              },
              "items": [
                {
                  "text": "Mase 1:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.16",
            "verseOrgIds": [
              "ACT.11.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sambano naga Mlungu ŵapele mtuka jemanjajo wele wuŵatupele uwe pitwakulupilile Ambuje Yesu",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.17",
            "verseOrgIds": [
              "ACT.11.17"
            ]
          }
        },
        {
          "text": " Klistu,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.17",
            "verseOrgIds": [
              "ACT.11.17"
            ]
          }
        },
        {
          "text": " nambi une ndili ŵani kuti mpakana kombola kumlekasya Mlungu?” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.17",
            "verseOrgIds": [
              "ACT.11.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Piŵapikene gele maloŵega, ŵalesile ya kumnyosya nipo ŵamlumbile Mlungu acitiji, “Eti soni Mlungu ŵapele ŵandu ŵa mitundu jine upile wakupitikuka mtima ni kupocela umi wangamala.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.18",
            "verseOrgIds": [
              "ACT.11.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mpingo wa ku Antiokeya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.18",
            "verseOrgIds": [
              "ACT.11.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵandu ŵele ŵiŵapwilingene ŵala ligongo lya yisawusyo yiyabucile katema kele Sitefano kiŵawulajidwe, ŵapite kwika mpaka ku upande wa ku Fenisiya, ku cilumba ca Saipulasi, ni ku msinda wa Antiokeya. Ŵalalicilaga Ngani Syambone",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.19",
            "verseOrgIds": [
              "ACT.11.19"
            ]
          }
        },
        {
          "text": " kwa Ayudape.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.19",
            "verseOrgIds": [
              "ACT.11.19"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.8.1+ACT.8.2+ACT.8.3+ACT.8.4"
              },
              "items": [
                {
                  "text": "Mase 8:1-4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.19",
            "verseOrgIds": [
              "ACT.11.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo pasikati pawo papali ŵane ŵakutyocela ku Saipulasi ni ku msinda wa Kilene. Ŵapite kwika kwa Antiokeya nipo ŵalalicilaga Ngani Syambone sya Ambuje Yesu kwa ŵandu ŵa mitundu jine. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.20",
            "verseOrgIds": [
              "ACT.11.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Macili ga Ambuje galiji pa jemanjajo, nipo ŵandu ŵajinji ŵakulupilile ni ŵagalawucile kwa Ambuje.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.21",
            "verseOrgIds": [
              "ACT.11.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.21",
            "verseOrgIds": [
              "ACT.11.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngani syapikanice ku mpingo",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.22",
            "verseOrgIds": [
              "ACT.11.22"
            ]
          }
        },
        {
          "text": " wa ku Yelusalemu nipo watumisye Banaba ku Antiokeyako. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.22",
            "verseOrgIds": [
              "ACT.11.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Piŵayice Banaba ni kulola mwele Mlungu ŵapelele upile, ŵasangalele ni ŵasalicisye wosopewo kuti asimicisye mtima kuŵa ŵakulupicika kwa Ambuje. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.23",
            "verseOrgIds": [
              "ACT.11.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 11:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Banabajo jwaliji mundu jwambone, jwakulongoleledwa ni Msimu Ŵaswela ni cikulupi. Myoyo ŵandu ŵajinji ŵalipelece kwa Ambuje.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.24",
            "verseOrgIds": [
              "ACT.11.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 11:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.24",
            "verseOrgIds": [
              "ACT.11.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nipo Banaba ŵapite ku Talisasi kukumsosa Saulo.",
          "type": "text",
          "attrs": {
