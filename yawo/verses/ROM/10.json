          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.19",
            "verseOrgIds": [
              "ROM.10.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ROM 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo Yesaya ŵaŵecete mwakulimba mtima kuti,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.20",
            "verseOrgIds": [
              "ROM.10.20"
            ]
          }
        },
        {
          "name": "note",
