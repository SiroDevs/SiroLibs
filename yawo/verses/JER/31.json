          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "AMBUJE akuŵeceta kuti, “Ndaŵi jikwisa jitinjitenda cilanga",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.31",
            "verseOrgIds": [
              "JER.31.31"
            ]
          }
        },
        {
          "text": " casambano ni ŵandu ŵa ku Isalaeli ni ku Yuda.",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.31",
            "verseOrgIds": [
              "JER.31.31"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
