        {
          "text": "AMBUJE akuŵeceta soni kuti, “Ndaŵi jikwisa, jele msinda wa AMBUJE ula tiwucitaŵidwa kutyocela ku Sanja ja Hananele mpaka ku Cipata ca Ndumba. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.38",
            "verseOrgIds": [
              "JER.31.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JER 31:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutyocela pelepo malile gakwe tigacipelenganya mpaka Kwitumbi lya Galebu, ni kukotela kulola ku Gowa. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.39",
            "verseOrgIds": [
              "JER.31.39"
            ]
          }
        },
