          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.15",
            "verseOrgIds": [
              "JER.26.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 26:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Papopo acakulungwakulungwawo ni ŵandu ŵane ŵasalile ŵakutaga mbopesi ni ŵakulocesya kuti, “Munduju ngakwenela kuwa, pakuti aŵecete ni uwe mu lina lya AMBUJE, Mlungu jwetu.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.16",
            "verseOrgIds": [
              "JER.26.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 26:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.16",
            "verseOrgIds": [
              "JER.26.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 26:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Piyamasile yeleyo, acakulungwakulungwa ŵane ŵa mcilambo ŵajimi ni kwasalila ŵandu uŵasongene kuti, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.17",
            "verseOrgIds": [
              "JER.26.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 26:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ndaŵi jele Hesekiya ŵaliji mwenye jwa ku Yuda, Mika jwa ku Moleseti ŵalocesyaga, ni ŵasalile ŵandu wosope ŵa ku Yuda kuti AMBUJE Ŵamaciligosope akuŵeceta kuti,",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.18",
            "verseOrgIds": [
              "JER.26.18"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MIC.3.12"
              },
              "items": [
                {
                  "text": "Mik 3:12",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 26:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.19",
            "verseOrgIds": [
              "JER.26.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 26:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Jwapali mundu jwine juŵalocesyaga mu lina lya AMBUJE, lina lyakwe ŵaliji Uliya mwanace jwa Shemaya ŵa ku Kiliyati Yelimu. Jwalakwejo jwalocesye soni yitiyicitendekwa soni ku msinda awuno ni cilambo acino mpela muŵatendele Yelemiya. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.20",
            "verseOrgIds": [
              "JER.26.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 26:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pandaŵi jele Yehoiyakimu pamo ni acakulungwakulungwa ŵakwe ni ŵa ngondo ŵakwe, piŵapikene yiŵaŵecete, ŵasacile kumwulaga. Uliya piŵapikene yeleyo, ŵatesile woga nipo ŵatilile ku Iguputo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.21",
            "verseOrgIds": [
              "JER.26.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 26:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
