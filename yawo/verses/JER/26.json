            "number": "1",
            "style": "v",
            "sid": "JER 26:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pandaŵi jele Yehoiyakimu, mwanace jwa Yosiya mwenye jwa ku Yuda, piŵatandite kulamulila, AMBUJE",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.1",
            "verseOrgIds": [
              "JER.26.1"
            ]
          }
        },
        {
          "text": " ŵasalile Yelemiya kuti,",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.1",
            "verseOrgIds": [
              "JER.26.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "2 Ayi 23:36—24:6",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.36.5+2CH.36.6+2CH.36.7"
              },
              "items": [
                {
                  "text": "2 Mbi 36:5-7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.1",
            "verseOrgIds": [
              "JER.26.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 26:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mkajime mu luŵala lwa Nyumba ja AMBUJE. Kweleko mkaŵecete ni ŵandu wosope ŵakutama m'misinda ja ku Yuda, ŵakusaja kulambila ku Nyumba jelejo. Mkasalile jemanjajo yosope yene yinamlamwile kuti mkaŵecete ngaleka kandu kane kalikose. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.2",
            "verseOrgIds": [
              "JER.26.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 26:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwine mwakwe komboleka kuti tacipikanila, nipo jwalijose tacileka kutenda ulemwa",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.3",
            "verseOrgIds": [
              "JER.26.3"
            ]
          }
        },
        {
          "text": " wakwe. Myoyo ngasinapa jemanjajo cilango cinatite kuti nape, ligongo lya masengo gawo gakusakala.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.3",
            "verseOrgIds": [
              "JER.26.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 26:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.3",
            "verseOrgIds": [
              "JER.26.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 26:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkasalile jemanjajo kuti, AMBUJE akuŵeceta kuti, “Naga ngimkumbikanila une, soni naga ngimkukuya malamusi ginampele ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.4",
            "verseOrgIds": [
              "JER.26.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 26:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "soni naga ngimkugapikanila maloŵe ga ŵakulocesya, ŵakundumicila ŵangu, ŵimbele ndili mkwatuma kwa jemanja, atamose kuti nganimwapikanilaga. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.5",
            "verseOrgIds": [
              "JER.26.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 26:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naga mkupitilisya ungapikanila jemanjajo, tinjitenda ku Nyumba ajino yinatesile ku msinda wa Shilo, nipo msinda welewu tinjiwutendekasya kuŵa welwesece kwa mitundu josope ja pa cilambo capasi.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.6",
            "verseOrgIds": [
              "JER.26.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.18.1"
              },
              "items": [
                {
                  "text": "Yos 18:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.78.60"
              },
              "items": [
                {
                  "text": "Mas 78:60",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.7.12+JER.7.13+JER.7.14"
              },
              "items": [
                {
                  "text": "Yel 7:12-14",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 26:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.6",
            "verseOrgIds": [
              "JER.26.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 26:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵakutaga mbopesi, ŵakulocesya, ni ŵandu wosope ŵambikene une ndili mkuŵeceta yindu yeleyi m'Nyumba ja AMBUJE. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.7",
            "verseOrgIds": [
              "JER.26.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 26:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yelemiya piŵamasile kuŵeceta yiŵamsalile AMBUJE kuti ŵasalile ŵandu wosope, ŵakulocesya, ŵambopesi ni ŵandu wosopewo ŵamkamwile jwalakwejo, ni kumsalila kuti, “Mkwenela kuwulajidwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.8",
            "verseOrgIds": [
              "JER.26.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 26:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ana ligongo cici mlocesye mu lina lya AMBUJE kuti Nyumba ajino tijicijonanjidwa mpela msinda wa Shilo, nambo soni kuti msinda awuno tiwuciŵa wangali ŵandu mpela cipululu?” Myoyo ŵandu wosope tacisongana ni kumsinga Yelemiya ku Nyumba ja AMBUJE.",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.9",
            "verseOrgIds": [
              "JER.26.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 26:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.9",
            "verseOrgIds": [
              "JER.26.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 26:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Acakulungwa ŵa ku Yuda piŵapikene yiyatendekwagayo ŵanyakwice kutyocela ku nyumba ja mwenye kwawula ku Nyumba ja AMBUJE ni kutama pa luŵala lwawo ku cipata casambano ca Nyumba ja AMBUJE. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.10",
            "verseOrgIds": [
              "JER.26.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pelepo ŵakutaga mbopesi ni ŵakulocesya ŵasalile acakulungwakulungwawo ni ŵandu ŵane wosope kuti, “Mundu jweleju akwenela kuwulajidwa ligongo lyakuti alocesyeje yakusakala ya msinda awuno, mpela mumlipikanile jemanja mwacimsyene ni mapikanilo genu.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.11",
            "verseOrgIds": [
              "JER.26.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.11",
            "verseOrgIds": [
              "JER.26.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 26:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaneko Yelemiya ŵasalile acakulungwakulungwa ni ŵandu wosope ŵala kuti, “AMBUJE ŵatesile kunduma kuti njenesye maloŵe gosope ginagapikene gakujigamba nyumba ajino pamo ni msindawu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.12",
            "verseOrgIds": [
              "JER.26.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 26:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo sambano naga mkukolosya ndamo syenu ni masengo genu gakwe, ni kutanda kwapikanila AMBUJE Mlungu jwenu ni kuti jwalakwejo tacikululuka ngasampa cilango mpela mwele jwalakwejo muŵasacile. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.13",
            "verseOrgIds": [
              "JER.26.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 26:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Une ndili myala mwenu. Mtende cilicose cicikumnonyelesya. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.14",
            "verseOrgIds": [
              "JER.26.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 26:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo cakuti m'manyilile cili cakuti naga mkumbulaga ni kuti jemanja pamo ni msinda awuno ni ŵandu wosope ŵakutama mwelemo, timcigatanda magambo gakumwulaga mundu jwangalemwa. Yisyene kuti AMBUJE ni ŵiŵandumile une kwa jemanja kuti mpikane yosope yinguŵecetayi.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.15",
            "verseOrgIds": [
              "JER.26.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
