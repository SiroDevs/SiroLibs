        "style": "s1"
      },
      "items": [
        {
          "text": "Yelemiya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lina lyangu Yelemiya. Ndili jwakutaga mbopesi, mwanace jwa Hilikiya, jumo jwa ŵakutaga mbopesi ŵakutyocela ku msinda wa Anatoti mu upande wa lukosyo lwa Benjamini. Aga gali maloŵe ga AMBUJE",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.1",
            "verseOrgIds": [
              "JER.1.1"
            ]
          }
        },
        {
          "text": " giŵaŵecete ni une. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.1",
            "verseOrgIds": [
              "JER.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "AMBUJE ŵaŵecete ni une pandanda mu caka ca likumi ni yitatu pa ndaŵi jele Yosiya mwanace jwa Amoni ŵaliji mwenye jwa ku Yuda.",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.2",
            "verseOrgIds": [
              "JER.1.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "2 Ayi 22:3—23:27; 2 Mbi 34:8—35:19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.2",
            "verseOrgIds": [
              "JER.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "AMBUJE ŵapelengenye soni kuŵeceta ni une kupitila mu ndaŵi jele Yehoiyakimu mwanace jwa Yosiya jiŵaliji mwenye jwa ku Yuda mpaka pa mwesi wa msano wa caka ca likumi ni cimo ca ucimwene wa Sedekiya mwanace jwa Yosiya mwenye jwa ku Yuda, pa ndaŵi jiŵajigalidwe ŵandu ŵa ku Yelusalemu kuja ku ukapolo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.3",
            "verseOrgIds": [
              "JER.1.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "2 Ayi 23:36—24:7; 24:18—25:21",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.36.5+2CH.36.6+2CH.36.7+2CH.36.8"
              },
              "items": [
                {
                  "text": "2 Mbi 36:5-8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
