            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.2",
            "verseOrgIds": [
              "JER.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaneko Yelemiya ŵasalile jemanjajo kuti, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.3",
            "verseOrgIds": [
              "JER.21.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "mkasalile Sedekiya kuti, AMBUJE Mlungu jwa Aisalaeli akuti, “Tinjimsumula yida ya ngondo yayili myala mwenumo, yamkuputila ngondo ni mwenye jwa ku Babiloniya ni asilikali ŵakwe ŵa ngondo ŵele ŵamsyungulile jemanja pamo ni misinda jakwe. Tinjiyika nayo ni kuyiŵika mkati mwa msinda awuno. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.4",
            "verseOrgIds": [
              "JER.21.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Une namsyene tinjimenyana ni jemanja, ndili jwampye mtima, jwaukali ni jwakutumbila. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.5",
            "verseOrgIds": [
              "JER.21.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tinjiwulaga jwalijose jwakutama mu msindamo kwapwatikapo ni yilangwa yakwe, yosope yene tiyiciwa ni yilwele yakogoya. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.6",
            "verseOrgIds": [
              "JER.21.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaneko tinjimjawusya ku ukapolo Sedekiya mwenye jwa ku Yuda pamo ni nduna syakwe, ni ŵandu ŵakusigala mu msindamu ŵele ŵaŵakulupwice ku yilwele yakogoya, ku sala ni ku ngondo. Tinjapeleka jemanjajo myala mwa Mwenye Nebukadinesa, nambo soni kwa amagongo ŵawo ŵakusaka kwawulaga, Taciwulajidwa kusyesyene ni upanga mwangatendeledwa canasa.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.7",
            "verseOrgIds": [
              "JER.21.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.7",
            "verseOrgIds": [
              "JER.21.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "AMBUJE akuŵeceta kuti, “Ŵandu ŵeleŵa timwasalile soni kuti akwenela kusagula sikati ja umi ni ciwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.8",
            "verseOrgIds": [
              "JER.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwalijose jutasigale mu msinda awuno taciwa ni ngondo, sala kapena yilwele yakogoya. Nambo jwalijose jutacilipeleka kwa ŵandu ŵa ku Babiloniya ŵele ŵamsyungulile jemanja pamo ni misinda jakwe, mundu jwamti myoyojo tacikulupuka ni taciŵa ni umi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.9",
            "verseOrgIds": [
              "JER.21.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Une simicisye kuti tinjiwutenda yakusakala msinda welewu ngaŵaga yambone. Tiwucipelecedwa kwa mwenye jwa ku Babiloniya nipo jwalakwejo taciwucoma moto.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.10",
            "verseOrgIds": [
              "JER.21.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Cilango pa liŵasa lya mwenye jwa ku Yuda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.10",
            "verseOrgIds": [
              "JER.21.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sambano mkalisalile liŵasa lya mwenye jwa ku Yuda kuti, “Mpikane maloŵe ga AMBUJE, jemanja ŵa mwiŵasa lya Daudi,",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.11+JER.21.12",
            "verseOrgIds": [
              "JER.21.11",
              "JER.21.12"
            ]
          }
        },
        {
          "text": " AMBUJE akuti: Mlamuleje magambo pakukuya cilungamo kundaŵi kulikose, soni mwakulupusyeje kwa ŵandu ŵakulagasya acimjawo, mundu jwalijose jwajiŵilidwe katundu jwakwe, kogopela kuti lutumbilo lwangu lutakukolela ni kulepela kulusimisya ligongo lya ulemwa",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.11+JER.21.12",
            "verseOrgIds": [
              "JER.21.11",
              "JER.21.12"
            ]
          }
        },
        {
          "text": " wenu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.11+JER.21.12",
            "verseOrgIds": [
              "JER.21.11",
              "JER.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngumjimba magambo jemanja ŵandu ŵimkutama ku ciŵata, umkuŵa mpela lwala lwa mwilambo, AMBUJE akuŵeceta myoyo. Jemanja ŵimkusati kuti ana ŵani ŵampaka apute ngondo ni uwe? Ana ŵani ŵampaka ajinjile m'misinda mwetu? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.13",
            "verseOrgIds": [
              "JER.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tinjimpa cilango pakukuya masengo ga jemanja. Tinjicoma moto ma ukweti genu, moto tiwucitinisya yosope yayimsyungulile jemanja, Une AMBUJE nguŵeceta myoyo.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.14",
            "verseOrgIds": [
              "JER.21.14"
            ]
          }
        }
      ]
    }
  ],
