              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayi ni yiŵaŵecete AMBUJE",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.1",
            "verseOrgIds": [
              "JER.48.1"
            ]
          }
        },
