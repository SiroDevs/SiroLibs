          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "AMBUJE Ŵamaciligosope. Mlungu jwa Aisalaeli, aŵecete kuti, “Tinjipeleka cilango kwa Amoni, mlungu jwa Tebesi. Tinjipeleka soni cilango kwa Mwenye jwa ku Iguputo ni kwa wosope ŵakusamkulupilila jwalakwejo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.25",
            "verseOrgIds": [
              "JER.46.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 46:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tinjapeleka kwa ŵele ŵakusaka kwajonanga, kwa Nebukadinesa, mwenye jwa ku Babiloniya, ni acimlongola ŵakwe ŵa ngondo. Nambo pali papite ndaŵi, Iguputo taciŵa soni ni ŵandu mpela kalakala,” akuŵeceta myoyo AMBUJE.",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.26",
            "verseOrgIds": [
              "JER.46.26"
            ]
          }
        }
      ]
