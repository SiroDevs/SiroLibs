            "number": "12",
            "style": "v",
            "sid": "JER 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Une nawusisye kuti, “Ana jwalunda nduni jwampaka ayipikanicisye yeleyi? Ana AMBUJE",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.12",
            "verseOrgIds": [
              "JER.9.12"
            ]
          }
        },
        {
          "text": " ŵalondecesye ŵani, kuti jwele mundujo akalondecesye ŵane? Nambi ligongo cici cilambo cijonasice ni kuŵa cipululu mwangapita ŵandu?”",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.12",
            "verseOrgIds": [
              "JER.9.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.12",
            "verseOrgIds": [
              "JER.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "AMBUJE ŵajanjile kuti, “Ligongo lyakuti ŵandu ŵanguwo nganagakuya malamusi ginapele ni kungagapikanila maloŵe gangu ni kugasamalila. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.13",
            "verseOrgIds": [
              "JER.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo ŵagambaga kukuya yakulemwa ya m'mitima jawo jakanika. Ŵaliji mkumlambila Baala",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.14",
            "verseOrgIds": [
              "JER.9.14"
            ]
          }
        },
        {
          "text": " mpela muŵajiganyicisye acinangolo ŵawo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.14",
            "verseOrgIds": [
              "JER.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpikane yitinjitenda une AMBUJE",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.15",
            "verseOrgIds": [
              "JER.9.15"
            ]
          }
        },
        {
          "text": " Ŵamaciligosope, Mlungu jwa Aisalaeli. Ŵandu ŵeleŵa tinjalisya yakumela ya kuŵaŵa ni kwapa mesi ga yikoko kuti amwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.15",
            "verseOrgIds": [
              "JER.9.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tinjapwilinganya sikati ja mitundu ja ŵandu jele jemanjajo kapena acinangolo ŵawo nganajisimana. Tinjakuya ni asilikali ŵa ngondo mpaka kwajonanga wosope ŵene.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.16",
            "verseOrgIds": [
              "JER.9.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ŵandu ŵa ku Yelusalemu akuŵenda cikamucisyo",
          "type": "text"
        }
      ]
    },
