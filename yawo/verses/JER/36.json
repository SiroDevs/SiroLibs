          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.31",
            "verseOrgIds": [
              "JER.36.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JER 36:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sambano Yelemiya ŵajigele cipukutu ca yakulembedwa cine ni kumpa mlembela Baluki, mwanace jwa Neliya, nikumlembesya maloŵe gosope ga mcipukutu ca yakulembedwa ciŵajocile Yehoiyakimu mwenye jwa ku Yuda jula. Ŵajonjecesyepo maloŵe gejinji mpela galagala.",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.32",
            "verseOrgIds": [
              "JER.36.32"
            ]
          }
        }
      ]
