                "loc": "2KI.24.1"
              },
              "items": [
                {
                  "text": "2 Ayi 24:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.36.5+2CH.36.6+2CH.36.7"
              },
              "items": [
                {
                  "text": "2 Mbi 36:5-7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.1.1+DAN.1.2"
              },
              "items": [
                {
                  "text": "Dan 1:1-2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.1",
            "verseOrgIds": [
              "JER.36.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 36:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mjigale cipukutu ca yakulembedwa ni mlembe maloŵe gosope gimbecete ni m'mwejo yakwamba Yuda ni Isalaeli ni yilambo yosope kutyocela pandaŵi jinaŵecete namwe ya Yosiya mpaka lelo jino. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.2",
            "verseOrgIds": [
              "JER.36.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 36:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwine mwakwe liŵasa lya Yuda tilicipikana yakogoya yosope yitinayiyikasye. Myoyo mundu jwalijose tacileka ndamo syakwe syakusakala. Myoyo tinjakululucila yakusakala kwawo ni ulemwa",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.3",
            "verseOrgIds": [
              "JER.36.3"
            ]
          }
        },
        {
          "text": " wawo.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.3",
            "verseOrgIds": [
              "JER.36.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 36:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.3",
            "verseOrgIds": [
              "JER.36.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 36:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sambano Yelemiya ŵamŵilasile Baluki mwanace jwa Neliya. Baluki ŵalembile mu cipukutu ca yakulembedwa maloŵe gosope giŵaŵecete AMBUJE ni Yelemiyajo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.4",
            "verseOrgIds": [
              "JER.36.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 36:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵamsalile Baluki kuti, “Une andekasisye kwawula ku Nyumba ja AMBUJE. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.5",
            "verseOrgIds": [
              "JER.36.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 36:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo ngusaka m'mwejo mjawule kweleko m'malo mwa une pa lisiku lyakulijima kulya, mkaŵalanje maloŵe ga AMBUJE ginamlembesye mu cipukutu ca yakulembedwa, ŵandu wosope ali mkupikana. Timgaŵalanje kwa ŵandu ŵa ku Yuda ŵayice kutyocela ku misinda jawo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.6",
            "verseOrgIds": [
              "JER.36.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 36:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwine mwakwe tacipopela kwa AMBUJE, nipo mundu jwalijose tacileka ndamo syakwe syakusakala. AMBUJE ŵatumbilile ŵandu ŵeleŵa, ukali wakwe uli wakogoya mnope.” ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.7",
            "verseOrgIds": [
              "JER.36.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 36:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwakuti Baluki mwanace jwa Neliya ŵatesile yosope yele jwakulocesya",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.8",
            "verseOrgIds": [
              "JER.36.8"
            ]
          }
        },
        {
          "text": " Yelemiya yiŵasalile kuti atende. Ŵaŵalasile maloŵe ga AMBUJE gigalembedwe mcipukutu ca yakulembedwa gala m'Nyumba ja AMBUJE.",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.8",
            "verseOrgIds": [
              "JER.36.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 36:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.8",
            "verseOrgIds": [
              "JER.36.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 36:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa mwesi wamsano ni mcece wa caka ca msano ca ucimwene wa Yehoiyakimu mwanace jwa Yosiya mwenye jwa ku Yuda, ŵandu wosope ŵa ku Yelusalemu ni wosope uŵayice kweleko kutyocela ku misinda ja Yuda, ŵalangene yakulijima kulya kuti AMBUJE ŵatendele yambone jemanjajo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.9",
            "verseOrgIds": [
              "JER.36.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 36:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sambano wosope piŵajinjile m'Nyumba ja AMBUJE, Baluki ŵaŵalasile maloŵe ga AMBUJE gigalembedwe mcipukutu ca yakulembedwa, ŵandu wosope ali mkupikana. Ŵagaŵalanjile mcipinda ca Gemaliya, mwanace jwa mlembela Shafani, cele cicaliji mu luŵala lwapenani, ciŵandika ni cipata casambano cakwinjilila ku Nyumba ja AMBUJE.",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.10",
            "verseOrgIds": [
              "JER.36.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Akuŵalanga buku pameso pa acakulungwakulungwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 36:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.10",
            "verseOrgIds": [
              "JER.36.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 36:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mikaya mwanace jwa Gemaliya, cisukulu ca Shafani, piŵapikene maloŵe gosope gelembedwe mcipukutu ca yakulembedwa gala, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.11",
            "verseOrgIds": [
              "JER.36.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 36:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "ŵapite ku nyumba ja mwenye, ni kuja kwinjila mcipinda ca mlembela. Acakulungwakulungwa wosope ŵaliji ali asongene mwelemo: mlembela Elishama, Delaya mwanace jwa Shemaya, Elinatani mwanace jwa Akiboli, Gemaliya mwanace jwa Shafani, Sedekiya mwanace jwa Hananiya, pamo ni acakulungwakulungwa ŵane wosope. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.12",
            "verseOrgIds": [
              "JER.36.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 36:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sambano Mikaya ŵasalile maloŵe gosope giŵagapikene pa ndaŵi jele Baluki jiŵaliji mkuŵalanga cipukutu ca yakulembedwa ŵandu ali mkupikana. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.13",
            "verseOrgIds": [
              "JER.36.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 36:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pelepo acakulungwakulungwa ŵamtumile Yehudi mwanace jwa Netaniya, mwanace jwa Shelemiya, mwanace jwa Kushi, kwa Baluki kukumsalila kuti ayice naco cipukutu ca yakulembedwa ciŵaŵalanjilaga ŵandu. Myoyo Baluki mwanace jwa Neliya, ŵapite naco cipukutu ca yakulembedwa kwa jemanjajo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.14",
            "verseOrgIds": [
              "JER.36.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 36:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jemanjajo ŵatite, “Mtame apa, ni mtuŵalanjile.” Baluki ŵaŵalanjile jemanjajo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.15",
            "verseOrgIds": [
              "JER.36.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 36:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Piŵapikene yiŵaŵalasile yila, ŵatandite kulolecesya ali mkutetemela ni woga. Myoyo ŵamsalile Baluki kuti, “Tukwenela kwasalila mwenye maloŵe gosopega.” ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.16",
            "verseOrgIds": [
              "JER.36.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 36:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaneko ŵamwusisye kuti, “Mtusalile, sampano, ana mwalembile uli maloŵe gosopega? Ana Yelemiya ni uŵamsalilaga maloŵe gelega kuti mgalembe?”",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.17",
            "verseOrgIds": [
              "JER.36.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 36:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.17",
            "verseOrgIds": [
              "JER.36.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 36:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baluki ŵajanjile kuti, “Yili yisyene kuti Yelemiya ni uŵasalilaga maloŵe gelega, une ni kulembaga mcipukutu ca yakulembedwa.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.18",
            "verseOrgIds": [
              "JER.36.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 36:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.18",
            "verseOrgIds": [
              "JER.36.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 36:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Acakulungwakulungwa ŵala ŵamsalile Baluki kuti, “M'mwejo ni Yelemiyawo mkajuŵe, pakasimanikwa jwalijose jutamanyilile kumli jemanja.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.19",
            "verseOrgIds": [
              "JER.36.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mwenye jwajocile buku",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 36:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.19",
            "verseOrgIds": [
              "JER.36.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 36:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sambano jemanjajo ŵajinjile mu luŵala ni kwawula kwa mwenye ali ajiŵisile cipukutu ca yakulembedwa mcipinda ca mlembela Elishama. Ŵamsalile mwenyejo maloŵe gosopego.",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.20",
            "verseOrgIds": [
              "JER.36.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 36:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.20",
            "verseOrgIds": [
              "JER.36.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 36:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenye piŵapikene yeleyi, ŵamtumile Yehudi kuja kujigala cipukutu ca yakulembedwa cila. Piŵajile kujijigala ku cipinda ca mlembela Elishama, Yehudi ŵamŵalanjile mwenye ni acakulungwakulungwa wosope uŵasongene. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.21",
            "verseOrgIds": [
              "JER.36.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 36:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waliji mwesi wa msano ni mcece nipo mwenye ŵaliji m'nyumba jakusatama pa ndaŵi jakusisima, ali mkota moto uŵakolesisye ligongo lyakusisima. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.22",
            "verseOrgIds": [
              "JER.36.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 36:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehudi ŵatiji kuti naga amasile kuŵalanga masamba gatatu kapena mcece ga bukujo, mwenye ŵagakataga ni cipula ni kugaponya pamoto. Ŵapelengenye kutenda yeleyi mpaka cipukutu ca yakulembedwa cosope camasile kupya ni moto. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.23",
            "verseOrgIds": [
              "JER.36.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 36:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo mwenye kapena jwine jwalijose mwa nduna syakwe sisyapikene maloŵe gelega, nganatenda woga kapena kupapula yakuwala yawo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.24",
            "verseOrgIds": [
              "JER.36.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 36:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atamose kuti Elinatani, Delaya ni Gemaliya ŵamŵendile mwenye kuti akajoca cipukutu ca yakulembedwa, nambo jwalakwejo nganajiticisya. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.25",
            "verseOrgIds": [
              "JER.36.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 36:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaneka mwenye ŵamlamwile Yelamele mwanace jwa mwenye, Selaya mwanace jwa Asiliyeli ni Shelemiya mwanace jwa Abidele kuti akamkamule mlembela Baluki ni jwakulocesya Yelemiya. Nambo AMBUJE ŵaliji ali ŵasisile jemanjaji.",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.26",
            "verseOrgIds": [
              "JER.36.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yelemiya akulemba soni buku jine",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 36:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.26",
            "verseOrgIds": [
              "JER.36.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 36:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sambano mwenye piŵajocile cipukutu ca yakulembedwa muyaliji yosope yele Yelemiya yiŵamsalile Baluki kuti alembe, AMBUJE ŵamsalile Yelemiya kuti, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.27",
            "verseOrgIds": [
              "JER.36.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JER 36:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "sambano jigalani cipukutu ca yakulembedwa cine kuti mlembemo maloŵe gosope gigaliji mcipukutu ca yakulembedwa candanda, cele Yehoiyakimu, mwenye jwa ku Yuda ciŵajijocile cila. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.28",
            "verseOrgIds": [
              "JER.36.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JER 36:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "AMBUJE ŵasalile une kuti nimsalile mwenye kuti, “Wawo ajocile cipukutu ca yakulembedwa, soni ŵalakwe amwusisye Yelemiya kuti ana ligongo cici ŵalembile kuti mwenye jwa ku Babiloniya taciyika ni konanga cilamboci ni kwawulaga ŵandu ŵakwe ni yinyama yakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.29",
            "verseOrgIds": [
              "JER.36.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JER 36:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sambano, Une AMBUJE nguŵeceta kuti, ngasipasimanikwa cisukulu cine cakwinjila m'malo mwakwe pa mpando wa ucimwene wa Daudi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.30",
            "verseOrgIds": [
              "JER.36.30"
            ]
          }
        },
        {
          "text": " Pitaciwa jwalakwejo, mtembo wakwe tiwuciŵa pa lyuŵa ndaŵi ja musi, nipo ndaŵi ja cilo tiwuciŵa pa mbepo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.30",
            "verseOrgIds": [
              "JER.36.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JER 36:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tinjapa cilango pamo ni yisukulu yawo ni nduna syakwe ligongo lya yakusakala yawo. Tinjiyikasya yakogoya yinasasile pa ŵandu wosope ŵa ku Yelusalemu ni ŵa ku Yuda, ligongo lyakuti jemanjajo nganagapikanila maloŵe gangu.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.31",
            "verseOrgIds": [
              "JER.36.31"
            ]
          }
        }
      ]
    },
