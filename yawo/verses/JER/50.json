        "style": "s1"
      },
      "items": [
        {
          "text": "Yakukamulwa kwa ŵandu ŵa ku Babiloni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 50:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aga gali maloŵe giŵaŵecete AMBUJE",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.1",
            "verseOrgIds": [
              "JER.50.1"
            ]
          }
        },
        {
          "text": " ni jwakulocesya",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.1",
            "verseOrgIds": [
              "JER.50.1"
            ]
          }
        },
        {
          "text": " Yelemiya kwamba ya msinda wa Babiloni",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.1",
            "verseOrgIds": [
              "JER.50.1"
            ]
          }
        },
        {
          "text": " ni ŵandu ŵakwe. Ŵatite kuti,",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.1",
            "verseOrgIds": [
              "JER.50.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "Yes 13:1—14:23",
              "type": "text"
            },
