      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CO 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cikalataci cikutyocela kwa une Paulo, ndumetume",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.1",
            "verseOrgIds": [
              "2CO.1.1"
            ]
          }
        },
        {
          "text": " jwa Klistu",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.1",
            "verseOrgIds": [
              "2CO.1.1"
            ]
          }
        },
        {
          "text": " Yesu",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.1",
            "verseOrgIds": [
              "2CO.1.1"
            ]
          }
        },
        {
          "text": " mwa lisosa lya Mlungu, nipo soni cikutyocela kwa mlongo mjetu Timoteo.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.1",
            "verseOrgIds": [
              "2CO.1.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.18.1"
              },
              "items": [
                {
                  "text": "Mase 18:1",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CO 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cikalataci tukulembela ku mpingo",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.1",
            "verseOrgIds": [
              "2CO.1.1"
            ]
          }
        },
        {
          "text": " wa Mlungu wele uli ku Kolinto, nipo soni ŵandu wosope ŵa Mlungu ŵele ŵali mcilambo cosope ca Akaya.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.1",
            "verseOrgIds": [
              "2CO.1.1"
            ]
          }
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.1",
            "verseOrgIds": [
              "2CO.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CO 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umbone mtima ni mtendele yakutyocela kwa Mlungu Atati ŵetu ni kwa Ambuje Yesu Klistu yiŵe ni jemanja.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.2",
            "verseOrgIds": [
              "2CO.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Paulo akumtogolela Mlungu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CO 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.2",
            "verseOrgIds": [
              "2CO.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CO 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tumtogolele Mlungu jwali Atati ŵa Ambuje ŵetu Yesu Klistu, ŵali Atati ŵacanasa, ni Mlungu ŵakusatulimbisya mitima mnope. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.3",
            "verseOrgIds": [
              "2CO.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CO 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mlungu akusatulimbisya mitima myisawusyo yetu yosope, kuti mpela jwalakwe mwakusatulimbisya uwe mitima, nowe ŵakwe tupakombole kwalimbisya mitima acimjetu ŵali pasikati pa yisawusyo yamitundumitundu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.4",
            "verseOrgIds": [
              "2CO.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CO 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti tukugaŵana yipwetesi yejinji pampepe ni Klistu, myoyo soni Klistu akusatulimbisya mtima mnope. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.5",
            "verseOrgIds": [
              "2CO.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CO 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naga tukulaga, ni kuti jemanja mpate cakulimbisya mtima ni cikulupusyo. Naga uwe akutulimbisya mtima, ni kuti soni jemanja tamlimbisye mtima ni kupocela macili gakupilila pele payikumsimana yipwetesi yele yitukulaga nayo nowe ŵakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.6",
            "verseOrgIds": [
              "2CO.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CO 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cembeceyo cetu pa jemanja cili cakulimba, pakuti tukumanyilila kuti mkuyiwona yipwetesi pampepe ni uwe, m'momopemo soni timcipata cakumlimbisya mtima pampepe ni uwe.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.7",
            "verseOrgIds": [
              "2CO.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CO 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.7",
            "verseOrgIds": [
              "2CO.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CO 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Acimjangu, ngusaka kuti m'manyilile, yakulaga kwetu kutwasimene nako ku Asiya.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.8",
            "verseOrgIds": [
              "2CO.1.8"
            ]
          }
        },
        {
          "text": " Twasitopelwe mnope, kwakupundanganya macili getu, kwamti nganitujembecelaga kuti tuŵe soni ni umi.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.8",
            "verseOrgIds": [
              "2CO.1.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.15.32"
              },
              "items": [
                {
                  "text": "1 Akoli 15:32",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.8",
            "verseOrgIds": [
              "2CO.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CO 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nditu m'mitima mwetu twaganisyaga kuti tutuwe. Nambo yeleyi yatendekwe myiyi kuti tukalikulupililaga twacimsyewe, nambo tumkulupilileje Mlungu jwakusajimusya ŵawe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.9",
            "verseOrgIds": [
              "2CO.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CO 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mlungu ŵatukulupwisye ku yakogoya ya ciwa, nipo soni tacitukulupusya. Tuŵisile cembeceyo cetu mwa jwelejo kuti tacitukulupusya soni. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.10",
            "verseOrgIds": [
              "2CO.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CO 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Conde mtukamucisye pakutupopelela. Pelepo ŵandu ŵajinji tacimtogolela Mlungu m'malo mwetuwe ligongo lya yiŵatutendele jwalakwe mwa kusalala mtima kwakwe.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.11",
            "verseOrgIds": [
              "2CO.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Paulo akusala magongo giŵacenjele ulendo wakwe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CO 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.11",
            "verseOrgIds": [
              "2CO.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CO 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Citukusangalalila ni cakuti mtima wetu utendeleje umboni palipose pele patwapite, nambo mnopemnope pasikati penu, kwenda kwetu kwaliji kwagoloka ni kwangali unami. Yaliji myoyo ngaŵa ligongo lyakuya lunda lwa ŵandu iyayi, nambo kuti Mlungu ŵatusalalile mtima. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.12",
            "verseOrgIds": [
              "2CO.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CO 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti tukumlembela yelepeyo yimpaka mkombole kuŵalanga ni kuyimanyilila cenene. Ngukulupilila kuti, ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.13",
            "verseOrgIds": [
              "2CO.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CO 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "mpela mwatandite kala kutumanyilila panandi, tacitumanyilila mnope, mnopemnope pa lisiku lya Ambuje Yesu tacikombola kutusangalalila uwe, soni nowe ŵakwe tucimsangalalila jemanja.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.14",
            "verseOrgIds": [
              "2CO.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CO 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.14",
            "verseOrgIds": [
              "2CO.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CO 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti nakulupilile yeleyi nditu, naganisisye yakuti ndande kwika kwenumwe. Nasacile kuti mpocele upile kaŵili. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.15",
            "verseOrgIds": [
              "2CO.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CO 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nalinganyisye ulendo wangu kuti mbitile kumangwenu pakwawula ku Masedoniya nipo soni pakuwuja kutyocela kweleko. Nasakaga kuti mumbecesye pa ulendo wangu wakwawula ku Yudeya.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.16",
            "verseOrgIds": [
              "2CO.1.16"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.19.21"
              },
              "items": [
                {
                  "text": "Mase 19:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.16",
            "verseOrgIds": [
              "2CO.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CO 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ana pinaganisyaga kutenda yeleyi, ana ŵalakwe akupela natesile yeleyi mwawanace? Kapena yele yinaganisyaga kuyitendayi, ana naganisyaga mwa utambwali, mwamti ngukomboleka kuŵeceta kuti, “Elo, elo” nipo soni “Iyayi, iyayi” pa ndaŵi jimpepe? ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.17",
            "verseOrgIds": [
              "2CO.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CO 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuŵa Mlungu ali jwakulupicika, ni maloŵe getu gatukumsalila nganigaŵa “Elo” nipo soni “Iyayi.” ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.18",
            "verseOrgIds": [
              "2CO.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CO 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti Yesu Klistu, Mwanace jwa Mlungu, jwele une ni Sila soni ni Timoteo twaliji mkulalicila, nganaŵa jumo jwa “Elo” kapena soni “Iyayi” pa ndaŵi jimpepe, nambo ndaŵi josope ŵaliji “Elo” jwa Mlungu.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.19",
            "verseOrgIds": [
              "2CO.1.19"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.18.5"
              },
              "items": [
                {
                  "text": "Mase 18:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.19",
            "verseOrgIds": [
              "2CO.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CO 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nipo yosope yiŵayitesile Mlungu, yatendekwe ni “Elo” jweleju. Ni ligongo lyakwe mwa Yesu Klistu tukusajiticisyaga yeleyi pakuŵeceta kuti, “Ami”",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.20",
            "verseOrgIds": [
              "2CO.1.20"
            ]
          }
        },
        {
          "text": " kucimbicisya Mlungu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.20",
            "verseOrgIds": [
              "2CO.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CO 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mlungu ni jwele jwakutuŵika pampepe ni jemanja mwa Klistu. Soni Mlungu pejo ni juŵatusagwile, ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.21",
            "verseOrgIds": [
              "2CO.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CO 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "ni ŵatuŵisile cimanyisyo cakwe kuti tuli ŵakwe, ni kutuŵika Msimu Ŵaswela m'mitima jetu kuti uŵe cilanga ca yindu yatusunjile pasogolo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.22",
            "verseOrgIds": [
              "2CO.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CO 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngumŵenda Mlungu kuti aŵe mboni jangu, ligongo akumanyilila mtima wangu, ni ligongo lyele linganiyicila akuno ku Kolinto lyaliji lyakuti ngamtesya canasa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.23",
            "verseOrgIds": [
              "2CO.1.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CO 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngatukusaka kutenda mpela tukumlamulila pa yindu yimkusaka kuyikulupilila, kuŵeceta ya cikulupi cenu, jemanja mli ŵatamilicice kusyene. Mnopemnope tukamula namwe masengo kuti mŵe ŵakusangalala.",
          "type": "text",
