        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.29",
            "verseOrgIds": [
              "2CO.11.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
