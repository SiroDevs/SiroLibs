          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasano Ayuda ŵangwapwile yikoti 39.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.24",
            "verseOrgIds": [
              "2CO.11.24"
            ]
          }
        },
        {
