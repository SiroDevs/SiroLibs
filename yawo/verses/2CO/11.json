                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.14.19"
              },
              "items": [
                {
                  "text": "14:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.25",
            "verseOrgIds": [
              "2CO.11.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CO 11:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "M'maulendo gangu gejinji nasimene ni yindu yakogoya ya musulo, yakogoya ya ŵaciswamba, yakogoya ya kutyocela kwa Ayuda acimjangu, ni yine yakutyocela kwa ŵandu ŵa mitundu jine.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.26",
            "verseOrgIds": [
              "2CO.11.26"
            ]
          }
        },
        {
          "text": " Nayisimene yakogoya m'misinda, mwitinji, m'nyasa syekulungwa, ni pasikati pa acimjetu ŵa unami.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.26",
            "verseOrgIds": [
              "2CO.11.26"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
