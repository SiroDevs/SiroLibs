                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.14.15"
              },
              "items": [
                {
                  "text": "14:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.26",
            "verseOrgIds": [
              "2CO.11.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CO 11:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngamwile masengo gakupesya mnope, mwamti mbele ndili mkucesya ngagona lugono. Jangwete sala ni njota, nipo kaŵilikaŵili naliji jwangali yakulya nipo soni kusoŵa yakuwala ni gambaga kulaga ni mbepo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.27",
            "verseOrgIds": [
              "2CO.11.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2CO 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konjecesya pa yosopeyi, lisiku lili lyose nakwete msigo ŵakusamalila mipingo josope. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.28",
            "verseOrgIds": [
              "2CO.11.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2CO 11:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naga jwine ali jwakulepetala, none jwakwe ngusaŵa jwakulepetala myoyo; naga jwine akumlemwekasya, une ngusadandawula mnope.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.29",
            "verseOrgIds": [
              "2CO.11.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
