          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo ŵandu ŵambisile mlukalala ni kundulucisya pa liwindo lya lipupalyo, ni nakulupwice m'makono mwawo.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.33",
