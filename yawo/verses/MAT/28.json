{
  "id": "MAT.28",
  "number": "28",
  "bookId": "MAT",
  "reference": "Mat 28",
  "verseCount": 20,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "28",
        "style": "c",
        "sid": "MAT 28"
      },
      "items": [
        {
          "text": "28",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu ŵajimwice ku ŵawe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 28:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pilyamasile lisiku lyakupumula,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.1",
            "verseOrgIds": [
              "MAT.28.1"
            ]
          }
        },
        {
          "text": " kumasikusiku kwa lisiku lya mlungu, Maliya jwa ku Magadala ni Maliya jwine jula ŵayice kukulola lilembe lila. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.1",
            "verseOrgIds": [
              "MAT.28.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 28:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwacisisimucisya cilambo catenganyice mnope, ligongo lilayika lya Ambuje lyatulwice kutyocela kwinani, ni lyayingalamulile pambali liganga lila, ni kutama pacanya pakwepo. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.2",
            "verseOrgIds": [
              "MAT.28.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 28:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwonece wakwe waliji mpela njasi, nipo cakuwala cakwe caliji ceswela mpela utandi wa mbee. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.3",
            "verseOrgIds": [
              "MAT.28.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 28:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pelepo acilonda ŵala ŵakamwilwe woga ni ŵatandite kutetemela, nipo ŵaliji mpela ŵandu ŵawe.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.4",
            "verseOrgIds": [
              "MAT.28.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 28:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.4",
            "verseOrgIds": [
              "MAT.28.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 28:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo lilayikalyo lyaŵecete ni acakongwe ŵala nipo ŵasalile kuti, “Jemanja mkasimjogopa iyayi. Ngumanyilila kuti mkusosa Yesu,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.5",
            "verseOrgIds": [
              "MAT.28.5"
            ]
          }
        },
        {
          "text": " juŵamkomele pa msalaba jula. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.5",
            "verseOrgIds": [
              "MAT.28.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 28:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nganaŵa amuno, ajimwice ku ŵawe mpela yiŵatite pakumsalila yila. Myice mlole piŵagonile. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.6",
            "verseOrgIds": [
              "MAT.28.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 28:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mjawule mwacitema sambano jino, mkasalile ŵakulijiganya",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.7",
            "verseOrgIds": [
              "MAT.28.7"
            ]
          }
        },
        {
          "text": " ŵakwe ŵala kuti, ‘Jwalakwe ajimwice ku ŵawe, nipo sambano alongolele kwawula ku Galileya, timkamwonele kweleko.’ Mkumbucile yinimsalileyi.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.7",
            "verseOrgIds": [
              "MAT.28.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 28:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.7",
            "verseOrgIds": [
              "MAT.28.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 28:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele acakongwewo ŵatyosile ku malembeko mwacitema, ali akamwilwe ni woga nambo soni kwineku ni cisangalalo cacikulungwa, ni ŵawutwice kuja kukwasalila ŵakulijiganya ŵakwe ŵala.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.8",
            "verseOrgIds": [
              "MAT.28.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 28:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.8",
            "verseOrgIds": [
              "MAT.28.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 28:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwacisisimucisya Yesu ŵasimangene nawo ni ŵatite, “Monitu mwanja mama!” Jemanjajo ŵayice ni kumŵandicila soni ŵakamwile sajo syakwe, nipo ŵamlambile. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.9",
            "verseOrgIds": [
              "MAT.28.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 28:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Papopo Yesu ŵasalile kuti, “Kasimjogopa. Mjawule mkasalile acalongo acimjangu kuti akajawule ku Galileya. Takambonele kweleko.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.10",
            "verseOrgIds": [
              "MAT.28.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yiŵaŵecete acilonda ŵala",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 28:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.10",
            "verseOrgIds": [
              "MAT.28.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 28:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Piŵajawulaga acakongwe ŵala, ŵane mwa acilonda ŵala ŵajawile ku msinda, ni ŵasalile acakulungwa ŵa ŵakutaga mbopesi yosope yele yiyatendekwe.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.11",
            "verseOrgIds": [
              "MAT.28.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.27.65+MAT.27.66"
              },
              "items": [
                {
                  "text": "Mat 27:65-66",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.11",
            "verseOrgIds": [
              "MAT.28.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 28:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sambano acakulungwa ŵa ŵakutaga mbopesi ŵala ni acakulungwa ŵa Ayuda",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.12",
            "verseOrgIds": [
              "MAT.28.12"
            ]
          }
        },
        {
          "text": " ŵasongangene ni kupangana lunda. Ŵapele acilonda ŵala mbiya syejinji, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.12",
            "verseOrgIds": [
              "MAT.28.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 28:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "ni ŵasalile kuti, “Mjileje, ‘Ŵakulijiganya ŵakwe ŵayice cilo kukwiŵa mtembo wakwe uwe tuli mlugono.’ ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.13",
            "verseOrgIds": [
              "MAT.28.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 28:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myoyo bwanamkubwa",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.14",
            "verseOrgIds": [
              "MAT.28.14"
            ]
          }
        },
        {
          "text": " pitapikane yeleyi, mtima wawo tiwucitama pasi, nipo tipaciŵa pangali kandu kakumsawusya.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.14",
            "verseOrgIds": [
              "MAT.28.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 28:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.14",
            "verseOrgIds": [
              "MAT.28.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 28:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Acilonda ŵala piŵapocele mbiya sila, ŵatesile kweli mpela yila yiŵatite pakwasalila. Kwakuti jele mbiliji jajenele pasikati pa Ayuda mpaka lelo jino.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.15",
            "verseOrgIds": [
              "MAT.28.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu ŵatumile ŵakulijiganya ŵakwe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 28:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.15",
            "verseOrgIds": [
              "MAT.28.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 28:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵakulijiganya likumi ni ŵaŵili ŵala ŵajawile ku Galileya kwitumbi kwele Yesu ŵalangene nawo kuti akasimane.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.16",
            "verseOrgIds": [
              "MAT.28.16"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.26.32"
              },
              "items": [
                {
                  "text": "Mat 26:32",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.14.28"
              },
              "items": [
                {
                  "text": "Mak 14:28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.16",
            "verseOrgIds": [
              "MAT.28.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 28:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Piŵam'weni, ŵamtindiŵalile, nambo ŵane ŵakayicilaga. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.17",
            "verseOrgIds": [
              "MAT.28.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 28:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu ŵaŵandicile ni ŵasalile kuti, “Mbegwile ulamusi wosope kwinani ni pasi pano. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.18",
            "verseOrgIds": [
              "MAT.28.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 28:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni ligongo lyakwe jemanja mjawule, mkajiganye ŵandu ŵa ngosyo syosope. Mkabatisyeje mu lina lya Atati, ni lya Mwanace, ni lya Msimu Ŵaswela,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.19",
            "verseOrgIds": [
              "MAT.28.19"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.1.8"
              },
              "items": [
                {
                  "text": "Mase 1:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.19",
            "verseOrgIds": [
              "MAT.28.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 28:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "ni kwajiganya yosope yele yinamlamulile. Nipo unejo ndili ni jemanja masiku gosope, mpaka mbesi ja cilambo capasi cino.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.20",
            "verseOrgIds": [
              "MAT.28.20"
            ]
          }
        }
      ]
    }
  ],
