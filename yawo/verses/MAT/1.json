          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Acinangolo ŵa Yesu",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.1",
            "verseOrgIds": [
              "MAT.1.1"
            ]
          }
        },
        {
          "text": " Klistu",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.1",
            "verseOrgIds": [
              "MAT.1.1"
            ]
          }
        },
        {
          "text": " ŵaliji Daudi",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.1",
            "verseOrgIds": [
              "MAT.1.1"
            ]
          }
        },
        {
          "text": " ni Abulahamu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.1",
            "verseOrgIds": [
              "MAT.1.1"
            ]
          }
        },
        {
          "text": " Mena ga acinangolo ŵakwe ni aga:",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.1",
            "verseOrgIds": [
              "MAT.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.1",
            "verseOrgIds": [
              "MAT.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abulahamu ŵaŵelece Isaki, Isaki ŵaŵelece Yakobo,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.2",
            "verseOrgIds": [
              "MAT.1.2"
            ]
          }
        },
        {
          "text": " Yakobo ŵaŵelece Yuda ni acapwakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.2",
            "verseOrgIds": [
              "MAT.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yuda ŵaŵelece Pelesi ni Sela mwa Tamala; Pelesi ŵaŵelece Hesiloni, Hesiloni ŵaŵelece Lamu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.3",
            "verseOrgIds": [
              "MAT.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lamu ŵaŵelece Aminadabu, Aminadabu ŵaŵelece Nashoni, Nashoni ŵaŵelece Salimoni. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.4",
            "verseOrgIds": [
              "MAT.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Salimoni ŵaŵelece Bowasi mwa Lahabu, Bowasi ŵaŵelece Obedi mwa Lute, Obedi ŵaŵelece Yese, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.5",
            "verseOrgIds": [
              "MAT.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yese ŵaŵelece Mwenye Daudi.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.6",
            "verseOrgIds": [
              "MAT.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi ŵaŵelece Solomoni, ŵele mamagwe ŵaliji ŵamkwakwe Uliya. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.6",
            "verseOrgIds": [
              "MAT.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoni ŵaŵelece Lehobowamu, Lehobowamu ŵaŵelece Abiya, Abiya ŵaŵelece Asa. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.7",
            "verseOrgIds": [
              "MAT.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asa ŵaŵelece Yehoshafati, Yehoshafati ŵaŵelece Yolamu, Yolamu ŵaŵelece Usiya. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.8",
            "verseOrgIds": [
              "MAT.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usiya ŵaŵelece Yotamu, Yotamu ŵaŵelece Ahasi, Ahasi ŵaŵelece Hesekiya. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.9",
            "verseOrgIds": [
              "MAT.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hesekiya ŵaŵelece Manase, Manase ŵaŵelece Amoni, Amoni ŵaŵelece Yosiya. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.10",
            "verseOrgIds": [
              "MAT.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosiya ŵaŵelece Yekoniya ni acapwakwe, pa ndaŵi jiŵajigalidwe ukapolo Aisalaeli kuja nawo ku Babiloni.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.11",
            "verseOrgIds": [
              "MAT.1.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.24.12+2KI.24.13+2KI.24.14+2KI.24.15+2KI.24.16"
              },
              "items": [
                {
                  "text": "2 Ayi 24:12-16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.36.10"
              },
              "items": [
                {
                  "text": "2 Mbi 36:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.27.20"
              },
              "items": [
                {
                  "text": "Yel 27:20",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.11",
            "verseOrgIds": [
              "MAT.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aisalaeli piŵajigalidwe ukapolo kwawula ku Babiloni, Yekoniya ŵaŵelece Sheyatiyele, Sheyatiyele ŵaŵelece Selubabele. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.12",
            "verseOrgIds": [
              "MAT.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Selubabele ŵaŵelece Abiyudi, Abiyudi ŵaŵelece Eliyakimu, Eliyakimu ŵaŵelece Asoli. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.13",
            "verseOrgIds": [
              "MAT.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asoli ŵaŵelece Sadoki, Sadoki ŵaŵelece Akimu, Akimu ŵaŵelece Eliyudi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.14",
            "verseOrgIds": [
              "MAT.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eliyudi ŵaŵelece Eliyesa, Eliyesa ŵaŵelece Matani, Matani ŵaŵelece Yakobo. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.15",
            "verseOrgIds": [
              "MAT.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobo ŵaŵelece Yosefe, ŵamkwawo ŵa Maliya. Maliyaju ŵaŵelece Yesu, jwakolanjidwa Klistu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.16",
            "verseOrgIds": [
              "MAT.1.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.16",
            "verseOrgIds": [
              "MAT.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myoyo japali mipago likumi ni mcece kutandila pa Abulahamu mpaka pa Mwenye Daudi, soni mipago likumi ni mcece kutandilila pa Daudijo mpaka pa ndaŵi jiŵajigalidwe Aisalaeli ukapolo kuja ku Babiloni, soni mipago jine likumi ni mcece kutandila pa ndaŵi ja kujigalwa ukapolo kuja ku Babiloni mpaka pa ndaŵi jakupagwa kwa Klistu, Mkulupusyo jwakulocesedwa jula.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.17",
            "verseOrgIds": [
              "MAT.1.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kupagwa kwa Yesu Klistu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.17",
            "verseOrgIds": [
              "MAT.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kupagwa kwa Yesu Klistu kwaliji kwamti myi: Maliya, mamagwe Yesujo ŵatomeledwe ni Yosefe; nambo mkanatame malo gamo, Maliyajo ŵasimanikwe kuti akwete cilu mwamacili ga Msimu Ŵaswela.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.18",
            "verseOrgIds": [
              "MAT.1.18"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.1.27"
              },
              "items": [
                {
                  "text": "Luk 1:27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.18",
            "verseOrgIds": [
              "MAT.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosefe ŵaliji mundu jwakunonyela cilungamo, nambo nganasosa kose kumjalusya Maliyajo pameso pa ŵandu. Ni ligongo lyakwe ŵaganisisye yakwamba kumasya citomelo cawo mwa mcisyepela, mwangajimbana magambo. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.19",
            "verseOrgIds": [
              "MAT.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ali mkati mwaganicisya yeleyi, lilayika lya Ambuje lyamwonecele musagamisi ni lyatite kuti, “Yosefe, mwanace jwa Daudi, kasimjogopa kumjigala Maliya kuti aŵe ŵamkwenu. Pakuŵa cilu cakweteco cili ca macili ga Msimu Ŵaswela. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.20",
            "verseOrgIds": [
              "MAT.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Taciŵeleka mwanace jwamlume, nipo timcimpa lina lyakwe Yesu, pakuŵa jwalakwejo ni jutacikulupusya ŵandu ŵakwe ku ulemwa",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.21",
            "verseOrgIds": [
              "MAT.1.21"
            ]
          }
        },
        {
          "text": " wawo.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.21",
            "verseOrgIds": [
              "MAT.1.21"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.1.31"
              },
              "items": [
                {
                  "text": "Luk 1:31",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.21",
            "verseOrgIds": [
              "MAT.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosopeyi yatendekwe gumbalicisya yiŵaŵecete Ambuje mwa jwakulocesya",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.22",
            "verseOrgIds": [
              "MAT.1.22"
            ]
          }
        },
        {
          "text": " kuti, ",
