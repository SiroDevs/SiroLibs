          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Citagu ca aciŵali likumi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 25:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Pa jele ndaŵijo ya Ucimwene wa kwinani tiyicilandana ni yele yiyatendecele aciŵali likumi. Jemanjajo ŵajigele nyali syawo ni kujaga kukumcingamila mlombela.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.1",
            "verseOrgIds": [
              "MAT.25.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.12.35"
              },
              "items": [
                {
                  "text": "Luk 12:35",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.1",
            "verseOrgIds": [
              "MAT.25.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aciŵali msano ŵaliji ŵakuloŵela, nipo msano ŵanewo ŵaliji ŵakalamuka. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.2",
            "verseOrgIds": [
              "MAT.25.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Msano ŵakuloŵela ŵala ŵajigele nyali syawo, nambo nganajigala cile mawuta gane gapambali. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.3",
            "verseOrgIds": [
              "MAT.25.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo msano ŵakalamuka ŵala ŵajigalile cile mawuta gane ga pambali m'mabotolo gawo. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.4",
            "verseOrgIds": [
              "MAT.25.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuŵa kuti mlombela ŵacelewe kwisa, wosope ŵatandite gwesela ni ŵagonile.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.5",
            "verseOrgIds": [
              "MAT.25.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.5",
            "verseOrgIds": [
              "MAT.25.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Sambano pakati cilo kwapikanice gumila kwakuti, ‘Mlombela ali mkwisa! Mkopoce mkamcingamile!’ ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.6",
            "verseOrgIds": [
              "MAT.25.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aciŵali likumi ŵala ŵajimwice, ni kutanda kupamba nyali syawo sila. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.7",
            "verseOrgIds": [
              "MAT.25.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵakuloŵela ŵala ŵaŵendile ŵakalamuka ŵala kuti, ‘Mtugaŵile mawuta, mlole nyali syetu sikusima.’ ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.8",
            "verseOrgIds": [
              "MAT.25.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo ŵakalamuka ŵala ŵajanjile kuti, ‘Iyayi, tukogopela kuti naga tutende myoyo, mawutago ngagatukwanila wosopewe. Uli mgambe kwawula ku sitolo mkasume genu.’ ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.9",
            "verseOrgIds": [
              "MAT.25.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Piŵajawulaga kukusuma, mlombela ŵayice. Ŵiŵaliŵicile cilepe ŵala ni ŵajinjile najo pampepe m'nyumba ja cindimba; panyuma pakwe ŵawugele pa mlango.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.10",
            "verseOrgIds": [
              "MAT.25.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.10",
            "verseOrgIds": [
              "MAT.25.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kaneko aciŵali ŵane ŵala nombe nawo ŵayice acitiji, ‘Ambuje, Ambuje, atuwugulile!’",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.11",
            "verseOrgIds": [
              "MAT.25.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.13.25"
              },
              "items": [
                {
                  "text": "Luk 13:25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.11",
            "verseOrgIds": [
              "MAT.25.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo Mlombelajo jwatite, ‘Iyayi, Ngingum'manyilila jemanja!’ ”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.12",
            "verseOrgIds": [
              "MAT.25.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.12",
            "verseOrgIds": [
              "MAT.25.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 25:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakumalisya Yesu",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.13",
            "verseOrgIds": [
              "MAT.25.13"
            ]
          }
        },
        {
          "text": " ŵatite, “Sambanotu jemanja mŵeje mesope, pakuti ngamkumanyilila lisiku kapena ndaŵi jakwe.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.13",
            "verseOrgIds": [
              "MAT.25.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Citagu ca ŵamasengo ŵatatu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 25:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.13",
            "verseOrgIds": [
              "MAT.25.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 25:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ya Ucimwene wa kwinani mpaka tuwulandanicisye mwamti myi: Jwapali mundu juŵasakaga kwawula pa ulendo. Mkananyakuce, ŵaŵilasile ŵamasengo ŵakwe, ni ŵalecele cipanje cakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.14",
            "verseOrgIds": [
              "MAT.25.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 25:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwine ŵampele mbiya msano, jwine siŵili, nipo jwine mbiya jimpepe. Ŵampele jwalijose mwakulingana ni lunda lwakwe, ni ŵatyosile. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.15",
            "verseOrgIds": [
              "MAT.25.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 25:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwamasengo juŵapocele mbiya syakwana msano jula, ŵatyosile kuja kutenda malonda ni ŵapatile soni sine syakwana msano. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.16",
            "verseOrgIds": [
              "MAT.25.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 25:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yalumo soni jwele juŵapocele mbiya syakwana siŵili jula, ŵapatile mbiya sine soni syakwana siŵili syakupwatika. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.17",
            "verseOrgIds": [
              "MAT.25.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 25:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo jwele juŵapocele mbiya jimo jula, ŵapite ni kuja kujisolela pasi mbiya ja mbujegwe jila.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.18",
            "verseOrgIds": [
              "MAT.25.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 25:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.18",
            "verseOrgIds": [
              "MAT.25.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 25:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Pigapite masiku gamajinji, mbujegwe jula ŵawusile ni ŵaŵilasile ŵamasengo ŵakwe ŵala kuti amsalile yiŵatesile nasyo mbiya sila. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.19",
            "verseOrgIds": [
              "MAT.25.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 25:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwamasengo juŵapocele mbiya syakwana msano jula, ŵayice nasyo sine syakupwatikapo syakwana msano soni acitiji, ‘Ambuje, mwandecele mbiya syakwana msano. Mlole, mbatile sine syakwana soni msano, asi.’ ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.20",
            "verseOrgIds": [
              "MAT.25.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 25:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbujegwe jula ŵatite, ‘Mwatesile cenene kwabasi, mcanda jwangu jwambone ni jwakulupicika. Sambano pakuŵa mwakulupicice pa yindu yamnono, tinjimŵika kuti mloleleje yindu yejinji. Myice kuti msangalale pampepe ni une mbujegwenu.’",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.21",
            "verseOrgIds": [
              "MAT.25.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 25:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.21",
            "verseOrgIds": [
              "MAT.25.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 25:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nombe najo jwamasengo juŵapocele mbiya syakwana siŵili jula, ŵayice acitiji, ‘Ambuje, mwandecele mbiya syakwana siŵili. Mlole, mbatile sine syakwana siŵili, asi.’ ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.22",
            "verseOrgIds": [
              "MAT.25.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 25:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbujegwe jula ŵatite, ‘Mwatesile cenene kwabasi, mcanda jwangu jwambone ni jwakulupicika. Sambano pakuŵa mwakulupicice pa yindu yamnono, tinjimŵika kuti mloleleje yindu yejinji. Myice kuti msangalale pampepe ni une mbujegwenu.’",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.23",
            "verseOrgIds": [
              "MAT.25.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 25:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.23",
            "verseOrgIds": [
              "MAT.25.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 25:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nombe najo soni jwele juŵapocele mbiya jimo jula, jwayice acitiji, ‘Ambuje, une namanyilile kuti m'mwejo mli mundu jwakusawusya. Mkusagowolaga kwele kwanganimpanda kose, nipo mkusasonganganya yindu kwele kunganim'misa kose mbeju. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.24",
            "verseOrgIds": [
              "MAT.25.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 25:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni naliji mkogopa, myoyo najile kukujisolela pasi mbiya jenu jila. Mlole, ngati aji sambano mbiya jenujo.’ ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.25",
            "verseOrgIds": [
              "MAT.25.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 25:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele mbujegwe jula ŵamjanjile kuti, ‘M'mwejo jwamasengo jwangalumbana ni jwaulesi. Ana wele utendewu mwamanyilile kuti unejo ngusagowola kwele kwamkanimbanda, nipo ngusasonganganya yindu kwele kwanganimisa mbeju? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.26",
            "verseOrgIds": [
              "MAT.25.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 25:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sambanotu yikaliji cenene mkajiŵice ku banki mbiya jangujo, une pakuwuja ningajipocele pamo ni syakonjecesya syakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.27",
            "verseOrgIds": [
              "MAT.25.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 25:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumsumule mbiyajo ni mjipelece kwa jwele jwakwete mbiya syakwana likumijo. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.28",
            "verseOrgIds": [
              "MAT.25.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 25:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuŵa jwalijose jwakwete cindu, tacimjonjecesya yine, myoyo tacikola yejinji kwakupundanganya. Nambo jwele jwamkanakola kandu, atamose kele kakweteko tacimsumulape.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.29",
            "verseOrgIds": [
              "MAT.25.29"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
