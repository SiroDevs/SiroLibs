          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nipo naga akulumbila kuti, kwinani nditu, alumbile soni pa citengu ca Ucimwene wa Mlungu,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.22",
            "verseOrgIds": [
              "MAT.23.22"
            ]
          }
        },
        {
          "text": " nipo soni pa jwalakwe jwele jwakusatamaga pacitengupo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.22",
            "verseOrgIds": [
              "MAT.23.22"
            ]
          }
