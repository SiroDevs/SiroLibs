                "loc": "MRK.9.35"
              },
              "items": [
                {
                  "text": "Mak 9:35",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.10.43+MRK.10.44"
              },
              "items": [
                {
