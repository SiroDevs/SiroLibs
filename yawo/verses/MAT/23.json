              },
              "items": [
                {
                  "text": "Yel 22:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.38",
            "verseOrgIds": [
              "MAT.23.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "MAT 23:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nipo ngumsalicisya kuti, ngasimumbona soni kose mpaka patimciti, ‘Jwana upile jwele jwakwisa mu lina lya Ambuje.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.39",
            "verseOrgIds": [
              "MAT.23.39"
            ]
          }
        },
