          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nditu ngumsalicisya kuti, cilicose citimtaŵe pasi pano, ticicitaŵidwa ni kwinani kwakwe, nipo cilicose citimgopole pasi pano, ticicigopoledwa ni kwinani kwakwe.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.18",
            "verseOrgIds": [
              "MAT.18.18"
            ]
          }
        },
        {
