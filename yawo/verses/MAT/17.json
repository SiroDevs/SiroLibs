          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaneko ŵakulijiganya ŵala ŵayice kwa Yesu pacisyepela ni ŵambusisye kuti, “Ana uweji twalepele uli kuwukoposya msimu wakusakala wula?”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.19",
            "verseOrgIds": [
