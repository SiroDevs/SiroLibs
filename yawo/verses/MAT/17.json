                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.11.23"
              },
              "items": [
                {
                  "text": "Mak 11:23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
