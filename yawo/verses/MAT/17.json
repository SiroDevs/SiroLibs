              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lisiku line ŵakulijiganya piŵasongene wosope pampepe ku Galileya, Yesu ŵasalile kuti, “Mwanace jwa Mundu tacipelecedwa myala mwa ŵandu kuti amwulaje. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.22",
            "verseOrgIds": [
              "MAT.17.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 17:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo pitacimwulagapo, jwalakwejo tacijimuka ku ŵawe gali gamasile masiku gatatu.” Ŵakulijiganya ŵala piŵapikene yeleyi, ŵadandawile mnope.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.23",
            "verseOrgIds": [
              "MAT.17.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu ŵakomile msongo wa ku Nyumba ja AMBUJE",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
