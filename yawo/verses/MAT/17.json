        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 17:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu ni ŵakulijiganya ŵakwe piŵayice ku Kapelenaumu, ŵakukomesya msongo ŵa ku Nyumba ja AMBUJE ŵayice ni ŵamwusisye Petulo kuti, “Ana mwalimu jwenuju ngakusakoma msongo wa ku Nyumba ja AMBUJE?”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.24",
            "verseOrgIds": [
              "MAT.17.24"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "17:24",
              "type": "text"
            },
            {
              "text": "Msongo wa ku Nyumba ja AMBUJE:",
              "type": "text"
            },
            {
              "text": "Myuda jwalijose jwa yaka makumi gaŵili kapena kupunda pelepo jwaŵajilwaga kukoma msongo caka ni caka msongo welewu. Alole Eks 30:11-16.",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
