      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu ŵaŵecete soni ya kuwa ni kwimuka kwakwe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
