          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwalakwe ŵatite, “Akusakomaga.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.25",
            "verseOrgIds": [
              "MAT.17.25"
            ]
          }
        }
      ]
