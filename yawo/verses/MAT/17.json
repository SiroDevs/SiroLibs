              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo msimu wa mtundu welewu wangakopoka akaŵe mli mtandite ni mapopelo ni kulijima yakulya, ni mpaka mwukoposye.]”",
          "type": "text",
          "attrs": {
