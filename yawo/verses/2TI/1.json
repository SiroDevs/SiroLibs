            "sid": "2TI 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cikalataci cikutyocela kwa une Paulo, ndumetume",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.1",
            "verseOrgIds": [
              "2TI.1.1"
            ]
          }
        },
        {
          "text": " jwa Klistu",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.1",
            "verseOrgIds": [
              "2TI.1.1"
            ]
          }
        },
        {
          "text": " Yesu",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.1",
            "verseOrgIds": [
              "2TI.1.1"
            ]
          }
        },
        {
          "text": " mwa lisosa lya Mlungu, ŵandumile kuti lalicile ya cilanga",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.1",
            "verseOrgIds": [
              "2TI.1.1"
            ]
          }
        },
        {
          "text": " ca umi wele wawuli mwa Klistu Yesu.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.1",
            "verseOrgIds": [
              "2TI.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2TI 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.1",
            "verseOrgIds": [
              "2TI.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2TI 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngumlembela cikalataci m'mwejo Timoteo, mwanangu jwakunonyelwa.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.2",
            "verseOrgIds": [
              "2TI.1.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.16.1"
              },
              "items": [
                {
                  "text": "Mase 16:1",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2TI 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umbone mtima, canasa, ni mtendele yakutyocela kwa Mlungu ni Klistu Yesu Ambuje ŵetu.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.2",
            "verseOrgIds": [
              "2TI.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Paulo akumtogolela Mlungu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2TI 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.2",
            "verseOrgIds": [
              "2TI.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2TI 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngumtogolela Mlungu jwele jungusamtumicila ni mtima wangu wosope, mpela mwele muŵatendelaga acinangolo ŵetu. Ngusamtogolelaga jwalakwe mwangalecesya m'mapopelo gangu cilo ni musi ndaŵi jingusinamkumbucilaga jemanja. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.3",
            "verseOrgIds": [
              "2TI.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2TI 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pingusakumbucila misosi jenu, ngusasosa kumwona, kuti mbee ni cisangalalo cekulungwa. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.4",
            "verseOrgIds": [
              "2TI.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2TI 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngukumbucila cikulupi cenu cisyesyene, cicatandite kuŵa ni anganga ŵenu Loisi, mama ŵenu Yunisi nipo sambano ngukulupilila kuti nomwe ŵakwe mkwete cele cikulupico.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.5",
            "verseOrgIds": [
              "2TI.1.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.16.1"
              },
              "items": [
                {
                  "text": "Mase 16:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.5",
            "verseOrgIds": [
              "2TI.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2TI 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni ligongo lyeleli ngumkumbusya kuti mtuka wele Mlungu ŵampele panamsajikaga makono gangu, mwukolosye kuti ukolele mpela moto. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.6",
            "verseOrgIds": [
              "2TI.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2TI 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti Msimu uŵatupele Mlungu, ngaŵa Msimu wakututendekasya woga iyayi, nambo Msimu wakutupa macili, cinonyelo soni kuligosa.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.7",
            "verseOrgIds": [
              "2TI.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2TI 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.7",
            "verseOrgIds": [
              "2TI.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2TI 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkatenda soni sambano kwatendela umboni Ambuje ŵetu, kapena kutenda soni ligongo lya une jundili mkayidi ligongo lya Klistu. Nambo m'malo mwakwe msimane yipwetesi ligongo lya Ngani Syambone,",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.8",
            "verseOrgIds": [
              "2TI.1.8"
            ]
          }
        },
        {
          "text": " mwakulingana ni cikamucisyo ca macili ga Mlungu. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.8",
            "verseOrgIds": [
              "2TI.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2TI 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwalakwe ŵatukulupwisye, ni ŵatuŵilasile kuti tuŵe ŵandu ŵakwe. Nganatenda yeleyi ligongo lyakuti uwe twatesile yindu yambone iyayi, nambo ligongo lyakuti msyenejo ŵatendele cilepe yeleyi mwakusaka kwakwe ni umbone mtima wakwe mwa Klistu Yesu ndaŵi mkanijitande, ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.9",
            "verseOrgIds": [
              "2TI.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2TI 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "nambo sambano Mlungu atujuwulile yeleyi kupitila mkwika kwa Mkulupusyo jwetu, Klistu Yesu. Klistujo ŵamasisye macili ga ciwa, soni mu Ngani Syambone ŵalosisye pakulanguka umi wele wangaŵa mkuwa kose.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.10",
            "verseOrgIds": [
              "2TI.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2TI 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.10",
            "verseOrgIds": [
              "2TI.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2TI 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mlungu ŵasagwile une kuti mbe jwakulalicila,",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.11",
            "verseOrgIds": [
              "2TI.1.11"
            ]
          }
        },
        {
          "text": " ndumetume soni mwalimu jwa Ngani Syambonesi,",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.11",
            "verseOrgIds": [
              "2TI.1.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.2.7"
              },
              "items": [
                {
                  "text": "1 Tim 2:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.11",
            "verseOrgIds": [
              "2TI.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2TI 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "ni ligongo lyakwe ngusimana ni yisawusyoyi. Nambo ngangutenda soni, ligongo ngum'manyilila jwele junamkulupilile, nipo ngangukayicila kuti Jwalakwe tapakombole kusunga cenene, mpaka lisiku lya lyakucilamula cilambo capasi, yele yiŵasunjisye une. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.12",
            "verseOrgIds": [
              "2TI.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2TI 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkamulisye maloŵe gasyesyene gimwapikene kutyocela kwa une, kuti gaŵe cisyasyo cakuti mtendeje. Mtendeje yeleyi mwa cikulupi ni mwa cinonyelo, cacili mwa Klistu Yesu. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.13",
            "verseOrgIds": [
              "2TI.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2TI 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myisunje cenene yindu yambone yele yiŵampele kuti myisunje ligongo lya macili ga Msimu Ŵaswela wawuli mwa uwe.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.14",
            "verseOrgIds": [
              "2TI.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2TI 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.14",
            "verseOrgIds": [
              "2TI.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2TI 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkumanyilila kuti ŵandu wosope ŵa cilambo ca Asiya",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.15",
            "verseOrgIds": [
              "2TI.1.15"
            ]
          }
        },
        {
          "text": " ŵandesile une, nipo ŵane ŵa jemanjajo ni Figelo ni Helemogene. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.15",
            "verseOrgIds": [
              "2TI.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2TI 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ambuje alitendele canasa liŵasa lya Onesifolo, ligongo jwalakwe jwasangalasyaga ndaŵi ni katema. Nganatendaga kose soni ni une, atamose naliji jwamtaŵidwe ni unyolo, ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.16",
            "verseOrgIds": [
              "2TI.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2TI 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "nambo piŵayice ku Loma, ŵatandite kusosa une mpaka ŵasimene. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.17",
            "verseOrgIds": [
              "2TI.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2TI 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngupopela kwa Ambuje Yesu kuti tamŵende Mlungu kuti tamtendele canasa Onesifolo pa lisiku lyakumalisya. Mkumanyilila soni cenene yiŵatite pakungamucisya ku Efeso.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.18",
            "verseOrgIds": [
              "2TI.1.18"
            ]
          }
        }
      ]
    }
  ],
