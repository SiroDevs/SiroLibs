          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti Dema anonyelwe ni yapasi pano, nipo andesile apite ku Atesalonika. Klesike ŵapite ku Galatiya,",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.10",
            "verseOrgIds": [
              "2TI.4.10"
            ]
          }
        },
        {
          "text": " nipo Tito ŵapite ku Dalimatiya.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.10",
            "verseOrgIds": [
              "2TI.4.10"
            ]
          }
        },
