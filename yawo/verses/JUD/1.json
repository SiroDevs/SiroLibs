          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpela muyaŵelele, ŵandu ŵeleŵa akutenda myoyopeyo. Pakuya sagamisi syawo, akusayijonanga yilu yawo, akusawukanya ulamusi wa Mlungu, nambo soni akusiŵatendela cipongwe ŵalumbili ŵakwinani. ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.8",
            "verseOrgIds": [
              "JUD.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
