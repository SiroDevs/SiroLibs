                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Enoki, jwa mpago wa msano ni jiŵili",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.14",
            "verseOrgIds": [
              "JUD.1.14"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "1:14",
              "type": "text"
            },
            {
              "text": "Msano ni jiŵili:",
              "type": "text"
            },
            {
              "text": "Kuŵalanjila kweleku kukupwatika lina lyandanda soni lyakumalisya mwikuga lya mena msano ni gaŵili kutandila pa Adamu mpaka pa Enoki.",
              "type": "text"
            }
          ]
        },
        {
          "text": " kutandila pa Adamu, ŵalocesye ya ŵandupe piŵatite kuti, “Mlole, Ambuje alimkwisa ni malayika gakwe, gele gangaŵa mkomboleka kugaŵalanga. ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.14",
            "verseOrgIds": [
              "JUD.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JUD 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akwisa kukwalamula ŵandu wosope. Ŵandu ŵangalumbana tapocele cilango ligongo lya yindu yakusatenda, soni ligongo lya maloŵe gosope gacabe gakusaŵeceta mwakwasisya Ambuje.”",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.15",
            "verseOrgIds": [
              "JUD.1.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
