                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nambo atamose Mikaele",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.9",
            "verseOrgIds": [
              "JUD.1.9"
            ]
          }
        },
        {
          "text": " ŵene, ŵakulungwa ŵa malayika, piŵakanganaga ni Satana,",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.9",
            "verseOrgIds": [
              "JUD.1.9"
            ]
          }
        },
        {
          "text": " ni kusisyana najo pa ya mtembo wa Mose,",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.9",
            "verseOrgIds": [
              "JUD.1.9"
            ]
          }
        },
        {
          "text": " ŵalakwewo nganasosa kuŵeceta mwacipongwe kuti Satana ali jwakulemwa. Nambo ŵatite kuti, “Ambuje ampe cilango.” ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.9",
            "verseOrgIds": [
              "JUD.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JUD 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo ŵandu ŵeleŵa akatendela cipongwe yindu yangakuyipikanicisya. Nipo yindu yakusayimanyilila ni lunda lwa mundu, mpela musiŵelele nyama, yindu yeleyi ni yikusiyajonanga. ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.10",
            "verseOrgIds": [
              "JUD.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JUD 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
