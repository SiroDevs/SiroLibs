                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Cikalataci cikutyocela kwa une Yuda, jwakutumicila jwa Yesu",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.1",
            "verseOrgIds": [
              "JUD.1.1"
            ]
          }
        },
        {
          "text": " Klistu,",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.1",
            "verseOrgIds": [
              "JUD.1.1"
            ]
          }
        },
        {
          "text": " nambo soni mpwakwe jwa Yakobo.",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.1",
            "verseOrgIds": [
              "JUD.1.1"
            ]
          }
        }
