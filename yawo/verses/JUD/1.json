                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.16.1+NUM.16.2+NUM.16.3+NUM.16.4+NUM.16.5+NUM.16.6+NUM.16.7+NUM.16.8+NUM.16.9+NUM.16.10+NUM.16.11+NUM.16.12+NUM.16.13+NUM.16.14+NUM.16.15+NUM.16.16+NUM.16.17+NUM.16.18+NUM.16.19+NUM.16.20+NUM.16.21+NUM.16.22+NUM.16.23+NUM.16.24+NUM.16.25+NUM.16.26+NUM.16.27+NUM.16.28+NUM.16.29+NUM.16.30+NUM.16.31+NUM.16.32+NUM.16.33+NUM.16.34+NUM.16.35"
              },
              "items": [
                {
                  "text": "16:1-35",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Jemanjaji akwete likungu, ligongo ŵakuyisye litala lya Kaini. Mpela mujwatendele Balamu, nombe nawo ŵagwile soni mu ulemwa ligongo lyakusosa kupata mbiya. Ligongo lya kumjimucila Mlungu, ŵajonasile jemanjajo mpela muŵatendele ni Kola. ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.11",
            "verseOrgIds": [
              "JUD.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JUD 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jemanjaji ni ŵele ŵakusasakasya yindimba yenu yacinonyelo. Akusalya namwe mwakutesya soni, ni kulikamucisya acimsyenepe. Ali mpela mawunde gakusajigalidwa ni mbungo, nambo gele gangayika ni ula. Ali mpela yitela yele yangasogola yisogosi atamose ndaŵi yajikwenela kusogola, yiyawile nditu, nipo ŵandu ŵayitupwile. ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.12",
            "verseOrgIds": [
              "JUD.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JUD 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jemanjaji ali mpela matumbela gaukali ga panyasa gagakusakoposya ciwulo ca yakusakala yawo. Ali mpela ndondwa syesokonecele, nipo Mlungu akwasunjila malo ga cipi cekulungwa ca ndaŵi syosope.",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.13",
            "verseOrgIds": [
              "JUD.1.13"
            ]
          }
        }
      ]
    },
