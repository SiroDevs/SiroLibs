              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngulemba cikalataci kwa jemanja ŵiŵamŵilasile Mlungu, ŵimkutama mcinonyelo ca Mlungu Atati ni mcitetelo ca Yesu Klistu.",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.1",
            "verseOrgIds": [
              "JUD.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JUD 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.1",
            "verseOrgIds": [
              "JUD.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JUD 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mlungu aculuye canasa cakwe, mtendele ni cinonyelo cakwe kwa jemanja.",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.2",
            "verseOrgIds": [
              "JUD.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ya aciŵalimu ŵa unami",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JUD 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.2",
            "verseOrgIds": [
              "JUD.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JUD 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Acalongo acimjangu ŵakunonyelwa, naliji jwakusosasosa kuti namlembele cikalata, kuti namsalile ya cikulupusyo cetuwe. Nambo mtima wangu, wanganganicisye kuti namlembele cikalata kumsalila kuti, mputeje ngondo ja cikulupi, ciŵacipelece Mlungu kampepe kwa ŵandu. ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.3",
            "verseOrgIds": [
              "JUD.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JUD 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵandu ŵangakulupilila Mlungu, soni ŵele ŵaŵaliji ŵakwenela kupocela cilango, ajinjile sikati jenu mwakulisisa. Jemanjaji akusasokonesya utenga wa umbone mtima wa Mlungu, ni kuwutendekasya kuwa ufulu wakutendela yakusakala. Jemanjaji akasiŵakanya Yesu Klistu, mlongola jwetu ni Ambuje ŵetu. Yakuti ŵanganyaŵa tacipocela cilango yalembedwe kalakala.",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.4",
            "verseOrgIds": [
              "JUD.1.4"
            ]
          }
        }
      ]
    },
    {
