  "bookId": "1PE",
  "reference": "1 Pet 1",
  "verseCount": 24,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "1PE 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1PE 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cikalataci cikutyocela kwa une Petulo,",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.1",
            "verseOrgIds": [
              "1PE.1.1"
            ]
          }
        },
        {
          "text": " ndumetume",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.1",
            "verseOrgIds": [
              "1PE.1.1"
            ]
          }
        },
        {
          "text": " jwa Yesu",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.1",
            "verseOrgIds": [
              "1PE.1.1"
            ]
          }
        },
        {
          "text": " Klistu.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.1",
            "verseOrgIds": [
              "1PE.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1PE 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cikalataci cikuja kwa jemanja ŵimli ŵakusagulidwa ŵa Mlungu ŵimpwilingene ŵimli ku cilambo ca cilendo, ku ma upande ga Pontasi, Galatiya,",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.1",
            "verseOrgIds": [
              "1PE.1.1"
            ]
          }
        },
        {
          "text": " Kapadokiya, Asiya",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.1",
            "verseOrgIds": [
              "1PE.1.1"
            ]
          }
        },
        {
          "text": " ni Bitiniya. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.1",
            "verseOrgIds": [
              "1PE.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1PE 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mlungu Atati ŵamsagwile jemanja mpela muŵaganicisye pandanda, kuti Msimu Ŵaswela amswejesye nambo soni kuti mumpikanile Yesu Klistu, ni kuswejesedwa ni miasi jakwe.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.2",
            "verseOrgIds": [
              "1PE.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1PE 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mlungu amsalalile mtima ni kumpa mtendele wakupundanganya.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.2",
            "verseOrgIds": [
              "1PE.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Cembeceyo ca umi wangamala",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1PE 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.2",
            "verseOrgIds": [
              "1PE.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1PE 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwende tumtogolele Mlungu Atati ŵa Ambuje ŵetu Yesu Klistu. Jwalakwejo mwa canasa cakwe cekulungwa ŵatupele umi wasambano pakumjimusya Yesu Klistu kutyocela ku ŵawe. Yeleyi yikusatulimbikasya mtima ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.3",
            "verseOrgIds": [
              "1PE.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1PE 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuti tucipocela cakupata cacili cili cangawola kapena konasika, kapena kunyala yakumsunjila Mlungu jemanja kwinani. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.4",
            "verseOrgIds": [
              "1PE.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1PE 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwamacili gakwe Mlungu akumsunjila jemanja ŵikumkulupilila jwalakwejo kuti timpocele cikulupusyo cele jwalakwejo ali cile kucilosya pa ndaŵi jakumalisya.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.5",
            "verseOrgIds": [
              "1PE.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1PE 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.5",
            "verseOrgIds": [
              "1PE.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1PE 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeleyi yimsangalasyeje, atamose kuti kwa ndaŵi japanandi mkuyiwona yipwetesi pakulinjidwa mwakulekanganalekangana. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.6",
            "verseOrgIds": [
              "1PE.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1PE 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cakulinga cakwe cili cakuti alosye kuti cikulupi cenu cili cisyesyene. Atamose golidi,",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.7",
            "verseOrgIds": [
              "1PE.1.7"
            ]
          }
        },
        {
          "text": " jwele komboleka konanjidwa, akusalinjidwa ni moto, myoyo soni cikulupi cenu cacili ca mtengo wapenani kupunda golidi jwakusajonasika, atamose julinjidwe pa moto, myoyo soni cikulupi cenu cele cili ca mtengo mnope kupunda golidi cikwenela kulinjidwa kuti ciŵe cakulosya kuti cili cisyesyene. Myoyo timcipocela matogolelo, lumbili ni ucimbicimbi pa ndaŵi jitaciyika Yesu Klistu. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.7",
            "verseOrgIds": [
              "1PE.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1PE 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwalakweju nganimumwoneje, nambope mkusimumnonyela, soni mkusakulupilila mwa jwalakwejo, atamose kuti pa ndaŵi jejino ngamkumwona. Myoyo mkusasengwa ni lukondwa lwekulungwa lwangaŵalanjika. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.8",
            "verseOrgIds": [
              "1PE.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1PE 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakutenda myoyo mkupata mbote ja cikulupi, cacili cikulupusyo ca umi wenu.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.9",
            "verseOrgIds": [
              "1PE.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1PE 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.9",
            "verseOrgIds": [
              "1PE.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1PE 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵakulocesya uŵasasile cilepe ya mbote jalulele jitimcipocelajo, ŵasosagasosaga mwakuwungunyawungunya ya cikulupusyoci. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.10",
            "verseOrgIds": [
              "1PE.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1PE 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵalinjilile kusimana ndaŵi jitiyicitendekwa yeleyi, nambo soni mwa litalaci? Jeleji jaliji ndaŵi jakuti Msimu wa Klistu uwaliji mwa jemanjajo waliji mkwalosya, pakwasalila ya msogolo kwambaga ya yisawusyo yele Klistu ŵajenele kupilila nambo ya lumbili lulwaliji mkwisa. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.11",
            "verseOrgIds": [
              "1PE.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1PE 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mlungu ŵajuŵile yeleyi kwa ŵakulocesya kuti masengo gawogo nganagakamulaga ligongo lya jemanjajo acimsyene, nambo ligongo lya jemanja, mpela muŵaŵecetele yakwamba yindu yimyipikene jemanja kutyocela kwa jemanjajo uŵamlalicile Ngani Syambone",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.12",
            "verseOrgIds": [
              "1PE.1.12"
            ]
          }
        },
        {
          "text": " mwamacili ga Msimu Ŵaswela ŵakutumidwa kutyocela kwinani. Nombe nago malayika",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.12",
            "verseOrgIds": [
              "1PE.1.12"
            ]
          }
        },
        {
          "text": " gakusasaka kuyimanyilila yindu yeleyi.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.12",
            "verseOrgIds": [
              "1PE.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Akwaŵenda kuti alinjeje kuŵa ŵaswela mtima",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1PE 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.12",
            "verseOrgIds": [
              "1PE.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1PE 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ali ni ligongo lyakwe mtima wenu uŵeje tayale. Mŵeje cile ni kutamilisya cikulupi cenu mwakumalilwa pa upile wele tiwucipegwa kwa jemanja pa ndaŵi jitaciwoneka Yesu Klistu. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.13",
            "verseOrgIds": [
              "1PE.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1PE 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mŵeje ŵakumpikanila jwalakwejo, ngakuyaga yimwayikumbilaga pa ndaŵi jimwaliji ŵangamanyilila. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.14",
            "verseOrgIds": [
              "1PE.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1PE 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo mŵeje ŵaswela mtima mu yosope yimkusatenda mpela Mlungu jwenu juŵamŵilasile jemanja ali jwamswela. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.15",
            "verseOrgIds": [
              "1PE.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1PE 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paja yilembedwe m'Malemba kuti, “Mŵeje ŵaswela mtima pakuti Une ndili jwamswela mtima.”",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.16",
            "verseOrgIds": [
              "1PE.1.16"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.11.44+LEV.11.45"
              },
              "items": [
                {
                  "text": "Lef 11:44-45",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.19.2"
              },
              "items": [
                {
                  "text": "19:2",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1PE 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.16",
            "verseOrgIds": [
              "1PE.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1PE 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkumbucileje kuti Mlungu jwangali lusagu. Jwalakwejo akusamjamuka jwalijose mwakulingana ni yitendo yakwe. Naga mkusimwakolanga kuti Atati pa ndaŵi jimkupopela, myoyo mkwenela kwacimbicisya ndaŵi syosope pa ndaŵi jimli acalendo pasi pano. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.17",
            "verseOrgIds": [
              "1PE.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1PE 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkumanyilila cenene ciŵamwombolele naco kuti ndamo jenu jakusakala jimwapocele kutyocela kwa acinangolo ŵenu. Nganamwombola jemanja ni mbiya sisikusajonasika sila mpela silifa,",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.18",
            "verseOrgIds": [
              "1PE.1.18"
            ]
          }
        },
        {
          "text": " kapena golidi, ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.18",
            "verseOrgIds": [
              "1PE.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1PE 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "m'malo mwakwe ŵamwombwele jemanja ni miasi jamtengo wapenani ja Klistu ŵele uŵaliji mpela mwanace jwangondolo jwangali liŵasi lililyose kapena liŵala. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.19",
            "verseOrgIds": [
              "1PE.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1PE 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mlungu ŵamsagwile jwalakwejo cilambo capasi mkinicipanganyidwe, nambo amlosisye jwalakwejo pa ndaŵi jakumalisya jino ligongo lya jemanja. ",
          "type": "text",
          "attrs": {
