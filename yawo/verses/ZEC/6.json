          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.6.14",
            "verseOrgIds": [
              "ZEC.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ZEC 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵandu ŵakutama kwakutalika taciyika kukutaŵa Nyumba ja AMBUJE. Myoyo timcimanyilila kuti AMBUJE Ŵamaciligosope andumile une kwa jemanja. Yeleyi tiyicitendekwa naga mkwapikanila mwacitema AMBUJE, Mlungu jwenu.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.6.15",
            "verseOrgIds": [
              "ZEC.6.15"
            ]
          }
        }
      ]
    }
