              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.27",
            "verseOrgIds": [
              "1JN.2.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1JN 2:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sambano ŵanace ŵangu, mŵeje mwa jwalakwejo, kuti pitaciyika, soni tukasitutenda soni. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.28",
            "verseOrgIds": [
              "1JN.2.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1JN 2:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naga mkumanyilila kuti Klistu ali jwakulungama, m'manyilile soni kuti jwalijose jwakutenda yakulungama, ali Mwanace jwa Mlungu.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.29",
            "verseOrgIds": [
              "1JN.2.29"
            ]
          }
        }
