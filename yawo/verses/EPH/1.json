          ]
        },
        {
          "text": "Klistu akulamulila ayimwene wosope, ŵakulamula wosope ni acakulungwakulungwa wosope ŵakwinani. Nambo soni mena gane gosope gamacili gakamula masengo ndaŵi ajino ni ndaŵi ja msogolo. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.21",
            "verseOrgIds": [
              "EPH.1.21"
            ]
          }
        },
