  "reference": "Aef 3",
  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "3",
        "style": "c",
        "sid": "EPH 3"
      },
      "items": [
        {
          "text": "3",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ya masengo ga Paulo pasikati pa ŵandu ŵa mitundu jine",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EPH 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa lyele ligongoli une Paulo ngumpopelela jemanja ŵandu ŵa mitundu jine,",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.1",
            "verseOrgIds": [
              "EPH.3.1"
            ]
          }
        },
        {
          "text": " pakuŵa ndili mkayidi jwa Klistu",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.1",
            "verseOrgIds": [
              "EPH.3.1"
            ]
          }
        },
        {
          "text": " Yesu",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.1",
            "verseOrgIds": [
              "EPH.3.1"
            ]
          }
        },
        {
          "text": " ligongo lya jemanja. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.1",
            "verseOrgIds": [
              "EPH.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EPH 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kusyene mwapikene ya masengo gaŵambele Mlungu mwa umbone mtima wakwe kuti nagatende kwa jemanja. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.2",
            "verseOrgIds": [
              "EPH.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EPH 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵamanyisye yamtemela yakwe, mpela yinamlembele mwakata yila. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.3",
            "verseOrgIds": [
              "EPH.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EPH 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Patimŵalanjeje yeleyi timpakombole kuyiwona yamtemela yakwaya Klistu.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.4",
            "verseOrgIds": [
              "EPH.3.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.1.26+COL.1.27"
              },
              "items": [
                {
                  "text": "Akolo 1:26-27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.4",
            "verseOrgIds": [
              "EPH.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EPH 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵandu ŵa mipago jakala nganayimanyililaga yamtemelawo, nambo Mlungu awusasile sambano mtemelawo mwa Msimu Ŵaswela kwa ŵandumetume ni ŵakulocesya ŵakwe ŵaswela. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.5",
            "verseOrgIds": [
              "EPH.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EPH 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mtemelawo ni wakuti kupitila mu Ngani Syambone",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.6",
            "verseOrgIds": [
              "EPH.3.6"
            ]
          }
        },
        {
          "text": " ŵandu ŵa mitundu jine nombe nawo akwenela kupocela upile wa Mlungu pamo ni Ayuda. Ali yiŵalo ya cilu cimo, nipo mwa Klistu Yesu akusapocela nawo cilanga",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.6",
            "verseOrgIds": [
              "EPH.3.6"
            ]
          }
        },
        {
          "text": " ca Mlungu.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.6",
            "verseOrgIds": [
              "EPH.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EPH 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.6",
            "verseOrgIds": [
              "EPH.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EPH 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Natendekwe kuŵa jwakulalicila",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.7",
            "verseOrgIds": [
              "EPH.3.7"
            ]
          }
        },
        {
          "text": " Ngani Syambone ni umbone mtima wa Mlungu, nipo pakutenda myoyo ŵalosisye macili gakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.7",
            "verseOrgIds": [
              "EPH.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EPH 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atamose ndili jwangasosekwa mnope pasikati pa ŵandu ŵa Mlungu, nambope Mlungu ŵambele unejo masengo aga, gakuti nalalicile ŵandu ŵa mitundu jine ya cipanje cangamala, cakusatupa Mlungu mwa Klistu. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.8",
            "verseOrgIds": [
              "EPH.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EPH 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵambele masengo gakwasalila ŵandu wosope ya mutacitendela Mlungu yosope yele yiŵapanganyisye cilepe mwamtemela. Mlungu ŵiŵapanganyisye yosope, ŵawusunjile mtemelawo, mkanijikwane ndaŵi. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.9",
            "verseOrgIds": [
              "EPH.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EPH 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sambano akusaka kuti, kupitila mwa mpingo,",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.10",
            "verseOrgIds": [
              "EPH.3.10"
            ]
          }
        },
        {
          "text": " acakulungwa ni ŵamaulamusi wosope ŵakwinani amanyilile ya lunda lwa Mlungu lwa mtundu ni mtundu. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.10",
            "verseOrgIds": [
              "EPH.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EPH 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mlungu ŵayitesile yeleyi kuti yiŵe mwele muŵatendele mwa Klistu Yesu Ambuje ŵetu, mkanijikwane ndaŵi. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.11",
            "verseOrgIds": [
              "EPH.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EPH 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuŵa kuti tuli mwa Klistu soni tukumkulupilila Jwalakwe, ni tukulimba mtima kuŵandicila kwa Mlungu mwangakayicila kose. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.12",
            "verseOrgIds": [
              "EPH.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EPH 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngumŵenda sambano kuti mkajasa mtima pakuti ngulaga ligongo lya jemanja, yeleyi yili yakumpa jemanja ucimbicimbi.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.13",
            "verseOrgIds": [
              "EPH.3.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Cinonyelo ca Klistu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EPH 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.13",
            "verseOrgIds": [
              "EPH.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EPH 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni ligongo lyakwe sambano ngwatindiŵalila Atati, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.14",
            "verseOrgIds": [
              "EPH.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EPH 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "ŵele liŵasa lililyose lya kwinani ni pasi pano likusakolanjidwa ni lina lyawo. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.15",
            "verseOrgIds": [
              "EPH.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EPH 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngumŵenda Mlungu kuti kutyocela mcipanje ca lumbili lwakwe ampe macili, nipo mwa Msimu wakwe Ŵaswela alimbisye umi wenu wa usimu, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.16",
            "verseOrgIds": [
              "EPH.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EPH 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngupopela kuti mwa cikulupi cenu, Klistu atamilicice m'mitima jenu, kuti mtitimice miciga jenu ja cinonyelo, nipo soni kuti mŵice yilimbilimbi ya umi wenu wosope pa cinonyelo. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.17",
            "verseOrgIds": [
              "EPH.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EPH 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngumŵenda Mlungu kuti, pampepe ni ŵandu ŵakwe wosope, mpakombole kumanyilila ya citando cakwe ni ulewu wakwe, cikwesya cakwe ni kwendelela kwakwe kwa cinonyelo ca Klistu. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.18",
            "verseOrgIds": [
              "EPH.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EPH 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kusyene ngupopelela kuti m'manyilile cinonyelo ca Klistu cakupunda lunda lwa ŵandu, kuti mgumbalilwe mnope ni umi wa Mlungu msyene.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.19",
            "verseOrgIds": [
              "EPH.3.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EPH 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.19",
            "verseOrgIds": [
              "EPH.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EPH 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lumbili luŵe kwa Mlungu jwele, mwamacili gakwe gakamula masengo mwetuwe, mpaka mpakombole kutenda mwakuculuya mnope kupunda mwele mutukaŵendele kapena kuganicisya. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.20",
            "verseOrgIds": [
              "EPH.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EPH 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mlungu aŵe ni lumbili mu mpingo ni mwa Klistu Yesu ku ndaŵi syangamala. Ami.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.21",
            "verseOrgIds": [
              "EPH.3.21"
            ]
          }
        }
      ]
    }
  ],
