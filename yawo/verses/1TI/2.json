  "reference": "1 Tim 2",
  "verseCount": 15,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
        "style": "c",
        "sid": "1TI 2"
      },
      "items": [
        {
          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Paulo akwasalila Ŵakulupilila yakwenela kutenda pa ndaŵi jakupopela",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1TI 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cakusosekwa mnope mwa yosope yene cili cakuti paŵeje mapopelo gakwapopelela ŵandu wosope. Mapopelo gakwe gaŵeje gakucondelela, gakuŵenda ni kumtogolela Mlungu. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.1",
            "verseOrgIds": [
              "1TI.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1TI 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwapopeleleje ayimwene ni wosope ŵakwete ulamusi, kuti mwalitala lililyose tutameje mu umi wakutulala ni wa mtendele, kulosya kulipeleka ni ucimbicimbi pameso pa Mlungu ni kutama mwakulungama ni mwa ndamo syambone pameso pa ŵandu ŵane. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.2",
            "verseOrgIds": [
              "1TI.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1TI 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeleyi yili yambone nambo soni yikusamsangalasya Mlungu Mkulupusyo jwetu, ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.3",
            "verseOrgIds": [
              "1TI.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1TI 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "jwakusaka kuti jwalijose akulupusidwe nambo soni kuti amanyilile cakuwona cisyesyene. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.4",
            "verseOrgIds": [
              "1TI.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1TI 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti kwana Mlungu jumpepe, nambo soni jwakwimilila pasikati pa mbali siŵili jumpepe jwampaka ajilanye Mlungu ni ŵandu. Jwalakwejo ali Klistu",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.5",
            "verseOrgIds": [
              "1TI.2.5"
            ]
          }
        },
        {
          "text": " Yesu.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.5",
            "verseOrgIds": [
              "1TI.2.5"
            ]
          }
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.5",
            "verseOrgIds": [
              "1TI.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1TI 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwalakwejo jwalipelece msyene kuti amwombole jwalijose. Welewu waliji umboni uwapelecedwe mu ndaŵi jakwe wakusimicisya kuti Mlungu akusaka kuti mundu jwalijose akulupusidwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.6",
            "verseOrgIds": [
              "1TI.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1TI 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ali ni ligongo lyakwe jwalakwejo ŵambisile une kuti mbe ndumetume",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.7",
            "verseOrgIds": [
              "1TI.2.7"
            ]
          }
        },
        {
          "text": " jwakwe jakwajiganya ŵandu ŵa mitundu jine,",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.7",
            "verseOrgIds": [
              "1TI.2.7"
            ]
          }
        },
        {
          "text": " maloŵe ga cikulupi cisyesyene.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.7",
            "verseOrgIds": [
              "1TI.2.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TI.1.11"
              },
              "items": [
                {
                  "text": "2 Tim 1:11",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1TI 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.7",
            "verseOrgIds": [
              "1TI.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1TI 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngusaka kuti palipose acalume pa ndaŵi jakupopela, anyakulileje makono gawo kwa Mlungu mwakumtendela jwalakwejo ulemu, mwangatumbila kapena kukangana.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.8",
            "verseOrgIds": [
              "1TI.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1TI 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.8",
            "verseOrgIds": [
              "1TI.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1TI 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nombe nawo acakongwe awaleje mwakulicimbicisya, mwalunda ni mwakwenela. Elo, alisalalisye, nambo ngaŵaga ni kutiŵa umbo, kapena ni yakusalalisya yakupanganyidwa ni golidi,",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.9",
            "verseOrgIds": [
              "1TI.2.9"
            ]
          }
        },
        {
          "text": " kapena yuma ya mtengo wapenani, kapena yakuwala ya mtengo wapatali.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.9",
            "verseOrgIds": [
              "1TI.2.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.3.3"
              },
              "items": [
                {
                  "text": "1 Pet 3:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.9",
            "verseOrgIds": [
              "1TI.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1TI 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mnopemnope jemanjaji alisalalisye pakutenda masengo gambone, mpela mwakwenela kutendela acakongwe ŵakusatiji kuti ali ŵakumlambila Mlungu. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.10",
            "verseOrgIds": [
              "1TI.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1TI 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pandaŵi jakulijiganya, jwamkongwe alijiganyeje mwakumyalala ni mtima ŵakulinondiya. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.11",
            "verseOrgIds": [
              "1TI.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1TI 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngangukunda kuti jwamkongwe alijiganyeje kapena kukola ulamusi pa jwamlume, kwakwe kuli kutama jii. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.12",
            "verseOrgIds": [
              "1TI.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1TI 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pajatu Adamu",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.13",
            "verseOrgIds": [
              "1TI.2.13"
            ]
          }
        },
        {
          "text": " ni juŵatandite kupanganyidwa, kaneko Hawa.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.13",
            "verseOrgIds": [
              "1TI.2.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.2.7"
              },
              "items": [
                {
                  "text": "Gen 2:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.2.21+GEN.2.22"
              },
              "items": [
                {
                  "text": "21-22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.13",
            "verseOrgIds": [
              "1TI.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1TI 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo soni ngaŵaga Adamu ni uŵalambusidwe ni Satana",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.14",
            "verseOrgIds": [
              "1TI.2.14"
            ]
          }
        },
        {
          "text": " jula, nambo jwamkongwe ni juŵalambusidwe nipo ŵakasile Lilamusi lya Mlungu.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.14",
            "verseOrgIds": [
              "1TI.2.14"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.3.1+GEN.3.2+GEN.3.3+GEN.3.4+GEN.3.5+GEN.3.6"
              },
              "items": [
                {
                  "text": "Gen 3:1-6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.14",
            "verseOrgIds": [
              "1TI.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1TI 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo jwamkongwe tacikulupuka kupitila mu kuŵeleka ŵanace, naga akulimbicila kutama mwakulinondiya mcikulupi, mcinonyelo ni mu uswela mtima.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.15",
            "verseOrgIds": [
              "1TI.2.15"
            ]
          }
        }
      ]
    }
