      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 21:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehoshafati ŵawile nipo cilu cakwe ŵacisicile m'malembe ga ayimwene mu msinda wa Daudi",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.1",
            "verseOrgIds": [
              "2CH.21.1"
            ]
          }
        },
        {
          "text": " nipo Yeholamu ŵajinjile ucimwene m'malo mwa babagwewo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.1",
            "verseOrgIds": [
              "2CH.21.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mwenye Yeholamu jwa ku Yuda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 21:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.1",
            "verseOrgIds": [
              "2CH.21.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeholamu mwanace jwa Mwenye Yehoshafati ŵa ku Yuda ŵakwete acapwakwe msano ni jumo ŵakuyicisyaŵa: Asaliya, Yehiyele, Sakaliya, Asaliyahu, Mikaele, ni Shefatiya. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.2",
            "verseOrgIds": [
              "2CH.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baba ŵawo ŵapele jemanjajo golidi",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.3",
            "verseOrgIds": [
              "2CH.21.3"
            ]
          }
        },
        {
          "text": " ni silifa",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.3",
            "verseOrgIds": [
              "2CH.21.3"
            ]
          }
        },
        {
          "text": " jwamjinji ni yindu yine ya mtengo wapenani, soni ŵamŵisile mwanace jwalijose kuti aŵe jwakulolela misinda jakulupucilamo ja ku Yuda. Nambo ligongo lyakuti Yeholamu ŵaliji mwanace jwakwitiwo, Yehoshafati ŵamtesile jwalakwejo kuti tajinjile ucimwene m'malo mwa babagwewo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.3",
            "verseOrgIds": [
              "2CH.21.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeholamu piŵajinjile ucimwene ni kutamilicika pa citengu ca ucimweneco, jwalakwe ŵawuleje acapwakwe wosope, ni nduna sine sya ku Isalaeli.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.4",
            "verseOrgIds": [
              "2CH.21.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.4",
            "verseOrgIds": [
              "2CH.21.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeholamu ŵajinjile ucimwenewo piŵaliji ni yaka 32, nipo jwalakwejo ŵalamulile ku Yelusalemu yaka yakwana msano ni yitatu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.5",
            "verseOrgIds": [
              "2CH.21.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwalakwe ŵakuyisye ndamo jakusakala ja Mwenye Ahabu ni ayimwene ŵane ŵa ku Isalaeli, ligongo lyakuti ŵaliji ali alombele mwanace jwamkongwe jwa Ahabu. Myoyo ŵalemwecesye AMBUJE.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.6",
            "verseOrgIds": [
              "2CH.21.6"
            ]
          }
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.6",
            "verseOrgIds": [
              "2CH.21.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo AMBUJE nganasaka konanga liŵasa lya Daudi, ligongo ŵaliji ali atesile cilanga",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.7",
            "verseOrgIds": [
              "2CH.21.7"
            ]
          }
        },
        {
          "text": " ni Daudiwo kuti ŵanace ŵakwe tacipitilisya kulamulila.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.7",
            "verseOrgIds": [
              "2CH.21.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
