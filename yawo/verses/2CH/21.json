          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.19",
            "verseOrgIds": [
              "2CH.21.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 21:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeholamu ŵajinjile ucimwene pa ndaŵi jiŵaliji ni yaka 32, nipo ŵalamulile ku Yelusalemu kwa yaka yakwana msano ni yitatu. Pandaŵi jiŵawile Yeholamu, paliji pangali mundu jwalijose juŵamtendele canasa jwalakwejo. Jwalakwejo ŵamsicile mu Msinda wa Daudi, nambo ngaŵaga m'malembe ga ayimwene.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.20",
            "verseOrgIds": [
              "2CH.21.20"
            ]
          }
        }
      ]
