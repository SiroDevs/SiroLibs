            "style": "v",
            "sid": "2CH 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.1",
            "verseOrgIds": [
              "2CH.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Panyuma pakwe Mwenye Solomoni ŵasalile acimlongola wosope ŵa ngosyo ni ŵa maŵasa ga Aisalaeli kuti akasongane ku Yelusalemu ni cakulinga cakuti akajigale Libokosi lya Cilanga ca AMBUJE kutyoka nalyo ku Siyoni,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.2",
            "verseOrgIds": [
              "2CH.5.2"
            ]
          }
        },
        {
          "text": " msinda wa Daudi ni kwawula nalyo ku Nyumba ja AMBUJE.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.2",
            "verseOrgIds": [
              "2CH.5.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
