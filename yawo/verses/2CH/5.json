          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoni piŵamasile masengo gakutaŵa Nyumba ja AMBUJE, jwalakwejo ŵaŵisile myipinda yakusunjilamo katundu yindu yosope yiŵapelece Daudi",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.1",
            "verseOrgIds": [
              "2CH.5.1"
            ]
          }
        },
        {
          "text": " babagwe kwa AMBUJE, ŵaŵisilemo soni silifa,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.1",
            "verseOrgIds": [
              "2CH.5.1"
            ]
          }
        },
        {
          "text": " golidi",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.1",
            "verseOrgIds": [
              "2CH.5.1"
            ]
          }
        },
        {
          "text": " ni yindu yine.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.1",
            "verseOrgIds": [
              "2CH.5.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
