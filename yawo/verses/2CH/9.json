          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoni ŵalamulile ku Yelusalemu yaka 40. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.30",
            "verseOrgIds": [
              "2CH.9.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2CH 9:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaneko Solomoni ŵawile nipo ŵasicile mwilembe mu msinda wa Daudi,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.31",
            "verseOrgIds": [
              "2CH.9.31"
            ]
          }
        },
        {
          "text": " nipo Lehobowamu mwanace jwawo jwajinjile ucimwene m'malo mwa babagwe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.31",
