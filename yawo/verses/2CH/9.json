          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoni ŵaliji mwenye jwakusicila nambo soni jwalunda kwapunda ayimwene wosope ŵa pa cilambo capasi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.22",
            "verseOrgIds": [
              "2CH.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayimwene wosope ŵa pa cilambo capasi ŵayikaga kukupikanila lunda lwa Solomoni luŵapegwile ni Mlungu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.23",
            "verseOrgIds": [
              "2CH.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Caka cilicose ayimweneŵa ŵayikaga ni mituka ja yindu yakupanganyidwa ni silifa ni golidi, mikanjo, yida ya ngondo, yakunonyesya yakulya, mahaci, ni ngamila.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.24",
            "verseOrgIds": [
              "2CH.9.24"
            ]
          }
        }
      ]
