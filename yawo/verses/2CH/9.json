          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Masengo gosope giŵatesile Solomoni pa ndaŵi jiŵaliji mwenye, kutyocela pandanda mpaka pa mbesi galembedwe m'mabuku ga mbili ga jwakulocesya",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.29",
            "verseOrgIds": [
              "2CH.9.29"
            ]
          }
        },
        {
          "text": " Natani, ni m'buku ja jwakulocesya Ahiya jwa ku Shilo, ni jwakulocesya Ido juŵalembile ya Yelobowamu mwanace jwa Nebati. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.29",
            "verseOrgIds": [
              "2CH.9.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
