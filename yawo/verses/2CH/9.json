          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵalamulilaga yilambo yosope kutyocela ku mbali ja Lusulo lwa Yufuleti mpaka ku cilambo ca Filisitiya, mpaka soni ku malile ga cilambo ca Iguputo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.26",
            "verseOrgIds": [
