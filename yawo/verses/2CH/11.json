      },
      "items": [
        {
          "text": "11",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kulocesya kwa Shemaya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenye Lehobowamu piŵayice ku Yelusalemu, ŵaganisisye soni yakuti apute ngondo ni Aisalaeli ni cakulinga cakuti alamulileje soni cilamboco. Myoyo ŵasongenye asilikali ŵakwana 1,800 kutyocela ku ngosyo sya Yuda ni Benjamini. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.1",
            "verseOrgIds": [
              "2CH.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo AMBUJE ŵaliji ali amsalile jwakulocesya",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.2",
            "verseOrgIds": [
              "2CH.11.2"
            ]
          }
        },
        {
          "text": " Shemaya ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.2",
            "verseOrgIds": [
              "2CH.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuti akasale utengawu kwa Mwenye Lehobowamu ni kwa ŵandu wosope ŵa lukosyo lwa Yuda ni Benjamini kuti: ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.3",
            "verseOrgIds": [
              "2CH.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mkajawula kuputa ngondo ni Aisalaeli. Mundu jwalijose ajawuleje kumangwakwe. Pakuti yeleyi yitendece ligongo lya lisosa lyangu.” Ŵanduwo ŵagapikanile maloŵe ga AMBUJE nipo nganajawula kuputa ngondo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.4",
            "verseOrgIds": [
              "2CH.11.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lehobowamu ŵataŵile ndenje kusyungulila misinda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.4",
            "verseOrgIds": [
              "2CH.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lehobowamu piŵayice ku Yelusalemu, ŵataŵile misinda jakulicenjela jakuyicisyaji ku Yuda: ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.5",
            "verseOrgIds": [
              "2CH.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Betelehemu, Etamu, Tekowa, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.6",
            "verseOrgIds": [
              "2CH.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Beti Suli, Soko, Adulamu, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.7",
            "verseOrgIds": [
              "2CH.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gati, Malesha, Sifi, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.8",
            "verseOrgIds": [
              "2CH.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adolayimu, Lakishi, Aseka, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.9",
            "verseOrgIds": [
              "2CH.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sola, Aiyaloni, ni Hebuloni. Misinda jesopeji jaliji ku cilambo ca Yuda ni Benjamini. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.10",
            "verseOrgIds": [
              "2CH.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵataŵile mapupa gakulimbangana, nipo mu msinda uliwose ŵamŵisile mlongola jwa ngondo. Ŵaŵisilemo soni yakulya, mawuta ga olifi,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.11",
            "verseOrgIds": [
              "2CH.11.11"
            ]
          }
        },
        {
          "text": " ni finyo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.11",
            "verseOrgIds": [
              "2CH.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵaŵisilemo soni yakucijila pa ngondo ni mipamba, mwalitala lyeleli misinda ja Yuda ni Benjamini jaliji jakulimbangana nipo Lehobowamu ŵalamulilaga ŵandu ŵa ku Yuda ni ku Benjamini.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.12",
            "verseOrgIds": [
              "2CH.11.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ŵakutaga mbopesi ni Alefi akwika ku Yuda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.12",
            "verseOrgIds": [
              "2CH.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵakutaga mbopesi pamo ni Alefi ŵa ku Isalaeli ŵayice kum'mwela ku Yuda kutyocela kuŵatamaga kumkuya Lehobowamu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.13",
            "verseOrgIds": [
              "2CH.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alefi ŵalesile malo gawo gakulicisya yilangwa ni misinda jawo nipo ŵajile kutama ku Yuda ni ku Yelusalemu ligongo lyakuti Mwenye Yelobowamu ŵa ku Isalaeli pamo ni ayimwene ŵaŵajinjile m'malo mwakwe ŵatyosisye Alefi pa masengo gawo ga umbopesi kwa AMBUJE. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.14",
            "verseOrgIds": [
              "2CH.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myoyo Lehobowamu ŵasagwile ŵakutaga mbopesi ŵakweŵakwepe kuti akamuleje masengo atumicileje ku malo gakujilambililako milungu ja cilendo, ni malo gane kuŵalambilaga misimu ja kusakala ni tumilungu twakusepa tuŵatupanganyisye mcilandanyo ca ŵanace ŵa ng'ombe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.15",
            "verseOrgIds": [
              "2CH.11.15"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.12.31"
              },
              "items": [
                {
                  "text": "1 Ayi 12:31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.15",
            "verseOrgIds": [
              "2CH.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo ŵandu ŵane ŵaŵasimicisye m'mitima mwawo kuti tiŵalambileje AMBUJE, Mlungu juŵamlambilaga Aisalaeli, ŵakuyaga Alefi ŵala mpaka ku Yelusalemu kuti akapelece mbopesi kwa AMBUJE, Mlungu juŵalambilanga acinangolo ŵawo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.16",
            "verseOrgIds": [
              "2CH.11.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jemanjajo ŵawutendesye ucimwene wa Yuda kuti uŵe ŵakulimbangana, nipo ŵamkamucisye Lehobowamu mwanace jwa Solomoni kwa yaka yitatu soni ŵakuyaga ndamo ja Daudi",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.17",
            "verseOrgIds": [
              "2CH.11.17"
            ]
          }
        },
        {
          "text": " ni Solomoni.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.17",
            "verseOrgIds": [
              "2CH.11.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Liŵasa lya Lehobowamu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.17",
            "verseOrgIds": [
              "2CH.11.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵamkwawo Lehobowamu ŵaliji Mahalati, mwanace jwamkongwe jwa Yelimoti juŵaliji mwanace jwa Daudi. Mamagwe ŵaliji Abihayilo mwanace jwamkongwe jwa Eliyabu mwanace jwa Yese. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.18",
            "verseOrgIds": [
              "2CH.11.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lehobowamu ni Mahalati ŵakwete ŵanace ŵatatu, mena gawo galiji Yeushi, Shemaliya ni Sahamu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.19",
            "verseOrgIds": [
              "2CH.11.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaneko Lehobowamu ŵalombile Maaka, mwanace jwamkongwe jwa Abisalomu, nipo ŵakwete ŵanace mcece, mena gawo galiji Abiya, Atayi, Sisa, ni Shelomiti. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.20",
            "verseOrgIds": [
              "2CH.11.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lehobowamu ŵanonyelaga mnope Maaka mwanace jwamkongwe jwa Abisalomu kwapunda aciŵamkwakwe wosope. Ŵalombele acakongwe ŵakwana 18, nambo soni ŵakwete acakongwe ŵane ŵapambali ŵakwana 60, nipo ŵakwete ŵanace ŵacalume ŵakwana 28, ni ŵacakongwe ŵakwana 60. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.21",
            "verseOrgIds": [
              "2CH.11.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵamsagwile mwanace jwawo jwamkulungwa lina lyakwe Abiya jwele juŵaŵelecedwe ni Maaka kuti aŵe mwenye. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.22",
            "verseOrgIds": [
              "2CH.11.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lehobowamu ŵaliji ŵalunda mnope, nipo ŵasagwile ŵanace ŵakwe ŵane kuti aŵe ŵakulolela misinda jakulupucila ku madela ga Yuda ni Benjamini mu ucimwene wakwe. Ŵapaga yakulya yosope yiŵasakaga nambo soni ŵasosele jemanjajo acakongwe ŵakuti alombele.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.23",
            "verseOrgIds": [
              "2CH.11.23"
            ]
          }
        }
      ]
    }
  ],
