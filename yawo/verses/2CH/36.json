            "number": "8",
            "style": "v",
            "sid": "2CH 36:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Masengo gosope giŵatesile Yehoiyakimu, ni yakusakala yiŵatesile, yilembedwe mu Buku ja Mbili ja Ayimwene ŵa ku Isalaeli ni ku Yuda. Nipo Yehoiyakini ŵajinjile ucimwene m'malo mwa babagwe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.8",
            "verseOrgIds": [
