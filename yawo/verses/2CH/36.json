              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵandu ŵa mcilambo ca Yuda ŵamjigele Yehowahasi mwanace jwa Yosiya nipo ŵamjinjisye ucimwene ku Yelusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.1",
            "verseOrgIds": [
              "2CH.36.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 36:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yowahasi ŵaliji ni yaka 23 piŵajinjilaga ucimwene ŵa ku Yuda, nipo ŵalamulile ku Yelusalemuko kwa miesi jitatu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.2",
            "verseOrgIds": [
              "2CH.36.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 36:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenye Neko ŵa ku Iguputo ŵamkamwile ukapolo Mwenye Yehowahasi nipo ŵacilamwile cilambo ca Yuda kuti cikome msongo ŵakwanila makilogalamu 3,400 ga silifa,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.3",
            "verseOrgIds": [
              "2CH.36.3"
            ]
          }
        },
        {
          "text": " ni makilogalamu 34 ga golidi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.3",
            "verseOrgIds": [
              "2CH.36.3"
            ]
          }
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.3",
            "verseOrgIds": [
              "2CH.36.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 36:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myoyo Mwenye Neko ŵamŵilasile Eliyakimu mpwakwe jwa Yowahasi, kuti aŵe mwenye jwakulamulila ku Yuda ni ku Yelusalemu nipo ŵasindile lina lyakwe kuŵa Yehoiyakimu. Yohowahasi ŵajigalidwe kwawula ku Iguputo ni Mwenye Neko.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.4",
            "verseOrgIds": [
              "2CH.36.4"
            ]
          }
        },
        {
