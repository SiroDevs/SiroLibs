        },
        {
          "text": "Nebukadinesa ŵajigele yida ya m'Nyumba ja AMBUJE nipo ŵajile kuyiŵika m'nyumba jakwe ja ucimwene ku Babiloni. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.7",
            "verseOrgIds": [
