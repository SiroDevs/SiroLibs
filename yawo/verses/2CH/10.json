                "loc": "2SA.20.1"
              },
              "items": [
                {
                  "text": "2 Sam 20:1",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myoyo ŵandu ŵa ku Isalaeli ŵatyosile kwawula kumangwawo, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.16",
            "verseOrgIds": [
              "2CH.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "nipo ŵamlesile Lehobowamu kuti ŵalamulileje ŵandu ŵa mu upande wakwe wa ku Yuda.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.17",
            "verseOrgIds": [
              "2CH.10.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.17",
            "verseOrgIds": [
              "2CH.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaneko Mwenye Lehobowamu ŵatumile Hadolamu juŵaliji jwakulolela masengo gangalipidwa nago kuti ajawule akaŵecetane nawo ŵanduwo, nambo ŵanduwo ŵamwuleje pakumsoma ni maganga. Kaneko Lehobowamu ŵakwesile ligeleta lyakwe nipo ŵatilile ku Yelusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.18",
            "verseOrgIds": [
              "2CH.10.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutyocela ndaŵi jelejo ŵandu ŵa ngosyo sya kumpoto kwa cilambo ca Isalaeli aŵele ali mkulijimucila liŵasa lya Daudi mpaka sambano jino.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.19",
            "verseOrgIds": [
              "2CH.10.19"
            ]
          }
        }
      ]
    }
