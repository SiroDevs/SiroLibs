          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Masengo gosope giŵatesile pa ndaŵi jiŵaliji mwenye, kutandilila pandanda mpaka pambesi galembedwe mu mabuku ga Mbili ja ayimwene ŵa ku Yuda ni ku Yelusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.26",
            "verseOrgIds": [
              "2CH.28.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 28:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenye Ahasi ŵawile nipo ŵasicile ku Yelusalemu, nambo ngaŵaga ku malembe ga ayimwene. Nipo Hesekiya mwanace jwawo ni juŵajinjile ucimwene m'malo mwa babagwe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.27",
            "verseOrgIds": [
              "2CH.28.27"
            ]
          }
