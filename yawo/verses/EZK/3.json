            }
          ]
        },
        {
          "text": "Mlungu ŵatite, “M'mwe mwanace jwa mundu, mlye cipukutuci; ni mjawule mkaŵecete ni Aisalaeli.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.1",
            "verseOrgIds": [
              "EZK.3.1"
            ]
          }
        },
        {
