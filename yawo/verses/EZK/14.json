          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.20",
            "verseOrgIds": [
              "EZK.14.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayi ni yakuŵeceta AMBUJE Mlungu: “Tinjitumisya yilango yakogoya mnope pa Yelusalemu, ngondo, sala, yilombo, ni yilwele kuti yijonanje ŵandu ni yinyama.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.21",
            "verseOrgIds": [
              "EZK.14.21"
            ]
          }
        },
