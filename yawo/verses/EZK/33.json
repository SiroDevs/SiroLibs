        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.21",
            "verseOrgIds": [
              "EZK.33.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 33:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ligulo mundu jula mkanayice, nakamwilwe ni macili ga AMBUJE. Nambo kundaŵi kwakwe piŵayice mundu jula, AMBUJE ŵambucisye macili gakuŵecetela mwamti nganimba soni jwangaŵeceta.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.22",
            "verseOrgIds": [
              "EZK.33.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ulemwa wa ŵandu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
