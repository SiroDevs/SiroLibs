              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa lisiku lyandanda lya mwesi, mcaka ca likumi ni cimo ca ukapolo, AMBUJE",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.1",
            "verseOrgIds": [
              "EZK.26.1"
            ]
          }
        },
        {
          "text": " ŵambelele utenga awu wakuti,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.1",
            "verseOrgIds": [
              "EZK.26.1"
            ]
          }
        },
