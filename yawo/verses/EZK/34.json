                "loc": "EZK.37.24"
              },
              "items": [
                {
                  "text": "Esek 37:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.24",
            "verseOrgIds": [
              "EZK.34.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 34:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tinjitenda cilanga",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.25",
            "verseOrgIds": [
              "EZK.34.25"
            ]
          }
        },
        {
          "text": " ca mtendele ni jemanjajo soni tinjiyityosya yilombo yakogoya mcilambomo, kuti sitameje ni citetelo mcipululu ni gonaga muwukweti.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.25",
            "verseOrgIds": [
              "EZK.34.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 34:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.25",
            "verseOrgIds": [
              "EZK.34.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 34:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Tinjatamika ŵandu ŵangu ciŵandika ni litumbi lyangu, ni tinjagwicisya ula pa ndaŵi jakwe, tijiciŵa ula ja upile. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.26",
            "verseOrgIds": [
              "EZK.34.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 34:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yitela ya m'migunda tiyicisogola yisogosi, soni migunda jiciŵa ni mbeju syakwe, pelepo ŵandu tacitama mwamtendele mcilambo cawo. Tacimanyilila kuti Une ni AMBUJE, ndaŵi jitinjitemanya makongwa gawo ni kwakulupusya kwa ŵele uŵakamwile ukapolo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.27",
            "verseOrgIds": [
              "EZK.34.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EZK 34:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵandu ŵa mitundu jine",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.28",
            "verseOrgIds": [
              "EZK.34.28"
            ]
          }
        },
        {
          "text": " ngasiŵajonanga soni, nipo yilombo yakwitinji ngisiyalya. Tacitama mwa mtendele pangali jwine jwakwajogoya. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.28",
            "verseOrgIds": [
              "EZK.34.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EZK 34:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tinjiculuya yakulima yawo, mwakuti ngasawa soni ni sala mcilambomo, mwakuti ŵandu ŵa mitundu jine ngasiŵanyosya soni. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.29",
            "verseOrgIds": [
              "EZK.34.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EZK 34:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myoyo tacimanyilila kuti Une AMBUJE Mlungu ndili nawo, soni jemanjajo, Aisalaeli ali ŵandu ŵangu. Ni yinguti Une AMBUJE Mlungu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.30",
            "verseOrgIds": [
              "EZK.34.30"
            ]
          }
        }
      ]
    },
