          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Esekiele akuŵeceta ya ngondo ja ku Yelusalemu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mlungu ŵatite, “M'mwe mwanace jwa mundu, mjigale njelwa, mjiŵice pasogolo penu, nipo mjambule citusitusi ca msinda wa Yelusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.4.1",
            "verseOrgIds": [
              "EZK.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Msindawo mwusyungusye ni ngalande, mwunje matuto, mtaŵe masakasa, ni kuŵika yindu yagumulila. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.4.2",
            "verseOrgIds": [
              "EZK.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mjigale ciwaya ni mcijimice mpela lipupa lya cisyano pasikati pa m'mwejo ni msindawo. Mwulolecesye msindawo. Ukusumulidwa msindawo, nipo m'mwejo ni ŵatimciwusumula msindawo. Aci ticiciŵa cimanyisyo ca Aisalaeli.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.4.3",
            "verseOrgIds": [
              "EZK.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.4.3",
            "verseOrgIds": [
              "EZK.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Sambano mgonele kumciji kwenu, nipo tinjiŵika ulemwa",
          "type": "text",
          "attrs": {
            "verseId": "EZK.4.4+EZK.4.5",
            "verseOrgIds": [
              "EZK.4.4",
              "EZK.4.5"
            ]
          }
        },
        {
          "text": " wa mtundu wa Aisalaeli penumwe. Kwa masiku 390 gatimkaŵe kweleko timkalaje ligongo lya ulemwa wawo. Namlamwile m'mwejo lisiku lililyose limo likwamba caka cimo cilicose ca cilango cawo mucicimalila. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.4.4+EZK.4.5",
            "verseOrgIds": [
              "EZK.4.4",
              "EZK.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Patim'malisye yeleyo, mkagalawucile kumlyo kwenu, nipo timcilaga ligongo lya ulemwa wa Yuda kwa masiku mcece, nipo lisiku limo lililyose likwamba caka camtundu ca cilango cawo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.4.6",
            "verseOrgIds": [
              "EZK.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.4.6",
            "verseOrgIds": [
              "EZK.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mlolecesye kusumulwa kwa Yelusalemu. Ni mkono wenu mlolecesye mwakwamuka Yelusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.4.7",
            "verseOrgIds": [
              "EZK.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tinjimtaŵa ni ngonji kuti timlepele galawucila aku nakuku mpela kusumulwa kwa Yelusalemu kuli kumasile.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.4.8",
            "verseOrgIds": [
              "EZK.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.4.8",
            "verseOrgIds": [
              "EZK.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Sambano mjigale tiligu, balele,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.4.9",
            "verseOrgIds": [
              "EZK.4.9"
            ]
          }
        },
        {
          "text": " mbwanda, mbweso, mapemba ni mceŵele. Myiwanganye yosopeyi pampepe kuti mpanganye mkate. Yeleyi ni yicimcilyaga masiku 390 gele gatimcigonela mbali jimo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.4.9",
            "verseOrgIds": [
              "EZK.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tacimkundisyaga kulya magalamu 230 ga mkate pa lisiku, nipo magalamu gelego gakwanileje mpaka lisiku linelyo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.4.10",
            "verseOrgIds": [
              "EZK.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Timcimwaga soni mesi gakulinga, migawo jiŵili pa lisiku. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.4.11",
            "verseOrgIds": [
              "EZK.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkolesye moto ni ndoŵe sya ŵandu, ni mjoce mkate pa motowo, nipo mlye mkatewo ŵandu alikumwona.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.4.12",
            "verseOrgIds": [
              "EZK.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.4.12",
            "verseOrgIds": [
              "EZK.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "AMBUJE",
          "type": "text",
          "attrs": {
            "verseId": "EZK.4.13",
            "verseOrgIds": [
              "EZK.4.13"
            ]
          }
        },
        {
          "text": " ŵatite, “Buledi jweleju ali cilandanyo ca yakulya yangalumbana yele Aisalaeli tacilyaga ku yilambo ya cilendo kwele kutinjatopolela.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.4.13",
            "verseOrgIds": [
              "EZK.4.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.4.13",
            "verseOrgIds": [
              "EZK.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo une natite, “Iyayi, AMBUJE Mlungu, une nganinalisakasyeje jikape. Citandilile wanace wangu mpaka lelo nganindyeje nyama jakuwa jikape kapena jakamulwa ni yilombo. Nganindyeje nyama jilijose jakolanjidwa jangalumbana.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.4.14",
            "verseOrgIds": [
              "EZK.4.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.4.14",
            "verseOrgIds": [
              "EZK.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myoyo Mlungu ŵatite, “Cambone, tinamkunde kocela ndoŵe sya ng'ombe m'malo mwa ndoŵe sya ŵandu, pa malo gakocela mkatewo.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.4.15",
            "verseOrgIds": [
              "EZK.4.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.4.15",
            "verseOrgIds": [
              "EZK.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni ŵaŵecete soni kuti, “M'mwe mwanace jwa mundu, tinanandiyicisye mkate ŵandu ŵa ku Yelusalemu. Ŵanduwo taciŵa ŵakudandawula ligongo tacilingaga yakulya yele yitacilyaga ni mesi gitacimwaga. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.4.16",
            "verseOrgIds": [
              "EZK.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myoyo yakulya ni mesi tiyicimala; taciŵa ŵakudandawula pa ndaŵi jitacilolegana, nipo tacimala ligongo lya ulemwa wawo.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.4.17",
            "verseOrgIds": [
              "EZK.4.17"
            ]
          }
        }
      ]
    }
  ],
