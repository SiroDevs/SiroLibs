              },
              "items": [
                {
                  "text": "Ciw 18:11-19",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EZK 27:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.34",
            "verseOrgIds": [
              "EZK.27.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EZK 27:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Jwalijose jwakutama mungulugulu nyasa yamjogoyisye yele yayimtendecele. Ayimwene ŵawo akutenda woga, ngope syawo sikuwoneka syawoga. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.35",
            "verseOrgIds": [
              "EZK.27.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "EZK 27:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵandu ŵamalonda ŵa yilambo yine akumgamba sambano, m'masile mwakutesya woga, nipo ngasimwoneka soni mpaka kalakala.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.36",
            "verseOrgIds": [
              "EZK.27.36"
            ]
          }
        }
      ]
    }
  ],
