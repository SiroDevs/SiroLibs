            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.3",
            "verseOrgIds": [
              "EZK.40.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 40:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundujo ŵatite kuti, “M'mwe mwanace jwa mundu. Mpikanicisye cenene soni mlolecesye yosope yicinamlosye, pakuti lyeleli ni ligongo ni namjigalile akuno. Mwasalile Aisalaeli yosope yitimyiwoneyi.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.4",
            "verseOrgIds": [
              "EZK.40.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Cipata ca kungopoko lyuŵa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 40:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.4",
            "verseOrgIds": [
              "EZK.40.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 40:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sambano naliweni lipupa lilyasyungulile Nyumba ja AMBUJE posepose. Mundu jula ŵajigele litete lyakupimila, ulewu wakwe waliji mamita gatatu, ni ŵapimile lipupalyo. Lyaliji mamita gatatu mcilewu soni mamita gatatu kandapala kwakwe.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.5",
            "verseOrgIds": [
              "EZK.40.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.6.1+1KI.6.2+1KI.6.3+1KI.6.4+1KI.6.5+1KI.6.6+1KI.6.7+1KI.6.8+1KI.6.9+1KI.6.10+1KI.6.11+1KI.6.12+1KI.6.13+1KI.6.14+1KI.6.15+1KI.6.16+1KI.6.17+1KI.6.18+1KI.6.19+1KI.6.20+1KI.6.21+1KI.6.22+1KI.6.23+1KI.6.24+1KI.6.25+1KI.6.26+1KI.6.27+1KI.6.28+1KI.6.29+1KI.6.30+1KI.6.31+1KI.6.32+1KI.6.33+1KI.6.34+1KI.6.35+1KI.6.36+1KI.6.37+1KI.6.38"
              },
              "items": [
                {
                  "text": "1 Ayi 6:1-38",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.3.1+2CH.3.2+2CH.3.3+2CH.3.4+2CH.3.5+2CH.3.6+2CH.3.7+2CH.3.8+2CH.3.9"
              },
              "items": [
                {
                  "text": "2 Mbi 3:1-9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.5",
            "verseOrgIds": [
              "EZK.40.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 40:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaneko ŵapite ku cipata cicalolegene ni kungopoko lyuŵa, ŵakwesile pa masitepe ni penanipo ŵapimile cipataco, ulewu wakwe waliji mamita gatatu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.6",
            "verseOrgIds": [
              "EZK.40.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 40:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paliji pana soni yipinda ya acilonda, soni cipinda cilicose caliji mamita gatatu mcilewu mwakwe, mcijipi mwakwe mwaliji soni mamita gatatu. Mipata ja sikati ja yipindayo jaliji mamita gaŵili ni hafu. Pasogolo pa yipinda ya acilonda paliji pana mpata ulewu wakwe mamita gatatu uwajawulaga ku cipata cakwinjilila cicalolegene ni Nyumba ja AMBUJE. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.7",
            "verseOrgIds": [
              "EZK.40.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 40:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵapimile cipinda celeci ni ŵacisime kuti caliji mamita mcece kwawula pasi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.8",
            "verseOrgIds": [
              "EZK.40.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 40:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumbesiko kwaliji cipata cicaŵandicile Nyumba ja AMBUJE, soni yipilala yakwe yaliji mita jimo kandapala kwakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.9",
            "verseOrgIds": [
              "EZK.40.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 40:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkati mwa cipata cakungopoko lyuŵa mwaliji mwana yipinda yitatu ya acilonda mbali jilijose. Yipinda yitatu yosopeyo yaliji yakulandana ukulu wakwe soni yipilala yambali syosope yaliji yakulandana.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.10",
            "verseOrgIds": [
              "EZK.40.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 40:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.10",
            "verseOrgIds": [
              "EZK.40.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 40:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaneko ŵapimile wipi wakwe wa mpata wa cipata cakwinjilila. Caliji mamita msano mcijipi mwakwe soni mcilewu mwakwe mwaliji mamita 6 ni hafu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.11",
            "verseOrgIds": [
              "EZK.40.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 40:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumeso kwa yipinda ya acilonda yila kwapali kapupa ka mita jimo mcilewu ni mcijipi mwakwe. Yipindayo yaliji ya mamita gatatu mbali syosope. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.12",
            "verseOrgIds": [
              "EZK.40.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 40:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sambano ŵapimile ulewu wakwe kutyocela kwipupa lyakunyuma lya cipinda cimo mpaka kwipupa lya cipinda cine, kutyocela ku litanga mpaka kuja kuyika ku litanga line. Ulewu wakwe waliji mamita 12 ni hafu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.13",
            "verseOrgIds": [
              "EZK.40.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 40:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaneko ŵapimile lipenu lyamkati, lyaliji mamita likumi. Soni pakusyungulila lipenulyo paliji pana luŵala. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.14",
            "verseOrgIds": [
              "EZK.40.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 40:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutyocela kumeso kwa cipata mpaka pakwinjilila pa luŵala lwa mkati, ulewu wakwe waliji mamita 25. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.15",
            "verseOrgIds": [
              "EZK.40.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 40:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mapupa gakusa ga yipindayo gakwete mawindo soni mapupa gamkati ga yipindayo gakwete nombe nago mawindo. Mapupa gosope ŵasepile yitusitusi ya kanjesa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.16",
            "verseOrgIds": [
              "EZK.40.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Luŵala lwa kusa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 40:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.16",
            "verseOrgIds": [
              "EZK.40.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 40:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sambano mundu jula ŵanjigalile ku luŵala lwakusa. Yipinda 30 ŵayitaŵile kutyocela kwipupa lya kusa, soni kusogolo kwakwe kwaliji kwana malo wa maganga, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.17",
            "verseOrgIds": [
              "EZK.40.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 40:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "malogo gasyungulile luŵala. Luŵala lwakusalu lwaliji lwapasi ngaŵa lwakunyang'amala mpela luŵala lwa mkati.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.18",
            "verseOrgIds": [
              "EZK.40.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 40:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.18",
            "verseOrgIds": [
              "EZK.40.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 40:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sambano ŵapimile mkati mwa luŵala kutyocela ku cipata mwiŵanda mpaka ku cipata cakusa ca luŵala lwamkati. Ulewu wakwe waliji mamita makumi msano.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.19",
            "verseOrgIds": [
              "EZK.40.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Cipata ca kumpoto",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 40:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.19",
            "verseOrgIds": [
              "EZK.40.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 40:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaneko mundu jula ŵapimile cipata cakumpoto cakwawulila ku luŵala lwakusa. Ŵapimile mcilewu ni mcijipi mwakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.20",
            "verseOrgIds": [
              "EZK.40.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
