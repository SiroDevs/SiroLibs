            "number": "30",
            "style": "v",
            "sid": "EZK 40:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myoyo gapali maluŵala gagasyungulile posope. Luŵala lulilose lwaliji mamita 25 mcilewu mwakwe, soni mamita 12 ni hafu mcijipi mwakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.30",
            "verseOrgIds": [
              "EZK.40.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
