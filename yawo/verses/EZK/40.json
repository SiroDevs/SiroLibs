            "sid": "EZK 40:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myipinda ya cipata celeci cakwete mawindo mpela gayine yila. Mcilewu mwakwe mwaliji mamita 25, soni mcijipi mwakwe mwaliji mamita 12 ni hafu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.25",
            "verseOrgIds": [
