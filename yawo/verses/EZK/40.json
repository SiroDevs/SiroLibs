              "type": "text"
            }
          ]
        },
        {
          "text": "Sambano mundu jula ŵasalile kuti cipinda cicalolite kumwelaci ni ca ŵakutaga mbopesi ŵakulolela Nyumba ja AMBUJE, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.45",
