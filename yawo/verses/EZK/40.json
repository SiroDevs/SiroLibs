              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaneko mundu jula ŵanjigalile kum'mwela, soni kweleko twaciweni cipata cicalolite kum'mwela. Ŵapimile yipilala yakwe ni luŵala lwamkati mwakwe, yosope yaliji yakulandana ni yijakwe yila. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.24",
            "verseOrgIds": [
              "EZK.40.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
