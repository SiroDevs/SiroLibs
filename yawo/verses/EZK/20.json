                {
                  "text": "Lef 26:33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.20.23",
            "verseOrgIds": [
              "EZK.20.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 20:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "ligongo nganapikanila malamusi gangu, ni kana yinasalilaga, ŵasakesye masiku gangu gakupumula Ayuda, soni ŵajilambilaga milungu jine jijojo jiŵajilambilaga acinangolo ŵawo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.20.24",
            "verseOrgIds": [
              "EZK.20.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 20:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.20.24",
            "verseOrgIds": [
              "EZK.20.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 20:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kaneko napele malamusi gele nganigaŵa gambone kwa jemanjajo ni kwasalila yindu yanganiyapaga umi wambone. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.20.25",
            "verseOrgIds": [
              "EZK.20.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 20:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nalesile mele kuti alisakasye acimsyene ni mituka jawo, pakwapeleka ŵanace ŵandanda kupagwa mpela mbopesi syakutinisya, kuti najogoye jemanjajo. Natesile myoyo kuti amanyilile kuti Une ndili AMBUJE.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.20.26",
            "verseOrgIds": [
              "EZK.20.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 20:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.20.26",
            "verseOrgIds": [
              "EZK.20.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 20:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Sambano m'mwe mwanace jwa mundu, mŵecetane nawo Aisalaeli ni mwasalile kuti Une AMBUJE Mlungu nguti; Acinangolo ŵenu ŵanyosisye pakuleka kungulupilila. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.20.27",
            "verseOrgIds": [
              "EZK.20.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EZK 20:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndaŵi jinajigalile mcilambo cinalumbilile kuti tinjapa. Kulikose kuŵaliwonaga litumbi lyelewu ni citela cakutenjela, kweleko ŵapelekaga mbopesi syawo sisyandumbilikasyaga. Kweleko ŵapelekaga mbopesi sya liwungo lyambone soni ni mbopesi sya yakumwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.20.28",
            "verseOrgIds": [
              "EZK.20.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EZK 20:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawusisye kuti, Ana kwitumbi lyelewu kumwajawulagako kwamtuli? Myoyo lina lyakwe liŵele ‘Malo Gamalewu’ mpaka lelo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.20.29",
            "verseOrgIds": [
              "EZK.20.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EZK 20:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sambano mwasalile Aisalaeli kuti Une AMBUJE Mlungu nguti; Ana timlisakasyeje mpela mwele muŵatendelaga acinangolo ŵenu ni kusokonecelaga pakujikuyaga milungu jawo jakunyalaya? ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.20.30",
            "verseOrgIds": [
              "EZK.20.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EZK 20:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndaŵi jimkupeleka mituka jenu ni ŵanace ŵenu mpela mbopesi syakutinisya, mkusalisakasya mwacimsyene ni milungu jinejo mpaka lelo jino. Ana Aisalaeli jemanja, mpaka namkunde uli kuti namjamuce Une? Pakuti Une ndili Mlungu jwa umi, ngasingunda yeleyi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.20.31",
            "verseOrgIds": [
              "EZK.20.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EZK 20:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jemanja mkusaka kuŵa mpela ŵandu ŵa mitundu jine, soni mpela ŵandu ŵa yilambo yine ŵele ŵakusayilambila yitela ni maganga. Nambo yeleyo ngasiyitendecekwa kose.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.20.32",
            "verseOrgIds": [
              "EZK.20.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mlungu akusapeleka cilango ni kululucila",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EZK 20:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.20.32",
            "verseOrgIds": [
              "EZK.20.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EZK 20:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kusyene Une ndili AMBUJE Mlungu jwa umi, tinjimlamulila ni mkono wangu wamacili, ndiliniwutambasukwile ni lutumbilo lwekulungwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.20.33",
            "verseOrgIds": [
              "EZK.20.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EZK 20:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tinjimlosya macili gangu ni lutumbilo lwangu pakumsonganya pampepe ni kumwusya kutyocela ku yilambo yimwapwilinganile. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.20.34",
            "verseOrgIds": [
              "EZK.20.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EZK 20:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tinjimjinjisya mcipululu ca ŵandu, kweleko tinjimjimba magambo tuli mkulolegana pameso ni pameso. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.20.35",
            "verseOrgIds": [
              "EZK.20.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "EZK 20:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tinjimpa cilango mpela munapelecele cilango kwa acinangolo ŵenu mcipululu ca ku Iguputo. Ni yinguti Une AMBUJE Mlungu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.20.36",
            "verseOrgIds": [
              "EZK.20.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "EZK 20:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.20.36",
            "verseOrgIds": [
              "EZK.20.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "EZK 20:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Tinjimlamulila jemanja ni kumtenda kuti mcipikanileje cilanga cangu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.20.37",
            "verseOrgIds": [
              "EZK.20.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "EZK 20:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tinjatyosya ŵandu ŵakwimucila ni wa ulemwa",
          "type": "text",
          "attrs": {
            "verseId": "EZK.20.38",
            "verseOrgIds": [
              "EZK.20.38"
            ]
          }
        },
        {
          "text": " sikati jenu. Tinjatyosya mcilambo cakutamaco, nambo ngasajinjila mcilambo ca Aisalaeli. Pelepo timcimanyilila kuti Une ndili AMBUJE.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.20.38",
            "verseOrgIds": [
              "EZK.20.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "EZK 20:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.20.38",
            "verseOrgIds": [
              "EZK.20.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "EZK 20:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nambo jemanja Aisalaeli, yinguti Une AMBUJE Mlungu nayi: Jawulagani jemanja wosope ni mkajitumicileje milungu jenu jinejo! Nambo nguti panyuma pakwe timumbikanileje une, soni ngasimsakasya lina lyangu lyeswela pakuja kupeleka mituka kwa milungu jenu jine. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.20.39",
            "verseOrgIds": [
              "EZK.20.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "EZK 20:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aisalaeli wosope tacindumicilaga une mcilambo cawoco kwitumbi lyangu lyelewu, litumbi lyeswela lya ku Isalaeli. Kweleko tinjapocela mwakusangalala soni tinjipocela mituka jawo ni mbopesi syawo syeswela. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.20.40",
            "verseOrgIds": [
              "EZK.20.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "EZK 20:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tinjimpocela jemanja mpela mbopesi jakununjila, katema katinjimjigala kutyocela kwa ŵandu, ni kumsonganya pampepe kutyocela ku yilambo yele yimwapwilinganile, ni tinjililosya kuti Une ndili Jwamswela pasikati pa jemanja, ŵandu ŵa mitundu jine ali mkulola. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.20.41",
            "verseOrgIds": [
              "EZK.20.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "EZK 20:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pelepo timcimanyilila kuti Une ndili AMBUJE, katema katinjimwucisya mcilambo ca Isalaeli, cilambo cele cinalumbilile kuti tinjapa acinangolo ŵenu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.20.42",
            "verseOrgIds": [
              "EZK.20.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "EZK 20:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kweleko timcikumbucila ndamo syenu syakusakala ni yakunyalaya yenu yosope yimwalisakacisye nayo. Soni timcisakalilwa nayo mwacimsyene ligongo lya yindu yakusakala yimwayitesile. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.20.43",
            "verseOrgIds": [
              "EZK.20.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "EZK 20:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jemanja Aisalaeli timcimanyilila kuti Une ndili AMBUJE, katema katinjimtendelaga yambone ligongo lya lina lyangu, ngakumbucila ndamo syenu syakusakala ni masengo gangalumbana.” Ni yakuti AMBUJE Mlungu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.20.44",
            "verseOrgIds": [
              "EZK.20.44"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Moto kum'mwela",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "EZK 20:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.20.44",
            "verseOrgIds": [
              "EZK.20.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "EZK 20:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "AMBUJE ŵaŵecete ni une. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.20.45",
            "verseOrgIds": [
              "EZK.20.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "EZK 20:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "“M'mwe mwanace jwa mundu, mlole kum'mwela. Mlalicile mwakwajamuka ŵandu ŵakumwela soni mcijimbe magambo cilambo ca ukweti wa Negebu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.20.46",
            "verseOrgIds": [
              "EZK.20.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "EZK 20:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwusalile ukweti wa mbali ja kum'mwela yakuti AMBUJE Mlungu; Tinjikolesya moto, soni motowo tiwucijoca yitela yenu yosope yejumu ni yayiŵisi yakwe. Malamba gakwe tigaciŵa gangasimisika, nipo jwalijose kutyocela kum'mwela mpaka kumpoto tacipya nawo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.20.47",
            "verseOrgIds": [
              "EZK.20.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "EZK 20:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵandu wosope tacilola kuti Une AMBUJE ni junakolesisye motowo soni ngaŵa mkuwusimisya.”",
          "type": "text",
