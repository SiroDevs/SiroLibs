              },
              "items": [
                {
                  "text": "Ciw 16:15",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2PE 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.3.10",
            "verseOrgIds": [
              "2PE.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2PE 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosope yene tiyicijonasika mwa litala lyeleli, ana jemanja timciŵa ŵandu ŵamtuli? Ma umi genu gaŵeje geswela ni kulipeleka kwa Mlungu. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.3.11",
            "verseOrgIds": [
              "2PE.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2PE 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mjembeceleje lisiku lyele Mlungu litacajamuka ŵandu wosope, myoyo mlinjilileje kuti lisikuli liyice sampano. Lyele lisikulyo kwinani tikucipya ni konanjidwa, soni yindu yosope tiyicinyelenyenducila m'motomo. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.3.12",
            "verseOrgIds": [
              "2PE.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2PE 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo pakukuya cilanga ca Mlungu, tukwembecela kwinani kwa sambano ni cilambo capasi casambano, mwele timuciŵa m'mangwakwe mwa cilungamo.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.3.13",
            "verseOrgIds": [
              "2PE.3.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.65.17"
              },
              "items": [
                {
                  "text": "Yes 65:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.66.22"
              },
              "items": [
                {
                  "text": "66:22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.21.1"
              },
              "items": [
                {
                  "text": "Ciw 21:1",
                  "type": "text"
                }
              ]
            }
          ]
        }
