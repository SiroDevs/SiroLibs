    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Satana akumlinga soni Yobu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lisiku line malayika pigayikaga kukulilosya pameso pa AMBUJE,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.2.1",
            "verseOrgIds": [
              "JOB.2.1"
            ]
          }
        },
        {
          "text": " nombe najo Satana",
          "type": "text",
          "attrs": {
            "verseId": "JOB.2.1",
            "verseOrgIds": [
              "JOB.2.1"
            ]
          }
        },
        {
          "text": " jwaliji sikati ja jemanjajo. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.2.1",
            "verseOrgIds": [
              "JOB.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "AMBUJE ŵamwusisye Satanajo kuti, “Ana mkutyocela kwapi?” Satana ŵajanjile kuti, “Mbele ndili mkwendajenda mcilambomu.”",
          "type": "text",
          "attrs": {
            "verseId": "JOB.2.2",
            "verseOrgIds": [
              "JOB.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.2.2",
            "verseOrgIds": [
              "JOB.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaneko AMBUJE ŵamwusisye Satana kuti, “Ana kum'manyilila jwakutumicila jwangu lina lyakwe Yobu? Pa cilambo capasi pangali soni mundu jwine jwakulandana ni jwalakwejo pakuti jwalakwejo jwangali ulemwa soni ali jwakulungama. Akusanjimbicisya une soni jwangatenda yindu yakusakala. Atamose kuti m'mwejo mwanganganice une kuti nimkunde mumlagasye Yobu pali pangali ligongo, jwalakwejo akukulupicikape.”",
          "type": "text",
          "attrs": {
            "verseId": "JOB.2.3",
            "verseOrgIds": [
              "JOB.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.2.3",
            "verseOrgIds": [
              "JOB.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Satana ŵajanjile kuti, “Mundu akukomboleka kupeleka yosope yakwete kuti jwalakwejo aŵe cijumi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.2.4",
            "verseOrgIds": [
              "JOB.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo ŵalakwe naga akonanga cilu cakwe, jwalakwejo tacatukana wawojo pameso.”",
          "type": "text",
          "attrs": {
            "verseId": "JOB.2.5",
            "verseOrgIds": [
              "JOB.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.2.5",
            "verseOrgIds": [
              "JOB.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "AMBUJE ŵamsalile Satana kuti, “Cambone, mtende najo jwalakwejo cilicose cimkusaka, nambo mkasimumwulaga.”",
          "type": "text",
          "attrs": {
            "verseId": "JOB.2.6",
            "verseOrgIds": [
              "JOB.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.2.6",
            "verseOrgIds": [
              "JOB.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaneko Satana ŵatyosile pameso pa AMBUJE, nipo ŵajile kukumlagasya Yobu pakumpa jwalakwejo yilonda yakogoya pa cilu cosope. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.2.7",
            "verseOrgIds": [
              "JOB.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yobu ŵajile kutama ku citutu nipo ŵajigele kalupale kuti alimwajileje pa cilu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.2.8",
            "verseOrgIds": [
              "JOB.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myoyo, ŵamkwakwe Yobu ŵawusisye kuti, “Ŵamkwangu, ana ciŵela kutama mwakulupicikape mwamti myiyi? Nambi uli ngagamba kumtukana Mlungu, ni m'we?”",
          "type": "text",
          "attrs": {
            "verseId": "JOB.2.9",
            "verseOrgIds": [
              "JOB.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.2.9",
            "verseOrgIds": [
              "JOB.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yobu ŵajanjile kuti, “Yimkuŵecetayo yangali mate! Mlungu akusatutumicisya uwe yindu yambone nipo uwe tukusayipocela, nambi tiyilepelece uli kuyipocela yipwetesi?” Mu ndaŵi josope ja yipwetesi, Yobu nganamlemwecesya Mlungu mu uŵecete wakwe.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.2.10",
            "verseOrgIds": [
              "JOB.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Acimjakwe ŵa Yobu akwika kukunguluka",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.2.10",
            "verseOrgIds": [
              "JOB.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Acimjakwe ŵatatu ŵa Yobu ŵaliji Elifasi, jwa ku Temani, Bilidadi, jwa ku Shuwa ni Sofali jwa ku Naama. Jemanjaji piŵapikene muŵalajilaga Yobu, ŵaganisisye kuti akwenela kwawula kuti akamtulasye mjawojo. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.2.11",
            "verseOrgIds": [
              "JOB.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Piŵaliji ciŵandika kwika ku nyumba ja Yobu, ŵam'weni jwalakwejo nambo jemanjajo nganam'manyililaga jwalakwejo, kaneko acimjakwewo ŵatandite kulila mwakugumila nipo ŵapapwile yakuwala yawo, kaneko ŵatasile luwundu m'mitwe mwawo. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.2.12",
            "verseOrgIds": [
              "JOB.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jemanjajo ŵatemi ni Yobu kwa masiku msano ni gaŵili cilo ni musi wakwe, nambo pangali juŵaŵecete ni Yobu liloŵe lililyose pa jele ndaŵiji ligongo lyakuti jemanjajo ŵaliji mkumanyilila kuti Yobu ali pa yipwetesi yekulungwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.2.13",
            "verseOrgIds": [
              "JOB.2.13"
            ]
          }
        }
      ]
    }
