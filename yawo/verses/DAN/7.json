                "loc": "REV.13.7"
              },
              "items": [
                {
                  "text": "Ciw 13:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.21",
            "verseOrgIds": [
              "DAN.7.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DAN 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "mpaka pa ndaŵi jele, jwine juŵapali citamile jula jwayice. Sambano kulamula kwajendele cenene ŵaswela mtima ŵa Mlungu Jwakupunda yosope. Pelepo ndaŵi jakwanile kuti ŵaswela mtimawo apocele macili ga ku ucimwene.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.22",
            "verseOrgIds": [
              "DAN.7.22"
            ]
          }
        },
        {
          "name": "note",
