        },
        {
          "text": "Ŵapegwile ulamusi, lumbili ni ucimwene, kuti ŵandu ŵa mitundu josope, ngosyo syosope ni ŵa yiŵeceto yakulekanganalekangana amtumicileje jwalakwejo. Ulamusi wakwe uli wa mpaka kalakala, ucimwene wakwe ngisiwumala soni ngasiwujonasika.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.14",
            "verseOrgIds": [
              "DAN.7.14"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
