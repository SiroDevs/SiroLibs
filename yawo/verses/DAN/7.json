            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.12",
            "verseOrgIds": [
              "DAN.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DAN 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pinalijipe mkulola yindu cilo kupitila m'mesomkulola, nam'weni jwine jwakulandana ni mundu. Ali mkutuluka m'mawunde ga kwinani. Jwalakwejo pijwaŵandicile, Jwamkulungwa juŵaliji jwa citamile mpaka kalakala jula, ŵandu ŵane ŵampelece jwalakwejo kwa Jwamkulungwajo.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.13",
            "verseOrgIds": [
              "DAN.7.13"
            ]
          }
        },
        {
