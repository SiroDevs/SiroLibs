              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.22",
            "verseOrgIds": [
              "DAN.7.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DAN 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sambano ŵanjanjile kuti: “Cilombo camcececo cikulosya ucimwene wamcece wele wawuciwoneka pa cilambo capasi nipo tiwuciŵa wakulekangana ni ma ucimwene gane. Tiwucipunda cilambo cosope capasi ni kucipondelesya ni kucipwanya. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.23",
            "verseOrgIds": [
              "DAN.7.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DAN 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Misengo mcece jine jikulosya ma ucimwene likumi gele tigacikopoka mu ucimwene welewu. Panyuma pakwe tipaciyika mwenye jwine jwakulekangana ni ayimwene wosope ŵakala. Jwalakwejo tacapunda ayimwene ŵatatu.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.24",
            "verseOrgIds": [
              "DAN.7.24"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.17.12"
              },
              "items": [
                {
                  "text": "Ciw 17:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.24",
            "verseOrgIds": [
              "DAN.7.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DAN 7:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Taciŵeceta yakusisyana ni Mlungu Jwamaciligosope, nipo tacalagasya ŵakumlambila Mlungujo. Tacilinjilila kucenga masiku ga yindimba ni malamusi ga dini. Ŵaswela mtima ŵala tacilamulidwa ni mwenye jweleju pa ndaŵi jakwana yaka yitatu ni hafu.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.25",
            "verseOrgIds": [
              "DAN.7.25"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.12.14"
              },
              "items": [
                {
                  "text": "Ciw 12:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.13.5+REV.13.6"
              },
              "items": [
                {
                  "text": "13:5-6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.25",
            "verseOrgIds": [
              "DAN.7.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DAN 7:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa nganya ja magambo tacilamulidwa, nipo tacimsumula ucimwene wakwe kuti pambesi pakwe ujonasice ni kuwumasya kusyesyene. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.26",
            "verseOrgIds": [
              "DAN.7.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DAN 7:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ucimwene, ulamusi, ni ukulungwa wa ayimwene wosope pasi pano tiyicipelecedwa ku mpingo wa ŵaswela mtima ŵa Mlungu Jwakupunda yosope. Ucimwene wawo tiwuciŵa wa mpaka kalakala, wakulamulila wosope ŵa pa cilambo capasi tacatumicilaga ni kwapikanila jemanjajo.”",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.27",
            "verseOrgIds": [
              "DAN.7.27"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
