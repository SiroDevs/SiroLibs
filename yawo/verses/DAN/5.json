          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Maloŵe gagalembedwego ni aga: ‘ciŵalanjilo, ciŵalanjilo, usito, makuga.’ ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.25",
