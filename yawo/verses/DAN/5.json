          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": ", wawo alinjidwe pa sikelo, nipo asimanikwe kuti ali ŵakupelembela ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.27",
            "verseOrgIds": [
              "DAN.5.27"
            ]
          }
        },
