              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": ", ucimwene wawo ugaŵidwe, nipo upelecedwe kwa Amedi ni Apelesi.”",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.28",
            "verseOrgIds": [
