              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cilo cicoco, Belishesala mwenye jwa ku Babiloniya ŵawulajidwe. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.30",
            "verseOrgIds": [
