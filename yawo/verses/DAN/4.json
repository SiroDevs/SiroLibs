          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.27",
            "verseOrgIds": [
              "DAN.4.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DAN 4:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosopeyi yatendecekwele Mwenye Nebukadinesa. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.28",
            "verseOrgIds": [
              "DAN.4.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DAN 4:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakumala pa miesi likumi ni jiŵili, jwalakwe jwajendaga pa msakasa wa nyumba ja ucimwene ja ku Babiloni. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.29",
            "verseOrgIds": [
              "DAN.4.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "DAN 4:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nipo ŵaŵecetaga kuti, “Mlole ukulu wa msinda wa Babiloniwu! Nawutaŵile kuti uwe msinda wekulungwa wakulosya macili gangu ni ucimbicimbi wa ucimwene wangu.”",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.30",
            "verseOrgIds": [
              "DAN.4.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "DAN 4:30"
          },
          "items": [
            {
