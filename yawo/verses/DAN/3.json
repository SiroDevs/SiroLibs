            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DAN 3:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenyewo ŵatite kuti, “Nambope ngwawona ŵandu mcece alimkwenda m'moto mwa mtendele, ngapya. Nipo mundu jwamcecejo akuwoneka mpela mwanace jwa milungu.”",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.25",
            "verseOrgIds": [
              "DAN.3.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ŵandu ŵatatu ŵala akwagopola ni kwakwesya pa ma ukumu gawo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DAN 3:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.25",
            "verseOrgIds": [
              "DAN.3.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DAN 3:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaneko Nebukadinesa ŵasejele kumlango wa ng'aso jamoto jila, ni ŵaŵilasile kuti, “Shadileki, Misheki ni Abedenego, ŵakutumicila ŵa Mlungu Jwakupunda yosope, kopokani myice akuno.” Papopo Shadileki, Misheki ni Abedenego ŵakopwece m'motomo. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.26",
            "verseOrgIds": [
              "DAN.3.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DAN 3:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nipo ŵakulamulila ŵala, acibwanamkubwa ni apungu ŵa mwenye ŵasongene mwakwasyungulila acacanda ŵatatu ŵala, nipo ŵaweni kuti nganapya ni motowo. Umbo syawo nganisikwinyata, yakuwala yawo nganiyipya nipo ngananungaga lyosi amta panandi.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.27",
            "verseOrgIds": [
              "DAN.3.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DAN 3:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.27",
            "verseOrgIds": [
              "DAN.3.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DAN 3:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pelepo Nebukadinesa ŵatite kuti, “Acimbicikwe Mlungu jwa Shadileki, Misheki ni Abedenego. Atumisye lilayika lyakwe kukwakulupusya ŵakutumicila ŵakusamkulupilila, ni kukana kupikanila lilamusi lya mwenye. Jemanjajo ŵalipelece ku ng'aso jamoto ligongo lyangasosa kutumicila ni kulambila mlungu jwine jwalijose, akaŵe Mlungu jwawope.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.28",
            "verseOrgIds": [
              "DAN.3.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DAN 3:28"
          },
          "items": [
            {
