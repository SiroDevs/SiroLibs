              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.28",
            "verseOrgIds": [
              "DAN.3.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DAN 3:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Sambano ngutamilisya lilamusi ali: Mundu jwine jwalijose, jwa ngosyo kapena ciŵeceto cine cilicose, naga akunyosya Mlungu jwa Shadileki, Misheki ni Abedenego, tinjimpaculapacula nipo nyumba jakwe tinjijitenda kuŵa masame. Pangalitu mlungu jwine jwalijose jwampaka akulupusye ŵandu mwa litala lyamti myiyi.”",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.29",
            "verseOrgIds": [
              "DAN.3.29"
            ]
          }
        }
      ]
    },
