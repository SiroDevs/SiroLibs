                {
                  "text": "Eks 23:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.34.22"
              },
              "items": [
                {
                  "text": "34:22",
