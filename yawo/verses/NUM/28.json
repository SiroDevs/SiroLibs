        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.26",
            "verseOrgIds": [
              "NUM.28.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 28:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apelece mbopesi jakutinisya kuti jiŵe mpela ja liwungo lyakwanonyela AMBUJE: ng'ombe siŵili sya mkambako, ngondolo ja mkambako jimo, ni ŵanace ŵangondolo ŵacaka cimo ŵa mikambako ŵakwana msano ni ŵaŵili, wosope aŵe ŵangali yilema. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.27",
            "verseOrgIds": [
              "NUM.28.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 28:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apelece mbopesi ja utandi wewanganye ni mawuta ga olifi: wakwana makilogalamu gatatu pa ng'ombe jilijose, makilogalamu gaŵili pa ngondolojo, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.28",
            "verseOrgIds": [
              "NUM.28.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 28:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "ni kilogalamu jimo pa mwanace jwangondolo jwalijose. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.29",
            "verseOrgIds": [
              "NUM.28.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 28:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apelece soni mbopesi ja mbusi jimo ja tonde jakupesya ulemwa. Myoyo atende msyungu wakwaswejesya ŵandu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.30",
            "verseOrgIds": [
              "NUM.28.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NUM 28:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apelece yeleyi pamo ni mbopesi ja finyo pakonjecesya ku mbopesi jakutinisya ja yakulya ja lisiku ni lisiku.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.31",
            "verseOrgIds": [
              "NUM.28.31"
            ]
          }
        }
