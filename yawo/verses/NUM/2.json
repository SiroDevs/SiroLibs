          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NUM 2:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpela muŵamlamulile AMBUJE Mose, Alefi nganalembesya piŵalembesyaga Aisalaeli ŵane wosope.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.33",
            "verseOrgIds": [
              "NUM.2.33"
            ]
          }
        }
