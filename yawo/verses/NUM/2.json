        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NUM 2:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myoyo ŵandu ŵa Aisalaeli ŵatesile yosope yene yiŵalamwile AMBUJE kwa Mose. Ŵataŵile masakasa, jwalijose pijaliji mbendela jakwe, nipo ŵajendaga, jwalijose ni liŵasa lyakwe.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.34",
