          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ciŵalanjilo cosope ca Aisalaeli ŵiŵalembesye m'makuga mwawo, likuga ni likuga, caliji 603,550. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.32",
            "verseOrgIds": [
              "NUM.2.32"
            ]
          }
        },
