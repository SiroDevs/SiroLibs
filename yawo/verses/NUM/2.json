          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbali ja kum'mwela, tikuŵeje mbendela ja likuga lya Lubeni, taciŵa m'masakasa m'makuga pasi pa acimlongola ŵawo mwakuyicisyamu:",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.10+NUM.2.11+NUM.2.12+NUM.2.13+NUM.2.14+NUM.2.15+NUM.2.16",
