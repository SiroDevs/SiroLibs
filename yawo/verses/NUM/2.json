          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumpoto, ŵitijicalongolela mbendela ja likuga lya Dani tacitaŵa masakasa m'makuga mwawo, pakujikuya mbendela jawo mpela mwakuyicisyamu:",
          "type": "text",
