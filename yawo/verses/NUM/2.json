          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumbali ja kungopoko lyuŵa, aŵe ŵa mbendela ja likuga lya lukosyo lwa Yuda, nipo taciŵa m'masakasa gawo m'makuga, pasi pa acimlongola ŵawo mpela mwakuyicisyamu:",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.3+NUM.2.4+NUM.2.5+NUM.2.6+NUM.2.7+NUM.2.8+NUM.2.9",
            "verseOrgIds": [
