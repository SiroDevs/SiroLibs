          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kungapilo lyuŵa, ŵajikwalongolela mbendela ja likuga lya Efelemu tacitaŵa m'masakasa m'makuga mwawo, pakujikuya mbendela jawo pasi pa acimlongola ŵawo mpela mwakuyicisyamu:",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.18+NUM.2.19+NUM.2.20+NUM.2.21+NUM.2.22+NUM.2.23+NUM.2.24",
