              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.21",
            "verseOrgIds": [
              "NUM.20.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 20:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaneko mpingo wosope wa Aisalaeli watyosile ku Kadeshi nipo ŵayice ku Litumbi lya Holi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.22",
            "verseOrgIds": [
              "NUM.20.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 20:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Litumbilyo lyaliji malile ga cilambo ca Edomu, nipo AMBUJE ŵaŵecete kwa Mose ni Aloni kuti, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.23",
            "verseOrgIds": [
              "NUM.20.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 20:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Aloni ngaja kwinjila ku cilambo cinatesile cilanga kuti tinjipeleka kwa Aisalaeli, tawe, ligongo jemanja wosope ŵaŵili nganimpikanila lilamusi lyangu ku Meliba. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.24",
            "verseOrgIds": [
              "NUM.20.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 20:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwajigale Aloni ni mwanace jwawo Eliyesa mkwele nawo ku Litumbi lya Holi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.25",
            "verseOrgIds": [
              "NUM.20.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 20:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kweleko mkawule Aloni mikanjo jawo jakupelecela mbopesi ni mkawece Eliyesa. Aloni takawile kukoko.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.26",
            "verseOrgIds": [
              "NUM.20.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 20:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose ŵatesile yiŵamlamwile AMBUJE. Wosope ŵene ŵatatu ŵakwesile Litumbi lya Holi mpingo wosope uli mkulola. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.27",
            "verseOrgIds": [
              "NUM.20.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 20:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Piŵayice petumbipo Mose ŵamwusile Aloni yakuwala ya mbopesi ni kum'weca Eliyesa. Aloni ŵawilile penani pa litumbi pepo nipo Mose ni Eliyesa ŵatulwice litumbilyo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.28",
            "verseOrgIds": [
              "NUM.20.28"
            ]
          }
        },
        {
