            "sid": "NUM 20:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpingo wosope piŵapikene kuti Aloni ŵajasice, Aisalaeli wosope ŵalisile malilo gakwe kwa masiku 30.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.29",
