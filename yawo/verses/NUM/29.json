          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa lisiku lyaŵili apelece ŵanace ŵa ng'ombe ŵa mikambako 12, ngondolo siŵili sya mikambako, ni ŵanace ŵangondolo ŵa mikambako ŵakwana caka cimo 14, wosopewo aŵe ŵangali maŵasi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.17",
            "verseOrgIds": [
              "NUM.29.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 29:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apelece yosopeyi pamo ni mbopesi sine syosope syakusosekwa sya lisiku lyandanda.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.18+NUM.29.19",
            "verseOrgIds": [
              "NUM.29.18",
              "NUM.29.19"
