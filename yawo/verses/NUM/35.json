          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mundu jwakumjimba magambo gakuwulaga awulajidwe naga pali pana umboni wakwana wa ŵandu ŵaŵili kapena kupunda. Umboni wa mundu jumo nganiwuŵa wakwanila pakusosa kumjimba mundu magambo gakuwulaga.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.30",
            "verseOrgIds": [
              "NUM.35.30"
            ]
          }
        },
        {
