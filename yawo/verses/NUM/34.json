          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gelega ni mena ga ŵandu ŵiŵatumile AMBUJE kuti ŵakamusye Eliyesa ni Yoswa kwagaŵanya Aisalaeli cilambo ca Kenani.",
          "type": "text",
          "attrs": {
