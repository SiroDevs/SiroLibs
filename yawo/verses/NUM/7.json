        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.7.9",
            "verseOrgIds": [
              "NUM.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Acakulungwa ŵakulongolelawo nombe nawo ŵayice nasyo mbopesi syawo kukutenda msyungu wakukumbucila kugaŵika pajika malo gakupelecela mbopesi. Ndaŵi jiŵaliji ali cile kuti apelece mituka jawo pa malo gakupelecela mbopesipo, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.7.10",
            "verseOrgIds": [
              "NUM.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "AMBUJE ŵatite kwa Mose, “Mwasalile jemanjajo kuti, kwa ndaŵi jakwanila masiku 12 ŵakulongolelawo apeleceje mituka jawo lisiku lililyose jakusagulika pa malo gakupelecela mbopesi.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.7.11",
            "verseOrgIds": [
              "NUM.7.11"
            ]
          }
        }
      ]
    },
