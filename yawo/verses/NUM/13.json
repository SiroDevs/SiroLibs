            }
          ]
        },
        {
          "text": "AMBUJE",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.1",
            "verseOrgIds": [
              "NUM.13.1"
            ]
          }
        },
        {
          "text": " ŵatite kwa Mose",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.1",
            "verseOrgIds": [
              "NUM.13.1"
            ]
          }
        },
        {
          "text": " kuti, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.1",
            "verseOrgIds": [
              "NUM.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Msagule jumo mwa ŵakulongolelaŵa jwalijose kutyocela ku mitundu 12 ni mwatumisye mpela ŵakusonda mwa asili kukusonda mwa asili cilambo ca Kenani, cingucipeleka kwa Aisalaeli.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.2",
            "verseOrgIds": [
              "NUM.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose ŵapikanile nipo ŵatumisye acakulungwawo kutyocela ku cipululu ca Palani. Aga ni mena gawo:",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.3+NUM.13.4+NUM.13.5+NUM.13.6+NUM.13.7+NUM.13.8+NUM.13.9+NUM.13.10+NUM.13.11+NUM.13.12+NUM.13.13+NUM.13.14+NUM.13.15",
            "verseOrgIds": [
              "NUM.13.3",
              "NUM.13.4",
              "NUM.13.5",
              "NUM.13.6",
              "NUM.13.7",
              "NUM.13.8",
              "NUM.13.9",
              "NUM.13.10",
              "NUM.13.11",
              "NUM.13.12",
              "NUM.13.13",
              "NUM.13.14",
              "NUM.13.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
