          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jemanjajo masengo gawo tigaciŵa gakunyakula mafelemu, yisyano, sici, yakutaŵila pasi pa Tenti, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.31",
            "verseOrgIds": [
              "NUM.4.31"
            ]
          }
        },
        {
