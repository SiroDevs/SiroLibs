              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "nipo kuti ŵalembe acalume wosope ŵa pasikati pa yaka 30 ni 50 ŵiŵaliji ŵakuŵajilwa kupanganya masengo mu Tenti ja AMBUJE jakusimanilana. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.30",
            "verseOrgIds": [
              "NUM.4.30"
            ]
          }
        },
