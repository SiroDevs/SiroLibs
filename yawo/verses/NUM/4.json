        },
        {
          "text": "AMBUJE ŵamsalile Mose kuti ŵaŵalanje Alefi ŵa liŵele lya Melali mwa maŵele genandi ni maŵasa gakwe, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.29",
            "verseOrgIds": [
              "NUM.4.29"
            ]
