          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "AMBUJE",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.1",
            "verseOrgIds": [
              "NUM.4.1"
            ]
          }
        },
        {
          "text": " ŵamsalile Mose",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.1",
            "verseOrgIds": [
              "NUM.4.1"
            ]
          }
        },
        {
          "text": " kuti, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.1",
            "verseOrgIds": [
              "NUM.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mwaŵalanje ŵandu ŵa liŵele lya Kohati ŵa mu lukosyo lwa Lefi mwakulingana ni maŵasa gawo, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.2",
            "verseOrgIds": [
              "NUM.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ni kwalemba acalume wosope ŵa pasikati pa yaka ya 30 ni 50 ŵiŵaŵajilwe kupanganya masengo mu citenti cakusimanilana. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.3",
            "verseOrgIds": [
              "NUM.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Masengo gawo gakwayana ni yindu yakusagulidwa mnope basi.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.4",
            "verseOrgIds": [
              "NUM.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.4",
            "verseOrgIds": [
              "NUM.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "AMBUJE ŵampele Mose yakuŵajilwa kuyitenda yakuyicisyayi. Pitijicikwana ndaŵi jakusama pa masakasa, Aloni",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.5",
            "verseOrgIds": [
              "NUM.4.5"
            ]
          }
        },
        {
          "text": " ni ŵanace ŵawo tacijinjila mu citenti, ni kutulusya likatani lya pasogolo pa Libokosi lya Cilanga,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.5",
            "verseOrgIds": [
              "NUM.4.5"
            ]
          }
        },
        {
          "text": " ni kuwunicila Libokosilyo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.5",
            "verseOrgIds": [
              "NUM.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Taciŵikapo cakuwunicila ca lipende lyambone, ni kutandika penanipo nguwo ja buluwu, kaneko ni kwinjisya mbiko syakunyakulila.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.6",
            "verseOrgIds": [
              "NUM.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.6",
            "verseOrgIds": [
              "NUM.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jemanjajo tacitandika nguwo ja buluwu pa tebulo jakuŵika mkate wakuwupeleka kwa AMBUJE ni kuŵikapo mbale, tumipika twa ubani",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.7",
            "verseOrgIds": [
              "NUM.4.7"
            ]
          }
        },
        {
          "text": " tumipika twakutupeleka kwa AMBUJE, ni mipika ja finyo jwakupeleka kwa AMBUJE. Pa tebulopo tipaciŵa pana mkate ndaŵi syosope. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.7",
            "verseOrgIds": [
              "NUM.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Taciyiwunicila yosopeyi ni nguwo jecejewu, taciŵikapo cakuwunicila ca lipende lyambone, ni kwinjisya mbiko syakunyakulila.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.8",
            "verseOrgIds": [
              "NUM.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.8",
            "verseOrgIds": [
              "NUM.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jemanjajo tacijigala nguwo ja buluwu ni kuwunicila cakuŵikapo nyali, ni nyali syakwe, yakuŵanila yakwe, mbale sya liwu ni mwakutaga mawuta ga olifi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.9",
            "verseOrgIds": [
              "NUM.4.9"
            ]
          }
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.9",
            "verseOrgIds": [
              "NUM.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Taciciŵijilila ni kuciŵika pamo ni yida yakwe yosope mu msaku wa lipende lyambone ni kuyiŵika pa cakunyakulila cakwe.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.10",
            "verseOrgIds": [
              "NUM.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.10",
            "verseOrgIds": [
              "NUM.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Panyuma pakwe tacitandika nguwo ja buluwu pa malo ga golidi",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.11",
            "verseOrgIds": [
              "NUM.4.11"
            ]
          }
        },
        {
          "text": " gambopesi, ni kuŵikapo cakuwunicila ca lipende cambone, kaneko tacijinjisya mbiko syakunyakulila. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.11",
            "verseOrgIds": [
              "NUM.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jemanjajo tacijigala yida yosope yakupanganyicisya masengo ku Malo Gamaswela, ali ayiŵijilile mu nguwo ja buluwu, ni kuŵika cakuwunicila ca lipende lyambone ni kuyiŵika pa cakunyakulila cakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.12",
            "verseOrgIds": [
              "NUM.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Catyosye liwu lya pa malo ga mbopesi ni kutandikapo nguwo ja mtundu wa papo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.13",
            "verseOrgIds": [
              "NUM.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Taciŵika pelepo yida yosope yakupanganyicisya masengo ku malo ga mbopesi: mbale sya moto sya ubani, yisyano yakuloŵela nyama, yakokolela liwu ni mabeseni. Kaneko taciŵikapo cakuwunicila ca lipende cambone ni kwinjisya mbiko syakunyakulila. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.14",
            "verseOrgIds": [
              "NUM.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa ndaŵi jakugwisya masakasa, liŵasa lya Kohati tiliciyika kukunyakula yindu yakusagulidwayo, nipo ali amasile Aloni ni ŵanace ŵawo kuyiwunicila pamo ni yida yakwe yosope, liŵasa lya Kohati ngalikuŵajilwa kwikamula yindu yakusagulidwayo, kogopela kuti taciwa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.15",
            "verseOrgIds": [
              "NUM.4.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gelega ni masengo ga liŵasa lya Kohati pakutyosya Tenti.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.15",
            "verseOrgIds": [
              "NUM.4.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.15",
            "verseOrgIds": [
              "NUM.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eliyesa mwanace jwa Aloni ŵambopesi udindo wawo tiwuciŵa ŵakulolela Tenti jesope, mawuta ga nyali, ubani, mbopesi sya yakulya, mawuta gakwapakasya ŵakutaga mbopesi pakwajinjisya jemanjajo masengo gawo, aloleleje malo gakusagulidwa ga AMBUJE ni yosope ya mkatimo, kwisa soni cipinda cakusagulidwa mnope ni yida yakwe yiyaliji mwelemo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.16",
            "verseOrgIds": [
              "NUM.4.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.16",
            "verseOrgIds": [
              "NUM.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "AMBUJE ŵatite kwa Mose ni Aloni, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.17",
            "verseOrgIds": [
              "NUM.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Akasalikunda liŵasa lya Kohati ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.18",
            "verseOrgIds": [
              "NUM.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuti liwulajidwe mtande wakuyiŵandicila ayi yindu yakusagulidwa mnopeyi. Pakusosa kuti yeleyi yikatendeka, Aloni ni ŵanace ŵakwe tacijawula mkati ni kuja kukumgaŵila mundu jwalijose masengo gakwe ni kumsalila yakuti anyakule. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.19",
            "verseOrgIds": [
              "NUM.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo naga ŵandu ŵa liŵasa lya Kohati akwinjila mu Tenti ni kwawona ŵakutaga mbopesi ali mkulinganya yindu yakusagulidwayi kuti ayityosye, taciwa.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.20",
            "verseOrgIds": [
              "NUM.4.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Masengo ga Alefi ŵa mwiŵele lya Geleshoni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
