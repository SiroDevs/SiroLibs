              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gelega ni masengo ga liŵasa lya Melali ga mu tenti: tacigapanganya masengoga pakulongoledwa ni Itamala mwanace jwa Aloni jwakutaga mbopesi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.33",
