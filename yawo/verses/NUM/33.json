    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ulendo wakutyoka ku Iguputo kwawula ku Mowabu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 33:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aga ni mena ga malo giŵataŵaga Aisalaeli masakasa gawo ali atyosile ku Iguputo m'makuga ga mitundu jawo piŵalongolelaga Mose",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.1",
            "verseOrgIds": [
              "NUM.33.1"
            ]
          }
        },
        {
          "text": " ni Aloni.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.1",
            "verseOrgIds": [
              "NUM.33.1"
            ]
          }
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.1",
            "verseOrgIds": [
              "NUM.33.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 33:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "AMBUJE",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.2",
            "verseOrgIds": [
              "NUM.33.2"
            ]
          }
        },
        {
          "text": " ŵamlamwile Mose kuti alembeje lina lya malogo ndaŵi jilijose jiŵataŵaga m'masakasa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.2",
            "verseOrgIds": [
              "NUM.33.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 33:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.2",
            "verseOrgIds": [
              "NUM.33.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 33:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aisalaeli ŵatyosile ku Iguputo pa lisiku lya 15 lya mwesi wandanda wa caka, kundaŵi kwakwe lili lipite lisiku lya Pasaka.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.3",
            "verseOrgIds": [
              "NUM.33.3"
            ]
          }
        },
        {
          "text": " AMBUJE ŵacinjilicisye nipo ŵakopwece mu msinda wa Lamusesi mu Iguputo ali ŵakusangalala Aiguputo wosope ali mkwawona. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.3",
            "verseOrgIds": [
              "NUM.33.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 33:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa jele ndaŵiji Aiguputowo ŵaliji ali mkusika m'malembe malilo ga ŵanace ŵawo ŵandanda kupagwa ŵacalume ŵiŵaliji ali awulajidwe ni AMBUJE. Pakutenda yeleyi, AMBUJE ŵalosisye peswela kuti ŵaliji ŵamacili mnope kujipunda milungu ja mu Iguputo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.4",
            "verseOrgIds": [
              "NUM.33.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 33:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.4",
            "verseOrgIds": [
              "NUM.33.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 33:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aisalaeli ŵatyosile mu msinda wa Lamusesi ni kuja kutaŵa masakasa ku Sukoti. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.5",
            "verseOrgIds": [
              "NUM.33.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 33:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Masakasa gane ali atyosile ku Sukoti ŵajile kugataŵa ku Etamu mumbali mwa cipululu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.6",
            "verseOrgIds": [
              "NUM.33.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 33:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaneko ŵawujile kwawula ku Pihahiloti, kungopoko lyuŵa kwa Baala Sefoni. Ni ŵajile kutaŵa masakasa gawo paciŵandika ni Migidoli. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.7",
            "verseOrgIds": [
              "NUM.33.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 33:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵatyosile ku Pihahiloti ni ŵajombwece pasikati pa Nyasa Jecejewu",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.8",
            "verseOrgIds": [
              "NUM.33.8"
            ]
          }
        },
        {
          "text": " kwinjila mcipululu ca Suli. Ali ajesile masiku gatatu ŵataŵile masakasa gawo ku Mala. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.8",
            "verseOrgIds": [
              "NUM.33.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 33:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutyocela kweleko ŵajawile ku Elimu kuŵataŵile masakasa gawo, ligongo kwaliji kwana nduluko sya mesi 12 ni yitela ya migwalangwa 70.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.9",
            "verseOrgIds": [
              "NUM.33.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 33:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.9",
            "verseOrgIds": [
              "NUM.33.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 33:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵatyosile ku Elimu ni kuja kutaŵa masakasa ciŵandika ni ku Nyasa Jecejewu ku Suwesi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.10",
            "verseOrgIds": [
              "NUM.33.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 33:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵajile kukutaŵa masakasa gawo ku cipululu ca Sini. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.11",
            "verseOrgIds": [
              "NUM.33.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 33:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaneko ŵataŵile ku Dofika, ku Alushi, ku Lefidimu kukwaliji kwangali mesi gakumwa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.12+NUM.33.13+NUM.33.14",
            "verseOrgIds": [
              "NUM.33.12",
              "NUM.33.13",
              "NUM.33.14"
            ]
          }
        }
      ]
    },
    {
