              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "AMBUJE",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.1",
            "verseOrgIds": [
              "NUM.9.1"
            ]
          }
        },
        {
          "text": " ŵaŵecete kwa Mose",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.1",
            "verseOrgIds": [
              "NUM.9.1"
            ]
          }
        },
        {
          "text": " mcipululu ca Sinayi, mwesi wandanda wa caka caŵili Aisalaeli ali akopwece mu Iguputo. Jwalakwe ŵatite kuti,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.1",
            "verseOrgIds": [
              "NUM.9.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.12.1+EXO.12.2+EXO.12.3+EXO.12.4+EXO.12.5+EXO.12.6+EXO.12.7+EXO.12.8+EXO.12.9+EXO.12.10+EXO.12.11+EXO.12.12+EXO.12.13"
              },
              "items": [
                {
                  "text": "Eks 12:1-13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.1",
            "verseOrgIds": [
              "NUM.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Pa lisiku lya 14 lya awuno mwesi uno, kutandilaga pakapila lyuŵa, Aisalaeli akuŵajilwa kutenda cindimba ca Pasaka",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.2+NUM.9.3",
            "verseOrgIds": [
              "NUM.9.2",
              "NUM.9.3"
            ]
          }
        },
        {
          "text": " mpela mwa malamusi ni kukuya yosope yakukalamusya ya cele cindimbaci.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.2+NUM.9.3",
            "verseOrgIds": [
              "NUM.9.2",
              "NUM.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myoyo Mose ŵasalile ŵanduwo kuti atendeje cindimba ca Pasaka, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.4",
            "verseOrgIds": [
              "NUM.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "nipo ligulo lya lisiku lya 14 lya mwesi wandanda jemanjajo ŵatesile myoyo mcipululu ca Sinayi. Ŵandu ŵatesile yosope yene mpela yiŵatite AMBUJE pakumlamula Mose.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.5",
            "verseOrgIds": [
              "NUM.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.5",
            "verseOrgIds": [
              "NUM.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo ŵapali ŵandu ŵane ŵiŵaliji ŵangaswejela mpela mwa msyungu wakwe ligongo ŵaliji ali akwayisye mtembo, nipo nginapakombola kuti atende cindimba ca Pasaka pa lyele lisikulyo. Jemanjajo ŵajawile kwa Mose ni Aloni",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.6",
            "verseOrgIds": [
              "NUM.9.6"
            ]
          }
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.6",
            "verseOrgIds": [
              "NUM.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "ni ŵatite, “Uwe tuli ŵangaswejela ligongo tukwayisye mtembo, nambo ligongo cici akutulekasya kupeleka mbopesi kwa AMBUJE pamo ni Aisalaeli ŵane wosope?”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.7",
            "verseOrgIds": [
              "NUM.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.7",
            "verseOrgIds": [
              "NUM.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose ŵajanjile kuti, “Ajembecele mpaka ndili mbikene yitalamule AMBUJE yakwamba jemanja.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.8",
            "verseOrgIds": [
              "NUM.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.8",
            "verseOrgIds": [
              "NUM.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "AMBUJE ŵamsalile Mose ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.9",
            "verseOrgIds": [
              "NUM.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuti ŵasalile Aisalaeli kuti, “Naga jwalijose mwa jemanjajo kapena yisukulu yawo yili yangaswejela ligongo lyakwaya mtembo kapena ali kwakutalika pa ulendo, nambo soni akusosa kutenda cindimba ca Pasaka, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.10",
            "verseOrgIds": [
              "NUM.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "jemanjajo atende cindimbaco ligulo pa lisiku lya 14 mwesi waŵili wakwewo. Alyeje nyama ni mkate wangali cakusasaŵilisya pamo ni liponda lyakuŵaŵa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.11",
            "verseOrgIds": [
              "NUM.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akasasigasya yakulya yiliyose mpaka kundaŵi kwakwe nipo akakasa liwupa lililyose lya nyamasyo, atendeje Pasakajo pakukuya malamusi gakwe gosope.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.12",
            "verseOrgIds": [
              "NUM.9.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.12.46"
              },
              "items": [
                {
                  "text": "Eks 12:46",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.19.36"
              },
              "items": [
                {
                  "text": "Yoh 19:36",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.12",
            "verseOrgIds": [
              "NUM.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo jwalijose jwali jwamswela mpela mwa msyunguwo nipo nginajenda ulendo soni ngakutenda cindimba ca Pasaka, ngisinamtenda kuti ali jumo mwa ŵandu ŵangu, ligongo nginapeleka mbopesi kwa une pa ndaŵi jakwe jakuŵajilwa. Jwalakwejo tacipocela cilango ligongo lya ulemwa",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.13",
            "verseOrgIds": [
              "NUM.9.13"
            ]
          }
        },
        {
          "text": " wakwe.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.13",
            "verseOrgIds": [
              "NUM.9.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.13",
            "verseOrgIds": [
              "NUM.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Naga mlendo jwakutama pasikati penu akusosa kuti atende nawo cindimba ca Pasaka, akuŵajilwa kutenda mpela mwa malamusi gosope ni yakalamusya yakwe. Kanga acimsyene cilambo kapena acalendo wosope alikuye lilamusilyo.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.14",
            "verseOrgIds": [
              "NUM.9.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ya liwunde lyamoto",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.14",
            "verseOrgIds": [
              "NUM.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa lisiku liŵataŵile tenti jakusimanilana ni AMBUJE, liwunde lyatulwice ni kujiwunicila. Cilo liwundelyo lyawonekaga mpela moto. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.15+NUM.9.16",
            "verseOrgIds": [
              "NUM.9.15",
              "NUM.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naga liwundelyo likwesile, Aisalaeli ŵatyokaga m'masakasa, ni kuja kutaŵa soni pa malo pitilituluce liwundelyo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.17",
            "verseOrgIds": [
              "NUM.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵandu ŵatyosyaga masakasa naga AMBUJE ali alamwile, nipo mwakulamula kwawo ŵataŵaga soni masakasago. Nambo naga liwundelyo lili pacanya pa tentijo, ŵatamaga papopo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.18",
            "verseOrgIds": [
              "NUM.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naga litemi liwundelyo penani pa tentijo kwa ndaŵi jelewu, jemanjajo ŵapikanilaga AMBUJE nipo nginatyokagapo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.19",
            "verseOrgIds": [
              "NUM.9.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndaŵi sine liwundelyo lyatamaga pacanya pa tentijo kwa masiku gapanandi basi, nambo Aisalaeli ŵatamaga pa masakasapo kapena pakukuya lilamusi lya AMBUJE. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.20",
            "verseOrgIds": [
              "NUM.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndaŵi sine liwundelyo lyatamaga kutyocela cilo mpaka kundaŵipe basi, nipo ŵatyokaga ndaŵi jijojo jitilikwele liwundelyo. Pati liwunde likwesile, jemanjajo ŵanyakukaga pa ulendo wawo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.21",
            "verseOrgIds": [
              "NUM.9.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanga galiji masiku gaŵili, mwesi, caka, kapena ndaŵi jakupunda pelepo, nambo naga liwundelyo lyalijipe penani pa tentipo, jemanjajo nginanyakukaga kwawula pa ulendo wawo, nambo naga lili likwesile, ŵanyakukaga ulendo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.22",
            "verseOrgIds": [
              "NUM.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jemanjajo ŵataŵaga masakasa ni kugatyosya mwakupikanila malamusi giŵapelece AMBUJE kupitila mwa Mose.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.23",
            "verseOrgIds": [
              "NUM.9.23"
            ]
          }
        }
      ]
    }
  ],
