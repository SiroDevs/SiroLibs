          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myoyo Petahiya mwanace jwa Meshesabelo, jumo jwa ŵa mwiŵasa lya Sela ŵa lukosyo lwa Yuda ŵajimilile m'malo mwa Aisalaeli wosope ku luŵala lwa mwenye jwa ku Pelesiya.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.24",
            "verseOrgIds": [
              "NEH.11.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ŵandu ŵa m'misi ni m'misinda jine",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
