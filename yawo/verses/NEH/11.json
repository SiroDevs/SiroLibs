          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.21",
            "verseOrgIds": [
              "NEH.11.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NEH 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mlongola jwa Alefi ŵiŵatamaga ku Yelusalemu ŵaliji Usi mwanace jwa Bani. Bani mwanace jwa Hashabiya, angangagwe ŵaliji Mataniya, nipo ambujegwe ŵaliji Mika ŵiŵaliji ŵa mwiŵasa lya Asafu, lilyatumicilaga pa kwimba nyimbo m'Nyumba ja AMBUJE pa ndaŵi ja mapopelo. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.22",
            "verseOrgIds": [
              "NEH.11.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NEH 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenye ŵalamwile kuti makuga gakwimba gaŵejepo kuti gasindaneje lisiku ni lisiku, kuti galongoleleje kwimba pa ndaŵi ja mapopelo.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.23",
            "verseOrgIds": [
              "NEH.11.23"
            ]
          }
        }
      ]
    },
