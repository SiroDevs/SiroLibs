          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aisalaeli wosope pamo ni ŵakutaga mbopesi ni Alefi ŵatamaga m'misi jawo ku misinda ja ku Yuda. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.20",
            "verseOrgIds": [
              "NEH.11.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NEH 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo ŵakutumicila ku Nyumba ja AMBUJE ŵatamaga ku Ofele mbali jine ja msinda wa Yelusalemu nipo Siha ni Gishipa ŵalolelaga jemanjaji.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.21",
            "verseOrgIds": [
              "NEH.11.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
