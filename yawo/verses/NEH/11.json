          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵandu ŵa lukosyo lwa Benjamini ŵatamaga ku misi ja Geba, Mikimashi, Aiya, Beteli ni misi jakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.31",
            "verseOrgIds": [
              "NEH.11.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NEH 11:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anatoti, Nobu, Ananiya, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.32",
            "verseOrgIds": [
              "NEH.11.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
