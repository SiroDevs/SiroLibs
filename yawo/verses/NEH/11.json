          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵandu ŵane ŵa ku Yuda ŵatamaga m'misi jakuyicisyaji ciŵandika ni migunda jawo: Kiliyati Aliba, Diboni, Yekabisili, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.25",
            "verseOrgIds": [
              "NEH.11.25"
            ]
          }
        },
