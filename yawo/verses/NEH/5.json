                "loc": "EXO.22.25"
              },
              "items": [
                {
                  "text": "Eks 22:25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.25.35+LEV.25.36+LEV.25.37"
              },
              "items": [
                {
                  "text": "Lef 25:35-37",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.23.19+DEU.23.20"
              },
              "items": [
                {
                  "text": "Det 23:19-20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.7",
            "verseOrgIds": [
              "NEH.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NEH 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "ni kwasalila kuti, “Tulinjile kwawombola acalongo acimjetu wosope ŵa Ciyuda ŵiŵasumisidwe mpela acikapolo kwa ŵandu ŵa mitundu jine.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.8",
            "verseOrgIds": [
              "NEH.5.8"
            ]
          }
        },
        {
          "text": " Nambo sambano jemanja mkwasumisya acalongo acimjenuŵa kwa uweji kuti twasume soni!” Acimlongola ni acakulungwakulungwawo nganakola cakuŵeceta.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.8",
            "verseOrgIds": [
              "NEH.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NEH 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.8",
            "verseOrgIds": [
              "NEH.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NEH 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaneko napitilisye kuŵeceta kuti, “Yimkutendayi ngaŵa yambone! Tukwenela kumjogopa Mlungu ni kutenda yakulungama, kuti amagongo ŵetu ŵa mitundu jine akalisimana ligongo lyakutunyocesya uweji. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.9",
            "verseOrgIds": [
              "NEH.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NEH 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cine soni cili cakuti, une, acalongo acimjangu ni ŵamasengo ŵangu, tukusitwakongosyaga ŵandu mbiya ni tiligu, myoyo kwende tukasitwakanganika jemanjajo kuti awusye ngongole. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.10",
            "verseOrgIds": [
              "NEH.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NEH 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sambano jino mwawucisye migunda jawo, migunda jawo ya mipeleya, migunda jawo ja yitela yawo ya olifi",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.11",
            "verseOrgIds": [
              "NEH.5.11"
            ]
          }
        },
        {
          "text": " soni nyumba syawo, nipo mwakululucile ngongole sya mbiya, tiligu, finyo, ni ngongole sya mawuta gimwakongwesye!”",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.11",
            "verseOrgIds": [
              "NEH.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NEH 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.11",
            "verseOrgIds": [
              "NEH.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NEH 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Acimlongolawo ŵajanjile kuti, “Tucitenda mpela mwaŵecetelemo. Tuciyiwusya yeleyi soni ngasituŵilasya ngongole.” Myoyo naŵilasile ŵakutaga mbopesi nipo natesile acimlongola ŵala kuti alumbile pameso pa ŵakutaga mbopesiwo kuti jemanjajo aŵecete kuti tacitenda mpela muŵatendele cilanga.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.12",
            "verseOrgIds": [
              "NEH.5.12"
            ]
          }
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.12",
            "verseOrgIds": [
              "NEH.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NEH 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaneko nakupwile cakuwala cangu ni natite kuti, “Amu ni mwele Mlungu mutacimkupulila jwalijose jwa jemanja jwakakusunga cilanga cakwe. Jwalakwejo tacimleka mli ŵakulaga pakumsumula nyumba syenu, ŵamasengo ŵenu ni yindu yosope yimkwete.” Ŵanduwo ŵajiticisye kuti, “Yiŵe myoyo” nipo wosopewo ŵamlambile Mlungu. Panyuma pakwe acakulungwakulungwa ŵala ŵatesile mpela muŵatendele cilanga cila.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.13",
            "verseOrgIds": [
              "NEH.5.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Umbone mtima wa Nehemiya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NEH 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.13",
            "verseOrgIds": [
              "NEH.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NEH 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutyocela pa ndaŵi jiŵasagwile une kuti m'mbe bwanamkubwa jwa cilambo ca Yuda, kutandilila mcaka ca 20 mpaka mcaka ca 32 yele yayili yaka 12 ya ucimwene wa Alitakisesi, une pamo ni acalongo acimjangu nganitukunda kupocela cakulya cakuŵajilwa bwanamkubwa. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.14",
            "verseOrgIds": [
              "NEH.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NEH 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Acibwanamkubwa ŵiŵapali kala une mkininjinjile m'malo mwawo ŵasawusyaga ŵandu pakwalamula jemanjajo kuti apeleceje yakulya ni finyo ni kwalipikasya soni mbiya sya silifa",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.15",
            "verseOrgIds": [
              "NEH.5.15"
            ]
          }
        },
        {
          "text": " syakwana 40 pa lisiku. Nombe ŵamasengo ŵawo ŵakanganicisyaga ŵandu. Nambo une nganindenda nawo yeleyo, ligongo namjogopagaga Mlungu. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.15",
            "verseOrgIds": [
              "NEH.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NEH 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nalipelece ku masengo gakutaŵa soni lipupa lya msinda nipo nganisuma mgunda uliwose. Ŵamasengo ŵangu wosope ŵaliji nawo pa masengo gakutaŵago. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.16",
            "verseOrgIds": [
              "NEH.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NEH 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndaŵi syosope nalisyaga Ayuda pamo ni acimlongola ŵawo, kupwatikapo soni ŵandu ŵane ŵiŵayice kwa une kutyocela ku yilambo yine yakutusyungulila, nipo wosope pamo ŵakwanaga 150. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.17",
            "verseOrgIds": [
              "NEH.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NEH 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cakulya ca lisiku lililyose caliji: Ng'ombe jimo, ngondolo msano ni jimo syakwimbala, ni nguku syejinji. Masiku likumi galigose napelekaga finyo jwejinji. Atamose yaliji myoyo, une nganingunda kupocela yakulya yiŵapocelaga bwanamkubwa ligongo lyakuti ŵandu ŵangu ŵaliji pa yipwetesi yekulungwa.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.18",
            "verseOrgIds": [
              "NEH.5.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NEH 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.18",
            "verseOrgIds": [
              "NEH.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NEH 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngupopela kuti Mlungu ambe upile pa yosope yene yinatendele ŵandu ŵangu.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.19",
            "verseOrgIds": [
              "NEH.5.19"
            ]
          }
        }
      ]
    }
