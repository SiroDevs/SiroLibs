          },
          "items": [
            {
              "text": "61",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵapali ŵandu 642 ŵakutyocela mwiŵasa lya Delaya, Tobiya, ni Nekoda ŵiŵawusile kutyocela ku misinda ja Teli Mela, Teli Halisha, Kelubi, Adoni, ni Imeli, atamose kuti jemanjaji nganapakombola kusala kusyesyene naga acinangolo ŵawo kapena mitundu jawo jaliji ja Aisalaeli ŵasyesyene kapena iyayi.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.7.61+NEH.7.62",
            "verseOrgIds": [
              "NEH.7.61",
              "NEH.7.62"
            ]
          }
        }
      ]
