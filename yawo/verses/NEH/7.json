        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "63",
            "style": "v",
            "sid": "NEH 7:63"
          },
          "items": [
            {
              "text": "63",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maŵasa ga Habaiya, Hakosi, ni Balisilayi nganigapakombola kusala kuti jemanjajo ŵaliji ŵakutaga mbopesi. Nangolo jwa liŵasa lya Balisilayi ŵalombele mwanace jwamkongwe jwa Balisilayi ŵa ku Giliyadi nipo ŵajigele lina lya kwiŵasa kwa ŵamkwakwe. Nambo jemanjajo ŵasosilesosile mena mu buku ja kawundula jwa maŵasa gawo, nambo mena gawogo nganagasimanamo, myoyo nganiŵakunda soni jemanjajo kutumicila mpela ŵakutaga mbopesi. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.7.63+NEH.7.64",
            "verseOrgIds": [
              "NEH.7.63",
              "NEH.7.64"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "65",
            "style": "v",
            "sid": "NEH 7:65"
          },
          "items": [
            {
              "text": "65",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanamkubwa jwa Ciyuda ŵasalile jemanjajo kuti akalyaga nawo cakulya cicapelecedwe kwa Mlungu, mpaka ali asimanikwe jwakutaga mbopesi jwakumanyilila kulondola cisango pakukamulisya masengo maganga gaŵili ga Ulimu ni Tumimu.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.7.65",
            "verseOrgIds": [
              "NEH.7.65"
            ]
          }
        },
