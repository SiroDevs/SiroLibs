              "text": "60",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ciŵalanjilo cosope ca ŵandu ŵakamula masengo ku Nyumba ja AMBUJE pamo ni ŵamasengo ŵa Solomoni ŵiŵawusile ku ukapolo caliji 392.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.7.60",
