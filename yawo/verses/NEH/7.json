        },
        {
          "text": "Ciŵalanjilo cosope ca ŵandu ŵiŵawusile kutyocela ku ukapolo caliji 42,360. Ŵamasengo ŵawo ŵacalume ni ŵacakongwe ŵapali 7,337, acalume ni acakongwe ŵakwimba nyimbo ŵapali 245, mahaci gapali 736, acibulu ŵapali 245, ngamila",
          "type": "text",
          "attrs": {
            "verseId": "NEH.7.66+NEH.7.67+NEH.7.68+NEH.7.69",
            "verseOrgIds": [
              "NEH.7.66",
              "NEH.7.67",
              "NEH.7.68",
              "NEH.7.69"
            ]
          }
        },
        {
          "text": " syapali 435 ni mbunda syapali 6,720.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.7.66+NEH.7.67+NEH.7.68+NEH.7.69",
            "verseOrgIds": [
              "NEH.7.66",
