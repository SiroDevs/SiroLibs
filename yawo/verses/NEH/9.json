            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alefi ŵakuyicisyaŵa mpela Yeswa, Kadimiyele, Bani, Hashabineya, Shelebiya, Hodiya, Shebaniya, ni Petahiya ŵasalile ŵanduwo kuti:",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.5",
            "verseOrgIds": [
              "NEH.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lipopelo lyakwiticisya kulemwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
