          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenye Asa jwa ku Yuda ni Mwenye Basha jwa ku Isalaeli ŵaliji pa ngondo masiku gosope ga ucimwene wawo.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.32",
