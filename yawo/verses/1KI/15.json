          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yele yinduyi yatendekwe myiyi ligongo Yelobowamu ŵamtumbilisye AMBUJE, Mlungu jwa Aisalaeli, pakulemwa jwalakwe msyene soni kwatendekasya Aisalaeli kulemwa.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.30",
            "verseOrgIds": [
              "1KI.15.30"
            ]
          }
        }
