          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nadabu mwanace jwamlume jwa Yelobowamu ŵajinjile ucimwene wa ku Isalaeli, mu caka caŵili ca ucimwene wa Asa ku Yuda. Nadabujo ŵagambile kulamula ku Isalaeli kwa yaka yiŵilipe basi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.25",
            "verseOrgIds": [
              "1KI.15.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwalakwejo ŵatesile yindu ya ulemwa",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.26",
            "verseOrgIds": [
              "1KI.15.26"
            ]
          }
        },
        {
          "text": " pameso pa AMBUJE Mlungu, mpela muŵatendele babagwe, nipo ŵatendesye ŵandu ŵa ku Isalaeli kulemwa.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.26",
            "verseOrgIds": [
              "1KI.15.26"
            ]
          }
        }
      ]
    },
    {
