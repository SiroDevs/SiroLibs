              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Masengo gane gaŵatesile Nadabu, piŵaliji mwenye yilembedwe m'buku ja Mbili ja Ayimwene ŵa ku Isalaeli. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.31",
