              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nipo AMBUJE ŵamsalile jwakulocesya",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.28",
            "verseOrgIds": [
              "1KI.21.28"
            ]
          }
        },
        {
          "text": " Eliya kuti, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.28",
