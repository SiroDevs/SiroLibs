    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Solomoni akumpitikucila Mlungu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1KI 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenye Solomoni ŵanonyelaga acakongwe ŵajinji ŵa cilendo. Konjecesya pa mwanace jwamkongwe jwa Mwenye jwa ku Iguputo, ŵalombele soni acakongwe ŵa mitundu aji: Amowabu, Aedomu, Asidoni ni Ahiti.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.1",
            "verseOrgIds": [
              "1KI.11.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.17.17"
              },
              "items": [
                {
                  "text": "Det 17:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.1",
            "verseOrgIds": [
              "1KI.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵalombele acakongwe ŵeleŵa, atamose kuti AMBUJE",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.2",
            "verseOrgIds": [
              "1KI.11.2"
            ]
          }
        },
        {
          "text": " ŵalekasisye ŵandu ŵa ku Isalaeli, acakongwe atamose acalume, kuti akalombana ni ŵandu ŵa mitundu jeleji, kogopela ni mkaŵa mitima ja Aisalaeli kupitikuka ni kutanda kujilambila milungu jine.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.2",
            "verseOrgIds": [
              "1KI.11.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.34.16"
              },
              "items": [
                {
                  "text": "Eks 34:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.7.3+DEU.7.4"
              },
              "items": [
                {
                  "text": "Det 7:3-4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.2",
            "verseOrgIds": [
              "1KI.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenye Solomoni ŵalombele ŵanace ŵa ayimwene 700 ni acakongwe wamba 300. Nipo Solomoni, ŵamsokonesye mtwe acakongwewo. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.3",
            "verseOrgIds": [
              "1KI.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ali acekulwipe acakongwewo ŵatandite kumnyenjelela Solomoni kuti alambileje milungu ja cilendo. Myoyo Mwenye Solomoni nganakulupicika kwa AMBUJE Mlungu jwawo, ni mtima wawo wosope, mpela muŵatendele Daudi",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.4",
            "verseOrgIds": [
              "1KI.11.4"
            ]
          }
        },
        {
          "text": " baba ŵawo. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.4",
            "verseOrgIds": [
              "1KI.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwalakwe ŵalambilaga Ashitoleti, mlungu jwacikongwe jwa ŵandu ŵa ku Sidoni, ni soni Milikomu, mlungu jwakunyalaya jula jwa ŵandu ŵa Aamoni. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.5",
            "verseOrgIds": [
              "1KI.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakutenda myoyo Mwenye Solomoni ŵalemwecesye AMBUJE, nipo nganiŵakuya AMBUJE ni mtima wawo wosope, mpela muŵatendele Daudi baba ŵawo. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.6",
            "verseOrgIds": [
              "1KI.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵataŵile malo gakulambila petumbi lili kungopoko lyuŵa kwa Yelusalemu, kumtaŵila Kemoshi, mlungu jwa kunyalaya jwa ŵa Mowabu, ni soni Moleki mlungu jwakunyalaya jwa Aamoni. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.7",
            "verseOrgIds": [
              "1KI.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵataŵile soni malo ga aciŵamkwakwe ŵa cilendo ŵala, gakututumicisya ubani",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.8",
            "verseOrgIds": [
              "1KI.11.8"
            ]
          }
        },
        {
          "text": " ni gakupelecela mbopesi kwa milungu jawo.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.8",
            "verseOrgIds": [
              "1KI.11.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.8",
            "verseOrgIds": [
              "1KI.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "AMBUJE, Mlungu jwa Aisalaeli, ŵamwonecele Solomoni kaŵili, ŵamlamwile kuti akasalambila milungu jine ja cilendo. Nambo Solomoni nganiŵapikanila AMBUJE, ligongo mtima wakwe ŵagalawice ni ŵalesile AMBUJE Mlunguwo. Nipo AMBUJE ŵamtumbilile Solomoni. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.9+1KI.11.10",
            "verseOrgIds": [
              "1KI.11.9",
              "1KI.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "AMBUJE ŵamsalile Solomoni kuti, “Ligongo lyakuti mkasile mwamelepe cilanga",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.11",
            "verseOrgIds": [
              "1KI.11.11"
            ]
          }
        },
        {
          "text": " cenu cimwaŵisile kwa une, ni malamusi gangu ginampele, tinjiwusumula ucimwene kutyoka m'makono mwenu ni kuwupeleka kwa jumo jwa nduna syenu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.11",
            "verseOrgIds": [
              "1KI.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngindenda yindu yeleyi m'mwejo mli ciŵela umi, ligongo lya baba ŵenu Daudi. Tinjiwusumula pa ndaŵi jitacijinjila ucimwene mwanagwenu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.12",
            "verseOrgIds": [
              "1KI.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngisinimsumula mwanagwenu ucimwene wosope iyayi. Nambo tinjimlecela lukosyo lumope, ligongo lya jwakutumicila jwangu Daudi, soni ligongo lya Yelusalemu msinda wunawusagwile kuti uŵe wangu.”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.13",
            "verseOrgIds": [
              "1KI.11.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Amagongo ŵa Solomoni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.13",
            "verseOrgIds": [
              "1KI.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "AMBUJE ŵamjimucisye Solomoni m'magongo, jwa liŵasa lya ucimwene wa ku Edomu, lina lyakwe Hadadi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.14",
            "verseOrgIds": [
              "1KI.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kala mnope nditu mkaniyitendece yeleyi, ndaŵi jele Daudi jiŵaputaga ngondo ni ŵandu ŵa ku Edomu, Yowabu jwamkulungwa jwa ngondo ŵajawile ku Edomuko kuja kwasika m'malembe asilikali ŵa ci Isalaeli ŵawulajidwe pa ngondo. Yowabu ni asilikali ŵakwe ŵa ngondo ŵatemi ku Edomuko miesi msano ni umo, pa jele ndaŵiji ŵawuleje acalume ŵosope ŵa ku Edomuko, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.15+1KI.11.16",
            "verseOrgIds": [
              "1KI.11.15",
              "1KI.11.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "akaŵe Hadadi juŵatilile ku Iguputo, pamo ni ŵamasengo ŵa baba ŵakwe ŵa ci Edomu. Ndaŵi jelejo Hadadi ali mwanace jwa mnondi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.17",
            "verseOrgIds": [
              "1KI.11.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵatyosile ku Midiyani kuja ku Palani, kweleko ŵajigele acalume ŵane. Nipo ŵajesile mpaka kuja kwika ku Iguputo, ŵayicile kwa mwenye jwa cilamboco. Mwenye jwa ku Iguputojo ŵampele Hadadi ni ŵandu ŵakwe nyumba ni yakulya, ŵampele soni ka cilambo kakuti atameje. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.18",
            "verseOrgIds": [
              "1KI.11.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenye jwa ku Iguputojo ŵamnonyele mnope Hadadi, kwa mpaka ŵampele mlambagwawo kuti aŵe ŵamkwakwe. Jwamkongwejo jwaliji mpwakwe jwa ŵamkwawo mwenye ŵa ku Iguputo jula, lina lyawo lyaliji Tapenesi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.19",
            "verseOrgIds": [
              "1KI.11.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵamkwawo Hadadiwo, ŵaŵelece mwanace jwamlume lina lyakwe Genubati. Nipo Tapenesi ŵamlelite Genubati ku nyumba jakwe ja ucimwene, pamo ni ŵanace ŵa Mwenye jwa ku Iguputoko. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.20",
            "verseOrgIds": [
              "1KI.11.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hadadi piŵapikene ku Iguputoko kuti Daudi ŵawile, ni kuti Yowabu jwamkulungwa jwa ngondo nombe nawo ŵawile soni, ŵamsalile Mwenye jwa ku Iguputo jula kuti, “Conde angunde kuti ndyoce kuti njawule ku cilambo ca kumangwetu.” ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.21",
            "verseOrgIds": [
              "1KI.11.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo Mwenye jwa ku Iguputo jula ŵamwusisye kuti, “Ligongo cici?” “Ana cipali cindu cilicose cindepele kumpa, ca mpaka m'mweji kuganisya yakuwujila ku cilambo ca kumangwenu?” Nambo Hadadi ŵamjanjile mwenyejo kuti, “Iyayi ngaŵa yeleyo, agambe kungunda basi kuti njawuleje.” Hadadi piŵajinjile ucimwene wa ku Edomu, ŵaliji mwenye jwakusakala, soni ŵaliji m'magongo jwakogoya jwa Aisalaeli.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.22",
            "verseOrgIds": [
              "1KI.11.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.22",
            "verseOrgIds": [
              "1KI.11.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1KI 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mlungu ŵamjimucisye Solomoni m'magongo jwine soni, lina lyakwe Lesoni mwanace jwa Eliyada, kuti amjimucile jwalakwe. Lesoni ŵaliji ali atisile kwa ambujegwe, Mwenye Hadadesa jwa ku Soba. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.23",
            "verseOrgIds": [
              "1KI.11.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 11:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lesoni ŵasongangenye ŵandu, nipo jwalakweju ni juŵaliji jwakulilongolela likuga lya ŵandu ŵaciswamba. Ayi yatendekwe ndaŵi jele Daudi ŵampundile pa ngondo Hadadesa, ni kwawulaga amagongo ŵakwe ŵa ku Siliya. Lesoni ni likuga lya ŵandu ŵakwe ŵajile kutama ku Damasiko, ŵanduwo ŵamjinjisye jwalakwe ucimwene wakulamulila cilambo ca Siliya. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.24",
            "verseOrgIds": [
              "1KI.11.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lesoni ŵaliji m'magongo jwa Aisalaeli ndaŵi josope ja umi wakwe Solomoni. Ŵaliji mkumsawusya Solomoni, ŵajonjecesye yisawusyo yiŵapataga Solomonijo kutyocela kwa Hadadi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.25",
            "verseOrgIds": [
              "1KI.11.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Cilanga ca Mlungu kwa Yelobowamu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.25",
            "verseOrgIds": [
              "1KI.11.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 11:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundu jwine juŵamjimucile Mwenye Solomoni ŵaliji jumo jwa nduna syakwe lina lyakwe Yelobowamu, mwanace jwa Nebati jwakutyocela m'musi ŵa Seleda mcilambo ca Efelemu. Mamagwe ŵaliji ŵamasije nipo lina lyawo lyaliji Seluya. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.26",
            "verseOrgIds": [
              "1KI.11.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 11:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngani jakwimucila kwakweko jajesile camti myi: Solomoni ŵaliji mkusilila licenje lyaliji kungopoko lyuŵa kwa msinda wa Yelusalemu ni litaka, ni soni ŵaliji mkutaŵa lipupa lilyasyungwile msindawo. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.27",
            "verseOrgIds": [
              "1KI.11.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yelobowamu ŵaliji mundu jwakulipeleka pakutenda masengo, nipo Solomoni piŵam'weni kuti akukamula masengo mwakulimbika, ŵamŵisile kuŵa kapitawo jwakwalolela ŵamasengo ŵiŵakamulaga ku dela jiŵatamaga ŵandu ŵa lukosyo wa Manase ni Efelemu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.28",
            "verseOrgIds": [
              "1KI.11.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.28",
            "verseOrgIds": [
              "1KI.11.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 11:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lisiku line Yelobowamu piŵaliji pa ulendo wa kutyocela ku Yelusalemu, nipo ŵasimangene najo jwakulocesya",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.29",
            "verseOrgIds": [
              "1KI.11.29"
            ]
          }
        },
        {
          "text": " Ahiya jwa ku Shilo, ali jika pa msewu. Ahiyawo ŵaliji ali awete mkanjo wasambano, nipo ŵaliji ŵaŵilipe kwitinjiko. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.29",
            "verseOrgIds": [
              "1KI.11.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 11:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahiya ŵawusile mkanjo wasambano uŵawete ula, ni ŵawupapwile kuŵa likumi ni yiŵili. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.30",
            "verseOrgIds": [
              "1KI.11.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1KI 11:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni ŵamsalile Yelobowamu kuti, “Mjigale yiwisa likumiyi. Ligongo AMBUJE, Mlungu jwa Aisalaeli, akumsalila m'mwejo kuti, ‘Une nguwusumula ucimwene m'magasa ga Solomoni, nipo tinampe m'mwejo mitundu ja ŵandu likumi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.31",
            "verseOrgIds": [
              "1KI.11.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1KI 11:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoni tinamlecele lukosyo lumope, ligongo lya Daudi jwakutumicila jwangu, ni soni ligongo lya Yelusalemu, msinda wele nawusagwile kuŵa wangu pa cilambo cosope ca Aisalaeli. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.32",
            "verseOrgIds": [
              "1KI.11.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1KI 11:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tinayitende yindu yeleyi ligongo Solomonijo anganile une, atandite kumpopelela Ashitoleti, mlungu jwamkongwe jwa ŵandu ŵa ku Sidoni, Kemoshi mlungu jwa Amowabu, ni Milikomu mlungu jwa Aamoni. Pakutenda myoyo nganambikanila une, atesile yindu yakulemwa, nginatenda yingusaka une, soni nganasunga malamusi gangu, ni majiganyo gangu, mpela muŵatendelaga Daudi baba ŵawo. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.33",
            "verseOrgIds": [
              "1KI.11.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1KI 11:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo nganimsumula ucimwene Solomoni. Taŵepe mwenye jwakulamulila umi wakwe wosope, ligongo lya Daudi jwakutumicila jwangu junamsagwile, jwele juŵasungaga malamusi gangu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.34",
            "verseOrgIds": [
              "1KI.11.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1KI 11:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ucimwenewo tinjiwusumula uli m'magasa ga mwanace jwa Solomoni, nipo m'mwejo tinjimpa ngosyo likumi sya Aisalaeli. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.35",
            "verseOrgIds": [
              "1KI.11.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1KI 11:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo tinjimlecela lukosyo lumope mwanace jwa Solomonijo kuti alulamulileje, ni soni kuti ndaŵi syosope paŵeje cisukulu ca Daudi jwakutumicila jwangu, jwakulamulila Yelusalemu, msinda wangu unawusagwile kuti ambopeleje kweleko. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.36",
            "verseOrgIds": [
              "1KI.11.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1KI 11:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yelobowamu, tinimŵice kuŵa mwenye jwa Aisalaeli, timlamulile cilambo cilicose cimkusaka. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.37",
            "verseOrgIds": [
              "1KI.11.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1KI 11:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naga mkupikanila yosope yitinamlamule une, ni kwenda m'matala gangu, ni kutenda yingusosa une, pakugasunga malamusi gangu mpela muŵatendelaga Daudi jwakutumicila jwangu, ni kuti une tinjiŵa ni m'mwejo ndaŵi syosope. Tinamŵice m'mwejo kuŵa mwenye jwa Aisalaeli, nipo tinjilolecesya kuti yisukulu yenu tiyilamulile panyuma penu, mpela munatendele cilanga ni Daudi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.38",
            "verseOrgIds": [
              "1KI.11.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1KI 11:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ligongo lyakulemwa kwa Solomoniku, tinjiyipa cilango yisukulu ya Daudi, nambo ngaŵa kwa yaka yosope.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.39",
            "verseOrgIds": [
              "1KI.11.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1KI 11:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.39",
            "verseOrgIds": [
              "1KI.11.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1KI 11:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nipo Solomoni ŵasakaga kumwulaga Yelobowamu. Nambo Yelobowamu ŵatyosile ni kutilila kwa Mwenye Shishaki jwa ku Iguputo. Ŵatemi ku Iguputoko mpaka Mwenye Solomoni ali awile.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.40",
            "verseOrgIds": [
              "1KI.11.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kuwa kwa Solomoni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1KI 11:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.40",
            "verseOrgIds": [
              "1KI.11.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1KI 11:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Masengo gane giŵatesile Solomoni, lunda lwakwe, ni yosope yiŵatesile, yosope yilembedwe m'buku ja Mbili ja Solomoni. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.41",
            "verseOrgIds": [
              "1KI.11.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1KI 11:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwalakwe ŵalamulile Aisalaeli ku Yelusalemu yaka 40. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.42",
            "verseOrgIds": [
              "1KI.11.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "1KI 11:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵawile ni ŵamsicile mwilembe mu msinda wa Daudi, baba ŵawo. Nipo Lehobowamu mwanace jwakwe, ŵajinjile ucimwene m'malo mwakwe.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.43",
            "verseOrgIds": [
              "1KI.11.43"
            ]
          }
        }
      ]
    }
