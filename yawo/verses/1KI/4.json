              },
              "items": [
                {
                  "text": "25:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "SNG.1.1"
              },
              "items": [
                {
                  "text": "Nyi 1:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.32",
            "verseOrgIds": [
              "1KI.4.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1KI 4:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu jele misyungujo ni nyimbosyo, ŵajiganyisye ngani ja yitela ni yakumela yine, kutandila ngani ja mikungusa ja ku Lebanoni mpaka ja kawukutu ka hisope",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.33",
            "verseOrgIds": [
              "1KI.4.33"
            ]
          }
        },
        {
          "text": " kakumela m'mapupa. Ŵaŵecete soni ya yinyama, yijuni, yinyama yakwaŵa pasi ni ya somba. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.33",
            "verseOrgIds": [
              "1KI.4.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1KI 4:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayimwene ŵosope ŵa yilambo yapasi ŵajipikene mbili ja lunda lwakwe, ni ŵatumisyaga ŵandu ŵawo kuti akapikane ya lunda lwakwelo.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.34",
            "verseOrgIds": [
              "1KI.4.34"
            ]
          }
        }
      ]
    }
