          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoni ŵaliji mwenye jwa ku Isalaeli, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.1",
            "verseOrgIds": [
              "1KI.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "syakuyicisyasi syaliji nduna syakwe:",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.2",
            "verseOrgIds": [
              "1KI.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.6",
            "verseOrgIds": [
              "1KI.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoni ŵasagwile nduna sine likumi kwisa siŵili ni ŵasiŵisile ku mbali syosope sya cilambo ca Isalaeli. Nduna syelesi syapelekaga yakulya kwa mwenye ni liŵasa lyakwe lyosope. Nduna jilijose japelekaga yakulya kwa mwenye mwesi umo pa caka. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.7",
            "verseOrgIds": [
              "1KI.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mena ga nduna likumi ni siŵili ni mbali siŵalolelaga ni asi:",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.8",
            "verseOrgIds": [
              "1KI.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Japali soni nduna jimo jijalolelaga cilambo cosope ca Yuda.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.19",
            "verseOrgIds": [
              "1KI.4.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kulamulila kwa Solomoni kukwendelecela cenene",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.19",
            "verseOrgIds": [
              "1KI.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵandu ŵa Ciyuda ni Aisalaeli ŵatupile mpela mcenga ŵa mungulugulu nyasa. Ŵaliji ŵandu ŵakusengwa mnope, ligongo mundu jwalijose ŵakwete yakulya ni yakumwa yakwanila. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.20",
            "verseOrgIds": [
              "1KI.4.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoni ŵaliji mkulamulila yilambo yosope, ya kutandila ku Lusulo lwa Yufuleti mpaka ku cilambo ca Afilisiti, mpaka kuja kwika kumalile ga cilambo ca Iguputo. Ŵandu ŵa myilambo yeleyi ŵaliji mkukoma msongo, ni kumtumicila Solomoni masiku gosope ga umi wakwe.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.21",
            "verseOrgIds": [
              "1KI.4.21"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.15.18"
              },
              "items": [
                {
                  "text": "Gen 15:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.9.26"
              },
              "items": [
                {
                  "text": "2 Mbi 9:26",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
