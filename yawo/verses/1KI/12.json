              "1KI.12.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1KI 12:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yelobowamu ŵaŵisile lisiku lya 15, lya mwesi wa msano ni jitatu, kuŵa lisiku lyakutenda cindimba Aisalaeli, mpela muŵatendelaga cindimba ku cilambo ca Yuda. Pa lyele lisikuli, Yelobowamu ŵajawulaga ku Beteli kuja kutaga mbopesi, kwa mwanace jwa ng'ombe jwa golidi juŵagumbile. Nipo kweleko ŵaŵisile ŵakutaga mbopesi pa malo gakulambila giŵataŵile kuti atumicileje.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.32+1KI.12.33",
            "verseOrgIds": [
              "1KI.12.32",
              "1KI.12.33"
