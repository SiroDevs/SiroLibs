              },
              "items": [
                {
                  "text": "Det 17:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.28",
            "verseOrgIds": [
              "1KI.10.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 10:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵasumaga soni mageleta kutyocela ku cilambo ca Iguputo. Ŵasumaga ligeleta limo pa mtengo wa mbiya sya silifa 600, ni haci jimo ŵasumaga masekeli ga silifa 150. Ŵa malonda ŵa mwenyewo nombe nawo ŵasumisyaga kwa acayimwene ŵa Ahiti ni ŵa ku Siliya.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.29",
            "verseOrgIds": [
              "1KI.10.29"
            ]
          }
