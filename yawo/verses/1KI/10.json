              "1KI.10.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1KI 10:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenye Solomoni ŵaliji ŵakusicila soni ŵalunda kwapunda acayimwene wosope ŵa pa cilambo capasi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.23",
            "verseOrgIds": [
              "1KI.10.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 10:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵandu wosope ŵa pa cilambo capasi ŵamsosaga kuti amlole Mwenye Solomoni ni kumpikanila lunda lwakwe luŵapegwile ni Mlungu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.24",
            "verseOrgIds": [
              "1KI.10.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 10:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwalijose juŵayikaga kwa Mwenye Solomoni ŵayikaga ni mtuka wakwe, yindu yakupanganyidwa ni silifa ni ya golidi, yakuwala, yida ya ngondo, yakununjila yakutaga muyakulya, mahaci ni acibulu. Yeleyi yatendekwaga caka ni caka.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.25",
            "verseOrgIds": [
              "1KI.10.25"
            ]
          }
        }
      ]
    },
