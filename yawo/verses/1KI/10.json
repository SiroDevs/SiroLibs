    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mwenye jwamkongwe jwa ku Sheba ŵayice kukunguluka ni Solomoni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1KI 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Piŵapikene mwenye jwamkongwe jwa ku Sheba mbili jakupikanika kwakwe kwa Solomoni, ŵayice ku Yelusalemu kukumlinga ni yiwusyo yakusawusya.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.1",
            "verseOrgIds": [
              "1KI.10.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.12.42"
              },
              "items": [
                {
                  "text": "Mat 12:42",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.11.31"
              },
              "items": [
                {
                  "text": "Luk 11:31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.1",
            "verseOrgIds": [
              "1KI.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵayice ni ŵakutumicila ŵakwe ŵajinji, ni ngamila",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.2",
            "verseOrgIds": [
              "1KI.10.2"
            ]
          }
        },
        {
          "text": " sili sitwicile mituka ja yindu yakutaga mu yakulya yakununjila, golidi",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.2",
            "verseOrgIds": [
              "1KI.10.2"
            ]
          }
        },
        {
          "text": " jwamjinji, ni maganga ga mtengo wapenani mnope. Piŵasimene ni Mwenye Solomoni, jwalakwe ŵamwusisye yiwusyo yosope yiŵakwete mu mtima mwakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.2",
            "verseOrgIds": [
              "1KI.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoni ŵayijanjile cenene yiwusyo yakwe yosope. Nipo paliji pangali ciwusyo cakusawusya kwa jwalakwejo, cimkanapakombola kumgopolela cenene mwenye jwamkongwejo. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.3",
            "verseOrgIds": [
              "1KI.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenye jwa ku Sheba piŵalupikene lunda losope lwa Solomoni, ni piŵajiweni nyumba jiŵataŵile jila, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.4",
            "verseOrgIds": [
              "1KI.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "ni piŵaciweni cakulya cicaliji pa tebulo jakwe, majumba gakutama nduna syakwe, kamula kwa masengo kwa ŵakutumicila ŵakwe ni yakuwala yawo, ŵakutumicila ŵakwe ŵakupelecela yakumwa, ni mbopesi syakwe siŵatagaga ku Nyumba ja AMBUJE.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.5",
            "verseOrgIds": [
              "1KI.10.5"
            ]
          }
        },
        {
          "text": " Ŵagambile kuŵa kukamwa jasa, kusoŵa cakuŵeceta.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.5",
            "verseOrgIds": [
              "1KI.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.5",
            "verseOrgIds": [
              "1KI.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nipo ŵamsalile Mwenye Solomoni kuti, “Yinayipikanaga ndili ku cilambo ca kumangwetu ya ŵalakwe, yakusala ya masengo gawo ni lunda lwawo, yili yakuwona. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.6",
            "verseOrgIds": [
              "1KI.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo yeleyo ngininayikulupilila, mpaka pimbice akuno ni kuyiwona ni meso gangu. Nambo nayiweni kuti ŵanduwo nganasalila atamose hafu ja yindu yosope. Lunda lwawo ni cipanje cakwete ŵalakwe yipundile ni muŵasalilaga ŵele ŵanduwo kumangwetu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.7",
            "verseOrgIds": [
              "1KI.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵana upile aciŵamkwenu. Ŵana upile ŵakutumicila ŵenu, ŵakuŵa pameso penu ndaŵi syosope, ni kukola upile ŵakupikanila yakuŵeceta yenu ya lunda. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.8",
            "verseOrgIds": [
              "1KI.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Acimbicikwe AMBUJE Mlungu jwenu, ŵiŵanonyele ŵalakwe, ni kwatamika ŵalakwe pa mpando wa ucimwene wa cilambo ca Isalaeli. Ligongo cinonyelo ca AMBUJE pa Aisalaeli cili cangamala, ŵaŵisile ŵalakwe kuti aŵe mwenye jwakulamulila mwakulupicika ni mwa cilungamo.” ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.9",
            "verseOrgIds": [
              "1KI.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ali amasile kuŵeceta mwenye jwamkongwejo, ŵapelece kwa Mwenye Solomoni golidi jwa usito wa makilogalamu 4,000, yakununjila yakutaga mu yakulya yejinji yamitundumitundu, ni maganga ga mtengo wapenani mnope. Yakununjila yakutaga mu yakulya yiŵapelece mwenye jwamkongwe jwa ku Sheba yaliji yejinji, yele yimkanapoceleje ni kalakose Mwenye Solomoni.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.10",
            "verseOrgIds": [
              "1KI.10.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.10",
            "verseOrgIds": [
              "1KI.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yombo ya Mwenye Hilamu, yiyajigele golidi kutyocela ku Ofili yila, yajigele soni yitela yejinji ya alimugi ni maganga ga mtengo wapenani mnope. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.11",
            "verseOrgIds": [
              "1KI.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni yitela yeleyo Mwenye Solomoni ŵapanganyisye misati ja Nyumba ja AMBUJE, ni misati ja nyumba ja ucimwene. Ŵapanganyicisye soni malulimba ni pangwe ni yakwimbila yine yangonji, yakwapa ŵandu ŵakwimba. Paliji pangali yitela ya alimugi yakusalala mpela yeleyi, yiyayice kapena kuwoneka soni mcilambo ca Aisalaeli mpaka lelo jino. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.12",
            "verseOrgIds": [
              "1KI.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenye Solomoni nombe najo ŵapelece kwa mwenye jwamkongwe jwa ku Sheba jula mtuka wakapelece kwa mwenye jwine jwalijose, nambo soni ŵampele cindu cilicose ciŵaŵendile. Myoyo mwenye jwamkongwejo pamo ni ŵakutumicila ŵakwe ŵala, ŵawujile ku cilambo ca Sheba.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.13",
            "verseOrgIds": [
              "1KI.10.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Cipanje ca Mwenye Solomoni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.13",
            "verseOrgIds": [
              "1KI.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Caka cilicose Mwenye Solomoni ŵapocelaga golidi jwakwanila makilogalamu 23,000, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.14",
            "verseOrgIds": [
              "1KI.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngaŵalanjila golidi juŵapocelaga kutyocela ku misongo jiŵakomaga ŵandu ŵa malonda, ni juŵapelekaga mtuka acayimwene wosope ŵa cilambo ca Alebiya, ni ma bwanamkubwa ga m'maboma ga mcilambo ca Isalaeli. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.15",
            "verseOrgIds": [
              "1KI.10.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenye Solomoni ŵapanganyisye yakucijila 200 yayikulungwa ya golidi. Mu cakulicinjilicisya cilicose mwajinjilaga golidi jwakwanila ma kilogalamu msano ni gaŵili. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.16",
            "verseOrgIds": [
              "1KI.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵapanganyisye soni yakucijila 300 yayinondi ya golidi. Mu cakulicinjilicisya cilicose mwajinjilaga golidi jwakwanila makilogalamu gaŵili. Ŵayiŵisile yakucijila yosopeyi mcipinda cakolanjidwa kuti, Nyumba ja mu Ukweti wa ku Lebanoni. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.17",
            "verseOrgIds": [
              "1KI.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵapanganyisye soni mpando wawukulungwa wa ucimwene ŵa misengo ja ndembo, ni ŵawusalalisye mpandowo ni golidi jwambone mnope. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.18",
            "verseOrgIds": [
              "1KI.10.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpando wa ucimwenewo wakwete makwelelo msano ni limo gakuja kuyicila pa malo gakutamila, ŵaŵisile yitusitusi ya masimba yiŵili mbali syosope siŵili sya likwelelo lililyose, gakwanile masimba 12 gosope. Pa cakusamila ca mpando wa ucimwenewo, capali citusitusi ca mtwe wa ng'ombe jamkambako, wakwete soni mwakusajika makono aku nakuku, ni yitusitusi ya masimba yili yijimi mu mbali mwa yakusajika makonoyo. Pangali mpando wine wa ucimwene pa cilambo capasi waliji wakulandana ni mpando wa Mwenye Solomoni.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.19+1KI.10.20",
            "verseOrgIds": [
              "1KI.10.19",
              "1KI.10.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.19+1KI.10.20",
            "verseOrgIds": [
              "1KI.10.19",
              "1KI.10.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Migawo josope jiŵamwelaga Mwenye Solomoni jaliji jakupanganyikwa ni golidi. Yida yosope yakamulila masengo yiŵaŵisile mcipinda cakolanjidwa kuti, Ukweti ŵa Lebanoni, nombe nayo yaliji yakupanganyidwa ni golidi msyesyene. Paliji pangali yida ya kupanganyidwa ni silifa,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.21",
            "verseOrgIds": [
              "1KI.10.21"
            ]
          }
        },
        {
          "text": " pakuŵa silifa nganaŵa jwa mtengo wa penani mnope pa ndaŵi ja Solomoni. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.21",
            "verseOrgIds": [
              "1KI.10.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 10:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoni ŵakwete yombo yayikulungwakulungwa soni yakulimba, yiyajendaga pa nyasa pamo ni yombo ya Mwenye Hilamu. Pakumala pa yaka yitatu yili yose yomboyo yawujaga yili yijigele golidi, silifa, misengo ja ndembo, majani ni yitumbili.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.22",
            "verseOrgIds": [
              "1KI.10.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
