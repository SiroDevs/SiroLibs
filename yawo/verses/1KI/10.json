              },
              "items": [
                {
                  "text": "1 Ayi 4:26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.26",
            "verseOrgIds": [
              "1KI.10.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 10:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa ndaŵi jele Solomoni ŵaliji mwenye, silifa mu msinda wa Yelusalemu jwaliji mbwe palipose mpela maganga, ni yitela ya mikungusa yaliji yejinji mpela yitela wamba ya mkuju ya mungulugulu matumbi ga cilambo ca Yuda. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.27",
            "verseOrgIds": [
              "1KI.10.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 10:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵa malonda ŵa Mwenye Solomoni ŵasumaga mahaci kutyocela ku misinda ja Musili ni ku Kuwe ja mcilambo ca Alebiya.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.28",
            "verseOrgIds": [
              "1KI.10.28"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
