      },
      "items": [
        {
          "text": "9",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mlungu akuwonecela soni kwa Solomoni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1KI 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoni ali amalisisye kutaŵa Nyumba ja AMBUJE",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.1",
            "verseOrgIds": [
              "1KI.9.1"
            ]
          }
        },
        {
          "text": " ni nyumba ja mwenye, ni yindu yosope yiŵasacile jwalakwe kutaŵa, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.1",
            "verseOrgIds": [
              "1KI.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "AMBUJE ŵamwonecele soni, mpela mwele muŵawonecele ku Gibiyoni kula.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.2",
            "verseOrgIds": [
              "1KI.9.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.3.5"
              },
              "items": [
                {
                  "text": "1 Ayi 3:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.1.7"
              },
              "items": [
                {
                  "text": "2 Mbi 1:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.2",
            "verseOrgIds": [
              "1KI.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "AMBUJE ŵamsalile kuti, “Nagapikene mapopelo genu. Une nijiswejesye Nyumba jimtaŵileji, kuti jiŵe malo gatimumbopeleje une kwa yaka yosope. Tinajilolele ni kujicenjela jele Nyumbaji ndaŵi syosope. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.3",
            "verseOrgIds": [
              "1KI.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naga m'mwejo mkundumicila une mwakulupicika ni mwakulungamika, mpela mwele muŵatendelaga baba ŵenu Daudi,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.4",
            "verseOrgIds": [
              "1KI.9.4"
            ]
          }
        },
        {
          "text": " soni naga mkuyitenda yindu yosope yinamlamwile ni kugapikanila malamusi gangu ni maloŵe gangu, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.4",
            "verseOrgIds": [
              "1KI.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "une tinacisunje cilanga",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.5",
            "verseOrgIds": [
              "1KI.9.5"
            ]
          }
        },
        {
          "text": " cangu cinatesile kwa baba ŵenu Daudi pinasalile kuti, ŵanace ŵenu ŵacalume tacalamulila Aisalaeli.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.5",
            "verseOrgIds": [
              "1KI.9.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.2.4"
              },
              "items": [
                {
                  "text": "1 Ayi 2:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.5",
            "verseOrgIds": [
              "1KI.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo naga m'mwejo ni ŵanace ŵenu mkuleka kunguya une, soni naga mkuleka kugapikanila maloŵe ni malamusi gangu ginampele, ni kutanda kujitumicila milungu jine ni kujipopelela, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.6",
            "verseOrgIds": [
              "1KI.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "une tinjatyosya ŵandu ŵangu Aisalaeliwo mcilambo cinapele. Tinjijikana Nyumba jino jinajiswejesye kuti jiŵe Nyumba jakumbopelela une. Nipo ŵandu ŵa mitundu jine",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.7",
            "verseOrgIds": [
              "1KI.9.7"
            ]
          }
        },
        {
          "text": " josope tacanyosya ni kwasogoda ŵandu ŵa ku Isalaeli. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.7",
            "verseOrgIds": [
              "1KI.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyumba jamboneji ni jakusalalaji tijiciŵa ciliŵa, nipo mundu jwalijose jutacipita pa malo pelepa tacisimonga ali mkuwusyana kuti, ‘Ligongo cici AMBUJE acitendele cilambo aci yindu yamti myiyi ni Nyumbaji?’",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.8",
            "verseOrgIds": [
              "1KI.9.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.25.9"
              },
              "items": [
                {
                  "text": "2 Ayi 25:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.36.19"
              },
              "items": [
                {
                  "text": "2 Mbi 36:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.8",
            "verseOrgIds": [
              "1KI.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nipo ŵandu tacijanga kuti, ‘Ligongo lyakuti ŵandu ŵeleŵa ŵalesile AMBUJE Mlungu jwawo, ŵaŵakopwesye acinangolo ŵawo ku cilambo ca Iguputo. Ni ŵalisosele acimsyene milungu jine ni kujitumicila ni kujilambila. Ni ligongo lyakwe AMBUJE ŵatendele yindu yakusakala yamti myiyi.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.9",
            "verseOrgIds": [
              "1KI.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Misinda jiŵajipelece Solomoni kwa Hilamu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.9",
            "verseOrgIds": [
              "1KI.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Masengo gakutaŵa Nyumba ja AMBUJE ni nyumba ja mwenye gamjigalile Solomoni yaka makumi gaŵili. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.10",
            "verseOrgIds": [
              "1KI.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Panyuma pakwe Mwenye Solomoni ŵampele Mwenye Hilamu jwa ku Taya misinda 20, ja mbali ja mcilambo ca Galileya. Kumlipila ligongo ni juŵapelekaga kwa Solomoni yitela ya Mkungusa, ya payini, ni soni golidi,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.11",
            "verseOrgIds": [
              "1KI.9.11"
            ]
          }
        },
        {
          "text": " mpela muŵasoselaga Solomoni. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.11",
            "verseOrgIds": [
              "1KI.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hilamu piŵajawile kutyocela ku Taya, kuja kujilola misinda jiŵapegwile ni Solomoni, nambo nginajinonyela. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.12",
            "verseOrgIds": [
              "1KI.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni ligongo lyakwe ŵamwusisye Solomoni kuti, “Ana m'mweji Solomoni, mlongo mjangu, misinda jimkumba uneji ni jeleji?” Myoyo Hulamu ŵajipele jele mbali ja cilambo ca Galileyajo, lina lyakuti Kabu, lilikukolanjidwa mpaka lelo jino. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.13",
            "verseOrgIds": [
              "1KI.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hilamu ŵaliji ali amtumicisye Solomoni golidi jwakupunda makilogalamu 4,000.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.14",
            "verseOrgIds": [
              "1KI.9.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yindu yine yayikulungwa yiŵatesile Solomoni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.14",
            "verseOrgIds": [
              "1KI.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Piŵamasile ŵamasengo ŵa Mwenye Solomoni kutaŵa Nyumba ja AMBUJE ni nyumba ja mwenye, mwenyewo ŵalamwile ŵa masengowo kuti asilile licenje lilyaliji kungopoko lyuŵa kwa msinda ŵa Yelusalemu ni litaka, ni kutaŵa lipupa kusyungulila msindawo. Ni ŵalamwile kutaŵa soni misinda ja Hasoli, Megido, ni Gesele. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.15",
            "verseOrgIds": [
              "1KI.9.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Mwenye jwa ku Iguputo ŵawusumwile msinda wa Gesele, ni kuwujoca moto. Ŵawuleje ŵandu ŵa Kenani ŵaŵatamaga mu msindamo, ni ŵawupelece msindawo kuti uŵe mtuka wa ulombela kwa mwanace jwakwe jwamkongwe juŵalombedwe ni Solomoni jula. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.16",
            "verseOrgIds": [
              "1KI.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myoyo Solomoni ŵawutaŵile soni wele msindawu). Solomoni ŵalamwile ŵamasengo ŵakwe kutaŵa soni misinda aji, Beti Holoni kwiŵanda, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.17",
            "verseOrgIds": [
              "1KI.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balati, ni Tamala wa ku cipululu ca Yuda. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.18",
            "verseOrgIds": [
              "1KI.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵamasengowo ŵataŵile soni misinda jakusunjila cipanje cakwe, ni mahaci gakwe, ni misinda ja asilikali wakwe ŵakukwela pa mahaci, ŵataŵile cindu cilicose ciwacisacile kutaŵa Mwenye Solomoni mu msinda wa Yelusalemu, Lebanoni, ni malo gane galigose ga mcilambo ciŵacilamulilaga jwalakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.19",
            "verseOrgIds": [
              "1KI.9.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoni ŵayikamulisye masengo ga ukapolo yisukulu ya ŵandu ŵa Kenani, ŵele Aisalaeli nganiŵawulaga, ndaŵi jiŵajinjilaga mcilambomo. Ŵandu ŵeleŵa ŵaliji ŵa mitundu jakulekangana, mpela ŵa Aamoli, ŵa Ahiti, ŵa Apelesi, ŵa Ahifi ni ŵa Ayebusi. Ŵandu ŵeleŵa Mwenye Solomoni ŵakamulisyaga masengo ga ukapolo, nipo ali ciŵela mkukamulape masengo mpaka lelo jino. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.20+1KI.9.21",
            "verseOrgIds": [
              "1KI.9.20",
              "1KI.9.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo Solomoni nganiŵakamulisya masengo ga ukapolo Aisalaeli. Jemanjajo ŵaliji asilikali ŵakwe ŵa ngondo, nduna syakwe sya boma, ŵakulongolela pa ngondo, ŵakulongolela asilikali ŵa pa mageleta ga ngondo, ni asilikali ŵakukwela pa mahaci.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.22",
            "verseOrgIds": [
              "1KI.9.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.22",
            "verseOrgIds": [
              "1KI.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1KI 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵapali soni acikapitawo 550 ŵacakulungwakulungwa ŵakwalolela ŵandu ŵamasengo, ŵaŵakamulaga masengo gakutaŵa yindu yakulekanganalekangana ya Mwenye Solomoni.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.23",
            "verseOrgIds": [
              "1KI.9.23"
            ]
          }
        }
      ]
