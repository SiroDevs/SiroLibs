          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yindu yosope yiŵatesile Lehobowamu piŵaliji mwenye, yilembedwe m'buku ja Mbili ja Ayimwene ŵa ku Yuda. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.29",
            "verseOrgIds": [
              "1KI.14.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 14:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pacilikati pa Mwenye Lehobowamu ni Mwenye Yelobowamu, ŵaliji mkumenyana kaŵilikaŵili ngondo, mwangalecesya. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.30",
            "verseOrgIds": [
              "1KI.14.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1KI 14:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lehobowamu ŵawile, ni ŵamsicile m'malembe ga ucimwene mu msinda wa Daudi, nipo Abiya mwanace jwakwe ŵajinjile ucimwene m'malo mwakwe.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.31",
            "verseOrgIds": [
              "1KI.14.31"
            ]
          }
        }
