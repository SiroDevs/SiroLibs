{
  "id": "1CO.14",
  "number": "14",
  "bookId": "1CO",
  "reference": "1 Akoli 14",
  "verseCount": 40,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "14",
        "style": "c",
        "sid": "1CO 14"
      },
      "items": [
        {
          "text": "14",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mituka jine jakusapeleka Msimu Ŵaswela",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CO 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mlinjilileje kukola cinonyelo, nambo soni mŵice mtima wenu pa mituka jele jakusapeleka Msimu Ŵaswela, mnopemnope mtuka wakuŵeceta maloŵe gakutyocela kwa Mlungu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.1",
            "verseOrgIds": [
              "1CO.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CO 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundu jwakuŵeceta ciŵeceto ca cilendo, jwangaŵeceta ni ŵandu, nambo ni Mlungu. Pangali mundu jwakusapikanicisya yakuŵeceta jwalakwejo, pakuti msimu Ŵaswela ni ŵakusamŵecetekasyaga jwalakwejo ya mtemela. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.2",
            "verseOrgIds": [
              "1CO.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CO 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo jwele jwakuŵeceta maloŵe gakutyocela kwa Mlungu, akusaŵeceta ni ŵandu, akusiŵakamucisya kuti akule mwa Ambuje, akusiŵalimbisya mitima ni kwasangalasya. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.3",
            "verseOrgIds": [
              "1CO.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CO 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundu jwakuŵeceta ciŵeceto ca cilendo akusagamba kukamucisya msyene, nambo jwakuŵeceta maloŵe gakutyocela kwa Mlungu akusawukamucisya mpingo.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.4",
            "verseOrgIds": [
              "1CO.14.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CO 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.4",
            "verseOrgIds": [
              "1CO.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CO 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nganonyele kuti wosope mkakole mtuka wakuŵeceta yiŵeceto ya cilendo, nambo mnopemnope nganonyele kuti jemanja wosope mkole mtuka wakuŵeceta maloŵe gakutyocela kwa Mlungu. Pakuti mundu jwakuŵeceta maloŵe gakutyocela kwa Mlungu, ali jwakusosekwa mnope kumpunda jwele jwakuŵeceta yiŵeceto ya cilendo, naga pali pangali mundu jwakugopolela yiyikuŵecetedwayo kuti mpingo wosope upindule pa yeleyo.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.5",
            "verseOrgIds": [
              "1CO.14.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CO 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.5",
            "verseOrgIds": [
              "1CO.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CO 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Acalongo acimjangu, une naga nguyika kwa jemanja ni kuŵecetaga yiŵeceto ya cilendo, ana yeleyo tiyakamucisye cici? Yeleyi ngaŵa mkwakamucisya jemanja, naga m'maloŵe mwangumo mwangali yine yanjuwulile Mlungu, kapena yine yakupeleka lunda, kapena yine yene yambele Mlungu kuti mbecete, mwine soni lijiganyo line. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.6",
            "verseOrgIds": [
              "1CO.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CO 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mjigale yida yakwimbila yangali umi yele yikusakoposya liloŵe mpela citolilo kapena cida cakwimbila ca ngonji. Ana jwine mpaka alekanganye uli kulila kwa yidayi naga jwakwimbajo ngakuyilekanganya ujimbe wakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.7",
            "verseOrgIds": [
              "1CO.14.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CO 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwakwimba lipenga naga ngakwimba mwakupikanika cenene, ana nduni taliŵicile cile kuja kuputa ngondo? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.8",
            "verseOrgIds": [
              "1CO.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CO 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myoyo soni, ana mundu mpaka apikane uli naga mkuŵeceta mu ciŵeceto ca cilendo? Naga mkutenda myoyo timgambe kwasa maloŵe genu pacabe. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.9",
            "verseOrgIds": [
              "1CO.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CO 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa cilambo capasi pano pana yiŵeceto yakulekanganalekangana yejinji, nambotu pangali ni ciŵeceto cimo cose cele cicili cangali mate. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.10",
            "verseOrgIds": [
              "1CO.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CO 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo une naga ngingumanyilila kugopolela kwa ciŵeceto cicikuŵecetedwa, une tinjiŵa mlendo kwa jwele jwakuŵecetajo, soni jwalakwejo taciŵa mlendo kwa une. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.11",
            "verseOrgIds": [
              "1CO.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CO 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyoyo soni jemanja pimkusosasosa mituka jakusapeleka Msimu Ŵaswela, mkwenela kulinga kujikamulisya masengo mitukajo, mnopemnope ajo jili jakulimbikasya mipingojo.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.12",
            "verseOrgIds": [
              "1CO.14.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CO 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.12",
            "verseOrgIds": [
              "1CO.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CO 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ali ni ligongo lyakwe mundu jwakusaŵeceta ciŵeceto ca cilendo apopele kuti apegwe mtuka wakuti apakombole kugopolela ciŵecetoco. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.13",
            "verseOrgIds": [
              "1CO.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CO 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naga ngupopela mu yiŵeceto ya cilendo,",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.14",
            "verseOrgIds": [
              "1CO.14.14"
            ]
          }
        },
        {
          "text": " elo nikuti mtima wangu ukupopela, nambo lunda lwangu ngalukupindulapo kandu pelepo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.14",
            "verseOrgIds": [
              "1CO.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CO 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambi ndende uli pelepa? Tinjipopela ni mtima wangu, nambo soni ni lunda lwangu. Tinjijimba ni mtima wangu, nambo soni ni lunda lwangu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.15",
            "verseOrgIds": [
              "1CO.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CO 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naga mkutogolela Mlungu mu mtimape, nambi mundu jumli najo papopojo, mpaka ajiticisye uli kuti, “Ami”",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.16",
            "verseOrgIds": [
              "1CO.14.16"
            ]
          }
        },
        {
          "text": " pa lipopelo lyenu lyakumtogolela Mlungu, citamileco jwalakwejo ali mkakumanyilila yimkuŵeceta m'mwejoyo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.16",
            "verseOrgIds": [
              "1CO.14.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CO 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atamose kuti mumtogolele Mlungu cenenepe, nambo mundu jwinejo ngapindula cilicose ni lipopelo lyenulyo.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.17",
            "verseOrgIds": [
              "1CO.14.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CO 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.17",
            "verseOrgIds": [
              "1CO.14.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CO 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngumtogolela Mlungu kuti une ngusaŵeceta mu yiŵeceto ya cilendo kupunda jemanja wosope. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.18",
            "verseOrgIds": [
              "1CO.14.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CO 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo mu msongano wa mpingo, nganonyele kuŵeceta maloŵe msanope gakupikanika cenene, kuti najiganye ŵandu, kulekangana ni kuti mbecete maloŵe gejinji mu ciŵeceto ca cilendo.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.19",
            "verseOrgIds": [
              "1CO.14.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CO 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.19",
            "verseOrgIds": [
              "1CO.14.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CO 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Acalongo acimjangu, mkaganisyaga mpela ŵanace; pa yicindu yangalumbana mŵeje mpela ŵanace ŵangamanyilila, nambo mu nganisyo syenu, mŵeje ŵakomangale. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.20",
            "verseOrgIds": [
              "1CO.14.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CO 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti yilembedwe m'Malemba, Ambuje akuti,",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.21",
            "verseOrgIds": [
              "1CO.14.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CO 14:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.22",
            "verseOrgIds": [
              "1CO.14.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CO 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sambano naga mpingo wosope ukusongana pampepe, soni wosope naga akutanda kuŵeceta m'ciŵeceto cangamanyika, kaneko mukwinjila ŵandu ŵangamanyika kapena ŵangakulupilila kapena kuti ŵangamanyilila, ana ngasaganisya kuti jemanja mli ŵa masoka? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.23",
            "verseOrgIds": [
              "1CO.14.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CO 14:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo naga wosope akuŵeceta maloŵe gakutyocela kwa Mlungu, nipo mundu jwangakulupilila kapena jwangamanyilila akwinjila, jwalakwejo tacigomecedwa ulemwa",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.24",
            "verseOrgIds": [
              "1CO.14.24"
            ]
          }
        },
        {
          "text": " wakwe pa yosope yene yakuyipikana. Maloŵe gosopego tigacimjinjila mu mtima, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.24",
            "verseOrgIds": [
              "1CO.14.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CO 14:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "nipo yakusisika ya mu mtima mwakwe tiyiciwoneka pakulanguka. Pelepo jwalakwejo tacitindiŵala ni kulola pasi ni kumlambila Mlungu, soni tacijiticisya kuti Mlungu ali sikati ja jemanja.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.25",
            "verseOrgIds": [
              "1CO.14.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yosope yitendekwe mwakulongosoka mu Mpingo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CO 14:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.25",
            "verseOrgIds": [
              "1CO.14.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CO 14:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ana tutende cici sambano, acalongo acimjangu mwa Ambuje? Pandaŵi jimkusongana, jwalijose komboleka kukola nyimbo, kapena lijiganyo lyakuti ajiganye, kandu kane kakwe kele Mlungu amjuwulile, kapena maloŵe gakuti aŵecete m'ciŵeceto ca cilendo, nipo jwine akusosa kugopolela maloŵego. Nambo cakulinga ca yosopeyi ciŵeje kuwulimbisya mpingo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.26",
            "verseOrgIds": [
              "1CO.14.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CO 14:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naga pana jwakusaka kuŵeceta mu ciŵeceto ca cilendo, ŵaŵili kapena ŵatatu aŵecete, nambo ngapelenganya pelepo aŵecete mwakulindililana, nipo mundu jwine agopoleleje maloŵego. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.27",
            "verseOrgIds": [
              "1CO.14.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CO 14:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo naga pangali mundu jwakugopolela maloŵego, jwalakwejo atame jii mu msonganomo, nipo agambe kutama jii agambeje kuŵeceta ni mwa jikape kwa Mlungu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.28",
            "verseOrgIds": [
              "1CO.14.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CO 14:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwamba ya ŵakuŵeceta maloŵe gakutyocela kwa Mlungu, ŵaŵili kapena ŵatatu aŵecete, nipo ŵane wosope alamule pa yakuŵeceta jemanjajo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.29",
            "verseOrgIds": [
              "1CO.14.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CO 14:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo naga Mlungu akujuwula kandu kwa mundu jwine jwali papopo, jwakuŵecetajo aŵe jii. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.30",
            "verseOrgIds": [
              "1CO.14.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CO 14:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jemanja wosope mkukomboleka kuŵeceta maloŵe gakutyocela kwa Mlungu mwakupegana lipesa, kuti wosope alijiganye ni kulimbisidwa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.31",
            "verseOrgIds": [
              "1CO.14.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1CO 14:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵandu ŵakwete mtuka ŵakuŵeceta maloŵe ga Mlungu amanyilile kuwulamulila mtukawo, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.32",
            "verseOrgIds": [
              "1CO.14.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1CO 14:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "ligongo Mlungu ngakusosa cisokonesyo, nambo mwakukamulana ni mwa mtendele.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.33",
            "verseOrgIds": [
              "1CO.14.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1CO 14:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpela muyikusatendecekwela m'mipingo josope ja ŵandu ŵa Mlungu, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.33",
            "verseOrgIds": [
              "1CO.14.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1CO 14:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "acakongwe atame jii m'misongano ja mpingo, pakuti jemanjajo ngakukundidwa kuŵeceta mpela mugakuŵecetela Malamusi ga Mose",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.34",
            "verseOrgIds": [
              "1CO.14.34"
            ]
          }
        },
        {
          "text": " kuti acakongwe aŵeje ŵagamba kupikanila basi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.34",
            "verseOrgIds": [
              "1CO.14.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1CO 14:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naga akwete yiwusyo, akawusye aciŵamkwawo ku nyumba. Pajatu cili cakutesya soni kuti jwamkongwe aŵecete mu msongano wa mpingo.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.35",
            "verseOrgIds": [
              "1CO.14.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1CO 14:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.35",
            "verseOrgIds": [
              "1CO.14.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1CO 14:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ana mpaka tujile kuti maloŵe ga Mlungu gatyocele kwa jemanja? Kapena gayicile kwa jemanja jikape? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.36",
            "verseOrgIds": [
              "1CO.14.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1CO 14:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naga jwine jwakwe akulitenda kuti ali jwakuŵeceta maloŵe ga Mlungu kapena akwete mtuka wa usimu, jwalakwejo akwenela kumanyilila kuti yingumlembela jemanjayi, lili lilamusi lyakutyocela kwa Ambuje. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.37",
            "verseOrgIds": [
              "1CO.14.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1CO 14:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naga mundujo ngakwiticisya yeleyi, nombe nawo ngasamjiticisya jwalakwejo.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.38",
            "verseOrgIds": [
              "1CO.14.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1CO 14:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.38",
            "verseOrgIds": [
              "1CO.14.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1CO 14:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni ligongo lyakwe sambano, acalongo acimjangu, mŵice mitima jenu pakuŵeceta maloŵe gakutyocela kwa Mlungu, soni mkalekasya ŵandu kuŵeceta yiŵeceto ya cilendo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.39",
            "verseOrgIds": [
              "1CO.14.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1CO 14:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yindu yosope yitendekwe mwakulongosoka.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.40",
            "verseOrgIds": [
              "1CO.14.40"
            ]
          }
        }
      ]
    }
