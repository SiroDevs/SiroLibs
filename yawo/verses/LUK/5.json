          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Soni pangali mundu jwakusataga finyo wasambano mu misaku ja mapende gakalakala, ligongo naga akutenda myoyo, finyo wasambanowo tiwuwulisye misakujo, nipo finyowo tiwujasicile pasi, nipo misakujo tijijonasice. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.37",
            "verseOrgIds": [
              "LUK.5.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LUK 5:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo finyo jwasambano jukwenela kutajidwa m'misaku ja sambano. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.38",
            "verseOrgIds": [
              "LUK.5.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LUK 5:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pangali mundu jutamsace finyo jwasambanojo kutendaga jwalakwejo ali amwele kala finyo jwakala, pakuti akusatiji, finyo jwakalajo ni jwakunong'a.”",
          "type": "text",
          "attrs": {
