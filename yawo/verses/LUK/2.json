            "sid": "LUK 2:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Acinangolo ŵakwe piŵam'weni jwalakwejo, ŵasimonjile, nipo mamagwewo ŵamwusisye jwalakwejo kuti, “M'mwe amwanace, ana ligongo cici mtusawisye uwe mwamti myiyi? Une ni baba ŵenu tulasile kumsosasosa.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.48",
            "verseOrgIds": [
              "LUK.2.48"
            ]
          }
        }
      ]
    },
    {
