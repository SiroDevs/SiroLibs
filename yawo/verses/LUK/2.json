          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu ŵapitilisye kukula mwa lunda ni mwamacili, mwakuti Mlungu ni ŵandu ŵakwe ŵamnonyelaga mnope.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.52",
