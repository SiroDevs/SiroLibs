              "type": "text"
            }
          ]
        },
        {
          "text": "mpela mugakuŵecetela malamusi ga Ambuje kuti, “Mwanace jwalijose jwamlume jwakwitiwo, aŵe jwakusaguka jwa Ambuje.”",
          "type": "text",
          "attrs": {
