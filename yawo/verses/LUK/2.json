          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pijakwanile ndaŵi jakuti Maliya ni Yosefe atende msyungu wakuliswejesya pakukuya yigasalaga Malamusi ga Mlungu giŵalembile Mose",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.22",
            "verseOrgIds": [
              "LUK.2.22"
            ]
          }
        },
        {
          "text": " kwambaga yele jwamkongwe akwenela kutenda mwanace ali apagwile, jemanjajo ŵamjigele mwanacejo kwawula najo ku Yelusalemu kuti akatende msyungu ŵakumpeleka kwa Ambuje",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.22",
            "verseOrgIds": [
              "LUK.2.22"
            ]
          }
        },
        {
          "name": "note",
