        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu akupelecedwa ku Nyumba ja AMBUJE",
          "type": "text"
        }
      ]
    },
