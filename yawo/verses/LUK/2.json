          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myoyo Yesu ŵalongene pamo ni acinangolo ŵakwewo, mpaka ŵajile kwika ku Nasaleti, nipo ŵaliji mkwapikanila jemanjajo. Mamagwe Yesu ŵagasalesye maloŵe gosopega mu mtima mwawo. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.51",
            "verseOrgIds": [
              "LUK.2.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
