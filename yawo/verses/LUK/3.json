              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵandu wosope piŵaliji mkubatisidwa, nombe nawo Yesu",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.21",
            "verseOrgIds": [
              "LUK.3.21"
            ]
          }
        },
        {
          "text": " ŵabatisidwe. Kaneko piŵaliji mkupopela, kwinani kwawugwice, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.21",
            "verseOrgIds": [
              "LUK.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
