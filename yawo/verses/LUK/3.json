          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "nipo Msimu Ŵaswela uwawonekaga mpela ngunda watulucile pa jwalakwejo. Lyapikanice liloŵe kutyocela kwinani licitiji, “M'mwejo mli mwanangu jwa pa mtima, ngusasengwa najo mnope.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.22",
