            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.22",
            "verseOrgIds": [
              "LUK.3.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu piŵatandaga masengo gakulalicila, ŵaliji ali akwete yaka ciŵandika makumi gatatu gakupagwa. Ŵandu ŵamganicisyaga kuti jwalakwejo ŵaliji mwanace jwa Yosefe. Nambo liŵasa lyakwe lyatandite kutyocela pa Heli, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.23",
            "verseOrgIds": [
              "LUK.3.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "juŵaliji mwanace jwa Matati, Matati juŵaliji mwanace jwa Lefi, Lefi juŵaliji mwanace jwa Meliki, Meliki juŵaliji mwanace jwa Yanai, Yanai juŵaliji mwanace jwa Yosefe, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.24",
            "verseOrgIds": [
              "LUK.3.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 3:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosefe juŵaliji mwanace jwa Matatiyasi, Matatiyasi juŵaliji mwanace jwa Amosi, Amosi juŵaliji mwanace jwa Nahumu, Nahumu juŵaliji mwanace jwa Hesili, Esili juŵaliji mwanace jwa Nagai, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.25",
            "verseOrgIds": [
              "LUK.3.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 3:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nagai juŵaliji mwanace jwa Maati, Maati juŵaliji mwanace jwa Matatiyasi, Matatiyasi juŵaliji mwanace jwa Semeyini, Semeyini juŵaliji mwanace jwa Yoseki, Yoseki juŵaliji mwanace jwa Yoda, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.26",
            "verseOrgIds": [
              "LUK.3.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 3:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoda juŵaliji mwanace jwa Yowanani, Yowanani juŵaliji mwanace jwa Lesa, Lesa juŵaliji mwanace jwa Selubabele, Selubabele juŵaliji mwanace jwa Salatiyele, Sheyatiyele juŵaliji mwanace jwa Nele, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.27",
            "verseOrgIds": [
              "LUK.3.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 3:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nele juŵaliji mwanace jwa Meliki, Meliki juŵaliji mwanace jwa Adi, Adi juŵaliji mwanace jwa Kosamu, Kosamu juŵaliji mwanace jwa Elimadamu, Elimadamu juŵaliji mwanace jwa Ele, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.28",
            "verseOrgIds": [
              "LUK.3.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 3:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ele juŵaliji mwanace jwa Yoswa, Yoswa juŵaliji mwanace jwa Eliyesa, Eliyesa juŵaliji mwanace jwa Yolimu, Yolimu juŵaliji mwanace jwa Matati, Matati juŵaliji mwanace jwa Lefi, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.29",
            "verseOrgIds": [
              "LUK.3.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 3:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lefi juŵaliji mwanace jwa Simiyoni, Simiyoni juŵaliji mwanace jwa Yuda, Yuda juŵaliji mwanace jwa Yosefe, Yosefe juŵaliji mwanace jwa Yonamu, Yonamu juŵaliji mwanace jwa Eliyakimu, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.30",
            "verseOrgIds": [
              "LUK.3.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 3:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eliyakimu juŵaliji mwanace jwa Meleya, Meleya juŵaliji mwanace jwa Mena, Mena juŵaliji mwanace jwa Matata, Matata juŵaliji mwanace jwa Natani, Natani juŵaliji mwanace jwa Daudi,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.31",
            "verseOrgIds": [
              "LUK.3.31"
            ]
          }
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.31",
            "verseOrgIds": [
              "LUK.3.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 3:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi juŵaliji mwanace jwa Yese, Yese juŵaliji mwanace jwa Obedi, Obedi juŵaliji mwanace jwa Bowasi, Bowasi juŵaliji mwanace jwa Sala, Sala juŵaliji mwanace jwa Nashoni, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.32",
            "verseOrgIds": [
              "LUK.3.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LUK 3:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nasoni juŵaliji mwanace jwa Aminadabu, Abinadabu juŵaliji mwanace jwa Adimini, Adimini juŵaliji mwanace jwa Alini, Alini juŵaliji mwanace jwa Hesiloni, Hesiloni juŵaliji mwanace jwa Pelesi, Pelesi juŵaliji mwanace jwa Yuda, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.33",
            "verseOrgIds": [
              "LUK.3.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LUK 3:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yuda juŵaliji mwanace jwa Yakobo,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.34",
            "verseOrgIds": [
              "LUK.3.34"
            ]
          }
        },
        {
          "text": " Yakobo juŵaliji mwanace jwa Isaki, Isaki juŵaliji mwanace jwa Abulahamu, Abulahamu juŵaliji mwanace jwa Tela, Tela juŵaliji mwanace jwa Naholi, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.34",
            "verseOrgIds": [
              "LUK.3.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 3:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naholi juŵaliji mwanace jwa Selugi, Selugi juŵaliji mwanace jwa Lewu, Lewu juŵaliji mwanace jwa Pelegi, Pelegi juŵaliji mwanace jwa Ebele, Ebele juŵaliji mwanace jwa Sela, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.35",
            "verseOrgIds": [
              "LUK.3.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LUK 3:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sela juŵaliji mwanace jwa Kainani, Kainani juŵaliji mwanace jwa Alifakisadi, Alifakisadi juŵaliji mwanace jwa Shemu, Shemu juŵaliji mwanace jwa Nowa, Nowa juŵaliji mwanace Lameki, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.36",
            "verseOrgIds": [
              "LUK.3.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LUK 3:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lameki juŵaliji mwanace jwa Metusela, Metusela juŵaliji mwanace jwa Enoki, Enoki juŵaliji mwanace jwa Yaledi, Yaledi juŵaliji mwanace jwa Mahalala, Mahalaleli juŵaliji mwanace jwa Kainani, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.37",
            "verseOrgIds": [
              "LUK.3.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LUK 3:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kainani juŵaliji mwanace jwa Enoshi, Enoshi juŵaliji mwanace jwa Seti, Seti juŵaliji mwanace jwa Adamu,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.38",
            "verseOrgIds": [
              "LUK.3.38"
            ]
          }
        },
        {
          "text": " Adamu juŵaliji Mwanace jwa Mlungu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.38",
            "verseOrgIds": [
              "LUK.3.38"
            ]
          }
        }
      ]
