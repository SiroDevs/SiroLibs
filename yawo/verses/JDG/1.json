              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aamoli ŵakanganicisyaga ŵandu ŵa lukosyo lwa Dani kuti atame ku malo ga kwitumbi nipo nganiŵakunda kuti ayice kutulucila kwilambo. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.34",
            "verseOrgIds": [
              "JDG.1.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JDG 1:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aamoli ŵapitilisye kutama ku Aiyaloni, Shalibimu, ni Litumbi lya Helesi, nambo ngosyo sya Efelemu ni Manase syalamulilaga jemanjajo ni kwakanganicisya kuti ŵakamulileje masengo.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.35",
            "verseOrgIds": [
              "JDG.1.35"
            ]
          }
        }
