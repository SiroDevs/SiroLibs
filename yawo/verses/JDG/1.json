              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lukosyo lwa Asha nginiŵatoposya ŵandu ŵiŵatamaga m'misinda ja Ako, Sidoni, Ahilabu, Akisibi, Heliba, Afiki, ni Lehobu. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.31",
            "verseOrgIds": [
              "JDG.1.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JDG 1:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵandu ŵa lukosyo lwa Asha ŵatemi ni acimsyene ŵa cilamboco Akenani, pakuŵa nganiŵatoposya kose.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.32",
