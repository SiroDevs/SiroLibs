          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lukosyo lwa Manase nginiŵatoposya ŵandu ŵakutama m'misinda ja Beti Shani, Tanaki, Doli, Ibuleyamu, Megido, ni matawuni gakuŵandicila, Akenani ŵapitilisye kutamape mwelemo.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.27",
            "verseOrgIds": [
              "JDG.1.27"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
