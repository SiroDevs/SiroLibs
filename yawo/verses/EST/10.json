            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenye Ahasuwelo ŵatandite kukomesya msongo mcilambo mwakwemo ni ku yilumba ya m'nyasa. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.10.1",
            "verseOrgIds": [
              "EST.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EST 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Masengo gosope gakusimonjesya giŵatesile soni ngani ja mwele muŵatendele pakumcimbicisya Modekayi, yilembedwe m'buku ja Mbili ja ayimwene ŵa ku Mediya ni ku Pelesiya. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.10.2",
            "verseOrgIds": [
              "EST.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EST 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Modekayi m'Yuda ŵaliji jwaŵili kwa Mwenye Ahasuwelo. Jwalakwe jwaliji jwamkulungwa nambo soni jwakupikanika sikati ja Ayuda, pakuti ŵakamucisyaga jemanjajo mwa matala gejinji ni kwasosela yambone.",
          "type": "text",
          "attrs": {
            "verseId": "EST.10.3",
            "verseOrgIds": [
              "EST.10.3"
            ]
          }
        }
      ]
