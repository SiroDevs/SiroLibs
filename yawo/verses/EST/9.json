                "loc": "EST.3.7"
              },
              "items": [
                {
                  "text": "Est 3:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.24",
            "verseOrgIds": [
              "EST.9.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EST 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo Esitele ŵajile kwa mwenye, nipo mwenye ŵalamwile kupitila mu cikalata ciŵalembile kuti ciswamba ca Hamani casacileje kwatendela Ayuda, cawujile asyenewo, nambo soni kuti Hamanijo pamo ni ŵanace ŵakwe ŵacalume akolecedwe pa citela. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.25",
            "verseOrgIds": [
              "EST.9.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EST 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ali ni ligongo lyakwe masiku gelega akusagakolangaga kuti Pulimu. Ligongo lya yosope yiyalembedwe mcikalatamo, nambo soni ligongo lya yiŵawonecele jemanjajo. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.26",
            "verseOrgIds": [
              "EST.9.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EST 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayudawo ŵalipanganyicisye acimsyene lilamusi, ni kwa yisukulu yawo, ni jwalijose juŵaŵele m'Yuda, kuti wosope akalepelega kugakumbucila masiku gaŵiliga, pakukuya yiyalembedwe mcikalata ca Modekayi cila soni ndaŵi jakwe jakutenda yeleyi caka ni caka. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.27",
            "verseOrgIds": [
              "EST.9.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EST 9:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Masiku gelega gakumbucilidweje ni mipago josope m'maŵasa gosope ga Ayuda, mcilambo cilicose ni mu msinda uliwose. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.28",
            "verseOrgIds": [
              "EST.9.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EST 9:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaneko Esitele mwanace jwamkongwe jwa Abihayilo pamo ni m'Yuda jula Modekayi nombe nawo ŵalembile cikalata cine ni ulamusi wosope kuti asimicisye pa ya cikalata caŵili cicasalaga ya Pulimu. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.29",
            "verseOrgIds": [
              "EST.9.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EST 9:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yikalatayo ŵayitumisye kwa Ayuda wosope ku madela gosope 127 ga cilambo ca Mwenye Ahasuwelo. Yikalatayo yasalaga ya mtendele ni kulupicika, ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.30",
            "verseOrgIds": [
              "EST.9.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EST 9:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuti masiku ga Pulimu gakumbucilidweje mu ndaŵi jakwe, pakukuya yiŵaŵecete Modekayi ni Esitele ŵamkwawo mwenye ya kwalamula Ayuda. Agakumbucileje masiku gelega pakukuya malamusi giŵaliŵicile acimsyene ni yisukulu yawo, gakwamba kulijima kulya",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.31",
            "verseOrgIds": [
              "EST.9.31"
            ]
          }
        },
        {
          "text": " ni kulila kwawo. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.31",
            "verseOrgIds": [
              "EST.9.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EST 9:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lilamusi lya Esitele ŵamkwawo mwenye, ni lilyasimicisye ya Pulimu, nipo lyalembedwe m'buku.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.32",
            "verseOrgIds": [
              "EST.9.32"
            ]
          }
        }
      ]
