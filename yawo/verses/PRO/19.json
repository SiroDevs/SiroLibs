        },
        {
          "text": "Mumjamuce mwanagwenu cembeceyo cili cipali mwanacejo mkanakule, soni mkanapelenganye konasika; mkakola mtima wakusaka kumjonanga mwanagwenu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.18",
            "verseOrgIds": [
              "PRO.19.18"
            ]
          }
        }
      ]
    },
    {
