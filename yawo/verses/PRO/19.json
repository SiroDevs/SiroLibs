          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumtimbe mundu jwa mwano, kuti yisilu yine yipatilepo lunda, naga mkumjamuka mundu jwakupikanicisya cenene yindu, jwalakwe tacipata lunda.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.25",
            "verseOrgIds": [
              "PRO.19.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "PRO 19:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.25",
            "verseOrgIds": [
              "PRO.19.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "PRO 19:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundu jwakusatenda ndewo ni babagwe soni kwatopola mamagwe, ali mwanace jwakutesya soni nambo soni jwakutesya ucimbicimbi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.26",
            "verseOrgIds": [
              "PRO.19.26"
            ]
          }
        }
      ]
    },
    {
