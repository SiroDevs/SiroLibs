            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "PRO 19:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanangu, naga mkuleka kugapikanila malamusi, ni kuti msokonecele ni kulilekanganya ni lunda.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.27",
            "verseOrgIds": [
              "PRO.19.27"
            ]
          }
        }
      ]
    },
    {
