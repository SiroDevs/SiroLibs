          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵandu ŵane ali ŵaulesi wakulepelaga atamose kunyakula mbamu jose kuti aŵice pakamwa pawo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.24",
            "verseOrgIds": [
              "PRO.19.24"
            ]
          }
        }
      ]
    },
    {
