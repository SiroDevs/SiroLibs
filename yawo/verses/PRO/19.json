          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanace jwakuloŵela akusaŵa likungu kwa babagwe, soni jwamkongwe jwakuŵecetaŵeceta akusapesya mpela ula ja kawombe.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.13",
            "verseOrgIds": [
              "PRO.19.13"
            ]
          }
        }
      ]
    },
    {
