              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.28",
            "verseOrgIds": [
              "PRO.19.28"
            ]
          }
        },
        {
