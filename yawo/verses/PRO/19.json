          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyumba ni yipanje komboleka kupata mundu kutyocela kwa acinangolo, nambo jwamkongwe jwalunda akusatyocela kwa AMBUJE.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.14",
            "verseOrgIds": [
              "PRO.19.14"
            ]
          }
        }
      ]
