          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutumbila kwa mwenye kuli mpela kutwamula kwa lisimba, nambo kusalala mtima kwawo kuli mpela mangame pa manyasi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.12",
            "verseOrgIds": [
              "PRO.19.12"
            ]
          }
        }
      ]
    },
    {
