          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundu jwakusagapikanila malamusi akusalisunjila umi wakwe, nambo mundu jwangakusamalila matala gakwe taciwa nditu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.16",
