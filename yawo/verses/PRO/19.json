          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "PRO 19:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwajogopa AMBUJE kukusapeleka umi, soni jwakusajogopajo akusaŵa pambone.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.23",
            "verseOrgIds": [
              "PRO.19.23"
            ]
          }
        }
