          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yilinganyidwe kalape kuti ŵandu ŵakusakala gawujile magambo, soni cikoti cakuputila pa mgongo pa ŵandu ŵakuloŵela cili cile.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.29",
            "verseOrgIds": [
              "PRO.19.29"
            ]
          }
        }
