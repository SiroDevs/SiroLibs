          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "PRO 19:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.22",
            "verseOrgIds": [
