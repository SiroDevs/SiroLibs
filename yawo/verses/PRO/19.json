          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "PRO 19:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mboni ja unami jikusanyosya cilungamo, pakamwa pa ŵandu ŵakusakala pakusawucisya cindu cakusakala.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.28",
            "verseOrgIds": [
              "PRO.19.28"
            ]
          }
        }
      ]
    },
