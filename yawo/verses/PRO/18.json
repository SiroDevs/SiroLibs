          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maloŵe ga lunda gakukopoka mkamwa mwa mundu gali mpela nyasa jakusokoka, Uliŵa wa lunda uli mpela lusulo lwegumbale lwakuwutuka mesi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.4",
            "verseOrgIds": [
              "PRO.18.4"
            ]
          }
        }
