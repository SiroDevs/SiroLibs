          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cisilu cikusalijonanga cisyene ni pakamwa pakwe, cikusakamulwa pakulitega ni maloŵe gakwe msyenejo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.7",
            "verseOrgIds": [
              "PRO.18.7"
            ]
          }
        }
      ]
    },
    {
