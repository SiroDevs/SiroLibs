          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cipanje ca mundu jwakusicila cili mpela msinda wakwe, cili mpela cida cakumcinjilicisya ku yisawusyo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.11",
            "verseOrgIds": [
              "PRO.18.11"
