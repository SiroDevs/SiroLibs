              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundu jwakusalityosya mwikuga lya cimjakwe akusaŵa jwakulinonyela, akusagambaga kukuya yakumnonyela jwalakwe jika.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.1",
            "verseOrgIds": [
              "PRO.18.1"
            ]
          }
        }
      ]
    },
    {
