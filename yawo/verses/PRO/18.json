          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nganiciŵa cindu cambone kutenda lusagu pakunonyelesya magambo ga mundu jwakusakala, kapena kuwunicila meso melepe kumtendela ngalwe mundu jwambone.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.5",
            "verseOrgIds": [
              "PRO.18.5"
            ]
          }
        }
      ]
    },
    {
