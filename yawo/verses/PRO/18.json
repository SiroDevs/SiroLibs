              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mtima wa mundu jwakalamuka cenene ukusaŵa cile kusosa kulijiganya yejinji, mapikanilo ga mundu jwalunda gakusasosa kupikanicisya kuti gapate umanyilisi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.15",
            "verseOrgIds": [
              "PRO.18.15"
            ]
          }
        }
