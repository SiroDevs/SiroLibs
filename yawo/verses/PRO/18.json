          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mtima wa mundu komboleka kupilila cilwele, nambo pati ajasile mtima, nduni jwampaka apakombole kuwulimbikasya?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.14",
            "verseOrgIds": [
              "PRO.18.14"
            ]
          }
        }
      ]
