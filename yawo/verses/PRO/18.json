          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundu mkanagwe, akusatanda kola mtima wakanika ni wakulikwesya, nambo ucimbicimbi ukusayika panyuma pakulinondiya.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.12",
            "verseOrgIds": [
              "PRO.18.12"
            ]
          }
        }
