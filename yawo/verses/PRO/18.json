          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maloŵe ga mundu jwa mabosa gakusaŵa gakunong'a kupunda cine cilicose, ŵandu ŵajinji akusanonyela kugamila gosope myuu mwangasawusya.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.8",
            "verseOrgIds": [
              "PRO.18.8"
