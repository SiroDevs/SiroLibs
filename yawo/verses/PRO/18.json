          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundu jwakusajanguyaga kwanga ngani mkanapikanicisye, akusaloŵela ni kulitesya soni msyene jika.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.13",
            "verseOrgIds": [
              "PRO.18.13"
