              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mtuka wa mundu ukusamwugulila litala jwali jwakupelekajo, ukusakomboleka kumŵandikanya ni acakulungwakulungwa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.16",
            "verseOrgIds": [
