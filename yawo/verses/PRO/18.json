          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lina lya AMBUJE",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.10",
            "verseOrgIds": [
              "PRO.18.10"
            ]
          }
        },
        {
          "text": " lili mpela sanja jakulimbangana mnope, mundu jwakulungama akusatilila kweleko ni kulupuka.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.10",
            "verseOrgIds": [
              "PRO.18.10"
            ]
          }
        }
      ]
    },
    {
