              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵandu ŵakusakala mtima AMBUJE akusiŵanyalaya, nambo ŵandu ŵa ndamo jambone akusiŵasangalasyaga AMBUJE.",
          "type": "text",
          "attrs": {
