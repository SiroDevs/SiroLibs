              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cisogosi ca ŵakulungama cili citela ca umi, soni mundu jwakwete luŵilango lwakujipitikusya mitima ja ŵandu, jwana lunda.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.30",
