              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yisyene nditu, ŵandu ŵakusakala ngisicakulusya cilango ca Mlungu, nambo ŵandu ŵali ŵa cilungamo tacikulupuka.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.21",
