              "items": [
                {
                  "text": "1 Pet 5:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.34",
            "verseOrgIds": [
              "PRO.3.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
