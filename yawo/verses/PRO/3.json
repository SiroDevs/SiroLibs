          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Msyungu kwa ŵanace",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanangu, mkaliŵalila majiganyo gangu, nambo mgasunje malamusi gangu mu mtima mwenu. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.1",
            "verseOrgIds": [
              "PRO.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti naga mkutenda yeleyi, masiku ni yaka ya umi ŵenu tiyicitupa, soni timcitama ni umi wambone mnope. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.2",
            "verseOrgIds": [
              "PRO.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndamo ja kulipeleka ni kulupicika kasimkunda kuti yimtyocele, ndamo syelesi mjendeje nasyo mpela yila mwakusamtendelaga ni cuma ca pa lukosi lwenu. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.3",
            "verseOrgIds": [
              "PRO.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naga mkuyitenda yeleyi, Mlungu ni ŵandu taciŵa ŵakusangalala namwe soni timcikola mbili jambone.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.4",
            "verseOrgIds": [
              "PRO.3.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.2.52"
              },
              "items": [
                {
                  "text": "Luk 2:52",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.4",
            "verseOrgIds": [
              "PRO.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwakulupilileje AMBUJE ni mtima wenu wosope, mkasimgambaga kulupilila pa lunda lwenupe mciganisyaga kuti mkusamanyilila. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.5",
            "verseOrgIds": [
              "PRO.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myindu yosope yamkusitenda, mkumbucileje kwiticisya kuti kusa kuno kwana Mlungu, jwalakwejo ni jutacigagolosya matala genu. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.6",
            "verseOrgIds": [
              "PRO.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkasimganisyaga mwasyene kuti mli ŵalunda kupundanganya ni mumŵelele, mwajogopeje AMBUJE",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.7",
            "verseOrgIds": [
              "PRO.3.7"
            ]
          }
        },
        {
          "text": " soni myiŵambaleje yindu yakusakala, ngayitenda.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.7",
            "verseOrgIds": [
              "PRO.3.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.12.16"
              },
              "items": [
                {
                  "text": "Alo 12:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.7",
            "verseOrgIds": [
              "PRO.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naga mkutenda yeleyi, timciŵa mpela mtela wambone wakuposya ni kupeleka umi wambone ku cilu cenu nambo soni kutyosya kupweteka ni kulimbikasya mawupa genu. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.8",
            "verseOrgIds": [
              "PRO.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwacimbicisyeje AMBUJE ni yipanje yenu soni ni yisogosi yandanda kugowola mu mgunda mwenu yosope. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.9",
            "verseOrgIds": [
              "PRO.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naga mkuyitenda yeleyi, ngokwe syenu tisicigumbala ni yindu yejinji, nambo soni timcikola finyo jwejinji jwakusoŵa pakutaga. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.10",
            "verseOrgIds": [
              "PRO.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanangu, mkasimcinyosya cilango ca AMBUJE, soni mkapela ni camuko cakwe.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.11",
            "verseOrgIds": [
              "PRO.3.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.5.17"
              },
              "items": [
                {
                  "text": "Yob 5:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.12.5+HEB.12.6"
              },
              "items": [
                {
                  "text": "Aheb 12:5-6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.11",
            "verseOrgIds": [
              "PRO.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuŵa AMBUJE akusamwunda mundu jwele jwakusamnonyela, mpela mwakusatendela baba pakumwunda mwanagwawo jwakusamnonyela.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.12",
            "verseOrgIds": [
              "PRO.3.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.3.19"
              },
              "items": [
                {
                  "text": "Ciw 3:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.12",
            "verseOrgIds": [
              "PRO.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwana upile mundu jwapatile lunda, jwapatile lunda lwakupakombola kupikanicisya cenene yindu. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.13",
            "verseOrgIds": [
              "PRO.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuŵa mbote ja lunda jili jakupunda mbote ja silifa,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.14",
            "verseOrgIds": [
              "PRO.3.14"
            ]
          }
        },
        {
          "text": " soni jili jakupindulisya mnope kwenumwe kupunda golidi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.14",
            "verseOrgIds": [
              "PRO.3.14"
            ]
          }
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.14",
            "verseOrgIds": [
              "PRO.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lunda luli lwakupunda maganga ga mtengo wa penani, pangali cindu cakucikumbila m'mwejo cakulandana ni lunda. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.15",
            "verseOrgIds": [
              "PRO.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lunda lukusapeleka umi welewu, nambo soni cipanje ni ucimbicimbi. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.16",
            "verseOrgIds": [
              "PRO.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PRO 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lunda lukusamlongolela m'matala gakusangalasya, ni kumjendesya mu mtendelepe basi. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.17",
            "verseOrgIds": [
              "PRO.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PRO 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lunda luli mpela citela cakupeleka umi kwa ŵandu ŵakusalukamulisya masengo. Ŵana upile ŵele ŵakusalukamulisya masengo mnope lundalo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.18",
            "verseOrgIds": [
              "PRO.3.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PRO 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.20",
            "verseOrgIds": [
              "PRO.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "PRO 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanangu, mlusunje lunda lusyesyene nambo soni ndamo jenu jwakupakombola ganicisya cenenepe ya kusogolo. Mkakunda kuti yele yindu yiŵiliyi yimtile. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.21",
            "verseOrgIds": [
              "PRO.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "PRO 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeleyi tiyicimpa umi, tiyicimpa umi wakusangalasya ni wakondwa. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.22",
            "verseOrgIds": [
              "PRO.3.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "PRO 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pelepo timcijenda mwitala lyenu mwangajogopa soni ngasimkuŵala kose. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.23",
            "verseOrgIds": [
              "PRO.3.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "PRO 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndaŵi jimkutama pasi, ngasimtenda woga; pa ndaŵi jimkuja kukugona, timcigona lugono lwakunong'a. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.24",
            "verseOrgIds": [
              "PRO.3.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "PRO 3:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkasimjogopaga yindu yakogoya yakwika mwacisisimucila, atamose yakusakala yayikusiyayicilila ŵandu ŵakusakala, mkasimtendaga nayo woga. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.25",
            "verseOrgIds": [
              "PRO.3.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "PRO 3:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti AMBUJE ni ŵitacimlimbikasya m'mwejo, soni taciliŵambasya lusajo lwenu kuti lukatanjila.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.26",
            "verseOrgIds": [
              "PRO.3.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "PRO 3:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.26",
            "verseOrgIds": [
              "PRO.3.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "PRO 3:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkasimleka kwatendela yambone ŵele ŵali ŵakuŵajilwa kupocela yambone, pa ndaŵi jimkwete macili gakuti mpaka mpakombole kuyitenda yeleyi. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.27",
            "verseOrgIds": [
              "PRO.3.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "PRO 3:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkasimumsalila mjenu kuti, “Pepani, mkawuje soni malaŵi tinjimpa” nambo kutendaga pa jele ndaŵijo ni mli mkwete yindu yakuti nikumkamucisya nayo mjenujo. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.28",
            "verseOrgIds": [
              "PRO.3.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "PRO 3:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkasimumtendelaga wiwu pane malindi mnasi jwenu jwakusatama ciŵandika mwakumkulupilila m'mwejo. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.29",
            "verseOrgIds": [
              "PRO.3.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "PRO 3:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkasimkangana ni mundu pangali ligongo, pali pangali cakusakala cilicose camtendele m'mwejo. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.30",
            "verseOrgIds": [
              "PRO.3.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "PRO 3:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkasimlagaga najo mu mtima mwenu mundu jwa ciwawa, soni kasimlinga kujigalila ndamo syakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.31",
            "verseOrgIds": [
              "PRO.3.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "PRO 3:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ligongo AMBUJE akusaŵengana ni mundu jwakusakala, nambo ŵandu ŵakulungama akusiŵaŵika m'likuga lya ŵandu ŵakwe ŵakusiŵakulupilila. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.32",
            "verseOrgIds": [
              "PRO.3.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "PRO 3:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "AMBUJE akusalwesa nyumba ja ŵandu ŵakusakala, nambo akusapeleka upile malo gakutama ŵandu ŵakulungama. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.33",
            "verseOrgIds": [
              "PRO.3.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "PRO 3:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwalakwe akusiŵanyosya ŵandu ŵakunyosya, nambo ŵandu ŵakulitulusya, akusiŵasalalila mtima.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.34",
            "verseOrgIds": [
              "PRO.3.34"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
