          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵandu ŵalunda tacipocela ucimbicimbi, nambo yisilu taciyitesya soni.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.35",
            "verseOrgIds": [
