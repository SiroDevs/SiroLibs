          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundu jwakusaŵeceta yakuwona, ngakusapeleka umboni wa unami, nambo mboni ja unami jikusaŵeceta ya unami.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.17",
            "verseOrgIds": [
              "PRO.12.17"
            ]
          }
        }
      ]
