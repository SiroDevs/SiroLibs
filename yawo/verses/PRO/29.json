          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundu jwakwanguya kutumbila akusatandisya njojo, mundu jwakusagamba kalipakalipa akusalemwa yejinji.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.22",
            "verseOrgIds": [
              "PRO.29.22"
            ]
