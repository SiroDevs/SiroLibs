              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵandu ŵangali cilungamo akusaŵengana ni ŵandu ŵambone, myoyo soni nombe ŵandu ŵambone akusaŵengana ni ŵandu ŵangalumbana.",
          "type": "text",
