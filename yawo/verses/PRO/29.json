          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naga mwenye akwalamula ŵandu ŵakulaga mwangali lusagu, ucimwene wakwe tiwucitamilicika mpaka kalakala.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.14",
            "verseOrgIds": [
              "PRO.29.14"
            ]
          }
        }
      ]
    },
    {
