          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumjogopa mundu kuli mpela kulitaŵa ukapolo, nambo mundu jwakwakulupilila AMBUJE akusaŵa pambone soni jwagopoka.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.25",
            "verseOrgIds": [
              "PRO.29.25"
