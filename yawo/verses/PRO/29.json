          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundu jwakwenda ni mundu jwawiyi, akuŵengana ni umi wakwe, akusakupikana kulwesa nambo ngakusalumukula cilicose.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.24",
            "verseOrgIds": [
              "PRO.29.24"
