          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kupoka kwa mundu tikucimgwisya, nambo mundu jwakulitulusya tacipocela ucimbicimbi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.23",
            "verseOrgIds": [
              "PRO.29.23"
