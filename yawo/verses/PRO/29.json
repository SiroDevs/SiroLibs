          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ana mum'weni mundu jwakwanguya kuŵeceta mkanaganicisye cenene, atamose cisiluco bola kuŵa mkola cembeceyo kulekangana ni jwele mundujo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.20",
            "verseOrgIds": [
              "PRO.29.20"
            ]
          }
        }
