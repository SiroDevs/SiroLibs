          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundu jwakusamlela kapolo jwakwe mwa mtendele kutandila kuwanace wakwe, pambesi pakwe tacisimana kuti kapolojo asyucile kuŵa jwakwinjila m'malo mwakwe kujigala cipanje cakwe cosope.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.21",
            "verseOrgIds": [
              "PRO.29.21"
