        },
        {
          "text": "Cilambo cangali nganisyo sya kulola yakusogolo mwakulongoleledwa ni Mlungu, cikusaŵa cilambo cangali bata ni mtendele pakuti ŵandu ŵakwe akusaŵa ŵangapikana ya ŵane.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.18",
            "verseOrgIds": [
              "PRO.29.18"
            ]
          }
        }
      ]
    },
