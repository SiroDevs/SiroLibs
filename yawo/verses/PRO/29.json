        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.13",
            "verseOrgIds": [
              "PRO.29.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
