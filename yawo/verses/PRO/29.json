          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumwundeje mwanagwenu, atamose ni cikoti, ni tacimpa mtendele mu mtima wenu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.17",
            "verseOrgIds": [
