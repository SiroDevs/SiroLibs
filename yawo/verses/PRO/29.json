          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵandu ŵajinji akusasaka kuti jwakulamula ŵasalalile mtima, nambo kutyocela kwa AMBUJE jikape basi ni kwampaka mundu asimane kulamula kwa cilungamo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.26",
            "verseOrgIds": [
              "PRO.29.26"
            ]
