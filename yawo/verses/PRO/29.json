          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundu jwakutumicila ngakusapikana kumwunda ni maloŵepe basi, pakuti atamose agapikanicisye maloŵego, ngakusagakosya.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.19",
            "verseOrgIds": [
              "PRO.29.19"
            ]
          }
