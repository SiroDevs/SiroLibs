              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundu jwangapya mtima mwacitema, akusapikanicisya yindu mnope, nambo mundu jwakwanguya kupya mtima akusalosya usilu wakwe wosope.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.29",
