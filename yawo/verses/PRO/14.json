              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cilungamo cikusakwesya mtundu wa ŵandu, nambo ulemwa ukusatesya soni ku mtundu uliwose.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.34",
            "verseOrgIds": [
              "PRO.14.34"
            ]
          }
        }
