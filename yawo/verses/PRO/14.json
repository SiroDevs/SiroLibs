              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwakwenda mwagoloka mtima akusamjogopa AMBUJE, nambo jwakwenda mwa unami akusamnyosya jwalakwejo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.2",
            "verseOrgIds": [
