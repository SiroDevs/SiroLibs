          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lunda lwa mundu jwakalamuka lugonile paganicisya cenene matala gakwe, nambo yisilu yikusaliloŵesya yisyene ni usilu wawo.",
          "type": "text",
          "attrs": {
