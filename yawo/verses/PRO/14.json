              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵandu ŵakusakala tacalamucila ŵandu ŵambone, ŵandu ŵakusakalawo tacitenda cikamucisyo kwa ŵandu ŵambone.",
