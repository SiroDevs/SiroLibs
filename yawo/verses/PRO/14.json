          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbote ja ŵandu ŵalunda ni lunda lwawo pelo, nambo ŵandu ŵakuloŵela malipilo gawo ni kuloŵela kwawo peko.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.24",
