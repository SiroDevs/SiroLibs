          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yisilu ngayikusakosya kuti yipesye ulemwa wawo, lisosa lyambone likusapatikanaga mwa ŵandu ŵakulungama basi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.9",
