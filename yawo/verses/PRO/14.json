          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwajogopa AMBUJE uli uliŵa usyesyene wa umi wa mundu, kukusakuŵambasya ku yitega ya ciwa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.27",
            "verseOrgIds": [
