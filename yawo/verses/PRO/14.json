          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mboni jakulupicika jikusijakulupusya ŵandu, nambo mboni ja unami jikusijawulagasya ŵandu.",
          "type": "text",
          "attrs": {
