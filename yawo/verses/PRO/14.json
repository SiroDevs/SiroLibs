          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mtima wambone ukusapeleka umi wambone ku cilu ca mundu, nambo wiwu ukusawosya mawupa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.30",
            "verseOrgIds": [
              "PRO.14.30"
            ]
          }
        }
