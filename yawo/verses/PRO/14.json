              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵandu ŵakuloŵela kwawo ni kuloŵela, nambo ŵandu ŵakalamuka jawo ni mbote jakumanyilila yindu.",
          "type": "text",
          "attrs": {
