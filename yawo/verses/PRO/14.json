              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mtima ukusamanyilila usyenepe yakupweteka yakwe, soni pangali jwine jwampaka amanyilile lukondwa lwakwe.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.10",
