          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Citipwindi ca ŵandu ni ucimbicimbi wa mcimwene, nambo naga ŵandu ali mkinapagwa, ucimwene ukusajonasika.",
          "type": "text",
