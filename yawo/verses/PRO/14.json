          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwakuli kwangali ng'ombe kukusaŵa soni kwangali macinga, nambo kusili ng'ombe syamacili kukusapagwaga soni yakulya yejinji.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.4",
            "verseOrgIds": [
              "PRO.14.4"
            ]
          }
        }
