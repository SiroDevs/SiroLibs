              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lunda lukusaŵaga m'mitima ja ŵandu ŵakusapikanicisyaga cenene yindu, nambo m'mitima ja yisilu ngalukusamanyika kose.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.33",
            "verseOrgIds": [
              "PRO.14.33"
            ]
          }
        }
