              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundu jwakwajogopa AMBUJE",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.26",
            "verseOrgIds": [
              "PRO.14.26"
            ]
          }
        },
        {
          "text": " jwana cikulupi ca macili, soni ŵanace ŵakwe tacikola pakutilila.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.26",
            "verseOrgIds": [
