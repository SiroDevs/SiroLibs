              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenye akusakondwa ni ndumetume jajikusatenda yindu mwa lunda, nambo jikusamtumbilila mundu jwakusatenda yindu mwakutesya soni.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.35",
