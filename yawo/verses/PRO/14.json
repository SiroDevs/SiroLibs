          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuŵeceta kwa cisilu kukusaliŵilanjila simbo pa mgongo pakwe, nambo maloŵe ga mundu jwalunda gakusamcinga ku yisawusyo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.3",
            "verseOrgIds": [
              "PRO.14.3"
            ]
          }
        }
      ]
    },
    {
