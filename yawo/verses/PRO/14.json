              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵandu ŵakutenda yakusakala akusiŵagwisya, nambo ŵandu ŵakutenda yambone akusacenjeledwa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.32",
            "verseOrgIds": [
              "PRO.14.32"
            ]
