          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwakwanyosya acimjakwe akusalusosasosa lunda ngalupata kose, nambo mundu jwakupikanicisya cenene yindu akusayimanyilila yindu mwacitema.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.6",
            "verseOrgIds": [
              "PRO.14.6"
            ]
