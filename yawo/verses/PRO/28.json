              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundu jwakusajenda mwakulupicika tacikulupuka, nambo mundu jwangatenda mwagoloka tacigwa mwisimbo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.18",
