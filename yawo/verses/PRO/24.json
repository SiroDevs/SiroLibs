              },
              "items": [
                {
                  "text": "Mis 6:10-11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.33",
            "verseOrgIds": [
              "PRO.24.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "PRO 24:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ulanda tiwucimsimana mpela jwawiyi, soni kulaga tikucimsawusya mpela jwaciswamba.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.34",
