{
  "id": "PRO.6",
  "number": "6",
  "bookId": "PRO",
  "reference": "Mis 6",
  "verseCount": 32,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
        "style": "c",
        "sid": "PRO 6"
      },
      "items": [
        {
          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kasimŵa ŵakuloŵela",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanangu, naga mtesile cilanga",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.1",
            "verseOrgIds": [
              "PRO.6.1"
            ]
          }
        },
        {
          "text": " cakumlipilila mjenu ngongole, naga mlangene yakuti timumlipilile mlendo ngongole jakwe; ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.1",
            "verseOrgIds": [
              "PRO.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "mlitanjisye ni maloŵe ga pakamwa penu, mkamwilwe ni maloŵe ga mkamwa mwenu. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.2",
            "verseOrgIds": [
              "PRO.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sambano pakuti mlipelecele kala m'myala mwa jwele mundujo, mtende ayi mwanangu kuti mlikulupusye mwasyene, mjawule mwakulinandiya kwa mjenujo ni mkamdandawulile kuti amgopole. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.3",
            "verseOrgIds": [
              "PRO.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasimkunda meso genu gona lugono, kapena kwikunda gwesela yikoloŵa yenu. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.4",
            "verseOrgIds": [
              "PRO.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mlikulupusye mwasyene mpela mujikusalikulupucisya ndandala kwa jwakusakula nyama, mpela mukucisalikulupucisya cijuni kwa ŵakusakula. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.5",
            "verseOrgIds": [
              "PRO.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mjawule mkajilole mbamba, m'mwe waulesi; mkalolecesye ni kulijiganya ndamo jakwe kuti mpate lunda. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.6",
            "verseOrgIds": [
              "PRO.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nganijikola mwenye, nganijikola soni kapitawo atamose jwakulamula. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.7",
            "verseOrgIds": [
              "PRO.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo jikusalinganyicisya cile yakulya yakwe m'cawu, soni jikusalisonganyicisya yakulya yakweyo ndaŵi ja masika. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.8",
            "verseOrgIds": [
              "PRO.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ana timŵe mli cigonele pelepo mpaka cakaci, m'mwe ŵaulesi? Ana timjimuce cakaci ku lugono lwenu? ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.9",
            "verseOrgIds": [
              "PRO.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamkuti, “Ngambe gona panandipe, kwamba gwesela panandi, ngaŵa camnope.”",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.10",
            "verseOrgIds": [
              "PRO.6.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.24.33+PRO.24.34"
              },
              "items": [
                {
                  "text": "Mis 24:33-34",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.10",
            "verseOrgIds": [
              "PRO.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pelepo ulanda tiwucimsimana mpela mundu jwaciswamba.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.11",
            "verseOrgIds": [
              "PRO.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.11",
            "verseOrgIds": [
              "PRO.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundu jwacabecabe, mundu jwakusakala, akusagambaga kwendajenda apa napopo kuja mkwenesya ya unami basi. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.12",
            "verseOrgIds": [
              "PRO.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akusaŵeceta ni makono gakwe ali mkusisinila soni kupalapasa pasi ni makawu gakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.13",
            "verseOrgIds": [
              "PRO.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndaŵi syosope akusagambaga ganicisya yakusakala basi mu mtima wakwe wakusakala. Akusagambaga kutamila kuwatanganya ngani pasikati pa ŵandu. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.14",
            "verseOrgIds": [
              "PRO.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ligongo lya yeleyi, likungu tilicimsimana mwacisisimucila, mwangacelewasya pa ndaŵi jamnono, timcijonanjidwa, ngasimkulupuka kose.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.15",
            "verseOrgIds": [
              "PRO.6.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.15",
            "verseOrgIds": [
              "PRO.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yipali yindu msano ni cimo yele AMBUJE akusaŵengana nayo, kusyesyene yindu msano ni yiŵili yikusamsakalisya kwabasi;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.16+PRO.6.17+PRO.6.18+PRO.6.19",
            "verseOrgIds": [
              "PRO.6.16",
              "PRO.6.17",
              "PRO.6.18",
              "PRO.6.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Akwakalamusya yakwamba cikululu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.16+PRO.6.17+PRO.6.18+PRO.6.19",
            "verseOrgIds": [
              "PRO.6.16",
              "PRO.6.17",
              "PRO.6.18",
              "PRO.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PRO 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanangu, mgasunjeje malamusi ga baba ŵenu, soni kasimliŵalila yiŵamjiganyisye mama ŵenu. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.20",
            "verseOrgIds": [
              "PRO.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "PRO 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeleyi myitaŵe mu mtima mwenu ngayijasa kose, yiŵe ni m'mwejo citaŵile pa lukosi lwenu, ngayiliŵalila. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.21",
            "verseOrgIds": [
              "PRO.6.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "PRO 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakwenda pa ulendo, tiyicimlongolela kumlosya litala; pamkugona, tiyicimlondela, soni pamkwimuka tiyiciŵeceta namwe kumpa lunda. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.22",
            "verseOrgIds": [
              "PRO.6.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "PRO 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti malamusi gali mpela nyali, nombe nago soni majiganyo gali mpela lilanguka; Soni camuko ca msyungu ni ndamo jisyesyene pa umi wa mundu. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.23",
            "verseOrgIds": [
              "PRO.6.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "PRO 6:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeleyi tiyicimkulupusya kwa jwamkongwe jwakusakala, tiyicimkamucisya kuti mkajigalika ni maloŵe ga kuŵeŵa ga jwamkongwe jwa cikululu. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.24",
            "verseOrgIds": [
              "PRO.6.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "PRO 6:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasimkumbilaga kusalala kwakwe mu mtima mwenu, kasimjigalika nago meso gakwe gakombola kunyenjelela. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.25",
            "verseOrgIds": [
              "PRO.6.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "PRO 6:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti jwamkongwe jwacikululu akukomboleceka kusumidwa ni mkate, nambo jwamkongwe jwacijama jwamlombele akusakusumula umi wakwe wene. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.26",
            "verseOrgIds": [
              "PRO.6.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "PRO 6:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ana mundu mpaka awumbate moto, yakuwala yakwe ni ngapya? ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.27",
            "verseOrgIds": [
              "PRO.6.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "PRO 6:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kapena mpaka mliŵate makala ga moto, sajo syenu ni ngapya? ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.28",
            "verseOrgIds": [
              "PRO.6.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "PRO 6:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yalumo soni kwa jwele mundu jwakusajinjila mwa ŵakongwe ŵasyene. Jwalijose jwakumkwaya jwele jwamkongwejo, tacilaga, ngasakulupuka kose ku cilango. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.29",
            "verseOrgIds": [
              "PRO.6.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "PRO 6:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵandu ngakusamnyosya jwawiyi jwakusajiŵa ligongo lyakuti jimkwete sala. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.30",
            "verseOrgIds": [
              "PRO.6.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "PRO 6:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambope naga jwawiyijo akamwilwe, akusalipaga kasano ni kaŵili; mpaka kusumulwa cipanje cosope ca m'nyumba jakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.31",
            "verseOrgIds": [
              "PRO.6.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "PRO 6:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundu jwakusatenda cikululu jwangali lunda pakuti akusagamba kulijonanga msyene. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.32",
            "verseOrgIds": [
              "PRO.6.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "PRO 6:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akusagamba kuputwa ni kunyosyedwa; soni syakwe ngasisimtyoka kose mpaka kalakala. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.33",
            "verseOrgIds": [
