        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kukusaŵa kwakusimonjesya kuti cisilu ciŵecete yambone, myoyo soni kuti ngomo sya mwenye siŵe sya unami.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.7",
            "verseOrgIds": [
              "PRO.17.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
