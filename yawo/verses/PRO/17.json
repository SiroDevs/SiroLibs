        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.5",
            "verseOrgIds": [
              "PRO.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yisukulu ni ucimbicimbi wa ŵandu ŵacekulupe, soni ucimbicimbi wa ŵanace ni acinangolo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.6",
            "verseOrgIds": [
              "PRO.17.6"
            ]
          }
        }
      ]
    },
    {
