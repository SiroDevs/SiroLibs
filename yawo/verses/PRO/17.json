            "sid": "PRO 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundu jwalunda akusapikanaga kampepe, kulekangana ni cisilu camti atamose acipute camtuli ngacikusapikana. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.10",
            "verseOrgIds": [
              "PRO.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundu jwakusakala akusagamba kusosa yakwimucila basi, nambo tacimtumicisya ndumetume ja ngalwe.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.11",
            "verseOrgIds": [
              "PRO.17.11"
            ]
          }
        }
      ]
    },
