          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundu jwakusalamula mwagalawusya, mundu jwakusakala mtima kuŵa jwangali cileŵi, ni jwa cilungamo kuŵa jwakulemwa, jwele mundujo AMBUJE akusanyalayisidwa najo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.15",
            "verseOrgIds": [
              "PRO.17.15"
            ]
          }
        }
      ]
