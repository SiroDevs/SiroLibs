          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "M'mbusanga akusakunonyela ndaŵi ni ndaŵi, soni mlongo mjakwe ŵapagwile kuti atukamucisye pa ndaŵi ja yisawusyo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.17",
